{
  "name": "TamboresDaSelva",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "ServerShared": {
        "$path": "src/serverShared"
      },
      "Lobby": {
        "$path": "src/lobby/server"
      },
      "Game": {
        "$path": "src/game/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Lobby": {
          "$path": "src/lobby/client"
        },
        "Game": {
          "$path": "src/game/client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": false
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future"
      }
    },
    "TextChatService": {
      "$properties": {
        "ChatVersion": "TextChatService"
      }
    }
  }
}
