{
  "name": "JumanjiGame",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "ServerShared": {
        "$path": "src/serverShared"
      },
      "Game": {
        "$path": "src/game/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Game": {
          "$path": "src/game/client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": false
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future"
      }
    }
  }
}
