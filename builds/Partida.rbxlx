		MacheteSwing = "rbxasset://sounds/swordslash.wav",
		MacheteHit = "rbxasset://sounds/swordlunge.wav",
		Equip = "rbxasset://sounds/unsheath.wav",
		Explosion = "",

		-- Criaturas e eventos
		Roar = "",
