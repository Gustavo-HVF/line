      <Item class="Folder" referent="11">
        <Properties>
          <string name="Name">Settings</string>
        </Properties>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">AudioApplier</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Aplica as configurações de áudio no cliente.
-- Cada SoundGroup de Config/Sounds.Groups recebe volume = geral × volume do grupo:
--   Music → music, Effects → effects, Ambience → ambience.
-- A mudança é local (só este jogador ouve diferente). Os grupos são criados pelo servidor
-- (SoundUtil.EnsureGroups); se ainda não existirem, o volume é aplicado assim que aparecerem.

local SoundService = game:GetService("SoundService")

local Sounds = require(script.Parent.Parent.Config.Sounds)
local SettingsSchema = require(script.Parent.SettingsSchema)

local AudioApplier = {}

-- Chave do grupo em Sounds.Groups → campo correspondente em AudioSettings.
local GROUP_FIELDS = {
	Music = "music",
	Effects = "effects",
	Ambience = "ambience",
}

-- Nome do SoundGroup no SoundService → chave do grupo.
local groupKeyByName = {}
for groupKey, groupName in Sounds.Groups do
	groupKeyByName[groupName] = groupKey
end

local latest = nil -- últimas configurações de áudio aplicadas (já validadas)
local watchConnection: RBXScriptConnection? = nil

local function volumeFor(groupKey: string, audio): number
	local field = GROUP_FIELDS[groupKey]
	local groupValue = field and audio[field] or 1
	return math.clamp(audio.master * groupValue, 0, 1)
end

local function applyToGroup(group: Instance)
	if not latest or not group:IsA("SoundGroup") then
		return
	end
	local groupKey = groupKeyByName[group.Name]
	if not groupKey then
		return
	end
	local volume = volumeFor(groupKey, latest)
	if math.abs(group.Volume - volume) > 1e-4 then
		group.Volume = volume
	end
end

-- Ajusta o volume dos SoundGroups. Não cede (pode ser chamado a cada movimento de um slider).
function AudioApplier.Apply(audio)
	latest = SettingsSchema.Sanitize({ audio = audio }).audio

	for _, groupName in Sounds.Groups do
		local group = SoundService:FindFirstChild(groupName)
		if group then
			applyToGroup(group)
		end
	end

	-- Grupos que ainda não chegaram do servidor (ou que forem recriados) recebem o volume ao aparecer.
	if not watchConnection then
		watchConnection = SoundService.ChildAdded:Connect(applyToGroup)
	end
end

-- Volume final de um grupo ("Music" | "Effects" | "Ambience") com as configurações atuais.
function AudioApplier.GetVolume(groupKey: string): number
	if not latest then
		return 1
	end
	return volumeFor(groupKey, latest)
end

return AudioApplier
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">GraphicsApplier</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Aplica as configurações gráficas no cliente. Tudo é local: nada disso replica para o servidor.
-- Funciona no lobby e na partida, com o workspace inteiro.
--
-- Sombras
--   off  → Lighting.GlobalShadows = false e nenhuma luz faz sombra;
--   low  → sombras ligadas e suaves (ShadowSoftness = 1); parts pequenas (maior dimensão < 8) e luzes sem sombra;
--   high → tudo como foi construído (valores originais) e ShadowSoftness = 0,2.
-- Redução de texturas
--   materiais (exceto Glass, Neon, ForceField e SmoothPlastic) viram SmoothPlastic; Decals e Textures ficam
--   invisíveis; GuiObjects com o atributo TextureDetail = true (detalhes "pintados" em SurfaceGuis) somem.
--   Personagens (Models com Humanoid) não são alterados, para ninguém ficar sem rosto.
-- Distância de renderização
--   Models com a tag CullChunk mais longe da câmera que o limite ficam invisíveis: LocalTransparencyModifier = 1
--   nas parts/decals e luzes, partículas e GUIs 3D desligadas. A checagem roda a cada ~0,4 s e só mexe nas
--   instâncias quando o estado do chunk muda. A distância é medida até o ponto mais próximo da caixa do Model.
--
-- Os valores originais ficam em tabelas fracas (chave = instância) para poder restaurar. Como o Roblox pode
-- coletar o objeto Lua de uma instância que ninguém referencia (e a entrada sumiria da tabela fraca), as
-- instâncias alteradas também ficam "presas" numa tabela forte, limpa periodicamente quando são destruídas.
-- Instâncias novas (mapa sendo construído, pedaços de destruição) entram numa fila processada aos poucos,
-- com limite de tempo por frame, para não travar o celular.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")

local GameConfig = require(script.Parent.Parent.Config.GameConfig)
local Tags = require(script.Parent.Parent.Tags)
local SettingsSchema = require(script.Parent.SettingsSchema)

local GraphicsApplier = {}

-- Ajustes -----------------------------------------------------------------------------------
local SMALL_PART_SIZE = 8 -- parts com maior dimensão abaixo disso não fazem sombra em "low"
local LOW_SHADOW_SOFTNESS = 1
local HIGH_SHADOW_SOFTNESS = 0.2
local CULL_INTERVAL = 0.4
local CULL_HYSTERESIS = 10 -- studs: um chunk escondido só volta quando fica 10 studs dentro do limite
local CULL_BUDGET = 3000 -- instâncias alteradas por frame ao esconder/mostrar chunks
local BOX_REFRESH_INTERVAL = 2 -- s: intervalo mínimo entre recálculos da caixa de um chunk que mudou
local QUEUE_TIME_BUDGET = 0.002 -- s por frame processando a fila de instâncias novas
local QUEUE_MIN_PER_FRAME = 64
local PASS_BATCH = 1500 -- instâncias por frame numa passada completa pelo workspace
local REGISTER_TIME_BUDGET = 0.004 -- s por frame registrando os chunks que já existiam no Init
local PIN_SWEEP_INTERVAL = 20
local DETAIL_ATTRIBUTE = "TextureDetail"
local CULL_TAG = Tags.CullChunk

local SMOOTH = Enum.Material.SmoothPlastic
local KEEP_MATERIALS = {
	[Enum.Material.Glass] = true,
	[Enum.Material.Neon] = true,
	[Enum.Material.ForceField] = true,
	[Enum.Material.SmoothPlastic] = true,
}

-- Estado ------------------------------------------------------------------------------------
local initialized = false
local hasApplied = false
local shadowMode = "high"
local reduced = false
local renderDistance = SettingsSchema.RenderDistanceStuds(SettingsSchema.Defaults())
local cullingEnabled = true

local function weakKeys()
	return setmetatable({}, { __mode = "k" })
end

-- Valores originais (só entra quem foi alterado).
local origCastShadow = weakKeys() -- [BasePart] = true
local origLightShadows = weakKeys() -- [Light] = true
local origMaterial = weakKeys() -- [BasePart] = Enum.Material
local origDecalTransparency = weakKeys() -- [Decal] = number
local origDetailVisible = weakKeys() -- [GuiObject] = true

-- Referências fortes das instâncias alteradas (ver comentário no topo).
local pinned: { [Instance]: boolean } = {}

local function isClean(inst: Instance): boolean
	return origCastShadow[inst] == nil
		and origLightShadows[inst] == nil
		and origMaterial[inst] == nil
		and origDecalTransparency[inst] == nil
		and origDetailVisible[inst] == nil
end

local function releaseIfClean(inst: Instance)
	if pinned[inst] and isClean(inst) then
		pinned[inst] = nil
	end
end

-- Parte de um personagem (jogador ou NPC com Humanoid)?
local function belongsToCharacter(inst: Instance): boolean
	local model = inst:FindFirstAncestorWhichIsA("Model")
	return model ~= nil and model:FindFirstChildOfClass("Humanoid") ~= nil
end

-- Sombras e texturas --------------------------------------------------------------------------

local function applyPartShadow(part: BasePart)
	if shadowMode == "low" then
		local size = part.Size
		if math.max(size.X, size.Y, size.Z) < SMALL_PART_SIZE and part.CastShadow then
			origCastShadow[part] = true
			pinned[part] = true
			part.CastShadow = false
		end
	elseif origCastShadow[part] then
		-- "off" usa GlobalShadows/luzes; "high" volta ao original. Nos dois casos a part volta como era.
		origCastShadow[part] = nil
		part.CastShadow = true
		releaseIfClean(part)
	end
end

local function applyPartMaterial(part: BasePart)
	if reduced then
		local material = part.Material
		if not KEEP_MATERIALS[material] and not belongsToCharacter(part) then
			-- Também cobre o caso do servidor ter trocado o material depois da primeira redução.
			origMaterial[part] = material
			pinned[part] = true
			part.Material = SMOOTH
		end
	else
		local original = origMaterial[part]
		if original ~= nil then
			origMaterial[part] = nil
			-- Se o servidor trocou o material nesse meio-tempo, o valor dele vale mais que o guardado.
			if part.Material == SMOOTH then
				part.Material = original
			end
			releaseIfClean(part)
		end
	end
end

local function applyDecal(decal: Decal)
	if reduced then
		if decal.Transparency < 1 and not belongsToCharacter(decal) then
			origDecalTransparency[decal] = decal.Transparency
			pinned[decal] = true
			decal.Transparency = 1
		end
	else
		local original = origDecalTransparency[decal]
		if original ~= nil then
			origDecalTransparency[decal] = nil
			if decal.Transparency >= 1 then
				decal.Transparency = original
			end
			releaseIfClean(decal)
		end
	end
end

local function applyLight(light: Light)
	if shadowMode ~= "high" then
		if light.Shadows then
			origLightShadows[light] = true
			pinned[light] = true
			light.Shadows = false
		end
	elseif origLightShadows[light] then
		origLightShadows[light] = nil
		light.Shadows = true
		releaseIfClean(light)
	end
end

local function applyDetail(gui: GuiObject)
	if reduced then
		if gui.Visible then
			origDetailVisible[gui] = true
			pinned[gui] = true
			gui.Visible = false
		end
	elseif origDetailVisible[gui] then
		origDetailVisible[gui] = nil
		gui.Visible = true
		releaseIfClean(gui)
	end
end

-- Aplica o modo atual (sombras + texturas) numa instância qualquer.
local function processInstance(inst: Instance)
	if inst.Parent == nil then
		return
	end
	if inst:IsA("BasePart") then
		if inst:IsA("Terrain") then
			return
		end
		applyPartShadow(inst)
		applyPartMaterial(inst)
	elseif inst:IsA("Decal") then
		applyDecal(inst)
	elseif inst:IsA("Light") then
		applyLight(inst)
	elseif inst:IsA("GuiObject") then
		if inst:GetAttribute(DETAIL_ATTRIBUTE) == true then
			applyDetail(inst)
		end
	end
end

local function isRelevant(inst: Instance): boolean
	if inst:IsA("BasePart") or inst:IsA("Decal") or inst:IsA("Light") then
		return true
	end
	return inst:IsA("GuiObject") and inst:GetAttribute(DETAIL_ATTRIBUTE) == true
end

-- Com sombras altas e texturas normais, instâncias novas não precisam de nada.
local function isDefaultMode(): boolean
	return shadowMode == "high" and not reduced
end

-- Fila de instâncias novas (processada no Heartbeat com limite de tempo) ------------------------------
local queue: { Instance } = {}
local queueHead, queueTail = 1, 0
local queueConnection: RBXScriptConnection? = nil

local function processQueue()
	local started = os.clock()
	local processed = 0
	while queueHead <= queueTail do
		local inst = queue[queueHead]
		queue[queueHead] = nil
		queueHead += 1
		processInstance(inst)
		processed += 1
		if processed >= QUEUE_MIN_PER_FRAME and os.clock() - started > QUEUE_TIME_BUDGET then
			return
		end
	end
	-- Fila vazia: para de rodar todo frame.
	queueHead, queueTail = 1, 0
	if queueConnection then
		queueConnection:Disconnect()
		queueConnection = nil
	end
end

local function enqueue(inst: Instance)
	queueTail += 1
	queue[queueTail] = inst
	if not queueConnection then
		queueConnection = RunService.Heartbeat:Connect(processQueue)
	end
end

local function onDescendantAdded(inst: Instance)
	if isDefaultMode() then
		return
	end
	if isRelevant(inst) then
		enqueue(inst)
	end
end

-- Passada completa pelo workspace (quando o modo de sombras/texturas muda). Uma passada nova cancela a anterior.
local passGeneration = 0
local function startFullPass()
	passGeneration += 1
	local generation = passGeneration
	task.spawn(function()
		local descendants = workspace:GetDescendants()
		for index, inst in descendants do
			if generation ~= passGeneration then
				return
			end
			processInstance(inst)
			if index % PASS_BATCH == 0 then
				task.wait()
			end
		end
	end)
end

local function applyLighting(mode: string)
	if mode == "off" then
		Lighting.GlobalShadows = false
	else
		Lighting.GlobalShadows = true
		Lighting.ShadowSoftness = mode == "low" and LOW_SHADOW_SOFTNESS or HIGH_SHADOW_SOFTNESS
	end
end

-- Limpa as referências de instâncias destruídas.
local function sweepPins()
	local snapshot = table.clone(pinned)
	local count = 0
	for inst in snapshot do
		if inst.Parent == nil then
			pinned[inst] = nil
			origCastShadow[inst] = nil
			origLightShadows[inst] = nil
			origMaterial[inst] = nil
			origDecalTransparency[inst] = nil
			origDetailVisible[inst] = nil
		end
		count += 1
		if count % 4000 == 0 then
			task.wait()
		end
	end
end

-- Culling por distância ------------------------------------------------------------------------

-- Tipos de membro de um chunk.
local KIND_TRANSPARENCY = 1 -- usa LocalTransparencyModifier
local KIND_ENABLED = 2 -- usa Enabled

type Chunk = {
	model: Model,
	members: { [Instance]: number },
	disabled: { [Instance]: boolean }, -- desligados por ESTE culling (para religar só esses)
	hidden: boolean,
	boxCFrame: CFrame?,
	boxHalf: Vector3?,
	boxDirty: boolean,
	boxTime: number,
	connections: { RBXScriptConnection },
	removed: boolean,
}

local chunks: { [Instance]: Chunk } = {}

local function classify(inst: Instance): number?
	if inst:IsA("BasePart") then
		return if inst:IsA("Terrain") then nil else KIND_TRANSPARENCY
	end
	if inst:IsA("Decal") or inst:IsA("Beam") then
		return KIND_TRANSPARENCY
	end
	if
		inst:IsA("Light")
		or inst:IsA("ParticleEmitter")
		or inst:IsA("LayerCollector")
		or inst:IsA("Trail")
		or inst:IsA("Fire")
		or inst:IsA("Smoke")
		or inst:IsA("Sparkles")
	then
		return KIND_ENABLED
	end
	return nil
end

-- Chunk mais próximo acima da instância (chunks aninhados: cada instância pertence ao mais interno).
local function ownerChunkModel(inst: Instance): Instance?
	local current = inst.Parent
	while current and current ~= workspace do
		if chunks[current] or (current:IsA("Model") and CollectionService:HasTag(current, CULL_TAG)) then
			return current
		end
		current = current.Parent
	end
	return nil
end

local function hideMember(chunk: Chunk, inst: any, kind: number)
	if kind == KIND_TRANSPARENCY then
		inst.LocalTransparencyModifier = 1
	elseif inst.Enabled then
		inst.Enabled = false
		chunk.disabled[inst] = true
	end
end

local function showMember(chunk: Chunk, inst: any, kind: number)
	if kind == KIND_TRANSPARENCY then
		inst.LocalTransparencyModifier = 0
	elseif chunk.disabled[inst] then
		chunk.disabled[inst] = nil
		inst.Enabled = true
	end
end

-- Esconde/mostra um chunk inteiro. Retorna quantas instâncias foram tocadas (para o orçamento por frame).
local function setChunkHidden(chunk: Chunk, hidden: boolean): number
	if chunk.hidden == hidden then
		return 0
	end
	chunk.hidden = hidden
	local count = 0
	for inst, kind in chunk.members do
		if hidden then
			hideMember(chunk, inst, kind)
		else
			showMember(chunk, inst, kind)
		end
		count += 1
	end
	if not hidden then
		table.clear(chunk.disabled)
	end
	return count
end

local function addMember(chunk: Chunk, inst: Instance)
	local kind = classify(inst)
	if not kind or chunk.members[inst] then
		return
	end
	if ownerChunkModel(inst) ~= chunk.model then
		return
	end
	chunk.members[inst] = kind
	if inst:IsA("BasePart") then
		chunk.boxDirty = true
	end
	if chunk.hidden then
		hideMember(chunk, inst, kind)
	end
end

local function removeMember(chunk: Chunk, inst: Instance)
	local kind = chunk.members[inst]
	if not kind then
		return
	end
	chunk.members[inst] = nil
	-- Saiu do chunk (destruída ou virou destroço em workspace.Debris): volta a ser visível.
	if chunk.hidden then
		showMember(chunk, inst, kind)
	end
	chunk.disabled[inst] = nil
	if kind == KIND_TRANSPARENCY then
		chunk.boxDirty = true
	end
end

local function removeChunk(model: Instance)
	local chunk = chunks[model]
	if not chunk then
		return
	end
	chunks[model] = nil
	chunk.removed = true
	for _, connection in chunk.connections do
		connection:Disconnect()
	end
	if chunk.hidden then
		setChunkHidden(chunk, false)
	end
	table.clear(chunk.members)
end

local function addChunk(model: Instance)
	if chunks[model] or not model:IsA("Model") or not model:IsDescendantOf(workspace) then
		return
	end
	local chunk: Chunk = {
		model = model,
		members = {},
		disabled = {},
		hidden = false,
		boxCFrame = nil,
		boxHalf = nil,
		boxDirty = true,
		boxTime = 0,
		connections = {},
		removed = false,
	}
	chunks[model] = chunk
	for _, descendant in model:GetDescendants() do
		addMember(chunk, descendant)
	end
	table.insert(
		chunk.connections,
		model.DescendantAdded:Connect(function(descendant)
			addMember(chunk, descendant)
		end)
	)
	table.insert(
		chunk.connections,
		model.DescendantRemoving:Connect(function(descendant)
			removeMember(chunk, descendant)
		end)
	)
	-- Saiu do workspace sem ser destruído (a tag continua): para de controlar.
	table.insert(
		chunk.connections,
		model.AncestryChanged:Connect(function()
			if not model:IsDescendantOf(workspace) then
				removeChunk(model)
			end
		end)
	)
end

-- Caixa do chunk (cacheada; recalculada quando parts entram/saem, no máximo a cada BOX_REFRESH_INTERVAL).
local function refreshBox(chunk: Chunk, now: number)
	if not chunk.boxDirty then
		return
	end
	if chunk.boxCFrame and now - chunk.boxTime < BOX_REFRESH_INTERVAL then
		return
	end
	chunk.boxDirty = false
	chunk.boxTime = now
	if next(chunk.members) == nil then
		chunk.boxCFrame = nil
		chunk.boxHalf = nil
		return
	end
	local ok, cframe, size = pcall(function()
		return chunk.model:GetBoundingBox()
	end)
	if ok and typeof(cframe) == "CFrame" and typeof(size) == "Vector3" then
		chunk.boxCFrame = cframe
		chunk.boxHalf = size / 2
	else
		chunk.boxCFrame = nil
		chunk.boxHalf = nil
	end
end

-- Distância da câmera até o ponto mais próximo da caixa orientada do chunk (0 se estiver dentro).
local function distanceToBox(boxCFrame: CFrame, half: Vector3, point: Vector3): number
	local relative = boxCFrame:PointToObjectSpace(point)
	local dx = math.max(math.abs(relative.X) - half.X, 0)
	local dy = math.max(math.abs(relative.Y) - half.Y, 0)
	local dz = math.max(math.abs(relative.Z) - half.Z, 0)
	return math.sqrt(dx * dx + dy * dy + dz * dz)
end

local function cullStep()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local cameraPosition = camera.CFrame.Position
	local limit = renderDistance
	local now = os.clock()

	-- Cópia da lista: o laço pode ceder e chunks podem entrar/sair nesse meio-tempo.
	local list = {}
	for _, chunk in chunks do
		table.insert(list, chunk)
	end

	local touched = 0
	for _, chunk in list do
		if not chunk.removed then
			local hide = false
			if cullingEnabled then
				refreshBox(chunk, now)
				local boxCFrame, half = chunk.boxCFrame, chunk.boxHalf
				if boxCFrame and half then
					local distance = distanceToBox(boxCFrame, half, cameraPosition)
					hide = if chunk.hidden then distance > limit - CULL_HYSTERESIS else distance > limit
				end
			end
			if hide ~= chunk.hidden then
				touched += setChunkHidden(chunk, hide)
				if touched >= CULL_BUDGET then
					task.wait()
					touched = 0
				end
			end
		end
	end
end

local cullRunning = false
local cullAgain = false

local function runCull()
	if cullRunning then
		cullAgain = true
		return
	end
	cullRunning = true
	repeat
		cullAgain = false
		local ok, err = pcall(cullStep)
		if not ok then
			warn("[GraphicsApplier] Erro no culling: " .. tostring(err))
		end
	until not cullAgain
	cullRunning = false
end

local function requestCull()
	if initialized then
		task.spawn(runCull)
	end
end

-- Registra aos poucos os chunks que já existiam (sem travar o primeiro frame).
local function registerExistingChunks()
	local started = os.clock()
	for _, model in CollectionService:GetTagged(CULL_TAG) do
		addChunk(model)
		if os.clock() - started > REGISTER_TIME_BUDGET then
			task.wait()
			started = os.clock()
		end
	end
	requestCull()
end

-- API pública ------------------------------------------------------------------------------------

-- Idempotente. Começa a escutar o workspace (em lote) e o culling por distância.
function GraphicsApplier.Init()
	if initialized then
		return
	end
	if not RunService:IsClient() then
		warn("[GraphicsApplier] Use somente no cliente.")
		return
	end
	initialized = true

	workspace.DescendantAdded:Connect(onDescendantAdded)
	CollectionService:GetInstanceAddedSignal(CULL_TAG):Connect(addChunk)
	CollectionService:GetInstanceRemovedSignal(CULL_TAG):Connect(removeChunk)
	task.spawn(registerExistingChunks)

	task.spawn(function()
		while true do
			task.wait(CULL_INTERVAL)
			runCull()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(PIN_SWEEP_INTERVAL)
			local ok, err = pcall(sweepPins)
			if not ok then
				warn("[GraphicsApplier] Erro ao limpar referências: " .. tostring(err))
			end
		end
	end)
end

-- Aplica sombras, redução de texturas e distância de renderização. Não cede.
function GraphicsApplier.Apply(graphics)
	if not RunService:IsClient() then
		return
	end
	GraphicsApplier.Init()
	local clean = SettingsSchema.Sanitize({ graphics = graphics }).graphics

	local shadowsChanged = clean.shadows ~= shadowMode
	local texturesChanged = clean.reducedTextures ~= reduced
	if shadowsChanged or not hasApplied then
		applyLighting(clean.shadows)
	end
	hasApplied = true
	shadowMode = clean.shadows
	reduced = clean.reducedTextures
	if shadowsChanged or texturesChanged then
		startFullPass()
	end

	local distance = GameConfig.RENDER_DISTANCES[clean.renderDistance] or renderDistance
	if distance ~= renderDistance then
		renderDistance = distance
		requestCull()
	end
end

-- false: mostra tudo e para de esconder (varredura de pré-carregamento). true: volta ao normal.
function GraphicsApplier.SetCullingEnabled(enabled: boolean)
	local value = enabled ~= false
	if cullingEnabled == value then
		return
	end
	cullingEnabled = value
	if not value then
		for _, chunk in chunks do
			if chunk.hidden then
				setChunkHidden(chunk, false)
			end
		end
	end
	requestCull()
end

-- Distância de renderização atual em studs.
function GraphicsApplier.GetRenderDistance(): number
	return renderDistance
end

return GraphicsApplier
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">SettingsClient</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Configurações do jogador no cliente (lobby e partida).
--   SettingsClient.Init()      idempotente; busca no servidor (Settings_Get, até 8 s; senão usa o padrão),
--                              aplica áudio e gráficos e inicia o GraphicsApplier
--   SettingsClient.Get()       cópia das configurações atuais
--   SettingsClient.Set(s)      valida, aplica na hora e salva no servidor com debounce de 1,5 s
--   SettingsClient.Changed     Signal (settings) disparado a cada mudança
--   SettingsClient.IsLoaded()  true depois que o Init terminou (com os dados do servidor ou o padrão)

local RunService = game:GetService("RunService")

local Net = require(script.Parent.Parent.Net)
local Signal = require(script.Parent.Parent.Util.Signal)
local SettingsSchema = require(script.Parent.SettingsSchema)
local AudioApplier = require(script.Parent.AudioApplier)
local GraphicsApplier = require(script.Parent.GraphicsApplier)

local SettingsClient = {}

SettingsClient.Changed = Signal.new()

local FETCH_TIMEOUT = 8
local SAVE_DEBOUNCE = 1.5

local current = SettingsSchema.Defaults()
local loaded = false
local initState = "idle" -- "idle" | "loading" | "done"
local initWaiters: { thread } = {}
local changedLocally = false -- o jogador mudou algo antes da resposta do servidor chegar
local saveToken = 0
local savePending = false

local function applyAll()
	local okAudio, audioErr = pcall(AudioApplier.Apply, current.audio)
	if not okAudio then
		warn("[SettingsClient] Erro ao aplicar o áudio: " .. tostring(audioErr))
	end
	local okGraphics, graphicsErr = pcall(GraphicsApplier.Apply, current.graphics)
	if not okGraphics then
		warn("[SettingsClient] Erro ao aplicar os gráficos: " .. tostring(graphicsErr))
	end
end

local function sendNow()
	savePending = false
	local snapshot = SettingsSchema.Clone(current)
	local ok, err = pcall(function()
		Net.event(Net.Names.Settings_Save):FireServer(snapshot)
	end)
	if not ok then
		warn("[SettingsClient] Não foi possível enviar as configurações: " .. tostring(err))
	end
end

local function scheduleSave()
	saveToken += 1
	local token = saveToken
	savePending = true
	task.delay(SAVE_DEBOUNCE, function()
		if token == saveToken and savePending then
			sendNow()
		end
	end)
end

-- Busca no servidor sem travar: a chamada roda numa thread separada e esperamos no máximo FETCH_TIMEOUT.
-- Se a resposta chegar depois do prazo (e o jogador não tiver mexido em nada), ela ainda é aplicada.
local function fetchFromServer(): any
	local result = nil
	local finished = false
	local timedOut = false

	task.spawn(function()
		local ok, value = pcall(function()
			return Net.func(Net.Names.Settings_Get):InvokeServer()
		end)
		if not ok then
			warn("[SettingsClient] Erro ao buscar as configurações: " .. tostring(value))
			value = nil
		end
		result = value
		finished = true
		if timedOut and value ~= nil and not changedLocally then
			current = SettingsSchema.Sanitize(value)
			applyAll()
			SettingsClient.Changed:Fire(SettingsSchema.Clone(current))
		end
	end)

	local started = os.clock()
	while not finished and os.clock() - started < FETCH_TIMEOUT do
		task.wait(0.1)
	end
	if not finished then
		timedOut = true
		warn("[SettingsClient] O servidor não respondeu a tempo; usando as configurações padrão por enquanto.")
		return nil
	end
	return result
end

function SettingsClient.Init()
	if not RunService:IsClient() then
		warn("[SettingsClient] Use somente no cliente.")
		return
	end
	if initState == "done" then
		return
	end
	if initState == "loading" then
		-- Outro script já está carregando: espera terminar (Init sempre retorna com tudo aplicado).
		table.insert(initWaiters, coroutine.running())
		coroutine.yield()
		return
	end
	initState = "loading"

	local okInit, initErr = pcall(GraphicsApplier.Init)
	if not okInit then
		warn("[SettingsClient] Erro ao iniciar o GraphicsApplier: " .. tostring(initErr))
	end

	local fromServer = fetchFromServer()
	if fromServer ~= nil and not changedLocally then
		current = SettingsSchema.Sanitize(fromServer)
	end
	applyAll()

	loaded = true
	initState = "done"
	SettingsClient.Changed:Fire(SettingsSchema.Clone(current))

	local waiters = initWaiters
	initWaiters = {}
	for _, thread in waiters do
		task.spawn(thread)
	end
end

function SettingsClient.Get()
	return SettingsSchema.Clone(current)
end

function SettingsClient.Set(settings)
	local clean = SettingsSchema.Sanitize(settings)
	current = clean
	changedLocally = true
	applyAll()
	SettingsClient.Changed:Fire(SettingsSchema.Clone(current))
	scheduleSave()
end

-- Envia agora uma gravação que ainda estava esperando o debounce (ex.: ao fechar a tela de configurações).
function SettingsClient.Flush()
	if savePending then
		saveToken += 1
		-- Em thread própria: Net.event pode esperar o remote existir, e quem chama não deve travar.
		task.spawn(sendNow)
	end
end

function SettingsClient.IsLoaded(): boolean
	return loaded
end

return SettingsClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">SettingsSchema</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Formato das configurações do jogador, valores padrão e validação.
-- Usado pelo cliente (UI) e pelo servidor (DataStore) para garantir dados válidos.

local GameConfig = require(script.Parent.Parent.Config.GameConfig)

export type AudioSettings = {
	master: number, -- 0..1
	music: number, -- 0..1
	effects: number, -- 0..1
	ambience: number, -- 0..1
}

export type GraphicsSettings = {
	shadows: string, -- "off" | "low" | "high"
	reducedTextures: boolean,
	renderDistance: number, -- índice em GameConfig.RENDER_DISTANCES (1..4)
	preload: boolean, -- pré-carregar o jogo na tela de carregamento
}

export type Settings = {
	version: number,
	audio: AudioSettings,
	graphics: GraphicsSettings,
}

local SettingsSchema = {}

SettingsSchema.VERSION = 1
SettingsSchema.SHADOW_OPTIONS = { "off", "low", "high" }
SettingsSchema.SHADOW_LABELS = { off = "Desligadas", low = "Baixas", high = "Altas" }

function SettingsSchema.Defaults(): Settings
	return {
		version = SettingsSchema.VERSION,
		audio = {
			master = 0.8,
			music = 0.6,
			effects = 0.8,
			ambience = 0.7,
		},
		graphics = {
			shadows = "high",
			reducedTextures = false,
			renderDistance = 3,
			preload = true,
		},
	}
end

local function clampNumber(value: any, min: number, max: number, default: number): number
	if type(value) ~= "number" or value ~= value then
		return default
	end
	return math.clamp(value, min, max)
end

-- Recebe qualquer valor (vindo do cliente ou do DataStore) e devolve configurações válidas.
function SettingsSchema.Sanitize(input: any): Settings
	local defaults = SettingsSchema.Defaults()
	if type(input) ~= "table" then
		return defaults
	end
	local audio = type(input.audio) == "table" and input.audio or {}
	local graphics = type(input.graphics) == "table" and input.graphics or {}

	local result = SettingsSchema.Defaults()
	for key, default in defaults.audio do
		result.audio[key] = clampNumber(audio[key], 0, 1, default)
	end

	if table.find(SettingsSchema.SHADOW_OPTIONS, graphics.shadows) then
		result.graphics.shadows = graphics.shadows
	end
	if type(graphics.reducedTextures) == "boolean" then
		result.graphics.reducedTextures = graphics.reducedTextures
	end
	result.graphics.renderDistance = math.floor(
		clampNumber(graphics.renderDistance, 1, #GameConfig.RENDER_DISTANCES, defaults.graphics.renderDistance)
	)
	if type(graphics.preload) == "boolean" then
		result.graphics.preload = graphics.preload
	end
	return result
end

-- Cópia profunda simples (as configurações só têm tabelas, números, strings e booleanos).
function SettingsSchema.Clone(settings: Settings): Settings
	local function copy(value)
		if type(value) ~= "table" then
			return value
		end
		local out = {}
		for k, v in value do
			out[k] = copy(v)
		end
		return out
	end
	return copy(settings)
end

function SettingsSchema.RenderDistanceStuds(settings: Settings): number
	return GameConfig.RENDER_DISTANCES[settings.graphics.renderDistance] or GameConfig.RENDER_DISTANCES[3]
end

return SettingsSchema
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Tags</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Nomes de tags do CollectionService usados no projeto inteiro.

return {
	Destructible = "Destructible", -- BasePart que pode ser quebrada (paredes, móveis, pisos superiores)
	Enemy = "Enemy", -- Model de NPC inimigo (Humanoid ou atributos Health/MaxHealth)
	WeaponSpawn = "WeaponSpawn", -- Part invisível onde armas podem aparecer
	CullChunk = "CullChunk", -- Model que o cliente pode esconder pela distância de renderização
	StartRoomDoor = "StartRoomDoor", -- Model de porta da sala inicial (abre após a contagem)
	PlayerSpawn = "PlayerSpawn", -- Part onde jogadores nascem (sala inicial)
	BoardSpawn = "BoardSpawn", -- Part onde o tabuleiro aparece no início
	LooseProp = "LooseProp", -- Objeto solto que eventos podem arremessar/empurrar
	Debris = "Debris", -- Pedaço gerado por destruição (some sozinho)
	Indestructible = "Indestructible", -- Nunca deve ser quebrado (tabuleiro, chão da ilha)
	Water = "Water", -- Parts de água (oceano, água de enchente)
	Weapon = "Weapon", -- Tool de arma
}
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="17">
        <Properties>
          <string name="Name">UI</string>
        </Properties>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">UIKit</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Kit de interface com o tema do jogo (selva / madeira / ouro).
-- Toda a UI é criada por código, então todos os menus usam estas funções para ficar consistentes.
--
--   local gui = UIKit.ScreenGui("MainMenu", 10)
--   local panel = UIKit.Panel({ Size = UDim2.fromOffset(400, 300), Position = UDim2.fromScale(0.5, 0.5),
--                               AnchorPoint = Vector2.new(0.5, 0.5), Parent = gui })
--   UIKit.Button({ Text = "Jogar", OnClick = function() end, Parent = panel })

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local SoundUtil = require(script.Parent.Parent.Audio.SoundUtil)

local UIKit = {}

UIKit.Theme = {
	Background = Color3.fromRGB(14, 28, 18),
	Panel = Color3.fromRGB(28, 46, 30),
	PanelLight = Color3.fromRGB(42, 66, 42),
	Wood = Color3.fromRGB(92, 60, 32),
	WoodDark = Color3.fromRGB(58, 36, 18),
	Gold = Color3.fromRGB(222, 180, 70),
	GoldDark = Color3.fromRGB(150, 112, 34),
	Text = Color3.fromRGB(244, 234, 206),
	TextMuted = Color3.fromRGB(176, 170, 146),
	Danger = Color3.fromRGB(196, 58, 46),
	Success = Color3.fromRGB(70, 160, 80),
	Info = Color3.fromRGB(70, 130, 180),
	Warning = Color3.fromRGB(226, 150, 40),
	Overlay = Color3.fromRGB(0, 0, 0),

	TitleFont = Enum.Font.Fondamento,
	BodyFont = Enum.Font.BuilderSans,
	BoldFont = Enum.Font.BuilderSansBold,

	Corner = UDim.new(0, 10),
}

local Theme = UIKit.Theme

local BUTTON_STYLES = {
	primary = { bg = Theme.Gold, hover = Color3.fromRGB(240, 202, 96), text = Theme.WoodDark },
	secondary = { bg = Theme.Wood, hover = Color3.fromRGB(116, 78, 44), text = Theme.Text },
	danger = { bg = Theme.Danger, hover = Color3.fromRGB(220, 80, 66), text = Theme.Text },
	ghost = { bg = Theme.PanelLight, hover = Color3.fromRGB(56, 86, 56), text = Theme.Text },
}

-- Generic -----------------------------------------------------------------------

-- Cria uma instância aplicando propriedades e filhos.
function UIKit.Create(className: string, props: { [string]: any }?, children: { Instance }?): Instance
	local instance = Instance.new(className)
	local parent = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				instance[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function UIKit.Corner(parent: Instance, radius: UDim?): UICorner
	return UIKit.Create("UICorner", { CornerRadius = radius or Theme.Corner, Parent = parent }) :: UICorner
end

function UIKit.Stroke(parent: Instance, color: Color3?, thickness: number?): UIStroke
	return UIKit.Create("UIStroke", {
		Color = color or Theme.GoldDark,
		Thickness = thickness or 2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	}) :: UIStroke
end

function UIKit.Padding(parent: Instance, px: number?): UIPadding
	local p = UDim.new(0, px or 12)
	return UIKit.Create("UIPadding", {
		PaddingTop = p,
		PaddingBottom = p,
		PaddingLeft = p,
		PaddingRight = p,
		Parent = parent,
	}) :: UIPadding
end

-- Layout vertical (ou horizontal) com espaçamento.
function UIKit.ListLayout(parent: Instance, padding: number?, horizontal: boolean?): UIListLayout
	return UIKit.Create("UIListLayout", {
		Padding = UDim.new(0, padding or 8),
		FillDirection = horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Parent = parent,
	}) :: UIListLayout
end

local function applyProps(instance: Instance, props: { [string]: any }?, skip: { [string]: boolean })
	if not props then
		return
	end
	for key, value in props do
		if not skip[key] and key ~= "Parent" then
			instance[key] = value
		end
	end
end

-- Containers ------------------------------------------------------------------------

function UIKit.ScreenGui(name: string, displayOrder: number?): ScreenGui
	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")
	local existing = playerGui:FindFirstChild(name)
	if existing then
		existing:Destroy()
	end
	return UIKit.Create("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = displayOrder or 0,
		Parent = playerGui,
	}) :: ScreenGui
end

-- Frame transparente (para organizar layout).
function UIKit.Frame(props: { [string]: any }?): Frame
	local frame = UIKit.Create("Frame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
	}) :: Frame
	applyProps(frame, props, {})
	if props and props.Parent then
		frame.Parent = props.Parent
	end
	return frame
end

-- Painel com fundo, borda dourada e cantos arredondados.
function UIKit.Panel(props: { [string]: any }?): Frame
	local panel = UIKit.Create("Frame", {
		BackgroundColor3 = Theme.Panel,
		BackgroundTransparency = 0.05,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(400, 300),
	}) :: Frame
	UIKit.Corner(panel)
	UIKit.Stroke(panel)
	applyProps(panel, props, { Padding = true })
	if not (props and props.Padding == false) then
		UIKit.Padding(panel, props and props.Padding or 14)
	end
	if props and props.Parent then
		panel.Parent = props.Parent
	end
	return panel
end

-- Lista rolável com layout vertical e canvas automático.
function UIKit.List(props: { [string]: any }?): ScrollingFrame
	local list = UIKit.Create("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Theme.Gold,
		ScrollingDirection = Enum.ScrollingDirection.Y,
	}) :: ScrollingFrame
	applyProps(list, props, { Spacing = true })
	UIKit.ListLayout(list, props and props.Spacing or 8)
	if props and props.Parent then
		list.Parent = props.Parent
	end
	return list
end

-- Texto -----------------------------------------------------------------------------

function UIKit.Label(props: { [string]: any }?): TextLabel
	local label = UIKit.Create("TextLabel", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 24),
		Font = Theme.BodyFont,
		TextColor3 = Theme.Text,
		TextSize = 18,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "",
	}) :: TextLabel
	applyProps(label, props, {})
	if props and props.Parent then
		label.Parent = props.Parent
	end
	return label
end

function UIKit.Title(text: string, props: { [string]: any }?): TextLabel
	local merged = {
		Text = text,
		Font = Theme.TitleFont,
		TextSize = 40,
		TextColor3 = Theme.Gold,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 48),
		TextStrokeTransparency = 0.6,
	}
	if props then
		for k, v in props do
			merged[k] = v
		end
	end
	return UIKit.Label(merged)
end

-- Botões ----------------------------------------------------------------------------

-- props: Text, OnClick, Style ("primary"|"secondary"|"danger"|"ghost"), mais qualquer propriedade de TextButton.
function UIKit.Button(props: { [string]: any }): TextButton
	local style = BUTTON_STYLES[props.Style or "secondary"] or BUTTON_STYLES.secondary
	local button = UIKit.Create("TextButton", {
		AutoButtonColor = false,
		BackgroundColor3 = style.bg,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 48),
		Font = Theme.BoldFont,
		TextColor3 = style.text,
		TextSize = 22,
		Text = props.Text or "",
	}) :: TextButton
	UIKit.Corner(button, UDim.new(0, 8))
	UIKit.Stroke(button, Theme.WoodDark, 2)
	applyProps(button, props, { Style = true, OnClick = true, Text = true })

	local tweenInfo = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	button.MouseEnter:Connect(function()
		TweenService:Create(button, tweenInfo, { BackgroundColor3 = style.hover }):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(button, tweenInfo, { BackgroundColor3 = style.bg }):Play()
	end)
	if props.OnClick then
		button.Activated:Connect(function()
			if button:GetAttribute("Disabled") then
				return
			end
			SoundUtil.Play("UIClick", { Volume = 0.4 })
			props.OnClick()
		end)
	end
	if props.Parent then
		button.Parent = props.Parent
	end
	return button
end

-- Ativa/desativa um botão criado por UIKit.Button.
function UIKit.SetButtonEnabled(button: TextButton, enabled: boolean)
	button:SetAttribute("Disabled", not enabled)
	button.AutoButtonColor = false
	button.TextTransparency = enabled and 0 or 0.5
	button.BackgroundTransparency = enabled and 0 or 0.5
end

-- Controles -------------------------------------------------------------------------

export type Control<T> = {
	Instance: Frame,
	Get: () -> T,
	Set: (value: T, silent: boolean?) -> (),
}

local function controlRow(props: { [string]: any }, height: number): (Frame, TextLabel)
	local row = UIKit.Frame({
		Size = UDim2.new(1, 0, 0, height),
		LayoutOrder = props.LayoutOrder or 0,
		Name = props.Name or props.Text or "Control",
	})
	local label = UIKit.Label({
		Text = props.Text or "",
		Size = UDim2.new(0.45, 0, 1, 0),
		TextSize = 18,
		Parent = row,
	})
	if props.Parent then
		row.Parent = props.Parent
	end
	return row, label
end

-- Interruptor liga/desliga. props: Text, Value, OnChanged(value), Parent, LayoutOrder
function UIKit.Toggle(props: { [string]: any }): Control<boolean>
	local row = controlRow(props, 40)
	local value = props.Value == true

	local track = UIKit.Create("TextButton", {
		Text = "",
		AutoButtonColor = false,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(64, 30),
		BorderSizePixel = 0,
		Parent = row,
	}) :: TextButton
	UIKit.Corner(track, UDim.new(1, 0))
	UIKit.Stroke(track, Theme.WoodDark, 2)
	local knob = UIKit.Create("Frame", {
		Size = UDim2.fromOffset(24, 24),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = Theme.Text,
		BorderSizePixel = 0,
		Parent = track,
	}) :: Frame
	UIKit.Corner(knob, UDim.new(1, 0))
	local stateLabel = UIKit.Label({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -74, 0.5, 0),
		Size = UDim2.fromOffset(110, 24),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = Theme.TextMuted,
		TextSize = 16,
		Parent = row,
	})

	local function render(animated: boolean)
		local goalPos = value and UDim2.new(1, -27, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)
		local goalColor = value and Theme.Success or Theme.WoodDark
		if animated then
			local info = TweenInfo.new(0.15)
			TweenService:Create(knob, info, { Position = goalPos }):Play()
			TweenService:Create(track, info, { BackgroundColor3 = goalColor }):Play()
		else
			knob.Position = goalPos
			track.BackgroundColor3 = goalColor
		end
		stateLabel.Text = value and "Ligado" or "Desligado"
	end
	render(false)

	local control = {} :: any
	control.Instance = row
	function control.Get()
		return value
	end
	function control.Set(newValue: boolean, silent: boolean?)
		value = newValue == true
		render(true)
		if not silent and props.OnChanged then
			props.OnChanged(value)
		end
	end
	track.Activated:Connect(function()
		SoundUtil.Play("UIClick", { Volume = 0.4 })
		control.Set(not value)
	end)
	return control
end

-- Controle deslizante. props: Text, Min, Max, Step, Value, OnChanged(value), Format(value)->string
function UIKit.Slider(props: { [string]: any }): Control<number>
	local row = controlRow(props, 44)
	local min, max = props.Min or 0, props.Max or 1
	local step = props.Step or 0.01
	local value = math.clamp(props.Value or min, min, max)
	local format = props.Format or function(v)
		return tostring(math.floor(v * 100 + 0.5)) .. "%"
	end

	local bar = UIKit.Create("TextButton", {
		Text = "",
		AutoButtonColor = false,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -64, 0.5, 0),
		Size = UDim2.new(0.55, -70, 0, 10),
		BackgroundColor3 = Theme.WoodDark,
		BorderSizePixel = 0,
		Parent = row,
	}) :: TextButton
	UIKit.Corner(bar, UDim.new(1, 0))
	local fill = UIKit.Create("Frame", {
		BackgroundColor3 = Theme.Gold,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0, 1),
		Parent = bar,
	}) :: Frame
	UIKit.Corner(fill, UDim.new(1, 0))
	local knob = UIKit.Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(20, 20),
		BackgroundColor3 = Theme.Text,
		BorderSizePixel = 0,
		Parent = bar,
	}) :: Frame
	UIKit.Corner(knob, UDim.new(1, 0))
	UIKit.Stroke(knob, Theme.GoldDark, 2)
	local valueLabel = UIKit.Label({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(56, 24),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextSize = 16,
		Parent = row,
	})

	local function render()
		local alpha = (max > min) and (value - min) / (max - min) or 0
		fill.Size = UDim2.fromScale(alpha, 1)
		knob.Position = UDim2.fromScale(alpha, 0.5)
		valueLabel.Text = format(value)
	end
	render()

	local control = {} :: any
	control.Instance = row
	function control.Get()
		return value
	end
	function control.Set(newValue: number, silent: boolean?)
		local snapped = math.floor((math.clamp(newValue, min, max) - min) / step + 0.5) * step + min
		snapped = math.clamp(snapped, min, max)
		if snapped == value and silent then
			render()
			return
		end
		value = snapped
		render()
		if not silent and props.OnChanged then
			props.OnChanged(value)
		end
	end

	local dragging = false
	local function updateFromX(x: number)
		local absPos, absSize = bar.AbsolutePosition.X, bar.AbsoluteSize.X
		if absSize <= 0 then
			return
		end
		local alpha = math.clamp((x - absPos) / absSize, 0, 1)
		control.Set(min + alpha * (max - min))
	end
	bar.InputBegan:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			dragging = true
			updateFromX(input.Position.X)
		end
	end)
	local changedConnection = UserInputService.InputChanged:Connect(function(input)
		if
			dragging
			and (
				input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch
			)
		then
			updateFromX(input.Position.X)
		end
	end)
	local endedConnection = UserInputService.InputEnded:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			dragging = false
		end
	end)
	-- Conexões globais: desconecta quando o controle for destruído (evita vazamento).
	row.Destroying:Connect(function()
		changedConnection:Disconnect()
		endedConnection:Disconnect()
	end)
	return control
end

-- Escolha entre opções (botões lado a lado).
-- props: Text, Options = { { Value = "high", Label = "Altas" }, ... }, Value, OnChanged(value)
function UIKit.Choice(props: { [string]: any }): Control<any>
	local row = controlRow(props, 40)
	local options = props.Options or {}
	local value = props.Value

	local holder = UIKit.Frame({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.new(0.55, 0, 0, 32),
		Parent = row,
	})
	local layout = UIKit.ListLayout(holder, 4, true)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Right

	local buttons = {}
	local control = {} :: any

	local function render()
		for optionValue, button in buttons do
			local selected = optionValue == value
			button.BackgroundColor3 = selected and Theme.Gold or Theme.WoodDark
			button.TextColor3 = selected and Theme.WoodDark or Theme.Text
		end
	end

	local count = math.max(#options, 1)
	for index, option in options do
		local button = UIKit.Create("TextButton", {
			Text = option.Label or tostring(option.Value),
			AutoButtonColor = false,
			Font = Theme.BoldFont,
			TextSize = 15,
			BorderSizePixel = 0,
			LayoutOrder = index,
			Size = UDim2.new(1 / count, -4, 1, 0),
			Parent = holder,
		}) :: TextButton
		UIKit.Corner(button, UDim.new(0, 6))
		buttons[option.Value] = button
		button.Activated:Connect(function()
			SoundUtil.Play("UIClick", { Volume = 0.4 })
			control.Set(option.Value)
		end)
	end

	control.Instance = row
	function control.Get()
		return value
	end
	function control.Set(newValue: any, silent: boolean?)
		value = newValue
		render()
		if not silent and props.OnChanged then
			props.OnChanged(value)
		end
	end
	render()
	return control
end

-- Caixa de texto. props: Placeholder, Text, MaxLength, OnChanged(text)
function UIKit.TextBox(props: { [string]: any }): TextBox
	local box = UIKit.Create("TextBox", {
		BackgroundColor3 = Theme.WoodDark,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 40),
		Font = Theme.BodyFont,
		TextSize = 18,
		TextColor3 = Theme.Text,
		PlaceholderColor3 = Theme.TextMuted,
		ClearTextOnFocus = false,
		Text = "",
	}) :: TextBox
	UIKit.Corner(box, UDim.new(0, 8))
	UIKit.Padding(box, 8)
	applyProps(box, props, { MaxLength = true, OnChanged = true })
	if props.MaxLength then
		-- Limita por caracteres (não bytes) para não cortar letras acentuadas no meio.
		box:GetPropertyChangedSignal("Text"):Connect(function()
			local text = box.Text
			local length = utf8.len(text)
			if length and length > props.MaxLength then
				local cut = utf8.offset(text, props.MaxLength + 1)
				if cut then
					box.Text = string.sub(text, 1, cut - 1)
				end
			end
		end)
	end
	if props.OnChanged then
		box.FocusLost:Connect(function()
			props.OnChanged(box.Text)
		end)
	end
	if props.Parent then
		box.Parent = props.Parent
	end
	return box
end

-- Efeitos ---------------------------------------------------------------------------

-- Mostra/esconde um GuiObject com fade (usa CanvasGroup se for um).
function UIKit.Fade(gui: GuiObject, visible: boolean, duration: number?)
	local time = duration or 0.25
	if gui:IsA("CanvasGroup") then
		if visible then
			gui.GroupTransparency = 1
			gui.Visible = true
		end
		local tween = TweenService:Create(gui, TweenInfo.new(time), { GroupTransparency = visible and 0 or 1 })
		tween:Play()
		if not visible then
			tween.Completed:Once(function(state)
				if state == Enum.PlaybackState.Completed then
					gui.Visible = false
				end
			end)
		end
	else
		gui.Visible = visible
	end
end

local toastGui: ScreenGui? = nil
local toastList: Frame? = nil

-- Notificação temporária no topo da tela.
-- kind: "info" | "warning" | "danger" | "success"
function UIKit.Toast(text: string, kind: string?, duration: number?)
	if not toastGui or not toastGui.Parent then
		toastGui = UIKit.ScreenGui("Toasts", 100)
		toastList = UIKit.Frame({
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 70),
			Size = UDim2.new(0, 520, 1, -70),
			Parent = toastGui,
		})
		UIKit.ListLayout(toastList :: Frame, 6)
	end
	local colors = {
		info = Theme.Info,
		warning = Theme.Warning,
		danger = Theme.Danger,
		success = Theme.Success,
	}
	local toast = UIKit.Create("CanvasGroup", {
		BackgroundColor3 = Theme.Panel,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		GroupTransparency = 1,
		Parent = toastList,
	}) :: CanvasGroup
	UIKit.Corner(toast, UDim.new(0, 8))
	UIKit.Stroke(toast, colors[kind or "info"] or Theme.Info, 2)
	UIKit.Padding(toast, 10)
	UIKit.Label({
		Text = text,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 0),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextSize = 19,
		Parent = toast,
	})
	TweenService:Create(toast, TweenInfo.new(0.2), { GroupTransparency = 0 }):Play()
	task.delay(duration or 4, function()
		local tween = TweenService:Create(toast, TweenInfo.new(0.4), { GroupTransparency = 1 })
		tween:Play()
		tween.Completed:Wait()
		toast:Destroy()
	end)
end

return UIKit
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="19">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">PartBuilder</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Helpers para construir geometria por código.
--   PartBuilder.part({ Name = "Parede", Size = ..., CFrame = ..., Color = ..., Material = ..., Parent = model,
--                      Tags = { Tags.Destructible }, Attributes = { Room = "Biblioteca" } })

local CollectionService = game:GetService("CollectionService")

local PartBuilder = {}

local SPECIAL_KEYS = {
	ClassName = true,
	Parent = true,
	Tags = true,
	Attributes = true,
}

-- Cria uma part (padrão: ancorada, superfícies lisas). Qualquer propriedade de BasePart pode ser passada.
function PartBuilder.part(props: { [string]: any }): BasePart
	local part = Instance.new(props.ClassName or "Part")
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		if not SPECIAL_KEYS[key] then
			part[key] = value
		end
	end
	if props.Tags then
		for _, tag in props.Tags do
			CollectionService:AddTag(part, tag)
		end
	end
	if props.Attributes then
		for name, value in props.Attributes do
			part:SetAttribute(name, value)
		end
	end
	if props.Parent then
		part.Parent = props.Parent
	end
	return part
end

-- Atalho para WedgePart.
function PartBuilder.wedge(props: { [string]: any }): WedgePart
	props.ClassName = "WedgePart"
	return PartBuilder.part(props) :: WedgePart
end

-- Cria um Model (ou Folder) com nome e pai.
function PartBuilder.model(name: string, parent: Instance?, className: string?): Instance
	local model = Instance.new(className or "Model")
	model.Name = name
	if parent then
		model.Parent = parent
	end
	return model
end

-- Solda a em b com WeldConstraint (mantém a posição relativa atual).
function PartBuilder.weld(a: BasePart, b: BasePart): WeldConstraint
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = a
	weld.Part1 = b
	weld.Parent = a
	return weld
end

-- Adiciona várias tags a uma instância.
function PartBuilder.tag(instance: Instance, ...: string)
	for _, tag in { ... } do
		CollectionService:AddTag(instance, tag)
	end
end

-- Retorna uma função que cede (task.wait) a cada `every` chamadas.
-- Use em loops de construção grandes para não travar o servidor.
function PartBuilder.yielder(every: number?): () -> ()
	local count = 0
	local limit = every or 200
	return function()
		count += 1
		if count % limit == 0 then
			task.wait()
		end
	end
end

-- Parede horizontal entre dois pontos (no plano XZ), com altura e espessura.
-- `bottomY` é a altura da base. Retorna a part.
function PartBuilder.wallBetween(
	a: Vector3,
	b: Vector3,
	bottomY: number,
	height: number,
	thickness: number,
	props: { [string]: any }?
): BasePart
	local flatA = Vector3.new(a.X, 0, a.Z)
	local flatB = Vector3.new(b.X, 0, b.Z)
	local length = (flatB - flatA).Magnitude
	local mid = (flatA + flatB) / 2
	local cf = CFrame.lookAt(
		Vector3.new(mid.X, bottomY + height / 2, mid.Z),
		Vector3.new(flatB.X, bottomY + height / 2, flatB.Z)
	)
	local merged = table.clone(props or {})
	merged.Size = Vector3.new(thickness, height, length)
	merged.CFrame = cf
	return PartBuilder.part(merged)
end

return PartBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Sinal simples (estilo RBXScriptSignal) para comunicação entre módulos do mesmo lado.
--   local s = Signal.new()
--   local conn = s:Connect(function(a, b) end)
--   s:Fire(1, 2)
--   conn:Disconnect()

local Signal = {}
Signal.__index = Signal

export type Connection = { Disconnect: (self: any) -> (), Connected: boolean }

function Signal.new()
	return setmetatable({ _handlers = {} }, Signal)
end

function Signal:Connect(handler: (...any) -> ()): Connection
	local connection = { Connected = true }
	local handlers = self._handlers
	function connection.Disconnect(conn)
		if not conn.Connected then
			return
		end
		conn.Connected = false
		local index = table.find(handlers, handler)
		if index then
			table.remove(handlers, index)
		end
	end
	table.insert(handlers, handler)
	return connection
end

function Signal:Once(handler: (...any) -> ()): Connection
	local connection
	connection = self:Connect(function(...)
		connection:Disconnect()
		handler(...)
	end)
	return connection
end

function Signal:Fire(...: any)
	for _, handler in table.clone(self._handlers) do
		task.spawn(handler, ...)
	end
end

function Signal:Wait(): ...any
	local thread = coroutine.running()
	self:Once(function(...)
		task.spawn(thread, ...)
	end)
	return coroutine.yield()
end

function Signal:DisconnectAll()
	table.clear(self._handlers)
end

return Signal
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="22">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="23">
      <Properties>
        <string name="Name">Game</string>
      </Properties>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">BoardModel</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Geometria do tabuleiro amaldiçoado (tudo por código, sem assets):
--   * caixa de madeira escura entalhada, aberta (≈ 5 x 0,6 x 3,5 studs);
--   * trilha de casas em espiral retangular, com a casa de partida e a última casa destacadas;
--   * "vidro" central com texto verde brilhante, onde aparecem os enigmas;
--   * a PEÇA única do grupo (uma estatueta de jade);
--   * os dados (cubos com pips nas 6 faces; faces opostas somam 7) e a leitura da face de cima.
-- Todas as parts recebem a tag Indestructible. Quem posiciona e anima é o BoardService.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local PartBuilder = require(ReplicatedStorage.Shared.Util.PartBuilder)
local Tags = require(ReplicatedStorage.Shared.Tags)

local BoardModel = {}

export type Board = {
	model: Model,
	base: BasePart,
	-- parts que ficam ancoradas no chão e são soldadas à base quando alguém carrega (inclui base e pieceRoot)
	parts: { BasePart },
	-- parts visuais da peça: sempre desancoradas e soldadas ao pieceRoot
	pieceParts: { BasePart },
	pieceRoot: BasePart,
	glass: BasePart,
	glassLight: PointLight,
	riddleLabel: TextLabel,
	finalLight: PointLight,
	spaceCount: number,
	spaceOffsets: { [number]: Vector3 }, -- índice 0 (partida) até spaceCount, em coordenadas locais da base
	original: { [BasePart]: { collide: boolean, query: boolean } },
}

-- Medidas ------------------------------------------------------------------------------

local BASE_SIZE = Vector3.new(5, 0.3, 3.5)
local RIM_HEIGHT = 0.3
local RIM_THICKNESS = 0.16
local TOP_Y = BASE_SIZE.Y / 2 -- topo da base (coordenadas locais da base)
local SPACE_SIZE = 0.36
local SPACE_HEIGHT = 0.03
local PIECE_Y = TOP_Y + SPACE_HEIGHT + 0.03 -- centro do disco da peça
local DIE_SIZE = 0.8

BoardModel.BASE_SIZE = BASE_SIZE
BoardModel.TOTAL_HEIGHT = BASE_SIZE.Y + RIM_HEIGHT
BoardModel.DIE_SIZE = DIE_SIZE

-- Cores -------------------------------------------------------------------------------

local WOOD_DARK = Color3.fromRGB(52, 32, 18)
local WOOD = Color3.fromRGB(84, 52, 28)
local GOLD = Color3.fromRGB(196, 156, 64)
local JADE = Color3.fromRGB(36, 122, 86)
local GLASS_COLOR = Color3.fromRGB(18, 64, 36)
local RIDDLE_COLOR = Color3.fromRGB(120, 255, 140)
local SPACE_COLORS = {
	Color3.fromRGB(150, 116, 70),
	Color3.fromRGB(92, 118, 62),
}
local MARKER_COLOR = Color3.fromRGB(176, 120, 52)
local START_COLOR = Color3.fromRGB(226, 214, 180)
local DIE_COLOR = Color3.fromRGB(236, 228, 206)
local PIP_COLOR = Color3.fromRGB(46, 28, 16)

-- Espiral retangular por onde a trilha passa (X/Z locais da base). Começa num canto, dá uma volta
-- completa pela borda, entra num anel interno e termina ao lado do vidro central.
local PATH = {
	Vector2.new(-2.08, -1.36),
	Vector2.new(2.08, -1.36),
	Vector2.new(2.08, 1.36),
	Vector2.new(-2.08, 1.36),
	Vector2.new(-2.08, -0.9),
	Vector2.new(1.62, -0.9),
	Vector2.new(1.62, 0.9),
	Vector2.new(-1.62, 0.9),
	Vector2.new(-1.62, 0),
}

-- Faces do dado e seus valores (faces opostas somam 7).
local DIE_FACES = {
	{ face = Enum.NormalId.Front, value = 1 },
	{ face = Enum.NormalId.Back, value = 6 },
	{ face = Enum.NormalId.Top, value = 2 },
	{ face = Enum.NormalId.Bottom, value = 5 },
	{ face = Enum.NormalId.Right, value = 3 },
	{ face = Enum.NormalId.Left, value = 4 },
}

-- Posição dos pips (fração da face).
local PIP_LAYOUT = {
	[1] = { { 0.5, 0.5 } },
	[2] = { { 0.26, 0.26 }, { 0.74, 0.74 } },
	[3] = { { 0.26, 0.26 }, { 0.5, 0.5 }, { 0.74, 0.74 } },
	[4] = { { 0.26, 0.26 }, { 0.74, 0.26 }, { 0.26, 0.74 }, { 0.74, 0.74 } },
	[5] = { { 0.26, 0.26 }, { 0.74, 0.26 }, { 0.5, 0.5 }, { 0.26, 0.74 }, { 0.74, 0.74 } },
	[6] = { { 0.26, 0.22 }, { 0.26, 0.5 }, { 0.26, 0.78 }, { 0.74, 0.22 }, { 0.74, 0.5 }, { 0.74, 0.78 } },
}

local UPRIGHT = CFrame.Angles(0, 0, math.rad(90)) -- cilindros do Roblox têm o eixo em X; isto os deixa em pé

-- Distribui count+1 pontos (0..count) igualmente espaçados ao longo da espiral.
local function samplePath(count: number): { [number]: Vector3 }
	local segments = {}
	local total = 0
	for i = 1, #PATH - 1 do
		local a, b = PATH[i], PATH[i + 1]
		local length = (b - a).Magnitude
		table.insert(segments, { a = a, b = b, length = length })
		total += length
	end

	local points = {}
	for index = 0, count do
		local target = total * index / count
		local accumulated = 0
		local point = PATH[#PATH]
		for _, segment in segments do
			if target <= accumulated + segment.length then
				local alpha = segment.length > 0 and (target - accumulated) / segment.length or 0
				point = segment.a:Lerp(segment.b, alpha)
				break
			end
			accumulated += segment.length
		end
		points[index] = Vector3.new(point.X, TOP_Y, point.Y)
	end
	return points
end

local function makeSurfaceText(part: BasePart, face: Enum.NormalId, props: { [string]: any }): (SurfaceGui, TextLabel)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Texto"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = props.PixelsPerStud or 100
	gui.LightInfluence = props.LightInfluence or 1
	gui.Brightness = props.Brightness or 1
	gui.MaxDistance = props.MaxDistance or 80
	gui.ClipsDescendants = true
	gui.ResetOnSpawn = false

	local label = Instance.new("TextLabel")
	label.Name = "Rotulo"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.Fondamento
	label.TextScaled = true
	label.TextWrapped = true
	label.TextColor3 = props.TextColor3 or RIDDLE_COLOR
	label.TextStrokeColor3 = props.TextStrokeColor3 or Color3.fromRGB(0, 40, 12)
	label.TextStrokeTransparency = props.TextStrokeTransparency or 0.5
	label.Text = props.Text or ""
	label.Parent = gui

	local padding = Instance.new("UIPadding")
	local px = UDim.new(0, props.Padding or 6)
	padding.PaddingLeft = px
	padding.PaddingRight = px
	padding.PaddingTop = px
	padding.PaddingBottom = px
	padding.Parent = label

	if props.MaxTextSize then
		local constraint = Instance.new("UITextSizeConstraint")
		constraint.MaxTextSize = props.MaxTextSize
		constraint.Parent = label
	end

	gui.Parent = part
	return gui, label
end

-- Constrói o tabuleiro com a base na origem (fundo em Y = 0) dentro de `parent`.
-- O pivot do Model fica no centro do FUNDO da base: PivotTo(cframe no chão) apoia o tabuleiro no chão.
function BoardModel.Build(parent: Instance, spaceCount: number?): Board
	local count = math.max(math.floor(spaceCount or GameConfig.BOARD_SPACES), 2)

	local model = Instance.new("Model")
	model.Name = "Tabuleiro"

	local parts: { BasePart } = {}
	local pieceParts: { BasePart } = {}
	local original = {}

	-- Cria uma part do tabuleiro. collide = true só para base e bordas.
	local function add(props: { [string]: any }, collide: boolean?, isPieceChild: boolean?): BasePart
		props.Parent = props.Parent or model
		props.Tags = { Tags.Indestructible }
		props.CanTouch = false
		props.Massless = true
		props.Locked = true
		if props.CastShadow == nil then
			props.CastShadow = false
		end
		local part = PartBuilder.part(props)
		-- CanQuery só pode ser falso com CanCollide falso: ajusta nesta ordem.
		if collide then
			part.CanCollide = true
			part.CanQuery = true
		else
			part.CanCollide = false
			part.CanQuery = false
		end
		original[part] = { collide = part.CanCollide, query = part.CanQuery }
		if isPieceChild then
			table.insert(pieceParts, part)
		else
			table.insert(parts, part)
		end
		return part
	end

	local baseCFrame = CFrame.new(0, BASE_SIZE.Y / 2, 0)
	local function at(x: number, y: number, z: number): CFrame
		return baseCFrame * CFrame.new(x, y, z)
	end

	-- Base e bordas da caixa aberta ------------------------------------------------------
	local base = add({
		Name = "Base",
		Size = BASE_SIZE,
		CFrame = baseCFrame,
		Color = WOOD_DARK,
		Material = Enum.Material.Wood,
		CastShadow = true,
	}, true)
	base.PivotOffset = CFrame.new(0, -BASE_SIZE.Y / 2, 0)

	local rimY = TOP_Y + RIM_HEIGHT / 2
	local halfX, halfZ = BASE_SIZE.X / 2, BASE_SIZE.Z / 2
	for _, sign in { -1, 1 } do
		add({
			Name = "BordaLonga",
			Size = Vector3.new(BASE_SIZE.X, RIM_HEIGHT, RIM_THICKNESS),
			CFrame = at(0, rimY, sign * (halfZ - RIM_THICKNESS / 2)),
			Color = WOOD,
			Material = Enum.Material.Wood,
			CastShadow = true,
		}, true)
		add({
			Name = "BordaCurta",
			Size = Vector3.new(RIM_THICKNESS, RIM_HEIGHT, BASE_SIZE.Z - RIM_THICKNESS * 2),
			CFrame = at(sign * (halfX - RIM_THICKNESS / 2), rimY, 0),
			Color = WOOD,
			Material = Enum.Material.Wood,
			CastShadow = true,
		}, true)
		-- Entalhe dourado no topo das bordas longas
		add({
			Name = "Entalhe",
			Size = Vector3.new(3.4, 0.03, 0.06),
			CFrame = at(0, TOP_Y + RIM_HEIGHT + 0.015, sign * (halfZ - RIM_THICKNESS / 2)),
			Color = GOLD,
			Material = Enum.Material.Metal,
		})
		-- Dobradiças na borda de trás (a caixa abre como um livro)
		add({
			Name = "Dobradica",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.5, 0.12, 0.12),
			CFrame = at(sign * 1.2, TOP_Y + 0.05, -(halfZ + 0.05)),
			Color = GOLD,
			Material = Enum.Material.Metal,
		})
	end

	-- Cantoneiras douradas
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			add({
				Name = "Cantoneira",
				Size = Vector3.new(0.24, 0.1, 0.24),
				CFrame = at(sx * (halfX - 0.1), TOP_Y + RIM_HEIGHT + 0.05, sz * (halfZ - 0.1)),
				Color = GOLD,
				Material = Enum.Material.Metal,
			})
		end
	end

	-- Placa com o nome do jogo na frente da caixa
	local plate = add({
		Name = "Placa",
		Size = Vector3.new(1.8, 0.36, 0.03),
		CFrame = at(0, 0.15, halfZ + 0.015),
		Color = GOLD,
		Material = Enum.Material.Metal,
	})
	makeSurfaceText(plate, Enum.NormalId.Back, {
		Text = GameConfig.GAME_TITLE,
		TextColor3 = WOOD_DARK,
		TextStrokeTransparency = 1,
		PixelsPerStud = 80,
		MaxDistance = 40,
		Padding = 2,
	})

	-- Vidro central do enigma -------------------------------------------------------------
	add({
		Name = "MolduraVidro",
		Size = Vector3.new(2.46, 0.025, 1.16),
		CFrame = at(0.15, TOP_Y + 0.0125, 0),
		Color = GOLD,
		Material = Enum.Material.Metal,
	})
	local glass = add({
		Name = "Vidro",
		Size = Vector3.new(2.3, 0.04, 1.0),
		CFrame = at(0.15, TOP_Y + 0.025 + 0.02, 0),
		Color = GLASS_COLOR,
		Material = Enum.Material.Glass,
		Transparency = 0.15,
		Reflectance = 0.1,
	})
	local _, riddleLabel = makeSurfaceText(glass, Enum.NormalId.Top, {
		Text = GameConfig.GAME_TITLE,
		LightInfluence = 0,
		Brightness = 2,
		PixelsPerStud = 110,
		MaxDistance = 70,
		MaxTextSize = 40,
	})
	local glassLight = Instance.new("PointLight")
	glassLight.Name = "Brilho"
	glassLight.Color = Color3.fromRGB(90, 255, 120)
	glassLight.Range = 5
	glassLight.Brightness = 0.6
	glassLight.Shadows = false
	glassLight.Parent = glass

	-- Trilha de casas -------------------------------------------------------------------------
	local offsets = samplePath(count)
	local finalLight: PointLight? = nil
	for index = 0, count do
		local offset = offsets[index]
		local size, color, material = SPACE_SIZE, SPACE_COLORS[index % 2 + 1], Enum.Material.SmoothPlastic
		local name = "Casa" .. index
		if index == 0 then
			size, color, name = 0.42, START_COLOR, "CasaPartida"
		elseif index == count then
			size, color, material, name = 0.46, JADE, Enum.Material.Neon, "CasaFinal"
		elseif index % 5 == 0 then
			color = MARKER_COLOR
		end
		local space = add({
			Name = name,
			Size = Vector3.new(size, SPACE_HEIGHT, size),
			CFrame = at(offset.X, TOP_Y + SPACE_HEIGHT / 2, offset.Z),
			Color = color,
			Material = material,
		})
		if index == count then
			local light = Instance.new("PointLight")
			light.Name = "BrilhoFinal"
			light.Color = JADE
			light.Range = 3
			light.Brightness = 0.8
			light.Shadows = false
			light.Parent = space
			finalLight = light
		end
	end

	-- A PEÇA única do grupo ------------------------------------------------------------------
	-- Ponto de extensão para skins futuras: no futuro, BoardModel.Build poderá receber um "skinId" e trocar
	-- apenas as parts visuais abaixo (disco, corpo, faixa, cabeça), mantendo o pieceRoot invisível como
	-- âncora de animação. NÃO implementado agora (fora do escopo desta versão).
	local pieceCFrame = at(offsets[0].X, PIECE_Y, offsets[0].Z)
	local pieceModel = Instance.new("Model")
	pieceModel.Name = "Peca"
	pieceModel.Parent = model
	local pieceRoot = add({
		Name = "PecaRaiz",
		Size = Vector3.new(0.3, 0.06, 0.3),
		CFrame = pieceCFrame,
		Transparency = 1,
		Parent = pieceModel,
	})
	pieceModel.PrimaryPart = pieceRoot

	local function piecePart(props: { [string]: any }, offsetY: number, cylinder: boolean)
		props.Parent = pieceModel
		props.Anchored = false
		props.CFrame = pieceCFrame * CFrame.new(0, offsetY, 0) * (cylinder and UPRIGHT or CFrame.identity)
		local part = add(props, false, true)
		PartBuilder.weld(part, pieceRoot)
		return part
	end
	piecePart({
		Name = "Disco",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.06, 0.34, 0.34),
		Color = GOLD,
		Material = Enum.Material.Metal,
	}, 0, true)
	piecePart({
		Name = "Corpo",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.32, 0.2, 0.2),
		Color = JADE,
		Material = Enum.Material.Marble,
	}, 0.19, true)
	piecePart({
		Name = "Faixa",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.04, 0.24, 0.24),
		Color = GOLD,
		Material = Enum.Material.Metal,
	}, 0.35, true)
	piecePart({
		Name = "Cabeca",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(0.22, 0.22, 0.22),
		Color = JADE,
		Material = Enum.Material.Marble,
	}, 0.48, false)

	model.PrimaryPart = base
	model.Parent = parent

	return {
		model = model,
		base = base,
		parts = parts,
		pieceParts = pieceParts,
		pieceRoot = pieceRoot,
		glass = glass,
		glassLight = glassLight,
		riddleLabel = riddleLabel,
		finalLight = finalLight :: PointLight,
		spaceCount = count,
		spaceOffsets = offsets,
		original = original,
	}
end

-- CFrame do pieceRoot quando a peça está na casa `space` (0 = partida), relativo à posição atual da base.
function BoardModel.GetPieceCFrame(board: Board, space: number): CFrame
	local index = math.clamp(math.floor(space), 0, board.spaceCount)
	local offset = board.spaceOffsets[index]
	return board.base.CFrame * CFrame.new(offset.X, PIECE_Y, offset.Z)
end

-- Texto do vidro central (nil volta ao nome do jogo).
function BoardModel.SetRiddle(board: Board, text: string?)
	board.riddleLabel.Text = text or GameConfig.GAME_TITLE
end

-- Cria um dado (desancorado) em `cframe` dentro de `parent`.
function BoardModel.CreateDie(parent: Instance, cframe: CFrame): BasePart
	local die = PartBuilder.part({
		Name = "Dado",
		Size = Vector3.new(DIE_SIZE, DIE_SIZE, DIE_SIZE),
		CFrame = cframe,
		Color = DIE_COLOR,
		Material = Enum.Material.SmoothPlastic,
		CanTouch = false,
		CastShadow = true,
		CustomPhysicalProperties = PhysicalProperties.new(1.2, 0.55, 0.25, 1, 1),
		Tags = { Tags.Indestructible },
	})

	for _, entry in DIE_FACES do
		local gui = Instance.new("SurfaceGui")
		gui.Name = "Face" .. entry.value
		gui.Face = entry.face
		gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
		gui.CanvasSize = Vector2.new(100, 100)
		gui.LightInfluence = 1
		gui.MaxDistance = 120
		gui.ResetOnSpawn = false
		for _, pip in PIP_LAYOUT[entry.value] do
			local dot = Instance.new("Frame")
			dot.Name = "Pip"
			dot.AnchorPoint = Vector2.new(0.5, 0.5)
			dot.Position = UDim2.fromScale(pip[1], pip[2])
			dot.Size = UDim2.fromScale(0.2, 0.2)
			dot.BackgroundColor3 = PIP_COLOR
			dot.BorderSizePixel = 0
			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(1, 0)
			corner.Parent = dot
			dot.Parent = gui
		end
		gui.Parent = die
	end

	die.Anchored = false
	die.Parent = parent
	return die
end

-- Lê o valor da face de cima: a face cuja normal (no mundo) aponta mais para +Y.
function BoardModel.ReadDie(die: BasePart): number
	local best, bestDot = 1, -math.huge
	for _, entry in DIE_FACES do
		local normal = die.CFrame:VectorToWorldSpace(Vector3.FromNormalId(entry.face))
		if normal.Y > bestDot then
			best, bestDot = entry.value, normal.Y
		end
	end
	return best
end

return BoardModel
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">BoardService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Serviço do tabuleiro (servidor): posição no mapa, carregar nas costas, jogar os dados com física,
-- andar com a peça única do grupo e avisar o resto do jogo pelo sinal BoardService.Rolled.
--
-- Regras de rolagem: a fase precisa permitir (SetRollingEnabled), o tabuleiro não pode estar travado
-- nem rolando, o cooldown precisa ter acabado e o jogador precisa estar vivo e ser o carregador
-- (ou ninguém carrega e ele está a até 12 studs).
-- Cada jogada DESLIGA a rolagem; o MatchService religa (junto com StartCooldown) quando o evento começa.

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local Net = require(ReplicatedStorage.Shared.Net)
local PartBuilder = require(ReplicatedStorage.Shared.Util.PartBuilder)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)
local SoundUtil = require(ReplicatedStorage.Shared.Audio.SoundUtil)
local Tags = require(ReplicatedStorage.Shared.Tags)

local BoardModel = require(script.Parent.BoardModel)
local CombatUtil = require(script.Parent.CombatUtil)

local BoardService = {}

-- ({ dice: {number}, total: number, fromSpace: number, space: number, position: Vector3,
--    isFinal: boolean, isFirst: boolean })
BoardService.Rolled = Signal.new()

-- Ajustes --------------------------------------------------------------------------------

local ROLL_DISTANCE = 12 -- distância máxima para jogar sem carregar
local PICKUP_DISTANCE = 12 -- validação no servidor (o prompt usa PROMPT_DISTANCE)
local PROMPT_DISTANCE = 10
local REQUEST_DEBOUNCE = 0.4 -- intervalo mínimo entre pedidos do mesmo jogador
local NOTIFY_DEBOUNCE = 2 -- intervalo mínimo entre avisos de erro para o mesmo jogador
local SETTLE_SPEED = 0.5 -- dado "parado" abaixo desta velocidade linear
local SETTLE_ANGULAR = 1 -- ...e desta velocidade angular (rad/s)
local SETTLE_TIME = 0.4 -- tempo parado para considerar assentado
local SETTLE_TIMEOUT = 4 -- tempo máximo esperando os dados
local DICE_FAR_DISTANCE = 18 -- dado mais longe que isto do tabuleiro = valor aleatório
local DICE_LINGER = 3 -- segundos até os dados sumirem
local STEP_TIME = 0.25 -- duração de cada passo da peça
local STEP_HOP = 0.25 -- altura do pulinho da peça
local MONITOR_INTERVAL = 0.5
local SAFE_EDGE_MARGIN = 6 -- margem da borda da ilha para considerar uma posição segura
local CARRY_ROTATION = CFrame.Angles(math.rad(90), 0, 0) -- topo do tabuleiro virado para trás (costas)

-- Estado --------------------------------------------------------------------------------

local initialized = false
local mapInfo = nil
local remotes: { [string]: RemoteEvent } = {}
local board: BoardModel.Board = nil
local boardFolder: Folder = nil
local diceFolder: Folder = nil
local pickupPrompt: ProximityPrompt? = nil
local rollPrompt: ProximityPrompt? = nil

local carrier: Player? = nil
local carrierConnections: { RBXScriptConnection } = {}
local carryWelds: { Instance } = {}
local locked = false
local rollingEnabled = false
local rolling = false
local cooldownEndsAt: number? = nil
local cooldownToken = 0
local space = 0
local rollCount = 0
local lastSafeCFrame = CFrame.new()
local lastRiddle: string? = nil
local pieceTween: Tween? = nil
local lastRequest: { [Player]: number } = {}
local lastNotify: { [Player]: number } = {}
local random = Random.new()

-- Funções declaradas antes por dependerem umas das outras.
local broadcastStatus: () -> ()
local updatePrompts: () -> ()

-- Utilitários ---------------------------------------------------------------------------

local function getRoot(player: Player): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

local function notify(player: Player, text: string, kind: string?)
	local now = os.clock()
	local last = lastNotify[player]
	if last and now - last < NOTIFY_DEBOUNCE then
		return
	end
	lastNotify[player] = now
	remotes.notify:FireClient(player, text, kind or "info")
end

local function getOrCreateFolder(parent: Instance, name: string): Folder
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("Folder") then
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

local function ensureFolders()
	if not boardFolder or not boardFolder:IsDescendantOf(workspace) then
		boardFolder = getOrCreateFolder(workspace, "Board")
	end
	if not diceFolder or not diceFolder:IsDescendantOf(boardFolder) then
		diceFolder = getOrCreateFolder(boardFolder, "Dice")
	end
end

-- Raycast que ignora o próprio tabuleiro, personagens, NPCs, pedaços, eventos e volumes de região.
local function rayParams(): RaycastParams
	local exclude: { Instance } = { boardFolder }
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(exclude, player.Character)
		end
	end
	for _, name in { "Debris", "ActiveEvents", "NPCs" } do
		local folder = workspace:FindFirstChild(name)
		if folder then
			table.insert(exclude, folder)
		end
	end
	local map = workspace:FindFirstChild("Map")
	local regions = map and map:FindFirstChild("Regions")
	if regions then
		table.insert(exclude, regions)
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = exclude
	params.IgnoreWater = true
	params.RespectCanCollide = true
	return params
end

local function findGround(position: Vector3, maxDrop: number, startAbove: number?): (Vector3?, BasePart?)
	local above = startAbove or 4
	local result =
		workspace:Raycast(position + Vector3.new(0, above, 0), Vector3.new(0, -(maxDrop + above), 0), rayParams())
	if result then
		return result.Position, result.Instance :: BasePart
	end
	return nil, nil
end

local function isWater(part: Instance?): boolean
	return part ~= nil and CollectionService:HasTag(part, Tags.Water)
end

local function isSafePosition(position: Vector3): boolean
	local center = mapInfo.islandCenter
	local flat = Vector3.new(position.X - center.X, 0, position.Z - center.Z)
	return flat.Magnitude <= mapInfo.islandRadius - SAFE_EDGE_MARGIN and position.Y > mapInfo.waterLevelY + 0.5
end

local function flatLook(vector: Vector3?): Vector3
	if vector then
		local flat = Vector3.new(vector.X, 0, vector.Z)
		if flat.Magnitude > 1e-3 then
			return flat.Unit
		end
	end
	return Vector3.new(0, 0, -1)
end

-- CFrame "deitado" no chão, olhando na direção horizontal dada.
local function groundCFrame(position: Vector3, look: Vector3?): CFrame
	return CFrame.lookAt(position, position + flatLook(look))
end

-- Acha um lugar seguro no chão a partir de `position`; se não achar, devolve a última posição segura.
local function placementAt(position: Vector3, look: Vector3?, maxDrop: number?, startAbove: number?): CFrame
	local ground, hit = findGround(position, maxDrop or 40, startAbove)
	if ground and not isWater(hit) and isSafePosition(ground) then
		return groundCFrame(ground, look)
	end
	return lastSafeCFrame
end

local function cooldownRemaining(): number
	if not cooldownEndsAt then
		return 0
	end
	return math.max(cooldownEndsAt - workspace:GetServerTimeNow(), 0)
end

local function canRollNow(): boolean
	return rollingEnabled and not locked and not rolling and cooldownRemaining() <= 0
end

local function statusPayload()
	local remaining = cooldownRemaining()
	return {
		carrierUserId = carrier and carrier.UserId or nil,
		canRoll = canRollNow(),
		cooldownEndsAt = remaining > 0 and cooldownEndsAt or nil,
		space = space,
		locked = locked,
		rolling = rolling,
	}
end

function broadcastStatus()
	if remotes.status then
		remotes.status:FireAllClients(statusPayload())
	end
end

function updatePrompts()
	if pickupPrompt then
		pickupPrompt.Enabled = carrier == nil and not locked and not rolling
	end
	if rollPrompt then
		rollPrompt.Enabled = carrier == nil and canRollNow()
	end
end

-- Física: carregado (solto, sem colisão, sem massa) x no chão (ancorado, colisão original).
local function setCarriedPhysics(carried: boolean)
	for _, part in board.parts do
		if part.Parent then
			if carried then
				part.CanCollide = false
				part.CanQuery = false
				part.Anchored = false
			else
				part.Anchored = true
				local original = board.original[part]
				part.CanCollide = original.collide
				part.CanQuery = original.query
			end
		end
	end
end

local function clearCarrierConnections()
	for _, connection in carrierConnections do
		connection:Disconnect()
	end
	table.clear(carrierConnections)
end

-- Remove as soldas e ancora o tabuleiro onde ele estiver.
local function detach()
	clearCarrierConnections()
	for _, weld in carryWelds do
		weld:Destroy()
	end
	table.clear(carryWelds)
	carrier = nil
	if board and board.base.Parent then
		setCarriedPhysics(false)
	end
end

-- Coloca o tabuleiro (ancorado) no CFrame dado. O pivot é o centro do fundo da base.
local function placeBoard(cframe: CFrame)
	if carrier then
		detach()
	end
	if pieceTween then
		pieceTween:Cancel()
		pieceTween = nil
	end
	board.model:PivotTo(cframe)
	board.pieceRoot.CFrame = BoardModel.GetPieceCFrame(board, space)
	if isSafePosition(cframe.Position) then
		lastSafeCFrame = cframe
	end
	updatePrompts()
	broadcastStatus()
end

-- O carregador solta o tabuleiro onde está (morte, eliminação, saída, travamento).
local function dropFromCarrier()
	local player = carrier
	if not player then
		return
	end
	local root = getRoot(player)
	local position = root and root.Position or board.model:GetPivot().Position
	local look = root and root.CFrame.LookVector or nil
	placeBoard(placementAt(position, look, 60, 1))
end

-- Lugar no chão à frente do jogador (sem atravessar paredes).
local function frontPlacement(player: Player): CFrame
	local root = getRoot(player)
	if not root then
		return placementAt(board.model:GetPivot().Position, nil, 60, 1)
	end
	local look = flatLook(root.CFrame.LookVector)
	local distance = 3.6
	local wallHit = workspace:Raycast(root.Position, look * (distance + 2), rayParams())
	if wallHit then
		distance = math.clamp((wallHit.Position - root.Position).Magnitude - 1.9, 0.8, 3.6)
	end
	local ground, hit = findGround(root.Position + look * distance, 14, 1)
	local feetY = root.Position.Y - 3
	if ground and not isWater(hit) and isSafePosition(ground) and math.abs(ground.Y - feetY) < 6 then
		return groundCFrame(ground, look)
	end
	return placementAt(root.Position, look, 60, 1)
end

-- Solda o tabuleiro nas costas do jogador.
local function attach(player: Player): boolean
	local character = player.Character
	if not character then
		return false
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	if not humanoid or not torso or not torso:IsA("BasePart") then
		return false
	end

	if pieceTween then
		pieceTween:Cancel()
		pieceTween = nil
	end
	board.pieceRoot.CFrame = BoardModel.GetPieceCFrame(board, space)

	-- Posiciona ainda ancorado, solda tudo na base e a base no torso; só então solta a física.
	local pose = torso.CFrame * CFrame.new(0, 0.2, torso.Size.Z / 2 + 0.04) * CARRY_ROTATION
	board.model:PivotTo(pose)
	for _, part in board.parts do
		if part ~= board.base then
			table.insert(carryWelds, PartBuilder.weld(part, board.base))
		end
	end
	table.insert(carryWelds, PartBuilder.weld(board.base, torso))
	setCarriedPhysics(true)
	carrier = player

	local function dropIfStillCarrier()
		if carrier == player then
			dropFromCarrier()
		end
	end
	table.insert(carrierConnections, humanoid.Died:Connect(dropIfStillCarrier))
	table.insert(
		carrierConnections,
		player:GetAttributeChangedSignal("Eliminated"):Connect(function()
			if player:GetAttribute("Eliminated") then
				dropIfStillCarrier()
			end
		end)
	)
	table.insert(
		carrierConnections,
		character.AncestryChanged:Connect(function()
			if not character:IsDescendantOf(workspace) then
				dropIfStillCarrier()
			end
		end)
	)
	table.insert(
		carrierConnections,
		torso.AncestryChanged:Connect(function()
			if not torso:IsDescendantOf(workspace) then
				dropIfStillCarrier()
			end
		end)
	)

	updatePrompts()
	broadcastStatus()
	return true
end

local function tryPickup(player: Player)
	if not initialized or carrier or locked or rolling then
		return
	end
	if not CombatUtil.IsPlayerAlive(player) then
		return
	end
	local root = getRoot(player)
	if not root or (root.Position - board.base.Position).Magnitude > PICKUP_DISTANCE then
		return
	end
	if attach(player) then
		notify(player, "Você está carregando o tabuleiro! T (ou o botão) joga o dado, G solta.", "success")
	end
end

-- Toca uma tween e espera terminar (com limite, caso a part seja destruída).
local function playAndWait(tween: Tween, timeout: number)
	local done = false
	local connection = tween.Completed:Once(function()
		done = true
	end)
	tween:Play()
	local started = os.clock()
	while not done and os.clock() - started < timeout do
		task.wait()
	end
	connection:Disconnect()
end

local function movePieceTo(index: number)
	local root = board.pieceRoot
	local fromCFrame = root.CFrame
	local toCFrame = BoardModel.GetPieceCFrame(board, index)
	local mid = fromCFrame:Lerp(toCFrame, 0.5) + board.base.CFrame.UpVector * STEP_HOP

	local up = TweenService:Create(
		root,
		TweenInfo.new(STEP_TIME / 2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ CFrame = mid }
	)
	pieceTween = up
	playAndWait(up, STEP_TIME * 2)
	if pieceTween ~= up then
		return -- o tabuleiro foi movido no meio do passo
	end
	local down = TweenService:Create(
		root,
		TweenInfo.new(STEP_TIME / 2, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{ CFrame = toCFrame }
	)
	pieceTween = down
	playAndWait(down, STEP_TIME * 2)
	if pieceTween == down then
		pieceTween = nil
	end
	SoundUtil.Play("PieceStep", { Parent = board.base, Volume = 0.5, RollOffMaxDistance = 80 })
end

local function removeDice(dice: { BasePart })
	for _, die in dice do
		if die.Parent then
			die.Anchored = true
			for _, child in die:GetChildren() do
				if child:IsA("SurfaceGui") then
					child.Enabled = false
				end
			end
			local tween = TweenService:Create(die, TweenInfo.new(0.5), {
				Size = Vector3.new(0.05, 0.05, 0.05),
				Transparency = 1,
			})
			tween.Completed:Once(function()
				die:Destroy()
			end)
			tween:Play()
			Debris:AddItem(die, 2)
		end
	end
end

-- A jogada completa: tabuleiro no chão, dados com física, leitura, peça andando e o sinal Rolled.
local function performRoll(player: Player)
	-- 1. Se o jogador carrega o tabuleiro, ele é colocado no chão à frente dele.
	if carrier == player then
		placeBoard(frontPlacement(player))
	elseif carrier then
		dropFromCarrier()
	end
	updatePrompts()
	broadcastStatus()

	local fromSpace = space
	local isFirst = rollCount == 0
	local boardPosition = board.model:GetPivot().Position
	local top = board.base.CFrame * CFrame.new(0, BoardModel.BASE_SIZE.Y / 2, 0)
	SoundUtil.Play("DiceRoll", { Parent = board.base, RollOffMaxDistance = 120 })

	-- 2. Dados nascem acima do tabuleiro, com velocidade e giro aleatórios (física no servidor).
	ensureFolders()
	local dice: { BasePart } = {}
	local diceCount = math.clamp(math.floor(GameConfig.DICE_COUNT), 1, 6)
	for index = 1, diceCount do
		local lateral =
			top:PointToWorldSpace(Vector3.new(random:NextNumber(-1.2, 1.2), 0, random:NextNumber(-0.6, 0.6)))
		local rotation = CFrame.Angles(
			random:NextNumber(0, math.pi * 2),
			random:NextNumber(0, math.pi * 2),
			random:NextNumber(0, math.pi * 2)
		)
		local die =
			BoardModel.CreateDie(diceFolder, CFrame.new(lateral + Vector3.new(0, 2.2 + index * 0.95, 0)) * rotation)
		pcall(function()
			die:SetNetworkOwner(nil)
		end)
		die.AssemblyLinearVelocity =
			Vector3.new(random:NextNumber(-2.5, 2.5), random:NextNumber(1, 3), random:NextNumber(-2.5, 2.5))
		die.AssemblyAngularVelocity =
			Vector3.new(random:NextNumber(-20, 20), random:NextNumber(-20, 20), random:NextNumber(-20, 20))
		table.insert(dice, die)
	end

	-- 3. Espera os dados assentarem (parados por SETTLE_TIME ou até SETTLE_TIMEOUT).
	local started = os.clock()
	local stillSince: number? = nil
	while os.clock() - started < SETTLE_TIMEOUT do
		task.wait(0.1)
		local allStill = true
		for _, die in dice do
			if die:IsDescendantOf(workspace) then
				if
					die.AssemblyLinearVelocity.Magnitude > SETTLE_SPEED
					or die.AssemblyAngularVelocity.Magnitude > SETTLE_ANGULAR
				then
					allStill = false
					break
				end
			end
		end
		if allStill then
			stillSince = stillSince or os.clock()
			if os.clock() - (stillSince :: number) >= SETTLE_TIME then
				break
			end
		else
			stillSince = nil
		end
	end

	-- 4. Lê a face de cima. Dado perdido (longe, na água ou destruído) vale um número aleatório.
	local values: { number } = {}
	local total = 0
	for _, die in dice do
		local value
		if
			die:IsDescendantOf(workspace)
			and (die.Position - boardPosition).Magnitude <= DICE_FAR_DISTANCE
			and die.Position.Y > mapInfo.waterLevelY
		then
			value = BoardModel.ReadDie(die)
		else
			value = random:NextInteger(1, 6)
		end
		if die.Parent then
			die.Anchored = true
		end
		table.insert(values, value)
		total += value
	end
	task.delay(DICE_LINGER, removeDice, dice)

	-- 5. A peça anda casa a casa.
	local target = math.min(space + total, GameConfig.BOARD_SPACES)
	for step = space + 1, target do
		movePieceTo(step)
		space = step
		broadcastStatus()
	end
	board.pieceRoot.CFrame = BoardModel.GetPieceCFrame(board, space)

	local isFinal = space >= GameConfig.BOARD_SPACES
	if isFinal and board.finalLight then
		board.finalLight.Brightness = 4
		board.finalLight.Range = 8
	end

	rollCount += 1
	rolling = false
	rollingEnabled = false -- o MatchService religa quando for a hora
	updatePrompts()
	broadcastStatus()

	BoardService.Rolled:Fire({
		dice = values,
		total = total,
		fromSpace = fromSpace,
		space = space,
		position = BoardService.GetBoardPosition(),
		isFinal = isFinal,
		isFirst = isFirst,
	})
end

local function requestRoll(player: Player)
	if not initialized or not player.Parent then
		return
	end
	local now = os.clock()
	local last = lastRequest[player]
	if last and now - last < REQUEST_DEBOUNCE then
		return
	end
	lastRequest[player] = now

	if rolling or not CombatUtil.IsPlayerAlive(player) then
		return
	end
	if locked then
		notify(player, "O tabuleiro está preso agora!", "warning")
		return
	end
	if not rollingEnabled then
		notify(player, "Ainda não é hora de jogar o dado.", "info")
		return
	end
	local remaining = cooldownRemaining()
	if remaining > 0 then
		notify(player, ("O dado ainda está quente! Próxima jogada em %ds."):format(math.ceil(remaining)), "info")
		return
	end
	if carrier then
		if carrier ~= player then
			notify(player, "Só quem está carregando o tabuleiro pode jogar o dado.", "info")
			return
		end
	else
		local root = getRoot(player)
		if not root or (root.Position - BoardService.GetBoardPosition()).Magnitude > ROLL_DISTANCE then
			notify(player, "Chegue mais perto do tabuleiro para jogar o dado.", "info")
			return
		end
	end

	-- Marca antes de ceder para que dois pedidos simultâneos não rolem duas vezes.
	rolling = true
	updatePrompts()
	broadcastStatus()
	task.spawn(function()
		local ok, err = pcall(performRoll, player)
		if not ok then
			warn("[BoardService] Erro durante a jogada: " .. tostring(err))
			rolling = false
			updatePrompts()
			broadcastStatus()
		end
	end)
end

local function createPrompts()
	local pickupAttachment = Instance.new("Attachment")
	pickupAttachment.Name = "PromptPegar"
	pickupAttachment.Position = Vector3.new(0, 0.9, 0)
	pickupAttachment.Parent = board.base

	local rollAttachment = Instance.new("Attachment")
	rollAttachment.Name = "PromptJogar"
	rollAttachment.Position = Vector3.new(0, 1.8, 0)
	rollAttachment.Parent = board.base

	local pickup = Instance.new("ProximityPrompt")
	pickup.Name = "PegarTabuleiro"
	pickup.ActionText = "Pegar tabuleiro"
	pickup.ObjectText = "Tabuleiro"
	pickup.KeyboardKeyCode = Enum.KeyCode.E
	pickup.GamepadKeyCode = Enum.KeyCode.ButtonX
	pickup.HoldDuration = 0.4
	pickup.MaxActivationDistance = PROMPT_DISTANCE
	pickup.RequiresLineOfSight = false
	pickup.Enabled = false
	pickup.Parent = pickupAttachment
	pickup.Triggered:Connect(tryPickup)
	pickupPrompt = pickup

	local roll = Instance.new("ProximityPrompt")
	roll.Name = "JogarDado"
	roll.ActionText = "Jogar o dado"
	roll.ObjectText = "Tabuleiro"
	roll.KeyboardKeyCode = Enum.KeyCode.T
	roll.GamepadKeyCode = Enum.KeyCode.ButtonY
	roll.HoldDuration = 0
	roll.MaxActivationDistance = PROMPT_DISTANCE
	roll.RequiresLineOfSight = false
	roll.Enabled = false
	roll.Parent = rollAttachment
	roll.Triggered:Connect(requestRoll)
	rollPrompt = roll
end

-- Reconstrói o tabuleiro se ele sumiu (ex.: personagem do carregador destruído).
local function rebuild()
	warn("[BoardService] O tabuleiro sumiu do workspace; reconstruindo na última posição segura.")
	clearCarrierConnections()
	for _, weld in carryWelds do
		weld:Destroy()
	end
	table.clear(carryWelds)
	carrier = nil
	pieceTween = nil
	if board and board.model then
		board.model:Destroy()
	end
	ensureFolders()
	board = BoardModel.Build(boardFolder, GameConfig.BOARD_SPACES)
	createPrompts()
	if lastRiddle then
		BoardModel.SetRiddle(board, lastRiddle)
	end
	placeBoard(lastSafeCFrame)
end

-- Verificações periódicas: tabuleiro inteiro, carregador válido, posição segura e chão embaixo.
local function monitorStep()
	if not board.base:IsDescendantOf(workspace) or not board.pieceRoot:IsDescendantOf(workspace) then
		rebuild()
		return
	end

	if carrier then
		local player = carrier
		local root = getRoot(player)
		if not player.Parent or not CombatUtil.IsPlayerAlive(player) or not root or #carryWelds == 0 then
			dropFromCarrier()
			return
		end
		local center = mapInfo.islandCenter
		local flat = Vector3.new(root.Position.X - center.X, 0, root.Position.Z - center.Z)
		if root.Position.Y < mapInfo.waterLevelY - 2 or flat.Magnitude > mapInfo.islandRadius then
			placeBoard(lastSafeCFrame)
			return
		end
		-- Guarda a última posição segura enquanto o tabuleiro é carregado.
		local ground, hit = findGround(root.Position, 12, 1)
		if ground and not isWater(hit) and isSafePosition(ground) then
			lastSafeCFrame = groundCFrame(ground, root.CFrame.LookVector)
		end
		return
	end

	if rolling or locked then
		-- Durante a jogada ou com o tabuleiro travado (ex.: pelicano), quem mexe é o dono da ação.
		return
	end

	local pivot = board.model:GetPivot()
	if not board.base.Anchored then
		placeBoard(placementAt(pivot.Position, pivot.LookVector, 60, 2))
		return
	end
	if not isSafePosition(pivot.Position) then
		placeBoard(lastSafeCFrame)
		remotes.notify:FireAllClients("O tabuleiro voltou para um lugar seguro.", "info")
		return
	end
	-- Chão destruído embaixo do tabuleiro: ele cai até o próximo chão.
	local support = findGround(pivot.Position, 1.5, 0.5)
	if not support then
		local below, hit = findGround(pivot.Position, 200, 0.5)
		if below and not isWater(hit) and isSafePosition(below) then
			placeBoard(groundCFrame(below, pivot.LookVector))
		else
			placeBoard(lastSafeCFrame)
		end
	end
end

local function monitorLoop()
	while true do
		task.wait(MONITOR_INTERVAL)
		local ok, err = pcall(monitorStep)
		if not ok then
			warn("[BoardService] Erro na verificação do tabuleiro: " .. tostring(err))
		end
	end
end

local function resolveSpawn(spawnCFrame: CFrame?): CFrame
	local base = typeof(spawnCFrame) == "CFrame" and spawnCFrame
		or CFrame.new(mapInfo.islandCenter.X, mapInfo.groundY, mapInfo.islandCenter.Z)
	-- O spawn fica em cima de uma mesa: ajusta a altura para o topo do que estiver embaixo.
	local ground = findGround(base.Position, 8, 2)
	if ground then
		return groundCFrame(ground, base.LookVector)
	end
	return groundCFrame(base.Position, base.LookVector)
end

local function watchReady(player: Player)
	local function sendIfReady()
		if player.Parent and player:GetAttribute("ClientReady") then
			remotes.status:FireClient(player, statusPayload())
		end
	end
	player:GetAttributeChangedSignal("ClientReady"):Connect(sendIfReady)
	sendIfReady()
end

-- API pública ----------------------------------------------------------------------------

function BoardService.Init(info)
	if initialized then
		return
	end
	mapInfo = info
	remotes.status = Net.event(Net.Names.Board_Status)
	remotes.roll = Net.event(Net.Names.Board_RollRequest)
	remotes.drop = Net.event(Net.Names.Board_DropRequest)
	remotes.notify = Net.event(Net.Names.Notify)
	remotes.ready = Net.event(Net.Names.Game_ClientReady)

	ensureFolders()
	board = BoardModel.Build(boardFolder, GameConfig.BOARD_SPACES)
	createPrompts()
	local spawnCFrame = resolveSpawn(info.boardSpawn)
	lastSafeCFrame = spawnCFrame
	initialized = true
	placeBoard(spawnCFrame)

	-- Os argumentos extras enviados pelo cliente são ignorados de propósito.
	remotes.roll.OnServerEvent:Connect(function(player)
		requestRoll(player)
	end)
	remotes.drop.OnServerEvent:Connect(function(player)
		if carrier == player and not rolling then
			BoardService.Drop()
		end
	end)
	-- Redundância: o GameMain já marca "ClientReady", mas isto garante o atributo mesmo sem ele.
	remotes.ready.OnServerEvent:Connect(function(player)
		if not player:GetAttribute("ClientReady") then
			player:SetAttribute("ClientReady", true)
		end
	end)

	Players.PlayerAdded:Connect(watchReady)
	for _, player in Players:GetPlayers() do
		watchReady(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		lastRequest[player] = nil
		lastNotify[player] = nil
		if carrier == player then
			dropFromCarrier()
		end
	end)

	task.spawn(monitorLoop)
end

-- Libera ou bloqueia a rolagem (controlado pelo MatchService conforme a fase).
function BoardService.SetRollingEnabled(enabled: boolean)
	rollingEnabled = enabled == true
	if initialized then
		updatePrompts()
		broadcastStatus()
	end
end

-- Inicia o tempo de espera até a próxima jogada.
function BoardService.StartCooldown(seconds: number)
	local duration = math.max(tonumber(seconds) or 0, 0)
	cooldownToken += 1
	local token = cooldownToken
	cooldownEndsAt = workspace:GetServerTimeNow() + duration
	if initialized then
		updatePrompts()
		broadcastStatus()
	end
	task.delay(duration + 0.05, function()
		if token == cooldownToken and initialized then
			updatePrompts()
			broadcastStatus()
		end
	end)
end

function BoardService.GetSpace(): number
	return space
end

function BoardService.GetBoardModel(): Model
	return board and board.model
end

function BoardService.GetBoardPosition(): Vector3
	if not board then
		return mapInfo and mapInfo.islandCenter or Vector3.zero
	end
	if carrier and board.base.Parent then
		return board.base.Position
	end
	return board.model:GetPivot().Position
end

function BoardService.GetCarrier(): Player?
	return carrier
end

-- O carregador solta o tabuleiro no chão (na posição dada ou à frente dele).
function BoardService.Drop(position: Vector3?)
	if not initialized or not carrier then
		return
	end
	if typeof(position) == "Vector3" then
		local root = getRoot(carrier)
		placeBoard(placementAt(position, root and root.CFrame.LookVector or nil, 40, 3))
	else
		placeBoard(frontPlacement(carrier))
	end
end

-- true enquanto os dados rolam e a peça anda (o tabuleiro não deve ser movido nesse intervalo).
function BoardService.IsRolling(): boolean
	return rolling
end

-- Travado: ninguém pega nem joga. Se alguém estiver carregando, o tabuleiro cai no chão.
function BoardService.SetLocked(value: boolean)
	locked = value == true
	if not initialized then
		return
	end
	if locked and carrier then
		dropFromCarrier()
	end
	updatePrompts()
	broadcastStatus()
end

-- Coloca o tabuleiro no chão nessa posição (solta o carregador). Posição insegura = última segura.
function BoardService.PlaceAt(cframe: CFrame)
	if not initialized or typeof(cframe) ~= "CFrame" then
		return
	end
	placeBoard(placementAt(cframe.Position, cframe.LookVector, 60, 3))
end

-- Mostra o texto do enigma no vidro central do tabuleiro.
function BoardService.ShowRiddle(text: string)
	if not initialized or type(text) ~= "string" then
		return
	end
	lastRiddle = text
	BoardModel.SetRiddle(board, text)
	local light = board.glassLight
	light.Brightness = 3
	TweenService:Create(light, TweenInfo.new(6, Enum.EasingStyle.Sine), { Brightness = 0.6 }):Play()
end

return BoardService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">BoundaryService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Borda da ilha (servidor): quem passa do raio da ilha (mais a margem) ou afunda abaixo do nível do mar
-- é eliminado. A morte é tratada pelo MatchService (Humanoid.Died -> eliminado com o motivo abaixo).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)

local CombatUtil = require(script.Parent.CombatUtil)

local BoundaryService = {}

local CHECK_INTERVAL = 0.25
local REASON = "Saiu da ilha"
local BELOW_WATER = 4 -- studs abaixo do nível do mar

local initialized = false

function BoundaryService.Init(mapInfo)
	if initialized then
		return
	end
	initialized = true

	local center: Vector3 = mapInfo.islandCenter or GameConfig.ISLAND_CENTER
	local limit: number = (mapInfo.islandRadius or GameConfig.ISLAND_RADIUS) + GameConfig.ELIMINATION_MARGIN
	local minY: number = (mapInfo.waterLevelY or GameConfig.WATER_LEVEL_Y) - BELOW_WATER

	task.spawn(function()
		while true do
			task.wait(CHECK_INTERVAL)
			for _, player in Players:GetPlayers() do
				if CombatUtil.IsPlayerAlive(player) then
					local character = player.Character
					local root = character:FindFirstChild("HumanoidRootPart") :: BasePart
					local humanoid = character:FindFirstChildOfClass("Humanoid")
					local position = root.Position
					local horizontal = Vector3.new(position.X - center.X, 0, position.Z - center.Z).Magnitude
					if humanoid and (horizontal > limit or position.Y < minY) then
						player:SetAttribute("LastDamageSource", REASON)
						humanoid.Health = 0
					end
				end
			end
		end
	end)
end

return BoundaryService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">CombatUtil</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Funções de combate compartilhadas no servidor do jogo (armas, NPCs e eventos usam isto).
-- Regras:
--   * Jogadores só levam dano de inimigos/eventos (sem fogo amigo).
--   * Inimigos podem ter Humanoid OU atributos "Health"/"MaxHealth" no Model (ex.: mosquitos voadores).
--   * Jogador eliminado tem o atributo "Eliminated" = true no objeto Player.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local Tags = require(ReplicatedStorage.Shared.Tags)

local CombatUtil = {}

-- Jogadores -----------------------------------------------------------------------

function CombatUtil.GetHumanoid(model: Instance?): Humanoid?
	if not model then
		return nil
	end
	return model:FindFirstChildOfClass("Humanoid")
end

function CombatUtil.IsPlayerAlive(player: Player): boolean
	if player:GetAttribute("Eliminated") then
		return false
	end
	local character = player.Character
	local humanoid = CombatUtil.GetHumanoid(character)
	return humanoid ~= nil and humanoid.Health > 0 and character:FindFirstChild("HumanoidRootPart") ~= nil
end

function CombatUtil.GetAlivePlayers(): { Player }
	local alive = {}
	for _, player in Players:GetPlayers() do
		if CombatUtil.IsPlayerAlive(player) then
			table.insert(alive, player)
		end
	end
	return alive
end

-- Jogador vivo mais próximo de uma posição (ou nil). maxDistance opcional.
function CombatUtil.GetNearestAlivePlayer(position: Vector3, maxDistance: number?): (Player?, number)
	local best, bestDistance = nil, maxDistance or math.huge
	for _, player in CombatUtil.GetAlivePlayers() do
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root then
			local distance = (root.Position - position).Magnitude
			if distance < bestDistance then
				best, bestDistance = player, distance
			end
		end
	end
	return best, bestDistance
end

-- Causa dano a um jogador. `source` é um texto curto usado na mensagem de eliminação (ex.: "Leão").
function CombatUtil.DamagePlayer(player: Player, amount: number, source: string?)
	-- NaN passaria pelo "<= 0" e deixaria a vida em NaN (nunca morre, nunca é eliminado: a derrota trava).
	if type(amount) ~= "number" or amount ~= amount or amount <= 0 or not CombatUtil.IsPlayerAlive(player) then
		return
	end
	local humanoid = CombatUtil.GetHumanoid(player.Character)
	if not humanoid then
		return
	end
	if source then
		player:SetAttribute("LastDamageSource", source)
	end
	humanoid:TakeDamage(amount)
end

-- Encontra o jogador dono de uma part (parte do personagem).
function CombatUtil.FindPlayerFromPart(part: Instance?): Player?
	local current = part
	while current and current ~= workspace do
		if current:IsA("Model") then
			local player = Players:GetPlayerFromCharacter(current)
			if player then
				return player
			end
		end
		current = current.Parent
	end
	return nil
end

-- Inimigos ------------------------------------------------------------------------

function CombatUtil.IsEnemy(model: Instance?): boolean
	return model ~= nil and CollectionService:HasTag(model, Tags.Enemy)
end

-- Sobe na hierarquia até achar o Model marcado com a tag Enemy.
function CombatUtil.FindEnemyFromPart(part: Instance?): Model?
	local current = part
	while current and current ~= workspace do
		if CollectionService:HasTag(current, Tags.Enemy) then
			return current :: Model
		end
		current = current.Parent
	end
	return nil
end

function CombatUtil.GetEnemyHealth(model: Model): (number, number)
	local humanoid = CombatUtil.GetHumanoid(model)
	if humanoid then
		return humanoid.Health, humanoid.MaxHealth
	end
	local health = tonumber(model:GetAttribute("Health")) or 0
	local maxHealth = tonumber(model:GetAttribute("MaxHealth")) or 0
	return health, maxHealth
end

function CombatUtil.IsEnemyAlive(model: Model): boolean
	if not model.Parent then
		return false
	end
	return (CombatUtil.GetEnemyHealth(model)) > 0
end

-- Causa dano a um inimigo. Retorna true se o golpe matou o inimigo.
function CombatUtil.DamageEnemy(model: Model, amount: number, attacker: Player?): boolean
	if type(amount) ~= "number" or amount ~= amount or amount <= 0 or not CombatUtil.IsEnemyAlive(model) then
		return false
	end
	if attacker then
		model:SetAttribute("LastAttackerUserId", attacker.UserId)
	end
	local humanoid = CombatUtil.GetHumanoid(model)
	if humanoid then
		humanoid:TakeDamage(amount)
		return humanoid.Health <= 0
	end
	local health = math.max((tonumber(model:GetAttribute("Health")) or 0) - amount, 0)
	model:SetAttribute("Health", health)
	return health <= 0
end

-- Dano em área ----------------------------------------------------------------------

-- Dano a jogadores dentro de um raio (com queda linear até a borda). Retorna os jogadores atingidos.
function CombatUtil.DamagePlayersInRadius(
	position: Vector3,
	radius: number,
	maxDamage: number,
	source: string?
): { Player }
	local hit = {}
	if not (radius > 0) then
		return hit -- raio 0 (ou NaN) daria falloff NaN
	end
	for _, player in CombatUtil.GetAlivePlayers() do
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root then
			local distance = (root.Position - position).Magnitude
			if distance <= radius then
				local falloff = 1 - (distance / radius) * 0.6
				CombatUtil.DamagePlayer(player, maxDamage * falloff, source)
				table.insert(hit, player)
			end
		end
	end
	return hit
end

-- Dano a inimigos dentro de um raio. Retorna a quantidade atingida.
function CombatUtil.DamageEnemiesInRadius(
	position: Vector3,
	radius: number,
	maxDamage: number,
	attacker: Player?
): number
	local count = 0
	if not (radius > 0) then
		return count
	end
	for _, enemy in CollectionService:GetTagged(Tags.Enemy) do
		if enemy:IsA("Model") and enemy:IsDescendantOf(workspace) and CombatUtil.IsEnemyAlive(enemy) then
			local pivot = enemy:GetPivot().Position
			local distance = (pivot - position).Magnitude
			if distance <= radius then
				local falloff = 1 - (distance / radius) * 0.6
				CombatUtil.DamageEnemy(enemy, maxDamage * falloff, attacker)
				count += 1
			end
		end
	end
	return count
end

-- Empurra o personagem de um jogador (knockback).
-- O personagem é simulado pelo cliente dono dele, então o empurrão é aplicado lá (FxClient, tipo "knockback").
function CombatUtil.Knockback(player: Player, direction: Vector3, strength: number)
	if direction.Magnitude < 1e-3 or not CombatUtil.IsPlayerAlive(player) then
		return
	end
	local push = direction.Unit * strength + Vector3.new(0, strength * 0.4, 0)
	Net.event(Net.Names.Fx_Play):FireClient(player, "knockback", { velocity = push })
end

return CombatUtil
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">DestructionService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Destruição do cenário (servidor).
--   * Fracture: quebra uma part com a tag Destructible. Blocos (Part com Shape Block) são cortados no espaço
--     LOCAL da part: abre-se um "buraco" em volta do ponto de impacto (raio proporcional ao impulso), dividido
--     em grade de ≈ FRACTURE_CHUNK_SIZE; os pedaços do buraco soltam e voam, e o resto da part vira até 6
--     blocos que continuam ancorados e Destructible (parede parcialmente quebrada, que pode quebrar de novo).
--     Eixos finos (≤ 2 studs) nunca são divididos e o total de pedaços respeita MAX_CHUNKS_PER_FRACTURE.
--     Outras formas (WedgePart, cilindros, malhas...) apenas desancoram e viram pedaço inteiras.
--   * RegisterDebris: pedaços com física vão para workspace.Debris (grupo de colisão "Debris", que não
--     colide consigo mesmo), somem com fade depois de DEBRIS_LIFETIME e respeitam MAX_DEBRIS.
--   * Explode: explosão visual, quebra as parts mais próximas, solta/empurra objetos, dano e tremor.
-- Extras usados pelos eventos físicos (fora do contrato): GetLooseRoot, ReleaseProp, Push, IsProtected.
-- Pedaços e objetos soltos ficam com a física no servidor (não pesa nos celulares dos jogadores).

local CollectionService = game:GetService("CollectionService")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local Net = require(ReplicatedStorage.Shared.Net)
local SoundUtil = require(ReplicatedStorage.Shared.Audio.SoundUtil)
local Tags = require(ReplicatedStorage.Shared.Tags)

local CombatUtil = require(script.Parent.CombatUtil)
local PhysUtil = require(script.Parent.EventHelpers.PhysUtil)

local DestructionService = {}

-- Ajustes --------------------------------------------------------------------------------

local DEBRIS_GROUP = "Debris"
local TICK = 0.25 -- intervalo da fila de pedaços (tempo de vida e fade em degraus)
local THIN_AXIS = 2 -- eixo com até isto de espessura não é dividido
local MIN_REMAINDER = 0.6 -- sobra mais fina que isto é incorporada ao buraco (sem lascas)
local MIN_RELEASE_RADIUS = 2
local MAX_RELEASE_RADIUS = 12
local DEFAULT_IMPULSE = 50
local MAX_IMPULSE = 250
local MAX_PIECE_SPEED = 160
local MAX_SPIN = 14
local EXPLODE_MAX_FRACTURES = 8
local EXPLODE_MAX_PUSH = 60
local EXPLODE_MAX_RADIUS = 120
local MAX_EXTRA_PARTS = 16 -- partes soldadas que acompanham um pedaço registrado
local CRUMBLE_INTERVAL = 0.25 -- intervalo mínimo entre sons de desmoronamento
local FALL_LIMIT_Y = GameConfig.WATER_LEVEL_Y - 40 -- pedaço que caiu no mar some na hora
local EXPLOSION_FLASH = Color3.fromRGB(255, 196, 120)

-- Estado ----------------------------------------------------------------------------------

local initialized = false
local loopStarted = false
local debrisFolder: Folder? = nil
local groupReady = false
local groupFailed = false
local entries: { any } = {} -- em ordem de chegada (o primeiro é o mais antigo)
local entryByPart: { [BasePart]: any } = {}
local serverOwned: { [BasePart]: boolean } = setmetatable({}, { __mode = "k" }) :: any
local lastCrumble = 0
local random = Random.new()

-- Preparação ------------------------------------------------------------------------------

local function ensureFolder(): Folder
	local folder = debrisFolder
	if folder and folder.Parent == workspace then
		return folder
	end
	local existing = workspace:FindFirstChild("Debris")
	if existing and existing:IsA("Folder") then
		debrisFolder = existing
		return existing
	end
	local created = Instance.new("Folder")
	created.Name = "Debris"
	created.Parent = workspace
	debrisFolder = created
	return created
end

local function ensureGroup()
	if groupReady or groupFailed then
		return
	end
	local ok, err = pcall(function()
		if not PhysicsService:IsCollisionGroupRegistered(DEBRIS_GROUP) then
			PhysicsService:RegisterCollisionGroup(DEBRIS_GROUP)
		end
		-- Pedaço não colide com pedaço: muito menos contatos para a física resolver.
		PhysicsService:CollisionGroupSetCollidable(DEBRIS_GROUP, DEBRIS_GROUP, false)
	end)
	if ok then
		groupReady = true
	else
		groupFailed = true
		warn("[DestructionService] Não foi possível criar o grupo de colisão 'Debris': " .. tostring(err))
	end
end

local startLoop: () -> ()

local function ensureSetup()
	ensureFolder()
	ensureGroup()
	startLoop()
end

-- Proteções -------------------------------------------------------------------------------

local function folderContains(name: string, instance: Instance): boolean
	local folder = workspace:FindFirstChild(name)
	return folder ~= nil and instance:IsDescendantOf(folder)
end

-- Personagens, inimigos e o tabuleiro: nunca quebrados, empurrados nem registrados como pedaço.
local function isLivingOrBoard(instance: Instance): boolean
	if folderContains("Board", instance) or folderContains("NPCs", instance) then
		return true
	end
	return CombatUtil.FindPlayerFromPart(instance) ~= nil or CombatUtil.FindEnemyFromPart(instance) ~= nil
end

-- true se a instância não deve ser tocada pela destruição (Indestructible, vivos, tabuleiro, armas).
function DestructionService.IsProtected(instance: Instance): boolean
	if typeof(instance) ~= "Instance" then
		return true
	end
	if CollectionService:HasTag(instance, Tags.Indestructible) or CollectionService:HasTag(instance, Tags.Weapon) then
		return true
	end
	if instance:FindFirstAncestorOfClass("Tool") then
		return true
	end
	return isLivingOrBoard(instance)
end

function DestructionService.IsDestructible(part: BasePart): boolean
	if typeof(part) ~= "Instance" or not part:IsA("BasePart") then
		return false
	end
	if not part:IsDescendantOf(workspace) then
		return false
	end
	if not CollectionService:HasTag(part, Tags.Destructible) or CollectionService:HasTag(part, Tags.Debris) then
		return false
	end
	return not DestructionService.IsProtected(part)
end

-- Física ----------------------------------------------------------------------------------

-- O servidor passa a simular a peça (só funciona em parts soltas; falha calada em ancoradas/soldadas).
local function takeOwnership(part: BasePart)
	if serverOwned[part] then
		return
	end
	local ok = pcall(part.SetNetworkOwner, part, nil)
	if ok then
		serverOwned[part] = true
	end
end

local function clampVector(vector: Vector3, maxMagnitude: number): Vector3
	local magnitude = vector.Magnitude
	if magnitude ~= magnitude then
		return Vector3.zero
	end
	if magnitude > maxMagnitude then
		return vector.Unit * maxMagnitude
	end
	return vector
end

local function randomSpin(scale: number): Vector3
	local s = math.min(scale, MAX_SPIN)
	return Vector3.new(random:NextNumber(-s, s), random:NextNumber(-s, s), random:NextNumber(-s, s))
end

-- Aplica velocidade numa part solta (ou no conjunto soldado dela).
function DestructionService.Push(part: BasePart, velocity: Vector3, angular: Vector3?)
	if typeof(part) ~= "Instance" or not part:IsA("BasePart") or typeof(velocity) ~= "Vector3" then
		return
	end
	if part.Anchored or not part:IsDescendantOf(workspace) or isLivingOrBoard(part) then
		return
	end
	takeOwnership(part)
	part.AssemblyLinearVelocity = clampVector(velocity, MAX_PIECE_SPEED * 1.5)
	if typeof(angular) == "Vector3" then
		part.AssemblyAngularVelocity = clampVector(angular, MAX_SPIN * 2)
	end
end

-- Part raiz de um objeto LooseProp (a própria part, a raiz do conjunto soldado ou uma vizinha marcada).
function DestructionService.GetLooseRoot(part: BasePart): BasePart?
	if typeof(part) ~= "Instance" or not part:IsA("BasePart") then
		return nil
	end
	if CollectionService:HasTag(part, Tags.LooseProp) then
		return part
	end
	local root = part.AssemblyRootPart
	if root and root ~= part and CollectionService:HasTag(root, Tags.LooseProp) then
		return root
	end
	if not part.Anchored then
		-- Depois de solto, a raiz do conjunto pode ser outra part: procura a marcada entre as soldadas.
		local ok, connected = pcall(part.GetConnectedParts, part, true)
		if ok then
			for index, other in connected do
				if index > MAX_EXTRA_PARTS then
					break
				end
				if CollectionService:HasTag(other, Tags.LooseProp) then
					return other
				end
			end
		end
	end
	return nil
end

-- Desancora um objeto LooseProp (o conjunto soldado vai junto) e, se pedido, aplica velocidade.
-- Retorna a part raiz solta, ou nil se a part não for um objeto solto válido.
function DestructionService.ReleaseProp(part: BasePart, velocity: Vector3?): BasePart?
	local root = DestructionService.GetLooseRoot(part)
	if not root or not root:IsDescendantOf(workspace) or DestructionService.IsProtected(root) then
		return nil
	end
	if root.Anchored then
		root.Anchored = false
	end
	if typeof(velocity) == "Vector3" then
		DestructionService.Push(root, velocity, randomSpin(velocity.Magnitude * 0.1))
	else
		takeOwnership(root)
	end
	return root
end

-- Fila de pedaços ---------------------------------------------------------------------------

local function destroyEntry(entry)
	for _, part in entry.parts do
		entryByPart[part] = nil
		serverOwned[part] = nil
		if part.Parent then
			part:Destroy()
		end
	end
end

local function removeEntryAt(index: number)
	local entry = table.remove(entries, index)
	if entry then
		destroyEntry(entry)
	end
end

local function startFade(entry, now: number)
	entry.fadeStart = now
	entry.base = {}
	for _, part in entry.parts do
		if part.Parent then
			entry.base[part] = part.Transparency
			-- Parado e sem colisão durante o fade: ninguém tropeça num pedaço "fantasma".
			part.Anchored = true
			part.CanCollide = false
			part.CanTouch = false
			part.CanQuery = false
		end
	end
end

local function stepEntries()
	local now = os.clock()
	local fadeTime = math.max(GameConfig.DEBRIS_FADE_TIME, 0.05)
	for index = #entries, 1, -1 do
		local entry = entries[index]
		local part = entry.part
		if not part.Parent or not part:IsDescendantOf(workspace) then
			removeEntryAt(index)
		elseif entry.fadeStart then
			local alpha = (now - entry.fadeStart) / fadeTime
			if alpha >= 1 then
				removeEntryAt(index)
			else
				for fading, base in entry.base do
					if fading.Parent then
						fading.Transparency = base + (1 - base) * alpha
					end
				end
			end
		elseif part.Position.Y < FALL_LIMIT_Y then
			removeEntryAt(index)
		elseif now >= entry.expireAt then
			startFade(entry, now)
		end
	end
end

function startLoop()
	if loopStarted then
		return
	end
	loopStarted = true
	task.spawn(function()
		while true do
			task.wait(TICK)
			local ok, err = pcall(stepEntries)
			if not ok then
				warn("[DestructionService] Erro na fila de pedaços: " .. tostring(err))
			end
		end
	end)
end

local function prepareDebrisPart(part: BasePart, folder: Folder)
	part.Parent = folder
	if groupReady then
		part.CollisionGroup = DEBRIS_GROUP
	end
	CollectionService:RemoveTag(part, Tags.Destructible)
	CollectionService:RemoveTag(part, Tags.LooseProp)
	CollectionService:AddTag(part, Tags.Debris)
end

function DestructionService.RegisterDebris(part: BasePart, lifetime: number?)
	if typeof(part) ~= "Instance" or not part:IsA("BasePart") or not part.Parent then
		return
	end
	if isLivingOrBoard(part) then
		return
	end
	ensureSetup()
	local now = os.clock()
	local life = GameConfig.DEBRIS_LIFETIME
	if type(lifetime) == "number" and lifetime == lifetime then
		life = math.clamp(lifetime, 0.5, 600)
	end

	local existing = entryByPart[part]
	if existing then
		if not existing.fadeStart then
			existing.expireAt = now + life
		end
		return
	end

	-- Partes soldadas e soltas (ex.: pernas de uma cadeira) acompanham a part e somem junto.
	local parts = { part }
	if not part.Anchored then
		local ok, connected = pcall(part.GetConnectedParts, part, true)
		if ok then
			for _, other in connected do
				if #parts > MAX_EXTRA_PARTS then
					break
				end
				if other ~= part and not other.Anchored and not entryByPart[other] and not isLivingOrBoard(other) then
					table.insert(parts, other)
				end
			end
		end
	end

	local folder = ensureFolder()
	for _, member in parts do
		prepareDebrisPart(member, folder)
	end
	local entry = { part = part, parts = parts, expireAt = now + life, fadeStart = nil, base = nil }
	table.insert(entries, entry)
	for _, member in parts do
		entryByPart[member] = entry
	end

	-- Limite global: os mais antigos somem na hora.
	local maxDebris = math.max(math.floor(GameConfig.MAX_DEBRIS), 1)
	while #entries > maxDebris do
		removeEntryAt(1)
	end
end

-- Fratura -----------------------------------------------------------------------------------

local function playCrumble(position: Vector3)
	local now = os.clock()
	if now - lastCrumble < CRUMBLE_INTERVAL then
		return
	end
	lastCrumble = now
	SoundUtil.Play("Crumble", { Position = position, RollOffMaxDistance = 200, Volume = 0.7 })
end

-- Raio do buraco a partir do impulso (impulso 50 ≈ 4,5 studs).
local function releaseRadiusFor(impulse: number): number
	return math.clamp(1.5 + impulse * 0.06, MIN_RELEASE_RADIUS, MAX_RELEASE_RADIUS)
end

local function axisCount(length: number, chunk: number): number
	if length <= THIN_AXIS then
		return 1
	end
	return math.max(1, math.floor(length / chunk + 0.5))
end

local function newPiece(source: BasePart, cframe: CFrame, size: Vector3): Part
	local piece = Instance.new("Part")
	piece.Name = source.Name
	piece.Anchored = true
	piece.TopSurface = Enum.SurfaceType.Smooth
	piece.BottomSurface = Enum.SurfaceType.Smooth
	piece.Material = source.Material
	piece.MaterialVariant = source.MaterialVariant
	piece.Color = source.Color
	piece.Transparency = source.Transparency
	piece.Reflectance = source.Reflectance
	piece.CastShadow = source.CastShadow
	piece.Size = size
	piece.CFrame = cframe
	return piece
end

-- Pedaço que continua no lugar: mesma colisão, tags e atributos da original (pode quebrar de novo).
local function setupAnchoredPiece(piece: Part, source: BasePart, sourceTags: { string }, attributes)
	piece.CanCollide = source.CanCollide
	piece.CanTouch = source.CanTouch
	piece.CanQuery = source.CanQuery or source.CanCollide
	piece.CollisionGroup = source.CollisionGroup
	for _, tag in sourceTags do
		if tag ~= Tags.Debris then
			CollectionService:AddTag(piece, tag)
		end
	end
	CollectionService:AddTag(piece, Tags.Destructible)
	for name, value in attributes do
		piece:SetAttribute(name, value)
	end
end

-- Lança um pedaço solto: para longe da origem do impacto, um pouco para cima, girando.
local function launch(part: BasePart, origin: Vector3, speed: number)
	local direction = part.Position - origin
	if direction.Magnitude < 0.05 then
		direction = Vector3.new(random:NextNumber(-1, 1), random:NextNumber(0, 1), random:NextNumber(-1, 1))
	end
	if direction.Magnitude < 0.05 then
		direction = Vector3.yAxis
	end
	local s = speed * random:NextNumber(0.6, 1)
	local velocity = direction.Unit * s + Vector3.new(0, speed * random:NextNumber(0.15, 0.3), 0)
	part.Anchored = false
	takeOwnership(part)
	part.AssemblyLinearVelocity = clampVector(velocity, MAX_PIECE_SPEED)
	part.AssemblyAngularVelocity = randomSpin(speed * 0.15 + 2)
end

-- Solta a part inteira (formas que não são bloco, ou bloco pequeno demais para dividir).
local function releaseWhole(part: BasePart, origin: Vector3, speed: number): { BasePart }
	CollectionService:RemoveTag(part, Tags.Destructible)
	local folder = ensureFolder()
	part.Parent = folder
	launch(part, origin, speed)
	DestructionService.RegisterDebris(part)
	playCrumble(part.Position)
	return { part }
end

-- Núcleo da fratura. `holeRadius`: meia-largura do buraco; `speed`: velocidade dos pedaços;
-- `origin`: de onde os pedaços são empurrados (ponto de impacto ou centro da explosão).
local function fracture(
	part: BasePart,
	impact: Vector3,
	holeRadius: number,
	speed: number,
	origin: Vector3
): { BasePart }
	if not part:IsA("Part") or (part :: Part).Shape ~= Enum.PartType.Block then
		return releaseWhole(part, origin, speed)
	end

	ensureSetup()
	local cframe = part.CFrame
	local size = part.Size
	local sizes = { size.X, size.Y, size.Z }
	local halves = { size.X / 2, size.Y / 2, size.Z / 2 }
	local localImpact = cframe:PointToObjectSpace(impact)
	local centerOf = { localImpact.X, localImpact.Y, localImpact.Z }

	-- 1. Intervalo do buraco em cada eixo (eixo fino: inteiro).
	local lo, hi = {}, {}
	for axis = 1, 3 do
		local half = halves[axis]
		local c = math.clamp(centerOf[axis], -half, half)
		if sizes[axis] <= THIN_AXIS then
			lo[axis], hi[axis] = -half, half
		else
			local a = math.max(-half, c - holeRadius)
			local b = math.min(half, c + holeRadius)
			if a + half < MIN_REMAINDER then
				a = -half
			end
			if half - b < MIN_REMAINDER then
				b = half
			end
			lo[axis], hi[axis] = a, b
		end
	end

	-- 2. Sobras (até 6 blocos), cortando primeiro o eixo mais comprido para as sobras ficarem inteiras.
	local order = { 1, 2, 3 }
	table.sort(order, function(a, b)
		return sizes[a] > sizes[b]
	end)
	local boxLo = { -halves[1], -halves[2], -halves[3] }
	local boxHi = { halves[1], halves[2], halves[3] }
	local remainders: { { cframe: CFrame, size: Vector3 } } = {}
	local function addRemainder(minV: { number }, maxV: { number })
		local sx, sy, sz = maxV[1] - minV[1], maxV[2] - minV[2], maxV[3] - minV[3]
		if sx > 0.05 and sy > 0.05 and sz > 0.05 then
			local center = Vector3.new((minV[1] + maxV[1]) / 2, (minV[2] + maxV[2]) / 2, (minV[3] + maxV[3]) / 2)
			table.insert(remainders, { cframe = cframe * CFrame.new(center), size = Vector3.new(sx, sy, sz) })
		end
	end
	for _, axis in order do
		local belowMax = table.clone(boxHi)
		belowMax[axis] = lo[axis]
		addRemainder(boxLo, belowMax)
		local aboveMin = table.clone(boxLo)
		aboveMin[axis] = hi[axis]
		addRemainder(aboveMin, boxHi)
		boxLo[axis] = lo[axis]
		boxHi[axis] = hi[axis]
	end

	-- 3. Grade do buraco: pedaços ≈ FRACTURE_CHUNK_SIZE, aumentando o tamanho até caber no limite.
	local holeSize = { hi[1] - lo[1], hi[2] - lo[2], hi[3] - lo[3] }
	local maxChunks = math.max(math.floor(GameConfig.MAX_CHUNKS_PER_FRACTURE), 2)
	local budget = math.max(maxChunks - #remainders, 1)
	local chunk = math.max(GameConfig.FRACTURE_CHUNK_SIZE, 0.5)
	local counts = { 1, 1, 1 }
	for _ = 1, 60 do
		counts = { axisCount(holeSize[1], chunk), axisCount(holeSize[2], chunk), axisCount(holeSize[3], chunk) }
		if counts[1] * counts[2] * counts[3] <= budget then
			break
		end
		chunk *= 1.2
	end

	-- Bloco pequeno inteiro dentro do buraco: solta a própria part (sem criar cópias).
	if #remainders == 0 and counts[1] * counts[2] * counts[3] == 1 then
		return releaseWhole(part, origin, speed)
	end

	local sourceTags = CollectionService:GetTags(part)
	local attributes = part:GetAttributes()
	local parent = part.Parent
	local folder = ensureFolder()
	local pieces: { BasePart } = {}
	local loose: { BasePart } = {}

	for _, remainder in remainders do
		local piece = newPiece(part, remainder.cframe, remainder.size)
		setupAnchoredPiece(piece, part, sourceTags, attributes)
		piece.Parent = parent
		table.insert(pieces, piece)
	end

	local cell = Vector3.new(holeSize[1] / counts[1], holeSize[2] / counts[2], holeSize[3] / counts[3])
	local localHit = Vector3.new(
		math.clamp(centerOf[1], -halves[1], halves[1]),
		math.clamp(centerOf[2], -halves[2], halves[2]),
		math.clamp(centerOf[3], -halves[3], halves[3])
	)
	local keepDistance = holeRadius * 1.3
	local nearest, nearestDistance = nil, math.huge
	local holeCells = {}
	for ix = 1, counts[1] do
		for iy = 1, counts[2] do
			for iz = 1, counts[3] do
				local center =
					Vector3.new(lo[1] + (ix - 0.5) * cell.X, lo[2] + (iy - 0.5) * cell.Y, lo[3] + (iz - 0.5) * cell.Z)
				local distance = (center - localHit).Magnitude
				local entry = { center = center, distance = distance }
				table.insert(holeCells, entry)
				if distance < nearestDistance then
					nearest, nearestDistance = entry, distance
				end
			end
		end
	end
	-- Pedaços soltos ficam um tiquinho menores para não nascerem encostados (sem tremedeira).
	local looseSize =
		Vector3.new(math.max(cell.X - 0.04, 0.2), math.max(cell.Y - 0.04, 0.2), math.max(cell.Z - 0.04, 0.2))
	for _, entry in holeCells do
		local worldCFrame = cframe * CFrame.new(entry.center)
		if entry == nearest or entry.distance <= keepDistance then
			local piece = newPiece(part, worldCFrame, looseSize)
			piece.CanCollide = true
			piece.CanTouch = true
			piece.CanQuery = true
			piece.Parent = folder
			table.insert(pieces, piece)
			table.insert(loose, piece)
		else
			local piece = newPiece(part, worldCFrame, cell)
			setupAnchoredPiece(piece, part, sourceTags, attributes)
			piece.Parent = parent
			table.insert(pieces, piece)
		end
	end

	-- Partes soldadas na original (enfeites presos nela) caem junto como pedaços.
	local dependents: { BasePart } = {}
	local okJoints, connected = pcall(part.GetConnectedParts, part, false)
	if okJoints then
		for _, other in connected do
			if other ~= part and not other.Anchored and not DestructionService.IsProtected(other) then
				table.insert(dependents, other)
			end
		end
	end

	local impactWorld = cframe:PointToWorldSpace(localHit)
	part:Destroy()

	for _, piece in loose do
		launch(piece, origin, speed)
		DestructionService.RegisterDebris(piece)
	end
	for _, other in dependents do
		if other.Parent then
			launch(other, origin, speed * 0.5)
			DestructionService.RegisterDebris(other)
		end
	end
	playCrumble(impactWorld)
	return pieces
end

function DestructionService.Fracture(part: BasePart, impactPoint: Vector3, impulse: number?): { BasePart }
	if not DestructionService.IsDestructible(part) then
		return {}
	end
	local power = DEFAULT_IMPULSE
	if type(impulse) == "number" and impulse == impulse then
		power = math.clamp(impulse, 0, MAX_IMPULSE)
	end
	local impact = impactPoint
	if typeof(impact) ~= "Vector3" or impact ~= impact then
		impact = part.Position
	end
	-- Impacto longe demais da part (argumento estranho): usa o ponto da part mais próximo.
	impact = PhysUtil.ClosestPointOnPart(part, impact)
	local ok, result =
		pcall(fracture, part, impact, releaseRadiusFor(power), math.min(power * 0.5, MAX_PIECE_SPEED), impact)
	if not ok then
		warn("[DestructionService] Erro ao quebrar '" .. part:GetFullName() .. "': " .. tostring(result))
		return {}
	end
	return result
end

-- Explosão ----------------------------------------------------------------------------------

function DestructionService.Explode(
	position: Vector3,
	radius: number,
	force: number,
	opts: {
		damagePlayers: number?,
		damageEnemies: number?,
		attacker: Player?,
		source: string?,
		visual: boolean?,
	}?
)
	if typeof(position) ~= "Vector3" or position ~= position then
		return
	end
	local blastRadius = math.clamp(tonumber(radius) or 10, 1, EXPLODE_MAX_RADIUS)
	local power = math.clamp(tonumber(force) or 60, 0, MAX_IMPULSE)
	local options = type(opts) == "table" and opts or {}
	ensureSetup()

	local visual = options.visual ~= false
	if visual then
		local explosion = Instance.new("Explosion")
		explosion.BlastPressure = 0
		explosion.BlastRadius = blastRadius
		explosion.DestroyJointRadiusPercent = 0
		explosion.ExplosionType = Enum.ExplosionType.NoCraters
		explosion.Position = position
		explosion.Parent = workspace
		SoundUtil.Play("Explosion", { Position = position, RollOffMaxDistance = 350, Volume = 0.9 })
	end

	-- 1. Classifica o que está no raio (antes de quebrar, para não empurrar duas vezes os pedaços novos).
	local params = PhysUtil.OverlapParams(true, 400)
	local found = workspace:GetPartBoundsInRadius(position, blastRadius, params)
	local destructibles = {}
	local pushed: { [BasePart]: boolean } = {}
	local pushList: { BasePart } = {}
	for _, part in found do
		if DestructionService.IsDestructible(part) then
			local point = PhysUtil.ClosestPointOnPart(part, position)
			table.insert(destructibles, { part = part, point = point, distance = (point - position).Magnitude })
		else
			local root = DestructionService.GetLooseRoot(part)
			if not root and not part.Anchored and CollectionService:HasTag(part, Tags.Debris) then
				root = part.AssemblyRootPart or part
			end
			if root and not pushed[root] and #pushList < EXPLODE_MAX_PUSH then
				pushed[root] = true
				table.insert(pushList, root)
			end
		end
	end

	-- 2. Quebra as parts mais próximas.
	table.sort(destructibles, function(a, b)
		return a.distance < b.distance
	end)
	for index = 1, math.min(#destructibles, EXPLODE_MAX_FRACTURES) do
		local item = destructibles[index]
		if item.part.Parent then
			local falloff = math.clamp(1 - item.distance / blastRadius, 0.25, 1)
			local hole = math.clamp(blastRadius - item.distance, MIN_RELEASE_RADIUS, MAX_RELEASE_RADIUS * 1.5)
			local ok, err =
				pcall(fracture, item.part, item.point, hole, math.min(power * falloff, MAX_PIECE_SPEED), position)
			if not ok then
				warn("[DestructionService] Erro ao quebrar na explosão: " .. tostring(err))
			end
		end
	end

	-- 3. Solta e empurra objetos e pedaços.
	for _, root in pushList do
		if root.Parent then
			local offset = root.Position - position
			local distance = offset.Magnitude
			local falloff = math.clamp(1 - distance / blastRadius, 0.15, 1)
			local direction = distance > 0.05 and offset.Unit or Vector3.yAxis
			local velocity = direction * power * falloff + Vector3.new(0, power * 0.35 * falloff, 0)
			if CollectionService:HasTag(root, Tags.LooseProp) then
				DestructionService.ReleaseProp(root, velocity)
			else
				DestructionService.Push(root, velocity, randomSpin(power * 0.1))
			end
		end
	end

	-- 4. Dano e empurrão em jogadores (só quando a explosão fere jogadores: sem fogo amigo) e inimigos.
	local damagePlayers = tonumber(options.damagePlayers) or 0
	if damagePlayers > 0 then
		local source = type(options.source) == "string" and options.source or "Explosão"
		local hits = CombatUtil.DamagePlayersInRadius(position, blastRadius, damagePlayers, source)
		for _, player in hits do
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if root and root:IsA("BasePart") then
				local away = PhysUtil.FlatUnit(root.Position - position, Vector3.xAxis)
				CombatUtil.Knockback(player, away, math.clamp(power * 0.6, 20, 110))
			end
		end
	end
	local damageEnemies = tonumber(options.damageEnemies) or 0
	if damageEnemies > 0 then
		local attacker = options.attacker
		if typeof(attacker) ~= "Instance" or not attacker:IsA("Player") then
			attacker = nil
		end
		CombatUtil.DamageEnemiesInRadius(position, blastRadius, damageEnemies, attacker)
	end

	-- 5. Tremor para quem está perto e clarão para quem está quase dentro.
	PhysUtil.Shake(position, blastRadius * 4, math.clamp(power / 100, 0.3, 1.6), 0.6)
	if visual then
		for _, hit in PhysUtil.PlayersInRadius(position, blastRadius * 1.5) do
			PhysUtil.Flash(hit.player, EXPLOSION_FLASH, 0.3)
		end
	end
end

-- Inicialização -------------------------------------------------------------------------------

function DestructionService.Init()
	if initialized then
		return
	end
	initialized = true
	-- Remotes usados por este serviço (existem antes de qualquer cliente pedir).
	Net.event(Net.Names.Fx_Play)
	Net.event(Net.Names.Notify)
	ensureSetup()
end

return DestructionService
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="29">
        <Properties>
          <string name="Name">EventHelpers</string>
        </Properties>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">GroundUtil</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Funções para achar o chão e pontos válidos perto de uma posição (spawn de NPCs, efeitos de eventos).
-- Ignora personagens, NPCs, pedaços de destruição e partes sem colisão.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")

local Tags = require(game:GetService("ReplicatedStorage").Shared.Tags)

local GroundUtil = {}

local function buildExcludeList(extra: { Instance }?): { Instance }
	local list = {}
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(list, player.Character)
		end
	end
	for _, enemy in CollectionService:GetTagged(Tags.Enemy) do
		table.insert(list, enemy)
	end
	local debrisFolder = workspace:FindFirstChild("Debris")
	if debrisFolder then
		table.insert(list, debrisFolder)
	end
	local eventsFolder = workspace:FindFirstChild("ActiveEvents")
	if eventsFolder then
		table.insert(list, eventsFolder)
	end
	if extra then
		for _, instance in extra do
			table.insert(list, instance)
		end
	end
	return list
end

-- Faz um raycast para baixo a partir de `position` (começando `startAbove` studs acima).
-- Retorna o ponto do chão e a part atingida, ou nil.
function GroundUtil.FindGround(
	position: Vector3,
	maxDrop: number?,
	startAbove: number?,
	exclude: { Instance }?
): (Vector3?, BasePart?)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = buildExcludeList(exclude)
	params.IgnoreWater = false
	local origin = position + Vector3.new(0, startAbove or 3, 0)
	local result = workspace:Raycast(origin, Vector3.new(0, -(maxDrop or 60), 0), params)
	if result and result.Instance and result.Instance.CanCollide then
		return result.Position, result.Instance :: BasePart
	end
	return nil, nil
end

-- Verifica se há linha de visão livre entre dois pontos (sem paredes no meio).
function GroundUtil.HasLineOfSight(from: Vector3, to: Vector3, exclude: { Instance }?): boolean
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = buildExcludeList(exclude)
	local direction = to - from
	local result = workspace:Raycast(from, direction, params)
	return result == nil or (result.Position - to).Magnitude < 1
end

-- Procura um ponto no chão perto de `center`, a uma distância entre minRadius e maxRadius,
-- com linha de visão a partir do centro (para não nascer do outro lado de uma parede).
-- Se não achar, devolve o chão sob o centro (ou o próprio centro).
function GroundUtil.RandomPointNear(
	center: Vector3,
	minRadius: number,
	maxRadius: number,
	random: Random?,
	attempts: number?
): Vector3
	local rng = random or Random.new()
	for _ = 1, attempts or 12 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local distance = rng:NextNumber(minRadius, maxRadius)
		local candidate = center + Vector3.new(math.cos(angle) * distance, 0, math.sin(angle) * distance)
		local ground = GroundUtil.FindGround(candidate, 30, 6)
		if ground and math.abs(ground.Y - center.Y) < 12 then
			local eye = center + Vector3.new(0, 3, 0)
			if GroundUtil.HasLineOfSight(eye, ground + Vector3.new(0, 3, 0)) then
				return ground
			end
		end
	end
	return GroundUtil.FindGround(center, 40, 4) or center
end

return GroundUtil
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">NpcEventUtil</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Utilitários dos eventos de inimigos (Macacos, Leão, Caçador, Aranhas, Mosquitos):
--   * sessão com limpeza idempotente: threads canceladas + NPC.DespawnGroup(ctx.instanceId);
--   * quantidade de jogadores vivos (para escalar o número de inimigos);
--   * nascimento em volta do ponto do evento (GroundUtil.RandomPointNear), olhando para o centro;
--   * ondas ao longo da duração: a próxima onda vem no intervalo ou logo depois que a atual morre;
--     se o limite global de NPCs estiver cheio, os que faltam nascem assim que houver vaga;
--     quando não há mais ondas e todos morreram, chama ctx.finish().
-- Nada aqui cede dentro do Start do evento: o trabalho que espera roda em threads da sessão.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)

local CombatUtil = require(script.Parent.Parent.CombatUtil)
local GroundUtil = require(script.Parent.GroundUtil)

local NpcEventUtil = {}

local TICK = 0.5
local SPAWN_STAGGER = 0.25 -- um inimigo a cada 0,25 s (nada de 12 modelos no mesmo frame)
local WAVE_BREATHER = 4 -- pausa entre uma onda derrotada e a próxima
local GIVE_UP_TIME = 12 -- sem vaga para os pendentes e ninguém vivo: o evento termina
local DEFAULT_MIN_RADIUS = 12

local Session = {}
Session.__index = Session

export type WaveOptions = {
	interval: number?, -- segundos entre o começo de uma onda e o da próxima
	startDelay: number?, -- espera antes da primeira onda
	health: number?,
	damage: number?,
	minRadius: number?,
	maxRadius: number?,
	waveMessage: string?, -- aviso para todos a partir da 2ª onda
	onSpawned: ((models: { Model }, wave: number) -> ())?,
}

-- Jogadores vivos agora (no mínimo 1).
function NpcEventUtil.AlivePlayerCount(ctx): number
	local combat = (type(ctx) == "table" and type(ctx.services) == "table" and ctx.services.Combat) or CombatUtil
	local ok, list = pcall(combat.GetAlivePlayers)
	local count = if ok and type(list) == "table" then #list else 0
	return math.max(count, 1)
end

-- Divide `total` inimigos em `waves` ondas (as primeiras ficam com o resto da divisão).
function NpcEventUtil.SplitWaves(total: number, waves: number): { number }
	local amount = math.max(math.floor(total), 1)
	local count = math.clamp(math.floor(waves), 1, amount)
	local base = math.floor(amount / count)
	local extra = amount - base * count
	local list = {}
	for index = 1, count do
		list[index] = base + (if index <= extra then 1 else 0)
	end
	return list
end

local notifyRemote: RemoteEvent? = nil

function NpcEventUtil.NotifyAll(text: string, kind: string?)
	if not notifyRemote then
		notifyRemote = Net.event(Net.Names.Notify)
	end
	(notifyRemote :: RemoteEvent):FireAllClients(text, kind or "info")
end

-- Sessão ------------------------------------------------------------------------------------------

function NpcEventUtil.new(ctx, label: string)
	local services = if type(ctx.services) == "table" then ctx.services else {}
	local npc = services.NPC
	if not npc or type(npc.Spawn) ~= "function" then
		warn(("[%s] NPCService indisponível: o evento não terá inimigos."):format(label))
		npc = nil
	end
	local self = setmetatable({
		ctx = ctx,
		label = label,
		npc = npc,
		ground = services.Ground or GroundUtil,
		threads = {},
		cleaned = false,
		spawnedTotal = 0,
	}, Session)
	return self
end

function Session:Active(): boolean
	return not self.cleaned and self.ctx.isActive()
end

-- task.spawn rastreado (cancelado na limpeza); erros viram aviso no Output.
function Session:Spawn(fn: (...any) -> (), ...: any): thread
	local label = self.label
	local thread = task.spawn(function(...)
		local ok, err = pcall(fn, ...)
		if not ok then
			warn(("[%s] Erro no evento: %s"):format(label, tostring(err)))
		end
	end, ...)
	table.insert(self.threads, thread)
	return thread
end

-- Espera `seconds` em fatias; devolve false se o evento acabou no meio.
function Session:Wait(seconds: number): boolean
	local deadline = os.clock() + seconds
	while self:Active() do
		local left = deadline - os.clock()
		if left <= 0 then
			return true
		end
		task.wait(math.min(left, TICK))
	end
	return false
end

function Session:CountAlive(): number
	local npc = self.npc
	if not npc then
		return 0
	end
	local ok, count = pcall(npc.CountAlive, self.ctx.instanceId)
	return if ok and type(count) == "number" then count else 0
end

-- Models vivos do evento (vazio se o NPCService não tiver GetGroup).
function Session:GetModels(): { Model }
	local npc = self.npc
	if not npc or type(npc.GetGroup) ~= "function" then
		return {}
	end
	local ok, models = pcall(npc.GetGroup, self.ctx.instanceId)
	return if ok and type(models) == "table" then models else {}
end

-- CFrame de nascimento: ponto no chão perto do evento, olhando para o centro.
function Session:SpawnPoint(minRadius: number?, maxRadius: number?): CFrame
	local ctx = self.ctx
	local center: Vector3 = ctx.position
	local minimum = minRadius or DEFAULT_MIN_RADIUS
	local maximum = maxRadius or math.max(ctx.radius * 0.6, minimum + 4)
	local point = self.ground.RandomPointNear(center, minimum, maximum, ctx.random)
	local flat = Vector3.new(center.X - point.X, 0, center.Z - point.Z)
	if flat.Magnitude < 0.5 then
		local angle = ctx.random:NextNumber(0, math.pi * 2)
		flat = Vector3.new(math.cos(angle), 0, math.sin(angle))
	end
	return CFrame.lookAt(point, point + flat.Unit)
end

-- Cria até `count` inimigos, um a cada SPAWN_STAGGER s (cede). Para no limite global de NPCs.
function Session:SpawnBatch(kind: string, count: number, options: WaveOptions?): (number, { Model })
	local opts = options or {}
	local models = {}
	local npc = self.npc
	if not npc then
		return 0, models
	end
	for index = 1, count do
		if not self:Active() then
			break
		end
		local cframe = self:SpawnPoint(opts.minRadius, opts.maxRadius)
		local ok, model = pcall(npc.Spawn, kind, cframe, {
			groupId = self.ctx.instanceId,
			health = opts.health,
			damage = opts.damage,
		})
		if not ok then
			warn(("[%s] Erro ao criar %s: %s"):format(self.label, kind, tostring(model)))
			break
		elseif not model then
			break -- limite de NPCs: tenta de novo depois
		end
		table.insert(models, model)
		self.spawnedTotal += 1
		if index < count then
			task.wait(SPAWN_STAGGER)
		end
	end
	return #models, models
end

-- Roda as ondas em uma thread da sessão e termina o evento quando todas forem derrotadas.
function Session:RunWaves(kind: string, waves: { number }, options: WaveOptions?)
	local opts = options or {}
	self:Spawn(function()
		local ctx = self.ctx
		if not self.npc then
			if self:Active() then
				ctx.finish()
			end
			return
		end
		if not self:Wait(opts.startDelay or 0.5) then
			return
		end
		local interval = opts.interval or 30
		local waveIndex = 0
		local pending = 0
		local nextWaveAt = 0
		local lastProgress = os.clock()
		while self:Active() do
			local now = os.clock()
			local alive = self:CountAlive()
			if waveIndex < #waves then
				if waveIndex > 0 and alive == 0 and pending == 0 then
					-- Onda derrotada antes do tempo: a próxima vem depois de um respiro.
					nextWaveAt = math.min(nextWaveAt, now + WAVE_BREATHER)
				end
				if now >= nextWaveAt then
					waveIndex += 1
					pending += waves[waveIndex]
					nextWaveAt = now + interval
					lastProgress = now
					if waveIndex > 1 and opts.waveMessage then
						NpcEventUtil.NotifyAll(opts.waveMessage, "warning")
					end
				end
			end
			if pending > 0 then
				local spawned, models = self:SpawnBatch(kind, pending, opts)
				pending -= spawned
				if spawned > 0 then
					lastProgress = os.clock()
					if opts.onSpawned then
						local ok, err = pcall(opts.onSpawned, models, waveIndex)
						if not ok then
							warn(("[%s] Erro depois de criar inimigos: %s"):format(self.label, tostring(err)))
						end
					end
				end
				alive = self:CountAlive()
			end
			if not self:Active() then
				return
			end
			if waveIndex >= #waves and alive == 0 then
				if pending == 0 or os.clock() - lastProgress >= GIVE_UP_TIME then
					ctx.finish()
					return
				end
			end
			task.wait(TICK)
		end
	end)
end

-- Limpeza idempotente: para as threads e remove os inimigos do evento.
function Session:Cleanup()
	if self.cleaned then
		return
	end
	self.cleaned = true
	local current = coroutine.running()
	for _, thread in self.threads do
		if thread ~= current and coroutine.status(thread) == "suspended" then
			pcall(task.cancel, thread)
		end
	end
	table.clear(self.threads)
	local npc = self.npc
	if npc and type(npc.DespawnGroup) == "function" then
		local ok, err = pcall(npc.DespawnGroup, self.ctx.instanceId)
		if not ok then
			warn(("[%s] Erro ao remover os inimigos: %s"):format(self.label, tostring(err)))
		end
	end
end

return NpcEventUtil
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">PhysCreatures</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Criaturas de blocos dos eventos físicos (rinoceronte, elefante e pelicano), feitas só com parts.
-- Cada criatura tem uma part raiz ancorada (o corpo) e as outras soldadas nela: para mover, basta mudar
-- `root.CFrame` (só a raiz replica para os clientes, bem mais leve que mover cada part).
-- As medidas são relativas ao corpo; a FRENTE da criatura aponta para o -Z local.

local PhysUtil = require(script.Parent.PhysUtil)

local PhysCreatures = {}

export type Creature = {
	model: Model,
	root: BasePart,
	footOffset: number, -- distância do centro da raiz até a sola dos pés
	halfWidth: number,
	frontReach: number, -- quanto a criatura avança à frente do centro (-Z)
	backReach: number,
	topY: number, -- topo da criatura em relação ao centro da raiz
	wings: { { part: BasePart, side: number, offset: CFrame } },
}

type Spec = {
	name: string,
	size: Vector3,
	offset: CFrame,
	color: Color3,
	material: Enum.Material?,
	shadow: boolean?,
	shape: Enum.PartType?,
}

local M = Enum.Material

local function spec(
	name: string,
	size: Vector3,
	offset: CFrame,
	color: Color3,
	material: Enum.Material?,
	shadow: boolean?,
	shape: Enum.PartType?
): Spec
	return {
		name = name,
		size = size,
		offset = offset,
		color = color,
		material = material,
		shadow = shadow,
		shape = shape,
	}
end

local function at(x: number, y: number, z: number): CFrame
	return CFrame.new(x, y, z)
end

-- Monta as parts a partir das especificações já na pose `cframe` (soldar fora do workspace exige que as
-- parts estejam na posição final relativa) e só então coloca o Model no pai.
local function assemble(name: string, parent: Instance, cframe: CFrame, specs: { Spec }): (Model, BasePart)
	local model = Instance.new("Model")
	model.Name = name
	local parts: { BasePart } = {}
	local root: BasePart = nil
	for index, item in specs do
		local part = PhysUtil.GhostPart({
			Name = item.name,
			Size = item.size,
			CFrame = cframe * item.offset,
			Color = item.color,
			Material = item.material or M.SmoothPlastic,
			CastShadow = item.shadow == true,
			Parent = model,
		})
		if item.shape then
			(part :: Part).Shape = item.shape
		end
		if index == 1 then
			root = part
		end
		table.insert(parts, part)
	end
	PhysUtil.WeldAll(root, parts)
	model.PrimaryPart = root
	model.Parent = parent
	return model, root
end

-- Rinoceronte (≈ 4 x 6,5 x 11 studs) ----------------------------------------------------------

local RHINO_SKIN = Color3.fromRGB(122, 118, 112)
local RHINO_DARK = Color3.fromRGB(92, 88, 84)
local HORN = Color3.fromRGB(222, 212, 188)

function PhysCreatures.Rhino(parent: Instance, cframe: CFrame): Creature
	local footOffset = 4.1
	local legY = -footOffset + 1.3
	local specs = {
		spec("Corpo", Vector3.new(4.2, 3.8, 7.5), at(0, 0, 0), RHINO_SKIN, M.Slate, true),
		spec("Cabeca", Vector3.new(2.6, 2.4, 2.8), at(0, -0.2, -4.9), RHINO_SKIN, M.Slate),
		spec("Focinho", Vector3.new(2, 1.6, 1.5), at(0, -0.7, -6.6), RHINO_DARK, M.Slate),
		spec("Chifre", Vector3.new(0.7, 1.9, 0.7), at(0, 0.5, -6.9) * CFrame.Angles(math.rad(-28), 0, 0), HORN),
		spec("ChifreMenor", Vector3.new(0.5, 1, 0.5), at(0, 0.5, -5.7) * CFrame.Angles(math.rad(-15), 0, 0), HORN),
		spec("OrelhaE", Vector3.new(0.35, 0.9, 0.35), at(-0.9, 1.3, -4.2), RHINO_DARK),
		spec("OrelhaD", Vector3.new(0.35, 0.9, 0.35), at(0.9, 1.3, -4.2), RHINO_DARK),
		spec("PataFE", Vector3.new(1.2, 2.6, 1.2), at(-1.4, legY, -2.4), RHINO_DARK, M.Slate),
		spec("PataFD", Vector3.new(1.2, 2.6, 1.2), at(1.4, legY, -2.4), RHINO_DARK, M.Slate),
		spec("PataTE", Vector3.new(1.2, 2.6, 1.2), at(-1.4, legY, 2.4), RHINO_DARK, M.Slate),
		spec("PataTD", Vector3.new(1.2, 2.6, 1.2), at(1.4, legY, 2.4), RHINO_DARK, M.Slate),
		spec("Rabo", Vector3.new(0.3, 1.3, 0.3), at(0, 0.6, 3.95) * CFrame.Angles(math.rad(25), 0, 0), RHINO_DARK),
	}
	local model, root = assemble("Rinoceronte", parent, cframe, specs)
	return {
		model = model,
		root = root,
		footOffset = footOffset,
		halfWidth = 2.2,
		frontReach = 7.4,
		backReach = 4.2,
		topY = 2.2,
		wings = {},
	}
end

-- Elefante (≈ 6 x 10,5 x 13 studs) ------------------------------------------------------------

local ELEPHANT_SKIN = Color3.fromRGB(132, 126, 124)
local ELEPHANT_DARK = Color3.fromRGB(104, 98, 96)
local TUSK = Color3.fromRGB(238, 230, 212)

function PhysCreatures.Elephant(parent: Instance, cframe: CFrame): Creature
	local footOffset = 6.6
	local legY = -footOffset + 2.1
	local specs = {
		spec("Corpo", Vector3.new(6, 5.6, 9.5), at(0, 0, 0), ELEPHANT_SKIN, M.Slate, true),
		spec("Cabeca", Vector3.new(4, 4, 3.4), at(0, 1.2, -5.8), ELEPHANT_SKIN, M.Slate),
		spec(
			"OrelhaE",
			Vector3.new(0.4, 3.8, 3.2),
			at(-2.3, 1.2, -4.9) * CFrame.Angles(0, math.rad(-20), 0),
			ELEPHANT_DARK
		),
		spec(
			"OrelhaD",
			Vector3.new(0.4, 3.8, 3.2),
			at(2.3, 1.2, -4.9) * CFrame.Angles(0, math.rad(20), 0),
			ELEPHANT_DARK
		),
		spec("Tromba1", Vector3.new(1.3, 2.4, 1.3), at(0, -1.2, -7.3), ELEPHANT_SKIN, M.Slate),
		spec("Tromba2", Vector3.new(1, 2.2, 1), at(0, -3.3, -7.6), ELEPHANT_SKIN, M.Slate),
		spec(
			"Tromba3",
			Vector3.new(0.8, 1.4, 0.8),
			at(0, -4.8, -7.2) * CFrame.Angles(math.rad(-25), 0, 0),
			ELEPHANT_DARK
		),
		spec("PresaE", Vector3.new(0.45, 0.45, 2.3), at(-0.9, -0.9, -8) * CFrame.Angles(math.rad(18), 0, 0), TUSK),
		spec("PresaD", Vector3.new(0.45, 0.45, 2.3), at(0.9, -0.9, -8) * CFrame.Angles(math.rad(18), 0, 0), TUSK),
		spec("PataFE", Vector3.new(1.9, 4.2, 1.9), at(-1.9, legY, -3.1), ELEPHANT_DARK, M.Slate),
		spec("PataFD", Vector3.new(1.9, 4.2, 1.9), at(1.9, legY, -3.1), ELEPHANT_DARK, M.Slate),
		spec("PataTE", Vector3.new(1.9, 4.2, 1.9), at(-1.9, legY, 3.1), ELEPHANT_DARK, M.Slate),
		spec("PataTD", Vector3.new(1.9, 4.2, 1.9), at(1.9, legY, 3.1), ELEPHANT_DARK, M.Slate),
		spec("Rabo", Vector3.new(0.35, 2, 0.35), at(0, 0.8, 4.95) * CFrame.Angles(math.rad(20), 0, 0), ELEPHANT_DARK),
	}
	local model, root = assemble("Elefante", parent, cframe, specs)
	return {
		model = model,
		root = root,
		footOffset = footOffset,
		halfWidth = 3.2,
		frontReach = 9.2,
		backReach = 5.2,
		topY = 3.4,
		wings = {},
	}
end

-- Pelicano (≈ 17 studs de envergadura) -----------------------------------------------------------

local FEATHER = Color3.fromRGB(242, 238, 230)
local FEATHER_GRAY = Color3.fromRGB(190, 188, 182)
local BEAK = Color3.fromRGB(242, 184, 64)
local POUCH = Color3.fromRGB(232, 148, 72)
local WING_TIP = Color3.fromRGB(44, 42, 40)

local WING_LENGTH = 7
local WING_ROOT = Vector3.new(1.4, 0.6, -0.2)

function PhysCreatures.Pelican(parent: Instance, cframe: CFrame): Creature
	local specs = {
		spec("Corpo", Vector3.new(3, 2.6, 5.5), at(0, 0, 0), FEATHER, M.SmoothPlastic, true),
		spec("Pescoco", Vector3.new(1, 2.4, 1), at(0, 1.6, -2.6), FEATHER),
		spec("Cabeca", Vector3.new(1.5, 1.4, 1.8), at(0, 2.9, -3.2), FEATHER),
		spec("Bico", Vector3.new(0.7, 0.4, 4.2), at(0, 2.7, -5.9), BEAK),
		spec("Papo", Vector3.new(0.8, 1, 3.4), at(0, 2.05, -5.6), POUCH),
		spec("OlhoE", Vector3.new(0.25, 0.25, 0.25), at(-0.76, 3.1, -3.5), WING_TIP),
		spec("OlhoD", Vector3.new(0.25, 0.25, 0.25), at(0.76, 3.1, -3.5), WING_TIP),
		spec("Cauda", Vector3.new(2.2, 0.4, 1.8), at(0, 0.3, 3.5), FEATHER_GRAY),
		spec("PeE", Vector3.new(0.5, 1.3, 0.5), at(-0.7, -1.8, 0.6), POUCH),
		spec("PeD", Vector3.new(0.5, 1.3, 0.5), at(0.7, -1.8, 0.6), POUCH),
	}
	local model, root = assemble("Pelicano", parent, cframe, specs)

	-- Asas: parts ancoradas à parte (batem as asas mudando o CFrame), cada uma com a ponta preta soldada.
	local wings = {}
	for _, side in { -1, 1 } do
		local offset = CFrame.new(WING_ROOT.X * side, WING_ROOT.Y, WING_ROOT.Z)
		local wingCFrame = cframe * offset * CFrame.new(side * WING_LENGTH / 2, 0, 0)
		local wing = PhysUtil.GhostPart({
			Name = side < 0 and "AsaE" or "AsaD",
			Size = Vector3.new(WING_LENGTH, 0.35, 3.2),
			CFrame = wingCFrame,
			Color = FEATHER,
			Material = M.SmoothPlastic,
			CastShadow = true,
		})
		local tip = PhysUtil.GhostPart({
			Name = "PontaDaAsa",
			Size = Vector3.new(2.4, 0.37, 3.2),
			CFrame = wingCFrame * CFrame.new(side * (WING_LENGTH / 2 - 1.2), 0, 0),
			Color = WING_TIP,
			Material = M.SmoothPlastic,
		})
		PhysUtil.WeldAll(wing, { tip })
		tip.Parent = wing
		wing.Parent = model
		table.insert(wings, { part = wing, side = side, offset = offset })
	end

	return {
		model = model,
		root = root,
		footOffset = 2.4,
		halfWidth = WING_LENGTH + WING_ROOT.X,
		frontReach = 8,
		backReach = 4.5,
		topY = 3.6,
		wings = wings,
	}
end

-- Posiciona as asas para um ângulo de batida (radianos; positivo = asas para cima).
function PhysCreatures.SetWings(creature: Creature, angle: number)
	local rootCFrame = creature.root.CFrame
	for _, wing in creature.wings do
		if wing.part.Parent then
			wing.part.CFrame = rootCFrame
				* wing.offset
				* CFrame.Angles(0, 0, wing.side * angle)
				* CFrame.new(wing.side * WING_LENGTH / 2, 0, 0)
		end
	end
end

return PhysCreatures
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">PhysUtil</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Utilitários compartilhados pelos eventos físicos (Debandada, Monção, Terremoto, Cipós, Areia Movediça,
-- Tornado, Pelicano):
--   * Trove: guarda conexões, instâncias, threads e funções para uma limpeza idempotente;
--   * consultas espaciais que ignoram personagens, NPCs, o tabuleiro e as pastas de eventos;
--   * tremor de câmera / avisos para os jogadores;
--   * modificadores de movimento empilháveis (vários eventos podem deixar o mesmo jogador lento ao
--     mesmo tempo sem que um "restaure" o valor errado do outro);
--   * pilha de iluminação com contagem de referência (eventos simultâneos escurecem/restauram certo).

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Net = require(ReplicatedStorage.Shared.Net)
local Tags = require(ReplicatedStorage.Shared.Tags)

local CombatUtil = require(script.Parent.Parent.CombatUtil)
local GroundUtil = require(script.Parent.GroundUtil)

local PhysUtil = {}

-- Texturas que já vêm com o cliente do Roblox (não precisam de upload).
PhysUtil.Textures = {
	Smoke = "rbxasset://textures/particles/smoke_main.dds",
	Sparkle = "rbxasset://textures/particles/sparkles_main.dds",
	Fire = "rbxasset://textures/particles/fire_main.dds",
}

-- Trove (limpeza) ----------------------------------------------------------------------------

local Trove = {}
Trove.__index = Trove

export type Trove = {
	Add: (self: any, item: any) -> any,
	Connect: (self: any, signal: RBXScriptSignal, handler: (...any) -> ()) -> RBXScriptConnection,
	Spawn: (self: any, fn: (...any) -> (), ...any) -> thread,
	Clean: (self: any) -> (),
	IsCleaned: (self: any) -> boolean,
}

local function cleanItem(item: any)
	local kind = typeof(item)
	if kind == "Instance" then
		item:Destroy()
	elseif kind == "RBXScriptConnection" then
		item:Disconnect()
	elseif kind == "thread" then
		-- Nunca cancela a própria thread que está limpando.
		if item ~= coroutine.running() and coroutine.status(item) ~= "dead" then
			task.cancel(item)
		end
	elseif kind == "function" then
		item()
	elseif kind == "table" then
		if type(item.Disconnect) == "function" then
			item:Disconnect()
		elseif type(item.Destroy) == "function" then
			item:Destroy()
		end
	end
end

function PhysUtil.newTrove(): Trove
	return setmetatable({ _items = {}, _cleaned = false }, Trove) :: any
end

-- Guarda um item para a limpeza. Depois da limpeza, o item é limpo na hora (threads atrasadas).
function Trove:Add(item: any): any
	if self._cleaned then
		local ok, err = pcall(cleanItem, item)
		if not ok then
			warn("[PhysUtil] Erro ao limpar item atrasado: " .. tostring(err))
		end
		return item
	end
	table.insert(self._items, item)
	return item
end

function Trove:Connect(signal: RBXScriptSignal, handler: (...any) -> ()): RBXScriptConnection
	return self:Add(signal:Connect(handler))
end

-- task.spawn rastreado (cancelado na limpeza).
function Trove:Spawn(fn: (...any) -> (), ...: any): thread
	return self:Add(task.spawn(fn, ...))
end

function Trove:Clean()
	if self._cleaned then
		return
	end
	self._cleaned = true
	local items = self._items
	self._items = {}
	for index = #items, 1, -1 do
		local ok, err = pcall(cleanItem, items[index])
		if not ok then
			warn("[PhysUtil] Erro na limpeza: " .. tostring(err))
		end
	end
end

function Trove:IsCleaned(): boolean
	return self._cleaned
end

-- Números e geometria -----------------------------------------------------------------------

function PhysUtil.Flat(vector: Vector3): Vector3
	return Vector3.new(vector.X, 0, vector.Z)
end

function PhysUtil.FlatDistance(a: Vector3, b: Vector3): number
	local dx, dz = a.X - b.X, a.Z - b.Z
	return math.sqrt(dx * dx + dz * dz)
end

-- Unitário horizontal (ou `fallback` se o vetor for quase vertical/nulo).
function PhysUtil.FlatUnit(vector: Vector3, fallback: Vector3?): Vector3
	local flat = Vector3.new(vector.X, 0, vector.Z)
	if flat.Magnitude < 1e-3 then
		return fallback or Vector3.new(0, 0, -1)
	end
	return flat.Unit
end

function PhysUtil.RandomFlatUnit(rng: Random): Vector3
	local angle = rng:NextNumber(0, math.pi * 2)
	return Vector3.new(math.cos(angle), 0, math.sin(angle))
end

-- Ponto da part (bloco) mais próximo de `point`.
function PhysUtil.ClosestPointOnPart(part: BasePart, point: Vector3): Vector3
	local half = part.Size / 2
	local localPoint = part.CFrame:PointToObjectSpace(point)
	local clamped = Vector3.new(
		math.clamp(localPoint.X, -half.X, half.X),
		math.clamp(localPoint.Y, -half.Y, half.Y),
		math.clamp(localPoint.Z, -half.Z, half.Z)
	)
	return part.CFrame:PointToWorldSpace(clamped)
end

-- Distância de um ponto a um segmento AB.
function PhysUtil.DistanceToSegment(point: Vector3, a: Vector3, b: Vector3): number
	local ab = b - a
	local lengthSq = ab:Dot(ab)
	if lengthSq < 1e-6 then
		return (point - a).Magnitude
	end
	local t = math.clamp((point - a):Dot(ab) / lengthSq, 0, 1)
	return (point - (a + ab * t)).Magnitude
end

-- Distância (no plano XZ) de `position` até a borda da ilha andando na direção `direction`.
function PhysUtil.DistanceToIslandEdge(mapInfo: any, position: Vector3, direction: Vector3): number
	local center = mapInfo and mapInfo.islandCenter or Vector3.zero
	local radius = mapInfo and mapInfo.islandRadius or 600
	local p = Vector3.new(position.X - center.X, 0, position.Z - center.Z)
	local d = PhysUtil.FlatUnit(direction)
	local b = p:Dot(d)
	local c = p:Dot(p) - radius * radius
	local discriminant = b * b - c
	if discriminant < 0 then
		return 0
	end
	return math.max(-b + math.sqrt(discriminant), 0)
end

-- Está dentro da ilha (com margem da borda)?
function PhysUtil.IsInsideIsland(mapInfo: any, position: Vector3, margin: number?): boolean
	local center = mapInfo and mapInfo.islandCenter or Vector3.zero
	local radius = mapInfo and mapInfo.islandRadius or 600
	return PhysUtil.FlatDistance(position, center) <= radius - (margin or 0)
end

-- Consultas espaciais -------------------------------------------------------------------------

local function addFolder(list: { Instance }, name: string)
	local folder = workspace:FindFirstChild(name)
	if folder then
		table.insert(list, folder)
	end
end

-- Lista de exclusão padrão: personagens, inimigos, tabuleiro, NPCs, eventos ativos e regiões.
function PhysUtil.ExcludeList(includeDebris: boolean?, extra: { Instance }?): { Instance }
	local list: { Instance } = {}
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(list, player.Character)
		end
	end
	for _, enemy in CollectionService:GetTagged(Tags.Enemy) do
		table.insert(list, enemy)
	end
	addFolder(list, "Board")
	addFolder(list, "NPCs")
	addFolder(list, "ActiveEvents")
	if not includeDebris then
		addFolder(list, "Debris")
	end
	local map = workspace:FindFirstChild("Map")
	local regions = map and map:FindFirstChild("Regions")
	if regions then
		table.insert(list, regions)
	end
	if extra then
		for _, instance in extra do
			table.insert(list, instance)
		end
	end
	return list
end

function PhysUtil.OverlapParams(includeDebris: boolean?, maxParts: number?, extra: { Instance }?): OverlapParams
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = PhysUtil.ExcludeList(includeDebris, extra)
	params.MaxParts = maxParts or 200
	return params
end

-- Raycast que só enxerga o cenário sólido (sem pedaços, personagens, eventos nem tabuleiro).
function PhysUtil.RaycastParams(extra: { Instance }?): RaycastParams
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = PhysUtil.ExcludeList(false, extra)
	params.IgnoreWater = true
	params.RespectCanCollide = true
	return params
end

-- Chão sob `position` ignorando também o tabuleiro (GroundUtil já ignora personagens, NPCs e pedaços).
function PhysUtil.GroundAt(position: Vector3, maxDrop: number?, startAbove: number?): (Vector3?, BasePart?)
	local exclude = {}
	addFolder(exclude, "Board")
	return GroundUtil.FindGround(position, maxDrop or 40, startAbove or 3, exclude)
end

-- Altura do chão no ponto do evento (o tabuleiro fica no chão; se estiver nas costas de alguém,
-- procura o chão logo abaixo).
function PhysUtil.EventGroundY(position: Vector3): number
	local ground = PhysUtil.GroundAt(position, 30, 1)
	if ground then
		return ground.Y
	end
	return position.Y
end

-- Primeiro obstáculo sólido acima de `position` (teto), até `maxHeight` studs.
function PhysUtil.CeilingAbove(position: Vector3, maxHeight: number): (Vector3?, BasePart?)
	local result = workspace:Raycast(position, Vector3.new(0, maxHeight, 0), PhysUtil.RaycastParams())
	if result then
		return result.Position, result.Instance :: BasePart
	end
	return nil, nil
end

-- Ponto aleatório dentro do volume de uma part (bloco).
function PhysUtil.RandomPointInPart(part: BasePart, rng: Random): Vector3
	local half = part.Size / 2
	return part.CFrame:PointToWorldSpace(
		Vector3.new(rng:NextNumber(-half.X, half.X), rng:NextNumber(-half.Y, half.Y), rng:NextNumber(-half.Z, half.Z))
	)
end

-- Serviços ----------------------------------------------------------------------------------

local fallbackModules: { [string]: any } = {}

-- require seguro de um módulo do servidor do jogo (caminho relativo a ServerScriptService.Game).
local function loadFallback(...: string): any
	local key = table.concat({ ... }, ".")
	if fallbackModules[key] ~= nil then
		return fallbackModules[key] or nil
	end
	local current: Instance? = script.Parent.Parent
	for _, name in { ... } do
		current = current and current:FindFirstChild(name)
	end
	local module = nil
	if current and current:IsA("ModuleScript") then
		local ok, result = pcall(require, current)
		if ok then
			module = result
		end
	end
	fallbackModules[key] = module or false
	return module
end

-- Serviços do EventContext com reserva: se o EventService não entregou algum, tenta carregar aqui.
-- Módulos de outros donos podem continuar nil (NPC, Map); quem usa precisa conferir.
function PhysUtil.Services(ctx: any): { [string]: any }
	local given = (type(ctx) == "table" and type(ctx.services) == "table") and ctx.services or {}
	return {
		Destruction = given.Destruction or loadFallback("DestructionService"),
		NPC = given.NPC or loadFallback("NPC", "NPCService"),
		Board = given.Board or loadFallback("BoardService"),
		Combat = given.Combat or CombatUtil,
		Map = given.Map or loadFallback("Map", "MapBuilder"),
		Ground = given.Ground or GroundUtil,
	}
end

-- Jogadores ---------------------------------------------------------------------------------

export type PlayerHit = { player: Player, root: BasePart, humanoid: Humanoid, distance: number }

-- Jogadores vivos com HumanoidRootPart dentro do raio (3D, ou só no plano XZ se `flat`).
function PhysUtil.PlayersInRadius(position: Vector3, radius: number, flat: boolean?): { PlayerHit }
	local result = {}
	for _, player in CombatUtil.GetAlivePlayers() do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if root and humanoid and root:IsA("BasePart") then
			local distance = if flat
				then PhysUtil.FlatDistance(root.Position, position)
				else (root.Position - position).Magnitude
			if distance <= radius then
				table.insert(result, { player = player, root = root, humanoid = humanoid, distance = distance })
			end
		end
	end
	return result
end

local fxRemote: RemoteEvent? = nil
local notifyRemote: RemoteEvent? = nil

local function getFx(): RemoteEvent
	if not fxRemote then
		fxRemote = Net.event(Net.Names.Fx_Play)
	end
	return fxRemote :: RemoteEvent
end

local function getNotify(): RemoteEvent
	if not notifyRemote then
		notifyRemote = Net.event(Net.Names.Notify)
	end
	return notifyRemote :: RemoteEvent
end

-- Treme a câmera de quem estiver até `reach` studs da origem (o cliente enfraquece com a distância).
function PhysUtil.Shake(origin: Vector3, reach: number, intensity: number, duration: number)
	local fx = getFx()
	local params = {
		intensity = math.clamp(intensity, 0.2, 2),
		duration = math.max(duration, 0.1),
		origin = origin,
		radius = reach,
	}
	for _, hit in PhysUtil.PlayersInRadius(origin, reach) do
		fx:FireClient(hit.player, "shake", params)
	end
end

function PhysUtil.Flash(player: Player, color: Color3?, duration: number?)
	getFx():FireClient(player, "flash", { color = color, duration = duration })
end

function PhysUtil.NotifyAll(text: string, kind: string?)
	getNotify():FireAllClients(text, kind or "info")
end

function PhysUtil.Notify(player: Player, text: string, kind: string?)
	getNotify():FireClient(player, text, kind or "info")
end

-- Cooldown simples por chave (jogador, part...). Retorna true se pode agir agora e marca o tempo.
function PhysUtil.newCooldown(seconds: number)
	local last: { [any]: number } = {}
	return function(key: any): boolean
		local now = os.clock()
		local previous = last[key]
		if previous and now - previous < seconds then
			return false
		end
		last[key] = now
		return true
	end
end

-- Modificadores de movimento ------------------------------------------------------------------
-- Cada efeito registra um modificador com uma chave própria; o valor aplicado é a combinação de todos
-- (menor velocidade, menor pulo, maior afundamento). Quando o último sai, os valores originais voltam.

export type Modifier = {
	walkSpeed: number?, -- teto de WalkSpeed
	jumpMultiplier: number?, -- multiplica JumpPower/JumpHeight (0..1)
	hipHeightOffset: number?, -- quanto o HipHeight desce (só R15; mínimo 0)
}

local modifierEntries: { [Humanoid]: any } = {}

local function releaseEntry(humanoid: Humanoid)
	local entry = modifierEntries[humanoid]
	if not entry then
		return
	end
	modifierEntries[humanoid] = nil
	for _, connection in entry.connections do
		connection:Disconnect()
	end
end

local function applyEntry(humanoid: Humanoid, entry)
	local base = entry.base
	local walkSpeed = base.walkSpeed
	local jumpMultiplier = 1
	local hipOffset = 0
	for _, modifier in entry.modifiers do
		if type(modifier.walkSpeed) == "number" then
			walkSpeed = math.min(walkSpeed, modifier.walkSpeed)
		end
		if type(modifier.jumpMultiplier) == "number" then
			jumpMultiplier = math.min(jumpMultiplier, math.clamp(modifier.jumpMultiplier, 0, 1))
		end
		if type(modifier.hipHeightOffset) == "number" then
			hipOffset = math.max(hipOffset, modifier.hipHeightOffset)
		end
	end
	humanoid.WalkSpeed = walkSpeed
	humanoid.JumpPower = base.jumpPower * jumpMultiplier
	humanoid.JumpHeight = base.jumpHeight * jumpMultiplier
	if base.isR15 then
		humanoid.HipHeight = math.max(base.hipHeight - hipOffset, 0)
	end
end

local function restoreEntry(humanoid: Humanoid, entry)
	local base = entry.base
	if humanoid.Parent and humanoid.Health > 0 then
		humanoid.WalkSpeed = base.walkSpeed
		humanoid.JumpPower = base.jumpPower
		humanoid.JumpHeight = base.jumpHeight
		if base.isR15 then
			humanoid.HipHeight = base.hipHeight
		end
	end
end

function PhysUtil.SetModifier(humanoid: Humanoid, key: string, modifier: Modifier)
	if typeof(humanoid) ~= "Instance" or not humanoid:IsA("Humanoid") or humanoid.Health <= 0 then
		return
	end
	local entry = modifierEntries[humanoid]
	if not entry then
		entry = {
			base = {
				walkSpeed = humanoid.WalkSpeed,
				jumpPower = humanoid.JumpPower,
				jumpHeight = humanoid.JumpHeight,
				hipHeight = humanoid.HipHeight,
				isR15 = humanoid.RigType == Enum.HumanoidRigType.R15,
			},
			modifiers = {},
			tokens = {},
			connections = {},
		}
		modifierEntries[humanoid] = entry
		-- Morreu ou saiu do jogo: não há o que restaurar.
		table.insert(
			entry.connections,
			humanoid.Died:Connect(function()
				releaseEntry(humanoid)
			end)
		)
		table.insert(
			entry.connections,
			humanoid.AncestryChanged:Connect(function()
				if not humanoid:IsDescendantOf(game) then
					releaseEntry(humanoid)
				end
			end)
		)
	end
	entry.modifiers[key] = modifier
	applyEntry(humanoid, entry)
end

function PhysUtil.ClearModifier(humanoid: Humanoid, key: string)
	local entry = modifierEntries[humanoid]
	if not entry or entry.modifiers[key] == nil then
		return
	end
	entry.modifiers[key] = nil
	entry.tokens[key] = nil
	if next(entry.modifiers) == nil then
		restoreEntry(humanoid, entry)
		releaseEntry(humanoid)
	else
		applyEntry(humanoid, entry)
	end
end

-- Modificador que sai sozinho depois de `seconds` (chamar de novo renova o tempo).
function PhysUtil.SetTimedModifier(humanoid: Humanoid, key: string, modifier: Modifier, seconds: number)
	PhysUtil.SetModifier(humanoid, key, modifier)
	local entry = modifierEntries[humanoid]
	if not entry then
		return
	end
	local token = {}
	entry.tokens[key] = token
	task.delay(seconds, function()
		local current = modifierEntries[humanoid]
		if current == entry and entry.tokens[key] == token then
			PhysUtil.ClearModifier(humanoid, key)
		end
	end)
end

-- Remove a chave de todos os humanoides (limpeza de um evento).
function PhysUtil.ClearModifiersWithKey(key: string)
	local humanoids = {}
	for humanoid, entry in modifierEntries do
		if entry.modifiers[key] ~= nil then
			table.insert(humanoids, humanoid)
		end
	end
	for _, humanoid in humanoids do
		PhysUtil.ClearModifier(humanoid, key)
	end
end

-- Iluminação com contagem de referência ---------------------------------------------------------
-- O primeiro evento que escurece guarda os valores originais; cada evento novo aplica o seu alvo;
-- ao sair, volta para o alvo do evento anterior que ainda está ativo ou para os valores originais.

export type LightingTarget = {
	Brightness: number?,
	ClockTime: number?,
	FogStart: number?,
	FogEnd: number?,
	AtmosphereDensity: number?,
}

local lightingStack: { { key: string, target: LightingTarget } } = {}
local lightingBase: LightingTarget? = nil
-- Valores originais enquanto a tween de volta ainda roda: um evento que começa nesse meio-tempo não pode
-- capturar a iluminação meio escura como "original" (ficaria escuro para sempre depois dele).
local restoringBase: LightingTarget? = nil
local restoringUntil = 0

local function captureLighting(): LightingTarget
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	return {
		Brightness = Lighting.Brightness,
		ClockTime = Lighting.ClockTime,
		FogStart = Lighting.FogStart,
		FogEnd = Lighting.FogEnd,
		AtmosphereDensity = atmosphere and atmosphere.Density or nil,
	}
end

local function tweenLighting(target: LightingTarget, seconds: number)
	local info = TweenInfo.new(math.max(seconds, 0.05), Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	local props = {}
	for _, name in { "Brightness", "ClockTime", "FogStart", "FogEnd" } do
		if type(target[name]) == "number" then
			props[name] = target[name]
		end
	end
	if next(props) then
		TweenService:Create(Lighting, info, props):Play()
	end
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmosphere and type(target.AtmosphereDensity) == "number" then
		TweenService:Create(atmosphere, info, { Density = math.clamp(target.AtmosphereDensity, 0, 1) }):Play()
	end
end

-- `makeTarget(base)` recebe os valores originais e devolve o alvo deste evento.
function PhysUtil.PushLighting(key: string, makeTarget: (LightingTarget) -> LightingTarget, seconds: number?)
	if not lightingBase then
		if restoringBase and os.clock() < restoringUntil then
			lightingBase = restoringBase
		else
			lightingBase = captureLighting()
		end
		restoringBase = nil
	end
	for index = #lightingStack, 1, -1 do
		if lightingStack[index].key == key then
			table.remove(lightingStack, index)
		end
	end
	local ok, target = pcall(makeTarget, table.clone(lightingBase :: LightingTarget))
	if not ok or type(target) ~= "table" then
		target = {}
	end
	table.insert(lightingStack, { key = key, target = target })
	local merged = table.clone(lightingBase :: LightingTarget)
	for name, value in target do
		merged[name] = value
	end
	tweenLighting(merged, seconds or 3)
end

function PhysUtil.PopLighting(key: string, seconds: number?)
	local removed = false
	for index = #lightingStack, 1, -1 do
		if lightingStack[index].key == key then
			table.remove(lightingStack, index)
			removed = true
		end
	end
	if not removed or not lightingBase then
		return
	end
	local base = lightingBase :: LightingTarget
	if #lightingStack == 0 then
		lightingBase = nil
		restoringBase = base
		restoringUntil = os.clock() + (seconds or 3) + 0.1
		tweenLighting(base, seconds or 3)
	else
		local merged = table.clone(base)
		for name, value in lightingStack[#lightingStack].target do
			merged[name] = value
		end
		tweenLighting(merged, seconds or 3)
	end
end

-- Construção ------------------------------------------------------------------------------------

-- Part decorativa de evento: ancorada, sem colisão, sem toque e invisível para consultas espaciais.
function PhysUtil.GhostPart(props: { [string]: any }): BasePart
	local part = Instance.new(props.ClassName or "Part")
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	for key, value in props do
		if key ~= "ClassName" and key ~= "Parent" then
			part[key] = value
		end
	end
	if props.Parent then
		part.Parent = props.Parent
	end
	return part
end

-- CFrame de um cilindro (eixo X do Roblox) indo de `a` até `b`.
function PhysUtil.CylinderBetween(a: Vector3, b: Vector3): (CFrame, number)
	local length = (b - a).Magnitude
	local middle = (a + b) / 2
	if length < 1e-3 then
		return CFrame.new(middle), 0
	end
	local up = math.abs((b - a).Unit.Y) > 0.98 and Vector3.xAxis or Vector3.yAxis
	return CFrame.lookAt(middle, b, up) * CFrame.Angles(0, math.pi / 2, 0), length
end

-- ParticleEmitter com propriedades (Color/Size/Transparency aceitam valores simples).
function PhysUtil.Emitter(parent: Instance, props: { [string]: any }): ParticleEmitter
	local emitter = Instance.new("ParticleEmitter")
	for key, value in props do
		if key == "Color" and typeof(value) == "Color3" then
			emitter.Color = ColorSequence.new(value)
		elseif (key == "Size" or key == "Transparency" or key == "Squash") and type(value) == "number" then
			emitter[key] = NumberSequence.new(value)
		else
			emitter[key] = value
		end
	end
	emitter.Parent = parent
	return emitter
end

-- Solda (WeldConstraint) as parts na raiz, deixando só a raiz ancorada.
function PhysUtil.WeldAll(root: BasePart, parts: { BasePart })
	for _, part in parts do
		if part ~= root then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = part
			weld.Parent = part
			part.Anchored = false
			part.Massless = true
		end
	end
end

return PhysUtil
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">EventService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Eventos do tabuleiro (servidor):
--   * carrega todo ModuleScript filho direto de Game/Events que tenha Id e Start;
--   * sorteia no Init o plano "casa -> evento" (pesos, MinSpace, sem repetir o mesmo evento em sequência);
--   * inicia instâncias (pasta workspace.ActiveEvents/<instanceId>, EventContext do contrato),
--     agenda o fim, chama o cleanup e avisa os clientes (Event_Started / Event_Ended / Notify).
-- Um evento com erro nunca derruba o serviço: tudo que vem dos módulos de evento roda em pcall.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local Net = require(ReplicatedStorage.Shared.Net)

local BoardService = require(script.Parent.BoardService)
local CombatUtil = require(script.Parent.CombatUtil)
local GroundUtil = require(script.Parent.EventHelpers.GroundUtil)

local EventService = {}

local FALLBACK_RIDDLE = "Um tambor distante começa a soar;\na selva acordou e vem te visitar."
local CLEANUP_TIMEOUT = 30 -- a pasta do evento é destruída mesmo que o cleanup trave

local initialized = false
local mapInfo = nil
local remotes: { [string]: RemoteEvent } = {}
local activeFolder: Folder = nil
local services: { [string]: any } = {}
local definitions: { [string]: any } = {}
local order: { string } = {} -- ids em ordem alfabética (sorteio determinístico dado o Random)
local plan: { [number]: string } = {}
local lastPlannedId: string? = nil
local active: { any } = {} -- registros em ordem de início (o primeiro é o mais antigo)
local counter = 0
local random = Random.new()

-- Utilitários ---------------------------------------------------------------------------

-- require seguro de um módulo de outro dono: um módulo ausente ou quebrado vira nil (com aviso).
local function tryRequire(...: string): any
	local current: Instance? = script.Parent
	local path = {}
	for _, name in { ... } do
		table.insert(path, name)
		current = current and current:FindFirstChild(name)
	end
	local label = table.concat(path, ".")
	if not current or not current:IsA("ModuleScript") then
		warn(("[EventService] Módulo '%s' não encontrado; os eventos terão esse serviço como nil."):format(label))
		return nil
	end
	local ok, result = pcall(require, current)
	if not ok then
		warn(("[EventService] Erro ao carregar '%s': %s"):format(label, tostring(result)))
		return nil
	end
	return result
end

local function positiveNumber(value: any, default: number, min: number, max: number): number
	if type(value) ~= "number" or value ~= value then
		return default
	end
	return math.clamp(value, min, max)
end

-- Copia a definição preenchendo valores padrão e descartando campos inválidos.
local function normalize(definition: any, moduleName: string)
	local result = table.clone(definition)
	result.DisplayName = (type(definition.DisplayName) == "string" and definition.DisplayName ~= "")
			and definition.DisplayName
		or definition.Id
	result.Kind = (definition.Kind == "npc" or definition.Kind == "physical") and definition.Kind or "physical"
	result.Weight = positiveNumber(definition.Weight, 1, 0.01, 1000)
	result.MinSpace = math.floor(positiveNumber(definition.MinSpace, 1, 1, GameConfig.BOARD_SPACES))
	result.Duration = positiveNumber(definition.Duration, 60, 5, 900)
	result.Radius = positiveNumber(definition.Radius, GameConfig.EVENT_DEFAULT_RADIUS, 4, 1000)
	local riddles = {}
	if type(definition.Riddles) == "table" then
		for _, riddle in definition.Riddles do
			if type(riddle) == "string" and riddle ~= "" then
				table.insert(riddles, riddle)
			end
		end
	end
	if #riddles == 0 then
		warn(
			("[EventService] O evento '%s' não tem enigmas válidos; usando um enigma genérico."):format(
				definition.Id
			)
		)
	end
	result.Riddles = riddles
	if definition.Id ~= moduleName then
		warn(("[EventService] O Id '%s' é diferente do nome do arquivo '%s'."):format(definition.Id, moduleName))
	end
	return result
end

local function loadDefinitions()
	local folder = script.Parent:FindFirstChild("Events")
	if not folder then
		warn("[EventService] Pasta Game/Events não encontrada: nenhum evento vai acontecer.")
		return
	end
	for _, child in folder:GetChildren() do
		if child:IsA("ModuleScript") then
			local ok, definition = pcall(require, child)
			if not ok then
				warn(("[EventService] Erro ao carregar o evento '%s': %s"):format(child.Name, tostring(definition)))
			elseif
				type(definition) ~= "table"
				or type(definition.Id) ~= "string"
				or definition.Id == ""
				or type(definition.Start) ~= "function"
			then
				warn(("[EventService] '%s' não é um evento válido (precisa de Id e Start)."):format(child.Name))
			elseif definitions[definition.Id] then
				warn(("[EventService] Id de evento repetido: '%s' (ignorado)."):format(definition.Id))
			else
				definitions[definition.Id] = normalize(definition, child.Name)
				table.insert(order, definition.Id)
			end
		end
	end
	table.sort(order)
	if #order == 0 then
		warn("[EventService] Nenhum evento carregado: as jogadas vão andar a peça, mas nada vai acontecer.")
	else
		print(("[EventService] %d evento(s) carregado(s): %s"):format(#order, table.concat(order, ", ")))
	end
end

-- Sorteio ---------------------------------------------------------------------------------

local function pickWeighted(list: { any }): string?
	local totalWeight = 0
	for _, definition in list do
		totalWeight += definition.Weight
	end
	if #list == 0 or totalWeight <= 0 then
		return nil
	end
	local roll = random:NextNumber(0, totalWeight)
	for _, definition in list do
		roll -= definition.Weight
		if roll <= 0 then
			return definition.Id
		end
	end
	return list[#list].Id
end

-- Escolhe um evento para a casa. Tenta, em ordem: respeitar MinSpace e evitar `exclude` e `avoid`;
-- depois só MinSpace e `exclude`; depois o(s) de menor MinSpace. Retorna nil se não houver eventos.
local function pickFor(spaceIndex: number, exclude: string?, avoid: { [string]: boolean }?): string?
	local strict, relaxed = {}, {}
	for _, id in order do
		local definition = definitions[id]
		if definition.MinSpace <= spaceIndex and id ~= exclude then
			table.insert(relaxed, definition)
			if not (avoid and avoid[id]) then
				table.insert(strict, definition)
			end
		end
	end
	local picked = pickWeighted(strict) or pickWeighted(relaxed)
	if picked then
		return picked
	end

	-- Nenhum elegível pela casa: usa os de menor MinSpace (preferindo não repetir).
	local lowest = math.huge
	for _, id in order do
		lowest = math.min(lowest, definitions[id].MinSpace)
	end
	local fallback, fallbackAny = {}, {}
	for _, id in order do
		local definition = definitions[id]
		if definition.MinSpace == lowest then
			table.insert(fallbackAny, definition)
			if id ~= exclude then
				table.insert(fallback, definition)
			end
		end
	end
	return pickWeighted(fallback) or pickWeighted(fallbackAny)
end

local function buildPlan()
	table.clear(plan)
	local previous: string? = nil
	for spaceIndex = 1, GameConfig.BOARD_SPACES do
		local id = pickFor(spaceIndex, previous, nil)
		if id then
			plan[spaceIndex] = id
			previous = id
		end
	end
end

-- Ciclo de vida das instâncias -----------------------------------------------------------

local function removeFromActive(record)
	local index = table.find(active, record)
	if index then
		table.remove(active, index)
	end
end

local function stopRecord(record, natural: boolean?)
	if record.stopped then
		return
	end
	if record.starting then
		-- Start ainda está rodando: termina assim que ele devolver o cleanup.
		record.active = false
		record.pendingStop = true
		return
	end
	record.stopped = true
	record.active = false
	if record.timer and coroutine.running() ~= record.timer then
		pcall(task.cancel, record.timer)
	end
	removeFromActive(record)

	-- O cleanup pode ceder (ex.: fade de NPCs): roda em outra thread e só então destrói a pasta.
	local folder = record.folder
	local cleanup = record.cleanup
	-- Rede de segurança: os NPCs do evento usam groupId = instanceId. Se o Start falhou (sem cleanup)
	-- ou o cleanup quebrou/travou, eles sumiriam nunca.
	local function despawnGroup()
		local npc = services.NPC
		if npc and type(npc.DespawnGroup) == "function" then
			pcall(npc.DespawnGroup, record.instanceId)
		end
	end
	task.spawn(function()
		if cleanup then
			local ok, err = pcall(cleanup)
			if not ok then
				warn(("[EventService] Erro no cleanup de '%s': %s"):format(record.instanceId, tostring(err)))
			end
		end
		despawnGroup()
		if folder and folder.Parent then
			folder:Destroy()
		end
	end)
	task.delay(CLEANUP_TIMEOUT, function()
		despawnGroup()
		if folder and folder.Parent then
			folder:Destroy()
		end
	end)

	remotes.ended:FireAllClients(record.instanceId)
	if natural then
		remotes.notify:FireAllClients(("%s acabou."):format(record.definition.DisplayName), "info")
	end
end

local function regionNameAt(position: Vector3): string?
	local map = services.Map
	if not map or type(map.GetRegionAt) ~= "function" then
		return nil
	end
	local ok, region = pcall(map.GetRegionAt, position)
	if ok and type(region) == "table" and type(region.name) == "string" then
		return region.name
	end
	return nil
end

local function watchReady(player: Player)
	local function sendActive()
		if not player.Parent or not player:GetAttribute("ClientReady") then
			return
		end
		-- Quem chega no meio recebe os eventos em andamento com a duração que ainda falta.
		for _, record in active do
			local info = table.clone(record.info)
			info.duration = math.max(record.definition.Duration - (os.clock() - record.startedAt), 0)
			remotes.started:FireClient(player, info)
		end
	end
	player:GetAttributeChangedSignal("ClientReady"):Connect(sendActive)
	sendActive()
end

-- API pública ----------------------------------------------------------------------------

function EventService.Init(info)
	if initialized then
		return
	end
	initialized = true
	mapInfo = info

	remotes.started = Net.event(Net.Names.Event_Started)
	remotes.ended = Net.event(Net.Names.Event_Ended)
	remotes.notify = Net.event(Net.Names.Notify)
	remotes.ready = Net.event(Net.Names.Game_ClientReady)

	local existing = workspace:FindFirstChild("ActiveEvents")
	if existing and existing:IsA("Folder") then
		activeFolder = existing
	else
		local folder = Instance.new("Folder")
		folder.Name = "ActiveEvents"
		folder.Parent = workspace
		activeFolder = folder
	end

	services = {
		Destruction = tryRequire("DestructionService"),
		NPC = tryRequire("NPC", "NPCService"),
		Board = BoardService,
		Combat = CombatUtil,
		Map = tryRequire("Map", "MapBuilder"),
		Ground = GroundUtil,
	}

	loadDefinitions()
	buildPlan()

	remotes.ready.OnServerEvent:Connect(function(player)
		if not player:GetAttribute("ClientReady") then
			player:SetAttribute("ClientReady", true)
		end
	end)
	Players.PlayerAdded:Connect(watchReady)
	for _, player in Players:GetPlayers() do
		watchReady(player)
	end
end

function EventService.GetDefinition(eventId: string)
	return definitions[eventId]
end

-- Evento planejado para a casa. Evita repetir o último evento sorteado e eventos ainda ativos
-- (quando há alternativa). Retorna "" se nenhum evento foi carregado.
function EventService.EventForSpace(spaceIndex: number): string
	if #order == 0 then
		return ""
	end
	local index = math.clamp(math.floor(tonumber(spaceIndex) or 1), 1, GameConfig.BOARD_SPACES)
	local id = plan[index] or pickFor(index, lastPlannedId, nil)
	local activeIds = {}
	for _, record in active do
		activeIds[record.eventId] = true
	end
	if id == lastPlannedId or activeIds[id] then
		local alternative = pickFor(index, lastPlannedId, activeIds)
		if alternative then
			id = alternative
			plan[index] = alternative
		end
	end
	lastPlannedId = id
	return id or ""
end

-- Um dos enigmas do evento (ao acaso).
function EventService.GetRiddle(eventId: string): string
	local definition = definitions[eventId]
	if not definition or #definition.Riddles == 0 then
		return FALLBACK_RIDDLE
	end
	return definition.Riddles[random:NextInteger(1, #definition.Riddles)]
end

-- Inicia o evento em `position` e devolve o id da instância ("" se o evento não existe).
function EventService.Start(eventId: string, position: Vector3): string
	local definition = definitions[eventId]
	if not initialized or not definition then
		warn(("[EventService] Evento desconhecido: %s"):format(tostring(eventId)))
		return ""
	end
	if typeof(position) ~= "Vector3" then
		position = BoardService.GetBoardPosition()
	end

	-- Limite de eventos simultâneos: o mais antigo termina.
	local maxActive = math.max(math.floor(GameConfig.MAX_ACTIVE_EVENTS), 1)
	while #active >= maxActive do
		stopRecord(active[1], false)
		-- Segurança: se o registro não saiu da lista (ainda iniciando), remove à força.
		if active[1] and active[1].pendingStop then
			table.remove(active, 1)
		end
	end

	counter += 1
	local instanceId = ("%s_%d"):format(definition.Id, counter)
	local folder = Instance.new("Folder")
	folder.Name = instanceId
	folder.Parent = activeFolder

	local regionName = regionNameAt(position)
	local record = {
		instanceId = instanceId,
		eventId = definition.Id,
		definition = definition,
		folder = folder,
		active = true,
		stopped = false,
		starting = true,
		pendingStop = false,
		startedAt = os.clock(),
		cleanup = nil,
		timer = nil,
		info = {
			id = instanceId,
			eventId = definition.Id,
			name = definition.DisplayName,
			position = position,
			radius = definition.Radius,
			duration = definition.Duration,
			regionName = regionName,
		},
	}
	table.insert(active, record)

	local context = {
		instanceId = instanceId,
		eventId = definition.Id,
		position = position,
		radius = definition.Radius,
		duration = definition.Duration,
		mapInfo = mapInfo,
		folder = folder,
		random = Random.new(),
		isActive = function(): boolean
			return record.active
		end,
		finish = function()
			if record.stopped or record.pendingStop then
				return
			end
			record.active = false
			if record.starting then
				record.pendingStop = true
			else
				task.defer(stopRecord, record, true)
			end
		end,
		services = services,
	}

	remotes.started:FireAllClients(record.info)
	remotes.notify:FireAllClients(
		("Evento: %s — %s"):format(definition.DisplayName, regionName or "perto do tabuleiro"),
		"warning"
	)

	local ok, result = pcall(definition.Start, context)
	record.starting = false
	if not ok then
		warn(("[EventService] Erro ao iniciar '%s': %s"):format(definition.Id, tostring(result)))
		record.pendingStop = true
	elseif type(result) == "function" then
		record.cleanup = result
	end

	if record.pendingStop then
		stopRecord(record, ok)
	else
		record.timer = task.delay(definition.Duration, stopRecord, record, true)
	end
	return instanceId
end

-- Encerra todos os eventos ativos (vitória / derrota).
function EventService.StopAll()
	for _, record in table.clone(active) do
		stopRecord(record, false)
	end
	table.clear(active)
end

-- Lista dos eventos ativos (payloads EventInfoPayload).
function EventService.GetActive()
	local list = {}
	for _, record in active do
		table.insert(list, table.clone(record.info))
	end
	return list
end

return EventService
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="35">
        <Properties>
          <string name="Name">Events</string>
        </Properties>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Earthquake</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Evento físico "Terremoto": a câmera treme forte num raio grande, partes Destructible próximas racham e
-- quebram aos poucos, objetos soltos tombam, pedaços do teto e lustres despencam (machucam quem estiver
-- embaixo) e fendas brilhando como brasa se abrem no chão (empurram e queimam quem pisa nelas).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local SoundUtil = require(ReplicatedStorage.Shared.Audio.SoundUtil)

local PhysUtil = require(script.Parent.Parent.EventHelpers.PhysUtil)

local SHAKE_INTERVAL = 1
local SHAKE_INTENSITY = 1.5
local BREAK_INTERVAL = 0.6
local BREAK_IMPULSE = 35
local MAX_FRACTURES = 45
local REFRESH_INTERVAL = 6
local MAX_QUERY_PARTS = 500
local PROPS_PER_TICK = 2
local CEILING_INTERVAL = 1.3
local CEILING_MAX_HEIGHT = 40
local MAX_FALLING = 6
local FALLING_LIFETIME = 10
local FALL_DAMAGE = 15
local FISSURE_INTERVAL = 2.5
local MAX_FISSURES = 8
local MAX_FISSURE_LIGHTS = 4
local FISSURE_DAMAGE = 10
local FISSURE_PUSH = 50
local FISSURE_COOLDOWN = 1
local HAZARD_INTERVAL = 0.12
local STUMBLE_INTERVAL = 2.5
local STUMBLE_STRENGTH = 12
local SOURCE_CEILING = "Desabamento"
local SOURCE_FISSURE = "Fenda do terremoto"

local CRACK_COLOR = Color3.fromRGB(34, 24, 20)
local LAVA_COLOR = Color3.fromRGB(255, 96, 30)
local GOLD = Color3.fromRGB(196, 156, 64)
local WARM_LIGHT = Color3.fromRGB(255, 214, 150)
local PLASTER = Color3.fromRGB(214, 204, 186)
local DUST = Color3.fromRGB(196, 184, 164)

return {
	Id = "Earthquake",
	DisplayName = "Terremoto",
	Kind = "physical",
	Riddles = {
		"A terra ruge, racha e range sem parar;\nlustres despencam: não fique a admirar.",
		"Quando o chão dança sem ninguém tocar,\no teto despenca e o fogo vem te queimar.",
		"Brasas acordam nas rachaduras do chão;\nnem a mansão inteira escapa da agitação.",
	},
	Weight = 0.7,
	MinSpace = 14,
	Duration = 30,
	Radius = 80,

	Start = function(ctx)
		local trove = PhysUtil.newTrove()
		local services = PhysUtil.Services(ctx)
		local Destruction = services.Destruction
		local Combat = services.Combat
		local Ground = services.Ground
		local rng = ctx.random
		local center = ctx.position
		local radius = ctx.radius
		local groundY = PhysUtil.EventGroundY(center)

		-- Som contínuo no centro.
		local soundPart = PhysUtil.GhostPart({
			Name = "SomDoTerremoto",
			Size = Vector3.one,
			CFrame = CFrame.new(center.X, groundY + 4, center.Z),
			Transparency = 1,
			Parent = ctx.folder,
		})
		trove:Add(soundPart)
		SoundUtil.Play("Earthquake", { Parent = soundPart, Looped = true, Volume = 1, RollOffMaxDistance = radius * 4 })

		-- Candidatos (atualizados de tempos em tempos) -----------------------------------------
		local candidates: { BasePart } = {}
		local props: { BasePart } = {}
		local function refresh()
			table.clear(candidates)
			table.clear(props)
			if not Destruction then
				return
			end
			local seen = {}
			local found =
				workspace:GetPartBoundsInRadius(center, radius, PhysUtil.OverlapParams(false, MAX_QUERY_PARTS))
			for _, part in found do
				if Destruction.IsDestructible(part) then
					table.insert(candidates, part)
				else
					local root = Destruction.GetLooseRoot(part)
					if root and root.Anchored and not seen[root] then
						seen[root] = true
						table.insert(props, root)
					end
				end
			end
		end

		local function takeRandom(list: { BasePart }): BasePart?
			while #list > 0 do
				local index = rng:NextInteger(1, #list)
				local part = list[index]
				list[index] = list[#list]
				list[#list] = nil
				if part.Parent then
					return part
				end
			end
			return nil
		end

		-- Fendas -------------------------------------------------------------------------------
		local fissures = {}
		local function spawnFissure()
			local point = Ground.RandomPointNear(center, 6, radius * 0.85, rng, 6)
			if math.abs(point.Y - groundY) > 12 then
				return
			end
			local width = rng:NextNumber(1.4, 2.2)
			local length = rng:NextNumber(10, 18)
			local cframe = CFrame.new(point + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0)
			local crack = PhysUtil.GhostPart({
				Name = "Fenda",
				Size = Vector3.new(width, 0.24, 0.5),
				CFrame = cframe,
				Color = CRACK_COLOR,
				Material = Enum.Material.Slate,
				Parent = ctx.folder,
			})
			local glow = PhysUtil.GhostPart({
				Name = "Brasa",
				Size = Vector3.new(width * 0.45, 0.26, 0.4),
				CFrame = cframe,
				Color = LAVA_COLOR,
				Material = Enum.Material.Neon,
				Parent = ctx.folder,
			})
			trove:Add(crack)
			trove:Add(glow)
			if #fissures < MAX_FISSURE_LIGHTS then
				local light = Instance.new("PointLight")
				light.Color = LAVA_COLOR
				light.Range = 10
				light.Brightness = 2
				light.Shadows = false
				light.Parent = glow
			end
			PhysUtil.Emitter(glow, {
				Texture = PhysUtil.Textures.Sparkle,
				Color = LAVA_COLOR,
				Size = 0.35,
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.1),
					NumberSequenceKeypoint.new(1, 1),
				}),
				Lifetime = NumberRange.new(0.8, 1.4),
				Rate = 5,
				Speed = NumberRange.new(3, 7),
				EmissionDirection = Enum.NormalId.Top,
				SpreadAngle = Vector2.new(20, 20),
				LightEmission = 1,
			})
			local info = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			TweenService:Create(crack, info, { Size = Vector3.new(width, 0.24, length) }):Play()
			TweenService:Create(glow, info, { Size = Vector3.new(width * 0.45, 0.26, length - 0.8) }):Play()
			SoundUtil.Play("Crumble", { Position = point, RollOffMaxDistance = 150, Volume = 0.7 })
			table.insert(fissures, { cframe = cframe, halfWidth = width / 2, halfLength = length / 2 })
		end

		-- Pedaços do teto e lustres ---------------------------------------------------------------
		local falling = {}
		local function puff(position: Vector3)
			local holder = PhysUtil.GhostPart({
				Name = "Poeira",
				Size = Vector3.one,
				CFrame = CFrame.new(position),
				Transparency = 1,
				Parent = ctx.folder,
			})
			local emitter = PhysUtil.Emitter(holder, {
				Texture = PhysUtil.Textures.Smoke,
				Color = DUST,
				Size = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 1.5),
					NumberSequenceKeypoint.new(1, 4),
				}),
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.4),
					NumberSequenceKeypoint.new(1, 1),
				}),
				Lifetime = NumberRange.new(0.8, 1.3),
				Rate = 0,
				Speed = NumberRange.new(2, 5),
				SpreadAngle = Vector2.new(180, 180),
				Acceleration = Vector3.new(0, -4, 0),
			})
			emitter:Emit(10)
			task.delay(2, function()
				if holder.Parent then
					holder:Destroy()
				end
			end)
		end

		local function spawnFalling(ceiling: Vector3, ceilingPart: BasePart?)
			if #falling >= MAX_FALLING then
				return
			end
			local parts: { BasePart } = {}
			local root: BasePart
			if rng:NextNumber() < 0.25 then
				-- Lustre: aro dourado com o globo de luz soldado.
				root = PhysUtil.GhostPart({
					Name = "LustreCaindo",
					Shape = Enum.PartType.Cylinder,
					Size = Vector3.new(0.5, 3.4, 3.4),
					CFrame = CFrame.new(ceiling - Vector3.new(0, 1.6, 0)) * CFrame.Angles(0, 0, math.rad(90)),
					Color = GOLD,
					Material = Enum.Material.Metal,
				})
				local globe = PhysUtil.GhostPart({
					Name = "Globo",
					Shape = Enum.PartType.Ball,
					Size = Vector3.new(1.2, 1.2, 1.2),
					CFrame = CFrame.new(ceiling - Vector3.new(0, 2.2, 0)),
					Color = WARM_LIGHT,
					Material = Enum.Material.Neon,
				})
				table.insert(parts, globe)
			else
				local size = Vector3.new(rng:NextNumber(1.6, 3.2), rng:NextNumber(0.8, 1.4), rng:NextNumber(1.6, 3.2))
				local color, material = PLASTER, Enum.Material.Plaster
				if ceilingPart and ceilingPart:IsA("BasePart") then
					color, material = ceilingPart.Color, ceilingPart.Material
				end
				root = PhysUtil.GhostPart({
					Name = "PedacoDoTeto",
					Size = size,
					CFrame = CFrame.new(ceiling - Vector3.new(0, size.Y / 2 + 0.15, 0))
						* CFrame.Angles(0, rng:NextNumber(0, math.pi), 0),
					Color = color,
					Material = material,
				})
			end
			table.insert(parts, 1, root)
			PhysUtil.WeldAll(root, parts)
			for _, part in parts do
				part.CanCollide = true
				part.CanQuery = true
				part.CanTouch = true
				part.Parent = ctx.folder
			end
			root.Anchored = false
			if Destruction then
				Destruction.Push(
					root,
					Vector3.new(0, -8, 0),
					Vector3.new(rng:NextNumber(-2, 2), 0, rng:NextNumber(-2, 2))
				)
				Destruction.RegisterDebris(root, FALLING_LIFETIME)
			end
			table.insert(falling, { part = root, spawned = os.clock(), hit = {} })
			puff(ceiling - Vector3.new(0, 0.5, 0))
			SoundUtil.Play("Crumble", { Position = ceiling, RollOffMaxDistance = 120, Volume = 0.6 })
		end

		-- Laços ------------------------------------------------------------------------------------

		-- Tremor, quebra de partes e objetos tombando.
		trove:Spawn(function()
			refresh()
			local fractures = 0
			local lastRefresh = os.clock()
			local lastShake = 0
			local lastStumble = os.clock()
			local started = os.clock()
			while ctx.isActive() do
				local now = os.clock()
				if now - lastShake >= SHAKE_INTERVAL then
					lastShake = now
					PhysUtil.Shake(center, radius * 2.5, SHAKE_INTENSITY, SHAKE_INTERVAL + 0.3)
				end
				if now - lastRefresh >= REFRESH_INTERVAL then
					lastRefresh = now
					refresh()
				end
				if Destruction then
					-- No meio do terremoto (o pico) quebram duas partes por vez.
					local elapsed = now - started
					local perTick = (elapsed > ctx.duration * 0.3 and elapsed < ctx.duration * 0.75) and 2 or 1
					for _ = 1, perTick do
						if fractures < MAX_FRACTURES then
							local part = takeRandom(candidates)
							if part and Destruction.IsDestructible(part) then
								fractures += 1
								Destruction.Fracture(part, PhysUtil.RandomPointInPart(part, rng), BREAK_IMPULSE)
							end
						end
					end
					for _ = 1, PROPS_PER_TICK do
						local prop = takeRandom(props)
						if prop then
							Destruction.ReleaseProp(
								prop,
								Vector3.new(rng:NextNumber(-6, 6), rng:NextNumber(4, 9), rng:NextNumber(-6, 6))
							)
						end
					end
				end
				if now - lastStumble >= STUMBLE_INTERVAL then
					lastStumble = now
					for _, target in PhysUtil.PlayersInRadius(center, radius, true) do
						Combat.Knockback(target.player, PhysUtil.RandomFlatUnit(rng), STUMBLE_STRENGTH)
					end
				end
				task.wait(BREAK_INTERVAL)
			end
		end)

		-- Teto caindo (perto de jogadores ou em pontos aleatórios da área).
		trove:Spawn(function()
			while ctx.isActive() do
				task.wait(CEILING_INTERVAL)
				local players = PhysUtil.PlayersInRadius(center, radius, true)
				local target: Vector3
				if #players > 0 and rng:NextNumber() < 0.65 then
					local chosen = players[rng:NextInteger(1, #players)]
					target = chosen.root.Position + Vector3.new(rng:NextNumber(-3, 3), 1.5, rng:NextNumber(-3, 3))
				else
					target = Ground.RandomPointNear(center, 0, radius * 0.7, rng, 4) + Vector3.new(0, 3, 0)
				end
				local ceiling, ceilingPart = PhysUtil.CeilingAbove(target, CEILING_MAX_HEIGHT)
				if ceiling and ceiling.Y - target.Y > 3 then
					spawnFalling(ceiling, ceilingPart)
				end
			end
		end)

		-- Fendas novas de tempos em tempos.
		trove:Spawn(function()
			while ctx.isActive() and #fissures < MAX_FISSURES do
				task.wait(FISSURE_INTERVAL)
				if ctx.isActive() then
					spawnFissure()
				end
			end
		end)

		-- Perigos: pedaços caindo em cima de alguém e jogadores pisando nas fendas.
		local canBurn = PhysUtil.newCooldown(FISSURE_COOLDOWN)
		trove:Spawn(function()
			while ctx.isActive() do
				task.wait(HAZARD_INTERVAL)
				local players = PhysUtil.PlayersInRadius(center, radius + 30, true)
				local now = os.clock()
				for index = #falling, 1, -1 do
					local item = falling[index]
					local part = item.part
					if not part.Parent or now - item.spawned > 2.5 then
						table.remove(falling, index)
					elseif part.AssemblyLinearVelocity.Y < -4 then
						local reach = math.max(part.Size.X, part.Size.Z) / 2 + 2
						for _, target in players do
							local offset = part.Position - target.root.Position
							if
								not item.hit[target.player]
								and Vector3.new(offset.X, 0, offset.Z).Magnitude <= reach
								and offset.Y > -1
								and offset.Y < 4.5
							then
								item.hit[target.player] = true
								Combat.DamagePlayer(target.player, FALL_DAMAGE, SOURCE_CEILING)
							end
						end
					end
				end
				for _, fissure in fissures do
					for _, target in players do
						local localPoint = fissure.cframe:PointToObjectSpace(target.root.Position)
						if
							math.abs(localPoint.X) <= fissure.halfWidth + 0.8
							and math.abs(localPoint.Z) <= fissure.halfLength + 0.3
							and localPoint.Y > -1
							and localPoint.Y < 4.5
							and canBurn(target.player)
						then
							Combat.DamagePlayer(target.player, FISSURE_DAMAGE, SOURCE_FISSURE)
							local side = localPoint.X >= 0 and 1 or -1
							Combat.Knockback(target.player, fissure.cframe.RightVector * side, FISSURE_PUSH)
						end
					end
				end
			end
		end)

		return function()
			trove:Clean()
			table.clear(fissures)
			table.clear(falling)
		end
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Hunter</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Evento de NPC "O Caçador": um caçador de chapéu e bigode persegue o grupo durante toda a duração
-- (150 s) ou até morrer. Ele mantém distância, recua de quem chega perto e atira com o rifle depois de
-- mirar com um laser vermelho (dá para sair da mira). A vida cresce com o número de jogadores.

local NpcEventUtil = require(script.Parent.Parent.EventHelpers.NpcEventUtil)
local Effects = require(script.Parent.Parent.NPC.Effects)

local BASE_HEALTH = 250
local HEALTH_PER_EXTRA_PLAYER = 0.12

return {
	Id = "Hunter",
	DisplayName = "O Caçador",
	Kind = "npc",
	Riddles = {
		"Um ponto vermelho procura o seu peito;\ncorra para o lado antes do disparo perfeito.",
		"Ele caça leões, mas hoje a presa é você;\nesconda-se bem onde o rifle não vê.",
		"Chapéu de couro e bigode cerrado;\nquem fica parado já está caçado.",
	},
	Weight = 0.7,
	MinSpace = 18,
	Duration = 150,
	Radius = 80,

	Start = function(ctx)
		local session = NpcEventUtil.new(ctx, "Hunter")
		local players = NpcEventUtil.AlivePlayerCount(ctx)
		local health = math.floor(BASE_HEALTH * (1 + HEALTH_PER_EXTRA_PLAYER * (players - 1)))

		session:RunWaves("Hunter", { 1 }, {
			startDelay = 1.5,
			health = health,
			onSpawned = function(models)
				local model = models[1]
				if model then
					Effects.Sound("Reload", model:GetPivot().Position, { Volume = 1, RollOffMaxDistance = 200 })
				end
				NpcEventUtil.NotifyAll(
					"O Caçador chegou! Quando o laser vermelho mirar em você, saia do lugar ou se esconda.",
					"danger"
				)
			end,
		})

		return function()
			session:Cleanup()
		end
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Lion</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Evento de NPC "Leão Faminto": um leão (dois, com 4 jogadores ou mais) surge perto de onde o tabuleiro foi
-- jogado. Ele ruge, persegue, dá garradas fortes e salta em bote de média distância (IA do Leão). A vida
-- cresce um pouco com o número de jogadores. Termina quando os leões morrem (ou ao fim da duração).

local NpcEventUtil = require(script.Parent.Parent.EventHelpers.NpcEventUtil)
local Effects = require(script.Parent.Parent.NPC.Effects)

local BASE_HEALTH = 220
local HEALTH_PER_EXTRA_PLAYER = 0.1 -- +10% de vida por jogador vivo além do primeiro
local SECOND_LION_PLAYERS = 4
local SECOND_LION_DELAY = 8

return {
	Id = "Lion",
	DisplayName = "Leão Faminto",
	Kind = "npc",
	Riddles = {
		"Juba dourada e garras afiadas;\nfuja depressa das suas passadas.",
		"Um rugido ecoa e faz tremer o chão;\nfaminto e veloz, o rei vem em sua direção.",
		"Não corra em linha reta pela savana;\no grande felino salta e não se engana.",
	},
	Weight = 0.9,
	MinSpace = 12,
	Duration = 80,
	Radius = 60,

	Start = function(ctx)
		local session = NpcEventUtil.new(ctx, "Lion")
		local players = NpcEventUtil.AlivePlayerCount(ctx)
		local health = math.floor(BASE_HEALTH * (1 + HEALTH_PER_EXTRA_PLAYER * (players - 1)))
		local waves = if players >= SECOND_LION_PLAYERS then { 1, 1 } else { 1 }

		-- O rugido chega antes do leão.
		Effects.Sound("Roar", ctx.position, { Volume = 1, RollOffMaxDistance = 400 })
		Effects.Shake(ctx.position, ctx.radius * 1.5, 0.5, 0.8)

		session:RunWaves("Lion", waves, {
			startDelay = 1,
			interval = SECOND_LION_DELAY,
			health = health,
			waveMessage = "Outro leão faminto apareceu!",
		})

		return function()
			session:Cleanup()
		end
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">Monkeys</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Evento de NPC "Macacos Saqueadores": um bando de macacos (6 + 2 por jogador vivo extra) chega em 2 ou 3
-- ondas perto de onde o tabuleiro foi jogado. Eles mordem, arremessam objetos soltos nos jogadores (IA do
-- Macaco) e, de tempos em tempos, um deles faz bagunça: derruba um objeto solto ou quebra um móvel por
-- perto. Termina quando o bando inteiro for derrotado (ou ao fim da duração).

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Tags = require(ReplicatedStorage.Shared.Tags)

local NpcEventUtil = require(script.Parent.Parent.EventHelpers.NpcEventUtil)
local Effects = require(script.Parent.Parent.NPC.Effects)

local BASE_COUNT = 6
local PER_EXTRA_PLAYER = 2
local WAVE_INTERVAL = 26
local MISCHIEF_MIN, MISCHIEF_MAX = 4, 7
local MISCHIEF_RADIUS = 12
local PROP_MAX_SIZE = 7
local BREAK_CHANCE = 0.35 -- chance de quebrar um móvel em vez de derrubar um objeto
local BREAK_MAX_SIZE = 12 -- só móveis (paredes inteiras ficam de fora)
local BREAK_IMPULSE = 30

local overlapParams = OverlapParams.new()
overlapParams.FilterType = Enum.RaycastFilterType.Exclude
overlapParams.MaxParts = 60

-- Um macaco derruba um objeto solto por perto (o objeto voa para cima e para o lado).
local function knockProp(position: Vector3, rng: Random): boolean
	local prop = Effects.FindLooseProp(position, MISCHIEF_RADIUS, PROP_MAX_SIZE, nil)
	if not prop then
		return false
	end
	local angle = rng:NextNumber(0, math.pi * 2)
	local speed = rng:NextNumber(12, 22)
	Effects.LaunchProp(prop, Vector3.new(math.cos(angle) * speed, rng:NextNumber(14, 24), math.sin(angle) * speed))
	return true
end

-- Um macaco quebra um móvel (Destructible pequeno) por perto.
local function breakFurniture(destruction, position: Vector3, rng: Random): boolean
	if not destruction or type(destruction.Fracture) ~= "function" then
		return false
	end
	local exclude = {}
	for _, name in { "NPCs", "Debris", "ActiveEvents", "Board" } do
		local folder = workspace:FindFirstChild(name)
		if folder then
			table.insert(exclude, folder)
		end
	end
	overlapParams.FilterDescendantsInstances = exclude
	local candidates = {}
	for _, part in workspace:GetPartBoundsInRadius(position, MISCHIEF_RADIUS * 0.7, overlapParams) do
		if CollectionService:HasTag(part, Tags.Destructible) then
			local size = part.Size
			if math.max(size.X, size.Y, size.Z) <= BREAK_MAX_SIZE then
				local okCheck, destructible = pcall(destruction.IsDestructible, part)
				if okCheck and destructible then
					table.insert(candidates, part)
				end
			end
		end
	end
	if #candidates == 0 then
		return false
	end
	local part = candidates[rng:NextInteger(1, #candidates)]
	local ok, err = pcall(destruction.Fracture, part, part.Position, BREAK_IMPULSE)
	if not ok then
		warn("[Monkeys] Erro ao quebrar um móvel: " .. tostring(err))
		return false
	end
	return true
end

return {
	Id = "Monkeys",
	DisplayName = "Macacos Saqueadores",
	Kind = "npc",
	Riddles = {
		"Pulam do lustre e gritam sem parar;\ntudo o que estiver solto eles vão arremessar.",
		"Pequenos ladrões de rabo comprido;\nnenhum vaso da casa fica escondido.",
		"Ouça os guinchos que vêm do telhado;\no bando faminto está muito agitado.",
	},
	Weight = 1.2,
	MinSpace = 1,
	Duration = 90,
	Radius = 55,

	Start = function(ctx)
		local session = NpcEventUtil.new(ctx, "Monkeys")
		local rng: Random = ctx.random
		local players = NpcEventUtil.AlivePlayerCount(ctx)
		local total = BASE_COUNT + PER_EXTRA_PLAYER * (players - 1)
		local waves = NpcEventUtil.SplitWaves(total, if total >= 10 then 3 else 2)

		Effects.Sound("Monkey", ctx.position, { Volume = 1, RollOffMaxDistance = 220 })
		session:RunWaves("Monkey", waves, {
			interval = WAVE_INTERVAL,
			waveMessage = "Mais macacos estão chegando!",
		})

		-- Bagunça: de tempos em tempos, um macaco vivo derruba ou quebra alguma coisa perto dele.
		local destruction = ctx.services and ctx.services.Destruction
		session:Spawn(function()
			while session:Wait(rng:NextNumber(MISCHIEF_MIN, MISCHIEF_MAX)) do
				local models = session:GetModels()
				if #models > 0 then
					local model = models[rng:NextInteger(1, #models)]
					if model.Parent then
						local position = model:GetPivot().Position
						local done = false
						if rng:NextNumber() < BREAK_CHANCE then
							done = breakFurniture(destruction, position, rng)
						end
						if not done then
							done = knockProp(position, rng)
						end
						if done then
							Effects.Sound("Monkey", position, { Volume = 0.8, RollOffMaxDistance = 120 })
						end
					end
				end
			end
		end)

		return function()
			session:Cleanup()
		end
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Monsoon</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Evento físico "Monção": chuva forte (ParticleEmitter numa part invisível no alto), céu escurecido e água
-- de Terrain subindo em camadas numa caixa centrada no evento (até ~8 studs em ~30 s), parando um pouco e
-- depois baixando. Quem fica com a cabeça embaixo d'água por mais de 4 s se afoga aos poucos.
-- Objetos soltos (LooseProp) são desancorados quando a água chega neles e boiam sozinhos.
-- O mapa não usa Terrain: a limpeza apaga (Air) somente a caixa que este evento encheu.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local SoundUtil = require(ReplicatedStorage.Shared.Audio.SoundUtil)

local PhysUtil = require(script.Parent.Parent.EventHelpers.PhysUtil)

local Terrain = workspace.Terrain

local MAX_DEPTH = 8
local UPSTAIRS_EXTRA = 2.5 -- evento no 2º andar: a água sobe até um pouco acima desse piso
local MAX_UPSTAIRS_DEPTH = 20
local RISE_TIME = 30
local HOLD_TIME = 16
local DRAIN_TIME = 18
local WATER_STEP = 1 -- segundos entre as camadas
local VOXEL = 4
local CHECK_INTERVAL = 0.5
local DROWN_GRACE = 4
local DROWN_DPS = 10
local RAIN_HEIGHT = 70
local MAX_PROPS = 60
local THUNDER_MIN, THUNDER_MAX = 9, 16
local SOURCE = "Afogamento"

local RAIN_COLOR = Color3.fromRGB(200, 214, 230)
local THUNDER_COLOR = Color3.fromRGB(235, 240, 255)

-- Aparência da água do Terrain (global): guardada pelo primeiro evento e restaurada pelo último.
local waterStyleUsers = 0
local savedWaterStyle = nil

local function pushWaterStyle()
	if waterStyleUsers == 0 then
		savedWaterStyle = {
			WaterColor = Terrain.WaterColor,
			WaterTransparency = Terrain.WaterTransparency,
			WaterWaveSize = Terrain.WaterWaveSize,
			WaterWaveSpeed = Terrain.WaterWaveSpeed,
			WaterReflectance = Terrain.WaterReflectance,
		}
		Terrain.WaterColor = Color3.fromRGB(78, 96, 72) -- enchente barrenta
		Terrain.WaterTransparency = 0.55
		Terrain.WaterWaveSize = 0.12
		Terrain.WaterWaveSpeed = 14
		Terrain.WaterReflectance = 0.4
	end
	waterStyleUsers += 1
end

local function popWaterStyle()
	waterStyleUsers = math.max(waterStyleUsers - 1, 0)
	if waterStyleUsers == 0 and savedWaterStyle then
		for name, value in savedWaterStyle do
			Terrain[name] = value
		end
		savedWaterStyle = nil
	end
end

return {
	Id = "Monsoon",
	DisplayName = "Monção",
	Kind = "physical",
	Riddles = {
		"Nuvens pesadas cobrem a sua cabeça;\nsuba bem alto antes que a água cresça.",
		"Gota após gota, o chão vira lagoa;\nquem não sabe nadar, a correnteza não perdoa.",
		"O céu vai chorar sem parar um segundo;\na água vai subir e engolir o seu mundo.",
	},
	Weight = 0.9,
	MinSpace = 6,
	Duration = 75,
	Radius = 55,

	Start = function(ctx)
		local trove = PhysUtil.newTrove()
		local services = PhysUtil.Services(ctx)
		local Destruction = services.Destruction
		local Combat = services.Combat
		local rng = ctx.random
		local lightingKey = "Monsoon:" .. ctx.instanceId
		local cleaned = false

		local center = ctx.position
		local cx, cz = center.X, center.Z
		local half = ctx.radius
		local size = half * 2
		local islandGround = (ctx.mapInfo and ctx.mapInfo.groundY) or PhysUtil.EventGroundY(center)
		local localGround = PhysUtil.EventGroundY(center)
		local bottom, depth
		if localGround > islandGround + 6 then
			-- Evento no andar de cima: a enchente começa no térreo e sobe até esse andar.
			bottom = islandGround
			depth = math.clamp(localGround + UPSTAIRS_EXTRA - islandGround, MAX_DEPTH, MAX_UPSTAIRS_DEPTH)
		else
			bottom = localGround
			depth = MAX_DEPTH
		end
		local level = bottom -- nível atual da água
		local filledTop = bottom -- ponto mais alto já preenchido (para a limpeza)

		-- Água ---------------------------------------------------------------------------------
		local function fillTo(target: number)
			if target - bottom < 0.1 then
				return
			end
			Terrain:FillBlock(
				CFrame.new(cx, (bottom + target) / 2, cz),
				Vector3.new(size, target - bottom, size),
				Enum.Material.Water
			)
			filledTop = math.max(filledTop, target)
		end

		local function lowerTo(target: number)
			local top = filledTop + VOXEL
			if top - target > 0.05 then
				Terrain:FillBlock(
					CFrame.new(cx, (target + top) / 2, cz),
					Vector3.new(size, top - target, size),
					Enum.Material.Air
				)
			end
			fillTo(target) -- refaz a camada parcial de cima
		end

		local function clearWater()
			if filledTop <= bottom then
				return
			end
			-- Uma célula de voxel de folga em volta: a borda da caixa preenche voxels parciais.
			local low = bottom - VOXEL
			local high = filledTop + VOXEL
			Terrain:FillBlock(
				CFrame.new(cx, (low + high) / 2, cz),
				Vector3.new(size + VOXEL * 2, high - low, size + VOXEL * 2),
				Enum.Material.Air
			)
			filledTop = bottom
		end

		-- Chuva, som e céu -------------------------------------------------------------------------
		local rainPart = PhysUtil.GhostPart({
			Name = "Chuva",
			Size = Vector3.new(size, 1, size),
			CFrame = CFrame.new(cx, math.max(bottom, localGround) + RAIN_HEIGHT, cz),
			Transparency = 1,
			Parent = ctx.folder,
		})
		trove:Add(rainPart)
		PhysUtil.Emitter(rainPart, {
			Texture = PhysUtil.Textures.Smoke,
			Color = RAIN_COLOR,
			Size = 0.22,
			Squash = 2.6, -- gotas compridas e finas
			Transparency = 0.35,
			Orientation = Enum.ParticleOrientation.VelocityParallel,
			EmissionDirection = Enum.NormalId.Bottom,
			Speed = NumberRange.new(95, 110),
			Lifetime = NumberRange.new(0.72, 0.82),
			SpreadAngle = Vector2.new(3, 3),
			Rate = 320,
			LightEmission = 0.25,
			LightInfluence = 0.6,
		})

		local soundPart = PhysUtil.GhostPart({
			Name = "SomDaChuva",
			Size = Vector3.one,
			CFrame = CFrame.new(cx, localGround + 4, cz),
			Transparency = 1,
			Parent = ctx.folder,
		})
		trove:Add(soundPart)
		SoundUtil.Play("Rain", {
			Parent = soundPart,
			Looped = true,
			Group = "Ambience",
			Volume = 0.8,
			RollOffMaxDistance = half * 4,
		})

		PhysUtil.PushLighting(lightingKey, function(base)
			local target = {}
			target.Brightness = (base.Brightness or 2) * 0.45
			local clock = base.ClockTime
			if clock and clock > 6 and clock < 17.6 then
				target.ClockTime = clock + 0.6
			end
			if base.AtmosphereDensity then
				target.AtmosphereDensity = math.min(base.AtmosphereDensity + 0.18, 0.65)
			end
			return target
		end, 4)
		pushWaterStyle()

		-- Objetos soltos na área: desancorados quando a água chega na base deles.
		local props: { BasePart } = {}
		if Destruction then
			local seen = {}
			local found = workspace:GetPartBoundsInBox(
				CFrame.new(cx, bottom + depth / 2 + 1, cz),
				Vector3.new(size, depth + 2, size),
				PhysUtil.OverlapParams(false, 400)
			)
			for _, part in found do
				local root = Destruction.GetLooseRoot(part)
				if root and root.Anchored and not seen[root] and #props < MAX_PROPS then
					seen[root] = true
					table.insert(props, root)
				end
			end
			table.sort(props, function(a, b)
				return a.Position.Y < b.Position.Y
			end)
		end
		local nextProp = 1
		local function releaseSubmergedProps()
			while nextProp <= #props do
				local root = props[nextProp]
				if root.Parent and root.Position.Y - root.Size.Y / 2 > level - 0.3 then
					break
				end
				nextProp += 1
				if root.Parent and root.Anchored then
					Destruction.ReleaseProp(
						root,
						Vector3.new(rng:NextNumber(-2, 2), rng:NextNumber(1, 3), rng:NextNumber(-2, 2))
					)
				end
			end
		end

		-- Linha do tempo da água: sobe, para, desce e termina o evento.
		trove:Spawn(function()
			local riseSteps = math.max(math.floor(RISE_TIME / WATER_STEP), 1)
			for step = 1, riseSteps do
				task.wait(WATER_STEP)
				if not ctx.isActive() then
					return
				end
				level = bottom + depth * (step / riseSteps)
				fillTo(level)
				releaseSubmergedProps()
			end
			task.wait(HOLD_TIME)
			local drainSteps = math.max(math.floor(DRAIN_TIME / WATER_STEP), 1)
			for step = drainSteps - 1, 0, -1 do
				task.wait(WATER_STEP)
				if not ctx.isActive() then
					return
				end
				level = bottom + depth * (step / drainSteps)
				lowerTo(level)
			end
			clearWater()
			level = bottom
			if ctx.isActive() then
				ctx.finish()
			end
		end)

		-- Afogamento: cabeça abaixo do nível atual, dentro da caixa, por mais de DROWN_GRACE segundos.
		local submerged: { [Player]: number } = {}
		local warned: { [Player]: boolean } = {}
		trove:Spawn(function()
			while ctx.isActive() do
				task.wait(CHECK_INTERVAL)
				local current = {}
				for _, target in PhysUtil.PlayersInRadius(center, half * 1.5, true) do
					local head = target.player.Character and target.player.Character:FindFirstChild("Head")
					if head and head:IsA("BasePart") then
						local p = head.Position
						if math.abs(p.X - cx) <= half and math.abs(p.Z - cz) <= half and p.Y < level - 0.3 then
							local time = (submerged[target.player] or 0) + CHECK_INTERVAL
							current[target.player] = time
							if time > DROWN_GRACE then
								if not warned[target.player] then
									warned[target.player] = true
									PhysUtil.Notify(
										target.player,
										"Você está se afogando! Suba para respirar.",
										"danger"
									)
								end
								Combat.DamagePlayer(target.player, DROWN_DPS * CHECK_INTERVAL, SOURCE)
							end
						end
					end
				end
				submerged = current
			end
		end)

		-- Trovões: clarão e um tremor leve de vez em quando.
		trove:Spawn(function()
			while ctx.isActive() do
				task.wait(rng:NextNumber(THUNDER_MIN, THUNDER_MAX))
				if not ctx.isActive() then
					return
				end
				for _, target in PhysUtil.PlayersInRadius(center, half * 2.5) do
					PhysUtil.Flash(target.player, THUNDER_COLOR, 0.25)
				end
				PhysUtil.Shake(center, half * 2.5, 0.35, 0.6)
			end
		end)

		return function()
			if cleaned then
				return
			end
			cleaned = true
			trove:Clean()
			local ok, err = pcall(clearWater)
			if not ok then
				warn("[Monsoon] Erro ao remover a água: " .. tostring(err))
			end
			PhysUtil.PopLighting(lightingKey, 3)
			popWaterStyle()
		end
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Mosquitos</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Evento de NPC "Enxame de Mosquitos": 8 a 12 mosquitos gigantes (mais com mais jogadores) chegam em 2
-- ondas. Eles circulam em volta dos jogadores e dão rasantes; a picada machuca e dá febre (IA do
-- Mosquito). Termina quando o enxame inteiro morre (ou ao fim da duração).

local NpcEventUtil = require(script.Parent.Parent.EventHelpers.NpcEventUtil)
local Effects = require(script.Parent.Parent.NPC.Effects)

local MIN_COUNT, MAX_COUNT = 8, 12
local WAVE_INTERVAL = 25

return {
	Id = "Mosquitos",
	DisplayName = "Enxame de Mosquitos",
	Kind = "npc",
	Riddles = {
		"Um zumbido agudo cresce no ar;\npicadas gigantes vêm te encontrar.",
		"Pequenos vampiros de asas ligeiras;\nsua sede de sangue não tem fronteiras.",
		"Abane os braços e não fique parado;\no enxame faminto chega de todo lado.",
	},
	Weight = 1,
	MinSpace = 1,
	Duration = 75,
	Radius = 50,

	Start = function(ctx)
		local session = NpcEventUtil.new(ctx, "Mosquitos")
		local rng: Random = ctx.random
		local players = NpcEventUtil.AlivePlayerCount(ctx)
		local total = math.clamp(MIN_COUNT + (players - 1) + rng:NextInteger(0, 1), MIN_COUNT, MAX_COUNT)

		Effects.Sound("Mosquito", ctx.position, { Volume = 1, RollOffMaxDistance = 160 })
		session:RunWaves("Mosquito", NpcEventUtil.SplitWaves(total, 2), {
			interval = WAVE_INTERVAL,
			waveMessage = "O zumbido aumenta: mais mosquitos!",
		})

		return function()
			session:Cleanup()
		end
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">Pelican</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Evento físico "Pelicano Ladrão": um pelicano gigante (modelo de blocos, ancorado, voando por CFrame)
-- mergulha até o tabuleiro, trava o tabuleiro (quem carregava larga), agarra e voa com ele até uma região
-- distante (de preferência o labirinto, a estufa ou um cômodo longe) e o solta no chão. Todos são avisados
-- de onde ele caiu. Se o evento acabar no meio do voo, o tabuleiro volta para o chão num lugar válido.
--
-- Durante o voo as parts do tabuleiro ficam soldadas na base (só a base é movida e replica), e no fim tudo
-- volta exatamente como estava antes de o BoardService assumir de novo (PlaceAt + SetLocked(false)).

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local SoundUtil = require(ReplicatedStorage.Shared.Audio.SoundUtil)
local Tags = require(ReplicatedStorage.Shared.Tags)

local PhysCreatures = require(script.Parent.Parent.EventHelpers.PhysCreatures)
local PhysUtil = require(script.Parent.Parent.EventHelpers.PhysUtil)

local SPAWN_DISTANCE = 170
local SPAWN_HEIGHT = 60
local APPROACH_SPEED = 48
local CARRY_SPEED = 40
local LEAVE_SPEED = 45
local LOCK_DISTANCE = 10 -- trava o tabuleiro (quem carrega larga) um pouco antes de agarrar
local GRAB_DISTANCE = 2.5
local APPROACH_TIMEOUT = 25
local CRUISE_HEIGHT = 45
local HOVER_HEIGHT = 3.4 -- altura do corpo do pelicano acima do chão ao agarrar/soltar
local HANG = CFrame.new(0, -3.4, -1.2) -- onde o tabuleiro fica pendurado (relativo ao corpo)
local MIN_DESTINATION_DISTANCE = 120
local ISLAND_MARGIN = 30
local LEAVE_TIME = 3
local NEAR_DESTINATION = 40
local CLEARANCE = Vector3.new(5, 5.6, 5) -- espaço livre exigido acima do ponto de queda
local FALLBACK_REGION = "algum canto da ilha"

-- Só um pelicano carrega o tabuleiro por vez (um segundo evento simultâneo só sobrevoa e vai embora).
local holder: string? = nil

local function shuffle(list: { any }, rng: Random)
	for index = #list, 2, -1 do
		local other = rng:NextInteger(1, index)
		list[index], list[other] = list[other], list[index]
	end
end

local function isPreferredRegion(name: string): boolean
	return name:sub(1, 10) == "Labirinto " or name == "Clareira do Labirinto" or name == "Estufa"
end

return {
	Id = "Pelican",
	DisplayName = "Pelicano Ladrão",
	Kind = "physical",
	Riddles = {
		"Asas enormes e um bico guloso;\nleva o que é seu esse ladrão ardiloso.",
		"Do céu vem um bico que tudo carrega;\nsegure o tabuleiro, que a ave não sossega.",
		"Um ladrão de penas mergulha do alto;\no jogo some num único salto.",
	},
	Weight = 0.8,
	MinSpace = 2,
	Duration = 60,
	Radius = 30,

	Start = function(ctx)
		local trove = PhysUtil.newTrove()
		local services = PhysUtil.Services(ctx)
		local Board = services.Board
		local Ground = services.Ground
		local Map = services.Map
		local rng = ctx.random
		local cleaned = false

		if not Board or type(Board.GetBoardPosition) ~= "function" then
			warn("[Pelican] BoardService indisponível: o pelicano não tem o que roubar.")
			task.defer(ctx.finish)
			return function() end
		end

		-- Estado do roubo.
		local locked = false -- este evento travou o tabuleiro
		local attached = nil -- { base, pivotToBase, anchored = {[BasePart]=bool}, welds = {Instance} }
		local grabCFrame: CFrame? = nil -- onde o tabuleiro estava quando foi agarrado
		local destination: Vector3? = nil

		-- Pelicano ---------------------------------------------------------------------------------
		local boardStart = Board.GetBoardPosition()
		local fromDirection = PhysUtil.RandomFlatUnit(rng)
		local position = boardStart + fromDirection * SPAWN_DISTANCE + Vector3.new(0, SPAWN_HEIGHT, 0)
		local look = PhysUtil.FlatUnit(boardStart - position)
		local pelican = PhysCreatures.Pelican(ctx.folder, CFrame.lookAt(position, position + look))
		trove:Add(pelican.model)
		local root = pelican.root
		SoundUtil.Play("Pelican", { Parent = root, Volume = 1, RollOffMaxDistance = 400 })

		local function moveBoard()
			if attached and attached.base.Parent then
				attached.base.CFrame = root.CFrame * HANG * attached.pivotToBase
			end
		end

		local function setPose(forward: Vector3?, flapping: boolean)
			if forward then
				local flat = Vector3.new(forward.X, 0, forward.Z)
				if flat.Magnitude > 0.5 then
					look = flat.Unit
				end
			end
			if not root.Parent then
				return
			end
			root.CFrame = CFrame.lookAt(position, position + look)
			local angle = if flapping then math.sin(os.clock() * 9) * 0.6 else 0.12
			PhysCreatures.SetWings(pelican, angle)
			moveBoard()
		end

		-- Avança na direção do alvo; true quando chegou.
		local function flyTowards(target: Vector3, speed: number, dt: number): boolean
			local delta = target - position
			local distance = delta.Magnitude
			local stepLength = speed * math.min(dt, 0.1)
			if distance <= stepLength then
				position = target
				return true
			end
			position += delta.Unit * stepLength
			return false
		end

		-- Tabuleiro: soldar na base durante o voo e devolver tudo como estava ------------------------
		local function attachBoard(): boolean
			local model = Board.GetBoardModel()
			if not model or not model.Parent then
				return false
			end
			local base = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
			if not base then
				return false
			end
			local state = {
				base = base,
				pivotToBase = model:GetPivot():ToObjectSpace(base.CFrame),
				anchored = {},
				welds = {},
			}
			-- Solda primeiro (tudo ainda ancorado) e só depois solta as partes: nada cai no meio.
			local toRelease = {}
			for _, part in model:GetDescendants() do
				if part:IsA("BasePart") and part ~= base and part.Anchored then
					local weld = Instance.new("WeldConstraint")
					weld.Name = "SoldaDoPelicano"
					weld.Part0 = base
					weld.Part1 = part
					weld.Parent = base
					table.insert(state.welds, weld)
					table.insert(toRelease, part)
				end
			end
			for _, part in toRelease do
				state.anchored[part] = true
				part.Anchored = false
			end
			base.Anchored = true
			grabCFrame = model:GetPivot()
			attached = state
			return true
		end

		local function detachBoard()
			local state = attached
			if not state then
				return
			end
			attached = nil
			for part, wasAnchored in state.anchored do
				if part.Parent then
					part.Anchored = wasAnchored
				end
			end
			for _, weld in state.welds do
				weld:Destroy()
			end
		end

		local function unlock()
			if locked then
				locked = false
				pcall(Board.SetLocked, false)
			end
			if holder == ctx.instanceId then
				holder = nil
			end
		end

		-- Escolha do destino ---------------------------------------------------------------------------
		local clearanceParams = PhysUtil.OverlapParams(false, 8)
		clearanceParams.RespectCanCollide = true

		-- Chão válido: firme, fora d'água, dentro da ilha e com espaço livre em cima (nada de cerca ou móvel).
		local function validGround(probe: Vector3, maxDrop: number, floorY: number?): Vector3?
			local ground, hit = Ground.FindGround(probe, maxDrop, 0)
			if not ground or not hit then
				return nil
			end
			if CollectionService:HasTag(hit, Tags.Water) then
				return nil
			end
			if floorY and ground.Y > floorY + 5 then
				return nil
			end
			if not PhysUtil.IsInsideIsland(ctx.mapInfo, ground, ISLAND_MARGIN) then
				return nil
			end
			clearanceParams.FilterDescendantsInstances = PhysUtil.ExcludeList(false)
			local blocking = workspace:GetPartBoundsInBox(
				CFrame.new(ground + Vector3.new(0, CLEARANCE.Y / 2 + 0.3, 0)),
				CLEARANCE,
				clearanceParams
			)
			if #blocking > 0 then
				return nil
			end
			return ground
		end

		local function pointInRegion(region): Vector3?
			if typeof(region.cframe) ~= "CFrame" or typeof(region.size) ~= "Vector3" then
				return nil
			end
			local bottom = region.cframe.Position.Y - region.size.Y / 2
			local startHeight = math.min(6, region.size.Y * 0.5)
			for _ = 1, 8 do
				local localPoint = Vector3.new(
					rng:NextNumber(-0.35, 0.35) * region.size.X,
					0,
					rng:NextNumber(-0.35, 0.35) * region.size.Z
				)
				local flat = region.cframe:PointToWorldSpace(localPoint)
				local probe = Vector3.new(flat.X, bottom + startHeight, flat.Z)
				local ground = validGround(probe, startHeight + 6, bottom + 1.5)
				if ground then
					return ground
				end
			end
			return nil
		end

		local function chooseDestination(from: Vector3): (Vector3, string)
			local preferred, others = {}, {}
			local regions = (ctx.mapInfo and type(ctx.mapInfo.regions) == "table") and ctx.mapInfo.regions or {}
			for _, region in regions do
				if
					type(region) == "table"
					and type(region.name) == "string"
					and typeof(region.cframe) == "CFrame"
					and typeof(region.size) == "Vector3"
					and region.size.X < 250
					and region.size.Z < 250
					and PhysUtil.FlatDistance(region.cframe.Position, from) >= MIN_DESTINATION_DISTANCE
					and PhysUtil.IsInsideIsland(ctx.mapInfo, region.cframe.Position, ISLAND_MARGIN)
				then
					if isPreferredRegion(region.name) then
						table.insert(preferred, region)
					else
						table.insert(others, region)
					end
				end
			end
			shuffle(preferred, rng)
			shuffle(others, rng)
			local order = {}
			local first, second = preferred, others
			if rng:NextNumber() >= 0.7 then
				first, second = others, preferred
			end
			for _, region in first do
				table.insert(order, region)
			end
			for _, region in second do
				table.insert(order, region)
			end
			for index, region in order do
				if index > 12 then
					break
				end
				local point = pointInRegion(region)
				if point then
					return point, region.name
				end
			end

			-- Sem região boa: um ponto qualquer da ilha, longe do tabuleiro.
			local groundY = (ctx.mapInfo and ctx.mapInfo.groundY) or from.Y
			local islandCenter = (ctx.mapInfo and ctx.mapInfo.islandCenter) or Vector3.zero
			local islandRadius = (ctx.mapInfo and ctx.mapInfo.islandRadius) or 600
			for _ = 1, 20 do
				local angle = rng:NextNumber(0, math.pi * 2)
				local distance = rng:NextNumber(0, islandRadius - ISLAND_MARGIN * 2)
				local candidate = islandCenter + Vector3.new(math.cos(angle) * distance, 0, math.sin(angle) * distance)
				if PhysUtil.FlatDistance(candidate, from) >= MIN_DESTINATION_DISTANCE then
					local ground = validGround(Vector3.new(candidate.X, groundY + 6, candidate.Z), 14, groundY + 1)
					if ground then
						local name = FALLBACK_REGION
						if Map and type(Map.GetRegionAt) == "function" then
							local ok, region = pcall(Map.GetRegionAt, ground + Vector3.new(0, 2, 0))
							if ok and type(region) == "table" and type(region.name) == "string" then
								name = region.name
							end
						end
						return ground, name
					end
				end
			end
			-- Último recurso: o pelicano desiste e devolve o tabuleiro onde estava.
			return from, "o mesmo lugar (o pelicano desistiu)"
		end

		-- Voo ------------------------------------------------------------------------------------------
		trove:Spawn(function()
			-- 1. Mergulho até o tabuleiro (segue o tabuleiro mesmo que alguém esteja correndo com ele).
			local deadline = os.clock() + APPROACH_TIMEOUT
			while ctx.isActive() do
				local dt = task.wait()
				local target = Board.GetBoardPosition() + Vector3.new(0, HOVER_HEIGHT, 0)
				local flatDistance = PhysUtil.FlatDistance(position, target)
				local aim = target + Vector3.new(0, math.clamp(flatDistance * 0.45, 0, 35), 0)
				flyTowards(aim, APPROACH_SPEED, dt)
				setPose(aim - position, true)
				local distance = (position - target).Magnitude
				local late = os.clock() > deadline
				-- Não agarra no meio de uma rolagem (dados e peça ainda animando): espera ela terminar.
				local boardBusy = Board.IsRolling ~= nil and Board.IsRolling()
				if not locked and not boardBusy and (distance <= LOCK_DISTANCE or late) then
					if holder ~= nil and holder ~= ctx.instanceId then
						break -- outro pelicano já está com o tabuleiro
					end
					holder = ctx.instanceId
					locked = true
					Board.SetLocked(true) -- quem carregava larga o tabuleiro no chão
				end
				if locked and (distance <= GRAB_DISTANCE or late) then
					break
				end
			end
			if not ctx.isActive() then
				return
			end

			if not locked or not attachBoard() then
				-- Não conseguiu pegar: sobrevoa e vai embora.
				unlock()
				local away = position + look * 120 + Vector3.new(0, 60, 0)
				local started = os.clock()
				while ctx.isActive() and os.clock() - started < LEAVE_TIME do
					local dt = task.wait()
					flyTowards(away, LEAVE_SPEED, dt)
					setPose(away - position, true)
				end
				if ctx.isActive() then
					ctx.finish()
				end
				return
			end

			-- 2. Agarrou: avisa todo mundo e escolhe para onde levar.
			moveBoard()
			SoundUtil.Play("Pelican", { Parent = root, Volume = 1, RollOffMaxDistance = 400 })
			PhysUtil.NotifyAll("O pelicano roubou o tabuleiro! Siga-o!", "warning")
			local from = (grabCFrame :: CFrame).Position
			local regionName
			destination, regionName = chooseDestination(from)
			local dest = destination :: Vector3

			-- 3. Sobe, cruza o céu e desce no destino.
			local cruiseY = math.max(position.Y, dest.Y + CRUISE_HEIGHT, from.Y + CRUISE_HEIGHT)
			local path = {
				Vector3.new(position.X, cruiseY, position.Z),
				Vector3.new(dest.X, cruiseY, dest.Z),
				dest + Vector3.new(0, HOVER_HEIGHT, 0),
			}
			for _, waypoint in path do
				while ctx.isActive() do
					local dt = task.wait()
					local arrived = flyTowards(waypoint, CARRY_SPEED, dt)
					setPose(Vector3.new(dest.X, 0, dest.Z) - Vector3.new(position.X, 0, position.Z), true)
					if arrived then
						break
					end
				end
				if not ctx.isActive() then
					return
				end
			end

			-- 4. Solta o tabuleiro no chão e libera.
			detachBoard()
			Board.PlaceAt(CFrame.lookAt(dest, dest + look))
			unlock()
			SoundUtil.Play("Pelican", { Parent = root, Volume = 1, RollOffMaxDistance = 400 })
			PhysUtil.NotifyAll(("O pelicano largou o tabuleiro em: %s!"):format(regionName), "info")

			-- 5. Vai embora e o evento termina.
			local away = position + look * 140 + Vector3.new(0, 70, 0)
			local started = os.clock()
			while ctx.isActive() and os.clock() - started < LEAVE_TIME do
				local dt = task.wait()
				flyTowards(away, LEAVE_SPEED, dt)
				setPose(away - position, true)
			end
			if ctx.isActive() then
				ctx.finish()
			end
		end)

		return function()
			if cleaned then
				return
			end
			cleaned = true
			trove:Clean()
			if attached then
				-- Acabou no meio do voo: perto do destino, solta lá; senão, devolve onde foi agarrado.
				local base = attached.base
				local current = base.Parent and base.Position or position
				detachBoard()
				local target: CFrame
				if destination and PhysUtil.FlatDistance(current, destination) <= NEAR_DESTINATION then
					target = CFrame.lookAt(destination, destination + look)
				elseif grabCFrame then
					target = grabCFrame
				else
					local ground = PhysUtil.GroundAt(current, 400, 2)
					target = CFrame.new(ground or current)
				end
				local ok, err = pcall(Board.PlaceAt, target)
				if not ok then
					warn("[Pelican] Erro ao devolver o tabuleiro: " .. tostring(err))
				end
			end
			unlock()
		end
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">Quicksand</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Evento físico "Areia Movediça": manchas de areia (discos finos de Sand, sem colisão, um pouco acima do
-- chão) aparecem na área. Dentro delas o jogador fica lento, quase não pula e vai afundando (HipHeight
-- diminui aos poucos em personagens R15); depois de 5 s dentro, perde vida a cada segundo. Tudo volta
-- ao normal ao sair (ou no fim do evento). Objetos que caem numa mancha afundam e somem.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local SoundUtil = require(ReplicatedStorage.Shared.Audio.SoundUtil)
local Tags = require(ReplicatedStorage.Shared.Tags)

local PhysUtil = require(script.Parent.Parent.EventHelpers.PhysUtil)

local PATCH_MIN, PATCH_MAX = 4, 7
local DIAMETER_MIN, DIAMETER_MAX = 10, 18
local PATCH_THICKNESS = 0.3
local PATCH_LIFT = 0.18 -- altura do disco acima do chão
local CHECK_INTERVAL = 0.2
local SINK_RATE = 0.3 -- studs de HipHeight por segundo
local MAX_SINK = 2.2
local SLOW_SPEED = 5
local JUMP_MULTIPLIER = 0.3
local DAMAGE_DELAY = 5
local DAMAGE_PER_SECOND = 8
local NOTIFY_COOLDOWN = 10
local PROP_SCAN_INTERVAL = 0.5
local MAX_SINKING = 10
local PROP_SINK_TIME = 2.5
local PROP_SINK_STEP = 0.1
local DRY_TIME = 2.5
local SOURCE = "Areia Movediça"

local SAND = Color3.fromRGB(184, 150, 98)
local WET_SAND = Color3.fromRGB(132, 102, 64)
local BUBBLE = Color3.fromRGB(120, 92, 58)

return {
	Id = "Quicksand",
	DisplayName = "Areia Movediça",
	Kind = "physical",
	Riddles = {
		"O chão parece firme, mas é só ilusão;\nquem pisa na areia afunda sem perdão.",
		"Debaixo dos pés, o chão vira mingau;\nficar parado ali termina muito mal.",
		"Grão por grão, o chão começa a sugar;\nquem fica parado não vai mais voltar.",
	},
	Weight = 1,
	MinSpace = 2,
	Duration = 60,
	Radius = 40,

	Start = function(ctx)
		local trove = PhysUtil.newTrove()
		local services = PhysUtil.Services(ctx)
		local Destruction = services.Destruction
		local Combat = services.Combat
		local Ground = services.Ground
		local rng = ctx.random
		local center = ctx.position
		local radius = ctx.radius
		local modifierKey = "Quicksand:" .. ctx.instanceId
		local cleaned = false

		-- Manchas -------------------------------------------------------------------------------
		local patches = {} -- { position: Vector3 (topo do chão), radius: number, parts: { BasePart } }

		local function overlapsExisting(point: Vector3, patchRadius: number): boolean
			for _, patch in patches do
				if PhysUtil.FlatDistance(point, patch.position) < (patch.radius + patchRadius) * 0.6 then
					return true
				end
			end
			return false
		end

		local function createPatch(point: Vector3, diameter: number)
			local upright = CFrame.new(point + Vector3.new(0, PATCH_LIFT, 0)) * CFrame.Angles(0, 0, math.rad(90))
			local outer = PhysUtil.GhostPart({
				Name = "AreiaMovedica",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(PATCH_THICKNESS, 1, 1),
				CFrame = upright,
				Color = SAND,
				Material = Enum.Material.Sand,
				Parent = ctx.folder,
			})
			local inner = PhysUtil.GhostPart({
				Name = "Redemoinho",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(PATCH_THICKNESS + 0.04, 0.6, 0.6),
				CFrame = upright,
				Color = WET_SAND,
				Material = Enum.Material.Mud,
				Parent = ctx.folder,
			})
			trove:Add(outer)
			trove:Add(inner)
			PhysUtil.Emitter(inner, {
				Texture = PhysUtil.Textures.Smoke,
				Color = BUBBLE,
				Size = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.3),
					NumberSequenceKeypoint.new(1, 0.9),
				}),
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.3),
					NumberSequenceKeypoint.new(1, 1),
				}),
				Lifetime = NumberRange.new(0.8, 1.4),
				Rate = 2,
				Speed = NumberRange.new(0.5, 1.5),
				EmissionDirection = Enum.NormalId.Right, -- o eixo X do cilindro aponta para cima
				SpreadAngle = Vector2.new(10, 10),
			})
			-- A mancha "abre" em 1,5 s.
			local info = TweenInfo.new(1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			TweenService:Create(outer, info, { Size = Vector3.new(PATCH_THICKNESS, diameter, diameter) }):Play()
			TweenService
				:Create(inner, info, { Size = Vector3.new(PATCH_THICKNESS + 0.04, diameter * 0.55, diameter * 0.55) })
				:Play()
			table.insert(patches, { position = point, radius = diameter / 2, parts = { outer, inner } })
			SoundUtil.Play("Crumble", { Position = point, RollOffMaxDistance = 100, Volume = 0.5 })
		end

		do
			local count = rng:NextInteger(PATCH_MIN, PATCH_MAX)
			local groundY = PhysUtil.EventGroundY(center)
			-- A primeira mancha fica bem perto do tabuleiro; as outras se espalham pela área.
			local first = Ground.RandomPointNear(center, 4, 8, rng, 6)
			if math.abs(first.Y - groundY) > 4 then
				first = Vector3.new(center.X, groundY, center.Z)
			end
			createPatch(first, rng:NextNumber(DIAMETER_MIN, DIAMETER_MAX))
			for _ = 2, count do
				local diameter = rng:NextNumber(DIAMETER_MIN, DIAMETER_MAX)
				for _ = 1, 6 do
					local point = Ground.RandomPointNear(center, 8, radius * 0.85, rng, 6)
					if not overlapsExisting(point, diameter / 2) and math.abs(point.Y - groundY) < 12 then
						createPatch(point, diameter)
						break
					end
				end
			end
		end

		local function patchAt(position: Vector3, verticalBand: number): any
			for _, patch in patches do
				local height = position.Y - patch.position.Y
				if
					height > -1
					and height <= verticalBand
					and PhysUtil.FlatDistance(position, patch.position) <= patch.radius - 0.3
				then
					return patch
				end
			end
			return nil
		end

		-- Jogadores ------------------------------------------------------------------------------------
		local inside: { [Player]: any } = {}
		local canWarn = PhysUtil.newCooldown(NOTIFY_COOLDOWN)

		local function release(player: Player)
			local state = inside[player]
			if state then
				inside[player] = nil
				PhysUtil.ClearModifier(state.humanoid, modifierKey)
			end
		end

		trove:Spawn(function()
			while ctx.isActive() do
				task.wait(CHECK_INTERVAL)
				local seen = {}
				for _, target in PhysUtil.PlayersInRadius(center, radius + 25, true) do
					local player = target.player
					if patchAt(target.root.Position, 6) then
						seen[player] = true
						local state = inside[player]
						if state and state.humanoid ~= target.humanoid then
							release(player)
							state = nil
						end
						if not state then
							state = { humanoid = target.humanoid, time = 0, sink = 0, nextDamage = DAMAGE_DELAY }
							inside[player] = state
							if canWarn(player) then
								PhysUtil.Notify(player, "Areia movediça! Saia antes de afundar.", "warning")
							end
						end
						state.time += CHECK_INTERVAL
						state.sink = math.min(state.sink + SINK_RATE * CHECK_INTERVAL, MAX_SINK)
						PhysUtil.SetModifier(target.humanoid, modifierKey, {
							walkSpeed = SLOW_SPEED,
							jumpMultiplier = JUMP_MULTIPLIER,
							hipHeightOffset = state.sink,
						})
						if state.time >= state.nextDamage then
							state.nextDamage += 1
							Combat.DamagePlayer(player, DAMAGE_PER_SECOND, SOURCE)
						end
					end
				end
				-- Quem saiu da areia (ou morreu, ou saiu do jogo) volta ao normal.
				for player in table.clone(inside) do
					if not seen[player] then
						release(player)
					end
				end
			end
		end)

		-- Objetos que caem nas manchas afundam e somem ----------------------------------------------
		local sinking: { [BasePart]: { BasePart } } = {} -- raiz -> partes que afundam juntas
		local sinkingCount = 0

		local function sinkProp(root: BasePart)
			local members: { BasePart } = { root }
			sinking[root] = members
			sinkingCount += 1
			if not root.Anchored then
				local ok, connected = pcall(root.GetConnectedParts, root, true)
				if ok then
					for _, other in connected do
						if other ~= root and #members < 16 then
							table.insert(members, other)
						end
					end
				end
			end
			root.Anchored = true -- o conjunto soldado desce junto com a raiz
			for _, member in members do
				member.CanCollide = false
				member.CanQuery = false
			end
			local depth = math.max(root.Size.Y, 1) + 3
			local steps = math.max(math.floor(PROP_SINK_TIME / PROP_SINK_STEP), 1)
			local tilt =
				CFrame.Angles(rng:NextNumber(-0.04, 0.04), rng:NextNumber(-0.08, 0.08), rng:NextNumber(-0.04, 0.04))
			trove:Spawn(function()
				for _ = 1, steps do
					task.wait(PROP_SINK_STEP)
					if not root.Parent then
						break
					end
					root.CFrame = (root.CFrame - Vector3.new(0, depth / steps, 0)) * tilt
				end
				for _, member in members do
					if member.Parent then
						member:Destroy()
					end
				end
				sinking[root] = nil
				sinkingCount -= 1
			end)
		end

		trove:Spawn(function()
			while ctx.isActive() do
				task.wait(PROP_SCAN_INTERVAL)
				if Destruction and sinkingCount < MAX_SINKING then
					local params = PhysUtil.OverlapParams(true, 40)
					for _, patch in patches do
						local diameter = patch.radius * 2
						local found = workspace:GetPartBoundsInBox(
							CFrame.new(patch.position + Vector3.new(0, 3, 0)),
							Vector3.new(diameter, 6, diameter),
							params
						)
						for _, part in found do
							if sinkingCount >= MAX_SINKING then
								break
							end
							local root = Destruction.GetLooseRoot(part)
							if not root and not part.Anchored and CollectionService:HasTag(part, Tags.Debris) then
								root = part.AssemblyRootPart or part
							end
							if
								root
								and not sinking[root]
								and root.Parent
								and not Destruction.IsProtected(root)
								and patchAt(root.Position, 6)
							then
								sinkProp(root)
							end
						end
					end
				end
			end
		end)

		-- No finzinho, a areia seca e some.
		trove:Add(task.delay(math.max(ctx.duration - DRY_TIME - 0.2, 1), function()
			if not ctx.isActive() then
				return
			end
			local info = TweenInfo.new(DRY_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			for _, patch in patches do
				for _, part in patch.parts do
					if part.Parent then
						TweenService:Create(part, info, { Transparency = 1, Color = SAND }):Play()
					end
				end
			end
		end))

		return function()
			if cleaned then
				return
			end
			cleaned = true
			trove:Clean()
			for player in table.clone(inside) do
				release(player)
			end
			PhysUtil.ClearModifiersWithKey(modifierKey)
			-- Objetos que estavam afundando foram "engolidos".
			for _, members in sinking do
				for _, member in members do
					if member.Parent then
						member:Destroy()
					end
				end
			end
			table.clear(sinking)
		end
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">Spiders</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Evento de NPC "Aranhas Gigantes": teias decorativas aparecem nas paredes (ou no chão) em volta do ponto
-- do evento e 5 a 8 aranhas saem de pontos ao redor, em 2 ondas. Elas mordem e cospem teia, que deixa o
-- jogador lento (IA da Aranha). Termina quando todas morrem (ou ao fim da duração).

local NpcEventUtil = require(script.Parent.Parent.EventHelpers.NpcEventUtil)
local Effects = require(script.Parent.Parent.NPC.Effects)

local MIN_COUNT, MAX_COUNT = 5, 8
local WAVE_INTERVAL = 30
local WEB_COUNT_MIN, WEB_COUNT_MAX = 3, 4
local WEB_SPOKES = 6
local WEB_RADIUS_MIN, WEB_RADIUS_MAX = 3.5, 5.5
local WEB_SEARCH_DIRECTIONS = 10
local WEB_WALL_REACH = 24
local WEB_HEIGHT = 5 -- altura do centro da teia nas paredes
local WEB_COLOR = Color3.fromRGB(236, 236, 230)
local STRAND_THICKNESS = 0.09

-- Um fio de teia (part fina, ancorada, sem colisão e fora das consultas espaciais).
local function strand(folder: Instance, a: Vector3, b: Vector3, thickness: number)
	local length = (b - a).Magnitude
	if length < 0.1 then
		return
	end
	local part = Instance.new("Part")
	part.Name = "FioDeTeia"
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Material = Enum.Material.SmoothPlastic
	part.Color = WEB_COLOR
	part.Transparency = 0.2
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Size = Vector3.new(thickness, thickness, length)
	part.CFrame = CFrame.lookAt((a + b) / 2, b)
	part.Parent = folder
end

-- Teia radial no plano XY local de `cframe` (o LookVector é a normal da teia): raios + um anel.
local function buildWeb(folder: Instance, cframe: CFrame, radius: number, rng: Random)
	local ring = {}
	for index = 1, WEB_SPOKES do
		local angle = (index / WEB_SPOKES) * math.pi * 2 + rng:NextNumber(-0.15, 0.15)
		local direction = Vector3.new(math.cos(angle), math.sin(angle), 0)
		strand(folder, cframe.Position, cframe:PointToWorldSpace(direction * radius), STRAND_THICKNESS)
		ring[index] = cframe:PointToWorldSpace(direction * radius * rng:NextNumber(0.5, 0.65))
	end
	for index = 1, WEB_SPOKES do
		strand(folder, ring[index], ring[index % WEB_SPOKES + 1], STRAND_THICKNESS * 0.8)
	end
end

-- Procura paredes em volta do centro; sem parede, a teia fica deitada no chão.
local function decorate(ctx, rng: Random, ground)
	local center: Vector3 = ctx.position
	local floor = Effects.Ground(center, 30, 2) or center
	local eye = floor + Vector3.new(0, WEB_HEIGHT, 0)
	local params = Effects.WorldParams()
	local wanted = rng:NextInteger(WEB_COUNT_MIN, WEB_COUNT_MAX)
	local placed = 0
	local offset = rng:NextNumber(0, math.pi * 2)
	for index = 1, WEB_SEARCH_DIRECTIONS do
		if placed >= wanted then
			break
		end
		local angle = offset + (index / WEB_SEARCH_DIRECTIONS) * math.pi * 2
		local direction = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local hit = workspace:Raycast(eye, direction * WEB_WALL_REACH, params)
		if hit and math.abs(hit.Normal.Y) < 0.3 then
			local position = hit.Position + hit.Normal * 0.12
			buildWeb(
				ctx.folder,
				CFrame.lookAt(position, position + hit.Normal),
				rng:NextNumber(WEB_RADIUS_MIN, WEB_RADIUS_MAX),
				rng
			)
			placed += 1
		end
	end
	-- Faltou parede: teias no chão em volta do centro.
	while placed < wanted do
		local point = ground.RandomPointNear(center, 6, math.max(ctx.radius * 0.4, 10), rng, 6)
		local flatWeb = CFrame.new(point + Vector3.new(0, 0.1, 0))
			* CFrame.Angles(math.pi / 2, rng:NextNumber(0, math.pi * 2), 0)
		buildWeb(ctx.folder, flatWeb, rng:NextNumber(WEB_RADIUS_MIN, WEB_RADIUS_MAX), rng)
		placed += 1
	end
end

return {
	Id = "Spiders",
	DisplayName = "Aranhas Gigantes",
	Kind = "npc",
	Riddles = {
		"Oito patas saem do canto escuro;\nsua teia te prende, nenhum passo é seguro.",
		"Fios brancos se espalham pelo salão;\nquem cair na teia vira refeição.",
		"Algo peludo corre pelas paredes;\nfuja das presas e das grudentas redes.",
	},
	Weight = 1,
	MinSpace = 4,
	Duration = 90,
	Radius = 50,

	Start = function(ctx)
		local session = NpcEventUtil.new(ctx, "Spiders")
		local rng: Random = ctx.random
		local players = NpcEventUtil.AlivePlayerCount(ctx)
		local total = math.clamp(MIN_COUNT + (players - 1) + rng:NextInteger(0, 1), MIN_COUNT, MAX_COUNT)

		local ok, err = pcall(decorate, ctx, rng, session.ground)
		if not ok then
			warn("[Spiders] Erro ao criar as teias: " .. tostring(err))
		end
		Effects.Sound("Spider", ctx.position, { Volume = 1, RollOffMaxDistance = 160 })

		session:RunWaves("Spider", NpcEventUtil.SplitWaves(total, 2), {
			interval = WAVE_INTERVAL,
			waveMessage = "Mais aranhas descem das teias!",
		})

		return function()
			session:Cleanup()
		end
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">Stampede</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Evento físico "Debandada": ondas de rinocerontes e elefantes atravessam o ponto do evento em linha reta,
-- cada onda vinda de uma direção aleatória. Os animais são modelos de blocos ancorados, movidos por CFrame
-- a ~40 studs/s seguindo o chão; quebram o que é Destructible à frente, arremessam objetos soltos e
-- atropelam jogadores (dano + empurrão) e inimigos.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local SoundUtil = require(ReplicatedStorage.Shared.Audio.SoundUtil)
local Tags = require(ReplicatedStorage.Shared.Tags)

local PhysCreatures = require(script.Parent.Parent.EventHelpers.PhysCreatures)
local PhysUtil = require(script.Parent.Parent.EventHelpers.PhysUtil)

local SPEED = 40 -- studs/s
local WAVES = 4
local WAVE_GAP = 1.5 -- pausa entre o fim de uma onda e o começo da próxima
local HALF_PATH = 130 -- distância percorrida antes e depois do centro
local EDGE_MARGIN = 15 -- os animais não passam da borda da ilha
local MIN_ANIMALS, MAX_ANIMALS = 3, 5
local LANE_SPACING = 7.5
local MAX_STAGGER = 14 -- atraso máximo (em studs) entre animais da mesma onda
local SCAN_INTERVAL = 0.1
local MAX_FRACTURES_PER_SCAN = 4
local SMASH_IMPULSE = 95
local PROP_SPEED = 45
local HIT_DAMAGE = 30
local HIT_COOLDOWN = 1.2
local KNOCKBACK = 85
local STEP_UP = 3 -- degrau máximo que os animais sobem sem quebrar
local CLIMB_SPEED = 30
local FALL_SPEED = 35
local SHAKE_INTERVAL = 0.5
local SOURCE = "Debandada"

local DUST_COLOR = Color3.fromRGB(156, 128, 92)

local function addDust(creature)
	local attachment = Instance.new("Attachment")
	attachment.Name = "Poeira"
	attachment.Position = Vector3.new(0, -creature.footOffset + 0.6, creature.backReach * 0.4)
	attachment.Parent = creature.root
	PhysUtil.Emitter(attachment, {
		Texture = PhysUtil.Textures.Smoke,
		Color = DUST_COLOR,
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 2),
			NumberSequenceKeypoint.new(1, 6),
		}),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.45),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Lifetime = NumberRange.new(1, 1.6),
		Rate = 10,
		Speed = NumberRange.new(2, 5),
		SpreadAngle = Vector2.new(70, 70),
		Acceleration = Vector3.new(0, 2, 0),
		RotSpeed = NumberRange.new(-40, 40),
		Rotation = NumberRange.new(0, 360),
		LightInfluence = 1,
	})
end

return {
	Id = "Stampede",
	DisplayName = "Debandada",
	Kind = "physical",
	Riddles = {
		"Uma nuvem de poeira anuncia a manada;\nnão há porta que resista à debandada.",
		"Ouça o chão tremer com patas de gigante;\nquem ficar no caminho não vê o próximo instante.",
		"Chifres e trombas em fúria vêm rolando;\nparedes e portas vão desmoronando.",
	},
	Weight = 0.8,
	MinSpace = 8,
	Duration = 45,
	Radius = 70,

	Start = function(ctx)
		local trove = PhysUtil.newTrove()
		local services = PhysUtil.Services(ctx)
		local Destruction = services.Destruction
		local Combat = services.Combat
		local rng = ctx.random
		local center = ctx.position
		local groundY = PhysUtil.EventGroundY(center)
		local canHit = PhysUtil.newCooldown(HIT_COOLDOWN)

		local function runWave(waveIndex: number)
			local angle = rng:NextNumber(0, math.pi * 2)
			local direction = Vector3.new(math.cos(angle), 0, math.sin(angle))
			local right = direction:Cross(Vector3.yAxis).Unit
			local flatCenter = Vector3.new(center.X, 0, center.Z)
			local back = math.max(
				math.min(HALF_PATH, PhysUtil.DistanceToIslandEdge(ctx.mapInfo, flatCenter, -direction) - EDGE_MARGIN),
				25
			)
			local front = math.max(
				math.min(HALF_PATH, PhysUtil.DistanceToIslandEdge(ctx.mapInfo, flatCenter, direction) - EDGE_MARGIN),
				25
			)
			local start = flatCenter - direction * back
			local pathLength = back + front

			local waveFolder = Instance.new("Folder")
			waveFolder.Name = "Onda" .. waveIndex
			waveFolder.Parent = ctx.folder
			trove:Add(waveFolder)

			-- Monta a manada em fileiras, com atrasos diferentes (ninguém chega junto).
			local animals = {}
			local count = rng:NextInteger(MIN_ANIMALS, MAX_ANIMALS)
			for index = 1, count do
				local isRhino = rng:NextNumber() < 0.55
				local lateral = (index - (count + 1) / 2) * LANE_SPACING + rng:NextNumber(-2, 2)
				local progress = -rng:NextNumber(0, MAX_STAGGER)
				local flat = start + direction * progress + right * lateral
				local footOffset = isRhino and 4.1 or 6.6
				local pose = CFrame.lookAt(
					Vector3.new(flat.X, groundY + footOffset, flat.Z),
					Vector3.new(flat.X, groundY + footOffset, flat.Z) + direction
				)
				local creature = if isRhino
					then PhysCreatures.Rhino(waveFolder, pose)
					else PhysCreatures.Elephant(waveFolder, pose)
				addDust(creature)
				table.insert(animals, {
					creature = creature,
					lateral = lateral,
					progress = progress,
					y = groundY + creature.footOffset,
					targetY = groundY + creature.footOffset,
					phase = rng:NextNumber(0, math.pi),
					gait = isRhino and 13 or 9,
					bob = isRhino and 0.45 or 0.6,
					done = false,
				})
			end
			SoundUtil.Play("Stampede", {
				Parent = animals[1].creature.root,
				Looped = true,
				Volume = 0.9,
				RollOffMaxDistance = 320,
			})

			-- Movimento (todo frame): só a raiz de cada animal muda de CFrame.
			local movement = trove:Connect(RunService.Heartbeat, function(dt)
				local step = math.min(dt, 0.1)
				local now = os.clock()
				for _, animal in animals do
					if not animal.done then
						animal.progress += SPEED * step
						if animal.progress > pathLength + MAX_STAGGER then
							animal.done = true
						end
						if animal.targetY > animal.y then
							animal.y = math.min(animal.targetY, animal.y + CLIMB_SPEED * step)
						else
							animal.y = math.max(animal.targetY, animal.y - FALL_SPEED * step)
						end
						local flat = start + direction * animal.progress + right * animal.lateral
						local bob = math.abs(math.sin(animal.phase + now * animal.gait)) * animal.bob
						local position = Vector3.new(flat.X, animal.y + bob, flat.Z)
						local root = animal.creature.root
						if root.Parent then
							root.CFrame = CFrame.lookAt(position, position + direction)
						end
					end
				end
			end)

			-- Varredura (10x por segundo): chão, destruição, objetos soltos e atropelamentos.
			local rayParams = PhysUtil.RaycastParams()
			local lastShake = 0
			while ctx.isActive() do
				task.wait(SCAN_INTERVAL)
				local overlap = PhysUtil.OverlapParams(true, 60)
				local fractures = 0
				local alive = 0
				local players = PhysUtil.PlayersInRadius(center, HALF_PATH * 2 + 20, true)
				local enemies = CollectionService:GetTagged(Tags.Enemy)
				local lead: Vector3? = nil
				for _, animal in animals do
					local creature = animal.creature
					local root = creature.root
					if not animal.done and root.Parent and animal.progress > -2 then
						alive += 1
						local rootCFrame = root.CFrame
						lead = lead or rootCFrame.Position

						-- Chão: sobe degraus baixos, desce (cai) quando o chão some.
						local feetY = animal.y - creature.footOffset
						local probe = Vector3.new(rootCFrame.X, feetY + STEP_UP + 1, rootCFrame.Z)
						local hit = workspace:Raycast(probe, Vector3.new(0, -40, 0), rayParams)
						if hit then
							animal.targetY = hit.Position.Y + creature.footOffset
						else
							animal.targetY = animal.y - 6
						end

						-- Caixa à frente do animal (do joelho até o topo, com folga para não pular paredes finas).
						local bottom = -creature.footOffset + 0.8
						local top = creature.topY
						local boxCFrame = rootCFrame * CFrame.new(0, (bottom + top) / 2, -creature.frontReach + 2)
						local boxSize = Vector3.new(creature.halfWidth * 2 + 1, top - bottom, 7)
						local touched = workspace:GetPartBoundsInBox(boxCFrame, boxSize, overlap)
						for _, part in touched do
							if Destruction and Destruction.IsDestructible(part) then
								if fractures < MAX_FRACTURES_PER_SCAN then
									fractures += 1
									Destruction.Fracture(
										part,
										PhysUtil.ClosestPointOnPart(part, rootCFrame.Position),
										SMASH_IMPULSE
									)
								end
							elseif Destruction then
								local fling = direction * PROP_SPEED
									+ right * rng:NextNumber(-12, 12)
									+ Vector3.new(0, rng:NextNumber(18, 30), 0)
								if not Destruction.ReleaseProp(part, fling) and not part.Anchored then
									if CollectionService:HasTag(part, Tags.Debris) then
										Destruction.Push(part, fling)
									end
								end
							end
						end

						-- Atropelamento de jogadores (caixa do corpo no espaço local do animal).
						for _, target in players do
							local localPoint = rootCFrame:PointToObjectSpace(target.root.Position)
							if
								math.abs(localPoint.X) <= creature.halfWidth + 1.5
								and localPoint.Z >= -creature.frontReach - 1.5
								and localPoint.Z <= creature.backReach + 1
								and localPoint.Y >= -creature.footOffset - 1
								and localPoint.Y <= creature.topY + 2
								and canHit(target.player)
							then
								Combat.DamagePlayer(target.player, HIT_DAMAGE, SOURCE)
								local side = localPoint.X >= 0 and 1 or -1
								Combat.Knockback(target.player, direction + right * side * 0.9, KNOCKBACK)
							end
						end

						-- Inimigos no caminho também são atropelados.
						for _, enemy in enemies do
							if enemy:IsA("Model") and enemy:IsDescendantOf(workspace) then
								local localPoint = rootCFrame:PointToObjectSpace(enemy:GetPivot().Position)
								if
									math.abs(localPoint.X) <= creature.halfWidth + 1.5
									and math.abs(localPoint.Z) <= creature.frontReach + 1
									and math.abs(localPoint.Y) <= creature.footOffset + 3
									and canHit(enemy)
								then
									Combat.DamageEnemy(enemy, HIT_DAMAGE, nil)
								end
							end
						end
					elseif not animal.done then
						alive += 1
					end
				end

				local now = os.clock()
				if lead and now - lastShake >= SHAKE_INTERVAL then
					lastShake = now
					PhysUtil.Shake(lead, 90, 0.9, 0.7)
				end
				if alive == 0 then
					break
				end
			end

			movement:Disconnect()
			if waveFolder.Parent then
				waveFolder:Destroy()
			end
		end

		trove:Spawn(function()
			for waveIndex = 1, WAVES do
				if not ctx.isActive() then
					return
				end
				if waveIndex > 1 then
					for _, target in PhysUtil.PlayersInRadius(center, ctx.radius * 3) do
						PhysUtil.Notify(target.player, "A manada está voltando! Saia do caminho!", "warning")
					end
				end
				local ok, err = pcall(runWave, waveIndex)
				if not ok then
					warn("[Stampede] Erro na onda " .. waveIndex .. ": " .. tostring(err))
				end
				task.wait(WAVE_GAP)
			end
			if ctx.isActive() then
				ctx.finish()
			end
		end)

		return function()
			trove:Clean()
		end
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">Tornado</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Evento físico "Tornado": um funil de vento (cilindros translúcidos girando, com pedaços orbitando e
-- poeira) desce do céu, anda devagar pela área por ~40 s e sobe de volta. Puxa e levanta objetos soltos e
-- pedaços (velocidade tangencial + para cima), quebra (com chance) partes Destructible que toca e
-- arremessa jogadores para o alto com dano.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local SoundUtil = require(ReplicatedStorage.Shared.Audio.SoundUtil)
local Tags = require(ReplicatedStorage.Shared.Tags)

local PhysUtil = require(script.Parent.Parent.EventHelpers.PhysUtil)

local FUNNEL_HEIGHT = 60
local SEGMENTS = 7
local BASE_DIAMETER = 5
local TOP_DIAMETER = 38
local ORBIT_BITS = 8
local SPIN_SPEED = 2.6 -- rad/s
local WANDER_SPEED = 9
local TOUCHDOWN_TIME = 3
local ACTIVE_TIME = 38
local LIFTOFF_TIME = 3
local EDGE_MARGIN = 45
local EFFECT_INTERVAL = 0.1
local PULL_RADIUS = 24
local PULL_CENTER_HEIGHT = 12
local SWIRL_SPEED = 38
local INWARD_SPEED = 14
local LIFT_SPEED = 34
local FLING_SPEED = 60
local MAX_LIFTED_PER_TICK = 35
local LIFTED_LIFETIME = 25
local BREAK_INTERVAL = 0.4
local BREAK_RADIUS = 9
local BREAK_HEIGHT = 30
local BREAK_CHANCE = 0.35
local MAX_BREAKS_PER_TICK = 3
local BREAK_IMPULSE = 70
local PLAYER_RADIUS = 10
local PLAYER_DAMAGE = 10
local PLAYER_COOLDOWN = 1.2
local PLAYER_FLING = 80
local SUCTION_RADIUS = 32
local SUCTION_INTERVAL = 0.8
local SUCTION_STRENGTH = 10
local SHAKE_INTERVAL = 1
local SOURCE = "Tornado"

local FUNNEL_COLORS = { Color3.fromRGB(128, 126, 120), Color3.fromRGB(104, 102, 98), Color3.fromRGB(146, 142, 134) }
local DUST_COLOR = Color3.fromRGB(142, 122, 96)
local BIT_COLORS = { Color3.fromRGB(96, 70, 42), Color3.fromRGB(70, 110, 52), Color3.fromRGB(120, 100, 76) }

return {
	Id = "Tornado",
	DisplayName = "Tornado",
	Kind = "physical",
	Riddles = {
		"Um funil de vento desce do céu cinzento;\nsegure-se firme ou voe com o vento.",
		"Um vento que gira e não sabe parar;\no que não está preso, ele vai levar.",
		"Rodopia, rodopia a fúria do ar;\ncadeiras e gente vão sair a voar.",
	},
	Weight = 0.8,
	MinSpace = 10,
	Duration = 48,
	Radius = 70,

	Start = function(ctx)
		local trove = PhysUtil.newTrove()
		local services = PhysUtil.Services(ctx)
		local Destruction = services.Destruction
		local Combat = services.Combat
		local rng = ctx.random
		local center = ctx.position
		local radius = ctx.radius

		local islandGround = (ctx.mapInfo and ctx.mapInfo.groundY) or PhysUtil.EventGroundY(center)
		local baseY = PhysUtil.EventGroundY(center)
		if baseY > islandGround + 6 then
			baseY = islandGround -- evento no andar de cima: o tornado anda pelo térreo
		end

		-- Funil ------------------------------------------------------------------------------------
		local model = Instance.new("Model")
		model.Name = "Tornado"
		local startFlat = center + PhysUtil.RandomFlatUnit(rng) * rng:NextNumber(12, 20)
		local pose = CFrame.new(startFlat.X, baseY + FUNNEL_HEIGHT, startFlat.Z)
		local root = PhysUtil.GhostPart({
			Name = "Raiz",
			Size = Vector3.one,
			CFrame = pose,
			Transparency = 1,
			Parent = model,
		})
		local parts: { BasePart } = { root }
		local visible: { BasePart } = {}
		local segmentHeight = FUNNEL_HEIGHT / SEGMENTS
		local middleSegment: BasePart = root
		for index = 1, SEGMENTS do
			local t = (index - 0.5) / SEGMENTS
			local diameter = BASE_DIAMETER + (TOP_DIAMETER - BASE_DIAMETER) * t ^ 1.6
			local wobble = math.sin(index * 1.3) * 1.2
			local segment = PhysUtil.GhostPart({
				Name = "Funil",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(segmentHeight + 0.6, diameter, diameter),
				CFrame = pose
					* CFrame.new(wobble, (index - 0.5) * segmentHeight, 0)
					* CFrame.Angles(0, 0, math.rad(90)),
				Color = FUNNEL_COLORS[(index % #FUNNEL_COLORS) + 1],
				Material = Enum.Material.SmoothPlastic,
				Transparency = 0.45 + index * 0.035,
				Parent = model,
			})
			table.insert(parts, segment)
			table.insert(visible, segment)
			if index == math.ceil(SEGMENTS / 2) then
				middleSegment = segment
			end
		end
		-- Pedaços orbitando: deixam o giro visível (cilindros girando em volta do eixo parecem parados).
		for index = 1, ORBIT_BITS do
			local height = rng:NextNumber(4, FUNNEL_HEIGHT * 0.8)
			local t = height / FUNNEL_HEIGHT
			local orbit = (BASE_DIAMETER + (TOP_DIAMETER - BASE_DIAMETER) * t ^ 1.6) / 2 + 1.5
			local angle = (index / ORBIT_BITS) * math.pi * 2
			local bit = PhysUtil.GhostPart({
				Name = "Destroco",
				Size = Vector3.new(rng:NextNumber(0.6, 1.6), rng:NextNumber(0.3, 0.8), rng:NextNumber(1, 2.4)),
				CFrame = pose
					* CFrame.new(math.cos(angle) * orbit, height, math.sin(angle) * orbit)
					* CFrame.Angles(rng:NextNumber(0, 3), rng:NextNumber(0, 3), rng:NextNumber(0, 3)),
				Color = BIT_COLORS[rng:NextInteger(1, #BIT_COLORS)],
				Material = Enum.Material.Wood,
				Parent = model,
			})
			table.insert(parts, bit)
			table.insert(visible, bit)
		end
		-- Anel de poeira no chão.
		local ring = PhysUtil.GhostPart({
			Name = "Poeira",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.4, 16, 16),
			CFrame = pose * CFrame.new(0, 0.3, 0) * CFrame.Angles(0, 0, math.rad(90)),
			Color = DUST_COLOR,
			Transparency = 0.7,
			Parent = model,
		})
		table.insert(parts, ring)
		table.insert(visible, ring)
		PhysUtil.Emitter(ring, {
			Texture = PhysUtil.Textures.Smoke,
			Color = DUST_COLOR,
			Size = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 4),
				NumberSequenceKeypoint.new(1, 10),
			}),
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.45),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Lifetime = NumberRange.new(1.5, 2.5),
			Rate = 28,
			Speed = NumberRange.new(8, 14),
			EmissionDirection = Enum.NormalId.Right, -- o eixo X do cilindro aponta para cima
			SpreadAngle = Vector2.new(75, 75),
			Acceleration = Vector3.new(0, 6, 0),
			RotSpeed = NumberRange.new(-120, 120),
			Rotation = NumberRange.new(0, 360),
		})
		PhysUtil.Emitter(middleSegment, {
			Texture = PhysUtil.Textures.Smoke,
			Color = FUNNEL_COLORS[2],
			Size = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 6),
				NumberSequenceKeypoint.new(1, 12),
			}),
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.6),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Lifetime = NumberRange.new(1.2, 1.8),
			Rate = 10,
			Speed = NumberRange.new(2, 4),
			RotSpeed = NumberRange.new(-200, 200),
			Rotation = NumberRange.new(0, 360),
		})
		PhysUtil.WeldAll(root, parts)
		model.PrimaryPart = root
		model.Parent = ctx.folder
		trove:Add(model)
		SoundUtil.Play("Wind", { Parent = root, Looped = true, Volume = 1, RollOffMaxDistance = 300 })

		-- Movimento ------------------------------------------------------------------------------
		local position = Vector3.new(startFlat.X, baseY, startFlat.Z)
		local height = FUNNEL_HEIGHT -- altura da base acima do chão (desce no começo, sobe no fim)
		local spin = 0
		local phase = "touchdown"
		local phaseStarted = os.clock()
		local waypoint = position

		local function newWaypoint()
			for _ = 1, 10 do
				local candidate = center + PhysUtil.RandomFlatUnit(rng) * rng:NextNumber(0, radius * 0.8)
				if PhysUtil.IsInsideIsland(ctx.mapInfo, candidate, EDGE_MARGIN) then
					waypoint = Vector3.new(candidate.X, baseY, candidate.Z)
					return
				end
			end
			waypoint = Vector3.new(center.X, baseY, center.Z)
		end
		newWaypoint()

		local function grounded(): boolean
			return phase == "active"
		end

		trove:Connect(RunService.Heartbeat, function(dt)
			local step = math.min(dt, 0.1)
			local now = os.clock()
			local elapsed = now - phaseStarted
			if phase == "touchdown" then
				height = FUNNEL_HEIGHT * (1 - math.clamp(elapsed / TOUCHDOWN_TIME, 0, 1))
				if elapsed >= TOUCHDOWN_TIME then
					phase, phaseStarted, height = "active", now, 0
				end
			elseif phase == "active" then
				if elapsed >= ACTIVE_TIME then
					phase, phaseStarted = "liftoff", now
				end
			elseif phase == "liftoff" then
				height = FUNNEL_HEIGHT * math.clamp(elapsed / LIFTOFF_TIME, 0, 1)
			end

			local toWaypoint = waypoint - position
			local flat = Vector3.new(toWaypoint.X, 0, toWaypoint.Z)
			if flat.Magnitude < 4 then
				newWaypoint()
			else
				position += flat.Unit * math.min(WANDER_SPEED * step, flat.Magnitude)
			end
			spin = (spin + SPIN_SPEED * step) % (math.pi * 2)
			local lean = flat.Magnitude > 0.1 and flat.Unit * 0.07 or Vector3.zero
			if root.Parent then
				root.CFrame = CFrame.new(position + Vector3.new(0, height, 0))
					* CFrame.Angles(lean.Z, 0, -lean.X)
					* CFrame.Angles(0, spin, 0)
			end
		end)

		-- Fim: o funil sobe, some e o evento termina.
		trove:Spawn(function()
			while ctx.isActive() and phase ~= "liftoff" do
				task.wait(0.25)
			end
			if not ctx.isActive() then
				return
			end
			local originals = {}
			for _, part in visible do
				originals[part] = part.Transparency
			end
			for stepIndex = 1, 6 do
				task.wait(LIFTOFF_TIME / 6)
				local alpha = stepIndex / 6
				for part, base in originals do
					if part.Parent then
						part.Transparency = base + (1 - base) * alpha
					end
				end
			end
			for _, emitter in model:GetDescendants() do
				if emitter:IsA("ParticleEmitter") then
					emitter.Enabled = false
				end
			end
			task.wait(0.5)
			if ctx.isActive() then
				ctx.finish()
			end
		end)

		-- Efeitos ----------------------------------------------------------------------------------
		local canHit = PhysUtil.newCooldown(PLAYER_COOLDOWN)
		trove:Spawn(function()
			local lastBreak, lastSuction, lastShake = 0, 0, 0
			while ctx.isActive() do
				task.wait(EFFECT_INTERVAL)
				if grounded() then
					local base = Vector3.new(position.X, baseY, position.Z)
					local now = os.clock()

					-- Objetos soltos e pedaços: giram em volta do funil, sobem e são cuspidos lá em cima.
					if Destruction then
						local found = workspace:GetPartBoundsInRadius(
							base + Vector3.new(0, PULL_CENTER_HEIGHT, 0),
							PULL_RADIUS,
							PhysUtil.OverlapParams(true, 150)
						)
						local handled = {}
						local count = 0
						for _, part in found do
							if count >= MAX_LIFTED_PER_TICK then
								break
							end
							local target = Destruction.GetLooseRoot(part)
							if not target and not part.Anchored and CollectionService:HasTag(part, Tags.Debris) then
								target = part.AssemblyRootPart or part
							end
							if target and not handled[target] and target.Parent then
								handled[target] = true
								count += 1
								if CollectionService:HasTag(target, Tags.LooseProp) then
									-- O tornado "leva" o objeto: ele vira pedaço e some depois de um tempo.
									target = Destruction.ReleaseProp(target)
									if target then
										Destruction.RegisterDebris(target, LIFTED_LIFETIME)
									end
								end
								if target and not target.Anchored then
									local offset = target.Position - base
									local flat = Vector3.new(offset.X, 0, offset.Z)
									local distance = flat.Magnitude
									local outward = distance > 0.1 and flat.Unit or Vector3.xAxis
									local velocity
									if offset.Y > FUNNEL_HEIGHT * 0.7 then
										velocity = outward * FLING_SPEED + Vector3.new(0, 8, 0)
									else
										local closeness = 1 - math.clamp(distance / PULL_RADIUS, 0, 1)
										local tangent = Vector3.yAxis:Cross(outward)
										local inward = distance > 6 and -outward * INWARD_SPEED or outward * 3
										velocity = tangent * SWIRL_SPEED * (0.5 + closeness * 0.5)
											+ inward
											+ Vector3.new(0, LIFT_SPEED * (0.35 + closeness * 0.65), 0)
									end
									Destruction.Push(target, velocity)
								end
							end
						end
					end

					-- Partes Destructible tocadas pelo funil quebram (com chance).
					if Destruction and now - lastBreak >= BREAK_INTERVAL then
						lastBreak = now
						local touched = workspace:GetPartBoundsInBox(
							CFrame.new(base + Vector3.new(0, BREAK_HEIGHT / 2, 0)),
							Vector3.new(BREAK_RADIUS * 2, BREAK_HEIGHT, BREAK_RADIUS * 2),
							PhysUtil.OverlapParams(false, 60)
						)
						local breaks = 0
						for _, part in touched do
							if breaks >= MAX_BREAKS_PER_TICK then
								break
							end
							if rng:NextNumber() < BREAK_CHANCE and Destruction.IsDestructible(part) then
								breaks += 1
								local axisPoint = Vector3.new(base.X, part.Position.Y, base.Z)
								Destruction.Fracture(part, PhysUtil.ClosestPointOnPart(part, axisPoint), BREAK_IMPULSE)
							end
						end
					end

					-- Jogadores: perto do eixo voam para o alto; um pouco mais longe são puxados.
					local suction = now - lastSuction >= SUCTION_INTERVAL
					if suction then
						lastSuction = now
					end
					for _, target in PhysUtil.PlayersInRadius(base, SUCTION_RADIUS, true) do
						local offset = target.root.Position - base
						if offset.Y > -4 and offset.Y < FUNNEL_HEIGHT then
							local outward = PhysUtil.FlatUnit(offset, Vector3.xAxis)
							if target.distance <= PLAYER_RADIUS then
								if canHit(target.player) then
									Combat.DamagePlayer(target.player, PLAYER_DAMAGE, SOURCE)
									local tangent = Vector3.yAxis:Cross(outward)
									Combat.Knockback(
										target.player,
										tangent * 0.6 + Vector3.new(0, 1.6, 0),
										PLAYER_FLING
									)
								end
							elseif suction then
								Combat.Knockback(target.player, -outward, SUCTION_STRENGTH)
							end
						end
					end

					if now - lastShake >= SHAKE_INTERVAL then
						lastShake = now
						PhysUtil.Shake(base, 70, 0.6, SHAKE_INTERVAL + 0.2)
					end
				end
			end
		end)

		return function()
			trove:Clean()
		end
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">Vines</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Evento físico "Cipós Carnívoros": cipós (cadeias de cilindros verdes) crescem a partir do ponto do evento
-- pelo chão e sobem pelas paredes. Encostar num cipó prende o jogador (WalkSpeed 2 por 1,5 s) e machuca.
-- Plantas carnívoras (NPC "Plant") brotam entre os cipós; quando todas morrem, os cipós murcham e o
-- evento acaba antes do tempo.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local SoundUtil = require(ReplicatedStorage.Shared.Audio.SoundUtil)

local PhysUtil = require(script.Parent.Parent.EventHelpers.PhysUtil)

local START_TENDRILS = 6
local MAX_TENDRILS = 11
local SEGMENT_LENGTH = 3
local MAX_SEGMENTS = 110 -- orçamento total de segmentos (celular)
local MAX_SEGMENTS_PER_TENDRIL = 18
local BRANCH_EVERY = 6
local GROW_INTERVAL = 0.35
local MAX_CLIMB = 10
local LEAF_EVERY = 3
local START_THICKNESS = 1.1
local MIN_THICKNESS = 0.45
local SNARE_SPEED = 2
local SNARE_TIME = 1.5
local SNARE_DAMAGE = 5
local SNARE_COOLDOWN = 1.5
local SNARE_NOTIFY_COOLDOWN = 8
local TOUCH_INTERVAL = 0.15
local TOUCH_REACH = 1.3 -- folga entre o cipó e o corpo do jogador
local PLANT_MIN, PLANT_MAX = 3, 6
local PLANT_INTERVAL = 1.6
local NO_PLANT_TIMEOUT = 40 -- sem plantas (limite de NPCs): os cipós murcham depois disto
local WITHER_STEPS = 5
local SOURCE = "Cipós Carnívoros"

local VINE_COLORS = { Color3.fromRGB(46, 108, 40), Color3.fromRGB(58, 124, 46), Color3.fromRGB(38, 92, 36) }
local LEAF_COLOR = Color3.fromRGB(86, 156, 60)
local WITHERED = Color3.fromRGB(112, 86, 52)

return {
	Id = "Vines",
	DisplayName = "Cipós Carnívoros",
	Kind = "physical",
	Riddles = {
		"Verdes serpentes sobem pela parede;\nflores com dentes estão com muita sede.",
		"Não toque nos cipós que brotam do chão;\na flor faminta quer morder a sua mão.",
		"Raízes famintas rastejam devagar;\nse um cipó te pegar, não vai te soltar.",
	},
	Weight = 1,
	MinSpace = 3,
	Duration = 90,
	Radius = 45,

	Start = function(ctx)
		local trove = PhysUtil.newTrove()
		local services = PhysUtil.Services(ctx)
		local NPC = services.NPC
		local Combat = services.Combat
		local Ground = services.Ground
		local rng = ctx.random
		local center = ctx.position
		local radius = ctx.radius
		local modifierKey = "Vines:" .. ctx.instanceId
		local groundY = PhysUtil.EventGroundY(center)
		local origin = Vector3.new(center.X, groundY + 0.45, center.Z)
		local rayParams = PhysUtil.RaycastParams()

		local segments = {} -- { a: Vector3, b: Vector3, radius: number, part: BasePart }
		local leaves: { BasePart } = {}
		local tendrils = {}
		local withering = false
		local cleaned = false

		-- Construção ------------------------------------------------------------------------------
		local function addSegment(tendril, a: Vector3, b: Vector3)
			local cframe, length = PhysUtil.CylinderBetween(a, b)
			if length < 0.2 then
				return
			end
			local progress = tendril.segments / (MAX_SEGMENTS_PER_TENDRIL * 1.3)
			local thickness = math.max(tendril.thickness * (1 - progress), MIN_THICKNESS)
			local part = PhysUtil.GhostPart({
				Name = "Cipo",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(length + thickness * 0.6, thickness, thickness),
				CFrame = cframe,
				Color = VINE_COLORS[rng:NextInteger(1, #VINE_COLORS)],
				Material = Enum.Material.Grass,
				Parent = ctx.folder,
			})
			table.insert(segments, { a = a, b = b, radius = thickness / 2, part = part })
			tendril.segments += 1
			if tendril.segments % LEAF_EVERY == 0 then
				local middle = (a + b) / 2
				local leaf = PhysUtil.GhostPart({
					Name = "Folha",
					Size = Vector3.new(1, 0.12, 0.7),
					CFrame = CFrame.new(middle + Vector3.new(0, thickness * 0.4, 0))
						* CFrame.Angles(rng:NextNumber(-0.6, 0.6), rng:NextNumber(0, math.pi * 2), 0)
						* CFrame.new(thickness * 0.5 + 0.4, 0, 0),
					Color = LEAF_COLOR,
					Material = Enum.Material.Grass,
					Parent = ctx.folder,
				})
				table.insert(leaves, leaf)
			end
		end

		local function newTendril(position: Vector3, direction: Vector3, thickness: number)
			if #tendrils >= MAX_TENDRILS then
				return
			end
			table.insert(tendrils, {
				pos = position,
				dir = PhysUtil.FlatUnit(direction),
				mode = "ground",
				normal = Vector3.zero,
				climbed = 0,
				segments = 0,
				thickness = thickness,
				alive = true,
			})
		end

		local function growGround(tendril)
			tendril.dir = (CFrame.Angles(0, rng:NextNumber(-0.45, 0.45), 0) * tendril.dir).Unit
			local nextFlat = tendril.pos + tendril.dir * SEGMENT_LENGTH
			if PhysUtil.FlatDistance(nextFlat, center) > radius then
				tendril.alive = false
				return
			end
			-- Parede à frente: o cipó encosta nela e começa a subir.
			local wall = workspace:Raycast(tendril.pos, tendril.dir * SEGMENT_LENGTH, rayParams)
			if wall and math.abs(wall.Normal.Y) < 0.5 then
				local contact = wall.Position + wall.Normal * 0.5
				addSegment(tendril, tendril.pos, contact)
				tendril.pos = contact
				tendril.mode = "wall"
				tendril.normal = PhysUtil.FlatUnit(wall.Normal)
				tendril.climbed = 0
				return
			end
			-- Segue o chão (degraus baixos); sem chão (beirada), o cipó para.
			local ground = workspace:Raycast(nextFlat + Vector3.new(0, 3, 0), Vector3.new(0, -7, 0), rayParams)
			if not ground then
				tendril.alive = false
				return
			end
			local point = ground.Position + Vector3.new(0, 0.45, 0)
			addSegment(tendril, tendril.pos, point)
			tendril.pos = point
		end

		local function growWall(tendril)
			local along = tendril.normal:Cross(Vector3.yAxis)
			local delta = Vector3.new(0, SEGMENT_LENGTH * 0.85, 0) + along * rng:NextNumber(-0.9, 0.9)
			local nextPoint = tendril.pos + delta
			-- Teto (ou outra coisa) no caminho: para de subir.
			if workspace:Raycast(tendril.pos, delta, rayParams) then
				tendril.alive = false
				return
			end
			-- A parede acabou (topo de uma cerca ou de uma parede baixa): para.
			if not workspace:Raycast(nextPoint, -tendril.normal * 1.6, rayParams) then
				tendril.alive = false
				return
			end
			addSegment(tendril, tendril.pos, nextPoint)
			tendril.pos = nextPoint
			tendril.climbed += delta.Y
			if tendril.climbed >= MAX_CLIMB then
				tendril.alive = false
			end
		end

		-- Crescimento ao longo do tempo.
		for index = 1, START_TENDRILS do
			local angle = (index / START_TENDRILS) * math.pi * 2 + rng:NextNumber(-0.3, 0.3)
			newTendril(origin, Vector3.new(math.cos(angle), 0, math.sin(angle)), START_THICKNESS)
		end
		trove:Spawn(function()
			while ctx.isActive() and not withering and #segments < MAX_SEGMENTS do
				local growing = 0
				for _, tendril in table.clone(tendrils) do
					if tendril.alive and #segments < MAX_SEGMENTS then
						growing += 1
						if tendril.mode == "ground" then
							growGround(tendril)
						else
							growWall(tendril)
						end
						if tendril.segments >= MAX_SEGMENTS_PER_TENDRIL then
							tendril.alive = false
						end
						-- Galhos: de vez em quando nasce um cipó novo para o lado.
						if
							tendril.alive
							and tendril.mode == "ground"
							and tendril.segments > 0
							and tendril.segments % BRANCH_EVERY == 0
						then
							local side = rng:NextNumber() < 0.5 and -1 or 1
							local branchDir = CFrame.Angles(0, side * rng:NextNumber(0.6, 1.1), 0) * tendril.dir
							newTendril(tendril.pos, branchDir, math.max(tendril.thickness * 0.8, MIN_THICKNESS + 0.2))
						end
					end
				end
				if growing == 0 then
					break
				end
				task.wait(GROW_INTERVAL)
			end
		end)

		-- Plantas carnívoras -----------------------------------------------------------------------
		local plantsSpawned = 0
		local plantPhaseDone = false
		local function plantPoint(): Vector3
			-- De preferência na ponta de um cipó que está no chão; senão, um ponto livre perto do centro.
			local candidates = {}
			for _, tendril in tendrils do
				if tendril.mode == "ground" and tendril.segments >= 2 then
					table.insert(candidates, tendril.pos)
				end
			end
			if #candidates > 0 and rng:NextNumber() < 0.7 then
				local point = candidates[rng:NextInteger(1, #candidates)]
				local ground = Ground.FindGround(point, 8, 2)
				if ground then
					return ground
				end
			end
			return Ground.RandomPointNear(center, 6, radius * 0.6, rng, 8)
		end

		trove:Spawn(function()
			local total = rng:NextInteger(PLANT_MIN, PLANT_MAX)
			if NPC and type(NPC.Spawn) == "function" then
				for _ = 1, total do
					task.wait(PLANT_INTERVAL)
					if not ctx.isActive() or withering then
						break
					end
					local point = plantPoint()
					local cframe = CFrame.new(point) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
					local ok, model = pcall(NPC.Spawn, "Plant", cframe, { groupId = ctx.instanceId })
					if ok and model then
						plantsSpawned += 1
						SoundUtil.Play("Crumble", { Position = point, RollOffMaxDistance = 100, Volume = 0.4 })
					elseif not ok then
						warn("[Vines] Erro ao criar planta carnívora: " .. tostring(model))
					end
				end
			else
				warn("[Vines] NPCService indisponível: os cipós vão aparecer sem plantas carnívoras.")
			end
			plantPhaseDone = true
		end)

		-- Murchar e terminar.
		local function wither(message: string?)
			if withering or not ctx.isActive() then
				return
			end
			withering = true
			PhysUtil.ClearModifiersWithKey(modifierKey)
			if message then
				for _, target in PhysUtil.PlayersInRadius(center, radius * 3) do
					PhysUtil.Notify(target.player, message, "success")
				end
			end
			local originals = {}
			for _, segment in segments do
				originals[segment.part] = segment.part.Color
			end
			for _, leaf in leaves do
				originals[leaf] = leaf.Color
			end
			for step = 1, WITHER_STEPS do
				task.wait(0.4)
				if cleaned then
					return
				end
				local alpha = step / WITHER_STEPS
				for part, color in originals do
					if part.Parent then
						part.Color = color:Lerp(WITHERED, alpha)
						part.Transparency = alpha * 0.6
					end
				end
			end
			if ctx.isActive() then
				ctx.finish()
			end
		end

		trove:Spawn(function()
			local started = os.clock()
			while ctx.isActive() and not withering do
				task.wait(1)
				if plantPhaseDone then
					if plantsSpawned > 0 then
						local ok, alive = pcall(NPC.CountAlive, ctx.instanceId)
						if ok and type(alive) == "number" and alive <= 0 then
							wither("As plantas carnívoras morreram: os cipós estão murchando!")
						end
					elseif os.clock() - started >= NO_PLANT_TIMEOUT then
						wither(nil)
					end
				end
			end
		end)

		-- Toque nos cipós ----------------------------------------------------------------------------
		local canHurt = PhysUtil.newCooldown(SNARE_COOLDOWN)
		local canWarn = PhysUtil.newCooldown(SNARE_NOTIFY_COOLDOWN)
		-- Renovar a prisão a cada checagem criaria uma thread nova por vez: só renova perto de acabar.
		local snaredUntil: { [Humanoid]: number } = setmetatable({}, { __mode = "k" }) :: any
		local function touchesVine(point: Vector3): boolean
			for _, segment in segments do
				if PhysUtil.DistanceToSegment(point, segment.a, segment.b) <= segment.radius + TOUCH_REACH then
					return true
				end
			end
			return false
		end

		trove:Spawn(function()
			while ctx.isActive() and not withering do
				task.wait(TOUCH_INTERVAL)
				if #segments > 0 and not withering then
					for _, target in PhysUtil.PlayersInRadius(center, radius + 15, true) do
						local rootPosition = target.root.Position
						if touchesVine(rootPosition - Vector3.new(0, 2.2, 0)) or touchesVine(rootPosition) then
							local now = os.clock()
							if (snaredUntil[target.humanoid] or 0) - now < SNARE_TIME * 0.5 then
								snaredUntil[target.humanoid] = now + SNARE_TIME
								PhysUtil.SetTimedModifier(
									target.humanoid,
									modifierKey,
									{ walkSpeed = SNARE_SPEED, jumpMultiplier = 0.2 },
									SNARE_TIME
								)
							end
							if canHurt(target.player) then
								Combat.DamagePlayer(target.player, SNARE_DAMAGE, SOURCE)
							end
							if canWarn(target.player) then
								PhysUtil.Notify(target.player, "Um cipó prendeu você! Afaste-se devagar.", "warning")
							end
						end
					end
				end
			end
		end)

		return function()
			if cleaned then
				return
			end
			cleaned = true
			trove:Clean()
			PhysUtil.ClearModifiersWithKey(modifierKey)
			if NPC and type(NPC.DespawnGroup) == "function" then
				local ok, err = pcall(NPC.DespawnGroup, ctx.instanceId)
				if not ok then
					warn("[Vines] Erro ao remover as plantas: " .. tostring(err))
				end
			end
		end
	end,
}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Script" referent="48">
        <Properties>
          <string name="Name">GameMain</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!nonstrict
-- Ponto de entrada do servidor da PARTIDA (place do jogo).
-- Ordem: sons, iluminação, personagens manuais, configurações, remotes, mapa e serviços.
-- Cada serviço inicia em pcall: um módulo quebrado não derruba os outros. Se o MapBuilder falhar,
-- o erro aparece bem visível no Output e um mapa reserva simples é criado para o jogo continuar testável.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local Net = require(ReplicatedStorage.Shared.Net)
local PartBuilder = require(ReplicatedStorage.Shared.Util.PartBuilder)
local SoundUtil = require(ReplicatedStorage.Shared.Audio.SoundUtil)
local Tags = require(ReplicatedStorage.Shared.Tags)

local GameFolder = script.Parent

-- require seguro: devolve (módulo, nil) ou (nil, mensagem de erro).
local function tryRequire(parent: Instance, ...: string): (any, string?)
	local current: Instance? = parent
	local path = {}
	for _, name in { ... } do
		table.insert(path, name)
		current = current and current:FindFirstChild(name)
	end
	local label = table.concat(path, ".")
	if not current or not current:IsA("ModuleScript") then
		return nil, ("módulo '%s' não encontrado"):format(label)
	end
	local ok, result = pcall(require, current)
	if not ok then
		return nil, ("erro ao carregar '%s': %s"):format(label, tostring(result))
	end
	return result, nil
end

-- 1. Sons ---------------------------------------------------------------------------------
SoundUtil.EnsureGroups()

-- 2. Iluminação: selva no fim da tarde. Depois daqui, sombras são assunto do cliente (GraphicsApplier).
do
	Lighting.ClockTime = 17
	Lighting.GeographicLatitude = 15
	Lighting.Brightness = 2.2
	Lighting.Ambient = Color3.fromRGB(46, 52, 40)
	Lighting.OutdoorAmbient = Color3.fromRGB(118, 124, 98)
	Lighting.ColorShift_Top = Color3.fromRGB(255, 212, 158)
	Lighting.ColorShift_Bottom = Color3.fromRGB(40, 60, 30)
	Lighting.EnvironmentDiffuseScale = 0.5
	Lighting.EnvironmentSpecularScale = 0.35
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.2

	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Density = 0.28
	atmosphere.Offset = 0.15
	atmosphere.Color = Color3.fromRGB(176, 200, 150)
	atmosphere.Decay = Color3.fromRGB(88, 116, 74)
	atmosphere.Glare = 0.2
	atmosphere.Haze = 1.4
	atmosphere.Parent = Lighting

	local grade = Lighting:FindFirstChild("CorDaSelva") or Instance.new("ColorCorrectionEffect")
	grade.Name = "CorDaSelva"
	grade.TintColor = Color3.fromRGB(255, 248, 232)
	grade.Saturation = 0.08
	grade.Contrast = 0.06
	grade.Parent = Lighting
end

-- 3. Personagens são criados pelo MatchService (sem respawn automático).
Players.CharacterAutoLoads = false

-- 4. Configurações dos jogadores (Settings_Get / Settings_Save).
do
	local SettingsStore, err = tryRequire(ServerScriptService, "ServerShared", "SettingsStore")
	if SettingsStore and type(SettingsStore.Init) == "function" then
		local ok, initErr = pcall(SettingsStore.Init)
		if not ok then
			warn("[GameMain] Erro ao iniciar o SettingsStore: " .. tostring(initErr))
		end
	else
		warn("[GameMain] SettingsStore indisponível: " .. tostring(err))
	end
end

-- 5. Remotes usados pelo fluxo da partida (existem antes de qualquer cliente pedir).
for _, name in
	{
		Net.Names.Game_ClientReady,
		Net.Names.Game_State,
		Net.Names.Board_Status,
		Net.Names.Board_RollRequest,
		Net.Names.Board_DropRequest,
		Net.Names.Board_Riddle,
		Net.Names.Event_Started,
		Net.Names.Event_Ended,
		Net.Names.Player_Eliminated,
		Net.Names.Fx_Play,
		Net.Names.Notify,
	}
do
	Net.event(name)
end

-- "Pronto" vira um atributo no Player: os serviços reagem a ele, independentemente da ordem de Init.
Net.event(Net.Names.Game_ClientReady).OnServerEvent:Connect(function(player)
	if not player:GetAttribute("ClientReady") then
		player:SetAttribute("ClientReady", true)
	end
end)

-- 6. Mapa ---------------------------------------------------------------------------------

-- Mapa reserva: plataforma, mesa com o tabuleiro e pontos de nascimento (só se o MapBuilder falhar).
local function buildFallbackMap(reason: string)
	local old = workspace:FindFirstChild("Map")
	if old then
		old:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "Map"
	local regions = Instance.new("Folder")
	regions.Name = "Regions"
	regions.Parent = folder

	local center = GameConfig.ISLAND_CENTER
	local groundY = GameConfig.GROUND_Y
	local size = 400

	PartBuilder.part({
		Name = "PlataformaReserva",
		Size = Vector3.new(size, 4, size),
		CFrame = CFrame.new(center.X, groundY - 2, center.Z),
		Color = Color3.fromRGB(74, 120, 56),
		Material = Enum.Material.Grass,
		Tags = { Tags.Indestructible },
		Parent = folder,
	})
	PartBuilder.part({
		Name = "OceanoReserva",
		Size = Vector3.new(2000, 1, 2000),
		CFrame = CFrame.new(center.X, GameConfig.WATER_LEVEL_Y - 0.5, center.Z),
		Color = Color3.fromRGB(40, 110, 140),
		Material = Enum.Material.Glass,
		Transparency = 0.3,
		CanCollide = false,
		CastShadow = false,
		Tags = { Tags.Water, Tags.Indestructible },
		Parent = folder,
	})
	local tableTop = PartBuilder.part({
		Name = "MesaReserva",
		Size = Vector3.new(7, 3, 5),
		CFrame = CFrame.new(center.X, groundY + 1.5, center.Z),
		Color = Color3.fromRGB(92, 60, 32),
		Material = Enum.Material.Wood,
		Tags = { Tags.Indestructible },
		Parent = folder,
	})
	local region = PartBuilder.part({
		Name = "RegiaoReserva",
		Size = Vector3.new(size, 40, size),
		CFrame = CFrame.new(center.X, groundY + 20, center.Z),
		Transparency = 1,
		CanCollide = false,
		CanTouch = false,
		Attributes = { RegionName = "Clareira", Floor = 0 },
		Parent = regions,
	})
	region.CanQuery = false -- só depois de CanCollide = false

	local spawns = {}
	for index = 1, 6 do
		local angle = (index / 6) * math.pi * 2
		local position = Vector3.new(center.X + math.cos(angle) * 12, groundY, center.Z + math.sin(angle) * 12)
		table.insert(spawns, CFrame.lookAt(position, Vector3.new(center.X, groundY, center.Z)))
	end

	folder.Parent = workspace
	workspace:SetAttribute("MapError", reason)
	workspace:SetAttribute("MapReady", true)

	return {
		islandCenter = center,
		islandRadius = size / 2 - 10,
		groundY = groundY,
		waterLevelY = GameConfig.WATER_LEVEL_Y,
		startRoom = { cframe = CFrame.new(center.X, groundY + 6, center.Z), size = Vector3.new(60, 12, 60) },
		boardSpawn = CFrame.new(tableTop.Position + Vector3.new(0, tableTop.Size.Y / 2, 0)),
		playerSpawns = spawns,
		weaponSpawns = {},
		regions = {},
		mapFolder = folder,
	}
end

-- Garante todos os campos do MapInfo (com valores padrão onde faltar).
local function normalizeMapInfo(info)
	local result = table.clone(info)
	if typeof(result.islandCenter) ~= "Vector3" then
		result.islandCenter = GameConfig.ISLAND_CENTER
	end
	if type(result.islandRadius) ~= "number" then
		result.islandRadius = GameConfig.ISLAND_RADIUS
	end
	if type(result.groundY) ~= "number" then
		result.groundY = GameConfig.GROUND_Y
	end
	if type(result.waterLevelY) ~= "number" then
		result.waterLevelY = GameConfig.WATER_LEVEL_Y
	end
	if type(result.startRoom) ~= "table" or typeof(result.startRoom.cframe) ~= "CFrame" then
		result.startRoom = {
			cframe = CFrame.new(GameConfig.MANSION_CENTER + Vector3.new(0, 6, 0)),
			size = Vector3.new(40, 12, 40),
		}
	end
	if typeof(result.boardSpawn) ~= "CFrame" then
		result.boardSpawn = result.startRoom.cframe
	end
	local spawns = {}
	if type(result.playerSpawns) == "table" then
		for _, spawnCFrame in result.playerSpawns do
			if typeof(spawnCFrame) == "CFrame" then
				table.insert(spawns, spawnCFrame)
			end
		end
	end
	if #spawns == 0 then
		local roomCFrame = result.startRoom.cframe
		local radius = 6
		if typeof(result.startRoom.size) == "Vector3" then
			radius = math.clamp(math.min(result.startRoom.size.X, result.startRoom.size.Z) / 3, 4, 14)
		end
		for index = 1, 6 do
			local angle = (index / 6) * math.pi * 2
			table.insert(spawns, roomCFrame * CFrame.new(math.cos(angle) * radius, 0, math.sin(angle) * radius))
		end
		warn("[GameMain] MapInfo sem playerSpawns; usando pontos ao redor da sala inicial.")
	end
	result.playerSpawns = spawns
	if type(result.weaponSpawns) ~= "table" then
		result.weaponSpawns = {}
	end
	if type(result.regions) ~= "table" then
		result.regions = {}
	end
	if typeof(result.mapFolder) ~= "Instance" then
		result.mapFolder = workspace:FindFirstChild("Map")
	end
	return result
end

local mapInfo = nil
do
	local MapBuilder, loadError = tryRequire(GameFolder, "Map", "MapBuilder")
	local failure = loadError
	if MapBuilder and type(MapBuilder.Build) == "function" then
		local ok, result = pcall(MapBuilder.Build)
		if ok and type(result) == "table" then
			mapInfo = result
		else
			failure = ok and "MapBuilder.Build não devolveu um MapInfo" or tostring(result)
		end
	elseif MapBuilder then
		failure = "MapBuilder não tem a função Build"
	end

	if not mapInfo then
		local message = tostring(failure)
		warn(
			"\n==================== ERRO AO CONSTRUIR O MAPA ====================\n"
				.. "[GameMain] "
				.. message
				.. "\nUm mapa reserva simples será usado para o jogo continuar testável."
				.. "\nCorrija o erro em Game/Map/MapBuilder e rode de novo."
				.. "\n================================================================="
		)
		mapInfo = buildFallbackMap(message)
	end
end
mapInfo = normalizeMapInfo(mapInfo)
if not workspace:GetAttribute("MapReady") then
	workspace:SetAttribute("MapReady", true)
end

-- 7. Serviços (cada um em pcall) ---------------------------------------------------------

local function initService(label: string, path: { string }, ...: any)
	local module, err = tryRequire(GameFolder, table.unpack(path))
	if not module then
		warn(("[GameMain] %s não foi carregado: %s"):format(label, tostring(err)))
		return
	end
	if type(module.Init) ~= "function" then
		warn(("[GameMain] %s não tem a função Init."):format(label))
		return
	end
	local args = table.pack(...)
	local ok, initErr = pcall(function()
		module.Init(table.unpack(args, 1, args.n))
	end)
	if not ok then
		warn(("[GameMain] Erro ao iniciar %s: %s"):format(label, tostring(initErr)))
	end
end

initService("DestructionService", { "DestructionService" })
initService("NPCService", { "NPC", "NPCService" })
initService("WeaponService", { "Weapons", "WeaponService" }, mapInfo)
initService("BoardService", { "BoardService" }, mapInfo)
initService("EventService", { "EventService" }, mapInfo)
initService("BoundaryService", { "BoundaryService" }, mapInfo)
initService("MatchService", { "MatchService" }, mapInfo)

print(("[GameMain] %s: servidor da partida pronto."):format(GameConfig.GAME_TITLE))
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="49">
        <Properties>
          <string name="Name">Map</string>
        </Properties>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">Furniture</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Biblioteca de móveis e objetos feitos de parts.
-- Convenção: `cf` é o centro da base do objeto no piso; a FRENTE do objeto aponta para o -Z local
-- e as costas (lado que encosta na parede) ficam no +Z local.
-- Móveis grandes recebem a tag Destructible; objetos pequenos são LooseProp (a part raiz fica ancorada
-- e as demais partes ficam soldadas nela, para o objeto inteiro voar junto quando um evento o soltar).

local Kit = require(script.Parent.Kit)
local Palette = require(script.Parent.Palette)

local Furniture = {}

local M = Enum.Material
local D = Kit.D
local L = Kit.L
local GHOST = { Ghost = true }
local GHOST_NO_SHADOW = { Ghost = true, NoShadow = true }
local NO_SHADOW = { NoShadow = true }

local VERTICAL = CFrame.Angles(0, 0, math.rad(90))

-- Bloco com deslocamento local (x, y, z) a partir de `cf`.
local function B(ctx, parent, name, cf, x, y, z, sx, sy, sz, color, material, tags, extra): BasePart
	return Kit.box(ctx, parent, name, cf * CFrame.new(x, y, z), Vector3.new(sx, sy, sz), color, material, tags, extra)
end

-- Cilindro em pé com deslocamento local.
local function C(ctx, parent, name, cf, x, y, z, height, diameter, color, material, tags, extra): BasePart
	return Kit.cylinderAlong(
		ctx,
		parent,
		name,
		cf * CFrame.new(x, y, z) * VERTICAL,
		height,
		diameter,
		color,
		material,
		tags,
		extra
	)
end

Furniture.B = B
Furniture.C = C

-- Mesas e assentos -------------------------------------------------------------------

-- Mesa com tampo e dois cavaletes. Retorna o tampo.
function Furniture.Table(
	ctx,
	parent,
	cf: CFrame,
	w: number,
	d: number,
	h: number,
	color: Color3,
	material: Enum.Material?
)
	local mat = material or M.Wood
	local top = B(ctx, parent, "Tampo", cf, 0, h - 0.3, 0, w, 0.6, d, color, mat, D)
	local inset = math.min(1.2, w * 0.15)
	for _, side in { -1, 1 } do
		B(ctx, parent, "Cavalete", cf, side * (w / 2 - inset), (h - 0.6) / 2, 0, 0.7, h - 0.6, d * 0.7, color, mat, D)
	end
	return top
end

-- Mesinha redonda solta (LooseProp).
function Furniture.SideTable(ctx, parent, cf: CFrame, diameter: number, h: number, color: Color3)
	local top = C(ctx, parent, "Mesinha", cf, 0, h - 0.15, 0, 0.3, diameter, color, M.Wood, L)
	local leg = C(ctx, parent, "Pe", cf, 0, (h - 0.3) / 2, 0, h - 0.3, 0.6, color, M.Wood)
	Kit.weldTo(top, { leg })
	return top
end

-- Cadeira (LooseProp): assento, encosto e duas laterais.
function Furniture.Chair(ctx, parent, cf: CFrame, color: Color3, seatColor: Color3?)
	local seat = B(ctx, parent, "Cadeira", cf, 0, 1.8, 0, 2, 0.35, 2, seatColor or color, M.Fabric, L)
	local back = B(ctx, parent, "Encosto", cf, 0, 3.25, 0.85, 2, 2.6, 0.3, color, M.Wood)
	local left = B(ctx, parent, "Lateral", cf, -0.85, 0.82, 0, 0.25, 1.65, 1.8, color, M.Wood)
	local right = B(ctx, parent, "Lateral", cf, 0.85, 0.82, 0, 0.25, 1.65, 1.8, color, M.Wood)
	Kit.weldTo(seat, { back, left, right })
	return seat
end

-- Banquinho redondo (LooseProp).
function Furniture.Stool(ctx, parent, cf: CFrame, color: Color3, height: number?)
	local h = height or 2.2
	local seat = C(ctx, parent, "Banquinho", cf, 0, h - 0.2, 0, 0.4, 1.6, color, M.Wood, L)
	local leg = C(ctx, parent, "Pe", cf, 0, (h - 0.4) / 2, 0, h - 0.4, 0.5, Palette.Iron, M.Metal)
	Kit.weldTo(seat, { leg })
	return seat
end

-- Poltrona (LooseProp).
function Furniture.Armchair(ctx, parent, cf: CFrame, color: Color3)
	local base = B(ctx, parent, "Poltrona", cf, 0, 0.9, 0, 3, 1.8, 3, color, M.Fabric, L)
	local back = B(ctx, parent, "Encosto", cf, 0, 2.9, 1.15, 3, 2.4, 0.7, color, M.Fabric)
	local left = B(ctx, parent, "Braco", cf, -1.3, 2.1, 0, 0.5, 0.8, 3, color, M.Fabric)
	local right = B(ctx, parent, "Braco", cf, 1.3, 2.1, 0, 0.5, 0.8, 3, color, M.Fabric)
	Kit.weldTo(base, { back, left, right })
	return base
end

-- Sofá grande (Destructible).
function Furniture.Sofa(ctx, parent, cf: CFrame, w: number, color: Color3)
	B(ctx, parent, "Sofa", cf, 0, 0.9, 0, w, 1.8, 3.2, color, M.Fabric, D)
	B(ctx, parent, "Encosto", cf, 0, 2.8, 1.2, w, 2.4, 0.8, color, M.Fabric, D)
	B(ctx, parent, "Braco", cf, -(w / 2 - 0.45), 2.05, -0.1, 0.9, 0.9, 3, color, M.Fabric, D)
	B(ctx, parent, "Braco", cf, w / 2 - 0.45, 2.05, -0.1, 0.9, 0.9, 3, color, M.Fabric, D)
end

-- Banco comprido (Destructible).
function Furniture.Bench(ctx, parent, cf: CFrame, w: number, color: Color3, material: Enum.Material?)
	local mat = material or M.Wood
	B(ctx, parent, "Banco", cf, 0, 1.75, 0, w, 0.5, 1.8, color, mat, D)
	B(ctx, parent, "Pe", cf, -(w / 2 - 0.6), 0.75, 0, 0.6, 1.5, 1.5, color, mat, D)
	B(ctx, parent, "Pe", cf, w / 2 - 0.6, 0.75, 0, 0.6, 1.5, 1.5, color, mat, D)
end

-- Quarto ---------------------------------------------------------------------------

-- Cama com cabeceira no +Z (encostada na parede).
function Furniture.Bed(ctx, parent, cf: CFrame, w: number, l: number, frameColor: Color3, sheetColor: Color3)
	B(ctx, parent, "Cama", cf, 0, 0.65, 0, w, 1.3, l, frameColor, M.Wood, D)
	B(ctx, parent, "Colchao", cf, 0, 1.7, 0, w - 0.4, 0.8, l - 0.4, Palette.White, M.Fabric, D)
	B(ctx, parent, "Coberta", cf, 0, 2.15, -l * 0.15, w - 0.1, 0.25, l * 0.62, sheetColor, M.Fabric, nil, GHOST)
	B(ctx, parent, "Travesseiro", cf, 0, 2.3, l / 2 - 1.2, w - 1.4, 0.5, 1.2, Palette.White, M.Fabric, nil, GHOST)
	B(ctx, parent, "Cabeceira", cf, 0, 2.5, l / 2 - 0.3, w + 0.2, 5, 0.6, frameColor, M.Wood, D)
	B(ctx, parent, "Peseira", cf, 0, 1.4, -l / 2 + 0.25, w + 0.2, 2.8, 0.5, frameColor, M.Wood, D)
end

-- Criado-mudo com abajur aceso opcional (LooseProp).
function Furniture.Nightstand(ctx, parent, cf: CFrame, color: Color3, withLamp: boolean?, lit: boolean?)
	local body = B(ctx, parent, "CriadoMudo", cf, 0, 1.25, 0, 2, 2.5, 1.8, color, M.Wood, L)
	if withLamp then
		local base = C(ctx, parent, "Abajur", cf, 0, 2.9, 0, 0.8, 0.6, Palette.Brass, M.Metal)
		local shade = C(ctx, parent, "Cupula", cf, 0, 3.75, 0, 0.9, 1.3, Palette.Parchment, M.Fabric)
		Kit.weldTo(body, { base, shade })
		if lit then
			Kit.light(shade, Palette.LightWarm, 12, 0.8)
		end
	end
	return body
end

-- Guarda-roupa alto (Destructible).
function Furniture.Wardrobe(ctx, parent, cf: CFrame, w: number, h: number, color: Color3)
	B(ctx, parent, "GuardaRoupa", cf, 0, h / 2, 0, w, h, 2.2, color, M.Wood, D)
	B(ctx, parent, "Fresta", cf, 0, h / 2, -1.11, 0.12, h - 1, 0.05, Palette.WoodDark, M.Wood, nil, GHOST_NO_SHADOW)
	B(ctx, parent, "Puxador", cf, -0.4, h / 2, -1.15, 0.2, 0.8, 0.12, Palette.Brass, M.Metal, nil, GHOST_NO_SHADOW)
	B(ctx, parent, "Puxador", cf, 0.4, h / 2, -1.15, 0.2, 0.8, 0.12, Palette.Brass, M.Metal, nil, GHOST_NO_SHADOW)
end

-- Cômoda com espelho (Destructible).
function Furniture.Dresser(ctx, parent, cf: CFrame, w: number, color: Color3)
	B(ctx, parent, "Comoda", cf, 0, 1.5, 0, w, 3, 1.8, color, M.Wood, D)
	B(ctx, parent, "Gavetas", cf, 0, 1.5, -0.91, w - 0.6, 0.12, 0.05, Palette.WoodDark, M.Wood, nil, GHOST_NO_SHADOW)
	B(ctx, parent, "Espelho", cf, 0, 5, 0.7, w * 0.6, 3.6, 0.2, Palette.Glass, M.Glass, nil, { Reflectance = 0.5 })
end

-- Estantes ---------------------------------------------------------------------------

-- Estante com 4 níveis. `fill`: "books" (padrão), "jars", "bottles", "scrolls", "fabric", "boxes", "empty".
function Furniture.Bookshelf(
	ctx,
	parent,
	cf: CFrame,
	w: number,
	h: number,
	depth: number,
	rng: Random,
	fill: string?,
	color: Color3?
)
	local wood = color or Palette.WoodDark
	B(ctx, parent, "Estante", cf, 0, h / 2, depth / 2 - 0.15, w, h, 0.3, wood, M.Wood, D)
	B(ctx, parent, "Lateral", cf, -(w / 2 - 0.2), h / 2, 0, 0.4, h, depth, wood, M.Wood, D)
	B(ctx, parent, "Lateral", cf, w / 2 - 0.2, h / 2, 0, 0.4, h, depth, wood, M.Wood, D)
	B(ctx, parent, "Topo", cf, 0, h - 0.2, 0, w, 0.4, depth, wood, M.Wood, D)
	local levels = 4
	local levelHeight = (h - 0.4) / levels
	local innerWidth = w - 0.8
	local kind = fill or "books"
	for level = 0, levels - 1 do
		local y0 = level * levelHeight
		B(ctx, parent, "Prateleira", cf, 0, y0 + 0.15, 0, w - 0.4, 0.3, depth, wood, M.Wood)
		local itemHeight = math.min(levelHeight - 0.7, 2.6)
		if kind == "books" then
			-- Dois blocos de livros por nível, com cores e alturas diferentes.
			local split = rng:NextNumber(0.35, 0.65)
			local leftWidth = innerWidth * split - 0.1
			local rightWidth = innerWidth * (1 - split) - 0.1
			local leftHeight = itemHeight * rng:NextNumber(0.75, 1)
			local rightHeight = itemHeight * rng:NextNumber(0.7, 1)
			B(
				ctx,
				parent,
				"Livros",
				cf,
				-innerWidth / 2 + leftWidth / 2,
				y0 + 0.3 + leftHeight / 2,
				0.05,
				leftWidth,
				leftHeight,
				depth - 0.5,
				Palette.pick(Palette.Books, rng),
				M.Fabric
			)
			if rng:NextNumber() < 0.85 then
				B(
					ctx,
					parent,
					"Livros",
					cf,
					innerWidth / 2 - rightWidth / 2,
					y0 + 0.3 + rightHeight / 2,
					0.05,
					rightWidth,
					rightHeight,
					depth - 0.5,
					Palette.pick(Palette.Books, rng),
					M.Fabric
				)
			end
		elseif kind == "jars" or kind == "bottles" then
			local count = 3
			for i = 1, count do
				local x = -innerWidth / 2 + (i - 0.5) * innerWidth / count
				local isJar = kind == "jars"
				C(
					ctx,
					parent,
					isJar and "Pote" or "Garrafa",
					cf,
					x,
					y0 + 0.3 + (isJar and 0.8 or 1),
					0,
					isJar and 1.6 or 2,
					isJar and 1.1 or 0.6,
					isJar and Palette.pick(Palette.Fabrics, rng) or Color3.fromRGB(40, 80, 40),
					M.Glass,
					L,
					{ Transparency = 0.15 }
				)
			end
		elseif kind == "scrolls" then
			Kit.cylinderAlong(
				ctx,
				parent,
				"Pergaminhos",
				cf * CFrame.new(0, y0 + 0.75, 0),
				innerWidth - 0.2,
				0.9,
				Palette.Parchment,
				M.Fabric
			)
		elseif kind == "fabric" then
			for i = 1, 2 do
				local x = (i == 1 and -1 or 1) * innerWidth / 4
				Kit.cylinderAlong(
					ctx,
					parent,
					"RoloDeTecido",
					cf * CFrame.new(x, y0 + 0.85, 0) * CFrame.Angles(0, math.rad(90), 0),
					depth - 0.4,
					1.1,
					Palette.pick(Palette.Fabrics, rng),
					M.Fabric,
					L
				)
			end
		elseif kind == "boxes" then
			local boxWidth = innerWidth / 2 - 0.2
			B(
				ctx,
				parent,
				"Caixa",
				cf,
				-innerWidth / 4,
				y0 + 0.3 + itemHeight * 0.4,
				0,
				boxWidth,
				itemHeight * 0.8,
				depth - 0.4,
				Palette.WoodLight,
				M.Cardboard,
				L
			)
		end
	end
end

-- Decoração ---------------------------------------------------------------------------

-- Tapete (sem colisão). borderColor opcional cria a faixa da borda.
function Furniture.Rug(ctx, parent, cf: CFrame, w: number, d: number, color: Color3, borderColor: Color3?)
	if borderColor then
		B(ctx, parent, "Tapete", cf, 0, 0.05, 0, w, 0.1, d, borderColor, M.Fabric, nil, GHOST_NO_SHADOW)
		B(ctx, parent, "Tapete", cf, 0, 0.07, 0, w - 1.4, 0.1, d - 1.4, color, M.Fabric, nil, GHOST_NO_SHADOW)
	else
		B(ctx, parent, "Tapete", cf, 0, 0.05, 0, w, 0.1, d, color, M.Fabric, nil, GHOST_NO_SHADOW)
	end
end

-- Lustre pendurado no teto. `ceiling` é o ponto do teto. Retorna a luz (range <= 0 = lustre apagado, sem luz).
function Furniture.Chandelier(
	ctx,
	parent,
	ceiling: Vector3,
	drop: number,
	diameter: number,
	range: number,
	shadows: boolean?,
	brightness: number?
): PointLight?
	local frame = CFrame.new(ceiling)
	C(ctx, parent, "Corrente", frame, 0, -drop / 2, 0, drop, 0.2, Palette.Iron, M.Metal, nil, GHOST_NO_SHADOW)
	C(ctx, parent, "Lustre", frame, 0, -drop, 0, 0.5, diameter, Palette.Gold, M.Metal, nil, GHOST_NO_SHADOW)
	local glow = Kit.ball(
		ctx,
		parent,
		"Brilho",
		ceiling - Vector3.new(0, drop - 0.6, 0),
		math.max(diameter * 0.35, 0.8),
		Palette.LightWarm,
		M.Neon,
		nil,
		GHOST_NO_SHADOW
	)
	if range <= 0 then
		return nil
	end
	return Kit.light(glow, Palette.LightWarm, range, brightness or 1.2, shadows)
end

-- Abajur de pé (LooseProp).
function Furniture.FloorLamp(ctx, parent, cf: CFrame, lit: boolean?)
	local base = C(ctx, parent, "Luminaria", cf, 0, 0.15, 0, 0.3, 1.4, Palette.Brass, M.Metal, L)
	local pole = C(ctx, parent, "Haste", cf, 0, 3, 0, 5.4, 0.25, Palette.Brass, M.Metal)
	local shade = C(ctx, parent, "Cupula", cf, 0, 6, 0, 1.3, 1.8, Palette.Parchment, M.Fabric)
	Kit.weldTo(base, { pole, shade })
	if lit then
		Kit.light(shade, Palette.LightWarm, 14, 0.9)
	end
	return base
end

-- Quadro na parede (LooseProp: explosões o derrubam). `cf` fica na superfície da parede, com a frente para o -Z.
-- Objetos de parede: a moldura é a raiz (colide, para cair no chão quando solta) e os detalhes vão soldados nela.
function Furniture.Painting(ctx, parent, cf: CFrame, w: number, h: number, rng: Random, frameColor: Color3?)
	local frame = B(ctx, parent, "Quadro", cf, 0, 0, -0.1, w, h, 0.2, frameColor or Palette.Gold, M.Wood, L, NO_SHADOW)
	local canvas = Palette.pick(Palette.Canvas, rng)
	local details = {
		B(ctx, parent, "Tela", cf, 0, 0, -0.22, w - 0.6, h - 0.6, 0.06, canvas, M.Fabric, nil, GHOST_NO_SHADOW),
	}
	local motif = rng:NextInteger(1, 3)
	if motif == 1 then
		-- Paisagem: faixa de terra/mar na metade de baixo.
		local landscape = B(
			ctx,
			parent,
			"Paisagem",
			cf,
			0,
			-(h - 0.6) / 4,
			-0.26,
			w - 0.6,
			(h - 0.6) / 2,
			0.04,
			Palette.pick(Palette.Canvas, rng),
			M.Fabric,
			nil,
			GHOST_NO_SHADOW
		)
		table.insert(details, landscape)
	elseif motif == 2 then
		-- Retrato: silhueta oval.
		local portrait = Kit.cylinderAlong(
			ctx,
			parent,
			"Retrato",
			cf * CFrame.new(0, 0, -0.27) * CFrame.Angles(0, math.rad(90), 0),
			0.04,
			math.min(w, h) * 0.55,
			Palette.pick(Palette.Canvas, rng),
			M.Fabric,
			nil,
			GHOST_NO_SHADOW
		)
		table.insert(details, portrait)
	end
	Kit.weldTo(frame, details)
	return frame
end

-- Lareira encostada na parede (+Z). `wallHeight` define a altura da coifa de tijolos.
function Furniture.Fireplace(ctx, parent, cf: CFrame, w: number, wallHeight: number, lit: boolean?, light: boolean?)
	local stone = Palette.Stone
	B(ctx, parent, "Lareira", cf, -(w / 2 - 0.7), 2.5, 0.2, 1.4, 5, 2, stone, M.Marble, D)
	B(ctx, parent, "Lareira", cf, w / 2 - 0.7, 2.5, 0.2, 1.4, 5, 2, stone, M.Marble, D)
	B(ctx, parent, "Cornija", cf, 0, 5.4, 0.1, w + 0.6, 0.8, 2.4, Palette.Marble, M.Marble, D)
	B(ctx, parent, "Fornalha", cf, 0, 2.2, 0.8, w - 2.8, 4.4, 0.6, Palette.Black, M.Slate)
	B(ctx, parent, "Base", cf, 0, 0.15, -0.6, w + 1.6, 0.3, 2.2, Palette.StoneDark, M.Slate)
	if wallHeight > 7 then
		B(
			ctx,
			parent,
			"Chamine",
			cf,
			0,
			5.8 + (wallHeight - 5.8) / 2,
			0.6,
			w - 1,
			wallHeight - 5.8,
			1.2,
			Palette.Brick,
			M.Brick,
			D
		)
	end
	if lit then
		local fire =
			B(ctx, parent, "Fogo", cf, 0, 0.9, 0.4, w - 3.6, 1.2, 0.8, Palette.Flame, M.Neon, nil, GHOST_NO_SHADOW)
		if light ~= false then
			Kit.light(fire, Palette.Flame, 16, 1.4)
		end
	end
end

-- Relógio de pêndulo (Destructible).
function Furniture.Clock(ctx, parent, cf: CFrame)
	B(ctx, parent, "Relogio", cf, 0, 3.6, 0, 2, 7.2, 1.4, Palette.WoodRed, M.Wood, D)
	Kit.cylinderAlong(
		ctx,
		parent,
		"Mostrador",
		cf * CFrame.new(0, 5.9, -0.71) * CFrame.Angles(0, math.rad(90), 0),
		0.1,
		1.5,
		Palette.Parchment,
		M.SmoothPlastic,
		nil,
		GHOST_NO_SHADOW
	)
	B(ctx, parent, "Pendulo", cf, 0, 2.6, -0.71, 0.8, 2.6, 0.08, Palette.Gold, M.Metal, nil, GHOST_NO_SHADOW)
end

-- Busto sobre pedestal.
function Furniture.Statue(ctx, parent, cf: CFrame, color: Color3?)
	local marble = color or Palette.Marble
	B(ctx, parent, "Pedestal", cf, 0, 1.75, 0, 2, 3.5, 2, Palette.StoneDark, M.Marble, D)
	B(ctx, parent, "Busto", cf, 0, 4.4, 0, 1.8, 1.8, 1.1, marble, M.Marble)
	Kit.ball(ctx, parent, "Cabeca", (cf * CFrame.new(0, 5.9, 0)).Position, 1.3, marble, M.Marble)
end

-- Vitrine com um objeto dentro.
function Furniture.DisplayCase(ctx, parent, cf: CFrame, rng: Random)
	B(ctx, parent, "Vitrine", cf, 0, 1.6, 0, 3, 3.2, 3, Palette.WoodDark, M.Wood, D)
	B(ctx, parent, "Vidro", cf, 0, 4.6, 0, 2.8, 2.8, 2.8, Palette.Glass, M.Glass, D, { Transparency = 0.6 })
	local kind = rng:NextInteger(1, 3)
	if kind == 1 then
		Kit.ball(ctx, parent, "Idolo", (cf * CFrame.new(0, 4.2, 0)).Position, 1.4, Palette.Gold, M.Metal, nil, GHOST)
	elseif kind == 2 then
		B(ctx, parent, "Mascara", cf, 0, 4.4, 0, 1.4, 1.8, 0.4, Palette.WoodRed, M.Wood, nil, GHOST)
	else
		C(ctx, parent, "Vaso", cf, 0, 4.3, 0, 1.6, 1.1, Palette.Terracotta, M.Slate, nil, GHOST)
	end
end

-- Máscara tribal na parede (`cf` na superfície da parede, frente para o -Z).
function Furniture.Mask(ctx, parent, cf: CFrame, rng: Random)
	local color = Palette.pick({ Palette.WoodRed, Palette.Wood, Palette.WoodLight }, rng)
	local mask = B(ctx, parent, "Mascara", cf, 0, 0, -0.25, 1.8, 2.6, 0.5, color, M.Wood, L, NO_SHADOW)
	Kit.weldTo(mask, {
		B(
			ctx,
			parent,
			"Olho",
			cf,
			-0.45,
			0.4,
			-0.52,
			0.4,
			0.3,
			0.06,
			Palette.Black,
			M.SmoothPlastic,
			nil,
			GHOST_NO_SHADOW
		),
		B(
			ctx,
			parent,
			"Olho",
			cf,
			0.45,
			0.4,
			-0.52,
			0.4,
			0.3,
			0.06,
			Palette.Black,
			M.SmoothPlastic,
			nil,
			GHOST_NO_SHADOW
		),
		B(
			ctx,
			parent,
			"Boca",
			cf,
			0,
			-0.65,
			-0.52,
			0.9,
			0.25,
			0.06,
			Palette.Black,
			M.SmoothPlastic,
			nil,
			GHOST_NO_SHADOW
		),
	})
	return mask
end

-- Cabeça de animal empalhada (troféu de caça), presa na parede.
function Furniture.TrophyHead(ctx, parent, cf: CFrame, rng: Random)
	local plaque = B(ctx, parent, "Placa", cf, 0, 0, -0.15, 2.2, 2.8, 0.3, Palette.WoodDark, M.Wood, L, NO_SHADOW)
	local fur =
		Palette.pick({ Color3.fromRGB(150, 110, 60), Color3.fromRGB(110, 80, 50), Color3.fromRGB(70, 60, 54) }, rng)
	local details = {
		B(ctx, parent, "Cabeca", cf, 0, 0, -1.2, 1.5, 1.6, 1.9, fur, M.Fabric, nil, GHOST),
		B(ctx, parent, "Focinho", cf, 0, -0.35, -2.4, 0.9, 0.9, 0.8, fur, M.Fabric, nil, GHOST),
	}
	for _, side in { -1, 1 } do
		local horn = Kit.box(
			ctx,
			parent,
			"Chifre",
			cf * CFrame.new(side * 0.8, 1.2, -1.2) * CFrame.Angles(0, 0, side * -0.5),
			Vector3.new(0.3, 1.6, 0.3),
			Palette.Parchment,
			M.SmoothPlastic,
			nil,
			GHOST_NO_SHADOW
		)
		table.insert(details, horn)
	end
	Kit.weldTo(plaque, details)
	return plaque
end

-- Vaso de planta (LooseProp).
function Furniture.PottedPlant(ctx, parent, cf: CFrame, size: number, rng: Random)
	local pot = C(ctx, parent, "Vaso", cf, 0, size * 0.3, 0, size * 0.6, size * 0.55, Palette.Terracotta, M.Slate, L)
	local foliage = Kit.ball(
		ctx,
		parent,
		"Folhagem",
		(cf * CFrame.new(0, size * 0.9, 0)).Position,
		size * 0.9,
		Palette.pick(Palette.Leaves, rng),
		M.LeafyGrass
	)
	Kit.weldTo(pot, { foliage })
	return pot
end

-- Vaso decorativo (LooseProp), opcionalmente com flores.
function Furniture.Vase(ctx, parent, cf: CFrame, h: number, color: Color3, rng: Random?)
	local vase = C(ctx, parent, "Vaso", cf, 0, h / 2, 0, h, h * 0.45, color, M.Marble, L)
	if rng then
		local flowers = Kit.ball(
			ctx,
			parent,
			"Flores",
			(cf * CFrame.new(0, h + 0.3, 0)).Position,
			h * 0.55,
			Palette.pick(Palette.Flowers, rng),
			M.Fabric
		)
		Kit.weldTo(vase, { flowers })
	end
	return vase
end

-- Livro solto (LooseProp).
function Furniture.Book(ctx, parent, cf: CFrame, rng: Random)
	return B(ctx, parent, "Livro", cf, 0, 0.2, 0, 1.4, 0.4, 1.9, Palette.pick(Palette.Books, rng), M.Fabric, L)
end

-- Garrafa (LooseProp).
function Furniture.Bottle(ctx, parent, cf: CFrame, color: Color3?)
	return C(
		ctx,
		parent,
		"Garrafa",
		cf,
		0,
		0.75,
		0,
		1.5,
		0.5,
		color or Color3.fromRGB(40, 80, 40),
		M.Glass,
		L,
		{ Transparency = 0.2 }
	)
end

-- Castiçal com vela acesa (sem luz própria).
function Furniture.Candle(ctx, parent, cf: CFrame)
	local base = C(ctx, parent, "Castical", cf, 0, 0.25, 0, 0.5, 0.8, Palette.Brass, M.Metal, L)
	local candle = C(ctx, parent, "Vela", cf, 0, 1, 0, 1, 0.35, Palette.White, M.SmoothPlastic)
	local flame = Kit.ball(
		ctx,
		parent,
		"Chama",
		(cf * CFrame.new(0, 1.65, 0)).Position,
		0.3,
		Palette.Flame,
		M.Neon,
		nil,
		GHOST_NO_SHADOW
	)
	Kit.weldTo(base, { candle, flame })
	return base
end

-- Caixote (LooseProp).
function Furniture.Crate(ctx, parent, cf: CFrame, size: Vector3, color: Color3?)
	return Kit.box(
		ctx,
		parent,
		"Caixote",
		cf * CFrame.new(0, size.Y / 2, 0),
		size,
		color or Palette.WoodLight,
		M.WoodPlanks,
		L
	)
end

-- Baú (LooseProp).
function Furniture.Chest(ctx, parent, cf: CFrame, color: Color3?)
	local wood = color or Palette.Wood
	local body = B(ctx, parent, "Bau", cf, 0, 0.9, 0, 3.2, 1.8, 2, wood, M.WoodPlanks, L)
	local lid = B(ctx, parent, "Tampa", cf, 0, 2, 0, 3.3, 0.4, 2.1, wood, M.Wood)
	local band =
		B(ctx, parent, "Faixa", cf, 0, 1.1, -1.02, 0.5, 2.1, 0.06, Palette.Brass, M.Metal, nil, GHOST_NO_SHADOW)
	Kit.weldTo(body, { lid, band })
	return body
end

-- Barril de pé ou deitado (LooseProp).
function Furniture.Barrel(ctx, parent, cf: CFrame, h: number, diameter: number, lying: boolean?)
	local axis
	if lying then
		axis = cf * CFrame.new(0, diameter / 2, 0)
	else
		axis = cf * CFrame.new(0, h / 2, 0) * VERTICAL
	end
	local body = Kit.cylinderAlong(ctx, parent, "Barril", axis, h, diameter, Palette.Wood, M.WoodPlanks, L)
	local ringA = Kit.cylinderAlong(
		ctx,
		parent,
		"Aro",
		axis * CFrame.new(h * 0.3, 0, 0),
		0.3,
		diameter + 0.1,
		Palette.Iron,
		M.Metal
	)
	local ringB = Kit.cylinderAlong(
		ctx,
		parent,
		"Aro",
		axis * CFrame.new(-h * 0.3, 0, 0),
		0.3,
		diameter + 0.1,
		Palette.Iron,
		M.Metal
	)
	Kit.weldTo(body, { ringA, ringB })
	return body
end

-- Saco de mantimentos (LooseProp).
function Furniture.Sack(ctx, parent, cf: CFrame, rng: Random)
	return Kit.box(
		ctx,
		parent,
		"Saco",
		cf * CFrame.new(0, 1, 0) * CFrame.Angles(0, rng:NextNumber(0, math.pi), rng:NextNumber(-0.15, 0.15)),
		Vector3.new(1.8, 2, 1.4),
		Palette.vary(Palette.Parchment, rng),
		M.Fabric,
		L
	)
end

-- Tambor decorativo (LooseProp).
function Furniture.Drum(ctx, parent, cf: CFrame, diameter: number, h: number, color: Color3?)
	local body = C(ctx, parent, "Tambor", cf, 0, h / 2, 0, h, diameter, color or Palette.WoodRed, M.Wood, L)
	local head = C(ctx, parent, "Pele", cf, 0, h + 0.05, 0, 0.12, diameter - 0.1, Palette.Parchment, M.Leather)
	local band = C(ctx, parent, "Faixa", cf, 0, h * 0.65, 0, 0.4, diameter + 0.08, Palette.Parchment, M.Fabric)
	Kit.weldTo(body, { head, band })
	return body
end

-- Ambientes específicos ---------------------------------------------------------------

-- Piano de cauda (Destructible), teclado na frente (-Z).
function Furniture.GrandPiano(ctx, parent, cf: CFrame)
	local black = Palette.Black
	B(ctx, parent, "Piano", cf, 0, 2.8, 0.6, 5, 1.3, 6.4, black, M.SmoothPlastic, D, { Reflectance = 0.15 })
	Kit.box(
		ctx,
		parent,
		"Tampa",
		cf * CFrame.new(2.45, 3.45, 0.6) * CFrame.Angles(0, 0, math.rad(-35)) * CFrame.new(-2.5, 0, 0),
		Vector3.new(5, 0.15, 6.2),
		black,
		M.SmoothPlastic,
		nil,
		GHOST
	)
	B(ctx, parent, "Teclado", cf, 0, 2.95, -2.95, 4.8, 0.3, 1.1, Palette.White, M.SmoothPlastic)
	B(ctx, parent, "Teclas", cf, 0, 3.12, -2.75, 4.6, 0.12, 0.5, black, M.SmoothPlastic, nil, GHOST_NO_SHADOW)
	for _, offset in { Vector3.new(-2, 0, -2), Vector3.new(2, 0, -2), Vector3.new(0, 0, 3.2) } do
		B(ctx, parent, "Pe", cf, offset.X, 1.1, offset.Z, 0.6, 2.2, 0.6, black, M.SmoothPlastic)
	end
	B(ctx, parent, "BancoPiano", cf, 0, 1.6, -4.6, 2.6, 0.5, 1.2, black, M.Leather, L)
end

-- Mesa de bilhar com bolas e tacos soltos.
function Furniture.BilliardTable(ctx, parent, cf: CFrame, rng: Random)
	B(ctx, parent, "MesaDeBilhar", cf, 0, 2.5, 0, 9, 0.7, 5, Palette.WoodRed, M.Wood, D)
	B(ctx, parent, "Feltro", cf, 0, 2.53, 0, 8.2, 0.7, 4.2, Palette.Felt, M.Fabric, D)
	for _, x in { -3.6, 3.6 } do
		for _, z in { -1.8, 1.8 } do
			B(ctx, parent, "Pe", cf, x, 1.08, z, 0.9, 2.15, 0.9, Palette.WoodRed, M.Wood)
		end
	end
	local colors = { Palette.White, Color3.fromRGB(220, 40, 40), Color3.fromRGB(240, 200, 40), Palette.Black }
	for i, color in colors do
		Kit.ball(
			ctx,
			parent,
			"Bola",
			(cf * CFrame.new(-2 + i * 0.9 + rng:NextNumber(-0.3, 0.3), 3.15, rng:NextNumber(-1.2, 1.2))).Position,
			0.5,
			color,
			M.SmoothPlastic,
			L
		)
	end
	Kit.cylinderAlong(
		ctx,
		parent,
		"Taco",
		cf * CFrame.new(0.5, 3.1, 1) * CFrame.Angles(0, rng:NextNumber(-0.3, 0.3), 0),
		6,
		0.25,
		Palette.WoodLight,
		M.Wood,
		L
	)
end

-- Banheira (Destructible) com água rasa.
function Furniture.Bathtub(ctx, parent, cf: CFrame)
	B(ctx, parent, "Banheira", cf, 0, 1.1, 0, 6, 2.2, 3, Palette.White, M.Marble, D)
	B(
		ctx,
		parent,
		"Agua",
		cf,
		0,
		2.21,
		0,
		5.2,
		0.05,
		2.2,
		Color3.fromRGB(120, 170, 200),
		M.SmoothPlastic,
		nil,
		{ Ghost = true, Transparency = 0.3 }
	)
	C(ctx, parent, "Torneira", cf, 0, 2.6, 1.2, 0.8, 0.3, Palette.Brass, M.Metal, nil, GHOST_NO_SHADOW)
end

-- Vaso sanitário.
function Furniture.Toilet(ctx, parent, cf: CFrame)
	B(ctx, parent, "Sanitario", cf, 0, 0.7, -0.2, 1.4, 1.4, 1.8, Palette.White, M.Marble, D)
	B(ctx, parent, "Caixa", cf, 0, 1.9, 0.75, 1.6, 1.8, 0.6, Palette.White, M.Marble, D)
	B(ctx, parent, "Assento", cf, 0, 1.45, -0.2, 1.3, 0.12, 1.6, Palette.WoodLight, M.Wood, nil, GHOST_NO_SHADOW)
end

-- Pia com espelho opcional (`mirrorHeight` = altura do centro do espelho).
function Furniture.Sink(ctx, parent, cf: CFrame, mirrorHeight: number?)
	B(ctx, parent, "Coluna", cf, 0, 1.3, 0.2, 0.9, 2.6, 0.9, Palette.White, M.Marble, D)
	B(ctx, parent, "Pia", cf, 0, 2.85, 0, 2.2, 0.6, 1.6, Palette.White, M.Marble, D)
	if mirrorHeight then
		B(
			ctx,
			parent,
			"Espelho",
			cf,
			0,
			mirrorHeight,
			0.85,
			2.2,
			2.8,
			0.15,
			Palette.Glass,
			M.Glass,
			nil,
			{ Ghost = true, Reflectance = 0.6 }
		)
	end
end

-- Balcão de cozinha (Destructible).
function Furniture.Counter(ctx, parent, cf: CFrame, w: number, color: Color3?, topColor: Color3?)
	B(ctx, parent, "Balcao", cf, 0, 1.5, 0, w, 3, 2.2, color or Palette.WoodLight, M.WoodPlanks, D)
	B(ctx, parent, "Tampo", cf, 0, 3.15, -0.05, w + 0.1, 0.3, 2.4, topColor or Palette.Marble, M.Marble, D)
end

-- Fogão a lenha de ferro (Destructible).
function Furniture.Stove(ctx, parent, cf: CFrame, wallHeight: number)
	B(ctx, parent, "Fogao", cf, 0, 1.6, 0, 4, 3.2, 2.4, Palette.Iron, M.Metal, D)
	B(ctx, parent, "Chapa", cf, 0, 3.25, 0, 4.1, 0.1, 2.5, Palette.Black, M.Metal, nil, GHOST_NO_SHADOW)
	B(ctx, parent, "Portinhola", cf, 0, 1.3, -1.21, 1.6, 1.1, 0.05, Palette.Flame, M.Neon, nil, GHOST_NO_SHADOW)
	C(ctx, parent, "Chamine", cf, 0, 3.2 + (wallHeight - 3.2) / 2, 0.7, wallHeight - 3.2, 0.9, Palette.Iron, M.Metal)
	C(ctx, parent, "Panela", cf, -1, 3.8, -0.2, 1, 1.3, Palette.Steel, M.Metal, L)
end

-- Geladeira antiga.
function Furniture.Icebox(ctx, parent, cf: CFrame)
	B(ctx, parent, "Geladeira", cf, 0, 3, 0, 3, 6, 2.4, Palette.WoodLight, M.Wood, D)
	B(ctx, parent, "Puxador", cf, 1, 3.6, -1.25, 0.25, 1.4, 0.12, Palette.Brass, M.Metal, nil, GHOST_NO_SHADOW)
end

-- Escrivaninha com papéis (Destructible).
function Furniture.Desk(ctx, parent, cf: CFrame, color: Color3, rng: Random)
	B(ctx, parent, "Escrivaninha", cf, 0, 2.9, 0, 5.4, 0.4, 2.6, color, M.Wood, D)
	B(ctx, parent, "Gaveteiro", cf, -1.8, 1.35, 0, 1.6, 2.7, 2.4, color, M.Wood, D)
	B(ctx, parent, "Gaveteiro", cf, 1.8, 1.35, 0, 1.6, 2.7, 2.4, color, M.Wood, D)
	B(ctx, parent, "Papeis", cf, rng:NextNumber(-1, 1), 3.13, 0, 1.4, 0.06, 1.8, Palette.White, M.SmoothPlastic, L)
end

-- Globo terrestre de chão (LooseProp).
function Furniture.Globe(ctx, parent, cf: CFrame, diameter: number)
	local stand = C(ctx, parent, "Globo", cf, 0, 1.2, 0, 2.4, 1, Palette.WoodDark, M.Wood, L)
	local ball = Kit.ball(
		ctx,
		parent,
		"Esfera",
		(cf * CFrame.new(0, 2.4 + diameter / 2, 0)).Position,
		diameter,
		Color3.fromRGB(70, 110, 140),
		M.SmoothPlastic
	)
	Kit.weldTo(stand, { ball })
	return stand
end

-- Telescópio de latão num tripé (LooseProp), apontado para a frente (-Z).
function Furniture.Telescope(ctx, parent, cf: CFrame)
	local hub = B(ctx, parent, "Telescopio", cf, 0, 4.4, 0, 0.6, 0.6, 0.6, Palette.Brass, M.Metal, L)
	local parts = {}
	for i = 0, 2 do
		local angle = i * math.pi * 2 / 3
		table.insert(
			parts,
			Kit.box(
				ctx,
				parent,
				"Tripe",
				cf * CFrame.Angles(0, angle, 0) * CFrame.new(0, 2.2, -0.75) * CFrame.Angles(math.rad(19), 0, 0),
				Vector3.new(0.25, 4.6, 0.25),
				Palette.WoodDark,
				M.Wood
			)
		)
	end
	table.insert(
		parts,
		Kit.cylinderAlong(
			ctx,
			parent,
			"Tubo",
			cf * CFrame.new(0, 5.2, -0.6) * CFrame.Angles(0, math.rad(90), 0) * CFrame.Angles(0, 0, math.rad(35)),
			5,
			0.8,
			Palette.Brass,
			M.Metal
		)
	)
	Kit.weldTo(hub, parts)
	return hub
end

-- Cavalete de pintura com tela (LooseProp).
function Furniture.Easel(ctx, parent, cf: CFrame, rng: Random)
	local canvas = Kit.box(
		ctx,
		parent,
		"Tela",
		cf * CFrame.new(0, 4.4, 0.1) * CFrame.Angles(math.rad(10), 0, 0),
		Vector3.new(3.4, 3, 0.2),
		Palette.pick(Palette.Canvas, rng),
		M.Fabric,
		L
	)
	local parts = {}
	for _, side in { -1, 1 } do
		table.insert(
			parts,
			Kit.box(
				ctx,
				parent,
				"Perna",
				cf * CFrame.new(side * 1.1, 2.6, 0.3) * CFrame.Angles(math.rad(10), 0, side * math.rad(6)),
				Vector3.new(0.2, 5.4, 0.2),
				Palette.WoodLight,
				M.Wood
			)
		)
	end
	table.insert(
		parts,
		Kit.box(
			ctx,
			parent,
			"Perna",
			cf * CFrame.new(0, 2.5, 1.2) * CFrame.Angles(math.rad(-20), 0, 0),
			Vector3.new(0.2, 5.2, 0.2),
			Palette.WoodLight,
			M.Wood
		)
	)
	table.insert(parts, B(ctx, parent, "Apoio", cf, 0, 2.85, 0.05, 3, 0.25, 0.5, Palette.WoodLight, M.Wood))
	Kit.weldTo(canvas, parts)
	return canvas
end

-- Manequim de costura (LooseProp).
function Furniture.Mannequin(ctx, parent, cf: CFrame, color: Color3)
	local base = C(ctx, parent, "Manequim", cf, 0, 0.15, 0, 0.3, 1.6, Palette.WoodDark, M.Wood, L)
	local pole = C(ctx, parent, "Haste", cf, 0, 1.6, 0, 2.8, 0.3, Palette.WoodDark, M.Wood)
	local torso = B(ctx, parent, "Torso", cf, 0, 4, 0, 1.8, 2.4, 1.1, color, M.Fabric)
	Kit.weldTo(base, { pole, torso })
	return base
end

-- Cavalinho de balanço (LooseProp).
function Furniture.RockingHorse(ctx, parent, cf: CFrame, color: Color3)
	local body = B(ctx, parent, "Cavalinho", cf, 0, 2, 0, 1, 1.2, 3, color, M.Wood, L)
	local head = Kit.box(
		ctx,
		parent,
		"Cabeca",
		cf * CFrame.new(0, 3, -1.4) * CFrame.Angles(math.rad(-25), 0, 0),
		Vector3.new(0.8, 1.8, 0.9),
		color,
		M.Wood
	)
	local rockers = {}
	for _, side in { -0.45, 0.45 } do
		table.insert(rockers, B(ctx, parent, "Balanco", cf, side, 0.5, 0, 0.2, 0.4, 3.8, Palette.WoodDark, M.Wood))
		table.insert(rockers, B(ctx, parent, "Perna", cf, side, 1.05, 0, 0.25, 0.9, 1.6, color, M.Wood))
	end
	table.insert(rockers, head)
	Kit.weldTo(body, rockers)
	return body
end

-- Gramofone (LooseProp).
function Furniture.Gramophone(ctx, parent, cf: CFrame)
	local box = B(ctx, parent, "Gramofone", cf, 0, 0.6, 0, 1.8, 1.2, 1.8, Palette.WoodRed, M.Wood, L)
	local horn = Kit.cylinderAlong(
		ctx,
		parent,
		"Corneta",
		cf * CFrame.new(0, 2.1, -0.4) * CFrame.Angles(0, math.rad(90), 0) * CFrame.Angles(0, 0, math.rad(40)),
		2,
		1.6,
		Palette.Brass,
		M.Metal
	)
	Kit.weldTo(box, { horn })
	return box
end

-- Estante de partitura (LooseProp).
function Furniture.MusicStand(ctx, parent, cf: CFrame)
	local base = C(ctx, parent, "Estante", cf, 0, 0.1, 0, 0.2, 1.2, Palette.Iron, M.Metal, L)
	local pole = C(ctx, parent, "Haste", cf, 0, 2, 0, 3.8, 0.15, Palette.Iron, M.Metal)
	local plate = Kit.box(
		ctx,
		parent,
		"Partitura",
		cf * CFrame.new(0, 4.1, 0) * CFrame.Angles(math.rad(-20), 0, 0),
		Vector3.new(2, 1.5, 0.1),
		Palette.Parchment,
		M.SmoothPlastic
	)
	Kit.weldTo(base, { pole, plate })
	return base
end

-- Varal com roupas (sem colisão nas roupas).
function Furniture.ClothesLine(ctx, parent, cf: CFrame, length: number, rng: Random)
	for _, side in { -1, 1 } do
		B(ctx, parent, "Poste", cf, side * length / 2, 3.2, 0, 0.3, 6.4, 0.3, Palette.WoodDark, M.Wood)
	end
	Kit.cylinderAlong(
		ctx,
		parent,
		"Varal",
		cf * CFrame.new(0, 6.1, 0),
		length,
		0.1,
		Palette.Parchment,
		M.Fabric,
		nil,
		GHOST_NO_SHADOW
	)
	local count = math.max(2, math.floor(length / 3))
	for i = 1, count do
		local x = -length / 2 + (i - 0.5) * (length / count)
		B(
			ctx,
			parent,
			"Roupa",
			cf,
			x,
			4.9,
			0,
			1.8,
			2.3,
			0.1,
			Palette.pick(Palette.Sheets, rng),
			M.Fabric,
			nil,
			GHOST_NO_SHADOW
		)
	end
end

-- Tina de lavar roupa com água.
function Furniture.Washtub(ctx, parent, cf: CFrame)
	local tub = C(ctx, parent, "Tina", cf, 0, 1.1, 0, 2.2, 3, Palette.Steel, M.Metal, L)
	local water = C(
		ctx,
		parent,
		"Agua",
		cf,
		0,
		2.1,
		0,
		0.1,
		2.7,
		Color3.fromRGB(150, 180, 200),
		M.SmoothPlastic,
		nil,
		{ Transparency = 0.3 }
	)
	Kit.weldTo(tub, { water })
	water.CanCollide = false
	water.CanQuery = false
	water.CanTouch = false
	return tub
end

-- Móvel coberto por lençol (sótão).
function Furniture.Covered(ctx, parent, cf: CFrame, size: Vector3, rng: Random)
	return Kit.box(
		ctx,
		parent,
		"MovelCoberto",
		cf * CFrame.new(0, size.Y / 2, 0) * CFrame.Angles(0, rng:NextNumber(-0.1, 0.1), 0),
		size,
		Palette.vary(Palette.White, rng, 0.06),
		M.Fabric,
		D
	)
end

-- Planetário mecânico (decoração de mesa).
function Furniture.Orrery(ctx, parent, cf: CFrame)
	local sun = Kit.ball(ctx, parent, "Planetario", (cf * CFrame.new(0, 1.4, 0)).Position, 1, Palette.Gold, M.Metal, L)
	local rod = C(ctx, parent, "Haste", cf, 0, 0.7, 0, 1.4, 0.2, Palette.Brass, M.Metal)
	local arm = Kit.cylinderAlong(ctx, parent, "Braco", cf * CFrame.new(1.1, 1.4, 0), 2.2, 0.1, Palette.Brass, M.Metal)
	local planet = Kit.ball(
		ctx,
		parent,
		"Planeta",
		(cf * CFrame.new(2.2, 1.4, 0)).Position,
		0.5,
		Palette.Canvas[1],
		M.SmoothPlastic
	)
	Kit.weldTo(sun, { rod, arm, planet })
	return sun
end

-- Máquina de costura sobre a mesa (LooseProp).
function Furniture.SewingMachine(ctx, parent, cf: CFrame)
	local body = B(ctx, parent, "MaquinaDeCostura", cf, 0, 0.45, 0, 1.8, 0.9, 0.9, Palette.Black, M.Metal, L)
	local arm = B(ctx, parent, "Braco", cf, -0.5, 1.2, 0, 0.5, 0.8, 0.6, Palette.Black, M.Metal)
	local head = B(ctx, parent, "Cabecote", cf, 0.1, 1.45, 0, 1.6, 0.4, 0.6, Palette.Black, M.Metal)
	Kit.weldTo(body, { arm, head })
	return body
end

-- Lança/rifle pendurados (decoração da sala de troféus), `cf` na superfície da parede.
function Furniture.WallWeapons(ctx, parent, cf: CFrame)
	local shield = B(ctx, parent, "Escudo", cf, 0, 0, -0.35, 1.6, 2.4, 0.3, Palette.WoodRed, M.Leather, L, NO_SHADOW)
	local spears = {}
	for _, side in { -1, 1 } do
		local spear = Kit.box(
			ctx,
			parent,
			"Lanca",
			cf * CFrame.new(0, 0, -0.2) * CFrame.Angles(0, 0, side * math.rad(35)),
			Vector3.new(0.25, 6, 0.25),
			Palette.WoodLight,
			M.Wood,
			nil,
			GHOST_NO_SHADOW
		)
		table.insert(spears, spear)
	end
	Kit.weldTo(shield, spears)
	return shield
end

-- Tapete de pele listrada.
function Furniture.SkinRug(ctx, parent, cf: CFrame)
	local orange = Color3.fromRGB(196, 120, 50)
	B(ctx, parent, "TapeteDePele", cf, 0, 0.06, 0, 4.5, 0.1, 7, orange, M.Fabric, nil, GHOST_NO_SHADOW)
	for i = -2, 2 do
		B(ctx, parent, "Listra", cf, 0, 0.12, i * 1.2, 4.2, 0.04, 0.35, Palette.Black, M.Fabric, nil, GHOST_NO_SHADOW)
	end
end

return Furniture
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">Garden</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Jardins e selva da ilha: caminhos de pedra ligando a porta da mansão, a entrada do labirinto e a
-- estufa; fonte na frente da mansão; avenida até a praia; coreto; postes com luz; e a vegetação
-- (árvores, arbustos, samambaias) que fica mais densa perto da borda, como uma selva invadindo.
-- A vegetação é agrupada em Models CullChunk por setor de 150 x 150.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)

local Furniture = require(script.Parent.Furniture)
local Kit = require(script.Parent.Kit)
local Palette = require(script.Parent.Palette)
local Plants = require(script.Parent.Plants)

local Garden = {}

local M = Enum.Material
local GHOST = { Ghost = true }

local PATH_WIDTH = 8
local SECTOR_SIZE = 150
local FOUNTAIN_RING = 20

-- layout: { mansion = info da Mansion, maze = info do Maze, greenhouse = info da Greenhouse, island = info da Island }
function Garden.Build(ctx, layout)
	local groundY = GameConfig.GROUND_Y
	local islandCenter = GameConfig.ISLAND_CENTER
	local rng = ctx.random
	local mansion = layout.mansion
	local maze = layout.maze
	local greenhouse = layout.greenhouse
	local plateauRadius = (layout.island and layout.island.grassRadius) or (GameConfig.ISLAND_RADIUS - 70)

	-- Models por setor (criados sob demanda).
	local sectors = {}
	local function sectorAt(x: number, z: number): Model
		local gx = math.floor((x - islandCenter.X) / SECTOR_SIZE + 0.5)
		local gz = math.floor((z - islandCenter.Z) / SECTOR_SIZE + 0.5)
		local id = gx .. "," .. gz
		local sector = sectors[id]
		if not sector then
			sector = {
				model = Kit.chunk(("Jardim %d,%d"):format(gx, gz)),
				center = Vector3.new(islandCenter.X + gx * SECTOR_SIZE, groundY + 6, islandCenter.Z + gz * SECTOR_SIZE),
			}
			sectors[id] = sector
		end
		return sector.model
	end

	-- 1) Caminhos de pedra (alturas alternadas para as emendas não piscarem).
	local paths = Kit.model("Jardim - Caminhos")
	local pathCount = 0
	local function path(a: Vector3, b: Vector3, width: number?)
		local w = width or PATH_WIDTH
		local flatA = Vector3.new(a.X, 0, a.Z)
		local flatB = Vector3.new(b.X, 0, b.Z)
		local length = (flatB - flatA).Magnitude
		if length < 0.5 then
			return
		end
		pathCount += 1
		local topY = groundY + 0.1 + 0.05 * (pathCount % 3)
		local mid = (flatA + flatB) / 2
		local position = Vector3.new(mid.X, topY - 0.2, mid.Z)
		Kit.box(
			ctx,
			paths,
			"Caminho",
			CFrame.lookAt(position, Vector3.new(flatB.X, position.Y, flatB.Z)),
			Vector3.new(w, 0.4, length + w * 0.6),
			(pathCount % 2 == 0) and Palette.Path or Palette.PathDark,
			M.Cobblestone,
			Kit.I,
			{ NoShadow = true }
		)
		Kit.addPath(ctx, a, b, w)
	end
	local function point(x: number, z: number): Vector3
		return Vector3.new(x, groundY, z)
	end

	local front = mansion.frontDoor
	local fountain = point(front.X, front.Z + 52)
	-- Porta da frente -> fonte.
	path(front, point(fountain.X, fountain.Z - FOUNTAIN_RING))
	-- Anel em volta da fonte (octógono).
	for k = 0, 7 do
		local a1 = k * math.pi / 4
		local a2 = (k + 1) * math.pi / 4
		path(
			point(fountain.X + math.cos(a1) * FOUNTAIN_RING, fountain.Z + math.sin(a1) * FOUNTAIN_RING),
			point(fountain.X + math.cos(a2) * FOUNTAIN_RING, fountain.Z + math.sin(a2) * FOUNTAIN_RING),
			6
		)
	end
	-- Avenida até a praia.
	local avenueEnd = point(fountain.X, islandCenter.Z + plateauRadius - 6)
	path(point(fountain.X, fountain.Z + FOUNTAIN_RING), avenueEnd, 10)
	-- Fonte -> estufa (porta principal).
	local ghDoor = greenhouse.mainDoor
	local eastTurn = point(ghDoor.X - 40, fountain.Z)
	path(point(fountain.X + FOUNTAIN_RING, fountain.Z), eastTurn)
	path(eastTurn, ghDoor)
	-- Porta lateral da mansão -> estufa.
	path(mansion.sideDoor, ghDoor)
	-- Porta dos fundos -> entrada do labirinto.
	path(mansion.backDoor, maze.entrance)
	-- Anel externo: oeste (da fonte até o caminho do labirinto) e leste (do caminho lateral até o labirinto).
	local backZ = (mansion.bounds.minZ + maze.bounds.maxZ) / 2
	local westX = mansion.bounds.minX - 40
	local eastX = mansion.bounds.maxX + 50
	path(point(fountain.X - FOUNTAIN_RING, fountain.Z), point(westX, fountain.Z))
	path(point(westX, fountain.Z), point(westX, backZ))
	path(point(westX, backZ), point(maze.entrance.X, backZ))
	local sideZ = mansion.sideDoor.Z
		+ (ghDoor.Z - mansion.sideDoor.Z) * ((eastX - mansion.sideDoor.X) / (ghDoor.X - mansion.sideDoor.X))
	path(point(eastX, sideZ), point(eastX, backZ))
	path(point(eastX, backZ), point(maze.entrance.X, backZ))
	-- Saída do labirinto -> praia.
	local exitDirection = (maze.exit.Z < maze.entrance.Z) and -1 or 1
	path(maze.exit, point(maze.exit.X, islandCenter.Z + exitDirection * (plateauRadius - 8)))
	-- Coreto no jardim oeste.
	local gazebo = point(westX - 70, fountain.Z + 10)
	path(point(westX, fountain.Z), point(gazebo.X + 9, gazebo.Z))
	Kit.attach(paths, ctx.map, Vector3.new(front.X, groundY, front.Z + 100))

	-- 2) Fonte.
	local fountainModel = Kit.chunk("Jardim - Fonte")
	local basinRadius = 12
	for k = 0, 7 do
		local angle = k * math.pi / 4
		local length = 2 * basinRadius * math.tan(math.pi / 8) + 1.5
		local height = (k % 2 == 0) and 2.4 or 2.5
		Kit.box(
			ctx,
			fountainModel,
			"BordaDaFonte",
			CFrame.new(
				fountain.X + math.cos(angle) * basinRadius,
				groundY + height / 2,
				fountain.Z + math.sin(angle) * basinRadius
			) * CFrame.Angles(0, -angle + math.pi / 2, 0),
			Vector3.new(length, height, 1.5),
			Palette.Marble,
			M.Marble,
			Kit.D
		)
	end
	Kit.cylinder(
		ctx,
		fountainModel,
		"FundoDaFonte",
		fountain + Vector3.new(0, 0.2, 0),
		0.6,
		basinRadius * 2,
		Palette.StoneDark,
		M.Slate,
		Kit.I
	)
	Kit.cylinder(
		ctx,
		fountainModel,
		"Agua",
		fountain + Vector3.new(0, 1.7, 0),
		0.2,
		basinRadius * 2 - 1.5,
		Palette.Water,
		M.SmoothPlastic,
		nil,
		{ Ghost = true, Transparency = 0.3, Reflectance = 0.1 }
	)
	Kit.cylinder(ctx, fountainModel, "Coluna", fountain + Vector3.new(0, 4, 0), 8, 2.4, Palette.Marble, M.Marble, Kit.I)
	Kit.cylinder(ctx, fountainModel, "Taca", fountain + Vector3.new(0, 8.3, 0), 1, 9, Palette.Marble, M.Marble, Kit.I)
	Kit.cylinder(
		ctx,
		fountainModel,
		"AguaDaTaca",
		fountain + Vector3.new(0, 8.85, 0),
		0.15,
		8,
		Palette.Water,
		M.SmoothPlastic,
		nil,
		{ Ghost = true, Transparency = 0.3 }
	)
	Kit.ball(ctx, fountainModel, "Topo", fountain + Vector3.new(0, 10.2, 0), 2.2, Palette.Marble, M.Marble)
	-- Canteiros de flores nas diagonais da fonte.
	for k = 0, 3 do
		local angle = k * math.pi / 2 + math.pi / 4
		local spot = fountain + Vector3.new(math.cos(angle) * 32, 0, math.sin(angle) * 32)
		Kit.box(
			ctx,
			fountainModel,
			"Canteiro",
			CFrame.new(spot + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, angle, 0),
			Vector3.new(10, 0.6, 6),
			Palette.Soil,
			M.Ground,
			Kit.I,
			{ NoShadow = true }
		)
		Plants.Flowers(ctx, fountainModel, spot + Vector3.new(0, 0.3, 0), 3, 6, rng)
		Kit.addPath(ctx, spot, spot, 12)
	end
	Kit.attach(fountainModel, ctx.map, fountain + Vector3.new(0, 4, 0))
	Kit.block(ctx, fountain.X - 26, fountain.X + 26, fountain.Z - 26, fountain.Z + 26)

	-- 3) Coreto (gazebo) octogonal.
	local gazeboModel = Kit.chunk("Jardim - Coreto")
	Kit.cylinder(ctx, gazeboModel, "Piso", gazebo + Vector3.new(0, 0.5, 0), 1, 18, Palette.Stone, M.Granite, Kit.I)
	for k = 0, 5 do
		local angle = k * math.pi / 3
		Kit.cylinder(
			ctx,
			gazeboModel,
			"Coluna",
			gazebo + Vector3.new(math.cos(angle) * 8, 6, math.sin(angle) * 8),
			10,
			0.9,
			Palette.Trim,
			M.Wood
		)
	end
	Kit.cylinder(ctx, gazeboModel, "Telhado", gazebo + Vector3.new(0, 11.5, 0), 1, 20, Palette.Roof, M.Slate)
	Kit.cylinder(ctx, gazeboModel, "Telhado", gazebo + Vector3.new(0, 12.75, 0), 1.5, 13, Palette.Roof, M.Slate)
	Kit.cylinder(ctx, gazeboModel, "Telhado", gazebo + Vector3.new(0, 14.25, 0), 1.5, 6, Palette.Roof, M.Slate)
	local gazeboLamp = Kit.ball(
		ctx,
		gazeboModel,
		"Lanterna",
		gazebo + Vector3.new(0, 9.8, 0),
		1.2,
		Palette.LightWarm,
		M.Neon,
		nil,
		GHOST
	)
	Kit.light(gazeboLamp, Palette.LightWarm, 20, 0.9)
	Furniture.Bench(ctx, gazeboModel, CFrame.new(gazebo + Vector3.new(0, 1, -4.5)), 6, Palette.WoodLight)
	Kit.attach(gazeboModel, ctx.map, gazebo + Vector3.new(0, 7, 0))
	Kit.block(ctx, gazebo.X - 12, gazebo.X + 12, gazebo.Z - 12, gazebo.Z + 12)
	Kit.region(ctx, "Coreto", CFrame.new(gazebo + Vector3.new(0, 8, 0)), Vector3.new(24, 20, 24), 0)

	-- 4) Postes de luz ao longo dos caminhos (só alguns acendem, para pesar menos).
	local lampSpots = {
		{ point(front.X - 7, front.Z + 14), true },
		{ point(front.X + 7, front.Z + 14), true },
		{ point(fountain.X - 11, fountain.Z + FOUNTAIN_RING + 30), true },
		{ point(fountain.X + 11, fountain.Z + FOUNTAIN_RING + 30), false },
		{ point(fountain.X - 11, fountain.Z + FOUNTAIN_RING + 130), false },
		{ point(fountain.X + 11, fountain.Z + FOUNTAIN_RING + 230), false },
		{ point(maze.entrance.X - 9, maze.entrance.Z + 8), true },
		{ point(maze.entrance.X + 9, maze.entrance.Z + 8), false },
		{ point(ghDoor.X - 8, ghDoor.Z - 8), true },
		{ point(westX - 7, fountain.Z - 60), false },
		{ point(eastX + 7, backZ + 40), false },
		{ point(mansion.backDoor.X + 7, mansion.backDoor.Z - 30), false },
	}
	for _, entry in lampSpots do
		local base, lit = entry[1], entry[2]
		local chunk = sectorAt(base.X, base.Z)
		Kit.cylinder(ctx, chunk, "Poste", base + Vector3.new(0, 5, 0), 10, 0.5, Palette.Iron, M.Metal)
		local lantern = Kit.box(
			ctx,
			chunk,
			"Lanterna",
			base + Vector3.new(0, 10.6, 0),
			Vector3.new(1.2, 1.4, 1.2),
			Palette.LightWarm,
			M.Neon,
			nil,
			GHOST
		)
		Kit.box(
			ctx,
			chunk,
			"Chapeu",
			base + Vector3.new(0, 11.5, 0),
			Vector3.new(1.8, 0.4, 1.8),
			Palette.Iron,
			M.Metal,
			nil,
			GHOST
		)
		if lit then
			Kit.light(lantern, Palette.LightWarm, 26, 1.1)
		end
	end

	-- 5) Avenida: árvores alinhadas e cercas vivas baixas.
	local avenueStart = fountain.Z + FOUNTAIN_RING + 20
	local z = avenueStart
	while z < avenueEnd.Z - 20 do
		for _, side in { -1, 1 } do
			local base = point(fountain.X + side * 15, z)
			Plants.Tree(ctx, sectorAt(base.X, base.Z), base, rng:NextNumber(0.9, 1.15), rng)
		end
		z += 45
	end
	for _, side in { -1, 1 } do
		local segment = 60
		local startZ = avenueStart - 10
		while startZ + segment < avenueEnd.Z - 10 do
			local base = point(fountain.X + side * 8.2, startZ + segment / 2)
			Kit.box(
				ctx,
				sectorAt(base.X, base.Z),
				"CercaBaixa",
				base + Vector3.new(0, 1.2, 0),
				Vector3.new(1.6, 2.4, segment - 8),
				Palette.pick(Palette.Hedge, rng),
				M.LeafyGrass,
				Kit.D
			)
			startZ += segment
		end
	end

	-- 6) Vegetação: mais densa conforme se afasta da mansão (a selva invadindo).
	local grid = math.ceil(plateauRadius / SECTOR_SIZE)
	for gx = -grid, grid do
		for gz = -grid, grid do
			local sectorCenter =
				Vector3.new(islandCenter.X + gx * SECTOR_SIZE, groundY, islandCenter.Z + gz * SECTOR_SIZE)
			local distance = (Vector3.new(sectorCenter.X - islandCenter.X, 0, sectorCenter.Z - islandCenter.Z)).Magnitude
			if distance < plateauRadius + SECTOR_SIZE * 0.3 then
				-- Jardim mais aberto perto da mansão; selva fechada perto da praia.
				local trees, bushes, ferns, bigLeaves
				if distance < 200 then
					trees, bushes, ferns, bigLeaves = 2, 3, 1, 0
				elseif distance < 380 then
					trees, bushes, ferns, bigLeaves = 5, 4, 2, 1
				else
					trees, bushes, ferns, bigLeaves = 9, 5, 3, 2
				end
				local function randomPoint(margin: number): Vector3?
					for _ = 1, 12 do
						local x = sectorCenter.X + rng:NextNumber(-SECTOR_SIZE / 2, SECTOR_SIZE / 2)
						local zz = sectorCenter.Z + rng:NextNumber(-SECTOR_SIZE / 2, SECTOR_SIZE / 2)
						local fromCenter = Vector3.new(x - islandCenter.X, 0, zz - islandCenter.Z).Magnitude
						if fromCenter < plateauRadius - 10 and not Kit.isBlocked(ctx, x, zz, margin) then
							return point(x, zz)
						end
					end
					return nil
				end
				local chunk = sectorAt(sectorCenter.X, sectorCenter.Z)
				for _ = 1, trees do
					local p = randomPoint(7)
					if p then
						if distance >= 380 and rng:NextNumber() < 0.25 then
							Plants.Palm(ctx, chunk, p, rng:NextNumber(16, 24), rng)
						else
							Plants.Tree(ctx, chunk, p, rng:NextNumber(0.9, 1.5), rng)
						end
						Kit.block(ctx, p.X - 5, p.X + 5, p.Z - 5, p.Z + 5)
					end
				end
				for _ = 1, bushes do
					local p = randomPoint(3)
					if p then
						Plants.Bush(ctx, chunk, p, rng:NextNumber(4, 8), rng)
					end
				end
				for _ = 1, ferns do
					local p = randomPoint(2)
					if p then
						Plants.Fern(ctx, chunk, p, rng:NextNumber(2.5, 4), rng, 4)
					end
				end
				for _ = 1, bigLeaves do
					local p = randomPoint(2)
					if p then
						Plants.BigLeaves(ctx, chunk, p, rng:NextNumber(4, 6), rng)
					end
				end
			end
		end
	end

	-- 7) Armas espalhadas pelo jardim.
	local weaponSpots = {
		{ point(fountain.X + FOUNTAIN_RING, fountain.Z), "Fonte" },
		{ point(fountain.X - FOUNTAIN_RING, fountain.Z), "Fonte" },
		{ point(maze.entrance.X, maze.entrance.Z + 6), "Jardim dos Fundos" },
		{ point(ghDoor.X - 6, ghDoor.Z), "Jardim Leste" },
		{ point(gazebo.X, gazebo.Z + 3) + Vector3.new(0, 1, 0), "Coreto" }, -- o piso do coreto é 1 stud mais alto
		{ point(fountain.X, (fountain.Z + avenueEnd.Z) / 2), "Avenida" },
		{ point(avenueEnd.X, avenueEnd.Z - 4), "Avenida" },
		{ point(westX, (fountain.Z + backZ) / 2), "Jardim Oeste" },
		{ point(eastX, (sideZ + backZ) / 2), "Jardim Leste" },
	}
	for _, entry in weaponSpots do
		Kit.weaponSpawn(ctx, entry[1] + Vector3.new(0, 1.6, 0), entry[2])
	end

	for _, sector in sectors do
		Kit.attach(sector.model, ctx.map, sector.center)
	end

	-- 8) Regiões externas.
	local bounds = mansion.bounds
	local function region(name: string, minX: number, maxX: number, minZ: number, maxZ: number)
		if maxX - minX < 1 or maxZ - minZ < 1 then
			return
		end
		Kit.region(
			ctx,
			name,
			CFrame.new((minX + maxX) / 2, groundY + 30, (minZ + maxZ) / 2),
			Vector3.new(maxX - minX, 80, maxZ - minZ),
			0
		)
	end
	region("Fonte", fountain.X - 26, fountain.X + 26, fountain.Z - 26, fountain.Z + 26)
	region("Jardim da Frente", bounds.minX - 12, bounds.maxX + 12, bounds.maxZ + 2, fountain.Z + 60)
	region("Avenida", fountain.X - 24, fountain.X + 24, fountain.Z + 60, avenueEnd.Z + 6)
	region("Jardim dos Fundos", bounds.minX - 12, bounds.maxX + 12, maze.bounds.maxZ + 2, bounds.minZ - 2)
	region("Jardim Leste", bounds.maxX + 2, greenhouse.bounds.minX - 2, maze.bounds.maxZ + 2, fountain.Z + 60)
	region("Jardim Oeste", westX - 110, bounds.minX - 2, maze.bounds.maxZ + 2, fountain.Z + 60)
end

return Garden
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">Greenhouse</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Estufa grande (110 x 70, telhado de duas águas com cumeeira a 30 studs): estrutura de metal verde,
-- painéis de vidro destrutíveis, canteiros elevados com plantas tropicais, cipós pendurados e um
-- tanque de água. Portas nas duas pontas (a do oeste fica voltada para a mansão).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)

local Furniture = require(script.Parent.Furniture)
local Kit = require(script.Parent.Kit)
local Palette = require(script.Parent.Palette)
local Plants = require(script.Parent.Plants)

local Greenhouse = {}

local M = Enum.Material
local GHOST = { Ghost = true }

local LENGTH = 110 -- ao longo do X
local WIDTH = 70 -- ao longo do Z
local WALL_HEIGHT = 18
local RIDGE = 12
local BAY = 11
local KNEE = 2.5 -- murinho de tijolo na base
local DOOR_WIDTH = 8
local DOOR_HEIGHT = 11

function Greenhouse.Build(ctx)
	local center = GameConfig.GREENHOUSE_CENTER
	local groundY = GameConfig.GROUND_Y
	local rng = ctx.random
	local model = Kit.chunk("Estufa")
	local frameColor = Palette.GreenhouseFrame
	local glassExtra = { Transparency = 0.5, Reflectance = 0.08 }

	local cx, cz = center.X, center.Z
	local x0, x1 = cx - LENGTH / 2, cx + LENGTH / 2
	local z0, z1 = cz - WIDTH / 2, cz + WIDTH / 2
	local floorY = groundY + 0.2
	local top = floorY + WALL_HEIGHT

	local function glass(name: string, cf: CFrame, size: Vector3)
		Kit.box(ctx, model, name, cf, size, Palette.GreenhouseGlass, M.Glass, Kit.D, glassExtra)
	end
	local function frame(name: string, cf: any, size: Vector3, tags)
		Kit.box(ctx, model, name, cf, size, frameColor, M.Metal, tags)
	end

	-- Piso de pedra.
	Kit.box(
		ctx,
		model,
		"Piso",
		Vector3.new(cx, floorY - 0.5, cz),
		Vector3.new(LENGTH, 1, WIDTH),
		Palette.Stone,
		M.Slate,
		Kit.I
	)

	-- Laterais compridas (z0 e z1): murinho, pilares a cada vão, vidro e travessas.
	for _, z in { z0, z1 } do
		Kit.box(
			ctx,
			model,
			"Murinho",
			Vector3.new(cx, floorY + KNEE / 2, z),
			Vector3.new(LENGTH, KNEE, 1),
			Palette.Brick,
			M.Brick,
			Kit.D
		)
		for k = 0, LENGTH / BAY do
			frame(
				"Pilar",
				Vector3.new(x0 + k * BAY, floorY + WALL_HEIGHT / 2, z),
				Vector3.new(0.8, WALL_HEIGHT, 0.8),
				Kit.D
			)
		end
		for k = 0, LENGTH / BAY - 1 do
			glass(
				"Vidro",
				CFrame.new(x0 + (k + 0.5) * BAY, floorY + KNEE + (WALL_HEIGHT - KNEE) / 2, z),
				Vector3.new(BAY - 0.8, WALL_HEIGHT - KNEE, 0.3)
			)
		end
		frame("Travessa", Vector3.new(cx, floorY + 10, z), Vector3.new(LENGTH, 0.4, 0.5))
		frame("Calha", Vector3.new(cx, top, z), Vector3.new(LENGTH + 0.8, 0.8, 0.8))
	end

	-- Pontas (x0 e x1) com porta no meio.
	local endPosts = { -35, -25, -15, -DOOR_WIDTH / 2, DOOR_WIDTH / 2, 15, 25, 35 }
	for _, x in { x0, x1 } do
		for index = 1, #endPosts do
			local zRel = endPosts[index]
			if index > 1 and index < #endPosts then
				frame(
					"Pilar",
					Vector3.new(x, floorY + WALL_HEIGHT / 2, cz + zRel),
					Vector3.new(0.8, WALL_HEIGHT, 0.8),
					Kit.D
				)
			end
			if index < #endPosts then
				local a, b = zRel, endPosts[index + 1]
				local isDoor = a == -DOOR_WIDTH / 2
				if isDoor then
					glass(
						"Bandeira",
						CFrame.new(x, floorY + DOOR_HEIGHT + (WALL_HEIGHT - DOOR_HEIGHT) / 2, cz),
						Vector3.new(0.3, WALL_HEIGHT - DOOR_HEIGHT, DOOR_WIDTH - 0.8)
					)
					frame("Verga", Vector3.new(x, floorY + DOOR_HEIGHT, cz), Vector3.new(0.6, 0.6, DOOR_WIDTH))
				else
					-- Nas quinas o murinho comprido já ocupa o canto.
					local ka = (index == 1) and (a + 0.5) or a
					local kb = (index == #endPosts - 1) and (b - 0.5) or b
					Kit.box(
						ctx,
						model,
						"Murinho",
						Vector3.new(x, floorY + KNEE / 2, cz + (ka + kb) / 2),
						Vector3.new(1, KNEE, kb - ka),
						Palette.Brick,
						M.Brick,
						Kit.D
					)
					glass(
						"Vidro",
						CFrame.new(x, floorY + KNEE + (WALL_HEIGHT - KNEE) / 2, cz + (a + b) / 2),
						Vector3.new(0.3, WALL_HEIGHT - KNEE, b - a - 0.8)
					)
				end
			end
		end
		frame("Calha", Vector3.new(x, top, cz), Vector3.new(0.8, 0.8, WIDTH))
		-- Oitão de vidro (dois triângulos) e um montante central.
		Kit.wedge(
			ctx,
			model,
			"Oitao",
			CFrame.new(x, top + RIDGE / 2, cz + WIDTH / 4) * CFrame.Angles(0, math.pi, 0),
			Vector3.new(0.3, RIDGE, WIDTH / 2),
			Palette.GreenhouseGlass,
			M.Glass,
			nil,
			glassExtra
		)
		Kit.wedge(
			ctx,
			model,
			"Oitao",
			CFrame.new(x, top + RIDGE / 2, cz - WIDTH / 4),
			Vector3.new(0.3, RIDGE, WIDTH / 2),
			Palette.GreenhouseGlass,
			M.Glass,
			nil,
			glassExtra
		)
		frame("Montante", Vector3.new(x, top + RIDGE / 2, cz), Vector3.new(0.6, RIDGE, 0.6))
	end

	-- Telhado: caibros e painéis de vidro inclinados nas duas águas, e a cumeeira.
	frame("Cumeeira", Vector3.new(cx, top + RIDGE, cz), Vector3.new(LENGTH + 0.8, 0.8, 0.8))
	for _, side in { 1, -1 } do
		local ridge = Vector3.new(0, top + RIDGE, cz)
		local down = Vector3.new(0, -RIDGE, side * WIDTH / 2).Unit
		local normal = Vector3.new(0, WIDTH / 2, side * RIDGE).Unit
		local slope = math.sqrt((WIDTH / 2) ^ 2 + RIDGE ^ 2)
		local middle = ridge + down * (slope / 2)
		for k = 0, LENGTH / BAY do
			local x = x0 + k * BAY
			frame(
				"Caibro",
				CFrame.fromMatrix(Vector3.new(x, middle.Y, middle.Z) - normal * 0.3, Vector3.xAxis, normal),
				Vector3.new(0.6, 0.6, slope)
			)
		end
		for k = 0, LENGTH / BAY - 1 do
			local x = x0 + (k + 0.5) * BAY
			glass(
				"Telhado",
				CFrame.fromMatrix(Vector3.new(x, middle.Y, middle.Z) + normal * 0.15, Vector3.xAxis, normal),
				Vector3.new(BAY - 0.6, 0.3, slope)
			)
		end
	end

	-- Corredores: central (ao longo do X) e transversal (ao longo do Z) ficam livres.
	-- Canteiros elevados nos quatro quadrantes; o quadrante nordeste vira um tanque de água.
	local quadrants = {
		{ minX = x0 + 3, maxX = cx - 4, minZ = z0 + 3, maxZ = cz - 5 },
		{ minX = cx + 4, maxX = x1 - 3, minZ = z0 + 3, maxZ = cz - 5 },
		{ minX = x0 + 3, maxX = cx - 4, minZ = cz + 5, maxZ = z1 - 3 },
		{ minX = cx + 4, maxX = x1 - 3, minZ = cz + 5, maxZ = z1 - 3 },
	}
	local tankIndex = rng:NextInteger(1, 4)
	for index, q in quadrants do
		local qx, qz = (q.minX + q.maxX) / 2, (q.minZ + q.maxZ) / 2
		local w, d = q.maxX - q.minX, q.maxZ - q.minZ
		if index == tankIndex then
			-- Tanque de água com borda de pedra e vitórias-régias.
			local rim = 1.4
			Kit.box(
				ctx,
				model,
				"FundoDoTanque",
				Vector3.new(qx, floorY + 0.15, qz),
				Vector3.new(w, 0.3, d),
				Palette.Soil,
				M.Mud,
				Kit.I
			)
			for _, side in { -1, 1 } do
				Kit.box(
					ctx,
					model,
					"BordaDoTanque",
					Vector3.new(qx, floorY + 1, qz + side * (d / 2 - rim / 2)),
					Vector3.new(w, 2, rim),
					Palette.Stone,
					M.Granite,
					Kit.D
				)
				Kit.box(
					ctx,
					model,
					"BordaDoTanque",
					Vector3.new(qx + side * (w / 2 - rim / 2), floorY + 1, qz),
					Vector3.new(rim, 2, d - rim * 2),
					Palette.Stone,
					M.Granite,
					Kit.D
				)
			end
			Kit.box(
				ctx,
				model,
				"Agua",
				Vector3.new(qx, floorY + 1.5, qz),
				Vector3.new(w - rim * 2, 0.2, d - rim * 2),
				Palette.Water,
				M.SmoothPlastic,
				nil,
				{ Ghost = true, Transparency = 0.3, Reflectance = 0.1 }
			)
			for _ = 1, 5 do
				Kit.cylinder(
					ctx,
					model,
					"VitoriaRegia",
					Vector3.new(
						qx + rng:NextNumber(-w / 2 + 4, w / 2 - 4),
						floorY + 1.65,
						qz + rng:NextNumber(-d / 2 + 4, d / 2 - 4)
					),
					0.1,
					rng:NextNumber(2.5, 4.5),
					Palette.Leaves[3],
					M.Grass,
					nil,
					{ Ghost = true, NoShadow = true }
				)
			end
		else
			Kit.box(
				ctx,
				model,
				"Canteiro",
				Vector3.new(qx, floorY + 0.6, qz),
				Vector3.new(w, 1.2, d),
				Palette.Brick,
				M.Brick,
				Kit.I
			)
			Kit.box(
				ctx,
				model,
				"Terra",
				Vector3.new(qx, floorY + 1.45, qz),
				Vector3.new(w - 0.8, 0.5, d - 0.8),
				Palette.Soil,
				M.Mud,
				Kit.I
			)
			local soilY = floorY + 1.7
			local function soilPoint(margin: number): Vector3
				return Vector3.new(
					qx + rng:NextNumber(-w / 2 + margin, w / 2 - margin),
					soilY,
					qz + rng:NextNumber(-d / 2 + margin, d / 2 - margin)
				)
			end
			Plants.Palm(
				ctx,
				model,
				Vector3.new(qx + rng:NextNumber(-8, 8), soilY, qz),
				rng:NextNumber(15, 20),
				rng,
				false
			)
			for _ = 1, 3 do
				Plants.BigLeaves(ctx, model, soilPoint(4), rng:NextNumber(4, 6), rng)
			end
			for _ = 1, 3 do
				Plants.Fern(ctx, model, soilPoint(3), rng:NextNumber(2.5, 3.5), rng, 4)
			end
			Plants.Bush(ctx, model, soilPoint(4), rng:NextNumber(3, 4.5), rng)
			Plants.Flowers(ctx, model, soilPoint(5), 2.5, 4, rng)
		end
	end

	-- Cipós pendurados nos caibros.
	for _ = 1, 12 do
		local x = x0 + rng:NextInteger(1, LENGTH / BAY - 1) * BAY
		local zRel = rng:NextNumber(-WIDTH / 2 + 6, WIDTH / 2 - 6)
		local roofY = top + RIDGE * (1 - math.abs(zRel) / (WIDTH / 2)) - 0.8
		Plants.Vine(ctx, model, Vector3.new(x, roofY, cz + zRel), rng:NextNumber(6, 12), rng, Vector3.xAxis)
	end

	-- Vasos soltos e bancos no corredor central.
	for _ = 1, 6 do
		local x = rng:NextNumber(x0 + 6, x1 - 6)
		if math.abs(x - cx) > 5 and math.abs(math.abs(x - cx) - 30) > 4 then
			local z = cz + (rng:NextNumber() < 0.5 and -1 or 1) * 3.2
			Furniture.PottedPlant(ctx, model, CFrame.new(x, floorY, z), rng:NextNumber(1.6, 2.4), rng)
		end
	end
	for _, side in { -1, 1 } do
		Furniture.Bench(ctx, model, CFrame.new(cx + side * 30, floorY, cz - 3), 5, Palette.WoodLight)
	end
	-- Bancada de jardinagem perto da porta leste.
	local benchCF = CFrame.new(x1 - 1.75, floorY, cz + 9) * CFrame.Angles(0, math.rad(90), 0)
	Furniture.Table(ctx, model, benchCF, 6, 2.4, 3, Palette.WoodLight)
	for i = -1, 1 do
		Furniture.PottedPlant(ctx, model, benchCF * CFrame.new(i * 1.8, 3, 0), 1.2, rng)
	end

	-- Luz suave sob a cumeeira.
	local lamp = Kit.box(
		ctx,
		model,
		"Lampada",
		Vector3.new(cx, top + RIDGE - 2, cz),
		Vector3.new(1, 1, 1),
		Palette.LightWarm,
		M.Neon,
		nil,
		GHOST
	)
	Kit.light(lamp, Palette.LightWarm, 50, 0.8)

	-- Armas nos corredores.
	for _, offset in
		{
			Vector3.new(-20, 0, 0),
			Vector3.new(20, 0, 0),
			Vector3.new(-45, 0, 0),
			Vector3.new(45, 0, 0),
			Vector3.new(0, 0, -20),
			Vector3.new(0, 0, 20),
		}
	do
		Kit.weaponSpawn(ctx, Vector3.new(cx + offset.X, floorY + 1.5, cz + offset.Z), "Estufa")
	end

	Kit.attach(model, ctx.map, Vector3.new(cx, floorY + WALL_HEIGHT / 2, cz))
	Kit.region(
		ctx,
		"Estufa",
		CFrame.new(cx, floorY + (WALL_HEIGHT + RIDGE + 2) / 2 - 1, cz),
		Vector3.new(LENGTH + 1, WALL_HEIGHT + RIDGE + 2, WIDTH + 1),
		0
	)
	Kit.block(ctx, x0 - 6, x1 + 6, z0 - 6, z1 + 6)

	local mansionIsWest = GameConfig.MANSION_CENTER.X <= cx
	local west = Vector3.new(x0 - 1, groundY, cz)
	local east = Vector3.new(x1 + 1, groundY, cz)
	return {
		mainDoor = mansionIsWest and west or east,
		backDoor = mansionIsWest and east or west,
		bounds = { minX = x0, maxX = x1, minZ = z0, maxZ = z1 },
	}
end

return Greenhouse
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">Island</string>
            <string name="Source"><![CDATA[--!nonstrict
-- A ilha: platô de grama, praia em rampa suave até a borda (ISLAND_RADIUS), fundo do mar e oceano.
-- Tudo é feito de Parts (o Terrain fica livre para os eventos). Nada bloqueia a passagem para fora da
-- borda: a eliminação é feita pelo BoundaryService. Pedras grandes e falésias ficam só além da borda.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local Tags = require(ReplicatedStorage.Shared.Tags)

local Kit = require(script.Parent.Kit)
local Palette = require(script.Parent.Palette)
local Plants = require(script.Parent.Plants)

local Island = {}

local M = Enum.Material

local BEACH_WIDTH = 70 -- largura da praia (a grama vai até ISLAND_RADIUS - BEACH_WIDTH)
local BEACH_SEGMENTS = 48
local OCEAN_SIZE = 4000
local OCEAN_TILE = 2000 -- partes têm no máximo 2048 studs por eixo
local SEABED_RADIUS = 1000

-- Direções da bússola: -Z = Norte, +X = Leste.
local SECTOR_NAMES = { "Leste", "Sudeste", "Sul", "Sudoeste", "Oeste", "Noroeste", "Norte", "Nordeste" }

-- Altura do topo da praia em função da distância ao centro (usada para assentar pedras e coqueiros).
local function beachSurface(profile, distance: number): number
	return profile.innerTop - (distance - profile.inner) * profile.slope
end

function Island.Build(ctx)
	local center = GameConfig.ISLAND_CENTER
	local radius = GameConfig.ISLAND_RADIUS
	local groundY = GameConfig.GROUND_Y
	local waterY = GameConfig.WATER_LEVEL_Y
	local rng = ctx.random

	local ground = Kit.model("Ilha")

	-- Platô de grama: cilindro em pé (o eixo do cilindro é o X, então giramos 90° no Z).
	local grassRadius = radius - BEACH_WIDTH
	Kit.cylinder(
		ctx,
		ground,
		"Grama",
		Vector3.new(center.X, groundY - 15, center.Z),
		30,
		grassRadius * 2,
		Palette.Grass,
		M.Grass,
		Kit.I
	)

	-- Praia: anel de cunhas descendo do platô até um pouco abaixo do mar.
	-- A linha d'água fica 6 studs depois de ISLAND_RADIUS (logo antes da margem de eliminação).
	local profile = {}
	profile.inner = grassRadius - 2
	profile.innerTop = groundY - 0.02
	profile.bottom = waterY - 1.5
	local shoreline = radius + 6
	profile.slope = (profile.innerTop - waterY) / (shoreline - profile.inner)
	profile.outer = profile.inner + (profile.innerTop - profile.bottom) / profile.slope
	local wedgeLength = profile.outer - profile.inner
	local wedgeHeight = profile.innerTop - profile.bottom
	local wedgeWidth = 2 * profile.outer * math.sin(math.pi / BEACH_SEGMENTS) + 0.6
	for k = 0, BEACH_SEGMENTS - 1 do
		local angle = (k / BEACH_SEGMENTS) * math.pi * 2
		local direction = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local middle = center + direction * ((profile.inner + profile.outer) / 2)
		local position = Vector3.new(middle.X, profile.bottom + wedgeHeight / 2, middle.Z)
		-- A frente (−Z) da cunha aponta para o mar: a rampa desce para fora.
		Kit.wedge(
			ctx,
			ground,
			"Praia",
			CFrame.lookAt(position, position + direction),
			Vector3.new(wedgeWidth, wedgeHeight, wedgeLength),
			(k % 2 == 0) and Palette.Sand or Palette.vary(Palette.Sand, rng, 0.03),
			M.Sand,
			Kit.I
		)
	end

	-- Fundo do mar raso em volta da ilha.
	Kit.cylinder(
		ctx,
		ground,
		"FundoDoMar",
		Vector3.new(center.X, profile.bottom - 5, center.Z),
		10,
		SEABED_RADIUS * 2,
		Palette.Seabed,
		M.Sand,
		Kit.I
	)
	Kit.attach(ground, ctx.map, Vector3.new(center.X, groundY, center.Z))

	-- Oceano: fundo escuro e lâminas de água translúcidas (sem colisão, sem consulta).
	local ocean = Kit.model("Oceano")
	local tiles = OCEAN_SIZE / OCEAN_TILE
	for ix = 0, tiles - 1 do
		for iz = 0, tiles - 1 do
			local x = center.X - OCEAN_SIZE / 2 + (ix + 0.5) * OCEAN_TILE
			local z = center.Z - OCEAN_SIZE / 2 + (iz + 0.5) * OCEAN_TILE
			Kit.box(
				ctx,
				ocean,
				"FundoDoOceano",
				Vector3.new(x, waterY - 42, z),
				Vector3.new(OCEAN_TILE, 4, OCEAN_TILE),
				Palette.DeepSea,
				M.Sand,
				Kit.I,
				{ NoShadow = true }
			)
			Kit.box(
				ctx,
				ocean,
				"Mar",
				Vector3.new(x, waterY - 0.5, z),
				Vector3.new(OCEAN_TILE, 1, OCEAN_TILE),
				Palette.Water,
				M.SmoothPlastic,
				{ Tags.Water },
				{ Ghost = true, NoShadow = true, Transparency = 0.25, Reflectance = 0.12 }
			)
		end
	end
	Kit.attach(ocean, ctx.map, Vector3.new(center.X, waterY, center.Z))

	-- Setores da praia: coqueiros, pedras e (no norte) falésias.
	local sectorSize = math.pi * 2 / #SECTOR_NAMES
	for index, name in SECTOR_NAMES do
		local sectorAngle = (index - 1) * sectorSize
		local chunk = Kit.chunk("Praia " .. name)
		local function randomAngle(): number
			return sectorAngle + rng:NextNumber(-sectorSize / 2 + 0.05, sectorSize / 2 - 0.05)
		end
		local function pointAt(angle: number, distance: number): Vector3
			return center + Vector3.new(math.cos(angle) * distance, 0, math.sin(angle) * distance)
		end

		-- Coqueiros na areia.
		local placed = {}
		for _ = 1, 8 do
			if #placed >= 3 then
				break
			end
			local distance = rng:NextNumber(grassRadius + 8, radius - 12)
			local p = pointAt(randomAngle(), distance)
			local tooClose = false
			for _, other in placed do
				if (other - p).Magnitude < 30 then
					tooClose = true
				end
			end
			if not tooClose and not Kit.isBlocked(ctx, p.X, p.Z, 5) then
				table.insert(placed, p)
				local base = Vector3.new(p.X, beachSurface(profile, distance), p.Z)
				Plants.Palm(ctx, chunk, base, rng:NextNumber(14, 22), rng)
			end
		end

		-- Pedrinhas soltas na areia (pequenas: dá para passar por elas).
		for _ = 1, 2 do
			local distance = rng:NextNumber(grassRadius + 10, radius - 6)
			local p = pointAt(randomAngle(), distance)
			if not Kit.isBlocked(ctx, p.X, p.Z, 3) then
				local size = rng:NextNumber(2.5, 5)
				Kit.box(
					ctx,
					chunk,
					"Pedra",
					CFrame.new(p.X, beachSurface(profile, distance) + size * 0.2, p.Z)
						* CFrame.Angles(
							rng:NextNumber(0, math.pi),
							rng:NextNumber(0, math.pi),
							rng:NextNumber(0, math.pi)
						),
					Vector3.new(size, size * 0.8, size * 1.1),
					Palette.pick(Palette.Rocks, rng),
					M.Rock
				)
			end
		end

		-- Rochedos no mar (sempre depois da borda).
		local isCliff = name == "Norte" or name == "Noroeste" or name == "Nordeste"
		local stacks = isCliff and 4 or 2
		for _ = 1, stacks do
			local width = isCliff and rng:NextNumber(14, 26) or rng:NextNumber(8, 16)
			local height = isCliff and rng:NextNumber(26, 46) or rng:NextNumber(10, 26)
			local distance = radius + 14 + width / 2 + rng:NextNumber(0, isCliff and 30 or 90)
			local p = pointAt(randomAngle(), distance)
			local material = Palette.pick({ M.Rock, M.Slate, M.Basalt }, rng)
			local color = Palette.pick(Palette.Rocks, rng)
			Kit.box(
				ctx,
				chunk,
				"Rochedo",
				CFrame.new(p.X, profile.bottom + height / 2 - 2, p.Z)
					* CFrame.Angles(
						rng:NextNumber(-0.12, 0.12),
						rng:NextNumber(0, math.pi),
						rng:NextNumber(-0.12, 0.12)
					),
				Vector3.new(width, height, width * rng:NextNumber(0.7, 1.2)),
				color,
				material,
				Kit.I
			)
			if rng:NextNumber() < 0.6 then
				local small = width * 0.55
				Kit.box(
					ctx,
					chunk,
					"Rochedo",
					CFrame.new(
						p.X + rng:NextNumber(-width, width) * 0.5,
						profile.bottom + height * 0.35,
						p.Z + rng:NextNumber(-width, width) * 0.5
					)
						* CFrame.Angles(
							rng:NextNumber(-0.3, 0.3),
							rng:NextNumber(0, math.pi),
							rng:NextNumber(-0.3, 0.3)
						),
					Vector3.new(small, height * 0.6, small),
					color,
					material,
					Kit.I
				)
			end
		end
		Kit.attach(chunk, ctx.map, pointAt(sectorAngle, radius - 20) + Vector3.new(0, groundY, 0))

		-- Região da praia deste setor (caixa tangente ao anel).
		local direction = Vector3.new(math.cos(sectorAngle), 0, math.sin(sectorAngle))
		local regionMiddle = center + direction * (grassRadius - 10 + (radius + 16 - grassRadius + 10) / 2)
		local regionCenter = Vector3.new(regionMiddle.X, groundY + 20, regionMiddle.Z)
		local tangentLength = 2 * (radius + 16) * math.tan(sectorSize / 2) + 4
		Kit.region(
			ctx,
			"Praia " .. name,
			CFrame.lookAt(regionCenter, regionCenter + direction),
			Vector3.new(tangentLength, 70, radius + 16 - grassRadius + 10),
			0
		)
	end

	-- Região geral da ilha (vale quando nenhuma região menor contém o ponto).
	Kit.region(
		ctx,
		"Selva",
		CFrame.new(center.X, groundY + 70, center.Z),
		Vector3.new(radius * 2 + 40, 180, radius * 2 + 40),
		0
	)

	return {
		grassRadius = grassRadius,
		beach = profile,
	}
end

return Island
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">Kit</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Ferramentas compartilhadas pelos construtores do mapa:
--   * criação de parts com contagem (orçamento) e pausas automáticas (PartBuilder.yielder);
--   * regiões nomeadas (workspace.Map.Regions) e pontos de arma (tag WeaponSpawn);
--   * chunks (Models com tag CullChunk) montados fora do workspace e anexados de uma vez;
--   * áreas bloqueadas e caminhos, para a vegetação aleatória não nascer em cima de nada.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local PartBuilder = require(ReplicatedStorage.Shared.Util.PartBuilder)
local Tags = require(ReplicatedStorage.Shared.Tags)

local Kit = {}

Kit.PART_BUDGET = 7000

-- Listas de tags reutilizadas (não altere estas tabelas).
Kit.D = { Tags.Destructible }
Kit.I = { Tags.Indestructible }
Kit.L = { Tags.LooseProp }

export type Region = { name: string, cframe: CFrame, size: Vector3, floor: number }

export type Rect = { minX: number, maxX: number, minZ: number, maxZ: number }

export type PathSegment = { ax: number, az: number, bx: number, bz: number, width: number }

export type Ctx = {
	map: Folder,
	regionsFolder: Folder,
	spawnsFolder: Folder,
	markersFolder: Folder,
	random: Random,
	regions: { Region },
	weaponSpawns: { BasePart },
	blocked: { Rect },
	paths: { PathSegment },
	partCount: number,
	budgetWarned: boolean,
	yield: () -> (),
}

-- Chaves especiais aceitas em `extra` (não são propriedades do Roblox):
--   Ghost = true    -> sem colisão, sem consulta espacial e sem toque (decoração pura)
--   NoShadow = true -> CastShadow = false
local SPECIAL_EXTRA = { Ghost = true, NoShadow = true }

function Kit.new(map: Folder, regionsFolder: Folder, spawnsFolder: Folder, markersFolder: Folder): Ctx
	return {
		map = map,
		regionsFolder = regionsFolder,
		spawnsFolder = spawnsFolder,
		markersFolder = markersFolder,
		random = Random.new(),
		regions = {},
		weaponSpawns = {},
		blocked = {},
		paths = {},
		partCount = 0,
		budgetWarned = false,
		yield = PartBuilder.yielder(180),
	}
end

local function applyGhost(part: BasePart)
	-- A ordem importa: CanQuery só pode ficar falso com CanCollide falso.
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
end

-- Cria uma part (qualquer classe) contando o orçamento e cedendo de tempos em tempos.
function Kit.part(ctx: Ctx, props: { [string]: any }, extra: { [string]: any }?): BasePart
	ctx.partCount += 1
	if ctx.partCount > Kit.PART_BUDGET and not ctx.budgetWarned then
		ctx.budgetWarned = true
		warn(("[MapBuilder] O mapa passou do orçamento de %d parts."):format(Kit.PART_BUDGET))
	end
	if extra then
		for key, value in extra do
			if not SPECIAL_EXTRA[key] then
				props[key] = value
			end
		end
	end
	local parent = props.Parent
	props.Parent = nil
	local part = PartBuilder.part(props)
	if extra then
		if extra.Ghost then
			applyGhost(part)
		end
		if extra.NoShadow then
			part.CastShadow = false
		end
	end
	if parent then
		part.Parent = parent
	end
	ctx.yield()
	return part
end

local function toCFrame(value: any): CFrame
	if typeof(value) == "Vector3" then
		return CFrame.new(value)
	end
	return value
end

-- Bloco (Shape Block). `cf` pode ser CFrame ou Vector3.
function Kit.box(
	ctx: Ctx,
	parent: Instance,
	name: string,
	cf: any,
	size: Vector3,
	color: Color3,
	material: Enum.Material,
	tags: { string }?,
	extra: { [string]: any }?
): BasePart
	return Kit.part(ctx, {
		Name = name,
		CFrame = toCFrame(cf),
		Size = size,
		Color = color,
		Material = material,
		Tags = tags,
		Parent = parent,
	}, extra)
end

-- Cunha (WedgePart). A rampa desce em direção ao -Z local (frente) e a face alta fica no +Z local.
function Kit.wedge(
	ctx: Ctx,
	parent: Instance,
	name: string,
	cf: CFrame,
	size: Vector3,
	color: Color3,
	material: Enum.Material,
	tags: { string }?,
	extra: { [string]: any }?
): BasePart
	return Kit.part(ctx, {
		ClassName = "WedgePart",
		Name = name,
		CFrame = cf,
		Size = size,
		Color = color,
		Material = material,
		Tags = tags,
		Parent = parent,
	}, extra)
end

-- Cilindro com eixo no X local de `cf` (é assim que o Roblox orienta cilindros).
function Kit.cylinderAlong(
	ctx: Ctx,
	parent: Instance,
	name: string,
	cf: CFrame,
	length: number,
	diameter: number,
	color: Color3,
	material: Enum.Material,
	tags: { string }?,
	extra: { [string]: any }?
): BasePart
	return Kit.part(ctx, {
		Name = name,
		Shape = Enum.PartType.Cylinder,
		CFrame = cf,
		Size = Vector3.new(length, diameter, diameter),
		Color = color,
		Material = material,
		Tags = tags,
		Parent = parent,
	}, extra)
end

local VERTICAL = CFrame.Angles(0, 0, math.rad(90))

-- Cilindro em pé, com centro em `center`.
function Kit.cylinder(
	ctx: Ctx,
	parent: Instance,
	name: string,
	center: Vector3,
	height: number,
	diameter: number,
	color: Color3,
	material: Enum.Material,
	tags: { string }?,
	extra: { [string]: any }?
): BasePart
	return Kit.cylinderAlong(
		ctx,
		parent,
		name,
		CFrame.new(center) * VERTICAL,
		height,
		diameter,
		color,
		material,
		tags,
		extra
	)
end

-- Esfera.
function Kit.ball(
	ctx: Ctx,
	parent: Instance,
	name: string,
	center: Vector3,
	diameter: number,
	color: Color3,
	material: Enum.Material,
	tags: { string }?,
	extra: { [string]: any }?
): BasePart
	return Kit.part(ctx, {
		Name = name,
		Shape = Enum.PartType.Ball,
		CFrame = CFrame.new(center),
		Size = Vector3.new(diameter, diameter, diameter),
		Color = color,
		Material = material,
		Tags = tags,
		Parent = parent,
	}, extra)
end

-- Luz pontual (sem sombra por padrão: sombras de luzes pontuais pesam no celular).
function Kit.light(part: BasePart, color: Color3, range: number, brightness: number?, shadows: boolean?): PointLight
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range
	light.Brightness = brightness or 1
	light.Shadows = shadows == true
	light.Parent = part
	return light
end

-- Model comum (sem tag), ainda fora do workspace.
function Kit.model(name: string, parent: Instance?): Model
	return PartBuilder.model(name, parent) :: Model
end

-- Model com tag CullChunk (o cliente pode escondê-lo pela distância). Monte-o e depois chame Kit.attach.
function Kit.chunk(name: string): Model
	local model = Kit.model(name)
	PartBuilder.tag(model, Tags.CullChunk)
	return model
end

-- Define o pivô (centro usado no cálculo de distância) e coloca o model no pai de uma vez só.
function Kit.attach(model: Model, parent: Instance, pivot: Vector3)
	model.WorldPivot = CFrame.new(pivot)
	model.Parent = parent
end

-- Prende `others` na part raiz com WeldConstraint. Só a raiz fica ancorada: quando um evento
-- desancorar a raiz (LooseProp), o objeto inteiro voa junto.
function Kit.weldTo(root: BasePart, others: { BasePart })
	for _, part in others do
		if part ~= root then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = part
			weld.Parent = part
			part.Anchored = false
		end
	end
end

-- Região nomeada (Part invisível em workspace.Map.Regions).
function Kit.region(ctx: Ctx, name: string, cframe: CFrame, size: Vector3, floor: number)
	local part = PartBuilder.part({
		Name = name,
		CFrame = cframe,
		Size = size,
		Transparency = 1,
		CastShadow = false,
		Attributes = { RegionName = name, Floor = floor },
	})
	applyGhost(part)
	part.Parent = ctx.regionsFolder
	table.insert(ctx.regions, { name = name, cframe = cframe, size = size, floor = floor })
end

-- Ponto de arma: Part invisível 1x1x1, ~1,5 stud acima do piso.
function Kit.weaponSpawn(ctx: Ctx, position: Vector3, area: string): BasePart
	local part = PartBuilder.part({
		Name = "WeaponSpawn",
		CFrame = CFrame.new(position),
		Size = Vector3.one,
		Transparency = 1,
		CastShadow = false,
		Tags = { Tags.WeaponSpawn },
		Attributes = { Area = area },
	})
	applyGhost(part)
	part.Parent = ctx.spawnsFolder
	table.insert(ctx.weaponSpawns, part)
	return part
end

-- Marcador invisível (spawns de jogador, tabuleiro).
function Kit.marker(ctx: Ctx, name: string, cframe: CFrame, size: Vector3, tag: string): BasePart
	local part = PartBuilder.part({
		Name = name,
		CFrame = cframe,
		Size = size,
		Transparency = 1,
		CastShadow = false,
		Tags = { tag },
	})
	applyGhost(part)
	part.Parent = ctx.markersFolder
	return part
end

-- Áreas bloqueadas para a vegetação aleatória -------------------------------------

function Kit.block(ctx: Ctx, minX: number, maxX: number, minZ: number, maxZ: number)
	table.insert(ctx.blocked, { minX = minX, maxX = maxX, minZ = minZ, maxZ = maxZ })
end

function Kit.addPath(ctx: Ctx, a: Vector3, b: Vector3, width: number)
	table.insert(ctx.paths, { ax = a.X, az = a.Z, bx = b.X, bz = b.Z, width = width })
end

local function distanceToSegment(px: number, pz: number, seg: PathSegment): number
	local dx, dz = seg.bx - seg.ax, seg.bz - seg.az
	local lengthSq = dx * dx + dz * dz
	local t = 0
	if lengthSq > 0 then
		t = math.clamp(((px - seg.ax) * dx + (pz - seg.az) * dz) / lengthSq, 0, 1)
	end
	local cx, cz = seg.ax + dx * t, seg.az + dz * t
	return math.sqrt((px - cx) ^ 2 + (pz - cz) ^ 2)
end

-- true se o ponto (x, z) estiver numa área bloqueada ou perto de um caminho (com margem).
function Kit.isBlocked(ctx: Ctx, x: number, z: number, margin: number?): boolean
	local m = margin or 0
	for _, rect in ctx.blocked do
		if x >= rect.minX - m and x <= rect.maxX + m and z >= rect.minZ - m and z <= rect.maxZ + m then
			return true
		end
	end
	for _, seg in ctx.paths do
		if distanceToSegment(x, z, seg) < seg.width / 2 + m then
			return true
		end
	end
	return false
end

return Kit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">Mansion</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Mansão de 2 andares (pé-direito 16) com 30 cômodos (15 por andar), dois corredores por andar,
-- escadaria principal no hall, escada de serviço nos fundos, biblioteca de pé-direito duplo com mezanino
-- e telhado de duas águas.
--
-- Planta (vista de cima, +Z = frente/fachada principal, +X = leste), células de 28 x 28:
--   Faixa F  (frente)   : 7 colunas de cômodos
--   Faixa C1 (corredor) : corredor principal (12 de largura)
--   Faixa M  (meio)     : 7 colunas de cômodos (a Sala de Jogos fica no centro)
--   Faixa C2 (corredor) : corredor dos fundos
--   Faixa B  (fundos)   : 7 colunas de cômodos
-- A estrutura (paredes, lajes, escadas, telhado) fica num Model que nunca é escondido;
-- os móveis de cada cômodo ficam em Models próprios com a tag CullChunk.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)

local Kit = require(script.Parent.Kit)
local Palette = require(script.Parent.Palette)
local Plants = require(script.Parent.Plants)
local Rooms = require(script.Parent.Rooms)
local StartRoom = require(script.Parent.StartRoom)

local Mansion = {}

local M = Enum.Material
local D = Kit.D
local I = Kit.I
local GHOST = { Ghost = true }

-- Dimensões ------------------------------------------------------------------------

local CENTER = GameConfig.MANSION_CENTER
local CX, CZ = CENTER.X, CENTER.Z
local CELL = 28
local COLS = 7
local STORY = 16
local SLAB = 1
local T_IN = 1
local T_EXT = 1.5
local HALF_W = COLS * CELL / 2 -- 98
local HALF_D = 54
local FLOOR = { [0] = GameConfig.GROUND_Y + 0.2, [1] = GameConfig.GROUND_Y + 0.2 + STORY }
local CEILING_TOP = FLOOR[1] + STORY -- topo da laje do teto
local ROOF_RISE = 22
local WALL_IN_HEIGHT = STORY - SLAB -- paredes internas vão do piso até a laje de cima
local STAIR_STEPS = 20 -- degraus de 0,8 stud de altura (jogadores e pathfinding sobem sem pular)

Mansion.Floor = FLOOR
Mansion.CeilingTop = CEILING_TOP

-- Faixas no eixo Z (relativas ao centro da mansão).
local BANDS = {
	F = { z0 = 26, z1 = 54 },
	C1 = { z0 = 14, z1 = 26 },
	M = { z0 = -14, z1 = 14 },
	C2 = { z0 = -26, z1 = -14 },
	B = { z0 = -54, z1 = -26 },
}
local BAND_ORDER = { "F", "C1", "M", "C2", "B" }
local ROOM_ROWS = { "F", "M", "B" }

-- Cômodos de cada célula. "@X" = vão (pé-direito duplo do cômodo X, sem laje).
local GRID = {
	[0] = {
		F = { "JardimInverno", "Musica", "Estar", "Hall", "Biblioteca", "Biblioteca", "Escritorio" },
		M = { "Adega", "Trofeus", "Bilhar", "Jogos", "Jantar", "Jantar", "Despensa" },
		B = { "Baile", "Baile", "Baile", "EscadaFundos", "Cozinha", "Cozinha", "Lavanderia" },
	},
	[1] = {
		F = { "Observatorio", "Pintura", "Costura", "@Hall", "@Biblioteca", "@Biblioteca", "Mapas" },
		M = { "Banheiro1", "Hospedes1", "Hospedes2", "Galeria", "Criancas", "Banheiro2", "Hospedes3" },
		B = { "QuartoPrincipal", "QuartoPrincipal", "Banheiro3", "@EscadaFundos", "Hospedes4", "Sotao", "Sotao" },
	},
}

-- Cômodos com pé-direito duplo (ocupam os dois andares).
local DOUBLE_HEIGHT = { Hall = true, Biblioteca = true, EscadaFundos = true }

-- Paredes paralelas ao eixo X (entre faixas). Uma especificação por coluna.
-- Strings: "wall" | "door" | "start" (porta da sala inicial). Tabelas: { kind, from, to, offset, height }
-- com posições relativas ao centro da célula. Uma lista de especificações cria várias aberturas na mesma célula.
local X_LINES = {
	{
		z = 26,
		specs = {
			[0] = { "door", "door", "door", { kind = "open", from = -5.5, to = 14 }, "door", "door", "door" },
			[1] = { "door", "door", "door", { kind = "railing", from = -5.5, to = 14 }, "door", "wall", "door" },
		},
	},
	{
		z = 14,
		specs = {
			[0] = { "door", "door", "door", "start", "door", "door", "door" },
			[1] = { "door", "door", "door", "door", "door", "door", "door" },
		},
	},
	{
		z = -14,
		specs = {
			[0] = { "door", "door", "door", "start", "door", "door", "door" },
			[1] = { "wall", "door", "door", "door", "door", "wall", "door" },
		},
	},
	{
		z = -26,
		specs = {
			[0] = { "door", "wall", "door", { kind = "door", offset = 6 }, "door", "wall", "door" },
			[1] = {
				"door",
				"wall",
				"door",
				-- Saída da escada dos fundos e a porta do patamar (logo acima da porta do térreo).
				{ { kind = "door", from = -13.5, to = -5.5, height = 10 }, { kind = "door", offset = 6 } },
				"door",
				"wall",
				"door",
			},
		},
	},
}

-- Paredes paralelas ao eixo Z (entre colunas), por faixa de cômodos. Índice k = parede entre a coluna k e k+1.
-- "none" = mesmo cômodo dos dois lados; "seal" = parede da sala inicial.
local Z_LINES = {
	-- Sem porta entre a Sala de Estar e o Hall: a escadaria principal encosta nessa parede.
	F = {
		[0] = { "door", "door", "wall", "door", "none", "door" },
		[1] = { "door", "wall", "wall", "wall", "none", "wall" },
	},
	M = {
		[0] = { "wall", "door", "seal", "seal", "none", "door" },
		[1] = { "door", "wall", "wall", "wall", "door", "wall" },
	},
	B = {
		[0] = { "none", "none", "wall", "door", "none", "door" },
		[1] = { "none", "door", "wall", "wall", "wall", "none" },
	},
}

-- Fachadas. Frente/fundos: uma especificação por coluna. Laterais: uma por faixa (F, C1, M, C2, B).
local FACADES = {
	front = {
		[0] = { "glassWall", "window", "window", "frontDoor", "tallWindow", "tallWindow", "window" },
		[1] = { "window", "window", "window", "bigWindow", "tallWindow", "tallWindow", "window" },
	},
	back = {
		[0] = { "window", "window", "window", "backDoor", "window", "window", "window" },
		[1] = { "window", "window", "window", "window", "window", "window", "window" },
	},
	west = {
		[0] = { "glassWall", "window", "smallWindow", "window", "window" },
		[1] = { "window", "window", "window", "window", "window" },
	},
	east = {
		[0] = { "window", "sideDoor", "smallWindow", "window", "window" },
		[1] = { "window", "window", "window", "window", "window" },
	},
}

-- Tipos de abertura (largura, altura do peitoril a partir do piso, altura do vão).
local OPENINGS = {
	door = { width = 6, bottom = 0, height = 9, kind = "door" },
	window = { width = 6, bottom = 3.5, height = 7, glass = true, sill = true, kind = "window" },
	smallWindow = { width = 4, bottom = 7, height = 4, glass = true, sill = true, kind = "window" },
	tallWindow = { width = 6, bottom = 2.5, height = 11, glass = true, sill = true, kind = "window" },
	bigWindow = { width = 10, bottom = 3, height = 9, glass = true, sill = true, kind = "window" },
	glassWall = { width = 20, bottom = 1.5, height = 12, glass = true, sill = true, mullions = 3, kind = "window" },
	frontDoor = { width = 8, bottom = 0, height = 11, frame = true, kind = "door" },
	backDoor = { width = 6, bottom = 0, height = 9, offset = 6, frame = true, kind = "door" },
	sideDoor = { width = 6, bottom = 0, height = 9, frame = true, kind = "door" },
}

-- Geometria auxiliar ---------------------------------------------------------------------

local function colX0(c: number): number
	return CX - HALF_W + (c - 1) * CELL
end

local function colX1(c: number): number
	return CX - HALF_W + c * CELL
end

local function colCenter(c: number): number
	return CX - HALF_W + (c - 0.5) * CELL
end

local function bandZ(band: string): (number, number)
	local b = BANDS[band]
	return CZ + b.z0, CZ + b.z1
end

-- Espessura da parede numa linha X (z relativo) ou Z (coluna de fronteira 0..7).
local function thicknessAtZ(zRel: number): number
	return math.abs(math.abs(zRel) - HALF_D) < 0.01 and T_EXT or T_IN
end

local function thicknessAtBoundary(k: number): number
	return (k == 0 or k == COLS) and T_EXT or T_IN
end

local function cellKey(story: number, row: string, col: number): string?
	local rowData = GRID[story][row]
	return rowData and rowData[col]
end

local function isVoid(key: string?): boolean
	return key ~= nil and string.sub(key, 1, 1) == "@"
end

-- Construtor de paredes -------------------------------------------------------------------

-- Constrói uma parede reta com aberturas (portas/janelas).
-- axis "X": parede ao longo do X na linha z = line; axis "Z": ao longo do Z na linha x = line.
-- a0/a1: início e fim ao longo do eixo. openings: lista com center/width/bottom/top (absolutos) e opções.
local function buildWall(
	ctx,
	parent,
	axis: string,
	line: number,
	a0: number,
	a1: number,
	y0: number,
	y1: number,
	openings,
	style
)
	local thickness = style.thickness
	local function piece(
		name: string,
		s0: number,
		s1: number,
		b0: number,
		b1: number,
		color,
		material,
		tags,
		depth,
		extra
	)
		if s1 - s0 < 0.05 or b1 - b0 < 0.05 then
			return nil
		end
		local mid = (s0 + s1) / 2
		local yc = (b0 + b1) / 2
		local cf, size
		if axis == "X" then
			cf = CFrame.new(mid, yc, line)
			size = Vector3.new(s1 - s0, b1 - b0, depth)
		else
			cf = CFrame.new(line, yc, mid)
			size = Vector3.new(depth, b1 - b0, s1 - s0)
		end
		return Kit.box(ctx, parent, name, cf, size, color, material, tags, extra)
	end
	local function wallPiece(s0, s1, b0, b1)
		local part = piece("Parede", s0, s1, b0, b1, style.color, style.material, style.tags, thickness)
		if part and style.collect then
			table.insert(style.collect, part)
		end
	end
	-- Posição deslocada para fora da parede (peitoris e molduras).
	local function outwardCF(s: number, y: number, distance: number): CFrame
		local normal = style.outward or Vector3.zero
		if axis == "X" then
			return CFrame.new(s, y, line) + normal * distance
		end
		return CFrame.new(line, y, s) + normal * distance
	end
	local function alongSize(along: number, height: number, depth: number): Vector3
		if axis == "X" then
			return Vector3.new(along, height, depth)
		end
		return Vector3.new(depth, height, along)
	end

	table.sort(openings, function(a, b)
		return a.center < b.center
	end)
	local cursor = a0
	for _, o in openings do
		local left = math.max(o.center - o.width / 2, a0)
		local right = math.min(o.center + o.width / 2, a1)
		wallPiece(cursor, left, y0, y1)
		wallPiece(left, right, math.min(o.top, y1), y1)
		wallPiece(left, right, y0, math.max(o.bottom, y0))
		if o.glass then
			piece("Vidro", left, right, o.bottom, math.min(o.top, y1), Palette.Glass, M.Glass, D, 0.3, {
				Transparency = 0.45,
				Reflectance = 0.1,
			})
			if o.mullions then
				local width = right - left
				for i = 1, o.mullions do
					local s = left + width * i / (o.mullions + 1)
					piece(
						"Caixilho",
						s - 0.2,
						s + 0.2,
						o.bottom,
						math.min(o.top, y1),
						Palette.Trim,
						M.Wood,
						nil,
						0.5,
						GHOST
					)
				end
				piece(
					"Caixilho",
					left,
					right,
					o.bottom + (o.top - o.bottom) * 0.62,
					o.bottom + (o.top - o.bottom) * 0.62 + 0.4,
					Palette.Trim,
					M.Wood,
					nil,
					0.5,
					GHOST
				)
			end
		end
		if o.sill and style.outward and o.bottom > y0 + 0.05 then
			local s = (left + right) / 2
			Kit.box(
				ctx,
				parent,
				"Peitoril",
				outwardCF(s, o.bottom - 0.2, thickness / 2 + 0.3),
				alongSize(right - left + 1, 0.4, 0.6),
				Palette.Trim,
				M.Wood,
				nil,
				GHOST
			)
		end
		if o.frame and style.outward then
			-- Moldura branca em volta da porta externa.
			for _, s in { left - 0.3, right + 0.3 } do
				Kit.box(
					ctx,
					parent,
					"Batente",
					outwardCF(s, (o.bottom + o.top) / 2, thickness / 2 + 0.1),
					alongSize(0.6, o.top - o.bottom, 0.3),
					Palette.Trim,
					M.Wood,
					nil,
					GHOST
				)
			end
			Kit.box(
				ctx,
				parent,
				"Batente",
				outwardCF((left + right) / 2, o.top + 0.4, thickness / 2 + 0.1),
				alongSize(right - left + 1.8, 0.8, 0.3),
				Palette.Trim,
				M.Wood,
				nil,
				GHOST
			)
		end
		cursor = right
	end
	wallPiece(cursor, a1, y0, y1)
end

-- Converte uma especificação de abertura em dados absolutos.
-- `cellMid` = centro da célula ao longo do eixo da parede; `floorY` = piso do andar.
local function resolveSpec(spec, cellMid: number, cellA: number, cellB: number, floorY: number, wallHeight: number)
	if type(spec) == "string" then
		if spec == "door" or spec == "start" then
			local o = OPENINGS.door
			return { center = cellMid, width = o.width, bottom = floorY, top = floorY + o.height, kind = spec }
		end
		local o = OPENINGS[spec]
		if o then
			local center = cellMid + (o.offset or 0)
			return {
				center = center,
				width = o.width,
				bottom = floorY + o.bottom,
				top = floorY + o.bottom + o.height,
				glass = o.glass,
				sill = o.sill,
				mullions = o.mullions,
				frame = o.frame,
				kind = o.kind,
			}
		end
		return nil
	end
	-- Tabela: aberturas com posição explícita.
	local from = spec.from and (cellMid + spec.from) or nil
	local to = spec.to and (cellMid + spec.to) or nil
	if spec.kind == "open" or spec.kind == "railing" then
		from = from or cellA
		to = to or cellB
		return {
			center = (from + to) / 2,
			width = to - from,
			bottom = floorY,
			top = floorY + wallHeight + 1,
			kind = spec.kind,
		}
	end
	local width, center
	if from and to then
		width = to - from
		center = (from + to) / 2
	else
		width = OPENINGS.door.width
		center = cellMid + (spec.offset or 0)
	end
	return {
		center = center,
		width = width,
		bottom = floorY,
		top = floorY + (spec.height or OPENINGS.door.height),
		kind = "door",
	}
end

-- Construção ------------------------------------------------------------------------------

function Mansion.Build(ctx)
	local root = ctx.map
	local structure = Kit.model("Mansão - Estrutura")
	local rng = ctx.random

	-- Aberturas registradas por andar (para os cômodos saberem onde estão portas e janelas).
	local openingsByStory = { [0] = {}, [1] = {} }
	-- Parts que lacram a sala inicial até as portas abrirem.
	local sealParts = {}
	local startDoorSlots = {}

	local function record(story: number, axis: string, line: number, o)
		local center
		if axis == "X" then
			center = Vector3.new(o.center, o.bottom, line)
		else
			center = Vector3.new(line, o.bottom, o.center)
		end
		table.insert(openingsByStory[story], {
			position = center,
			axis = axis,
			width = o.width,
			bottomY = o.bottom,
			topY = o.top,
			kind = (o.kind == "window") and "window" or "door",
		})
	end

	local interiorStyle = {
		[0] = { color = Palette.Plaster, material = M.Plaster, thickness = T_IN, tags = D },
		[1] = { color = Palette.PlasterUpper, material = M.Plaster, thickness = T_IN, tags = D },
	}

	-- 1) Pisos do térreo (indestrutíveis), um por cômodo e um por corredor.
	local floorDone = {}
	for _, row in ROOM_ROWS do
		for c = 1, COLS do
			local key = cellKey(0, row, c)
			if key and not floorDone[key] then
				floorDone[key] = true
				local c0, c1 = c, c
				while cellKey(0, row, c1 + 1) == key do
					c1 += 1
				end
				local z0, z1 = bandZ(row)
				local info = Rooms.Info[key]
				Kit.box(
					ctx,
					structure,
					"Piso",
					Vector3.new((colX0(c0) + colX1(c1)) / 2, FLOOR[0] - SLAB / 2, (z0 + z1) / 2),
					Vector3.new(colX1(c1) - colX0(c0), SLAB, z1 - z0),
					info.floorColor,
					info.floorMaterial,
					I
				)
			end
		end
	end
	for _, band in { "C1", "C2" } do
		local z0, z1 = bandZ(band)
		Kit.box(
			ctx,
			structure,
			"Piso",
			Vector3.new(CX, FLOOR[0] - SLAB / 2, (z0 + z1) / 2),
			Vector3.new(HALF_W * 2, SLAB, z1 - z0),
			Palette.FloorWood,
			M.WoodPlanks,
			I
		)
	end

	-- 2) Lajes do 2º andar (destrutíveis), uma por célula/trecho de corredor.
	local slabY = FLOOR[1] - SLAB / 2
	for _, band in BAND_ORDER do
		local z0, z1 = bandZ(band)
		for c = 1, COLS do
			local x0, x1 = colX0(c), colX1(c)
			local upperKey = cellKey(1, band, c)
			local material, color = M.WoodPlanks, Palette.FloorWood
			if upperKey and Rooms.Info[upperKey] then
				material = Rooms.Info[upperKey].floorMaterial
				color = Rooms.Info[upperKey].floorColor
			end
			if upperKey == "@EscadaFundos" then
				-- Patamar da escada dos fundos: só a parte leste (a escada ocupa a faixa oeste da célula).
				x0 = CX - 5.5
			end
			if not isVoid(upperKey) or upperKey == "@EscadaFundos" then
				local isStartCeiling = (band == "M" and cellKey(0, band, c) == "Jogos")
				local slab = Kit.box(
					ctx,
					structure,
					"Laje",
					Vector3.new((x0 + x1) / 2, slabY, (z0 + z1) / 2),
					Vector3.new(x1 - x0, SLAB, z1 - z0),
					color,
					material,
					isStartCeiling and I or D
				)
				if isStartCeiling then
					table.insert(sealParts, slab)
				end
			end
		end
	end

	-- Laje do teto do 2º andar (uma por faixa).
	for _, band in BAND_ORDER do
		local z0, z1 = bandZ(band)
		Kit.box(
			ctx,
			structure,
			"Teto",
			Vector3.new(CX, CEILING_TOP - SLAB / 2, (z0 + z1) / 2),
			Vector3.new(HALF_W * 2, SLAB, z1 - z0),
			Palette.PlasterUpper,
			M.Plaster
		)
	end

	-- 3) Paredes internas paralelas ao X.
	for _, xl in X_LINES do
		local line = CZ + xl.z
		for story = 0, 1 do
			local floorY = FLOOR[story]
			for c = 1, COLS do
				local spec = xl.specs[story][c]
				local a0 = (c == 1) and (colX0(c) + T_EXT / 2) or colX0(c)
				local a1 = (c == COLS) and (colX1(c) - T_EXT / 2) or colX1(c)
				local style = interiorStyle[story]
				local isStart = spec == "start"
				if isStart then
					style = table.clone(style)
					style.tags = I
					style.collect = sealParts
				end
				if type(spec) == "table" and spec.kind == "railing" then
					-- Sem parede: balaustrada na beira do vão, deixando livre a chegada da escada.
					local opening = resolveSpec(spec, colCenter(c), colX0(c), colX1(c), floorY, WALL_IN_HEIGHT)
					local from, to = opening.center - opening.width / 2, opening.center + opening.width / 2
					Kit.box(
						ctx,
						structure,
						"Balaustrada",
						Vector3.new((from + to) / 2, floorY + 1.6, line - 0.25),
						Vector3.new(to - from, 3.2, 0.5),
						Palette.WoodDark,
						M.Wood,
						D
					)
					record(story, "X", line, {
						center = colCenter(c),
						width = CELL,
						bottom = floorY,
						top = floorY + WALL_IN_HEIGHT,
						kind = "door",
					})
				else
					local openings = {}
					local specList = (type(spec) == "table" and spec[1] ~= nil) and spec or { spec }
					for _, item in specList do
						local opening = resolveSpec(item, colCenter(c), colX0(c), colX1(c), floorY, WALL_IN_HEIGHT)
						if opening then
							table.insert(openings, opening)
							record(story, "X", line, opening)
							if isStart then
								table.insert(startDoorSlots, {
									center = Vector3.new(opening.center, floorY, line),
									width = opening.width,
									height = opening.top - opening.bottom,
									-- O corredor fica do lado de fora da sala inicial (a porta abre para ele).
									outward = (xl.z > 0) and 1 or -1,
								})
							end
						end
					end
					buildWall(ctx, structure, "X", line, a0, a1, floorY, floorY + WALL_IN_HEIGHT, openings, style)
				end
			end
		end
	end

	-- 4) Paredes internas paralelas ao Z (entre colunas).
	for _, row in ROOM_ROWS do
		local z0, z1 = bandZ(row)
		for story = 0, 1 do
			local floorY = FLOOR[story]
			for k = 1, COLS - 1 do
				local spec = Z_LINES[row][story][k]
				if spec ~= "none" then
					local line = CX - HALF_W + k * CELL
					local style = interiorStyle[story]
					local height = WALL_IN_HEIGHT
					if story == 0 and isVoid(cellKey(1, row, k)) and isVoid(cellKey(1, row, k + 1)) then
						-- Vão dos dois lados: a parede sobe até o 2º andar para não sobrar fresta.
						height = STORY
					end
					if spec == "seal" then
						style = table.clone(style)
						style.tags = I
						style.collect = sealParts
					end
					local openings = {}
					if spec == "door" then
						local o = resolveSpec("door", (z0 + z1) / 2, z0, z1, floorY, height)
						table.insert(openings, o)
						record(story, "Z", line, o)
					end
					local a0 = (row == "B") and (z0 + T_EXT / 2) or z0
					local a1 = (row == "F") and (z1 - T_EXT / 2) or z1
					buildWall(ctx, structure, "Z", line, a0, a1, floorY, floorY + height, openings, style)
				end
			end
		end
	end

	-- 5) Fachadas (tijolo), com janelas de vidro destrutível.
	local exteriorStyle = { color = Palette.Brick, material = M.Brick, thickness = T_EXT, tags = D }
	for story = 0, 1 do
		local floorY = FLOOR[story]
		local wallTop = floorY + STORY
		for _, facade in { "front", "back" } do
			local zRel = facade == "front" and HALF_D or -HALF_D
			local line = CZ + zRel
			local style = table.clone(exteriorStyle)
			style.outward = Vector3.new(0, 0, facade == "front" and 1 or -1)
			for c = 1, COLS do
				local spec = FACADES[facade][story][c]
				local a0 = (c == 1) and (colX0(c) - T_EXT / 2) or colX0(c)
				local a1 = (c == COLS) and (colX1(c) + T_EXT / 2) or colX1(c)
				local openings = {}
				local o = resolveSpec(spec, colCenter(c), colX0(c), colX1(c), floorY, STORY)
				if o then
					table.insert(openings, o)
					record(story, "X", line, o)
				end
				buildWall(ctx, structure, "X", line, a0, a1, floorY, wallTop, openings, style)
			end
		end
		for _, facade in { "west", "east" } do
			local line = CX + (facade == "west" and -HALF_W or HALF_W)
			local style = table.clone(exteriorStyle)
			style.outward = Vector3.new(facade == "west" and -1 or 1, 0, 0)
			for index, band in BAND_ORDER do
				local z0, z1 = bandZ(band)
				local a0 = (band == "B") and (z0 + T_EXT / 2) or z0
				local a1 = (band == "F") and (z1 - T_EXT / 2) or z1
				local spec = FACADES[facade][story][index]
				local openings = {}
				local o = resolveSpec(spec, (z0 + z1) / 2, z0, z1, floorY, STORY)
				if o then
					table.insert(openings, o)
					record(story, "Z", line, o)
				end
				buildWall(ctx, structure, "Z", line, a0, a1, floorY, wallTop, openings, style)
			end
		end
	end

	-- 6) Escadas, balaústres e mezanino da biblioteca.
	local function buildStairs(name: string, xMin: number, xMax: number, zBase: number, zTop: number)
		local direction = (zTop > zBase) and 1 or -1
		local run = math.abs(zTop - zBase) / STAIR_STEPS
		local rise = STORY / STAIR_STEPS
		for i = 1, STAIR_STEPS do
			local zA = zBase + direction * run * (i - 1)
			local zB = zBase + direction * run * i
			local top = FLOOR[0] + rise * i
			Kit.box(
				ctx,
				structure,
				name,
				Vector3.new((xMin + xMax) / 2, (FLOOR[0] + top) / 2, (zA + zB) / 2),
				Vector3.new(xMax - xMin, top - FLOOR[0], run),
				(i % 2 == 0) and Palette.WoodDark or Palette.Wood,
				M.WoodPlanks,
				I
			)
		end
		-- Corrimão inclinado no lado aberto da escada, com três balaústres.
		local railX = xMax - 0.25
		local p0 = Vector3.new(railX, FLOOR[0] + 3.4, zBase)
		local p1 = Vector3.new(railX, FLOOR[1] + 3.4, zTop)
		local mid = (p0 + p1) / 2
		Kit.box(
			ctx,
			structure,
			"Corrimao",
			CFrame.lookAt(mid, p1),
			Vector3.new(0.45, 0.45, (p1 - p0).Magnitude),
			Palette.WoodDark,
			M.Wood,
			D
		)
		for _, i in { 1, 10, 19 } do
			local z = zBase + direction * run * (i - 0.5)
			local stepTop = FLOOR[0] + rise * i
			local railY = FLOOR[0] + 3.4 + rise * (i - 0.5)
			Kit.box(
				ctx,
				structure,
				"Balaustre",
				Vector3.new(railX, (stepTop + railY) / 2, z),
				Vector3.new(0.4, railY - stepTop, 0.4),
				Palette.WoodDark,
				M.Wood,
				D
			)
		end
	end
	-- Escadaria principal: no hall, encostada na parede oeste, subindo da frente para o corredor.
	buildStairs("Degrau", CX - 13.5, CX - 5.5, CZ + 50, CZ + 26)
	-- Escada dos fundos: subindo dos fundos para o corredor de serviço.
	buildStairs("Degrau", CX - 13.5, CX - 5.5, CZ - 50, CZ - 26)
	-- Guarda-corpo do patamar dos fundos (ao lado do vão da escada).
	Kit.box(
		ctx,
		structure,
		"Balaustrada",
		Vector3.new(CX - 5.25, FLOOR[1] + 1.6, (CZ - HALF_D + T_EXT / 2 + CZ - 27.2) / 2),
		Vector3.new(0.5, 3.2, (CZ - 27.2) - (CZ - HALF_D + T_EXT / 2)),
		Palette.WoodDark,
		M.Wood,
		D
	)

	-- Mezanino da biblioteca (faixa de 7 studs junto à parede do corredor).
	local libX0, libX1 = colX0(5), colX1(6)
	local mezzanineZ0, mezzanineZ1 = CZ + 26, CZ + 33
	Kit.box(
		ctx,
		structure,
		"Mezanino",
		Vector3.new((libX0 + libX1) / 2, slabY, (mezzanineZ0 + mezzanineZ1) / 2),
		Vector3.new(libX1 - libX0, SLAB, mezzanineZ1 - mezzanineZ0),
		Palette.FloorWood,
		M.WoodPlanks,
		D
	)
	Kit.box(
		ctx,
		structure,
		"Balaustrada",
		Vector3.new((libX0 + libX1) / 2, FLOOR[1] + 1.6, mezzanineZ1 - 0.25),
		Vector3.new(libX1 - libX0 - T_IN, 3.2, 0.5),
		Palette.WoodDark,
		M.Wood,
		D
	)
	for _, x in { libX0 + 7, (libX0 + libX1) / 2, libX1 - 7 } do
		Kit.cylinder(
			ctx,
			structure,
			"Coluna",
			Vector3.new(x, FLOOR[0] + (FLOOR[1] - SLAB - FLOOR[0]) / 2, mezzanineZ1 - 0.9),
			FLOOR[1] - SLAB - FLOOR[0],
			1.2,
			Palette.WoodDark,
			M.Wood
		)
	end

	-- 7) Acabamentos externos: rodapé de pedra, cornijas, telhado, chaminés e pórtico.
	local outerW = HALF_W * 2 + T_EXT
	local outerD = HALF_D * 2 + T_EXT
	for _, side in { -1, 1 } do
		Kit.box(
			ctx,
			structure,
			"Embasamento",
			Vector3.new(CX, FLOOR[0] - 0.1, CZ + side * HALF_D),
			Vector3.new(outerW + 0.6, 1, T_EXT + 0.6),
			Palette.StoneDark,
			M.Slate,
			I
		)
		Kit.box(
			ctx,
			structure,
			"Embasamento",
			Vector3.new(CX + side * HALF_W, FLOOR[0] - 0.1, CZ),
			Vector3.new(T_EXT + 0.6, 1, HALF_D * 2 - T_EXT - 0.6),
			Palette.StoneDark,
			M.Slate,
			I
		)
		for _, y in { FLOOR[1], CEILING_TOP - 0.3 } do
			Kit.box(
				ctx,
				structure,
				"Cornija",
				Vector3.new(CX, y, CZ + side * (HALF_D + T_EXT / 2 + 0.2)),
				Vector3.new(outerW + 0.8, 0.7, 0.4),
				Palette.Trim,
				M.Wood,
				nil,
				GHOST
			)
			Kit.box(
				ctx,
				structure,
				"Cornija",
				Vector3.new(CX + side * (HALF_W + T_EXT / 2 + 0.2), y, CZ),
				Vector3.new(0.4, 0.7, outerD),
				Palette.Trim,
				M.Wood,
				nil,
				GHOST
			)
		end
	end

	local roof = Kit.model("Mansão - Telhado")
	local halfDepthOuter = HALF_D + T_EXT / 2
	local overhang = 3
	local thick = 1.2
	local roofLength = outerW + 4
	local segments = 7
	for _, side in { 1, -1 } do
		local ridge = Vector3.new(0, CEILING_TOP + ROOF_RISE, CZ)
		local down = Vector3.new(0, -ROOF_RISE, side * halfDepthOuter).Unit
		local normal = Vector3.new(0, halfDepthOuter, side * ROOF_RISE).Unit
		local slopeLength = (halfDepthOuter + overhang) / math.abs(down.Z)
		local centerYZ = ridge + down * (slopeLength / 2) + normal * (thick / 2)
		for i = 1, segments do
			local x = CX - roofLength / 2 + (i - 0.5) * roofLength / segments
			Kit.box(
				ctx,
				roof,
				"Telhado",
				CFrame.fromMatrix(Vector3.new(x, centerYZ.Y, centerYZ.Z), Vector3.xAxis, normal),
				Vector3.new(roofLength / segments, thick, slopeLength),
				Palette.Roof,
				M.Slate,
				D
			)
		end
	end
	Kit.box(
		ctx,
		roof,
		"Cumeeira",
		Vector3.new(CX, CEILING_TOP + ROOF_RISE + 1.1, CZ),
		Vector3.new(roofLength, 0.8, 2.6),
		Palette.StoneDark,
		M.Slate
	)
	-- Oitões (triângulos de tijolo nas laterais): a rampa da cunha desce para o -Z local.
	for _, sx in { -1, 1 } do
		local x = CX + sx * HALF_W
		local y = CEILING_TOP + ROOF_RISE / 2
		Kit.wedge(
			ctx,
			roof,
			"Oitao",
			CFrame.new(x, y, CZ + halfDepthOuter / 2) * CFrame.Angles(0, math.pi, 0),
			Vector3.new(T_EXT, ROOF_RISE, halfDepthOuter),
			Palette.Brick,
			M.Brick
		)
		Kit.wedge(
			ctx,
			roof,
			"Oitao",
			CFrame.new(x, y, CZ - halfDepthOuter / 2),
			Vector3.new(T_EXT, ROOF_RISE, halfDepthOuter),
			Palette.Brick,
			M.Brick
		)
	end
	for _, sx in { -1, 1 } do
		local height = ROOF_RISE + 8
		Kit.box(
			ctx,
			roof,
			"Chamine",
			Vector3.new(CX + sx * 56, CEILING_TOP + height / 2, CZ - 10),
			Vector3.new(5, height, 4),
			Palette.BrickDark,
			M.Brick,
			D
		)
		Kit.box(
			ctx,
			roof,
			"Chamine",
			Vector3.new(CX + sx * 56, CEILING_TOP + height + 0.4, CZ - 10),
			Vector3.new(6, 0.8, 5),
			Palette.StoneDark,
			M.Slate
		)
	end
	Kit.attach(roof, root, Vector3.new(CX, CEILING_TOP + ROOF_RISE / 2, CZ))

	-- Pórtico de entrada com colunas e frontão.
	local porchZ0 = CZ + HALF_D + T_EXT / 2
	local porchDepth = 11
	local porch = Kit.model("Mansão - Pórtico")
	Kit.box(
		ctx,
		porch,
		"Piso",
		Vector3.new(CX, FLOOR[0] - 0.3, porchZ0 + porchDepth / 2),
		Vector3.new(24, 1, porchDepth),
		Palette.Marble,
		M.Marble,
		I
	)
	local porchTop = FLOOR[0] + 14
	for _, x in { -10, -4, 4, 10 } do
		Kit.cylinder(
			ctx,
			porch,
			"Coluna",
			Vector3.new(CX + x, (FLOOR[0] + porchTop) / 2, porchZ0 + porchDepth - 1.5),
			porchTop - FLOOR[0],
			1.8,
			Palette.Trim,
			M.Marble
		)
	end
	Kit.box(
		ctx,
		porch,
		"Cobertura",
		Vector3.new(CX, porchTop + 0.5, porchZ0 + porchDepth / 2),
		Vector3.new(25, 1, porchDepth + 1),
		Palette.Trim,
		M.Wood,
		D
	)
	for _, sx in { -1, 1 } do
		Kit.wedge(
			ctx,
			porch,
			"Frontao",
			CFrame.new(CX + sx * 6.25, porchTop + 3.5, porchZ0 + porchDepth / 2)
				* CFrame.Angles(0, -sx * math.rad(90), 0),
			Vector3.new(porchDepth + 1, 5, 12.5),
			Palette.Trim,
			M.Wood
		)
	end
	-- Portas de entrada abertas para dentro (decorativas), encostadas na face interna da fachada.
	-- Em pé (perpendiculares à parede) a folha oeste deixava só ~1,5 stud até o corrimão e
	-- bloqueava o acesso ao pé da escadaria principal.
	local doorWidth = OPENINGS.frontDoor.width
	for _, sx in { -1, 1 } do
		Kit.box(
			ctx,
			porch,
			"PortaDeEntrada",
			Vector3.new(CX + sx * (doorWidth / 2 + 1.95), FLOOR[0] + 5.45, CZ + HALF_D - T_EXT / 2 - 0.22),
			Vector3.new(3.9, 10.8, 0.4),
			Palette.WoodRed,
			M.Wood
		)
	end
	Kit.attach(porch, root, Vector3.new(CX, FLOOR[0] + 7, porchZ0 + porchDepth / 2))

	-- 8) Cômodos: descritores, regiões e móveis.
	local roomsBuilt = {}
	local startInfo = nil
	for story = 0, 1 do
		local done = {}
		for _, row in ROOM_ROWS do
			for c = 1, COLS do
				local key = cellKey(story, row, c)
				if key and not isVoid(key) and not done[key] then
					done[key] = true
					local c0, c1 = c, c
					while cellKey(story, row, c1 + 1) == key do
						c1 += 1
					end
					local z0, z1 = bandZ(row)
					local x0, x1 = colX0(c0), colX1(c1)
					local ix0 = x0 + thicknessAtBoundary(c0 - 1) / 2
					local ix1 = x1 - thicknessAtBoundary(c1) / 2
					local iz0 = z0 + thicknessAtZ(z0 - CZ) / 2
					local iz1 = z1 - thicknessAtZ(z1 - CZ) / 2
					local double = DOUBLE_HEIGHT[key] == true
					local floorY = FLOOR[story]
					local height = double and (CEILING_TOP - SLAB - floorY) or WALL_IN_HEIGHT
					-- Frente local (-Z) virada para a porta principal: faixa F olha para o corredor (−Z do mundo),
					-- faixas M e B olham para +Z do mundo.
					local yaw = (row == "F") and 0 or math.pi
					local centerX, centerZ = (ix0 + ix1) / 2, (iz0 + iz1) / 2
					local cf = CFrame.new(centerX, floorY, centerZ) * CFrame.Angles(0, yaw, 0)
					local info = Rooms.Info[key]
					local openings = {}
					local stories = double and { 0, 1 } or { story }
					for _, s in stories do
						for _, o in openingsByStory[s] do
							local p = o.position
							if p.X >= x0 - 1 and p.X <= x1 + 1 and p.Z >= z0 - 1 and p.Z <= z1 + 1 then
								table.insert(openings, o)
							end
						end
					end
					local room = Rooms.new(ctx, {
						key = key,
						name = info.name,
						kind = info.kind,
						story = story,
						floorY = floorY,
						cf = cf,
						w = ix1 - ix0,
						d = iz1 - iz0,
						h = height,
						openings = openings,
					})
					-- Áreas reservadas: as escadas e o espaço livre até a parede na frente do primeiro degrau.
					if key == "Hall" then
						room:reserveWorld(CX - 13.5, CX - 5.5, CZ + 26, CZ + HALF_D)
						-- Folhas da porta de entrada encostadas na fachada.
						room:reserveWorld(CX - 8, CX + 8, CZ + HALF_D - T_EXT / 2 - 0.6, CZ + HALF_D)
					elseif key == "EscadaFundos" then
						room:reserveWorld(CX - 13.5, CX - 5.5, CZ - HALF_D, CZ - 26)
					elseif key == "Biblioteca" then
						for _, x in { libX0 + 7, (libX0 + libX1) / 2, libX1 - 7 } do
							room:reserveWorld(x - 1.2, x + 1.2, mezzanineZ1 - 2.1, mezzanineZ1 + 0.3)
						end
					end
					local regionBottom = (story == 0) and (FLOOR[0] - 1.5) or (FLOOR[1] - 0.5)
					local regionTop = (double or story == 1) and CEILING_TOP or (FLOOR[1] - 0.5)
					Kit.region(
						ctx,
						info.name,
						CFrame.new((x0 + x1) / 2, (regionBottom + regionTop) / 2, (z0 + z1) / 2),
						Vector3.new(x1 - x0, regionTop - regionBottom, z1 - z0),
						story
					)
					if key == "Jogos" then
						startInfo = StartRoom.Build(ctx, room, startDoorSlots, sealParts)
					else
						Rooms.Furnish(room)
					end
					Kit.attach(room.model, root, Vector3.new(centerX, floorY + height / 2, centerZ))
					table.insert(roomsBuilt, room)
				end
			end
		end
	end

	-- Corredores (como "cômodos" compridos) e a região da escadaria principal.
	local corridorNames = {
		[0] = { C1 = "Corredor Principal", C2 = "Corredor dos Fundos" },
		[1] = { C1 = "Corredor Superior", C2 = "Corredor Superior dos Fundos" },
	}
	for story = 0, 1 do
		for _, band in { "C1", "C2" } do
			local z0, z1 = bandZ(band)
			local floorY = FLOOR[story]
			local name = corridorNames[story][band]
			local openings = {}
			for _, o in openingsByStory[story] do
				local p = o.position
				if p.Z >= z0 - 1 and p.Z <= z1 + 1 then
					table.insert(openings, o)
				end
			end
			local corridor = Rooms.new(ctx, {
				key = "Corredor",
				name = name,
				kind = "Corridor",
				story = story,
				floorY = floorY,
				cf = CFrame.new(CX, floorY, (z0 + z1) / 2),
				w = HALF_W * 2 - T_EXT,
				d = (z1 - z0) - T_IN,
				h = WALL_IN_HEIGHT,
				openings = openings,
			})
			if story == 1 and band == "C1" then
				-- Chegada da escadaria principal e beirada do vão do hall.
				corridor:reserveWorld(CX - 14, CX + 14, z1 - 4, z1)
			elseif story == 1 and band == "C2" then
				corridor:reserveWorld(CX - 14, CX - 5, z0, z0 + 4)
			end
			local regionBottom = (story == 0) and (FLOOR[0] - 1.5) or (FLOOR[1] - 0.5)
			local regionTop = (story == 0) and (FLOOR[1] - 0.5) or CEILING_TOP
			Kit.region(
				ctx,
				name,
				CFrame.new(CX, (regionBottom + regionTop) / 2, (z0 + z1) / 2),
				Vector3.new(HALF_W * 2, regionTop - regionBottom, z1 - z0),
				story
			)
			Rooms.Furnish(corridor)
			Kit.attach(corridor.model, root, Vector3.new(CX, floorY + 7, (z0 + z1) / 2))
		end
	end
	Kit.region(
		ctx,
		"Escadaria Principal",
		CFrame.new(CX - 9.75, (FLOOR[0] - 1.5 + CEILING_TOP) / 2, CZ + 39),
		Vector3.new(8.5, CEILING_TOP - FLOOR[0] + 1.5, 26),
		0
	)
	Kit.region(
		ctx,
		"Mansão",
		CFrame.new(CX, (FLOOR[0] - 2 + CEILING_TOP + ROOF_RISE + 8) / 2, CZ + 6),
		Vector3.new(HALF_W * 2 + 8, CEILING_TOP + ROOF_RISE + 10 - FLOOR[0], HALF_D * 2 + 24),
		0
	)

	-- 9) Selva invadindo a mansão: cipós nas fachadas e arbustos junto às paredes.
	local jungle = Kit.chunk("Mansão - Trepadeiras")
	local facades = {
		{
			normal = Vector3.new(0, 0, 1),
			fixed = CZ + HALF_D + T_EXT / 2 + 0.2,
			from = CX - HALF_W,
			to = CX + HALF_W,
			alongX = true,
		},
		{
			normal = Vector3.new(0, 0, -1),
			fixed = CZ - HALF_D - T_EXT / 2 - 0.2,
			from = CX - HALF_W,
			to = CX + HALF_W,
			alongX = true,
		},
		{
			normal = Vector3.new(1, 0, 0),
			fixed = CX + HALF_W + T_EXT / 2 + 0.2,
			from = CZ - HALF_D,
			to = CZ + HALF_D,
			alongX = false,
		},
		{
			normal = Vector3.new(-1, 0, 0),
			fixed = CX - HALF_W - T_EXT / 2 - 0.2,
			from = CZ - HALF_D,
			to = CZ + HALF_D,
			alongX = false,
		},
	}
	for _, facade in facades do
		local vines = facade.alongX and 9 or 5
		for _ = 1, vines do
			local s = rng:NextNumber(facade.from + 2, facade.to - 2)
			local topY = (rng:NextNumber() < 0.5) and (CEILING_TOP - 0.5) or (FLOOR[1] - 0.2)
			local length = rng:NextNumber(5, math.min(18, topY - FLOOR[0] - 1))
			local top = facade.alongX and Vector3.new(s, topY, facade.fixed) or Vector3.new(facade.fixed, topY, s)
			Plants.Vine(ctx, jungle, top, length, rng, facade.normal)
		end
		local bushes = facade.alongX and 6 or 3
		for _ = 1, bushes do
			local s = rng:NextNumber(facade.from + 4, facade.to - 4)
			-- Evita o pórtico e as portas externas.
			if not (facade.normal.Z > 0 and math.abs(s - CX) < 16) then
				local base = facade.alongX and Vector3.new(s, GameConfig.GROUND_Y, facade.fixed + facade.normal.Z * 2.5)
					or Vector3.new(facade.fixed + facade.normal.X * 2.5, GameConfig.GROUND_Y, s)
				local nearDoor = false
				for _, o in openingsByStory[0] do
					if
						o.kind == "door"
						and (Vector3.new(o.position.X, 0, o.position.Z) - Vector3.new(base.X, 0, base.Z)).Magnitude
							< 9
					then
						nearDoor = true
					end
				end
				if not nearDoor then
					Plants.Bush(ctx, jungle, base, rng:NextNumber(4, 7), rng)
				end
			end
		end
	end
	Kit.attach(jungle, root, Vector3.new(CX, FLOOR[1], CZ))

	Kit.attach(structure, root, Vector3.new(CX, FLOOR[1], CZ))

	-- Área ocupada pela mansão (a vegetação aleatória não nasce aqui).
	Kit.block(ctx, CX - HALF_W - 6, CX + HALF_W + 6, CZ - HALF_D - 6, CZ + HALF_D + porchDepth + 4)

	return {
		start = startInfo,
		frontDoor = Vector3.new(CX, GameConfig.GROUND_Y, porchZ0 + porchDepth),
		backDoor = Vector3.new(CX + OPENINGS.backDoor.offset, GameConfig.GROUND_Y, CZ - HALF_D - T_EXT / 2),
		sideDoor = Vector3.new(CX + HALF_W + T_EXT / 2, GameConfig.GROUND_Y, CZ + (BANDS.C1.z0 + BANDS.C1.z1) / 2),
		bounds = { minX = CX - HALF_W, maxX = CX + HALF_W, minZ = CZ - HALF_D, maxZ = CZ + HALF_D },
		rooms = roomsBuilt,
	}
end

return Mansion
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">MapBuilder</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Constrói o mapa da partida em workspace.Map (somente Parts, nada de Terrain):
--   ilha com praia e oceano, mansão de 2 andares (30 cômodos), labirinto de cerca viva, estufa e jardins.
-- No fim marca workspace:SetAttribute("MapReady", true).
--
-- API (docs/ARQUITETURA.md):
--   MapBuilder.Build(): MapInfo
--   MapBuilder.OpenStartDoors()
--   MapBuilder.GetRegionAt(position: Vector3): Region?

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)

local Garden = require(script.Parent.Garden)
local Greenhouse = require(script.Parent.Greenhouse)
local Island = require(script.Parent.Island)
local Kit = require(script.Parent.Kit)
local Mansion = require(script.Parent.Mansion)
local Maze = require(script.Parent.Maze)
local StartRoom = require(script.Parent.StartRoom)

local MapBuilder = {}

export type Region = { name: string, cframe: CFrame, size: Vector3, floor: number }

export type MapInfo = {
	islandCenter: Vector3,
	islandRadius: number,
	groundY: number,
	waterLevelY: number,
	startRoom: { cframe: CFrame, size: Vector3 },
	boardSpawn: CFrame, -- em cima da mesa na sala inicial (Y = superfície do tampo)
	playerSpawns: { CFrame }, -- dentro da sala inicial (8), na altura do HumanoidRootPart, olhando para a mesa
	weaponSpawns: { BasePart }, -- Parts com tag WeaponSpawn
	regions: { Region },
	mapFolder: Folder, -- workspace.Map
}

local MIN_WEAPON_SPAWNS = 60

local mapInfo: MapInfo? = nil
local building = false
local startState = nil
-- Regiões com volume pré-calculado (para escolher a menor quando várias contêm o ponto).
local regionIndex: { { region: Region, volume: number, half: Vector3 } } = {}

local function indexRegions(regions: { Region })
	table.clear(regionIndex)
	for _, region in regions do
		table.insert(regionIndex, {
			region = region,
			volume = region.size.X * region.size.Y * region.size.Z,
			half = region.size / 2,
		})
	end
end

-- Lê as regiões das Parts de workspace.Map.Regions (se o Build ainda não rodou neste servidor).
local function ensureRegions()
	if #regionIndex > 0 then
		return
	end
	local map = workspace:FindFirstChild("Map")
	local folder = map and map:FindFirstChild("Regions")
	if not folder then
		return
	end
	local regions = {}
	for _, part in folder:GetChildren() do
		if part:IsA("BasePart") then
			local name = part:GetAttribute("RegionName")
			table.insert(regions, {
				name = (type(name) == "string") and name or part.Name,
				cframe = part.CFrame,
				size = part.Size,
				floor = tonumber(part:GetAttribute("Floor")) or 0,
			})
		end
	end
	indexRegions(regions)
end

-- Executa uma etapa da construção; um erro numa etapa não derruba as outras.
local function step(name: string, fn: () -> any): any
	local ok, result = xpcall(fn, debug.traceback)
	if not ok then
		warn(("[MapBuilder] Falha ao construir %s: %s"):format(name, tostring(result)))
		return nil
	end
	return result
end

-- Dados de emergência da sala inicial (só usados se a mansão falhar ao ser construída).
local function fallbackStart()
	local center = GameConfig.MANSION_CENTER + Vector3.new(0, 0.2, 0)
	local spawns = {}
	for i = 1, 8 do
		local angle = math.rad(22.5 + (i - 1) * 45)
		local position = center + Vector3.new(math.cos(angle) * 9, 3, math.sin(angle) * 9)
		table.insert(spawns, CFrame.lookAt(position, Vector3.new(center.X, position.Y, center.Z)))
	end
	return {
		startRoom = { cframe = CFrame.new(center + Vector3.new(0, 7.5, 0)), size = Vector3.new(27, 15, 27) },
		boardSpawn = CFrame.new(center + Vector3.new(0, 3.5, 0)),
		playerSpawns = spawns,
		doors = {},
		sealParts = {},
		opened = true,
	}
end

local function buildAll(): MapInfo
	local started = os.clock()
	workspace:SetAttribute("MapReady", false)

	local old = workspace:FindFirstChild("Map")
	if old then
		old:Destroy()
	end
	local mapFolder = Instance.new("Folder")
	mapFolder.Name = "Map"
	mapFolder.Parent = workspace
	local regionsFolder = Instance.new("Folder")
	regionsFolder.Name = "Regions"
	regionsFolder.Parent = mapFolder
	local spawnsFolder = Instance.new("Folder")
	spawnsFolder.Name = "WeaponSpawns"
	spawnsFolder.Parent = mapFolder
	local markersFolder = Instance.new("Folder")
	markersFolder.Name = "Marcadores"
	markersFolder.Parent = mapFolder

	local ctx = Kit.new(mapFolder, regionsFolder, spawnsFolder, markersFolder)

	local islandInfo = step("a ilha", function()
		return Island.Build(ctx)
	end)
	local mansionInfo = step("a mansão", function()
		return Mansion.Build(ctx)
	end)
	local mazeInfo = step("o labirinto", function()
		return Maze.Build(ctx)
	end)
	local greenhouseInfo = step("a estufa", function()
		return Greenhouse.Build(ctx)
	end)
	if mansionInfo and mazeInfo and greenhouseInfo then
		step("os jardins", function()
			Garden.Build(ctx, {
				mansion = mansionInfo,
				maze = mazeInfo,
				greenhouse = greenhouseInfo,
				island = islandInfo,
			})
		end)
	end

	startState = (mansionInfo and mansionInfo.start) or fallbackStart()
	if #ctx.weaponSpawns < MIN_WEAPON_SPAWNS then
		warn(
			("[MapBuilder] Só %d pontos de arma foram criados (mínimo esperado: %d)."):format(
				#ctx.weaponSpawns,
				MIN_WEAPON_SPAWNS
			)
		)
	end

	indexRegions(ctx.regions)
	local info: MapInfo = {
		islandCenter = GameConfig.ISLAND_CENTER,
		islandRadius = GameConfig.ISLAND_RADIUS,
		groundY = GameConfig.GROUND_Y,
		waterLevelY = GameConfig.WATER_LEVEL_Y,
		startRoom = startState.startRoom,
		boardSpawn = startState.boardSpawn,
		playerSpawns = startState.playerSpawns,
		weaponSpawns = ctx.weaponSpawns,
		regions = ctx.regions,
		mapFolder = mapFolder,
	}
	mapInfo = info
	workspace:SetAttribute("MapReady", true)
	print(
		("[MapBuilder] Mapa pronto: %d parts, %d regiões, %d pontos de arma em %.2f s."):format(
			ctx.partCount,
			#ctx.regions,
			#ctx.weaponSpawns,
			os.clock() - started
		)
	)
	return info
end

function MapBuilder.Build(): MapInfo
	if mapInfo then
		return mapInfo
	end
	if building then
		-- Outra thread já está construindo: espera ela terminar.
		while building do
			task.wait(0.1)
		end
		if mapInfo then
			return mapInfo
		end
		error("[MapBuilder] A construção do mapa falhou em outra chamada.")
	end
	building = true
	local ok, result = xpcall(buildAll, debug.traceback)
	building = false
	if not ok then
		error(result, 0)
	end
	return result
end

-- Abre (tween) as portas da sala inicial e libera a destruição das paredes dela. Pode ser chamada mais
-- de uma vez (só a primeira tem efeito) e não cede.
function MapBuilder.OpenStartDoors()
	if not startState and not workspace:FindFirstChild("Map") then
		warn("[MapBuilder] OpenStartDoors chamado antes do mapa existir.")
		return
	end
	StartRoom.OpenDoors(startState)
end

-- Região nomeada que contém o ponto (a de menor volume, se houver mais de uma), ou nil.
function MapBuilder.GetRegionAt(position: Vector3): Region?
	if typeof(position) ~= "Vector3" then
		return nil
	end
	ensureRegions()
	local best, bestVolume = nil, math.huge
	for _, entry in regionIndex do
		local localPoint = entry.region.cframe:PointToObjectSpace(position)
		local half = entry.half
		if
			math.abs(localPoint.X) <= half.X
			and math.abs(localPoint.Y) <= half.Y
			and math.abs(localPoint.Z) <= half.Z
			and entry.volume < bestVolume
		then
			best, bestVolume = entry.region, entry.volume
		end
	end
	return best
end

return MapBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">Maze</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Labirinto de cerca viva gerado por busca em profundidade aleatória (um labirinto novo a cada servidor).
-- Paredes vizinhas na mesma linha são unidas para economizar parts (no máximo 4 células por parede,
-- para a destruição continuar com pedaços de bom tamanho). Cada canto pertence a uma única parede,
-- então não existem faces sobrepostas piscando.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)

local Furniture = require(script.Parent.Furniture)
local Kit = require(script.Parent.Kit)
local Palette = require(script.Parent.Palette)
local Plants = require(script.Parent.Plants)

local Maze = {}

local M = Enum.Material

local N = 21 -- células por lado
local CELL = 12
local HEDGE_HEIGHT = 14
local HEDGE_THICKNESS = 2.5
local SECTOR = 7 -- 3 x 3 setores de 7 x 7 células
local MAX_RUN = 4
local CLEARING_MIN, CLEARING_MAX = 8, 12 -- clareira central de 5 x 5 células
local EXTRA_OPENINGS = 0.07 -- paredes internas removidas para criar caminhos alternativos (rotas de fuga)

-- Nomes dos setores: linha 0 = norte (menor Z), coluna 0 = oeste (menor X).
local SECTOR_NAMES = {
	[0] = { [0] = "Noroeste", [1] = "Norte", [2] = "Nordeste" },
	[1] = { [0] = "Oeste", [1] = "Centro", [2] = "Leste" },
	[2] = { [0] = "Sudoeste", [1] = "Sul", [2] = "Sudeste" },
}

function Maze.Build(ctx)
	local center = GameConfig.MAZE_CENTER
	local groundY = GameConfig.GROUND_Y
	local rng = ctx.random
	local size = N * CELL
	local x0 = center.X - size / 2
	local z0 = center.Z - size / 2

	-- hWalls[j][i]: parede ao longo do X na linha z = z0 + j*CELL, entre as células (i, j-1) e (i, j).
	-- vWalls[i][j]: parede ao longo do Z na linha x = x0 + i*CELL, entre as células (i-1, j) e (i, j).
	local hWalls, vWalls = {}, {}
	for j = 0, N do
		hWalls[j] = {}
		for i = 0, N - 1 do
			hWalls[j][i] = true
		end
	end
	for i = 0, N do
		vWalls[i] = {}
		for j = 0, N - 1 do
			vWalls[i][j] = true
		end
	end

	-- Busca em profundidade iterativa a partir do centro.
	local visited = {}
	local function key(i: number, j: number): number
		return j * N + i
	end
	local startCell = math.floor(N / 2)
	local stack = { { startCell, startCell } }
	visited[key(startCell, startCell)] = true
	while #stack > 0 do
		local top = stack[#stack]
		local i, j = top[1], top[2]
		local options = {}
		if i > 0 and not visited[key(i - 1, j)] then
			table.insert(options, { i - 1, j, "W" })
		end
		if i < N - 1 and not visited[key(i + 1, j)] then
			table.insert(options, { i + 1, j, "E" })
		end
		if j > 0 and not visited[key(i, j - 1)] then
			table.insert(options, { i, j - 1, "N" })
		end
		if j < N - 1 and not visited[key(i, j + 1)] then
			table.insert(options, { i, j + 1, "S" })
		end
		if #options == 0 then
			table.remove(stack)
		else
			local choice = options[rng:NextInteger(1, #options)]
			local ni, nj, direction = choice[1], choice[2], choice[3]
			if direction == "W" then
				vWalls[i][j] = false
			elseif direction == "E" then
				vWalls[i + 1][j] = false
			elseif direction == "N" then
				hWalls[j][i] = false
			else
				hWalls[j + 1][i] = false
			end
			visited[key(ni, nj)] = true
			table.insert(stack, { ni, nj })
		end
	end

	-- Clareira central aberta.
	for j = CLEARING_MIN + 1, CLEARING_MAX do
		for i = CLEARING_MIN, CLEARING_MAX do
			hWalls[j][i] = false
		end
	end
	for i = CLEARING_MIN + 1, CLEARING_MAX do
		for j = CLEARING_MIN, CLEARING_MAX do
			vWalls[i][j] = false
		end
	end
	-- Alguns atalhos extras.
	for j = 1, N - 1 do
		for i = 0, N - 1 do
			if hWalls[j][i] and rng:NextNumber() < EXTRA_OPENINGS then
				hWalls[j][i] = false
			end
		end
	end
	for i = 1, N - 1 do
		for j = 0, N - 1 do
			if vWalls[i][j] and rng:NextNumber() < EXTRA_OPENINGS then
				vWalls[i][j] = false
			end
		end
	end

	-- Entrada voltada para a mansão e saída do lado oposto.
	local mansionIsSouth = GameConfig.MANSION_CENTER.Z >= center.Z
	local entranceLine = mansionIsSouth and N or 0
	local exitLine = mansionIsSouth and 0 or N
	local entranceI = startCell
	local exitI = rng:NextInteger(2, N - 3)
	hWalls[entranceLine][entranceI] = false
	hWalls[exitLine][exitI] = false

	-- Models por setor.
	local sectors = {}
	local function sectorModel(si: number, sj: number): Model
		local id = sj * 3 + si
		if not sectors[id] then
			sectors[id] = { model = Kit.chunk("Labirinto - " .. SECTOR_NAMES[sj][si]), si = si, sj = sj }
		end
		return sectors[id].model
	end
	local function clampSector(index: number): number
		return math.clamp(math.floor(index / SECTOR), 0, 2)
	end

	local claimed = {}
	local function cornerKey(ci: number, cj: number): number
		return cj * (N + 1) + ci
	end
	local function hCovered(ci: number, cj: number): boolean
		local row = hWalls[cj]
		return (ci > 0 and row[ci - 1] == true) or (ci < N and row[ci] == true)
	end
	local half = HEDGE_THICKNESS / 2
	local hedgeY = groundY - 0.5 + (HEDGE_HEIGHT + 0.5) / 2
	local function hedge(parent: Model, cf: CFrame, size: Vector3)
		Kit.box(ctx, parent, "CercaViva", cf, size, Palette.pick(Palette.Hedge, rng), M.LeafyGrass, Kit.D)
	end

	-- Paredes ao longo do X: cada trecho inclui os cantos das pontas.
	for j = 0, N do
		local z = z0 + j * CELL
		local i = 0
		while i < N do
			if hWalls[j][i] then
				local a = i
				local b = i + 1
				while b < N and hWalls[j][b] and (b - a) < MAX_RUN and b % SECTOR ~= 0 do
					b += 1
				end
				local startX = claimed[cornerKey(a, j)] and (x0 + a * CELL + half) or (x0 + a * CELL - half)
				local endX = x0 + b * CELL + half
				for ci = a, b do
					claimed[cornerKey(ci, j)] = true
				end
				hedge(
					sectorModel(clampSector(a), clampSector(math.min(j, N - 1))),
					CFrame.new((startX + endX) / 2, hedgeY, z),
					Vector3.new(endX - startX, HEDGE_HEIGHT + 0.5, HEDGE_THICKNESS)
				)
				i = b
			else
				i += 1
			end
		end
	end

	-- Paredes ao longo do Z: quebram nos cantos que já têm parede em X (sem sobreposição).
	for i = 0, N do
		local x = x0 + i * CELL
		local j = 0
		while j < N do
			if vWalls[i][j] then
				local a = j
				local b = j + 1
				while b < N and vWalls[i][b] and (b - a) < MAX_RUN and b % SECTOR ~= 0 and not hCovered(i, b) do
					b += 1
				end
				local startZ, endZ
				local startKey, endKey = cornerKey(i, a), cornerKey(i, b)
				if hCovered(i, a) or claimed[startKey] then
					startZ = z0 + a * CELL + half
				else
					startZ = z0 + a * CELL - half
					claimed[startKey] = true
				end
				if hCovered(i, b) or claimed[endKey] then
					endZ = z0 + b * CELL - half
				else
					endZ = z0 + b * CELL + half
					claimed[endKey] = true
				end
				for cj = a + 1, b - 1 do
					claimed[cornerKey(i, cj)] = true
				end
				if endZ - startZ > 0.1 then
					hedge(
						sectorModel(clampSector(math.min(i, N - 1)), clampSector(a)),
						CFrame.new(x, hedgeY, (startZ + endZ) / 2),
						Vector3.new(HEDGE_THICKNESS, HEDGE_HEIGHT + 0.5, endZ - startZ)
					)
				end
				j = b
			else
				j += 1
			end
		end
	end

	-- Clareira: fonte com um tambor de pedra gigante, bancos e tochas.
	local clearing = sectorModel(1, 1)
	local cx, cz = center.X, center.Z
	local basinRadius = 7
	for k = 0, 7 do
		local angle = k * math.pi / 4
		local length = 2 * basinRadius * math.tan(math.pi / 8) + 1.2
		local height = (k % 2 == 0) and 2.2 or 2.3
		Kit.box(
			ctx,
			clearing,
			"BordaDaFonte",
			CFrame.new(cx + math.cos(angle) * basinRadius, groundY + height / 2, cz + math.sin(angle) * basinRadius)
				* CFrame.Angles(0, -angle + math.pi / 2, 0),
			Vector3.new(length, height, 1.2),
			Palette.Stone,
			M.Granite,
			Kit.D
		)
	end
	Kit.cylinder(
		ctx,
		clearing,
		"FundoDaFonte",
		Vector3.new(cx, groundY + 0.1, cz),
		0.6,
		basinRadius * 2,
		Palette.StoneDark,
		M.Slate,
		Kit.I
	)
	Kit.cylinder(
		ctx,
		clearing,
		"Agua",
		Vector3.new(cx, groundY + 1.5, cz),
		0.2,
		basinRadius * 2 - 1,
		Palette.Water,
		M.SmoothPlastic,
		nil,
		{ Ghost = true, Transparency = 0.3 }
	)
	Kit.cylinder(ctx, clearing, "Pilar", Vector3.new(cx, groundY + 3, cz), 6, 2.6, Palette.Stone, M.Granite, Kit.I)
	Kit.cylinder(
		ctx,
		clearing,
		"TamborDePedra",
		Vector3.new(cx, groundY + 8, cz),
		4,
		5.5,
		Palette.Marble,
		M.Marble,
		Kit.I
	)
	Kit.cylinder(
		ctx,
		clearing,
		"PeleDePedra",
		Vector3.new(cx, groundY + 10.1, cz),
		0.3,
		5.1,
		Palette.Parchment,
		M.Marble,
		nil,
		{ NoShadow = true }
	)
	Kit.cylinder(
		ctx,
		clearing,
		"Cinta",
		Vector3.new(cx, groundY + 7, cz),
		0.8,
		5.8,
		Palette.Gold,
		M.Metal,
		nil,
		{ NoShadow = true }
	)
	for k = 0, 3 do
		local angle = k * math.pi / 2 + math.pi / 4
		local position = Vector3.new(cx + math.cos(angle) * 15, groundY, cz + math.sin(angle) * 15)
		Furniture.Bench(
			ctx,
			clearing,
			CFrame.lookAt(position, Vector3.new(cx, groundY, cz)) * CFrame.Angles(0, math.pi, 0),
			5,
			Palette.Stone,
			M.Granite
		)
	end
	for k, corner in { { -24, -24 }, { 24, -24 }, { -24, 24 }, { 24, 24 } } do
		local base = Vector3.new(cx + corner[1], groundY, cz + corner[2])
		Kit.cylinder(ctx, clearing, "Tocha", base + Vector3.new(0, 3.5, 0), 7, 0.5, Palette.WoodDark, M.Wood)
		local flame = Kit.ball(
			ctx,
			clearing,
			"Chama",
			base + Vector3.new(0, 7.4, 0),
			1,
			Palette.Flame,
			M.Neon,
			nil,
			{ Ghost = true, NoShadow = true }
		)
		if k % 2 == 1 then
			Kit.light(flame, Palette.Flame, 26, 1.2)
		end
	end
	for k = 0, 5 do
		local angle = k * math.pi / 3
		Plants.Fern(ctx, clearing, Vector3.new(cx + math.cos(angle) * 27, groundY, cz + math.sin(angle) * 27), 3, rng)
	end

	-- Armas: quatro na clareira e uma por setor em becos sem saída.
	for k = 0, 3 do
		local angle = k * math.pi / 2
		Kit.weaponSpawn(
			ctx,
			Vector3.new(cx + math.cos(angle) * 11, groundY + 1.5, cz + math.sin(angle) * 11),
			"Clareira do Labirinto"
		)
	end
	local deadEnds = {}
	for j = 0, N - 1 do
		for i = 0, N - 1 do
			local inClearing = i >= CLEARING_MIN and i <= CLEARING_MAX and j >= CLEARING_MIN and j <= CLEARING_MAX
			if not inClearing then
				local walls = (hWalls[j][i] and 1 or 0)
					+ (hWalls[j + 1][i] and 1 or 0)
					+ (vWalls[i][j] and 1 or 0)
					+ (vWalls[i + 1][j] and 1 or 0)
				if walls >= 3 then
					local sectorId = clampSector(j) * 3 + clampSector(i)
					deadEnds[sectorId] = deadEnds[sectorId] or {}
					table.insert(deadEnds[sectorId], { i, j })
				end
			end
		end
	end
	for sectorId = 0, 8 do
		local list = deadEnds[sectorId]
		if list and #list > 0 and sectorId ~= 4 then
			local cell = list[rng:NextInteger(1, #list)]
			local si, sj = sectorId % 3, math.floor(sectorId / 3)
			Kit.weaponSpawn(
				ctx,
				Vector3.new(x0 + (cell[1] + 0.5) * CELL, groundY + 1.5, z0 + (cell[2] + 0.5) * CELL),
				"Labirinto - " .. SECTOR_NAMES[sj][si]
			)
		end
	end

	-- Portais de pedra na entrada (com placa) e na saída.
	local function gate(line: number, cellI: number, label: string?)
		local gateModel = sectorModel(clampSector(cellI), clampSector(math.min(line, N - 1)))
		local z = z0 + line * CELL
		local outward = (line == N) and 1 or -1
		local gx = x0 + (cellI + 0.5) * CELL
		for _, side in { -1, 1 } do
			Kit.box(
				ctx,
				gateModel,
				"Portal",
				Vector3.new(gx + side * (CELL / 2 - 0.2), groundY + 8, z + outward * 2.2),
				Vector3.new(2.6, 16, 2.6),
				Palette.Stone,
				M.Granite,
				Kit.D
			)
			Kit.ball(
				ctx,
				gateModel,
				"Lanterna",
				Vector3.new(gx + side * (CELL / 2 - 0.2), groundY + 16.8, z + outward * 2.2),
				1.4,
				Palette.LightWarm,
				M.Neon,
				nil,
				{ Ghost = true, NoShadow = true }
			)
		end
		Kit.box(
			ctx,
			gateModel,
			"Arco",
			Vector3.new(gx, groundY + 15, z + outward * 2.2),
			Vector3.new(CELL + 2.2, 2, 2.6),
			Palette.Stone,
			M.Granite,
			Kit.D
		)
		if label then
			local sign = Kit.box(
				ctx,
				gateModel,
				"Placa",
				Vector3.new(gx, groundY + 13, z + outward * 3.6),
				Vector3.new(8, 1.8, 0.3),
				Palette.WoodDark,
				M.Wood,
				nil,
				{ Ghost = true }
			)
			local gui = Instance.new("SurfaceGui")
			gui.Name = "Texto"
			gui.Face = (outward > 0) and Enum.NormalId.Back or Enum.NormalId.Front
			gui.CanvasSize = Vector2.new(400, 90)
			gui.LightInfluence = 1
			local text = Instance.new("TextLabel")
			text.Size = UDim2.fromScale(1, 1)
			text.BackgroundTransparency = 1
			text.Font = Enum.Font.Fondamento
			text.TextScaled = true
			text.TextColor3 = Palette.Gold
			text.Text = label
			text.Parent = gui
			gui.Parent = sign
		end
	end
	gate(entranceLine, entranceI, "LABIRINTO")
	gate(exitLine, exitI, nil)

	for _, sector in sectors do
		local sx = x0 + (sector.si + 0.5) * SECTOR * CELL
		local sz = z0 + (sector.sj + 0.5) * SECTOR * CELL
		Kit.attach(sector.model, ctx.map, Vector3.new(sx, groundY + HEDGE_HEIGHT / 2, sz))
		local regionName = "Labirinto - " .. SECTOR_NAMES[sector.sj][sector.si]
		Kit.region(ctx, regionName, CFrame.new(sx, groundY + 10, sz), Vector3.new(SECTOR * CELL, 26, SECTOR * CELL), 0)
	end
	local clearingSize = (CLEARING_MAX - CLEARING_MIN + 1) * CELL
	Kit.region(
		ctx,
		"Clareira do Labirinto",
		CFrame.new(cx, groundY + 10, cz),
		Vector3.new(clearingSize, 26, clearingSize),
		0
	)

	Kit.block(ctx, x0 - 8, x0 + size + 8, z0 - 8, z0 + size + 8)

	local entranceZ = z0 + entranceLine * CELL + (mansionIsSouth and 6 or -6)
	local exitZ = z0 + exitLine * CELL + (mansionIsSouth and -6 or 6)
	return {
		entrance = Vector3.new(x0 + (entranceI + 0.5) * CELL, groundY, entranceZ),
		exit = Vector3.new(x0 + (exitI + 0.5) * CELL, groundY, exitZ),
		bounds = { minX = x0, maxX = x0 + size, minZ = z0, maxZ = z0 + size },
	}
end

return Maze
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">Palette</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Paleta de cores e materiais do mapa. Ajuste o visual da ilha, da mansão e dos jardins aqui.

local Palette = {}

local rgb = Color3.fromRGB

-- Ilha e mar -------------------------------------------------------------------
Palette.Grass = rgb(84, 124, 52)
Palette.GrassDark = rgb(62, 98, 40)
Palette.Sand = rgb(224, 202, 150)
Palette.SandWet = rgb(196, 172, 122)
Palette.Seabed = rgb(150, 138, 100)
Palette.DeepSea = rgb(12, 46, 64)
Palette.Water = rgb(34, 112, 150)
Palette.Rocks = { rgb(110, 106, 98), rgb(92, 90, 86), rgb(128, 120, 106), rgb(78, 76, 74) }

-- Vegetação --------------------------------------------------------------------
Palette.Leaves = { rgb(56, 108, 44), rgb(44, 92, 38), rgb(72, 126, 52), rgb(38, 80, 34), rgb(86, 132, 58) }
Palette.Hedge = { rgb(38, 82, 38), rgb(34, 74, 34), rgb(44, 90, 42), rgb(40, 78, 36) }
Palette.PalmLeaf = { rgb(70, 130, 50), rgb(60, 116, 44), rgb(82, 140, 58) }
Palette.Trunk = rgb(92, 66, 44)
Palette.PalmTrunk = rgb(140, 112, 78)
Palette.Vine = rgb(48, 98, 40)
Palette.Flowers = { rgb(214, 52, 66), rgb(242, 196, 60), rgb(232, 120, 170), rgb(250, 250, 240), rgb(230, 110, 40) }
Palette.Coconut = rgb(96, 70, 40)
Palette.Soil = rgb(78, 56, 38)

-- Mansão -----------------------------------------------------------------------
Palette.Brick = rgb(122, 62, 46)
Palette.BrickDark = rgb(96, 50, 38)
Palette.Trim = rgb(232, 224, 204)
Palette.Stone = rgb(150, 146, 136)
Palette.StoneDark = rgb(112, 108, 100)
Palette.Roof = rgb(56, 60, 68)
Palette.Plaster = rgb(214, 198, 166)
Palette.PlasterUpper = rgb(200, 186, 160)
Palette.Glass = rgb(176, 210, 220)
Palette.WoodDark = rgb(70, 44, 26)
Palette.Wood = rgb(112, 74, 42)
Palette.WoodLight = rgb(160, 118, 74)
Palette.WoodRed = rgb(120, 52, 36)
Palette.FloorWood = rgb(120, 82, 50)
Palette.FloorWoodLight = rgb(150, 108, 66)
Palette.Marble = rgb(228, 224, 214)
Palette.MarbleDark = rgb(70, 66, 64)
Palette.Tiles = rgb(206, 204, 196)
Palette.TilesBlue = rgb(150, 176, 190)
Palette.Gold = rgb(204, 164, 66)
Palette.Brass = rgb(176, 136, 62)
Palette.Iron = rgb(42, 42, 46)
Palette.Steel = rgb(120, 124, 130)
Palette.White = rgb(240, 238, 230)
Palette.Black = rgb(24, 22, 22)
Palette.Felt = rgb(30, 96, 54)
Palette.Leather = rgb(96, 58, 34)
Palette.Parchment = rgb(222, 204, 160)
Palette.Fabrics = {
	rgb(140, 36, 40),
	rgb(46, 74, 120),
	rgb(56, 98, 60),
	rgb(150, 110, 50),
	rgb(104, 58, 110),
	rgb(170, 150, 120),
}
Palette.Sheets = { rgb(236, 232, 218), rgb(214, 222, 236), rgb(236, 220, 214) }
Palette.Books = {
	rgb(128, 34, 30),
	rgb(36, 60, 104),
	rgb(40, 84, 52),
	rgb(122, 92, 40),
	rgb(70, 40, 72),
	rgb(150, 132, 100),
	rgb(30, 30, 34),
}
Palette.Canvas = {
	rgb(70, 110, 140),
	rgb(150, 120, 70),
	rgb(60, 100, 60),
	rgb(130, 60, 50),
	rgb(200, 170, 120),
	rgb(40, 50, 80),
}
Palette.Toys = { rgb(220, 60, 50), rgb(60, 120, 220), rgb(250, 200, 50), rgb(70, 170, 80) }

-- Estufa e exterior --------------------------------------------------------------
Palette.GreenhouseFrame = rgb(34, 70, 46)
Palette.GreenhouseGlass = rgb(196, 226, 214)
Palette.Path = rgb(128, 124, 116)
Palette.PathDark = rgb(108, 104, 98)
Palette.Terracotta = rgb(176, 96, 60)
Palette.Flame = rgb(255, 150, 50)
Palette.LightWarm = rgb(255, 200, 140)
Palette.LightCool = rgb(220, 236, 255)

-- Escolhe um item aleatório de uma lista.
function Palette.pick(list: { any }, rng: Random): any
	return list[rng:NextInteger(1, #list)]
end

-- Variação leve de uma cor (amount em 0..1 de brilho).
function Palette.vary(color: Color3, rng: Random, amount: number?): Color3
	local a = amount or 0.08
	local factor = 1 + rng:NextNumber(-a, a)
	return Color3.new(
		math.clamp(color.R * factor, 0, 1),
		math.clamp(color.G * factor, 0, 1),
		math.clamp(color.B * factor, 0, 1)
	)
end

return Palette
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">Plants</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Plantas procedurais (todas feitas de parts): árvores, coqueiros, arbustos, samambaias,
-- folhas grandes, cipós e flores. Usadas pela ilha, pelos jardins, pela estufa e pela mansão.
-- `base` é sempre o ponto no chão onde a planta nasce.

local Kit = require(script.Parent.Kit)
local Palette = require(script.Parent.Palette)

local Plants = {}

local M = Enum.Material
local GHOST = { Ghost = true }
local GHOST_NO_SHADOW = { Ghost = true, NoShadow = true }

-- Árvore de folhas largas: tronco quadrado e copa de blocos girados (estilo low-poly).
function Plants.Tree(ctx, parent: Instance, base: Vector3, scale: number, rng: Random)
	local height = 12 * scale
	local trunkWidth = 2.2 * scale
	Kit.box(
		ctx,
		parent,
		"Tronco",
		CFrame.new(base + Vector3.new(0, height / 2 - 0.5, 0)) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0),
		Vector3.new(trunkWidth, height + 1, trunkWidth),
		Palette.vary(Palette.Trunk, rng),
		M.Wood,
		Kit.D
	)
	local count = rng:NextInteger(2, 3)
	for i = 1, count do
		local size = (8 + rng:NextNumber(0, 5)) * scale
		local lift = (i == 1) and 0 or rng:NextNumber(1.5, 3.5) * scale
		local offset = Vector3.new(rng:NextNumber(-2, 2) * scale, height + lift, rng:NextNumber(-2, 2) * scale)
		Kit.box(
			ctx,
			parent,
			"Copa",
			CFrame.new(base + offset)
				* CFrame.Angles(rng:NextNumber(-0.35, 0.35), rng:NextNumber(0, math.pi), rng:NextNumber(-0.35, 0.35)),
			Vector3.new(size, size * 0.7, size),
			Palette.pick(Palette.Leaves, rng),
			M.LeafyGrass,
			Kit.D
		)
	end
end

-- Coqueiro com tronco curvo (4 segmentos), folhas caídas e cocos soltos.
function Plants.Palm(ctx, parent: Instance, base: Vector3, height: number, rng: Random, withCoconuts: boolean?)
	local direction = rng:NextNumber(0, math.pi * 2)
	local lean = rng:NextNumber(0.06, 0.2)
	local segments = 4
	local segmentLength = height / segments
	local width = math.clamp(height * 0.075, 0.9, 1.8)
	local joint = base - Vector3.new(0, 0.5, 0)
	local tilt = 0
	local up = Vector3.yAxis
	for i = 1, segments do
		tilt += lean * (i == 1 and 0.4 or 1)
		up = Vector3.new(math.sin(tilt) * math.cos(direction), math.cos(tilt), math.sin(tilt) * math.sin(direction))
		local center = joint + up * (segmentLength / 2)
		Kit.box(
			ctx,
			parent,
			"Tronco",
			CFrame.new(center) * CFrame.Angles(0, -direction, 0) * CFrame.Angles(0, 0, -tilt),
			Vector3.new(width * (1 - i * 0.06), segmentLength + 0.4, width * (1 - i * 0.06)),
			Palette.vary(Palette.PalmTrunk, rng),
			M.Wood,
			Kit.D
		)
		joint += up * segmentLength
	end
	local top = joint
	local fronds = rng:NextInteger(5, 7)
	local frondLength = math.clamp(height * 0.42, 4, 10)
	for i = 1, fronds do
		local angle = (i / fronds) * math.pi * 2 + rng:NextNumber(-0.2, 0.2)
		local droop = rng:NextNumber(0.25, 0.55)
		Kit.box(
			ctx,
			parent,
			"Folha",
			CFrame.new(top)
				* CFrame.Angles(0, angle, 0)
				* CFrame.Angles(-droop, 0, 0)
				* CFrame.new(0, 0, -frondLength / 2),
			Vector3.new(frondLength * 0.22, 0.25, frondLength),
			Palette.pick(Palette.PalmLeaf, rng),
			M.Grass,
			nil,
			GHOST
		)
	end
	if withCoconuts ~= false then
		for i = 1, rng:NextInteger(1, 3) do
			local angle = i * 2.1 + direction
			Kit.ball(
				ctx,
				parent,
				"Coco",
				top + Vector3.new(math.cos(angle) * 0.9, -0.7, math.sin(angle) * 0.9),
				1,
				Palette.Coconut,
				M.Wood,
				Kit.L
			)
		end
	end
end

-- Arbusto arredondado meio enterrado.
function Plants.Bush(ctx, parent: Instance, base: Vector3, size: number, rng: Random, color: Color3?)
	Kit.ball(
		ctx,
		parent,
		"Arbusto",
		base + Vector3.new(0, size * 0.28, 0),
		size,
		color or Palette.pick(Palette.Leaves, rng),
		M.LeafyGrass,
		nil,
		size < 4 and GHOST or nil
	)
end

-- Folhas finas saindo do chão em leque (samambaia). Sem colisão.
function Plants.Fern(ctx, parent: Instance, base: Vector3, size: number, rng: Random, leaves: number?)
	local count = leaves or 5
	local start = rng:NextNumber(0, math.pi * 2)
	for i = 1, count do
		local angle = start + (i / count) * math.pi * 2 + rng:NextNumber(-0.25, 0.25)
		local length = size * rng:NextNumber(0.8, 1.15)
		Kit.box(
			ctx,
			parent,
			"Samambaia",
			CFrame.new(base + Vector3.new(0, 0.1, 0))
				* CFrame.Angles(0, angle, 0)
				* CFrame.Angles(rng:NextNumber(0.45, 0.8), 0, 0)
				* CFrame.new(0, 0, -length / 2),
			Vector3.new(length * 0.28, 0.15, length),
			Palette.pick(Palette.Leaves, rng),
			M.Grass,
			nil,
			GHOST_NO_SHADOW
		)
	end
end

-- Folhas grandes (tipo taioba): poucas folhas largas e bem inclinadas.
function Plants.BigLeaves(ctx, parent: Instance, base: Vector3, size: number, rng: Random)
	local start = rng:NextNumber(0, math.pi * 2)
	for i = 1, 3 do
		local angle = start + i * 2.1
		local length = size * rng:NextNumber(0.85, 1.1)
		Kit.box(
			ctx,
			parent,
			"FolhaGrande",
			CFrame.new(base + Vector3.new(0, size * 0.25, 0))
				* CFrame.Angles(0, angle, 0)
				* CFrame.Angles(rng:NextNumber(0.6, 0.95), 0, 0)
				* CFrame.new(0, 0, -length / 2),
			Vector3.new(length * 0.55, 0.2, length),
			Palette.pick(Palette.PalmLeaf, rng),
			M.Grass,
			nil,
			GHOST
		)
	end
end

-- Cipó pendurado a partir de `top`, encostado numa superfície virada para `facing` (direção horizontal).
function Plants.Vine(ctx, parent: Instance, top: Vector3, length: number, rng: Random, facing: Vector3?)
	local yaw = 0
	if facing and facing.Magnitude > 0.01 then
		yaw = math.atan2(-facing.X, -facing.Z)
	end
	Kit.box(
		ctx,
		parent,
		"Cipo",
		CFrame.new(top - Vector3.new(0, length / 2, 0)) * CFrame.Angles(0, yaw, rng:NextNumber(-0.06, 0.06)),
		Vector3.new(rng:NextNumber(0.9, 1.6), length, 0.3),
		Palette.vary(Palette.Vine, rng, 0.15),
		M.Grass,
		nil,
		GHOST_NO_SHADOW
	)
end

-- Pequeno canteiro de flores (bolinhas coloridas sem colisão).
function Plants.Flowers(ctx, parent: Instance, center: Vector3, radius: number, count: number, rng: Random)
	local color = Palette.pick(Palette.Flowers, rng)
	for _ = 1, count do
		local angle = rng:NextNumber(0, math.pi * 2)
		local distance = rng:NextNumber(0, radius)
		Kit.ball(
			ctx,
			parent,
			"Flor",
			center + Vector3.new(math.cos(angle) * distance, 0.6, math.sin(angle) * distance),
			rng:NextNumber(0.7, 1.2),
			color,
			M.SmoothPlastic,
			nil,
			GHOST_NO_SHADOW
		)
	end
end

return Plants
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">Rooms</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Cômodos da mansão: nomes, pisos e a mobília temática de cada um.
--
-- Cada cômodo é um objeto Room com um referencial local: origem no centro do piso, -Z apontando para a
-- porta principal ("front"), +Z para a parede oposta ("back"), -X = "left" e +X = "right".
-- O Room conhece as portas e janelas das suas paredes e guarda as áreas ocupadas, então os móveis
-- nunca bloqueiam uma porta e não se sobrepõem.

local Kit = require(script.Parent.Kit)
local Palette = require(script.Parent.Palette)
local Furniture = require(script.Parent.Furniture)
local Plants = require(script.Parent.Plants)

local Rooms = {}

local M = Enum.Material

-- Dados dos cômodos ------------------------------------------------------------------------

Rooms.Info = {
	-- Térreo
	JardimInverno = {
		name = "Jardim de Inverno",
		kind = "WinterGarden",
		floorMaterial = M.CeramicTiles,
		floorColor = Palette.TilesBlue,
		weapons = 1,
	},
	Musica = {
		name = "Sala de Música",
		kind = "Music",
		floorMaterial = M.WoodPlanks,
		floorColor = Palette.FloorWoodLight,
		weapons = 1,
	},
	Estar = {
		name = "Sala de Estar",
		kind = "Living",
		floorMaterial = M.WoodPlanks,
		floorColor = Palette.FloorWood,
		weapons = 2,
	},
	Hall = {
		name = "Hall de Entrada",
		kind = "Hall",
		floorMaterial = M.Marble,
		floorColor = Palette.Marble,
		weapons = 2,
	},
	Biblioteca = {
		name = "Biblioteca",
		kind = "Library",
		floorMaterial = M.WoodPlanks,
		floorColor = Palette.FloorWood,
		weapons = 2,
	},
	Escritorio = {
		name = "Escritório",
		kind = "Study",
		floorMaterial = M.WoodPlanks,
		floorColor = Palette.FloorWood,
		weapons = 1,
	},
	Adega = { name = "Adega", kind = "Cellar", floorMaterial = M.Slate, floorColor = Palette.StoneDark, weapons = 1 },
	Trofeus = {
		name = "Sala de Troféus de Caça",
		kind = "Trophy",
		floorMaterial = M.WoodPlanks,
		floorColor = Palette.FloorWood,
		weapons = 2,
	},
	Bilhar = {
		name = "Sala de Bilhar",
		kind = "Billiards",
		floorMaterial = M.WoodPlanks,
		floorColor = Palette.FloorWoodLight,
		weapons = 1,
	},
	Jogos = {
		name = "Sala de Jogos",
		kind = "GameRoom",
		floorMaterial = M.WoodPlanks,
		floorColor = Palette.WoodRed,
		weapons = 0,
	},
	Jantar = {
		name = "Sala de Jantar",
		kind = "Dining",
		floorMaterial = M.WoodPlanks,
		floorColor = Palette.FloorWood,
		weapons = 2,
	},
	Despensa = { name = "Despensa", kind = "Pantry", floorMaterial = M.Slate, floorColor = Palette.Stone, weapons = 1 },
	Baile = {
		name = "Salão de Baile",
		kind = "Ballroom",
		floorMaterial = M.Marble,
		floorColor = Palette.Marble,
		weapons = 2,
	},
	EscadaFundos = {
		name = "Escadaria dos Fundos",
		kind = "BackStairs",
		floorMaterial = M.WoodPlanks,
		floorColor = Palette.FloorWood,
		weapons = 1,
	},
	Cozinha = {
		name = "Cozinha",
		kind = "Kitchen",
		floorMaterial = M.CeramicTiles,
		floorColor = Palette.Tiles,
		weapons = 2,
	},
	Lavanderia = {
		name = "Lavanderia",
		kind = "Laundry",
		floorMaterial = M.CeramicTiles,
		floorColor = Palette.TilesBlue,
		weapons = 1,
	},
	-- 2º andar (o material vale para a laje: o lado de baixo é o teto do térreo)
	Observatorio = {
		name = "Observatório",
		kind = "Observatory",
		floorMaterial = M.WoodPlanks,
		floorColor = Palette.FloorWood,
		weapons = 1,
	},
	Pintura = {
		name = "Estúdio de Pintura",
		kind = "Painting",
		floorMaterial = M.WoodPlanks,
		floorColor = Palette.FloorWoodLight,
		weapons = 1,
	},
	Costura = {
		name = "Sala de Costura",
		kind = "Sewing",
		floorMaterial = M.WoodPlanks,
		floorColor = Palette.FloorWood,
		weapons = 1,
	},
	Mapas = {
		name = "Sala de Mapas",
		kind = "Maps",
		floorMaterial = M.WoodPlanks,
		floorColor = Palette.FloorWood,
		weapons = 1,
	},
	Banheiro1 = {
		name = "Banheiro 1",
		kind = "Bathroom",
		floorMaterial = M.WoodPlanks,
		floorColor = Palette.FloorWoodLight,
		weapons = 1,
	},
	Banheiro2 = {
		name = "Banheiro 2",
		kind = "Bathroom",
		floorMaterial = M.WoodPlanks,
		floorColor = Palette.FloorWoodLight,
		weapons = 1,
	},
	Banheiro3 = {
		name = "Banheiro 3",
		kind = "Bathroom",
		floorMaterial = M.WoodPlanks,
		floorColor = Palette.FloorWoodLight,
		weapons = 1,
	},
	Hospedes1 = {
		name = "Quarto de Hóspedes 1",
		kind = "GuestRoom",
		floorMaterial = M.WoodPlanks,
		floorColor = Palette.FloorWood,
		weapons = 1,
	},
	Hospedes2 = {
		name = "Quarto de Hóspedes 2",
		kind = "GuestRoom",
		floorMaterial = M.WoodPlanks,
		floorColor = Palette.FloorWood,
		weapons = 1,
	},
	Hospedes3 = {
		name = "Quarto de Hóspedes 3",
		kind = "GuestRoom",
		floorMaterial = M.WoodPlanks,
		floorColor = Palette.FloorWood,
		weapons = 1,
	},
	Hospedes4 = {
		name = "Quarto de Hóspedes 4",
		kind = "GuestRoom",
		floorMaterial = M.WoodPlanks,
		floorColor = Palette.FloorWood,
		weapons = 1,
	},
	Galeria = {
		name = "Galeria de Arte",
		kind = "Gallery",
		floorMaterial = M.WoodPlanks,
		floorColor = Palette.FloorWoodLight,
		weapons = 2,
	},
	Criancas = {
		name = "Quarto das Crianças",
		kind = "Kids",
		floorMaterial = M.WoodPlanks,
		floorColor = Palette.FloorWoodLight,
		weapons = 1,
	},
	QuartoPrincipal = {
		name = "Quarto Principal",
		kind = "MasterBedroom",
		floorMaterial = M.WoodPlanks,
		floorColor = Palette.FloorWood,
		weapons = 2,
	},
	Sotao = {
		name = "Sótão",
		kind = "Attic",
		floorMaterial = M.WoodPlanks,
		floorColor = Palette.FloorWoodLight,
		weapons = 2,
	},
}

-- Objeto Room ---------------------------------------------------------------------------------

local Room = {}
Room.__index = Room

local DOOR_ZONE_DEPTH = 5.5

-- def: { key, name, kind, story, floorY, cf, w, d, h, openings }
function Rooms.new(ctx, def)
	local self = setmetatable({}, Room)
	self.ctx = ctx
	self.rng = ctx.random
	self.key = def.key
	self.name = def.name
	self.kind = def.kind
	self.story = def.story
	self.floorY = def.floorY
	self.cf = def.cf
	self.w = def.w
	self.d = def.d
	self.h = def.h
	self.model = Kit.chunk(def.name)
	self.occupied = {}
	self.doorZones = {}
	self.openings = {}
	for _, opening in def.openings or {} do
		self:_addOpening(opening)
	end
	return self
end

-- Converte uma abertura do mundo para o referencial do cômodo.
function Room:_addOpening(o)
	local p = self.cf:PointToObjectSpace(o.position)
	local halfW, halfD = self.w / 2, self.d / 2
	local wall, along
	-- A parede é paralela ao X do mundo; como o cômodo só gira 0° ou 180°, continua paralela ao X local.
	if o.axis == "X" then
		if math.abs(math.abs(p.Z) - halfD) > 1.6 or math.abs(p.X) > halfW + 1 then
			return
		end
		wall = (p.Z < 0) and "front" or "back"
		along = p.X
	else
		if math.abs(math.abs(p.X) - halfW) > 1.6 or math.abs(p.Z) > halfD + 1 then
			return
		end
		wall = (p.X < 0) and "left" or "right"
		along = p.Z
	end
	local bottom = o.bottomY - self.floorY
	local entry = {
		wall = wall,
		along = along,
		width = o.width,
		kind = o.kind,
		bottom = bottom,
		top = o.topY - self.floorY,
	}
	table.insert(self.openings, entry)
	if o.kind == "door" and math.abs(bottom) < 1 then
		local hw = o.width / 2 + 1
		local zone
		if wall == "front" then
			zone = { cx = along, cz = -halfD + DOOR_ZONE_DEPTH / 2, hx = hw, hz = DOOR_ZONE_DEPTH / 2 }
		elseif wall == "back" then
			zone = { cx = along, cz = halfD - DOOR_ZONE_DEPTH / 2, hx = hw, hz = DOOR_ZONE_DEPTH / 2 }
		elseif wall == "left" then
			zone = { cx = -halfW + DOOR_ZONE_DEPTH / 2, cz = along, hx = DOOR_ZONE_DEPTH / 2, hz = hw }
		else
			zone = { cx = halfW - DOOR_ZONE_DEPTH / 2, cz = along, hx = DOOR_ZONE_DEPTH / 2, hz = hw }
		end
		table.insert(self.doorZones, zone)
	end
end

-- CFrame no mundo a partir de coordenadas locais (x, z), giro em graus e altura acima do piso.
function Room:at(x: number, z: number, yawDegrees: number?, y: number?): CFrame
	return self.cf * CFrame.new(x, y or 0, z) * CFrame.Angles(0, math.rad(yawDegrees or 0), 0)
end

local function overlaps(ax, az, ahx, ahz, b): boolean
	return math.abs(ax - b.cx) < ahx + b.hx and math.abs(az - b.cz) < ahz + b.hz
end

function Room:isFree(cx: number, cz: number, hx: number, hz: number): boolean
	if math.abs(cx) + hx > self.w / 2 + 0.01 or math.abs(cz) + hz > self.d / 2 + 0.01 then
		return false
	end
	for _, rect in self.occupied do
		if overlaps(cx, cz, hx, hz, rect) then
			return false
		end
	end
	for _, zone in self.doorZones do
		if overlaps(cx, cz, hx, hz, zone) then
			return false
		end
	end
	return true
end

function Room:occupy(cx: number, cz: number, hx: number, hz: number)
	table.insert(self.occupied, { cx = cx, cz = cz, hx = hx, hz = hz })
end

-- Reserva uma área dada em coordenadas do mundo (ex.: escadas).
function Room:reserveWorld(x0: number, x1: number, z0: number, z1: number)
	local a = self.cf:PointToObjectSpace(Vector3.new(x0, self.floorY, z0))
	local b = self.cf:PointToObjectSpace(Vector3.new(x1, self.floorY, z1))
	self:occupy((a.X + b.X) / 2, (a.Z + b.Z) / 2, math.abs(a.X - b.X) / 2, math.abs(a.Z - b.Z) / 2)
end

local function halfExtents(yaw: number, sx: number, sz: number): (number, number)
	local quarter = math.abs(yaw) % 180
	if quarter == 90 then
		return sz / 2, sx / 2
	end
	return sx / 2, sz / 2
end

-- Coloca um objeto de pegada sx (largura) x sz (profundidade) em (x, z) com giro yaw.
function Room:place(x: number, z: number, yaw: number, sx: number, sz: number, builder: (CFrame) -> ()): boolean
	local hx, hz = halfExtents(yaw, sx, sz)
	if not self:isFree(x, z, hx, hz) then
		return false
	end
	self:occupy(x, z, hx, hz)
	builder(self:at(x, z, yaw))
	return true
end

-- Posição de um objeto encostado numa parede (costas do objeto na parede).
function Room:wallPose(wall: string, along: number, sx: number, sz: number, gap: number?): (number, number, number)
	local g = gap or 0.1
	if wall == "back" then
		return along, self.d / 2 - sz / 2 - g, 0
	elseif wall == "front" then
		return along, -self.d / 2 + sz / 2 + g, 180
	elseif wall == "left" then
		return -self.w / 2 + sz / 2 + g, along, -90
	end
	return self.w / 2 - sz / 2 - g, along, 90
end

function Room:wallLength(wall: string): number
	if wall == "front" or wall == "back" then
		return self.w
	end
	return self.d
end

-- Encosta um objeto na parede. `height` evita cobrir janelas (objetos mais altos que o peitoril).
function Room:against(
	wall: string,
	along: number,
	sx: number,
	sz: number,
	builder: (CFrame) -> (),
	height: number?
): boolean
	if math.abs(along) + sx / 2 > self:wallLength(wall) / 2 + 0.01 then
		return false
	end
	if height then
		for _, o in self.openings do
			if o.wall == wall and o.kind == "window" and o.bottom < height and o.top > 0 then
				if math.abs(o.along - along) < (o.width / 2 + sx / 2 + 0.2) then
					return false
				end
			end
		end
	end
	local x, z, yaw = self:wallPose(wall, along, sx, sz)
	return self:place(x, z, yaw, sx, sz, builder)
end

-- Tenta várias combinações (parede, posição) em ordem até uma dar certo.
function Room:tryAgainst(
	walls: { string },
	alongs: { number },
	sx: number,
	sz: number,
	builder: (CFrame) -> (),
	height: number?
): boolean
	for _, wall in walls do
		for _, along in alongs do
			if self:against(wall, along, sx, sz, builder, height) then
				return true
			end
		end
	end
	return false
end

-- Objeto preso na parede (quadros, troféus). `y` = altura do centro acima do piso.
function Room:wallItem(wall: string, along: number, y: number, w: number, h: number, builder: (CFrame) -> ()): boolean
	if math.abs(along) + w / 2 > self:wallLength(wall) / 2 - 0.3 then
		return false
	end
	for _, o in self.openings do
		if o.wall == wall and math.abs(o.along - along) < o.width / 2 + w / 2 + 0.4 then
			if y - h / 2 < o.top + 0.4 and y + h / 2 > o.bottom - 0.4 then
				return false
			end
		end
	end
	local cf
	if wall == "back" then
		cf = self:at(along, self.d / 2, 0, y)
	elseif wall == "front" then
		cf = self:at(along, -self.d / 2, 180, y)
	elseif wall == "left" then
		cf = self:at(-self.w / 2, along, -90, y)
	else
		cf = self:at(self.w / 2, along, 90, y)
	end
	builder(cf)
	return true
end

-- Ponto livre aleatório no piso (ou nil).
function Room:spot(hx: number, hz: number, margin: number?): (number?, number?)
	local m = margin or 1
	local rangeX = self.w / 2 - hx - m
	local rangeZ = self.d / 2 - hz - m
	if rangeX <= 0 or rangeZ <= 0 then
		return nil, nil
	end
	for _ = 1, 40 do
		local x = self.rng:NextNumber(-rangeX, rangeX)
		local z = self.rng:NextNumber(-rangeZ, rangeZ)
		if self:isFree(x, z, hx, hz) then
			return x, z
		end
	end
	return nil, nil
end

-- Lustre no teto (local x, z).
function Room:chandelier(x: number, z: number, range: number, shadows: boolean?, diameter: number?, drop: number?)
	return Furniture.Chandelier(
		self.ctx,
		self.model,
		self:at(x, z, 0, self.h).Position,
		drop or 3,
		diameter or 3,
		range,
		shadows,
		nil
	)
end

-- Quadros em paredes aleatórias.
function Room:paintings(count: number, y: number?)
	local walls = { "back", "left", "right", "front" }
	local placed = 0
	for _ = 1, count * 6 do
		if placed >= count then
			break
		end
		local wall = walls[self.rng:NextInteger(1, #walls)]
		local length = self:wallLength(wall)
		local w = self.rng:NextNumber(3, 5.5)
		local h = self.rng:NextNumber(3, 4.5)
		local along = self.rng:NextNumber(-length / 2 + w, length / 2 - w)
		if
			self:wallItem(wall, along, y or 8, w, h, function(cf)
				Furniture.Painting(self.ctx, self.model, cf, w, h, self.rng)
			end)
		then
			placed += 1
		end
	end
end

-- Pontos de arma em lugares livres do piso.
function Room:weapons(count: number)
	for _ = 1, count do
		local x, z = self:spot(1.5, 1.5, 1.5)
		if x then
			self:occupy(x, z, 1.5, 1.5)
			Kit.weaponSpawn(self.ctx, self:at(x, z, 0, 1.5).Position, self.name)
		end
	end
end

-- Tapete centralizado (não ocupa espaço).
function Room:rug(x: number, z: number, w: number, d: number, color: Color3, border: Color3?)
	Furniture.Rug(self.ctx, self.model, self:at(x, z), w, d, color, border)
end

-- Conjunto de mesa com cadeiras ao redor (pegada inclui as cadeiras).
local function diningSet(
	room,
	x: number,
	z: number,
	yaw: number,
	tableW: number,
	tableD: number,
	chairsPerSide: number,
	wood: Color3,
	seat: Color3,
	withEnds: boolean?
)
	local footprintW = tableW + (withEnds and 4.4 or 0.4)
	local footprintD = tableD + 4.6
	return room:place(x, z, yaw, footprintW, footprintD, function(cf)
		Furniture.Table(room.ctx, room.model, cf, tableW, tableD, 3.2, wood)
		for i = 1, chairsPerSide do
			local cx = -tableW / 2 + (i - 0.5) * (tableW / chairsPerSide)
			Furniture.Chair(room.ctx, room.model, cf * CFrame.new(cx, 0, tableD / 2 + 1.1), wood, seat)
			Furniture.Chair(
				room.ctx,
				room.model,
				cf * CFrame.new(cx, 0, -tableD / 2 - 1.1) * CFrame.Angles(0, math.pi, 0),
				wood,
				seat
			)
		end
		if withEnds then
			Furniture.Chair(
				room.ctx,
				room.model,
				cf * CFrame.new(tableW / 2 + 1.1, 0, 0) * CFrame.Angles(0, math.rad(90), 0),
				wood,
				seat
			)
			Furniture.Chair(
				room.ctx,
				room.model,
				cf * CFrame.new(-tableW / 2 - 1.1, 0, 0) * CFrame.Angles(0, math.rad(-90), 0),
				wood,
				seat
			)
		end
	end)
end

-- Cama encostada numa parede livre, com criados-mudos dos lados.
local function bedSet(room, bedW: number, bedL: number, frame: Color3, sheet: Color3, lit: boolean)
	local candidates = {}
	local side = room.w / 2 - bedW / 2 - 0.6
	for _, wall in { "back", "left", "right", "front" } do
		table.insert(candidates, { wall, 0 })
		table.insert(candidates, { wall, side })
		table.insert(candidates, { wall, -side })
	end
	for _, candidate in candidates do
		local wall, along = candidate[1], candidate[2]
		if
			room:against(wall, along, bedW, bedL, function(cf)
				Furniture.Bed(room.ctx, room.model, cf, bedW, bedL, frame, sheet)
			end)
		then
			for index, offset in { bedW / 2 + 1.2, -(bedW / 2 + 1.2) } do
				room:against(wall, along + offset, 2, 1.8, function(cf)
					Furniture.Nightstand(room.ctx, room.model, cf, frame, true, lit and index == 1)
				end)
			end
			return true
		end
	end
	return false
end

-- Mobília por tipo ----------------------------------------------------------------------------

local FURNISH = {}

FURNISH.Hall = function(room)
	local ctx, model, rng = room.ctx, room.model, room.rng
	room:rug(4, 0, 14, 18, Palette.Fabrics[1], Palette.Gold)
	room:chandelier(4, 0, 42, true, 5, 9)
	room:against("back", 9.5, 2.2, 2.2, function(cf)
		Furniture.Statue(ctx, model, cf)
	end)
	-- Longe das folhas da porta de entrada (encostadas na fachada até x = ±8).
	room:against("back", 12, 1.6, 1.6, function(cf)
		Furniture.PottedPlant(ctx, model, cf, 2.4, rng)
	end)
	room:against("right", 8.5, 2, 1.4, function(cf)
		Furniture.Clock(ctx, model, cf)
	end)
	room:against("right", -8.5, 5, 1.8, function(cf)
		Furniture.Table(ctx, model, cf, 5, 1.6, 3, Palette.WoodDark)
		Furniture.Vase(ctx, model, cf * CFrame.new(0, 3, 0), 1.6, Palette.TilesBlue, rng)
	end)
	room:wallItem("left", 2, 21, 9, 7, function(cf)
		Furniture.Painting(ctx, model, cf, 9, 7, rng)
	end)
	room:wallItem("right", 0, 21, 8, 6, function(cf)
		Furniture.Painting(ctx, model, cf, 8, 6, rng)
	end)
	room:wallItem("right", 0, 13, 2.2, 3, function(cf)
		Furniture.Mask(ctx, model, cf, rng)
	end)
end

FURNISH.Library = function(room)
	local ctx, model, rng = room.ctx, room.model, room.rng
	local function shelf(height)
		return function(cf)
			Furniture.Bookshelf(ctx, model, cf, 8, height, 1.6, rng)
		end
	end
	-- Estantes no térreo (embaixo do mezanino a altura é limitada).
	for _, along in { -8.5, 8.5 } do
		room:against("left", along, 8, 1.6, shelf(11), 11)
		room:against("right", along, 8, 1.6, shelf(11), 11)
	end
	room:against("back", 0, 12, 1.6, function(cf)
		Furniture.Bookshelf(ctx, model, cf, 12, 12, 1.6, rng)
	end, 12)
	room:against("front", 0, 12, 1.6, function(cf)
		Furniture.Bookshelf(ctx, model, cf, 12, 11, 1.6, rng)
	end, 11)
	for _, along in { -23.5, 23.5 } do
		room:against("back", along, 6, 1.6, function(cf)
			Furniture.Bookshelf(ctx, model, cf, 6, 12, 1.6, rng)
		end, 12)
		room:against("front", along, 6, 1.6, function(cf)
			Furniture.Bookshelf(ctx, model, cf, 6, 11, 1.6, rng)
		end, 11)
	end
	room:rug(0, 3, 30, 12, Palette.Fabrics[2], Palette.Gold)
	for _, x in { -9, 9 } do
		diningSet(room, x, 3.5, 0, 8, 3.6, 2, Palette.WoodDark, Palette.Fabrics[1])
	end
	room:place(0, 9, 0, 3, 3, function(cf)
		Furniture.Globe(ctx, model, cf, 2.6)
	end)
	for _, x in { -16, 16 } do
		room:place(x, 7, 0, 1.6, 1.6, function(cf)
			Furniture.FloorLamp(ctx, model, cf, false)
		end)
	end
	room:chandelier(0, 3, 46, true, 5, 10)
	-- Livros soltos em cima das mesas de leitura.
	Furniture.Book(ctx, model, room:at(-9.5, 3.5, 20, 3.2), rng)
	Furniture.Book(ctx, model, room:at(8.6, 3.2, -35, 3.2), rng)
	-- Mezanino (2º andar): estantes encostadas na parede do corredor e um ponto de arma.
	local mezzanineFront = -room.d / 2
	for _, along in { -23.5, -4.5, 4.5, 13.5, 22.5 } do
		Furniture.Bookshelf(ctx, model, room:at(along, mezzanineFront + 0.85, 180, 16), 8, 10, 1.6, rng)
	end
	Kit.weaponSpawn(ctx, room:at(0, mezzanineFront + 4.5, 0, 17.5).Position, room.name)
	room:paintings(2, 22)
end

FURNISH.Study = function(room)
	local ctx, model, rng = room.ctx, room.model, room.rng
	room:rug(0, 2, 12, 10, Palette.Fabrics[5], Palette.Gold)
	room:place(0, 4, 180, 5.4, 6, function(cf)
		Furniture.Desk(ctx, model, cf, Palette.WoodRed, rng)
		Furniture.Chair(
			ctx,
			model,
			cf * CFrame.new(0, 0, -2.4) * CFrame.Angles(0, math.pi, 0),
			Palette.WoodRed,
			Palette.Leather
		)
		Furniture.Candle(ctx, model, cf * CFrame.new(-2, 3.1, 0.6))
		Furniture.Globe(ctx, model, cf * CFrame.new(2.5, 0, 4.2), 1.6)
	end)
	room:tryAgainst({ "left", "right", "back" }, { -8.5, 8.5 }, 8, 1.6, function(cf)
		Furniture.Bookshelf(ctx, model, cf, 8, 11, 1.6, rng)
	end, 11)
	room:tryAgainst({ "right", "left", "back" }, { 8.5, -8.5 }, 8, 1.6, function(cf)
		Furniture.Bookshelf(ctx, model, cf, 8, 11, 1.6, rng)
	end, 11)
	room:tryAgainst({ "front", "back" }, { -9, 9 }, 3, 2.4, function(cf)
		Kit.box(
			ctx,
			model,
			"Cofre",
			cf * CFrame.new(0, 1.5, 0),
			Vector3.new(3, 3, 2.4),
			Palette.Iron,
			M.DiamondPlate,
			Kit.D
		)
	end)
	room:tryAgainst({ "front", "left" }, { 9, -9, 6 }, 3, 3, function(cf)
		Furniture.Armchair(ctx, model, cf, Palette.Leather)
	end)
	room:tryAgainst({ "back", "front" }, { -10, 10 }, 1.6, 1.6, function(cf)
		Furniture.FloorLamp(ctx, model, cf, true)
	end)
	room:paintings(2)
end

FURNISH.Living = function(room)
	local ctx, model, rng = room.ctx, room.model, room.rng
	local fabric = Palette.pick(Palette.Fabrics, rng)
	local placedFire = room:tryAgainst({ "back", "left", "right" }, { 8.5, -8.5 }, 7.5, 2.4, function(cf)
		Furniture.Fireplace(ctx, model, cf, 7, room.h, true, true)
	end)
	room:rug(0, 2, 14, 11, Palette.Fabrics[1], Palette.Gold)
	room:place(0, 1.5, 180, 9, 3.4, function(cf)
		Furniture.Sofa(ctx, model, cf, 9, fabric)
	end)
	room:place(0, 5.5, 0, 4, 2.4, function(cf)
		Furniture.Table(ctx, model, cf, 4, 2.2, 1.6, Palette.WoodDark)
		Furniture.Vase(ctx, model, cf * CFrame.new(1, 1.6, 0), 1.2, Palette.Terracotta, rng)
	end)
	for _, x in { -7, 7 } do
		room:place(x, 6, x < 0 and 90 or -90, 3, 3, function(cf)
			Furniture.Armchair(ctx, model, cf, fabric)
		end)
	end
	room:tryAgainst({ "left", "right", "front" }, { -9, 9 }, 8, 1.6, function(cf)
		Furniture.Bookshelf(ctx, model, cf, 8, 10, 1.6, rng)
	end, 10)
	room:tryAgainst({ "front", "back" }, { -10.5, 10.5 }, 1.6, 1.6, function(cf)
		Furniture.FloorLamp(ctx, model, cf, not placedFire)
	end)
	room:tryAgainst({ "front", "right" }, { 10.5, -10.5 }, 1.6, 1.6, function(cf)
		Furniture.PottedPlant(ctx, model, cf, 2.2, rng)
	end)
	room:paintings(3)
end

FURNISH.Music = function(room)
	local ctx, model = room.ctx, room.model
	room:rug(-2, 2, 12, 12, Palette.Fabrics[2], Palette.Gold)
	room:place(-3, 3, 30, 7, 9, function(cf)
		Furniture.GrandPiano(ctx, model, cf)
	end)
	for i, x in { 5, 8 } do
		room:place(x, -2 + i * 2, 200, 1.5, 1.5, function(cf)
			Furniture.MusicStand(ctx, model, cf)
		end)
		room:place(x + 0.5, i * 2 + 0.5, 20, 2.2, 2.2, function(cf)
			Furniture.Chair(ctx, model, cf, Palette.WoodDark, Palette.Fabrics[1])
		end)
	end
	-- Tambores da selva: o tema do jogo.
	for i, along in { -9, -6.5, 8 } do
		room:tryAgainst({ "back", "left", "right" }, { along }, 2.4, 2.4, function(cf)
			Furniture.Drum(ctx, model, cf, 1.6 + i * 0.3, 2 + i * 0.4)
		end)
	end
	room:tryAgainst({ "left", "right", "front" }, { 9, -9 }, 2, 2, function(cf)
		Furniture.Table(ctx, model, cf, 2, 2, 2.6, Palette.WoodDark)
		Furniture.Gramophone(ctx, model, cf * CFrame.new(0, 2.6, 0))
	end)
	room:tryAgainst({ "front", "back" }, { -10, 10 }, 1.6, 1.6, function(cf)
		Furniture.FloorLamp(ctx, model, cf, true)
	end)
	room:paintings(2)
end

FURNISH.WinterGarden = function(room)
	local ctx, model, rng = room.ctx, room.model, room.rng
	-- Muitas plantas em vasos e duas palmeiras pequenas.
	for _, spot in { { -9, 9 }, { 9, 9 }, { -9, -2 } } do
		room:place(spot[1], spot[2], 0, 3, 3, function(cf)
			Kit.cylinder(
				ctx,
				model,
				"Vaso",
				(cf * CFrame.new(0, 1, 0)).Position,
				2,
				2.6,
				Palette.Terracotta,
				M.Slate,
				Kit.L
			)
			Plants.Palm(ctx, model, (cf * CFrame.new(0, 2, 0)).Position, rng:NextNumber(6, 8), rng, false)
		end)
	end
	for _ = 1, 7 do
		local x, z = room:spot(1, 1, 0.5)
		if x then
			room:place(x, z, 0, 2, 2, function(cf)
				Furniture.PottedPlant(ctx, model, cf, rng:NextNumber(1.6, 2.6), rng)
			end)
		end
	end
	room:place(2, 3, 0, 7, 7, function(cf)
		Furniture.SideTable(ctx, model, cf * CFrame.new(0, 0, 0), 3, 2.8, Palette.White)
		Furniture.Vase(ctx, model, cf * CFrame.new(0, 2.8, 0), 1, Palette.TilesBlue, rng)
		Furniture.Chair(ctx, model, cf * CFrame.new(0, 0, 2.4), Palette.WoodLight, Palette.Fabrics[3])
		Furniture.Chair(
			ctx,
			model,
			cf * CFrame.new(0, 0, -2.4) * CFrame.Angles(0, math.pi, 0),
			Palette.WoodLight,
			Palette.Fabrics[3]
		)
	end)
	room:place(-3, -7, 0, 2, 2, function(cf)
		Plants.Fern(ctx, model, cf.Position, 2.5, rng)
	end)
	local light = Kit.box(
		ctx,
		model,
		"Lampiao",
		room:at(0, 0, 0, room.h - 2).Position,
		Vector3.new(1, 1.4, 1),
		Palette.LightWarm,
		M.Neon,
		nil,
		{ Ghost = true }
	)
	Kit.light(light, Palette.LightWarm, 22, 0.8)
end

FURNISH.Cellar = function(room)
	local ctx, model, rng = room.ctx, room.model, room.rng
	-- Barris deitados em suportes, encostados nas paredes.
	for _, wall in { "left", "right" } do
		for _, along in { -8, 0, 8 } do
			room:against(wall, along, 4, 3.4, function(cf)
				Kit.box(
					ctx,
					model,
					"Suporte",
					cf * CFrame.new(0, 0.5, 0),
					Vector3.new(4, 1, 3),
					Palette.WoodDark,
					M.Wood,
					Kit.D
				)
				Furniture.Barrel(ctx, model, cf * CFrame.new(0, 1, 0) * CFrame.Angles(0, math.rad(90), 0), 3.6, 3, true)
			end)
		end
	end
	room:tryAgainst({ "back", "front" }, { -8, 8 }, 8, 1.6, function(cf)
		Furniture.Bookshelf(ctx, model, cf, 8, 9, 1.6, rng, "bottles", Palette.WoodDark)
	end, 9)
	room:tryAgainst({ "back", "front" }, { 8, -8 }, 8, 1.6, function(cf)
		Furniture.Bookshelf(ctx, model, cf, 8, 9, 1.6, rng, "bottles", Palette.WoodDark)
	end, 9)
	room:place(0, 0, 0, 5, 5, function(cf)
		Furniture.Barrel(ctx, model, cf, 3.2, 3.4, false)
		Furniture.Bottle(ctx, model, cf * CFrame.new(0.4, 3.2, 0.2))
		Furniture.Bottle(ctx, model, cf * CFrame.new(-0.6, 3.2, -0.3), Color3.fromRGB(90, 20, 30))
	end)
	for _ = 1, 3 do
		local x, z = room:spot(1.4, 1.4, 0.5)
		if x then
			room:place(x, z, rng:NextNumber(0, 90), 2.6, 2.6, function(cf)
				Furniture.Crate(ctx, model, cf, Vector3.new(2.4, 2, 2.4))
			end)
		end
	end
	room:chandelier(0, 0, 18, false, 1.6, 2)
end

FURNISH.Trophy = function(room)
	local ctx, model, rng = room.ctx, room.model, room.rng
	room:place(0, 1, 0, 4.5, 7, function(cf)
		Furniture.SkinRug(ctx, model, cf)
	end)
	local heads = 0
	for _, wall in { "left", "right", "back", "front" } do
		for _, along in { -7, 7 } do
			if
				heads < 5
				and room:wallItem(wall, along, 10, 2.4, 3, function(cf)
					Furniture.TrophyHead(ctx, model, cf, rng)
				end)
			then
				heads += 1
			end
		end
	end
	room:wallItem("back", 0, 10, 4, 6, function(cf)
		Furniture.WallWeapons(ctx, model, cf)
	end)
	room:wallItem("front", 0, 12, 4, 6, function(cf)
		Furniture.WallWeapons(ctx, model, cf)
	end)
	for _, spot in { { -8, 8, 135 }, { 8, 8, -135 } } do
		room:place(spot[1], spot[2], spot[3], 3.2, 3.2, function(cf)
			Furniture.Armchair(ctx, model, cf, Palette.Leather)
		end)
	end
	room:place(0, 9, 0, 2, 2, function(cf)
		Furniture.SideTable(ctx, model, cf, 2, 2.6, Palette.WoodDark)
	end)
	room:tryAgainst({ "left", "right" }, { 8, -8 }, 3, 3, function(cf)
		Furniture.DisplayCase(ctx, model, cf, rng)
	end, 7)
	room:chandelier(0, 0, 24, false, 2.6, 3)
end

FURNISH.Billiards = function(room)
	local ctx, model, rng = room.ctx, room.model, room.rng
	room:place(0, 0, 90, 10, 7, function(cf)
		Furniture.BilliardTable(ctx, model, cf, rng)
	end)
	-- Luminária retangular sobre a mesa.
	local lamp = Kit.box(
		ctx,
		model,
		"Luminaria",
		room:at(0, 0, 0, room.h - 4).Position,
		Vector3.new(2, 0.8, 6),
		Palette.Felt,
		M.Metal,
		nil,
		{ Ghost = true }
	)
	Kit.light(lamp, Palette.LightWarm, 24, 1.1)
	Kit.cylinder(
		ctx,
		model,
		"Corrente",
		room:at(0, 0, 0, room.h - 1.8).Position,
		3.6,
		0.2,
		Palette.Iron,
		M.Metal,
		nil,
		{ Ghost = true }
	)
	room:tryAgainst({ "back", "front", "left" }, { 8, -8 }, 8, 2.4, function(cf)
		Furniture.Counter(ctx, model, cf, 8, Palette.WoodRed, Palette.MarbleDark)
		for i = -2, 2 do
			Furniture.Bottle(
				ctx,
				model,
				cf * CFrame.new(i * 1.3, 3.3, 0.3),
				Palette.pick(
					{ Color3.fromRGB(40, 80, 40), Color3.fromRGB(90, 20, 30), Color3.fromRGB(150, 110, 40) },
					rng
				)
			)
		end
	end, 3.5)
	for _ = 1, 2 do
		local x, z = room:spot(1, 1, 1)
		if x then
			room:place(x, z, 0, 1.8, 1.8, function(cf)
				Furniture.Stool(ctx, model, cf, Palette.WoodRed, 2.6)
			end)
		end
	end
	-- Suporte de tacos na parede (LooseProp).
	room:wallItem("left", 0, 8, 1.6, 6, function(cf)
		local rack = Kit.box(
			ctx,
			model,
			"SuporteDeTacos",
			cf * CFrame.new(0, -2.6, -0.15),
			Vector3.new(1.6, 0.4, 0.3),
			Palette.WoodDark,
			M.Wood,
			Kit.L,
			{ NoShadow = true }
		)
		local cues = {}
		for i = -1, 1 do
			table.insert(
				cues,
				Kit.box(
					ctx,
					model,
					"Taco",
					cf * CFrame.new(i * 0.4, 0, -0.3),
					Vector3.new(0.2, 6, 0.2),
					Palette.WoodLight,
					M.Wood,
					nil,
					{ Ghost = true }
				)
			)
		end
		Kit.weldTo(rack, cues)
	end)
	room:tryAgainst({ "right", "left" }, { -8, 8 }, 3, 3, function(cf)
		Furniture.Armchair(ctx, model, cf, Palette.Fabrics[3])
	end)
	room:paintings(2)
end

FURNISH.Dining = function(room)
	local ctx, model, rng = room.ctx, room.model, room.rng
	room:rug(0, 0, 30, 12, Palette.Fabrics[1], Palette.Gold)
	diningSet(room, 0, 0, 0, 22, 4.5, 5, Palette.WoodRed, Palette.Fabrics[1], true)
	for _, x in { -6, 0, 6 } do
		Furniture.Candle(ctx, model, room:at(x, 0, 0, 3.2))
	end
	for i = -1, 1 do
		Kit.cylinder(
			ctx,
			model,
			"Prato",
			room:at(i * 7 + 2, 1.2, 0, 3.25).Position,
			0.1,
			1.4,
			Palette.White,
			M.SmoothPlastic,
			Kit.L
		)
	end
	room:chandelier(-9, 0, 30, false, 3, 3)
	room:chandelier(9, 0, 0, false, 3, 3)
	for _, along in { -20, 20, -6, 6 } do
		room:tryAgainst({ "back", "front" }, { along }, 7, 2.4, function(cf)
			Furniture.Counter(ctx, model, cf, 7, Palette.WoodRed, Palette.WoodDark)
			Furniture.Vase(ctx, model, cf * CFrame.new(0, 3.3, 0), 1.4, Palette.Marble, rng)
		end, 3.5)
	end
	room:tryAgainst({ "left", "right" }, { 8, -8 }, 2, 1.4, function(cf)
		Furniture.Clock(ctx, model, cf)
	end)
	room:paintings(4)
end

FURNISH.Pantry = function(room)
	local ctx, model, rng = room.ctx, room.model, room.rng
	for _, wall in { "left", "right", "back", "front" } do
		for _, along in { -8, 8 } do
			room:against(wall, along, 7, 1.6, function(cf)
				Furniture.Bookshelf(
					ctx,
					model,
					cf,
					7,
					9,
					1.6,
					rng,
					rng:NextNumber() < 0.5 and "jars" or "boxes",
					Palette.WoodLight
				)
			end, 9)
		end
	end
	for _ = 1, 4 do
		local x, z = room:spot(1, 1, 0.5)
		if x then
			room:place(x, z, 0, 2, 2, function(cf)
				Furniture.Sack(ctx, model, cf, rng)
			end)
		end
	end
	for _ = 1, 2 do
		local x, z = room:spot(1.5, 1.5, 0.5)
		if x then
			room:place(x, z, 0, 3, 3, function(cf)
				Furniture.Barrel(ctx, model, cf, 3, 2.6, false)
			end)
		end
	end
	room:chandelier(0, 0, 18, false, 1.4, 2)
end

FURNISH.Ballroom = function(room)
	local ctx, model, rng = room.ctx, room.model, room.rng
	room:rug(0, 0, 40, 12, Palette.Fabrics[5], Palette.Gold)
	room:chandelier(-20, 0, 48, true, 6, 4)
	room:chandelier(20, 0, 0, false, 6, 4)
	-- Espelhos e cadeiras ao longo das paredes.
	for _, along in { -36, -20, -4, 12, 28 } do
		room:wallItem("back", along, 7, 4, 7, function(cf)
			Kit.box(
				ctx,
				model,
				"Espelho",
				cf * CFrame.new(0, 0, -0.15),
				Vector3.new(4, 7, 0.2),
				Palette.Glass,
				M.Glass,
				Kit.D,
				{ Reflectance = 0.6 }
			)
		end)
	end
	for _, wall in { "back", "front" } do
		for along = -36, 36, 12 do
			room:against(wall, along, 2.2, 2.2, function(cf)
				Furniture.Chair(ctx, model, cf, Palette.Gold, Palette.Fabrics[5])
			end)
		end
	end
	room:tryAgainst({ "left", "right" }, { 6, -6 }, 7, 9, function(cf)
		Furniture.GrandPiano(ctx, model, cf * CFrame.Angles(0, math.pi, 0))
	end)
	room:tryAgainst({ "right", "left" }, { -6, 6 }, 2.2, 2.2, function(cf)
		Furniture.Statue(ctx, model, cf)
	end)
	room:tryAgainst({ "right", "left" }, { 6, -6 }, 2, 2, function(cf)
		Furniture.Table(ctx, model, cf, 2, 2, 2.6, Palette.WoodDark)
		Furniture.Gramophone(ctx, model, cf * CFrame.new(0, 2.6, 0))
	end)
	for _, along in { -11, 11 } do
		room:tryAgainst({ "left", "right" }, { along }, 1.8, 1.8, function(cf)
			Furniture.PottedPlant(ctx, model, cf, 2.6, rng)
		end)
	end
end

FURNISH.BackStairs = function(room)
	local ctx, model, rng = room.ctx, room.model, room.rng
	-- A escada ocupa a faixa reservada pela Mansion; o resto vira um vestíbulo de serviço.
	room:tryAgainst({ "right", "left" }, { -6, 6, 0 }, 1.6, 1.6, function(cf)
		local base = Kit.cylinder(
			ctx,
			model,
			"Cabideiro",
			(cf * CFrame.new(0, 0.15, 0)).Position,
			0.3,
			1.4,
			Palette.WoodDark,
			M.Wood,
			Kit.L
		)
		local pole =
			Kit.cylinder(ctx, model, "Haste", (cf * CFrame.new(0, 3.2, 0)).Position, 6, 0.3, Palette.WoodDark, M.Wood)
		local coat = Kit.box(
			ctx,
			model,
			"Casaco",
			cf * CFrame.new(0, 4.6, -0.3),
			Vector3.new(1.4, 2.6, 0.5),
			Palette.Fabrics[4],
			M.Fabric
		)
		Kit.weldTo(base, { pole, coat })
	end)
	room:tryAgainst({ "right", "left", "back" }, { 6, -6, 0 }, 5, 1.8, function(cf)
		Furniture.Bench(ctx, model, cf, 5, Palette.Wood)
	end)
	room:tryAgainst({ "back", "front" }, { 9, -9 }, 3.4, 2.2, function(cf)
		Furniture.Chest(ctx, model, cf)
	end)
	for _ = 1, 2 do
		local x, z = room:spot(1, 1, 0.5)
		if x then
			room:place(x, z, 0, 2.4, 2.4, function(cf)
				Furniture.Crate(ctx, model, cf, Vector3.new(2, 1.6, 2))
			end)
		end
	end
	-- Patamar do 2º andar (faixa leste da célula, acima do vestíbulo).
	local landing = room:at(-4.5, 0, 0, 16)
	Furniture.PottedPlant(ctx, model, landing * CFrame.new(-6, 0, 10), 2.4, rng)
	Kit.weaponSpawn(ctx, (landing * CFrame.new(-2, 1.5, -2)).Position, room.name)
	room:chandelier(2, 0, 30, false, 2, 4)
end

FURNISH.Kitchen = function(room)
	local ctx, model, rng = room.ctx, room.model, room.rng
	local placedStove = false
	for _, along in { -22, -14, -6, 6, 14, 22 } do
		if not placedStove and math.abs(along) == 6 then
			placedStove = room:against("back", along, 4.2, 2.6, function(cf)
				Furniture.Stove(ctx, model, cf, room.h)
			end)
			if placedStove then
				continue
			end
		end
		room:against("back", along, 7, 2.4, function(cf)
			Furniture.Counter(ctx, model, cf, 7)
			Furniture.Vase(ctx, model, cf * CFrame.new(rng:NextNumber(-2, 2), 3.3, 0), 1, Palette.Steel)
		end, 3.4)
	end
	room:tryAgainst({ "left", "right" }, { 8, -8 }, 3, 2.6, function(cf)
		Furniture.Icebox(ctx, model, cf)
	end)
	room:tryAgainst({ "front" }, { -20, 20, -6, 6 }, 4, 2.4, function(cf)
		Furniture.Counter(ctx, model, cf, 4, Palette.White, Palette.Marble)
		Kit.box(
			ctx,
			model,
			"Cuba",
			cf * CFrame.new(0, 3.32, 0),
			Vector3.new(2.4, 0.06, 1.4),
			Palette.Steel,
			M.Metal,
			nil,
			{ Ghost = true }
		)
	end, 3.4)
	room:place(0, 2, 0, 12, 5, function(cf)
		Furniture.Table(ctx, model, cf, 12, 4, 3.2, Palette.WoodLight, M.WoodPlanks)
		Kit.cylinder(
			ctx,
			model,
			"Panela",
			(cf * CFrame.new(-3, 3.8, 0)).Position,
			1.2,
			1.6,
			Palette.Steel,
			M.Metal,
			Kit.L
		)
		Kit.box(
			ctx,
			model,
			"TabuaDeCarne",
			cf * CFrame.new(2, 3.3, 0.5),
			Vector3.new(2.4, 0.2, 1.6),
			Palette.WoodLight,
			M.Wood,
			Kit.L
		)
		Kit.ball(
			ctx,
			model,
			"Repolho",
			(cf * CFrame.new(4, 3.9, -0.6)).Position,
			1.2,
			Palette.Leaves[3],
			M.Grass,
			Kit.L
		)
	end)
	for _ = 1, 3 do
		local x, z = room:spot(1, 1, 0.5)
		if x then
			room:place(x, z, 0, 2, 2, function(cf)
				Furniture.Sack(ctx, model, cf, rng)
			end)
		end
	end
	room:chandelier(-12, 2, 30, false, 2, 3)
end

FURNISH.Laundry = function(room)
	local ctx, model, rng = room.ctx, room.model, room.rng
	room:tryAgainst({ "back", "left", "right" }, { -7, 7 }, 3.2, 3.2, function(cf)
		Furniture.Washtub(ctx, model, cf)
	end)
	room:tryAgainst({ "back", "left", "right" }, { 7, -7 }, 3.2, 3.2, function(cf)
		Furniture.Washtub(ctx, model, cf)
	end)
	room:place(0, 3, 0, 12, 2, function(cf)
		Furniture.ClothesLine(ctx, model, cf, 11, rng)
	end)
	room:tryAgainst({ "left", "right", "front" }, { 8, -8 }, 7, 1.6, function(cf)
		Furniture.Bookshelf(ctx, model, cf, 7, 8, 1.6, rng, "boxes", Palette.WoodLight)
	end, 8)
	room:tryAgainst({ "right", "left" }, { -8, 8 }, 5, 1.6, function(cf)
		Furniture.Table(ctx, model, cf, 5, 1.4, 3, Palette.WoodLight)
		Kit.box(
			ctx,
			model,
			"FerroDePassar",
			cf * CFrame.new(1, 3.3, 0),
			Vector3.new(1, 0.6, 0.6),
			Palette.Iron,
			M.Metal,
			Kit.L
		)
	end)
	for _ = 1, 2 do
		local x, z = room:spot(1, 1, 0.5)
		if x then
			room:place(x, z, 0, 2, 2, function(cf)
				Kit.cylinder(
					ctx,
					model,
					"Cesto",
					(cf * CFrame.new(0, 0.9, 0)).Position,
					1.8,
					2,
					Palette.WoodLight,
					M.Fabric,
					Kit.L
				)
			end)
		end
	end
	room:chandelier(0, 0, 20, false, 1.4, 2)
end

FURNISH.Observatory = function(room)
	local ctx, model, rng = room.ctx, room.model, room.rng
	room:rug(0, 0, 13, 13, Palette.Fabrics[2], Palette.Gold)
	-- Telescópio apontado para a janela da fachada (parede "back").
	room:place(0, room.d / 2 - 5, 180, 3, 3, function(cf)
		Furniture.Telescope(ctx, model, cf)
	end)
	room:place(-6, 0, 0, 4, 4, function(cf)
		Furniture.Table(ctx, model, cf, 3.5, 3.5, 3, Palette.WoodDark)
		Furniture.Orrery(ctx, model, cf * CFrame.new(-0.6, 3, 0))
	end)
	room:tryAgainst({ "left", "right", "front" }, { -8.5, 8.5 }, 5.4, 2.6, function(cf)
		Furniture.Desk(ctx, model, cf, Palette.WoodDark, rng)
	end)
	room:tryAgainst({ "front", "right" }, { 9, -9 }, 3, 3, function(cf)
		Furniture.Armchair(ctx, model, cf, Palette.Fabrics[2])
	end)
	room:place(7, -3, 0, 3, 3, function(cf)
		Furniture.Globe(ctx, model, cf, 2)
	end)
	-- Cartas celestes (quadros azul-escuros).
	for _, wall in { "left", "right", "front" } do
		room:wallItem(wall, -7, 8, 4, 4, function(cf)
			local chart = Kit.box(
				ctx,
				model,
				"CartaCeleste",
				cf * CFrame.new(0, 0, -0.1),
				Vector3.new(4, 4, 0.2),
				Palette.Canvas[6],
				M.Fabric,
				Kit.L,
				{ NoShadow = true }
			)
			local star = Kit.ball(
				ctx,
				model,
				"Estrela",
				(cf * CFrame.new(0.8, 0.6, -0.25)).Position,
				0.4,
				Palette.Gold,
				M.Neon,
				nil,
				{ Ghost = true }
			)
			Kit.weldTo(chart, { star })
		end)
	end
	room:chandelier(0, 0, 22, false, 2, 3)
end

FURNISH.Painting = function(room)
	local ctx, model, rng = room.ctx, room.model, room.rng
	room:rug(0, 0, 12, 10, Palette.White)
	for _, spot in { { -5, 2, 20 }, { 1, 5, -10 }, { 6, -1, -40 } } do
		room:place(spot[1], spot[2], spot[3], 3.6, 3, function(cf)
			Furniture.Easel(ctx, model, cf, rng)
		end)
	end
	room:place(-1, -4, 0, 2, 2, function(cf)
		Furniture.Stool(ctx, model, cf, Palette.WoodLight)
	end)
	room:tryAgainst({ "left", "right", "back" }, { 8, -8 }, 6, 2.4, function(cf)
		Furniture.Table(ctx, model, cf, 6, 2.2, 3, Palette.WoodLight)
		for i = -2, 2 do
			Kit.cylinder(
				ctx,
				model,
				"PoteDeTinta",
				(cf * CFrame.new(i * 1.1, 3.4, 0)).Position,
				0.8,
				0.7,
				Palette.Toys[(i + 3) % 4 + 1],
				M.SmoothPlastic,
				Kit.L
			)
		end
	end)
	-- Telas encostadas na parede.
	room:tryAgainst({ "front", "back", "left" }, { -9, 9 }, 4, 1.4, function(cf)
		for i = 0, 2 do
			Kit.box(
				ctx,
				model,
				"TelaEncostada",
				cf * CFrame.new(0, 1.8, 0.2 - i * 0.35) * CFrame.Angles(math.rad(8), 0, 0),
				Vector3.new(3.6 - i * 0.4, 3.4 - i * 0.3, 0.2),
				Palette.pick(Palette.Canvas, rng),
				M.Fabric,
				Kit.L
			)
		end
	end)
	room:paintings(4)
	room:chandelier(0, 0, 22, false, 2, 3)
end

FURNISH.Sewing = function(room)
	local ctx, model, rng = room.ctx, room.model, room.rng
	room:rug(0, 0, 12, 12, Palette.Fabrics[5], Palette.Gold)
	for _, along in { -7, 7 } do
		room:tryAgainst({ "back", "left", "right" }, { along, -along }, 5, 2.6, function(cf)
			Furniture.Table(ctx, model, cf, 5, 2.4, 3, Palette.WoodLight)
			Furniture.SewingMachine(ctx, model, cf * CFrame.new(0, 3, 0))
			Furniture.Chair(
				ctx,
				model,
				cf * CFrame.new(0, 0, -2.2) * CFrame.Angles(0, math.pi, 0),
				Palette.WoodLight,
				Palette.Fabrics[6]
			)
		end)
	end
	for _, spot in { { -5, 2 }, { 5, 2 } } do
		room:place(spot[1], spot[2], 0, 2.2, 2.2, function(cf)
			Furniture.Mannequin(ctx, model, cf, Palette.pick(Palette.Fabrics, rng))
		end)
	end
	room:tryAgainst({ "left", "right", "front" }, { 8.5, -8.5 }, 8, 1.6, function(cf)
		Furniture.Bookshelf(ctx, model, cf, 8, 9, 1.6, rng, "fabric", Palette.WoodLight)
	end, 9)
	for _ = 1, 3 do
		local x, z = room:spot(1, 1, 0.5)
		if x then
			room:place(x, z, 0, 2.2, 2.2, function(cf)
				Kit.cylinderAlong(
					ctx,
					model,
					"RoloDeTecido",
					cf * CFrame.new(0, 0.6, 0),
					2,
					1.2,
					Palette.pick(Palette.Fabrics, rng),
					M.Fabric,
					Kit.L
				)
			end)
		end
	end
	room:chandelier(0, 0, 22, false, 2, 3)
end

FURNISH.Maps = function(room)
	local ctx, model, rng = room.ctx, room.model, room.rng
	room:place(0, 1, 0, 9, 6, function(cf)
		Furniture.Table(ctx, model, cf, 8, 5, 3.2, Palette.WoodDark)
		Kit.box(
			ctx,
			model,
			"Mapa",
			cf * CFrame.new(0, 3.24, 0),
			Vector3.new(6.5, 0.06, 4),
			Palette.Parchment,
			M.Fabric,
			Kit.L
		)
		Furniture.Candle(ctx, model, cf * CFrame.new(3.2, 3.2, 1.8))
	end)
	room:place(-7, 7, 0, 3, 3, function(cf)
		Furniture.Globe(ctx, model, cf, 2.4)
	end)
	room:tryAgainst({ "left", "right", "back" }, { -8.5, 8.5 }, 8, 1.6, function(cf)
		Furniture.Bookshelf(ctx, model, cf, 8, 10, 1.6, rng, "scrolls", Palette.WoodDark)
	end, 10)
	for _, along in { -9, 9 } do
		room:tryAgainst({ "front", "back" }, { along }, 3.4, 2.2, function(cf)
			Furniture.Chest(ctx, model, cf, Palette.WoodRed)
		end)
	end
	-- Mapas antigos nas paredes.
	for _, wall in { "left", "right", "back", "front" } do
		room:wallItem(wall, 7, 8, 5, 4, function(cf)
			local oldMap = Kit.box(
				ctx,
				model,
				"MapaAntigo",
				cf * CFrame.new(0, 0, -0.1),
				Vector3.new(5, 4, 0.15),
				Palette.Parchment,
				M.Fabric,
				Kit.L,
				{ NoShadow = true }
			)
			local island = Kit.box(
				ctx,
				model,
				"Ilha",
				cf * CFrame.new(-0.5, 0.2, -0.2),
				Vector3.new(2, 1.4, 0.05),
				Palette.Leaves[1],
				M.Fabric,
				nil,
				{ Ghost = true }
			)
			Kit.weldTo(oldMap, { island })
		end)
	end
	room:chandelier(0, 1, 22, false, 2, 3)
end

FURNISH.Bathroom = function(room)
	local ctx, model, rng = room.ctx, room.model, room.rng
	-- Piso de ladrilhos por cima da laje.
	Kit.box(
		ctx,
		model,
		"Ladrilhos",
		room:at(0, 0, 0, 0.05),
		Vector3.new(room.w, 0.1, room.d),
		Palette.Tiles,
		M.CeramicTiles,
		nil,
		{ Ghost = true, NoShadow = true }
	)
	room:tryAgainst({ "back", "left", "right", "front" }, { 0, 7, -7 }, 6.2, 3.2, function(cf)
		Furniture.Bathtub(ctx, model, cf)
	end)
	room:tryAgainst({ "left", "right", "back", "front" }, { 8, -8, 0 }, 1.8, 2.4, function(cf)
		Furniture.Toilet(ctx, model, cf)
	end)
	room:tryAgainst({ "right", "left", "back", "front" }, { 8, -8, 0 }, 2.4, 1.8, function(cf)
		Furniture.Sink(ctx, model, cf, 6)
	end)
	room:tryAgainst({ "front", "back", "left" }, { -10, 10 }, 1.6, 1.6, function(cf)
		Furniture.PottedPlant(ctx, model, cf, 2, rng)
	end)
	room:rug(0, 0, 5, 3.5, Palette.pick(Palette.Fabrics, rng))
	room:chandelier(0, 0, 20, false, 1.4, 2)
end

FURNISH.GuestRoom = function(room)
	local ctx, model, rng = room.ctx, room.model, room.rng
	local frame = Palette.pick({ Palette.Wood, Palette.WoodDark, Palette.WoodRed }, rng)
	local sheet = Palette.pick(Palette.Fabrics, rng)
	room:rug(0, 0, 12, 10, Palette.pick(Palette.Fabrics, rng), Palette.Gold)
	bedSet(room, 6, 8.5, frame, sheet, true)
	room:tryAgainst({ "left", "right", "front", "back" }, { 8, -8 }, 5, 2.4, function(cf)
		Furniture.Wardrobe(ctx, model, cf, 5, 8, frame)
	end)
	room:tryAgainst({ "right", "left", "front", "back" }, { -8, 8 }, 4.4, 2, function(cf)
		Furniture.Dresser(ctx, model, cf, 4.4, frame)
	end, 7)
	room:tryAgainst({ "front", "left", "right" }, { 9.5, -9.5 }, 3, 3, function(cf)
		Furniture.Armchair(ctx, model, cf, sheet)
	end)
	room:paintings(2)
end

FURNISH.Gallery = function(room)
	local ctx, model, rng = room.ctx, room.model, room.rng
	room:rug(0, 0, 6, 20, Palette.Fabrics[1], Palette.Gold)
	for _, wall in { "left", "right", "back", "front" } do
		for _, along in { -8, 8 } do
			room:wallItem(wall, along, 7.5, 5, 4.5, function(cf)
				Furniture.Painting(ctx, model, cf, 5, 4.5, rng)
			end)
		end
	end
	for _, spot in { { -6, -5 }, { 6, -5 }, { 0, 6 } } do
		room:place(spot[1], spot[2], 0, 3.4, 3.4, function(cf)
			Furniture.DisplayCase(ctx, model, cf, rng)
		end)
	end
	for _, spot in { { -7, 4 }, { 7, 4 } } do
		room:place(spot[1], spot[2], 0, 2.4, 2.4, function(cf)
			Furniture.Statue(ctx, model, cf, Palette.pick({ Palette.Marble, Palette.Stone }, rng))
		end)
	end
	room:place(0, -1, 90, 5, 2, function(cf)
		Furniture.Bench(ctx, model, cf, 5, Palette.WoodDark)
	end)
	room:chandelier(0, 0, 26, false, 2.4, 3)
end

FURNISH.Kids = function(room)
	local ctx, model, rng = room.ctx, room.model, room.rng
	room:rug(0, 0, 12, 12, Palette.Toys[2], Palette.Toys[3])
	local made = 0
	for _, candidate in
		{ { "back", -7 }, { "back", 7 }, { "left", -7 }, { "left", 7 }, { "right", -7 }, { "right", 7 } }
	do
		if made >= 2 then
			break
		end
		if
			room:against(candidate[1], candidate[2], 4, 6.5, function(cf)
				Furniture.Bed(ctx, model, cf, 4, 6.5, Palette.WoodLight, Palette.Toys[made + 1])
			end)
		then
			made += 1
		end
	end
	room:place(4, -3, 30, 4.2, 4.2, function(cf)
		Furniture.RockingHorse(ctx, model, cf, Palette.Toys[1])
	end)
	room:place(-4, 2, 0, 5, 5, function(cf)
		Furniture.Table(ctx, model, cf, 3, 3, 2.2, Palette.Toys[4])
		Furniture.Stool(ctx, model, cf * CFrame.new(0, 0, 2.2), Palette.Toys[3], 1.6)
		Furniture.Stool(ctx, model, cf * CFrame.new(0, 0, -2.2), Palette.Toys[2], 1.6)
	end)
	room:tryAgainst({ "front", "back", "left" }, { -9, 9 }, 3.4, 2.2, function(cf)
		Furniture.Chest(ctx, model, cf, Palette.Toys[2])
	end)
	for i = 1, 4 do
		local x, z = room:spot(0.6, 0.6, 1)
		if x then
			room:place(x, z, rng:NextNumber(0, 90), 1, 1, function(cf)
				Furniture.Crate(ctx, model, cf, Vector3.new(0.9, 0.9, 0.9), Palette.Toys[i])
			end)
		end
	end
	room:place(2, 4, 0, 2, 2, function(cf)
		Furniture.Drum(ctx, model, cf, 1.4, 1.4, Palette.Toys[1])
	end)
	room:tryAgainst({ "left", "right", "front" }, { 8.5, -8.5 }, 6, 1.6, function(cf)
		Furniture.Bookshelf(ctx, model, cf, 6, 6, 1.6, rng, "books", Palette.WoodLight)
	end, 6)
	room:paintings(2, 7)
	room:chandelier(0, 0, 22, false, 2, 3)
end

FURNISH.MasterBedroom = function(room)
	local ctx, model = room.ctx, room.model
	local frame = Palette.WoodRed
	room:rug(-10, 0, 16, 14, Palette.Fabrics[1], Palette.Gold)
	-- Cama grande na metade "esquerda" do quarto.
	local placedBed = false
	for _, along in { -14, -8, 8, 14 } do
		if not placedBed then
			placedBed = room:against("back", along, 8, 9.5, function(cf)
				Furniture.Bed(ctx, model, cf, 8, 9.5, frame, Palette.Fabrics[1])
			end)
			if placedBed then
				for index, offset in { 5.4, -5.4 } do
					room:against("back", along + offset, 2, 1.8, function(cf)
						Furniture.Nightstand(ctx, model, cf, frame, true, index == 1)
					end)
				end
			end
		end
	end
	if not placedBed then
		bedSet(room, 8, 9.5, frame, Palette.Fabrics[1], true)
	end
	room:tryAgainst({ "front", "back" }, { 16, 20, -20 }, 7.5, 2.4, function(cf)
		Furniture.Fireplace(ctx, model, cf, 7, room.h, true, false)
	end)
	for _, along in { -20, -5 } do
		room:tryAgainst({ "front", "left" }, { along, -along }, 5, 2.4, function(cf)
			Furniture.Wardrobe(ctx, model, cf, 5, 9, frame)
		end)
	end
	room:tryAgainst({ "right", "front" }, { 0, 8 }, 4.4, 2, function(cf)
		Furniture.Dresser(ctx, model, cf, 4.4, frame)
	end, 7)
	for _, x in { 14, 20 } do
		room:place(x, 3, x == 14 and 120 or -120, 3, 3, function(cf)
			Furniture.Armchair(ctx, model, cf, Palette.Fabrics[1])
		end)
	end
	room:place(17, 5, 0, 2, 2, function(cf)
		Furniture.SideTable(ctx, model, cf, 1.8, 2.4, Palette.WoodDark)
	end)
	room:paintings(3)
	room:chandelier(-10, 0, 32, false, 3, 3)
end

FURNISH.Attic = function(room)
	local ctx, model, rng = room.ctx, room.model, room.rng
	-- Depósito bagunçado: caixotes empilhados, móveis cobertos, baús e um manequim velho.
	for _ = 1, 9 do
		local sx = rng:NextNumber(2, 3.4)
		local x, z = room:spot(sx / 2 + 0.3, sx / 2 + 0.3, 0.5)
		if x then
			room:place(x, z, 0, sx + 0.6, sx + 0.6, function(cf)
				local height = rng:NextNumber(1.6, 2.6)
				Furniture.Crate(
					ctx,
					model,
					cf * CFrame.Angles(0, rng:NextNumber(-0.3, 0.3), 0),
					Vector3.new(sx, height, sx)
				)
				if rng:NextNumber() < 0.5 then
					Furniture.Crate(
						ctx,
						model,
						cf * CFrame.new(0, height, 0) * CFrame.Angles(0, rng:NextNumber(-0.5, 0.5), 0),
						Vector3.new(sx * 0.7, height * 0.8, sx * 0.7)
					)
				end
			end)
		end
	end
	for _ = 1, 4 do
		local w, d, h = rng:NextNumber(3, 6), rng:NextNumber(2.5, 4), rng:NextNumber(2.5, 5)
		local x, z = room:spot(w / 2 + 0.3, d / 2 + 0.3, 0.5)
		if x then
			room:place(x, z, 0, w + 0.6, d + 0.6, function(cf)
				Furniture.Covered(ctx, model, cf, Vector3.new(w, h, d), rng)
			end)
		end
	end
	for _, along in { -18, 18 } do
		room:tryAgainst({ "back", "front" }, { along }, 3.4, 2.2, function(cf)
			Furniture.Chest(ctx, model, cf)
		end)
	end
	local x, z = room:spot(1.2, 1.2, 1)
	if x then
		room:place(x, z, rng:NextNumber(0, 180), 2.4, 2.4, function(cf)
			Furniture.Mannequin(ctx, model, cf, Palette.Fabrics[6])
		end)
	end
	x, z = room:spot(2.2, 2.2, 1)
	if x then
		room:place(x, z, rng:NextNumber(0, 180), 4.2, 4.2, function(cf)
			Furniture.RockingHorse(ctx, model, cf, Palette.WoodLight)
		end)
	end
	room:chandelier(-12, 0, 24, false, 1.4, 2)
end

FURNISH.Corridor = function(room)
	local ctx, model, rng = room.ctx, room.model, room.rng
	room:rug(0, 0, room.w - 8, 4, Palette.Fabrics[1], Palette.Gold)
	room:chandelier(-49, 0, 34, false, 2, 2)
	room:chandelier(49, 0, 34, false, 2, 2)
	-- Entre as portas (as portas ficam no centro das células; as divisas ficam em ±14, ±42, ±70).
	for _, along in { -70, -42, -14, 14, 42, 70 } do
		for _, wall in { "front", "back" } do
			room:wallItem(wall, along, 8, 4.5, 3.5, function(cf)
				Furniture.Painting(ctx, model, cf, 4.5, 3.5, rng)
			end)
		end
	end
	for _, along in { -42, 42 } do
		room:against("back", along, 5, 1.8, function(cf)
			Furniture.Table(ctx, model, cf, 5, 1.6, 3, Palette.WoodDark)
			Furniture.Vase(
				ctx,
				model,
				cf * CFrame.new(0, 3, 0),
				1.5,
				Palette.pick({ Palette.TilesBlue, Palette.Terracotta, Palette.Marble }, rng),
				rng
			)
		end)
	end
	for _, along in { -70, 70 } do
		room:against("front", along, 2.2, 2.2, function(cf)
			Furniture.Statue(ctx, model, cf)
		end)
	end
	for _, along in { -95, 95 } do
		room:tryAgainst({ "front", "back" }, { along }, 1.8, 1.8, function(cf)
			Furniture.PottedPlant(ctx, model, cf, 2.4, rng)
		end)
	end
end

-- Mobilia o cômodo e espalha os pontos de arma.
function Rooms.Furnish(room)
	local builder = FURNISH[room.kind]
	if builder then
		builder(room)
	else
		warn(("[MapBuilder] Cômodo sem mobília definida: %s"):format(tostring(room.kind)))
	end
	local info = Rooms.Info[room.key]
	local count = info and info.weapons or 1
	room:weapons(count)
end

return Rooms
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">StartRoom</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Sala de Jogos (sala inicial): fechada por duas portas de madeira até a contagem terminar.
-- Tem a mesa onde o tabuleiro nasce (BoardSpawn), os spawns dos jogadores (PlayerSpawn), armas,
-- lareira, estantes e tambores. As paredes e o teto em volta ficam Indestructible até as portas abrirem,
-- para ninguém escapar antes da hora com dinamite.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Tags = require(ReplicatedStorage.Shared.Tags)

local Furniture = require(script.Parent.Furniture)
local Kit = require(script.Parent.Kit)
local Palette = require(script.Parent.Palette)

local StartRoom = {}

local M = Enum.Material
local GHOST_NO_SHADOW = { Ghost = true, NoShadow = true }

local TABLE_HEIGHT = 3.5
local OPEN_ANGLE = math.rad(172) -- a folha termina quase encostada na parede do corredor
local OPEN_TIME = 1.8
local SPAWN_RADIUS = 9.2
local SPAWN_COUNT = 8

export type DoorRecord = {
	model: Model,
	leaf: BasePart,
	hinge: CFrame,
	offset: CFrame,
	openAngle: number,
}

-- Cria uma porta de madeira com dobradiça. `slot`: centro do vão no piso (mundo), largura, altura e
-- o lado do corredor (outward = +1 se o corredor fica no +Z do mundo, -1 se fica no -Z).
local function buildDoor(ctx, parent: Instance, slot, index: number, wallThickness: number): DoorRecord
	local model = Kit.model("PortaDaSalaDeJogos" .. index)
	local leafWidth = slot.width - 0.2
	local leafHeight = slot.height - 0.1
	local leafThickness = 0.4
	local outward = slot.outward
	local floorY = slot.center.Y
	-- Dobradiça no batente esquerdo (menor X), na face da parede voltada para o corredor.
	local hingePosition = Vector3.new(
		slot.center.X - slot.width / 2 + 0.05,
		floorY + 0.05 + leafHeight / 2,
		slot.center.Z + outward * (wallThickness / 2)
	)
	local hinge = CFrame.new(hingePosition)
	local offset = CFrame.new(leafWidth / 2, 0, -outward * (leafThickness / 2))
	local leaf = Kit.box(
		ctx,
		model,
		"Folha",
		hinge * offset,
		Vector3.new(leafWidth, leafHeight, leafThickness),
		Palette.WoodRed,
		M.Wood,
		Kit.I
	)
	-- Detalhes soldados na folha (acompanham a rotação): almofadas dos dois lados e maçanetas.
	local details = {}
	for _, face in { -1, 1 } do
		for _, y in { -2.2, 2 } do
			table.insert(
				details,
				Kit.box(
					ctx,
					model,
					"Almofada",
					leaf.CFrame * CFrame.new(0, y, face * (leafThickness / 2 + 0.04)),
					Vector3.new(leafWidth * 0.7, 3.2, 0.08),
					Palette.WoodDark,
					M.Wood,
					nil,
					GHOST_NO_SHADOW
				)
			)
		end
		table.insert(
			details,
			Kit.ball(
				ctx,
				model,
				"Macaneta",
				(leaf.CFrame * CFrame.new(leafWidth / 2 - 0.6, -0.4, face * 0.35)).Position,
				0.45,
				Palette.Brass,
				M.Metal,
				nil,
				GHOST_NO_SHADOW
			)
		)
	end
	for _, detail in details do
		detail.Massless = true
	end
	Kit.weldTo(leaf, details)
	CollectionService:AddTag(model, Tags.StartRoomDoor)
	model:SetAttribute("Open", false)
	model:SetAttribute("HingeCFrame", hinge)
	model:SetAttribute("LeafOffset", offset)
	model:SetAttribute("OpenAngle", -outward * OPEN_ANGLE)
	Kit.attach(model, parent, leaf.Position)
	-- Batentes fixos (moldura) dos dois lados da parede.
	for _, side in { -1, 1 } do
		local z = slot.center.Z + side * (wallThickness / 2 + 0.1)
		for _, x in { slot.center.X - slot.width / 2 - 0.3, slot.center.X + slot.width / 2 + 0.3 } do
			Kit.box(
				ctx,
				parent,
				"Batente",
				Vector3.new(x, floorY + slot.height / 2, z),
				Vector3.new(0.6, slot.height, 0.25),
				Palette.Trim,
				M.Wood,
				nil,
				GHOST_NO_SHADOW
			)
		end
		Kit.box(
			ctx,
			parent,
			"Batente",
			Vector3.new(slot.center.X, floorY + slot.height + 0.35, z),
			Vector3.new(slot.width + 1.2, 0.7, 0.25),
			Palette.Trim,
			M.Wood,
			nil,
			GHOST_NO_SHADOW
		)
	end
	return { model = model, leaf = leaf, hinge = hinge, offset = offset, openAngle = -outward * OPEN_ANGLE }
end

-- Constrói a sala inicial dentro do Room (ver Rooms.new). Retorna os dados da sala para o MapBuilder.
function StartRoom.Build(ctx, room, doorSlots, sealParts: { BasePart })
	local model, rng = room.model, room.rng

	-- Armas nos quatro cantos (reservadas antes de qualquer móvel).
	for _, corner in { { -10.5, -10.5 }, { 10.5, -10.5 }, { -10.5, 10.5 }, { 10.5, 10.5 } } do
		room:occupy(corner[1], corner[2], 1.5, 1.5)
		Kit.weaponSpawn(ctx, room:at(corner[1], corner[2], 0, 1.5).Position, room.name)
	end

	-- Spawns dos jogadores em volta da mesa, olhando para o tabuleiro.
	local center = room:at(0, 0).Position
	local playerSpawns = {}
	for i = 1, SPAWN_COUNT do
		local angle = math.rad(22.5 + (i - 1) * (360 / SPAWN_COUNT))
		local x, z = math.cos(angle) * SPAWN_RADIUS, math.sin(angle) * SPAWN_RADIUS
		room:occupy(x, z, 1.2, 1.2)
		local position = room:at(x, z, 0, 3).Position
		local cframe = CFrame.lookAt(position, Vector3.new(center.X, position.Y, center.Z))
		Kit.marker(ctx, "PlayerSpawn" .. i, cframe, Vector3.new(2, 1, 2), Tags.PlayerSpawn)
		table.insert(playerSpawns, cframe)
	end

	-- Mesa do tabuleiro e cadeiras.
	room:rug(0, 0, 20, 17, Palette.Fabrics[1], Palette.Gold)
	room:occupy(0, 0, 6.6, 5.2)
	local tableCF = room:at(0, 0)
	Furniture.Table(ctx, model, tableCF, 10, 7, TABLE_HEIGHT, Palette.WoodDark)
	for _, x in { -2.5, 2.5 } do
		Furniture.Chair(ctx, model, tableCF * CFrame.new(x, 0, 4.6), Palette.WoodDark, Palette.Fabrics[1])
		Furniture.Chair(
			ctx,
			model,
			tableCF * CFrame.new(x, 0, -4.6) * CFrame.Angles(0, math.pi, 0),
			Palette.WoodDark,
			Palette.Fabrics[1]
		)
	end
	Furniture.Chair(
		ctx,
		model,
		tableCF * CFrame.new(6.1, 0, 0) * CFrame.Angles(0, math.rad(90), 0),
		Palette.WoodDark,
		Palette.Fabrics[1]
	)
	Furniture.Chair(
		ctx,
		model,
		tableCF * CFrame.new(-6.1, 0, 0) * CFrame.Angles(0, math.rad(-90), 0),
		Palette.WoodDark,
		Palette.Fabrics[1]
	)
	local boardSpawn = CFrame.new(tableCF.Position + Vector3.new(0, TABLE_HEIGHT, 0))
	Kit.marker(ctx, "BoardSpawn", boardSpawn, Vector3.new(1, 0.2, 1), Tags.BoardSpawn)

	-- Lareira acesa numa parede lateral e estantes na outra.
	room:against("left", 0, 7.5, 2.4, function(cf)
		Furniture.Fireplace(ctx, model, cf, 7, room.h, true, true)
	end)
	for _, along in { -5, 5 } do
		room:against("right", along, 6, 1.6, function(cf)
			Furniture.Bookshelf(ctx, model, cf, 6, 10, 1.6, rng)
		end)
	end
	-- Tambores antigos entre as estantes (o "chamado" do tabuleiro).
	room:against("right", 0, 3.2, 3.2, function(cf)
		Furniture.Drum(ctx, model, cf, 2.6, 3)
		Furniture.Drum(ctx, model, cf * CFrame.new(-1.2, 0, -2.3), 1.6, 2, Palette.Wood)
	end)
	room:against("left", -6.8, 3.4, 2.2, function(cf)
		Furniture.Chest(ctx, model, cf, Palette.WoodRed)
	end)

	-- Lustre (a luz principal da sala, com sombra) e decoração nas paredes.
	room:chandelier(0, 0, 32, true, 4, 4)
	for _, wall in { "front", "back" } do
		for _, along in { -8, 8 } do
			room:wallItem(wall, along, 8, 4.5, 3.5, function(cf)
				Furniture.Painting(ctx, model, cf, 4.5, 3.5, rng)
			end)
		end
	end
	for _, along in { -7.5, 7.5 } do
		room:wallItem("left", along, 9, 2, 2.8, function(cf)
			Furniture.Mask(ctx, model, cf, rng)
		end)
	end
	-- Cipós descendo pelos cantos: a selva já está chegando.
	for _, corner in { { -13, -13 }, { 13, -13 }, { -13, 13 }, { 13, 13 } } do
		local length = rng:NextNumber(5, 9)
		local top = room:at(corner[1], corner[2], 0, room.h - 0.1).Position
		Kit.box(
			ctx,
			model,
			"Cipo",
			CFrame.new(top - Vector3.new(0, length / 2, 0)) * CFrame.Angles(0, math.rad(45), 0),
			Vector3.new(1.2, length, 0.3),
			Palette.Vine,
			M.Grass,
			nil,
			GHOST_NO_SHADOW
		)
	end

	-- Portas (Models com tag StartRoomDoor) nos vãos deixados pela Mansion. Ficam fora do Model do
	-- cômodo para nunca serem escondidas pela distância de renderização.
	local doorsModel = Kit.model("Sala de Jogos - Portas")
	local doors = {}
	for index, slot in doorSlots do
		table.insert(doors, buildDoor(ctx, doorsModel, slot, index, 1))
	end
	Kit.attach(doorsModel, ctx.map, room:at(0, 0, 0, 5).Position)
	for _, part in sealParts do
		part:SetAttribute("StartRoomSeal", true)
	end

	local roomCenter = room:at(0, 0, 0, room.h / 2).Position
	return {
		startRoom = { cframe = CFrame.new(roomCenter), size = Vector3.new(room.w, room.h, room.d) },
		boardSpawn = boardSpawn,
		playerSpawns = playerSpawns,
		doors = doors,
		sealParts = sealParts,
		opened = false,
	}
end

-- Lê as portas pelas tags (caso o estado do Build não esteja disponível).
local function doorsFromTags(): { DoorRecord }
	local doors = {}
	for _, model in CollectionService:GetTagged(Tags.StartRoomDoor) do
		local leaf = model:FindFirstChild("Folha")
		local hinge = model:GetAttribute("HingeCFrame")
		local offset = model:GetAttribute("LeafOffset")
		local angle = model:GetAttribute("OpenAngle")
		if leaf and typeof(hinge) == "CFrame" and typeof(offset) == "CFrame" and type(angle) == "number" then
			table.insert(doors, { model = model, leaf = leaf, hinge = hinge, offset = offset, openAngle = angle })
		end
	end
	return doors
end

local function openDoor(door: DoorRecord)
	if door.model:GetAttribute("Open") then
		return
	end
	door.model:SetAttribute("Open", true)
	local value = Instance.new("NumberValue")
	value.Name = "AnguloDaPorta"
	value.Value = 0
	value.Parent = door.model
	local connection = value.Changed:Connect(function(angle)
		if door.leaf.Parent then
			door.leaf.CFrame = door.hinge * CFrame.Angles(0, angle, 0) * door.offset
		end
	end)
	local tween = TweenService:Create(
		value,
		TweenInfo.new(OPEN_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Value = door.openAngle }
	)
	tween.Completed:Once(function()
		connection:Disconnect()
		if door.leaf.Parent then
			door.leaf.CFrame = door.hinge * CFrame.Angles(0, door.openAngle, 0) * door.offset
		end
		value:Destroy()
		tween:Destroy()
	end)
	-- O som das portas é tocado pelo MatchService (um só, no centro da sala), para não somar três rangidos.
	tween:Play()
end

-- Abre as portas (tween na dobradiça) e libera a destruição das paredes da sala. Não cede (não usa wait).
function StartRoom.OpenDoors(state)
	local doors = state and state.doors or doorsFromTags()
	for _, door in doors do
		openDoor(door)
	end
	if state and state.opened then
		return
	end
	local seal = state and state.sealParts
	if not seal then
		-- Sem o estado do Build: procura as parts marcadas no mapa.
		seal = {}
		local map = workspace:FindFirstChild("Map")
		if map then
			for _, descendant in map:GetDescendants() do
				if descendant:IsA("BasePart") and descendant:GetAttribute("StartRoomSeal") then
					table.insert(seal, descendant)
				end
			end
		end
	end
	if state then
		state.opened = true
	end
	for _, part in seal do
		if part.Parent and part:GetAttribute("StartRoomSeal") then
			part:SetAttribute("StartRoomSeal", nil)
			CollectionService:RemoveTag(part, Tags.Indestructible)
			CollectionService:AddTag(part, Tags.Destructible)
		end
	end
end

return StartRoom
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="62">
        <Properties>
          <string name="Name">MatchService</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Fluxo da partida (servidor):
--   Loading -> WaitingPlayers -> Intro (primeira jogada liberada) -> Countdown (10 s) -> portas abrem
--   -> Playing -> Victory | Defeat -> volta ao lobby.
--
-- Participantes: quem está no servidor até a primeira jogada (o "início" da partida). Quem entra depois
-- vira espectador. Quem já estava no servidor, mas ainda carregando, nasce assim que ficar pronto.
-- "Pronto" = atributo ClientReady no Player (marcado quando o cliente manda Game_ClientReady).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local Net = require(ReplicatedStorage.Shared.Net)
local Places = require(ReplicatedStorage.Shared.Config.Places)
local SoundUtil = require(ReplicatedStorage.Shared.Audio.SoundUtil)

local BoardService = require(script.Parent.BoardService)
local EventService = require(script.Parent.EventService)

local MatchService = {}

type Participant = {
	userId: number,
	name: string,
	eliminated: boolean,
	spawned: boolean,
	left: boolean,
}

local STUDIO_GRACE = 3 -- sem TeleportData: espera isto depois do primeiro pronto
local CORPSE_TIME = 6 -- segundos até o corpo do eliminado sumir
local TELEPORT_ATTEMPTS = 3
local TELEPORT_PLAYER_RETRIES = 2
local MAX_EXPECTED = 16
local SPAWN_ATTEMPTS = 3 -- tentativas de criar o personagem
local LOADING_LIMIT = 120 -- participante que não termina de carregar em 2 min sai da conta de vivos
local DEFAULT_REASON = "Não resistiu aos perigos da selva"

local initialized = false
local mapInfo = nil
local remotes: { [string]: RemoteEvent } = {}
local MapBuilder = nil
local NPCService = nil

local state = {
	phase = "Loading",
	countdown = nil :: number?,
	message = "Preparando a ilha…" :: string?,
}
local participants: { [number]: Participant } = {}
local participantCount = 0
local expectedUserIds: { number }? = nil
local partyName: string? = nil
local teleportDataRead = false
local introStarted = false
local matchStarted = false -- depois da primeira jogada
local finished = false
local handledReady: { [Player]: boolean } = {}
local spawning: { [Player]: boolean } = {}
local spawnAttempts: { [Player]: number } = {}
local spawnIndex = 0
local teleportRetries: { [Player]: number } = {}

-- Utilitários ---------------------------------------------------------------------------

local function tryRequire(...: string): any
	local current: Instance? = script.Parent
	local path = {}
	for _, name in { ... } do
		table.insert(path, name)
		current = current and current:FindFirstChild(name)
	end
	local label = table.concat(path, ".")
	if not current or not current:IsA("ModuleScript") then
		warn(("[MatchService] Módulo '%s' não encontrado."):format(label))
		return nil
	end
	local ok, result = pcall(require, current)
	if not ok then
		warn(("[MatchService] Erro ao carregar '%s': %s"):format(label, tostring(result)))
		return nil
	end
	return result
end

-- Corta um texto UTF-8 em `maxChars` caracteres sem quebrar acentos.
local function truncate(text: string, maxChars: number): string
	local length = utf8.len(text)
	if not length then
		return ""
	end
	if length <= maxChars then
		return text
	end
	local cut = utf8.offset(text, maxChars + 1)
	return cut and text:sub(1, cut - 1) or text
end

local function aliveCount(): number
	local count = 0
	for _, record in participants do
		if not record.eliminated then
			count += 1
		end
	end
	return count
end

local function buildPayload()
	return {
		phase = state.phase,
		countdown = state.countdown,
		space = BoardService.GetSpace(),
		totalSpaces = GameConfig.BOARD_SPACES,
		alive = aliveCount(),
		total = participantCount,
		message = state.message,
	}
end

local function broadcastState()
	remotes.state:FireAllClients(buildPayload())
end

local function sendStateTo(player: Player)
	if player.Parent then
		remotes.state:FireClient(player, buildPayload())
	end
end

local function setPhase(phase: string, message: string?)
	state.phase = phase
	state.message = message
	state.countdown = nil
	broadcastState()
end

local function readyPlayers(): { Player }
	local list = {}
	for _, player in Players:GetPlayers() do
		if player:GetAttribute("ClientReady") then
			table.insert(list, player)
		end
	end
	return list
end

-- TeleportData (enviado pelo lobby) do primeiro jogador: quem é esperado nesta partida.
local function readTeleportData(player: Player)
	if teleportDataRead then
		return
	end
	teleportDataRead = true
	local ok, joinData = pcall(function()
		return player:GetJoinData()
	end)
	if not ok or type(joinData) ~= "table" then
		return
	end
	local data = joinData.TeleportData
	if type(data) ~= "table" then
		return
	end
	if type(data.partyName) == "string" and data.partyName ~= "" then
		partyName = truncate(data.partyName, GameConfig.PARTY_NAME_MAX)
	end
	local list = {}
	if type(data.expectedUserIds) == "table" then
		local seen = 0
		for _, value in data.expectedUserIds do
			seen += 1
			if seen > MAX_EXPECTED then
				break
			end
			if type(value) == "number" and value == value and value > 0 and value % 1 == 0 then
				if not table.find(list, value) then
					table.insert(list, value)
				end
			end
		end
	end
	if #list == 0 and data.mode == "solo" then
		list = { player.UserId }
	end
	if #list > 0 then
		if not table.find(list, player.UserId) then
			table.insert(list, player.UserId)
		end
		expectedUserIds = list
	end
end

-- Participantes ---------------------------------------------------------------------------

local function addParticipant(player: Player): Participant
	local record = participants[player.UserId]
	if record then
		return record
	end
	record = {
		userId = player.UserId,
		name = player.DisplayName,
		eliminated = false,
		spawned = false,
		left = false,
	}
	participants[player.UserId] = record
	participantCount += 1
	return record
end

local checkDefeat: () -> ()

local function eliminate(player: Player, reason: string)
	if player:GetAttribute("Eliminated") then
		return
	end
	player:SetAttribute("Eliminated", true)
	local record = participants[player.UserId]
	if record then
		record.eliminated = true
	end
	remotes.eliminated:FireAllClients(player.UserId, reason)
	remotes.notify:FireAllClients(("%s foi eliminado (%s)."):format(player.DisplayName, reason), "danger")
	broadcastState()
	checkDefeat()
end

-- Quem entrou depois do início: assiste aos outros.
local function makeSpectator(player: Player, reason: string)
	if player:GetAttribute("Eliminated") then
		return
	end
	player:SetAttribute("Eliminated", true)
	player:SetAttribute("LastDamageSource", reason)
	remotes.eliminated:FireClient(player, player.UserId, reason)
	remotes.notify:FireClient(player, "A partida já começou: você vai assistir como espectador.", "info")
end

local function onCharacterDied(player: Player, character: Model)
	if not player:GetAttribute("Eliminated") then
		local source = player:GetAttribute("LastDamageSource")
		local reason = (type(source) == "string" and source ~= "") and source or DEFAULT_REASON
		eliminate(player, reason)
	end
	-- Sem respawn: o corpo some depois de alguns segundos para não pesar.
	task.delay(CORPSE_TIME, function()
		if player.Parent and player.Character == character then
			player.Character = nil
		end
		if character.Parent then
			character:Destroy()
		end
	end)
end

local function nextSpawnCFrame(): CFrame
	local spawns = mapInfo.playerSpawns
	spawnIndex += 1
	if type(spawns) == "table" and #spawns > 0 then
		return spawns[(spawnIndex - 1) % #spawns + 1]
	end
	return mapInfo.startRoom.cframe
end

local spawnCharacter: (Player) -> ()
function spawnCharacter(player: Player)
	local record = participants[player.UserId]
	if not record or record.eliminated or record.spawned or spawning[player] or not player.Parent then
		return
	end
	spawning[player] = true
	local ok, err = pcall(function()
		player:LoadCharacterAsync()
	end)
	if not ok and player.Parent and not player.Character then
		-- Motores antigos sem LoadCharacterAsync: usa o método clássico.
		ok, err = pcall(function()
			(player :: any):LoadCharacter()
		end)
	end
	spawning[player] = nil
	if not ok then
		local attempts = (spawnAttempts[player] or 0) + 1
		spawnAttempts[player] = attempts
		warn(
			("[MatchService] Falha ao criar o personagem de %s (tentativa %d): %s"):format(
				player.Name,
				attempts,
				tostring(err)
			)
		)
		if attempts < SPAWN_ATTEMPTS then
			task.delay(2, spawnCharacter, player)
		end
		return
	end
	local character = player.Character
	if player.Parent and not character then
		-- Garantia: se o carregamento devolveu antes de o personagem existir, espera um pouco por ele.
		local deadline = os.clock() + 5
		while player.Parent and not player.Character and os.clock() < deadline do
			task.wait(0.1)
		end
		character = player.Character
	end
	if not player.Parent or not character then
		local attempts = (spawnAttempts[player] or 0) + 1
		spawnAttempts[player] = attempts
		if player.Parent and attempts < SPAWN_ATTEMPTS then
			task.delay(2, spawnCharacter, player)
		end
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
	if not humanoid or not humanoid:IsA("Humanoid") then
		warn(("[MatchService] Personagem de %s sem Humanoid."):format(player.Name))
		return
	end
	record.spawned = true
	-- Os spawns do mapa já estão na altura do HumanoidRootPart; só uma folga pequena.
	character:PivotTo(nextSpawnCFrame() + Vector3.new(0, 0.5, 0))
	humanoid.MaxHealth = GameConfig.PLAYER_MAX_HEALTH
	humanoid.Health = GameConfig.PLAYER_MAX_HEALTH
	player:SetAttribute("LastDamageSource", nil)
	humanoid.Died:Once(function()
		onCharacterDied(player, character)
	end)
	broadcastState()
end

local function onPlayerReady(player: Player)
	if not player.Parent then
		return
	end
	sendStateTo(player)
	if finished then
		return
	end
	local record = participants[player.UserId]
	if not matchStarted then
		-- Antes da primeira jogada qualquer um entra (inclusive quem saiu e voltou).
		if record and record.left then
			record.eliminated = false
			record.left = false
			record.spawned = false
		end
		record = record or addParticipant(player)
	end
	if record and not record.eliminated then
		task.spawn(spawnCharacter, player)
	else
		makeSpectator(player, "Entrou depois do início")
	end
	broadcastState()
end

local function onPlayerAdded(player: Player)
	readTeleportData(player)
	local function check()
		if player:GetAttribute("ClientReady") and not handledReady[player] then
			handledReady[player] = true
			onPlayerReady(player)
		end
	end
	player:GetAttributeChangedSignal("ClientReady"):Connect(check)
	check()
end

local function onPlayerRemoving(player: Player)
	handledReady[player] = nil
	spawning[player] = nil
	spawnAttempts[player] = nil
	teleportRetries[player] = nil
	local record = participants[player.UserId]
	if record and not record.eliminated then
		record.eliminated = true
		record.left = true
		if not finished then
			remotes.eliminated:FireAllClients(player.UserId, "Saiu da partida")
			remotes.notify:FireAllClients(("%s saiu da partida."):format(player.DisplayName), "warning")
		end
	end
	task.defer(function()
		broadcastState()
		checkDefeat()
	end)
end

-- Fim da partida -------------------------------------------------------------------------

local function teleportPlayers(list: { Player }): (boolean, string?)
	local ok, err = pcall(function()
		return TeleportService:TeleportAsync(Places.LOBBY_PLACE_ID, list)
	end)
	if ok then
		return true, nil
	end
	return false, tostring(err)
end

local function returnToLobby()
	for remaining = math.max(math.floor(GameConfig.RETURN_TO_LOBBY_DELAY), 0), 1, -1 do
		state.countdown = remaining
		broadcastState()
		task.wait(1)
	end
	state.countdown = nil

	if Places.LOBBY_PLACE_ID == 0 or RunService:IsStudio() then
		state.message = "Fim da partida! (sem teleporte no Studio)"
		broadcastState()
		remotes.notify:FireAllClients(
			"Fim da partida! No Studio (ou com LOBBY_PLACE_ID = 0 em Shared/Config/Places) não há teleporte "
				.. "de volta ao lobby. Pare o teste para jogar de novo.",
			"info"
		)
		return
	end

	state.message = "Voltando ao lobby…"
	broadcastState()
	for attempt = 1, TELEPORT_ATTEMPTS do
		local list = Players:GetPlayers()
		if #list == 0 then
			return
		end
		local ok, err = teleportPlayers(list)
		if ok then
			return
		end
		warn(("[MatchService] Teleporte para o lobby falhou (tentativa %d): %s"):format(attempt, tostring(err)))
		task.wait(2 * attempt)
	end
	remotes.notify:FireAllClients(
		"Não foi possível voltar ao lobby automaticamente. Saia e entre de novo no jogo.",
		"danger"
	)
end

local function onTeleportFailed(player: Player, result: Enum.TeleportResult, message: string)
	if not finished or not player.Parent then
		return
	end
	local count = (teleportRetries[player] or 0) + 1
	teleportRetries[player] = count
	warn(("[MatchService] Teleporte de %s falhou (%s): %s"):format(player.Name, tostring(result), tostring(message)))
	if count > TELEPORT_PLAYER_RETRIES then
		remotes.notify:FireClient(player, "Não foi possível voltar ao lobby. Saia e entre de novo no jogo.", "danger")
		return
	end
	task.delay(2 * count, function()
		if player.Parent then
			teleportPlayers({ player })
		end
	end)
end

local function endMatch(victory: boolean)
	if finished then
		return
	end
	finished = true
	pcall(BoardService.SetRollingEnabled, false)
	local ok, err = pcall(EventService.StopAll)
	if not ok then
		warn("[MatchService] Erro ao encerrar os eventos: " .. tostring(err))
	end
	-- Trava DEPOIS do StopAll: o cleanup de um evento (ex.: pelicano) chama SetLocked(false).
	pcall(BoardService.SetLocked, true)
	if NPCService and type(NPCService.DespawnAll) == "function" then
		ok, err = pcall(NPCService.DespawnAll)
		if not ok then
			warn("[MatchService] Erro ao remover os NPCs: " .. tostring(err))
		end
	end
	if victory then
		setPhase("Victory", "O tabuleiro foi vencido!")
		SoundUtil.Play("Victory", { Group = "Music", Volume = 0.8 })
		remotes.notify:FireAllClients(("%s: o tabuleiro foi vencido!"):format(GameConfig.GAME_TITLE), "success")
	else
		setPhase("Defeat", "Todos foram eliminados. A selva venceu desta vez…")
		SoundUtil.Play("Defeat", { Group = "Music", Volume = 0.8 })
	end
	task.spawn(returnToLobby)
end

function checkDefeat()
	if finished or not introStarted or participantCount == 0 then
		return
	end
	if aliveCount() > 0 then
		return
	end
	endMatch(false)
end

-- Jogadas ---------------------------------------------------------------------------------

local function openStartDoors()
	if MapBuilder and type(MapBuilder.OpenStartDoors) == "function" then
		local ok, err = pcall(MapBuilder.OpenStartDoors)
		if not ok then
			warn("[MatchService] Erro ao abrir as portas da sala inicial: " .. tostring(err))
		end
	end
	local startRoom = mapInfo.startRoom
	SoundUtil.Play("DoorOpen", {
		Position = startRoom and startRoom.cframe.Position or BoardService.GetBoardPosition(),
		RollOffMaxDistance = 250,
	})
	remotes.notify:FireAllClients("As portas se abriram! Que comece o jogo.", "warning")
end

local function startEvent(eventId: string, position: Vector3)
	if eventId == "" then
		remotes.notify:FireAllClients("O tabuleiro estremece… mas nada acontece (nenhum evento carregado).", "info")
		return
	end
	local ok, err = pcall(EventService.Start, eventId, position)
	if not ok then
		warn(("[MatchService] Erro ao iniciar o evento '%s': %s"):format(eventId, tostring(err)))
	end
end

local function onRolled(result)
	if finished or type(result) ~= "table" then
		return
	end
	broadcastState()
	if result.isFinal then
		endMatch(true)
		return
	end

	local isFirst = result.isFirst == true
	if isFirst and not matchStarted then
		-- Início da partida: quem está no servidor agora participa (mesmo se ainda estiver carregando).
		matchStarted = true
		for _, player in Players:GetPlayers() do
			if not participants[player.UserId] and not player:GetAttribute("Eliminated") then
				addParticipant(player)
				if player:GetAttribute("ClientReady") then
					task.spawn(spawnCharacter, player)
				end
			end
		end
		-- Quem ainda não nasceu tem um tempo limite (senão um cliente travado impediria a derrota).
		task.delay(LOADING_LIMIT, function()
			for userId, record in participants do
				if not record.spawned and not record.eliminated and not finished then
					record.eliminated = true
					local player = Players:GetPlayerByUserId(userId)
					if player then
						player:SetAttribute("LastDamageSource", "Demorou demais para carregar")
						player:SetAttribute("Eliminated", true)
					end
				end
			end
			broadcastState()
			checkDefeat()
		end)
	end

	local eventId = EventService.EventForSpace(result.space)
	local riddle = EventService.GetRiddle(eventId)
	local countdown = isFirst and GameConfig.START_COUNTDOWN or GameConfig.EVENT_WARNING_TIME
	remotes.riddle:FireAllClients({
		text = riddle,
		space = result.space,
		dice = result.dice,
		countdown = countdown,
		isFirst = isFirst,
	})
	BoardService.ShowRiddle(riddle)
	local boardModel = BoardService.GetBoardModel()
	SoundUtil.Play("Drums", {
		Parent = boardModel and boardModel.PrimaryPart or nil,
		RollOffMaxDistance = 150,
		Volume = 0.8,
	})

	if isFirst then
		state.phase = "Countdown"
		state.message = "As portas vão se abrir…"
		for remaining = countdown, 1, -1 do
			state.countdown = remaining
			broadcastState()
			task.wait(1)
			if finished then
				return
			end
		end
		state.countdown = nil
		openStartDoors()
		startEvent(eventId, result.position)
		setPhase("Playing", nil)
	else
		task.wait(countdown)
		if finished then
			return
		end
		startEvent(eventId, result.position)
	end

	if finished then
		return
	end
	BoardService.StartCooldown(GameConfig.ROLL_COOLDOWN)
	BoardService.SetRollingEnabled(true)
	broadcastState()
end

-- Espera os jogadores esperados ficarem prontos (ou o tempo limite).
local function waitForPlayers()
	local started = os.clock()
	local firstReadyAt: number? = nil
	local lastMessage: string? = nil
	while not finished do
		local ready = readyPlayers()
		if #ready > 0 and not firstReadyAt then
			firstReadyAt = os.clock()
		end
		local expected = expectedUserIds
		local message
		if expected then
			local arrived = 0
			for _, userId in expected do
				local player = Players:GetPlayerByUserId(userId)
				if player and player:GetAttribute("ClientReady") then
					arrived += 1
				end
			end
			local elapsed = os.clock() - started
			if #ready > 0 and (arrived >= #expected or elapsed >= GameConfig.WAIT_FOR_PLAYERS_TIMEOUT) then
				break
			end
			local remaining = math.ceil(GameConfig.WAIT_FOR_PLAYERS_TIMEOUT - elapsed)
			if remaining > 0 then
				message = ("Aguardando jogadores (%d/%d)… começa em até %ds"):format(arrived, #expected, remaining)
			else
				message = ("Aguardando jogadores (%d/%d)…"):format(arrived, #expected)
			end
		else
			if firstReadyAt and os.clock() - firstReadyAt >= STUDIO_GRACE then
				break
			end
			message = ("Aguardando jogadores (%d pronto(s))…"):format(#ready)
		end
		if partyName then
			message = ("%s — %s"):format(partyName, message)
		end
		if message ~= lastMessage then
			lastMessage = message
			state.message = message
			broadcastState()
		end
		task.wait(0.25)
	end
end

local function startIntro()
	introStarted = true
	setPhase("Intro", "Pegue o tabuleiro (E) ou chegue perto dele e jogue o dado (T) para começar!")
	BoardService.SetLocked(false)
	BoardService.SetRollingEnabled(true)
	checkDefeat()
end

-- API pública ----------------------------------------------------------------------------

function MatchService.Init(info)
	if initialized then
		return
	end
	initialized = true
	mapInfo = info

	remotes.state = Net.event(Net.Names.Game_State)
	remotes.ready = Net.event(Net.Names.Game_ClientReady)
	remotes.riddle = Net.event(Net.Names.Board_Riddle)
	remotes.eliminated = Net.event(Net.Names.Player_Eliminated)
	remotes.notify = Net.event(Net.Names.Notify)

	MapBuilder = tryRequire("Map", "MapBuilder")
	NPCService = tryRequire("NPC", "NPCService")

	BoardService.SetLocked(true)
	BoardService.SetRollingEnabled(false)
	BoardService.Rolled:Connect(onRolled)

	remotes.ready.OnServerEvent:Connect(function(player)
		if player:GetAttribute("ClientReady") then
			sendStateTo(player) -- pedido repetido: só reenvia o estado
		else
			player:SetAttribute("ClientReady", true)
		end
	end)
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	if Places.LOBBY_PLACE_ID ~= 0 then
		TeleportService.TeleportInitFailed:Connect(onTeleportFailed)
	end

	setPhase("Loading", "Preparando a ilha…")
	task.spawn(function()
		setPhase("WaitingPlayers", "Aguardando jogadores…")
		waitForPlayers()
		if not finished then
			startIntro()
		end
	end)
end

return MatchService
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="63">
        <Properties>
          <string name="Name">NPC</string>
        </Properties>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">Brain</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Locomoção e percepção comuns aos NPCs terrestres (Humanoid):
--   * alvo: jogador vivo mais próximo no raio de aggro, com "memória" (só desiste além do leash) e
--     prioridade para quem acabou de atacar o NPC;
--   * linha de visão com cache curto;
--   * perseguição: com visão e perto → Humanoid:MoveTo direto (a cada ~0,3 s); senão, PathfindingService
--     (ComputeAsync em pcall, em outra thread, com limite de cálculos simultâneos) seguindo os waypoints;
--   * detecção de travamento: pula → recalcula o caminho → desvia para o lado;
--   * passeio sem alvo e animação procedural das pernas (Motor6D C0, ~8 Hz, só andando e perto de alguém).
-- Nada aqui cede (yield): tudo roda dentro do agendador do NPCService.

local PathfindingService = game:GetService("PathfindingService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)

local CombatUtil = require(script.Parent.Parent.CombatUtil)
local Effects = require(script.Parent.Effects)

local Brain = {}

local DIRECT_RANGE = 40 -- persegue direto (sem caminho) até esta distância, se estiver vendo o alvo
local DIRECT_MAX_DY = 7
local MOVE_REFRESH = 0.3
local TARGET_SCAN = 0.5
local LOS_CACHE = 0.3
local PROVOKE_TIME = 8 -- segundos em que quem atacou o NPC vira o alvo preferido
local SWITCH_MARGIN = 10 -- troca de alvo só se o novo estiver bem mais perto
local STUCK_INTERVAL = 1
local STUCK_MIN_MOVE = 1
local FORCE_PATH_TIME = 3
local SIDESTEP_TIME = 0.8
local PATH_RETRY_AFTER_FAIL = 1.5
local MAX_CONCURRENT_PATHS = 4
local GOAL_MOVED = 6 -- recalcula o caminho se o alvo andou mais que isto
local GAIT_INTERVAL = 0.12
local GAIT_NEAR = 80 -- só anima com jogador até esta distância
local GAIT_MIN_SPEED = 1.5
local MAX_GAIT_RATE = 13 -- radianos por segundo

local computing = 0

local function rootOf(player: Player?): BasePart?
	local character = player and player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end
Brain.RootOf = rootOf

local function flatDistance(a: Vector3, b: Vector3): number
	local dx, dz = a.X - b.X, a.Z - b.Z
	return math.sqrt(dx * dx + dz * dz)
end
Brain.FlatDistance = flatDistance

local function flatUnit(vector: Vector3, fallback: Vector3?): Vector3
	local flat = Vector3.new(vector.X, 0, vector.Z)
	if flat.Magnitude < 1e-3 then
		return fallback or Vector3.new(0, 0, -1)
	end
	return flat.Unit
end
Brain.FlatUnit = flatUnit

-- Alvo ----------------------------------------------------------------------------------------------

-- Marca quem atacou o NPC (vira o alvo preferido por alguns segundos, mesmo fora do raio).
function Brain.Provoke(npc, player: Player?, now: number)
	if player and CombatUtil.IsPlayerAlive(player) then
		npc.provoker = player
		npc.provokedUntil = now + PROVOKE_TIME
		npc.nextTargetScan = 0
	end
end

-- Atualiza e devolve (alvo, raiz do alvo, distância 3D). Sem alvo: (nil, nil, math.huge).
function Brain.UpdateTarget(npc, now: number): (Player?, BasePart?, number)
	local def = npc.def
	local position = npc.root.Position
	local current: Player? = npc.target
	if current and (not current.Parent or not CombatUtil.IsPlayerAlive(current)) then
		current = nil
		npc.target = nil
	end

	if not current or now >= (npc.nextTargetScan or 0) then
		npc.nextTargetScan = now + TARGET_SCAN
		local chosen: Player? = nil
		local provoker: Player? = npc.provoker
		if provoker and now < (npc.provokedUntil or 0) and provoker.Parent and CombatUtil.IsPlayerAlive(provoker) then
			local provokerRoot = rootOf(provoker)
			if provokerRoot and (provokerRoot.Position - position).Magnitude <= def.leashRadius then
				chosen = provoker
			end
		end
		if not chosen then
			local nearest, nearestDistance = CombatUtil.GetNearestAlivePlayer(position, def.aggroRadius)
			local currentRoot = rootOf(current)
			if current and currentRoot then
				local currentDistance = (currentRoot.Position - position).Magnitude
				if
					currentDistance <= def.leashRadius
					and not (nearest and nearestDistance < currentDistance - SWITCH_MARGIN)
				then
					chosen = current
				else
					chosen = nearest
				end
			else
				chosen = nearest
			end
			if not chosen and def.persistent then
				chosen = CombatUtil.GetNearestAlivePlayer(position)
			end
		end
		if chosen ~= npc.target then
			npc.target = chosen
			npc.waypoints = nil
			npc.losUntil = nil
		end
	end

	local target: Player? = npc.target
	local targetRoot = rootOf(target)
	if not target or not targetRoot then
		npc.target = nil
		npc.targetDistance = math.huge
		return nil, nil, math.huge
	end
	local distance = (targetRoot.Position - position).Magnitude
	npc.targetDistance = distance
	return target, targetRoot, distance
end

-- Visão ---------------------------------------------------------------------------------------------

function Brain.EyePosition(npc): Vector3
	local eye = npc.rig.eye
	if eye and eye.Parent then
		return eye.Position
	end
	return npc.root.Position + Vector3.new(0, 1, 0)
end

-- Há linha de visão do "olho" do NPC até `point` (sem paredes no meio)? Resultado guardado por ~0,3 s.
function Brain.LineOfSight(npc, now: number, point: Vector3): boolean
	local cachedPoint: Vector3? = npc.losPoint
	if npc.losUntil and now < npc.losUntil and cachedPoint and (cachedPoint - point).Magnitude < 4 then
		return npc.losValue == true
	end
	local eye = Brain.EyePosition(npc)
	local result = workspace:Raycast(eye, point - eye, Effects.WorldParams())
	local visible = result == nil
	npc.losValue = visible
	npc.losPoint = point
	npc.losUntil = now + LOS_CACHE
	return visible
end

-- Movimento -----------------------------------------------------------------------------------------

function Brain.MoveTo(npc, position: Vector3, now: number)
	local humanoid: Humanoid? = npc.humanoid
	if not humanoid then
		return
	end
	humanoid:MoveTo(position)
	npc.lastMoveTo = now
	npc.lastGoal = position
end

-- Para no lugar (sem detecção de travamento).
function Brain.Stop(npc)
	local humanoid: Humanoid? = npc.humanoid
	if humanoid and npc.root.Parent then
		humanoid:MoveTo(npc.root.Position)
	end
	npc.wantsMove = false
	npc.waypoints = nil
	npc.lastGoal = nil
end

-- Vira o NPC (só no plano) para olhar `position`.
function Brain.Face(npc, position: Vector3)
	local root: BasePart = npc.root
	local here = root.Position
	local flat = Vector3.new(position.X - here.X, 0, position.Z - here.Z)
	if flat.Magnitude < 0.1 then
		return
	end
	root.CFrame = CFrame.lookAt(here, here + flat.Unit)
end

function Brain.IsGrounded(npc): boolean
	local humanoid: Humanoid? = npc.humanoid
	return humanoid ~= nil and humanoid.FloorMaterial ~= Enum.Material.Air
end

local function requestPath(npc, goal: Vector3, now: number)
	if npc.computing or computing >= MAX_CONCURRENT_PATHS then
		return
	end
	local path: Path? = npc.path
	if not path then
		local def = npc.def
		local ok, created = pcall(function()
			return PathfindingService:CreatePath({
				AgentRadius = def.agentRadius,
				AgentHeight = def.agentHeight,
				AgentCanJump = true,
				AgentCanClimb = false,
				WaypointSpacing = 4,
			})
		end)
		if not ok or not created then
			npc.lastPathTime = now
			return
		end
		path = created
		npc.path = created
	end
	npc.computing = true
	npc.lastPathTime = now
	computing += 1
	local start = npc.root.Position
	local activePath = path :: Path
	task.spawn(function()
		local ok = pcall(function()
			activePath:ComputeAsync(start, goal)
		end)
		computing -= 1
		npc.computing = false
		if not npc.alive then
			return
		end
		if ok and activePath.Status == Enum.PathStatus.Success then
			local waypoints = activePath:GetWaypoints()
			if #waypoints >= 2 then
				npc.waypoints = waypoints
				npc.waypointIndex = 2 -- o primeiro é o próprio ponto de partida
				npc.movingToIndex = 0
				npc.pathGoal = goal
				npc.pathFailedUntil = nil
				return
			end
		end
		-- Sem caminho: segue direto por um tempo (a detecção de travamento ajuda) e tenta de novo depois.
		npc.waypoints = nil
		npc.pathGoal = goal
		npc.pathFailedUntil = os.clock() + PATH_RETRY_AFTER_FAIL
	end)
end

local function followWaypoints(npc, now: number, goal: Vector3)
	local waypoints = npc.waypoints
	local position = npc.root.Position
	local feetY = position.Y - npc.feetOffset
	local reach = npc.def.waypointReach
	local index = npc.waypointIndex or 2
	while index <= #waypoints do
		local point = waypoints[index].Position
		if flatDistance(point, position) <= reach and math.abs(point.Y - feetY) < 5 then
			index += 1
		else
			break
		end
	end
	npc.waypointIndex = index
	if index > #waypoints then
		npc.waypoints = nil
		Brain.MoveTo(npc, goal, now)
		return
	end
	local waypoint = waypoints[index]
	if index ~= npc.movingToIndex or now - (npc.lastMoveTo or 0) >= 1 then
		npc.movingToIndex = index
		Brain.MoveTo(npc, waypoint.Position, now)
		if waypoint.Action == Enum.PathWaypointAction.Jump then
			npc.humanoid.Jump = true
		end
	end
end

-- Verifica se o NPC está preso (quer andar e não sai do lugar) e reage em degraus.
function Brain.CheckStuck(npc, now: number)
	if now - (npc.stuckCheckTime or 0) < STUCK_INTERVAL then
		return
	end
	local position = npc.root.Position
	local last: Vector3? = npc.stuckCheckPos
	npc.stuckCheckTime = now
	npc.stuckCheckPos = position
	if not last or not npc.wantsMove then
		npc.stuckCount = 0
		return
	end
	if flatDistance(position, last) >= STUCK_MIN_MOVE then
		npc.stuckCount = 0
		return
	end
	local humanoid: Humanoid = npc.humanoid
	npc.stuckCount = (npc.stuckCount or 0) + 1
	if npc.stuckCount == 1 then
		humanoid.Jump = true
	elseif npc.stuckCount == 2 then
		humanoid.Jump = true
		npc.waypoints = nil
		npc.lastPathTime = -math.huge
		npc.pathFailedUntil = nil
		npc.forcePathUntil = now + FORCE_PATH_TIME
	else
		-- Desvia para um lado (e um pouco para trás) e tenta de novo.
		local look = npc.root.CFrame.LookVector
		local side = Vector3.new(-look.Z, 0, look.X)
		if npc.rng:NextNumber() < 0.5 then
			side = -side
		end
		Brain.MoveTo(npc, position + side * 6 - flatUnit(look) * 2, now)
		humanoid.Jump = true
		npc.sidestepUntil = now + SIDESTEP_TIME
		npc.waypoints = nil
		npc.stuckCount = 1
	end
end

-- Persegue `goal`. `canSee`: true = já se sabe que há visão; false = sem visão; nil = calcula.
-- `arrive`: a partir desta distância (XZ) o NPC só se ajeita (sem detecção de travamento).
function Brain.ChaseTo(npc, now: number, goal: Vector3, canSee: boolean?, arrive: number?)
	if not npc.humanoid then
		return
	end
	if now < (npc.sidestepUntil or 0) then
		return
	end
	local position = npc.root.Position
	local offset = goal - position
	local flat = Vector3.new(offset.X, 0, offset.Z).Magnitude
	npc.wantsMove = flat > (arrive or 0)

	local forcePath = now < (npc.forcePathUntil or 0)
	local direct = false
	if not forcePath and flat <= DIRECT_RANGE and math.abs(offset.Y) <= DIRECT_MAX_DY then
		if canSee == nil then
			direct = Brain.LineOfSight(npc, now, goal)
		else
			direct = canSee
		end
	end
	local pathFailed = npc.pathFailedUntil ~= nil and now < npc.pathFailedUntil

	if direct or (pathFailed and not forcePath) then
		-- Vendo o alvo (ou sem caminho calculável): vai reto; a detecção de travamento cuida do resto.
		npc.waypoints = nil
		local lastGoal: Vector3? = npc.lastGoal
		if now - (npc.lastMoveTo or 0) >= MOVE_REFRESH or not lastGoal or (lastGoal - goal).Magnitude > 3 then
			Brain.MoveTo(npc, goal, now)
		end
	else
		local waypoints = npc.waypoints
		local pathGoal: Vector3? = npc.pathGoal
		local stale = waypoints == nil
			or (npc.waypointIndex or 2) > #waypoints
			or (pathGoal ~= nil and (pathGoal - goal).Magnitude > GOAL_MOVED)
		if
			(stale or forcePath)
			and not npc.computing
			and now - (npc.lastPathTime or -math.huge) >= GameConfig.NPC_PATH_RECOMPUTE
		then
			requestPath(npc, goal, now)
		end
		if npc.waypoints then
			followWaypoints(npc, now, goal)
		elseif now - (npc.lastMoveTo or 0) >= MOVE_REFRESH then
			Brain.MoveTo(npc, goal, now)
		end
	end
	Brain.CheckStuck(npc, now)
end

-- Passeia perto de onde nasceu (sem caminho calculado: barato).
function Brain.Wander(npc, now: number, radius: number?)
	npc.wantsMove = false
	if now < (npc.nextWander or 0) then
		return
	end
	local rng: Random = npc.rng
	npc.nextWander = now + rng:NextNumber(3, 6)
	local range = radius or 16
	local angle = rng:NextNumber(0, math.pi * 2)
	local distance = rng:NextNumber(range * 0.3, range)
	local home: Vector3 = npc.home
	local candidate = home + Vector3.new(math.cos(angle) * distance, 0, math.sin(angle) * distance)
	local ground = Effects.Ground(candidate, 30, 8)
	if ground then
		Brain.MoveTo(npc, ground, now)
	end
end

-- Ataque corpo a corpo com cooldown. Retorna true se acertou.
function Brain.Melee(npc, now: number, player: Player, targetRoot: BasePart, range: number?): boolean
	if now < (npc.nextAttack or 0) then
		return false
	end
	local def = npc.def
	local offset = targetRoot.Position - npc.root.Position
	if offset.Magnitude > (range or def.attackRange) or math.abs(offset.Y) > 6 then
		return false
	end
	npc.nextAttack = now + def.attackCooldown
	CombatUtil.DamagePlayer(player, npc.damage, def.displayName)
	return true
end

-- Animação ------------------------------------------------------------------------------------------

local function resetGait(gait)
	for _, joint in gait.joints do
		joint.motor.C0 = joint.base
	end
end

-- Balança as pernas enquanto anda (C0 dos Motor6D a ~8 Hz); parado ou longe de todos, volta ao normal.
function Brain.Animate(npc, now: number)
	local gait = npc.rig.gait
	if not gait or now - (npc.lastGait or 0) < GAIT_INTERVAL then
		return
	end
	local dt = math.min(now - (npc.lastGait or now), 0.3)
	npc.lastGait = now
	local root: BasePart = npc.root
	local velocity = root.AssemblyLinearVelocity
	local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
	local near = (npc.targetDistance or math.huge) <= GAIT_NEAR
	if speed > GAIT_MIN_SPEED and near then
		local phase = (npc.gaitPhase or 0) + dt * math.min(speed * gait.rate, MAX_GAIT_RATE)
		npc.gaitPhase = phase % (math.pi * 2)
		for _, joint in gait.joints do
			local angle = npc.gaitPhase + joint.phase
			if joint.mode == "swing" then
				joint.motor.C0 = joint.base * CFrame.Angles(math.sin(angle) * joint.amp, 0, 0)
			else
				local lift = math.max(math.sin(angle), 0) * joint.lift
				joint.motor.C0 = joint.base * CFrame.new(0, lift, -math.cos(angle) * joint.stride)
			end
		end
		npc.gaitActive = true
	elseif npc.gaitActive then
		npc.gaitActive = false
		resetGait(gait)
	end
end

return Brain
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Utilitários dos NPCs (servidor):
--   * parâmetros de raycast/overlap compartilhados (só o cenário sólido; reconstruídos 1x por segundo);
--   * tiro em linha que para no cenário e acerta o primeiro jogador no caminho;
--   * sons com limite de repetição, avisos com cooldown, tremor de câmera e traço de tiro (Fx_Play);
--   * lentidão de jogadores (usa os modificadores empilháveis do PhysUtil quando existe, para não brigar
--     com os eventos físicos; senão, uma pilha própria com a mesma regra) e destaque visual (Highlight);
--   * objetos soltos (LooseProp): procurar, reservar, soltar e lançar (usa o DestructionService se houver).

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local SoundUtil = require(ReplicatedStorage.Shared.Audio.SoundUtil)
local Tags = require(ReplicatedStorage.Shared.Tags)

local CombatUtil = require(script.Parent.Parent.CombatUtil)
local GroundUtil = require(script.Parent.Parent.EventHelpers.GroundUtil)

local Effects = {}

local PARAMS_REFRESH = 1 -- segundos entre reconstruções da lista de exclusão
local SOUND_MIN_GAP = 0.25 -- o mesmo som não toca mais de uma vez nesse intervalo (muitos NPCs juntos)
local BODY_SAMPLES = { Vector3.new(0, -1.6, 0), Vector3.zero, Vector3.new(0, 1.5, 0) }
local BODY_RADIUS = 1.6 -- "espessura" do personagem para o tiro
local PROP_MAX_PARTS = 8 -- objeto soldado com mais partes que isto não é arremessável
local LEAF_TEXTURE = "rbxasset://textures/particles/smoke_main.dds"

-- Parâmetros de consulta -----------------------------------------------------------------------

local worldParams = RaycastParams.new()
worldParams.FilterType = Enum.RaycastFilterType.Exclude
worldParams.IgnoreWater = true
worldParams.RespectCanCollide = true

local propParams = OverlapParams.new()
propParams.FilterType = Enum.RaycastFilterType.Exclude
propParams.MaxParts = 80

local lastRefresh = -math.huge

local function addFolder(list: { Instance }, parent: Instance?, name: string)
	local folder = parent and parent:FindFirstChild(name)
	if folder then
		table.insert(list, folder)
	end
end

local function refreshParams()
	local now = os.clock()
	if now - lastRefresh < PARAMS_REFRESH then
		return
	end
	lastRefresh = now
	local list: { Instance } = {}
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(list, player.Character)
		end
	end
	for _, name in { "NPCs", "Debris", "ActiveEvents", "Board" } do
		addFolder(list, workspace, name)
	end
	addFolder(list, workspace:FindFirstChild("Map"), "Regions")
	worldParams.FilterDescendantsInstances = list
	propParams.FilterDescendantsInstances = list
end

-- Raycast que só enxerga o cenário sólido: ignora personagens, NPCs, pedaços, eventos e o tabuleiro.
function Effects.WorldParams(): RaycastParams
	refreshParams()
	return worldParams
end

-- Força a reconstrução na próxima consulta (ex.: personagem novo).
function Effects.InvalidateParams()
	lastRefresh = -math.huge
end

-- Tiro em linha reta: para no cenário sólido e acerta o primeiro jogador vivo no caminho.
-- Retorna (jogador atingido?, ponto final do traço, resultado do cenário se parou numa parede).
function Effects.CastShot(origin: Vector3, direction: Vector3, range: number): (Player?, Vector3, RaycastResult?)
	local unit = if direction.Magnitude > 1e-3 then direction.Unit else Vector3.new(0, 0, -1)
	local world = workspace:Raycast(origin, unit * range, Effects.WorldParams())
	local length = if world then (world.Position - origin).Magnitude else range
	local bestPlayer, bestAlong = nil, math.huge
	for _, player in CombatUtil.GetAlivePlayers() do
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			for _, offset in BODY_SAMPLES do
				local point = root.Position + offset
				local along = (point - origin):Dot(unit)
				if along > 0 and along <= length + BODY_RADIUS and along < bestAlong then
					if (point - (origin + unit * along)).Magnitude <= BODY_RADIUS then
						bestPlayer, bestAlong = player, along
					end
				end
			end
		end
	end
	if bestPlayer then
		return bestPlayer, origin + unit * bestAlong, nil
	end
	return nil, origin + unit * length, world
end

-- Chão sob `position` (ignora personagens, NPCs, pedaços e eventos).
function Effects.Ground(position: Vector3, maxDrop: number?, startAbove: number?): Vector3?
	local ground = GroundUtil.FindGround(position, maxDrop or 30, startAbove or 4)
	return ground
end

-- Módulos de outros donos (require seguro, uma vez) ----------------------------------------------

local cachedModules: { [string]: any } = {}

local function safeRequire(...: string): any
	local key = table.concat({ ... }, ".")
	local cached = cachedModules[key]
	if cached ~= nil then
		return cached or nil
	end
	local current: Instance? = script.Parent.Parent
	for _, name in { ... } do
		current = current and current:FindFirstChild(name)
	end
	local module = nil
	if current and current:IsA("ModuleScript") then
		local ok, result = pcall(require, current)
		if ok and type(result) == "table" then
			module = result
		else
			warn(("[NPC] Não foi possível carregar '%s': %s"):format(key, tostring(result)))
		end
	end
	cachedModules[key] = module or false
	return module
end

function Effects.GetDestruction(): any
	return safeRequire("DestructionService")
end

local function getPhysUtil(): any
	local module = safeRequire("EventHelpers", "PhysUtil")
	if module and type(module.SetTimedModifier) == "function" then
		return module
	end
	return nil
end

-- Pasta de efeitos dos NPCs (workspace.NPCs.Efeitos), definida pelo NPCService.
local effectsFolder: Instance? = nil

function Effects.SetFolder(folder: Instance)
	effectsFolder = folder
end

function Effects.Folder(): Instance
	if effectsFolder and effectsFolder.Parent then
		return effectsFolder
	end
	return workspace
end

-- Sons, avisos, tremor e traço --------------------------------------------------------------------

local lastSound: { [string]: number } = {}

-- Toca um som de Config/Sounds numa posição (ids vazios não fazem nada). Limita repetições seguidas.
function Effects.Sound(name: string, position: Vector3?, options: { [string]: any }?): Sound?
	local now = os.clock()
	local last = lastSound[name]
	if last and now - last < SOUND_MIN_GAP then
		return nil
	end
	lastSound[name] = now
	local opts = table.clone(options or {})
	if position and not opts.Parent then
		opts.Position = position
	end
	return SoundUtil.Play(name, opts)
end

local notifyRemote: RemoteEvent? = nil
local fxRemote: RemoteEvent? = nil
local notifyTimes: { [Player]: { [string]: number } } = setmetatable({}, { __mode = "k" }) :: any

local function getNotify(): RemoteEvent
	if not notifyRemote then
		notifyRemote = Net.event(Net.Names.Notify)
	end
	return notifyRemote :: RemoteEvent
end

local function getFx(): RemoteEvent
	if not fxRemote then
		fxRemote = Net.event(Net.Names.Fx_Play)
	end
	return fxRemote :: RemoteEvent
end

-- Aviso para um jogador; com `cooldownKey`, no máximo um aviso desse tipo a cada `cooldown` segundos.
function Effects.Notify(player: Player, text: string, kind: string?, cooldownKey: string?, cooldown: number?)
	if not player.Parent then
		return
	end
	if cooldownKey then
		local times = notifyTimes[player]
		if not times then
			times = {}
			notifyTimes[player] = times
		end
		local now = os.clock()
		local last = times[cooldownKey]
		if last and now - last < (cooldown or 6) then
			return
		end
		times[cooldownKey] = now
	end
	getNotify():FireClient(player, text, kind or "info")
end

function Effects.NotifyAll(text: string, kind: string?)
	getNotify():FireAllClients(text, kind or "info")
end

-- Treme a câmera de quem está vivo até `reach` studs da origem (o cliente enfraquece com a distância).
function Effects.Shake(origin: Vector3, reach: number, intensity: number, duration: number)
	local params = {
		intensity = math.clamp(intensity, 0.2, 2),
		duration = math.max(duration, 0.1),
		origin = origin,
		radius = reach,
	}
	for _, player in CombatUtil.GetAlivePlayers() do
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") and (root.Position - origin).Magnitude <= reach then
			getFx():FireClient(player, "shake", params)
		end
	end
end

-- Traço de tiro para todos os clientes.
function Effects.Tracer(from: Vector3, to: Vector3, color: Color3?, width: number?)
	getFx():FireAllClients("tracer", { from = from, to = to, color = color, width = width })
end

-- Nuvem de folhas/poeira rápida (nascimento de NPC). Uma partícula curta, sem loop.
function Effects.Burst(position: Vector3, color: Color3)
	local attachment = Instance.new("Attachment")
	attachment.Name = "NpcBurst"
	attachment.Parent = workspace.Terrain
	attachment.WorldPosition = position
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = LEAF_TEXTURE
	emitter.Color = ColorSequence.new(color)
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 2.6) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })
	emitter.Lifetime = NumberRange.new(0.5, 0.9)
	emitter.Speed = NumberRange.new(4, 9)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Rate = 45
	emitter.LightInfluence = 0.6
	emitter.Parent = attachment
	task.delay(0.25, function()
		if emitter.Parent then
			emitter.Enabled = false
		end
	end)
	Debris:AddItem(attachment, 2)
end

-- Lentidão / prisão de jogadores ----------------------------------------------------------------
-- Pilha própria (só usada se o PhysUtil não existir): o menor teto de velocidade vence e os valores
-- originais voltam quando o último efeito acaba.

local localStacks: { [Humanoid]: any } = {}

local function applyStack(humanoid: Humanoid, entry)
	local speed = entry.baseSpeed
	local jump = 1
	for _, modifier in entry.modifiers do
		speed = math.min(speed, modifier.walkSpeed)
		jump = math.min(jump, modifier.jump)
	end
	humanoid.WalkSpeed = speed
	humanoid.JumpPower = entry.baseJumpPower * jump
	humanoid.JumpHeight = entry.baseJumpHeight * jump
end

local function releaseStack(humanoid: Humanoid, entry, restore: boolean)
	if localStacks[humanoid] ~= entry then
		return
	end
	localStacks[humanoid] = nil
	if entry.diedConnection then
		entry.diedConnection:Disconnect()
	end
	if restore and humanoid.Parent and humanoid.Health > 0 then
		humanoid.WalkSpeed = entry.baseSpeed
		humanoid.JumpPower = entry.baseJumpPower
		humanoid.JumpHeight = entry.baseJumpHeight
	end
end

local function setLocalModifier(humanoid: Humanoid, key: string, walkSpeed: number, jump: number, seconds: number)
	local entry = localStacks[humanoid]
	if not entry then
		entry = {
			baseSpeed = humanoid.WalkSpeed,
			baseJumpPower = humanoid.JumpPower,
			baseJumpHeight = humanoid.JumpHeight,
			modifiers = {},
			tokens = {},
			diedConnection = nil,
		}
		localStacks[humanoid] = entry
		entry.diedConnection = humanoid.Died:Connect(function()
			releaseStack(humanoid, entry, false)
		end)
	end
	local token = {}
	entry.modifiers[key] = { walkSpeed = walkSpeed, jump = jump }
	entry.tokens[key] = token
	applyStack(humanoid, entry)
	task.delay(seconds, function()
		if localStacks[humanoid] ~= entry or entry.tokens[key] ~= token then
			return
		end
		entry.modifiers[key] = nil
		entry.tokens[key] = nil
		if next(entry.modifiers) == nil then
			releaseStack(humanoid, entry, true)
		elseif humanoid.Parent and humanoid.Health > 0 then
			applyStack(humanoid, entry)
		end
	end)
end

-- Deixa o jogador lento por `seconds` (chamar de novo com a mesma chave renova o tempo, sem empilhar).
function Effects.Slow(player: Player, key: string, walkSpeed: number, seconds: number, jumpMultiplier: number?)
	local humanoid = CombatUtil.GetHumanoid(player.Character)
	if not humanoid or humanoid.Health <= 0 then
		return
	end
	local physUtil = getPhysUtil()
	if physUtil then
		local ok, err = pcall(
			physUtil.SetTimedModifier,
			humanoid,
			key,
			{ walkSpeed = walkSpeed, jumpMultiplier = jumpMultiplier },
			seconds
		)
		if ok then
			return
		end
		warn("[NPC] Erro ao aplicar lentidão pelo PhysUtil: " .. tostring(err))
	end
	setLocalModifier(humanoid, key, walkSpeed, math.clamp(jumpMultiplier or 1, 0, 1), seconds)
end

-- Destaque (Highlight) no personagem por alguns segundos; a mesma chave reaproveita o destaque.
local marks: { [Player]: { [string]: any } } = setmetatable({}, { __mode = "k" }) :: any

function Effects.Mark(player: Player, key: string, color: Color3, seconds: number)
	local character = player.Character
	if not character then
		return
	end
	local byKey = marks[player]
	if not byKey then
		byKey = {}
		marks[player] = byKey
	end
	local entry = byKey[key]
	local highlight: Highlight? = entry and entry.highlight
	if not highlight or highlight.Parent ~= character then
		if highlight then
			highlight:Destroy()
		end
		local created = Instance.new("Highlight")
		created.Name = "NpcMarca_" .. key
		created.DepthMode = Enum.HighlightDepthMode.Occluded
		created.Adornee = character
		created.Parent = character
		highlight = created
	end
	local active = highlight :: Highlight
	active.FillColor = color
	active.FillTransparency = 0.6
	active.OutlineColor = color
	active.OutlineTransparency = 0.15
	local token = {}
	byKey[key] = { highlight = active, token = token }
	task.delay(seconds, function()
		local current = marks[player] and marks[player][key]
		if current and current.token == token then
			marks[player][key] = nil
			if active.Parent then
				active:Destroy()
			end
		end
	end)
end

-- Objetos soltos (LooseProp) ---------------------------------------------------------------------

local claims: { [BasePart]: any } = setmetatable({}, { __mode = "k" }) :: any

-- Reserva um objeto para um NPC (dois macacos não pegam o mesmo vaso). Retorna false se já reservado.
function Effects.ClaimProp(part: BasePart, owner: any): boolean
	local current = claims[part]
	if current ~= nil and current ~= owner then
		return false
	end
	claims[part] = owner
	return true
end

function Effects.ReleaseClaim(part: BasePart)
	claims[part] = nil
end

function Effects.ClearClaims()
	table.clear(claims)
end

local function countConnected(part: BasePart): number
	local ok, connected = pcall(part.GetConnectedParts, part, true)
	if ok and type(connected) == "table" then
		return #connected
	end
	return 1
end

-- O objeto ainda é um LooseProp pegável (no mundo, não reservado por outro, não protegido)?
function Effects.IsPropAvailable(part: BasePart, owner: any): boolean
	if not part.Parent or not part:IsDescendantOf(workspace) then
		return false
	end
	local current = claims[part]
	if current ~= nil and current ~= owner then
		return false
	end
	return CollectionService:HasTag(part, Tags.LooseProp)
		and not CollectionService:HasTag(part, Tags.Indestructible)
		and not CollectionService:HasTag(part, Tags.Debris)
end

-- Procura o LooseProp pequeno mais próximo (raiz do objeto) dentro do raio. Ignora os reservados.
function Effects.FindLooseProp(position: Vector3, radius: number, maxSize: number, owner: any): BasePart?
	refreshParams()
	local parts = workspace:GetPartBoundsInRadius(position, radius, propParams)
	local best, bestDistance = nil, math.huge
	for _, part in parts do
		if Effects.IsPropAvailable(part, owner) then
			local offset = part.Position - position
			local distance = offset.Magnitude
			if
				distance < bestDistance
				and math.abs(offset.Y) < 6
				and part.Size.Magnitude <= maxSize
				and countConnected(part) <= PROP_MAX_PARTS
			then
				best, bestDistance = part, distance
			end
		end
	end
	return best
end

-- Solta o objeto (desancora, física no servidor) e aplica velocidade; ele vira pedaço e some depois.
-- Retorna a part raiz lançada (ou nil).
function Effects.LaunchProp(part: BasePart, velocity: Vector3): BasePart?
	if not part.Parent then
		return nil
	end
	claims[part] = nil
	local destruction = Effects.GetDestruction()
	local root: BasePart? = nil
	if destruction and type(destruction.ReleaseProp) == "function" then
		local ok, released = pcall(destruction.ReleaseProp, part, velocity)
		if ok and typeof(released) == "Instance" and released:IsA("BasePart") then
			root = released :: BasePart
		end
	end
	if not root then
		part.Anchored = false
		pcall(part.SetNetworkOwner, part, nil)
		part.AssemblyLinearVelocity = velocity
		part.AssemblyAngularVelocity = Vector3.new(math.random() * 6 - 3, math.random() * 6 - 3, math.random() * 6 - 3)
		root = part
	end
	if destruction and type(destruction.RegisterDebris) == "function" then
		local ok, err = pcall(destruction.RegisterDebris, root)
		if not ok then
			warn("[NPC] Erro ao registrar objeto arremessado: " .. tostring(err))
		end
	end
	return root
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">HealthBar</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Barra de vida dos NPCs: BillboardGui criado no servidor (replica para todos) com o nome do inimigo e a
-- barra colorida. Só muda propriedades quando a vida muda de verdade (pouca rede).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UIKit = require(ReplicatedStorage.Shared.UI.UIKit)

local HealthBar = {}
HealthBar.__index = HealthBar

local Theme = UIKit.Theme

local HIGH = Color3.fromRGB(86, 186, 74)
local MID = Color3.fromRGB(230, 186, 52)
local LOW = Color3.fromRGB(214, 62, 48)

local function colorFor(ratio: number): Color3
	if ratio >= 0.5 then
		return MID:Lerp(HIGH, (ratio - 0.5) * 2)
	end
	return LOW:Lerp(MID, ratio * 2)
end

export type HealthBar = {
	gui: BillboardGui,
	fill: Frame,
	ratio: number,
	Set: (self: any, health: number, maxHealth: number) -> (),
	Destroy: (self: any) -> (),
}

-- Cria a barra presa em `adornee`, `heightOffset` studs acima do centro dela.
function HealthBar.new(
	adornee: BasePart,
	displayName: string,
	heightOffset: number,
	maxDistance: number,
	boss: boolean?
): HealthBar
	local width = if boss then 170 else 116
	local barHeight = if boss then 10 else 8
	local gui = UIKit.Create("BillboardGui", {
		Name = "BarraDeVida",
		Adornee = adornee,
		Size = UDim2.fromOffset(width, barHeight + 20),
		StudsOffsetWorldSpace = Vector3.new(0, heightOffset, 0),
		AlwaysOnTop = false,
		LightInfluence = 0,
		MaxDistance = maxDistance,
		ClipsDescendants = false,
	}) :: BillboardGui

	UIKit.Create("TextLabel", {
		Name = "Nome",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 18),
		Position = UDim2.fromOffset(0, 0),
		Font = Theme.BoldFont,
		Text = displayName,
		TextColor3 = if boss then Theme.Gold else Theme.Text,
		TextSize = if boss then 17 else 14,
		TextStrokeColor3 = Color3.new(0, 0, 0),
		TextStrokeTransparency = 0.35,
		Parent = gui,
	})

	local back = UIKit.Create("Frame", {
		Name = "Fundo",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, 0),
		Size = UDim2.new(1, -8, 0, barHeight),
		BackgroundColor3 = Theme.Background,
		BackgroundTransparency = 0.15,
		BorderSizePixel = 0,
		Parent = gui,
	}) :: Frame
	UIKit.Corner(back, UDim.new(0, 4))
	UIKit.Stroke(back, if boss then Theme.Gold else Theme.WoodDark, 1)

	local fill = UIKit.Create("Frame", {
		Name = "Vida",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = HIGH,
		BorderSizePixel = 0,
		Parent = back,
	}) :: Frame
	UIKit.Corner(fill, UDim.new(0, 4))

	gui.Parent = adornee
	local self = setmetatable({ gui = gui, fill = fill, ratio = 1 }, HealthBar)
	return self :: any
end

function HealthBar:Set(health: number, maxHealth: number)
	local ratio = math.clamp((tonumber(health) or 0) / math.max(tonumber(maxHealth) or 1, 1), 0, 1)
	-- Arredonda para 1% para não replicar mudanças invisíveis.
	ratio = math.floor(ratio * 100 + 0.5) / 100
	if ratio == self.ratio then
		return
	end
	self.ratio = ratio
	self.fill.Size = UDim2.fromScale(ratio, 1)
	self.fill.BackgroundColor3 = colorFor(ratio)
	self.fill.Visible = ratio > 0
end

function HealthBar:Destroy()
	if self.gui then
		self.gui:Destroy()
	end
end

return HealthBar
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">HunterAI</string>
            <string name="Source"><![CDATA[--!nonstrict
-- IA d'O Caçador: humanoide de blocos com rifle. Mantém distância (30 a 60 studs), recua se alguém chega
-- perto e atira de longe:
--   1. mira por 1,2 s com um laser vermelho travado na posição do alvo NO INÍCIO da mira (dá para desviar);
--   2. dispara: raio do cano até o ponto mirado (e além); o primeiro jogador no caminho leva 30 de dano;
--      parede quebrável no caminho leva um impacto (DestructionService); traço "tracer" para todos.
-- Persistente: sem ninguém no raio, vai atrás do jogador vivo mais próximo onde quer que esteja.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local PartBuilder = require(ReplicatedStorage.Shared.Util.PartBuilder)

local CombatUtil = require(script.Parent.Parent.CombatUtil)
local Brain = require(script.Parent.Brain)
local Effects = require(script.Parent.Effects)

local HunterAI = {}

local MIN_DISTANCE, MAX_DISTANCE = 30, 60
local SHOOT_RANGE = 95
local AIM_TIME = 1.2
local AIM_WARN_TIME = 0.8 -- o laser engrossa: o tiro está chegando
local SHOT_EXTRA_RANGE = 30
local MAX_SHOT_RANGE = 180
local RECOVER_TIME = 0.45
local FIRST_SHOT_DELAY = 2
local RETREAT_STEP = 16
local RETREAT_REPICK = 0.8
local STRAFE_STEP = 8
local STRAFE_SWITCH = 2.5
local ISLAND_SAFE_MARGIN = 25 -- não recua para fora da ilha
local WALL_FRACTURE_IMPULSE = 35
local LASER_COLOR = Color3.fromRGB(255, 30, 30)
local TRACER_COLOR = Color3.fromRGB(255, 214, 140)
local SOURCE = "O Caçador"

-- Laser ----------------------------------------------------------------------------------------------

local function clearLaser(npc)
	local laser = npc.memory.laser
	npc.memory.laser = nil
	if laser then
		for _, item in laser do
			if typeof(item) == "Instance" and item.Parent then
				item:Destroy()
			end
		end
	end
end

local function createLaser(npc, aimPoint: Vector3)
	clearLaser(npc)
	local muzzle: Attachment? = npc.rig.extras.muzzle
	if not muzzle or not muzzle.Parent then
		return
	end
	local finish = Instance.new("Attachment")
	finish.Name = "MiraDoCacador"
	finish.Parent = workspace.Terrain
	finish.WorldPosition = aimPoint

	local beam = Instance.new("Beam")
	beam.Name = "Laser"
	beam.Attachment0 = muzzle
	beam.Attachment1 = finish
	beam.Color = ColorSequence.new(LASER_COLOR)
	beam.Width0 = 0.12
	beam.Width1 = 0.12
	beam.LightEmission = 1
	beam.LightInfluence = 0
	beam.FaceCamera = true
	beam.Segments = 1
	beam.Transparency = NumberSequence.new(0.15)
	beam.Parent = muzzle.Parent

	local dot = PartBuilder.part({
		Name = "PontoVermelho",
		Color = LASER_COLOR,
		Material = Enum.Material.Neon,
		CanCollide = false,
		CanTouch = false,
		CastShadow = false,
	}) :: Part
	dot.CanQuery = false
	dot.Shape = Enum.PartType.Ball
	dot.Size = Vector3.new(0.7, 0.7, 0.7)
	dot.CFrame = CFrame.new(aimPoint)
	dot.Parent = Effects.Folder()

	npc.memory.laser = { finish, beam, dot }
	npc.memory.beam = beam
end

-- Tiro -----------------------------------------------------------------------------------------------

local function fire(npc, now: number)
	local memory = npc.memory
	local aimPoint: Vector3 = memory.aimPoint
	local muzzle: Attachment? = npc.rig.extras.muzzle
	local origin = if muzzle and muzzle.Parent then muzzle.WorldPosition else Brain.EyePosition(npc)
	local direction = aimPoint - origin
	if direction.Magnitude < 1 then
		direction = npc.root.CFrame.LookVector
	end
	local range = math.min(direction.Magnitude + SHOT_EXTRA_RANGE, MAX_SHOT_RANGE)
	local player, hitPosition, world = Effects.CastShot(origin, direction, range)
	if player then
		CombatUtil.DamagePlayer(player, npc.damage, SOURCE)
	elseif world and world.Instance then
		local destruction = Effects.GetDestruction()
		local hitPart = world.Instance
		if destruction and type(destruction.Fracture) == "function" and hitPart:IsA("BasePart") then
			local ok, err = pcall(destruction.Fracture, hitPart, world.Position, WALL_FRACTURE_IMPULSE)
			if not ok then
				warn("[HunterAI] Erro ao quebrar a parede atingida: " .. tostring(err))
			end
		end
	end
	Effects.Tracer(origin, hitPosition, TRACER_COLOR, 0.14)
	-- O som do tiro não passa pelo limite de repetição (cada tiro é importante para o jogador reagir).
	Effects.Sound("Gunshot", origin, { Volume = 0.9, RollOffMaxDistance = 400 })
	clearLaser(npc)
	memory.nextShot = now + npc.def.attackCooldown
	memory.state = "recover"
	memory.recoverUntil = now + RECOVER_TIME
end

local function startAim(npc, now: number, targetRoot: BasePart)
	local memory = npc.memory
	Brain.Stop(npc)
	if npc.humanoid then
		npc.humanoid.AutoRotate = false
	end
	memory.aimPoint = targetRoot.Position
	memory.aimStart = now
	memory.warned = false
	memory.state = "aim"
	Brain.Face(npc, memory.aimPoint)
	createLaser(npc, memory.aimPoint)
	Effects.Sound("Reload", npc.root.Position, { Volume = 0.7, RollOffMaxDistance = 120 })
end

-- Movimento ------------------------------------------------------------------------------------------

local function insideIsland(position: Vector3): boolean
	return Brain.FlatDistance(position, GameConfig.ISLAND_CENTER) <= GameConfig.ISLAND_RADIUS - ISLAND_SAFE_MARGIN
end

-- Ponto livre a `step` studs na direção `direction` (sem parede no meio e com chão). Ou nil.
local function freeSpot(npc, direction: Vector3, step: number): Vector3?
	local root: BasePart = npc.root
	local origin = root.Position
	local hit = workspace:Raycast(origin, direction * step, Effects.WorldParams())
	if hit then
		return nil
	end
	local candidate = origin + direction * step
	if not insideIsland(candidate) then
		return nil
	end
	return Effects.Ground(candidate, 14, 4)
end

local function rotate(direction: Vector3, angle: number): Vector3
	return (CFrame.Angles(0, angle, 0) * direction).Unit
end

local function retreat(npc, now: number, targetRoot: BasePart): boolean
	local memory = npc.memory
	local goal: Vector3? = memory.retreatGoal
	if goal and now < (memory.retreatUntil or 0) then
		npc.wantsMove = true
		if now - (npc.lastMoveTo or 0) >= 0.4 then
			Brain.MoveTo(npc, goal, now)
		end
		Brain.CheckStuck(npc, now)
		return true
	end
	local away = Brain.FlatUnit(npc.root.Position - targetRoot.Position, -npc.root.CFrame.LookVector)
	for _, angle in { 0, 0.7, -0.7, 1.4, -1.4 } do
		local spot = freeSpot(npc, rotate(away, angle), RETREAT_STEP)
		if spot then
			memory.retreatGoal = spot
			memory.retreatUntil = now + RETREAT_REPICK
			npc.wantsMove = true
			Brain.MoveTo(npc, spot, now)
			return true
		end
	end
	memory.retreatGoal = nil
	return false
end

local function strafe(npc, now: number, targetRoot: BasePart)
	local memory = npc.memory
	if now >= (memory.nextStrafeSwitch or 0) then
		memory.nextStrafeSwitch = now + STRAFE_SWITCH
		memory.strafeSign = -(memory.strafeSign or 1)
		local toTarget = Brain.FlatUnit(targetRoot.Position - npc.root.Position)
		local side = Vector3.new(-toTarget.Z, 0, toTarget.X) * memory.strafeSign
		local spot = freeSpot(npc, side, STRAFE_STEP) or freeSpot(npc, -side, STRAFE_STEP)
		if spot then
			Brain.MoveTo(npc, spot, now)
		end
	end
	npc.wantsMove = false
end

-- Ciclo ----------------------------------------------------------------------------------------------

function HunterAI.Setup(npc, now: number)
	local memory = npc.memory
	memory.state = "move"
	memory.nextShot = now + FIRST_SHOT_DELAY
	memory.strafeSign = if npc.rng:NextNumber() < 0.5 then 1 else -1
	memory.nextStrafeSwitch = now
	Effects.Burst(npc.root.Position, Color3.fromRGB(120, 100, 70))
end

function HunterAI.Think(npc, now: number, _dt: number): number?
	local memory = npc.memory
	local def = npc.def

	if memory.state == "aim" then
		Brain.Face(npc, memory.aimPoint)
		if not memory.warned and now - memory.aimStart >= AIM_WARN_TIME then
			memory.warned = true
			local beam: Beam? = memory.beam
			if beam and beam.Parent then
				beam.Width0 = 0.25
				beam.Width1 = 0.25
			end
		end
		if now - memory.aimStart >= AIM_TIME then
			fire(npc, now)
			return 0.1
		end
		return 0.05
	elseif memory.state == "recover" then
		if now < memory.recoverUntil then
			return 0.1
		end
		memory.state = "move"
		if npc.humanoid then
			npc.humanoid.AutoRotate = true
		end
	end

	local _target, targetRoot, distance = Brain.UpdateTarget(npc, now)
	if not targetRoot then
		Brain.Wander(npc, now, 20)
		return def.idleInterval
	end

	local canSee = Brain.LineOfSight(npc, now, targetRoot.Position)
	if canSee and distance <= SHOOT_RANGE and now >= memory.nextShot then
		startAim(npc, now, targetRoot)
		return 0.05
	end

	if distance < MIN_DISTANCE then
		if not retreat(npc, now, targetRoot) then
			strafe(npc, now, targetRoot)
		end
	elseif distance > MAX_DISTANCE or not canSee then
		memory.retreatGoal = nil
		Brain.ChaseTo(npc, now, targetRoot.Position, canSee)
	else
		memory.retreatGoal = nil
		strafe(npc, now, targetRoot)
	end
	return nil
end

function HunterAI.Cleanup(npc)
	clearLaser(npc)
	if npc.humanoid and npc.humanoid.Parent then
		npc.humanoid.AutoRotate = true
	end
end

return HunterAI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">Kinds</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Ficha de cada tipo de inimigo: nome exibido (pt-BR), vida, dano, velocidade, alcance, ritmo da IA e
-- parâmetros de caminho. Ajuste o balanceamento aqui sem mexer na IA.

export type KindDef = {
	kind: string,
	displayName: string, -- nome na barra de vida e motivo da eliminação
	movement: string, -- "ground" (Humanoid) | "flying" (CFrame ancorado) | "static" (parado)
	health: number,
	damage: number, -- dano do ataque principal (mordida, garra, tiro, picada)
	walkSpeed: number,
	jumpPower: number,
	thinkInterval: number, -- segundos entre decisões quando há alvo
	idleInterval: number, -- segundos entre decisões sem alvo
	aggroRadius: number, -- distância em que percebe um jogador
	leashRadius: number, -- distância em que desiste do alvo atual
	attackRange: number,
	attackCooldown: number,
	agentRadius: number, -- PathfindingService
	agentHeight: number,
	waypointReach: number, -- distância (XZ) para considerar um ponto do caminho alcançado
	barMaxDistance: number, -- distância máxima em que a barra de vida aparece
	boss: boolean, -- barra de vida maior
	persistent: boolean, -- sem ninguém no raio, vai atrás do jogador vivo mais próximo onde estiver
	sound: string?, -- som característico (Config/Sounds)
}

local Kinds = {}

local Defs: { [string]: KindDef } = {
	Monkey = {
		kind = "Monkey",
		displayName = "Macaco",
		movement = "ground",
		health = 30,
		damage = 6,
		walkSpeed = 22,
		jumpPower = 65, -- pula muito
		thinkInterval = 0.15,
		idleInterval = 0.5,
		aggroRadius = 150,
		leashRadius = 220,
		attackRange = 4.5,
		attackCooldown = 1,
		agentRadius = 1.2,
		agentHeight = 3.2,
		waypointReach = 3,
		barMaxDistance = 80,
		boss = false,
		persistent = false,
		sound = "Monkey",
	},
	Lion = {
		kind = "Lion",
		displayName = "Leão",
		movement = "ground",
		health = 220,
		damage = 25,
		walkSpeed = 24,
		jumpPower = 40,
		thinkInterval = 0.15,
		idleInterval = 0.5,
		aggroRadius = 150,
		leashRadius = 230,
		attackRange = 7.5,
		attackCooldown = 1.4,
		agentRadius = 2,
		agentHeight = 6.5,
		waypointReach = 3.5,
		barMaxDistance = 120,
		boss = false,
		persistent = false,
		sound = "Roar",
	},
	Hunter = {
		kind = "Hunter",
		displayName = "O Caçador",
		movement = "ground",
		health = 250,
		damage = 30,
		walkSpeed = 14,
		jumpPower = 50,
		thinkInterval = 0.15,
		idleInterval = 0.4,
		aggroRadius = 170,
		leashRadius = 400,
		attackRange = 95, -- alcance do rifle
		attackCooldown = 2.2,
		agentRadius = 1.6,
		agentHeight = 6.2,
		waypointReach = 2.5,
		barMaxDistance = 160,
		boss = true,
		persistent = true,
		sound = "Gunshot",
	},
	Spider = {
		kind = "Spider",
		displayName = "Aranha Gigante",
		movement = "ground",
		health = 60,
		damage = 12,
		walkSpeed = 20,
		jumpPower = 50,
		thinkInterval = 0.15,
		idleInterval = 0.5,
		aggroRadius = 150,
		leashRadius = 220,
		attackRange = 5.5,
		attackCooldown = 1.1,
		agentRadius = 2,
		agentHeight = 4.6,
		waypointReach = 3,
		barMaxDistance = 100,
		boss = false,
		persistent = false,
		sound = "Spider",
	},
	Mosquito = {
		kind = "Mosquito",
		displayName = "Mosquito Gigante",
		movement = "flying",
		health = 20,
		damage = 6,
		walkSpeed = 24,
		jumpPower = 0,
		thinkInterval = 0.05, -- voo por CFrame: 20 passos por segundo
		idleInterval = 0.3,
		aggroRadius = 150,
		leashRadius = 220,
		attackRange = 3,
		attackCooldown = 1.2,
		agentRadius = 1,
		agentHeight = 2,
		waypointReach = 2,
		barMaxDistance = 70,
		boss = false,
		persistent = false,
		sound = "Mosquito",
	},
	Plant = {
		kind = "Plant",
		displayName = "Planta Carnívora",
		movement = "static",
		health = 80,
		damage = 12,
		walkSpeed = 0,
		jumpPower = 0,
		thinkInterval = 0.15,
		idleInterval = 0.5,
		aggroRadius = 18, -- acompanha o jogador com a cabeça a partir daqui
		leashRadius = 18,
		attackRange = 9,
		attackCooldown = 1.2,
		agentRadius = 1,
		agentHeight = 6,
		waypointReach = 2,
		barMaxDistance = 90,
		boss = false,
		persistent = false,
		sound = nil,
	},
}

Kinds.Defs = Defs
Kinds.List = { "Monkey", "Lion", "Hunter", "Spider", "Mosquito", "Plant" }

function Kinds.Get(kind: string): KindDef?
	return Defs[kind]
end

return Kinds
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">LionAI</string>
            <string name="Source"><![CDATA[--!nonstrict
-- IA do Leão: persegue rápido, dá garradas fortes de perto (com empurrão) e, entre 10 e 25 studs com
-- visão livre, dá um BOTE (salto) a cada 4 s. Ruge ao nascer e de tempos em tempos (a câmera treme).
-- O bote usa AssemblyLinearVelocity na raiz (a física do leão é do servidor) e, durante o salto, o
-- WalkSpeed acompanha a velocidade do pulo para o controle do Humanoid não frear o leão no ar.

local CombatUtil = require(script.Parent.Parent.CombatUtil)
local Brain = require(script.Parent.Brain)
local Effects = require(script.Parent.Effects)

local LionAI = {}

local POUNCE_MIN, POUNCE_MAX = 10, 25
local POUNCE_COOLDOWN = 4
local POUNCE_UP = 40 -- velocidade vertical do bote (igual ao JumpPower do leão)
local POUNCE_MIN_SPEED, POUNCE_MAX_SPEED = 30, 85
local POUNCE_EXTRA_TIME = 0.35 -- tempo extra depois do pouso estimado
local POUNCE_HIT_RANGE = 8
local POUNCE_KNOCKBACK = 70
local CLAW_KNOCKBACK = 35
local ROAR_MIN, ROAR_MAX = 12, 20
local SOURCE = "Leão"
local SPAWN_DUST = Color3.fromRGB(196, 160, 100)

local function roar(npc)
	local position = npc.root.Position
	Effects.Sound("Roar", position, { Volume = 1, RollOffMaxDistance = 300 })
	Effects.Shake(position, 80, 0.6, 0.7)
end

local function endPounce(npc, now: number)
	local memory = npc.memory
	memory.state = "chase"
	memory.nextPounce = now + POUNCE_COOLDOWN
	if npc.humanoid then
		npc.humanoid.WalkSpeed = npc.def.walkSpeed
	end
end

local function startPounce(npc, now: number, targetRoot: BasePart)
	local memory = npc.memory
	local root: BasePart = npc.root
	local humanoid: Humanoid = npc.humanoid
	local lead = targetRoot.AssemblyLinearVelocity
	local predicted = targetRoot.Position + Vector3.new(lead.X, 0, lead.Z) * 0.3
	local offset = Vector3.new(predicted.X - root.Position.X, 0, predicted.Z - root.Position.Z)
	local distance = offset.Magnitude
	local direction = Brain.FlatUnit(offset, root.CFrame.LookVector)
	local airTime = 2 * POUNCE_UP / math.max(workspace.Gravity, 1)
	local horizontal = math.clamp((distance - 3) / airTime, POUNCE_MIN_SPEED, POUNCE_MAX_SPEED)

	Brain.Face(npc, predicted)
	humanoid.WalkSpeed = horizontal
	Brain.MoveTo(npc, root.Position + direction * (distance + 4), now)
	pcall(humanoid.ChangeState, humanoid, Enum.HumanoidStateType.Jumping)
	root.AssemblyLinearVelocity = direction * horizontal + Vector3.new(0, POUNCE_UP, 0)

	memory.state = "pounce"
	memory.pounceEnd = now + airTime + POUNCE_EXTRA_TIME
	memory.pounceHit = false
	npc.wantsMove = false
	roar(npc)
end

function LionAI.Setup(npc, now: number)
	local memory = npc.memory
	memory.state = "chase"
	memory.nextPounce = now + 2
	memory.nextRoar = now + npc.rng:NextNumber(ROAR_MIN * 0.5, ROAR_MAX * 0.5)
	Effects.Burst(npc.root.Position, SPAWN_DUST)
	roar(npc)
end

function LionAI.Think(npc, now: number, _dt: number): number?
	local memory = npc.memory
	local def = npc.def
	local target, targetRoot, distance = Brain.UpdateTarget(npc, now)

	if memory.state == "pounce" then
		if target and targetRoot and not memory.pounceHit and distance <= POUNCE_HIT_RANGE then
			memory.pounceHit = true
			CombatUtil.DamagePlayer(target, npc.damage, SOURCE)
			CombatUtil.Knockback(target, targetRoot.Position - npc.root.Position, POUNCE_KNOCKBACK)
		end
		if now < memory.pounceEnd then
			return 0.05
		end
		endPounce(npc, now)
	end

	if not target or not targetRoot then
		Brain.Wander(npc, now, 20)
		return def.idleInterval
	end

	if now >= memory.nextRoar then
		memory.nextRoar = now + npc.rng:NextNumber(ROAR_MIN, ROAR_MAX)
		roar(npc)
	end

	-- Garrada.
	if distance <= def.attackRange then
		if Brain.Melee(npc, now, target, targetRoot) then
			CombatUtil.Knockback(target, targetRoot.Position - npc.root.Position, CLAW_KNOCKBACK)
		end
		Brain.ChaseTo(npc, now, targetRoot.Position, true, def.attackRange * 0.7)
		return nil
	end

	-- Bote.
	local canSee: boolean? = nil
	local dy = targetRoot.Position.Y - npc.root.Position.Y
	if
		now >= memory.nextPounce
		and distance >= POUNCE_MIN
		and distance <= POUNCE_MAX
		and math.abs(dy) < 5
		and Brain.IsGrounded(npc)
	then
		canSee = Brain.LineOfSight(npc, now, targetRoot.Position)
		if canSee then
			startPounce(npc, now, targetRoot)
			return 0.05
		end
	end

	Brain.ChaseTo(npc, now, targetRoot.Position, canSee)
	return nil
end

function LionAI.Cleanup(_npc) end

return LionAI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">MonkeyAI</string>
            <string name="Source"><![CDATA[--!nonstrict
-- IA do Macaco: pequeno, rápido e saltitante. Persegue e morde de perto; de vez em quando (30%) corre até
-- um objeto solto (LooseProp) próximo, ergue acima da cabeça e arremessa num jogador (10 de dano ao
-- acertar). Sem ninguém por perto, "saqueia": derruba objetos soltos ao redor.

local Brain = require(script.Parent.Brain)
local Effects = require(script.Parent.Effects)
local Projectiles = require(script.Parent.Projectiles)

local MonkeyAI = {}

local THROW_CHECK_INTERVAL = 2.2
local THROW_CHANCE = 0.3
local THROW_MIN_DISTANCE = 10
local THROW_MAX_DISTANCE = 45
local THROW_SPEED = 45 -- define o tempo de voo (distância / velocidade)
local THROW_DAMAGE = 10
local PROP_SEARCH_RADIUS = 14
local PROP_MAX_SIZE = 6 -- tamanho máximo (magnitude do Size) de um objeto arremessável
local PICK_DISTANCE = 4.5
local FETCH_TIMEOUT = 3
local HOLD_TIME = 0.5
local HOP_CHANCE = 0.05 -- por decisão, enquanto persegue
local LOOT_RADIUS = 9
local LOOT_INTERVAL_MIN, LOOT_INTERVAL_MAX = 5, 9
local CHATTER_MIN, CHATTER_MAX = 5, 11
local SOURCE = "Macaco"
local SPAWN_LEAVES = Color3.fromRGB(70, 130, 50)

local function chatter(npc)
	Effects.Sound("Monkey", npc.root.Position, { Volume = 0.55, RollOffMaxDistance = 90 })
end

local function holdCFrame(npc, prop: BasePart): CFrame
	local height = npc.rig.topOffset + prop.Size.Y / 2 + 0.4
	return CFrame.new(npc.root.Position + Vector3.new(0, height, 0)) * prop.CFrame.Rotation
end

-- Larga o objeto (se estava segurando, ele cai) e libera a reserva.
local function releaseProp(npc)
	local memory = npc.memory
	local prop: BasePart? = memory.prop
	memory.prop = nil
	if prop then
		Effects.ReleaseClaim(prop)
		if memory.holding and prop.Parent then
			Effects.LaunchProp(prop, Vector3.new(0, -2, 0))
		end
	end
	memory.holding = false
end

local function pick(npc, prop: BasePart, now: number)
	local memory = npc.memory
	-- Ancorado enquanto está nas mãos: mover a raiz move o objeto inteiro (partes soldadas).
	prop.Anchored = true
	prop.CFrame = holdCFrame(npc, prop)
	memory.holding = true
	memory.state = "hold"
	memory.throwAt = now + HOLD_TIME
	Brain.Stop(npc)
	chatter(npc)
end

local function throw(npc, prop: BasePart, targetRoot: BasePart)
	local memory = npc.memory
	memory.prop = nil
	memory.holding = false
	local start = prop.Position
	local aim = targetRoot.Position
	local flight = math.clamp((aim - start).Magnitude / THROW_SPEED, 0.35, 1.1)
	-- Mira um pouco à frente de quem corre (dá para desviar parando ou mudando de direção).
	local lead = targetRoot.AssemblyLinearVelocity
	aim += Vector3.new(lead.X, 0, lead.Z) * flight * 0.5
	local velocity = Projectiles.BallisticVelocity(start, aim, flight)
	local launched = Effects.LaunchProp(prop, velocity)
	if launched then
		Projectiles.TrackProp(npc, launched, { damage = THROW_DAMAGE, source = SOURCE, lifetime = flight + 1 })
	end
	chatter(npc)
end

function MonkeyAI.Setup(npc, now: number)
	local memory = npc.memory
	local rng: Random = npc.rng
	memory.state = "chase"
	memory.nextThrowCheck = now + rng:NextNumber(1, THROW_CHECK_INTERVAL)
	memory.nextLoot = now + rng:NextNumber(2, LOOT_INTERVAL_MAX)
	memory.nextChatter = now + rng:NextNumber(1, CHATTER_MAX)
	Effects.Burst(npc.root.Position, SPAWN_LEAVES)
end

function MonkeyAI.Think(npc, now: number, _dt: number): number?
	local memory = npc.memory
	local rng: Random = npc.rng
	local def = npc.def
	local target, targetRoot, distance = Brain.UpdateTarget(npc, now)

	-- Segurando um objeto acima da cabeça.
	if memory.state == "hold" then
		local prop: BasePart? = memory.prop
		if not prop or not prop.Parent then
			releaseProp(npc)
			memory.state = "chase"
		else
			prop.CFrame = holdCFrame(npc, prop)
			if targetRoot then
				Brain.Face(npc, targetRoot.Position)
			end
			if now >= memory.throwAt then
				if
					targetRoot
					and distance <= THROW_MAX_DISTANCE + 10
					and Brain.LineOfSight(npc, now, targetRoot.Position)
				then
					throw(npc, prop, targetRoot)
				else
					releaseProp(npc)
				end
				memory.state = "chase"
			end
			return 0.1
		end
	end

	-- Indo buscar um objeto.
	if memory.state == "fetch" then
		local prop: BasePart? = memory.prop
		if not prop or now >= memory.fetchUntil or not Effects.IsPropAvailable(prop, npc) then
			releaseProp(npc)
			memory.state = "chase"
		else
			local offset = prop.Position - npc.root.Position
			if Vector3.new(offset.X, 0, offset.Z).Magnitude <= PICK_DISTANCE and math.abs(offset.Y) < 5 then
				pick(npc, prop, now)
				return 0.1
			end
			npc.wantsMove = true
			if now - (npc.lastMoveTo or 0) >= 0.3 then
				Brain.MoveTo(npc, prop.Position, now)
			end
			Brain.CheckStuck(npc, now)
			return nil
		end
	end

	if not target or not targetRoot then
		-- Saqueio: derruba um objeto solto por perto de vez em quando.
		if now >= memory.nextLoot then
			memory.nextLoot = now + rng:NextNumber(LOOT_INTERVAL_MIN, LOOT_INTERVAL_MAX)
			local prop = Effects.FindLooseProp(npc.root.Position, LOOT_RADIUS, PROP_MAX_SIZE, npc)
			if prop then
				local angle = rng:NextNumber(0, math.pi * 2)
				Effects.LaunchProp(prop, Vector3.new(math.cos(angle) * 14, 12, math.sin(angle) * 14))
				chatter(npc)
			end
		end
		Brain.Wander(npc, now, 18)
		return def.idleInterval
	end

	if now >= memory.nextChatter then
		memory.nextChatter = now + rng:NextNumber(CHATTER_MIN, CHATTER_MAX)
		chatter(npc)
	end

	-- Mordida de perto.
	if distance <= def.attackRange + 1 then
		Brain.Melee(npc, now, target, targetRoot)
		Brain.ChaseTo(npc, now, targetRoot.Position, true, def.attackRange * 0.6)
		return nil
	end

	-- Às vezes, pega algo para arremessar.
	if now >= memory.nextThrowCheck and distance >= THROW_MIN_DISTANCE and distance <= THROW_MAX_DISTANCE then
		memory.nextThrowCheck = now + THROW_CHECK_INTERVAL
		if rng:NextNumber() < THROW_CHANCE and Brain.LineOfSight(npc, now, targetRoot.Position) then
			local prop = Effects.FindLooseProp(npc.root.Position, PROP_SEARCH_RADIUS, PROP_MAX_SIZE, npc)
			if prop and Effects.ClaimProp(prop, npc) then
				memory.prop = prop
				memory.state = "fetch"
				memory.fetchUntil = now + FETCH_TIMEOUT
				return 0.1
			end
		end
	end

	Brain.ChaseTo(npc, now, targetRoot.Position)
	if Brain.IsGrounded(npc) and rng:NextNumber() < HOP_CHANCE then
		npc.humanoid.Jump = true
	end
	return nil
end

-- Morte ou remoção: solta o que estiver segurando.
function MonkeyAI.Cleanup(npc)
	releaseProp(npc)
end

return MonkeyAI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="71">
          <Properties>
            <string name="Name">MosquitoAI</string>
            <string name="Source"><![CDATA[--!nonstrict
-- IA do Mosquito Gigante (voador, sem Humanoid). O corpo é ancorado e se move por CFrame (só a raiz
-- replica; o resto do corpo vai soldado). Comportamento:
--   * enxame: circula em volta do alvo, alguns studs acima da cabeça, cada um num raio/altura/sentido;
--   * rasante: com visão livre e perto, mergulha em linha reta até onde o alvo ESTAVA (dá para desviar);
--     se passar pelo jogador, pica (6 de dano) e deixa "febre" (1 de dano por segundo por 4 s, sem
--     acumular: uma nova picada só renova o tempo). No máximo 2 mosquitos mergulham no mesmo alvo;
--   * colisão barata: um raio por passo; encostou numa parede, desliza; preso por 1 s, atravessa;
--   * sem alvo: paira perto de onde nasceu.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local SoundUtil = require(ReplicatedStorage.Shared.Audio.SoundUtil)

local CombatUtil = require(script.Parent.Parent.CombatUtil)
local Brain = require(script.Parent.Brain)
local Effects = require(script.Parent.Effects)

local MosquitoAI = {}

local ACCELERATION = 5 -- quão rápido a velocidade converge para a desejada (por segundo)
local DIVE_SPEED = 55
local IDLE_SPEED = 8
local APPROACH_DISTANCE = 24 -- além disto, voa direto para o alvo
local ORBIT_RADIUS_MIN, ORBIT_RADIUS_MAX = 7, 12
local ORBIT_HEIGHT_MIN, ORBIT_HEIGHT_MAX = 4, 8
local ORBIT_SPEED_MIN, ORBIT_SPEED_MAX = 1.1, 2.2 -- radianos por segundo
local DIVE_RANGE = 30
local DIVE_COOLDOWN_MIN, DIVE_COOLDOWN_MAX = 2.5, 5
local DIVE_MAX_TIME = 1.3
local DIVE_LEAD = 0.25 -- segundos de antecipação do movimento do alvo
local DIVE_OVERSHOOT = 3 -- passa um pouco do ponto mirado
local MAX_DIVERS_PER_TARGET = 2
local BITE_RADIUS = 3.2
local RETREAT_TIME = 0.7
local GROUND_CLEARANCE = 1.5
local GROUND_CHECK = 0.25
local WALL_MARGIN = 0.8
local STUCK_LIMIT = 1
local PHASE_TIME = 0.6
local BOB_SPEED = 9
local BOB_AMPLITUDE = 0.25
local FEVER_TICK = 1
local FEVER_DAMAGE = 1
local FEVER_TIME = 4
local FEVER_SOURCE = "Febre do Mosquito"
local BUZZ_CHANCE = 0.35 -- parte do enxame zumbe sem parar (som em loop preso no corpo)
local SPAWN_PUFF = Color3.fromRGB(110, 120, 90)

-- Quantos mosquitos estão mergulhando em cada jogador agora.
local divers: { [Player]: number } = setmetatable({}, { __mode = "k" }) :: any
-- Febre de cada jogador: { untilTime }. Uma única thread por febre cuida do dano.
local fevers: { [Player]: { untilTime: number } } = setmetatable({}, { __mode = "k" }) :: any

-- Febre ------------------------------------------------------------------------------------------

local function giveFever(player: Player)
	local now = os.clock()
	local current = fevers[player]
	if current then
		-- Já está com febre: só renova o tempo (não acumula).
		current.untilTime = now + FEVER_TIME
		return
	end
	local entry = { untilTime = now + FEVER_TIME }
	fevers[player] = entry
	Effects.Notify(player, "A picada deu febre! Você vai perder um pouco de vida.", "warning", "febre", 8)
	task.spawn(function()
		while fevers[player] == entry do
			task.wait(FEVER_TICK)
			if
				fevers[player] ~= entry
				or os.clock() > entry.untilTime + 0.05
				or not player.Parent
				or not CombatUtil.IsPlayerAlive(player)
			then
				break
			end
			CombatUtil.DamagePlayer(player, FEVER_DAMAGE, FEVER_SOURCE)
		end
		if fevers[player] == entry then
			fevers[player] = nil
		end
	end)
end

-- Mergulhos --------------------------------------------------------------------------------------

local function releaseDive(npc)
	local memory = npc.memory
	local player: Player? = memory.divingOn
	memory.divingOn = nil
	if player then
		local count = (divers[player] or 1) - 1
		divers[player] = if count > 0 then count else nil
	end
end

local function startDive(npc, now: number, target: Player, targetRoot: BasePart)
	local memory = npc.memory
	local velocity = targetRoot.AssemblyLinearVelocity
	local aim = targetRoot.Position + Vector3.new(velocity.X, 0, velocity.Z) * DIVE_LEAD
	local offset = aim - memory.pos
	if offset.Magnitude < 1 then
		return
	end
	memory.state = "dive"
	memory.diveTo = aim + offset.Unit * DIVE_OVERSHOOT
	memory.diveEnd = now + DIVE_MAX_TIME
	memory.divingOn = target
	divers[target] = (divers[target] or 0) + 1
	Effects.Sound("Mosquito", memory.pos, { Volume = 0.7, PlaybackSpeed = 1.3, RollOffMaxDistance = 80 })
end

local function startRetreat(npc, now: number)
	local memory = npc.memory
	releaseDive(npc)
	local rng: Random = npc.rng
	local angle = rng:NextNumber(0, math.pi * 2)
	memory.state = "retreat"
	memory.retreatTo = memory.pos + Vector3.new(math.cos(angle) * 8, rng:NextNumber(5, 8), math.sin(angle) * 8)
	memory.retreatEnd = now + RETREAT_TIME
	memory.nextDive = now + rng:NextNumber(DIVE_COOLDOWN_MIN, DIVE_COOLDOWN_MAX)
end

local function bite(npc, player: Player)
	CombatUtil.DamagePlayer(player, npc.damage, npc.def.displayName)
	giveFever(player)
	Effects.Sound("Mosquito", npc.memory.pos, { Volume = 0.8, PlaybackSpeed = 0.8, RollOffMaxDistance = 60 })
end

-- Movimento --------------------------------------------------------------------------------------

local function faceCFrame(position: Vector3, direction: Vector3): CFrame
	local look = direction
	if look.Magnitude < 1e-3 then
		return CFrame.new(position)
	end
	look = look.Unit
	if math.abs(look.Y) > 0.9 then
		-- Quase vertical: inclina sem perder a referência de "cima".
		local flat = Brain.FlatUnit(look)
		look = (flat + Vector3.new(0, math.sign(look.Y) * 2, 0)).Unit
	end
	return CFrame.lookAt(position, position + look)
end

-- Move a posição lógica em direção a `desired` com velocidade máxima `speed`, desviando de paredes.
local function fly(npc, now: number, dt: number, desired: Vector3, speed: number, keepAboveGround: boolean)
	local memory = npc.memory
	local pos: Vector3 = memory.pos
	local offset = desired - pos
	local distance = offset.Magnitude
	local wanted = Vector3.zero
	if distance > 0.05 then
		wanted = offset.Unit * math.min(speed, distance / math.max(dt, 1 / 30))
	end
	local accel = if memory.state == "dive" then ACCELERATION * 3 else ACCELERATION
	local velocity: Vector3 = memory.vel:Lerp(wanted, math.clamp(dt * accel, 0, 1))
	local move = velocity * dt
	local intended = move.Magnitude

	if intended > 1e-3 and now >= (memory.phaseUntil or 0) then
		local params = Effects.WorldParams()
		local hit = workspace:Raycast(pos, move.Unit * (intended + WALL_MARGIN), params)
		if hit then
			local normal = hit.Normal
			-- Desliza na superfície (tira o componente que entra na parede).
			local slide = move - normal * move:Dot(normal)
			velocity -= normal * math.min(velocity:Dot(normal), 0)
			if
				slide.Magnitude > 1e-3
				and not workspace:Raycast(pos, slide.Unit * (slide.Magnitude + WALL_MARGIN), params)
			then
				move = slide
			else
				move = Vector3.zero
			end
			-- Encostado demais: afasta um pouco.
			if (hit.Position - pos).Magnitude < WALL_MARGIN * 0.5 then
				move += normal * 0.2
			end
		end
	end

	-- Preso (quer andar e quase não sai do lugar): atravessa por um instante.
	if intended > 0.05 and move.Magnitude < intended * 0.2 then
		memory.stuckTime = (memory.stuckTime or 0) + dt
		if memory.stuckTime >= STUCK_LIMIT then
			memory.stuckTime = 0
			memory.phaseUntil = now + PHASE_TIME
		end
	else
		memory.stuckTime = 0
	end

	local nextPos = pos + move
	if keepAboveGround then
		if now - (memory.lastGroundCheck or 0) >= GROUND_CHECK then
			memory.lastGroundCheck = now
			local ground = Effects.Ground(nextPos, 40, 1)
			memory.groundY = if ground then ground.Y else nil
		end
		local groundY: number? = memory.groundY
		if groundY and nextPos.Y < groundY + GROUND_CLEARANCE then
			nextPos = Vector3.new(nextPos.X, groundY + GROUND_CLEARANCE, nextPos.Z)
		end
	end

	memory.pos = nextPos
	memory.vel = velocity
	return nextPos, move
end

-- Posiciona o corpo (posição lógica + balanço do voo). Sem direção útil, mantém para onde já olhava.
local function render(npc, now: number, faceDirection: Vector3)
	local memory = npc.memory
	local root: BasePart = npc.root
	local bob = math.sin(now * BOB_SPEED + memory.seed) * BOB_AMPLITUDE
	local direction = faceDirection
	if direction.Magnitude < 1e-3 then
		direction = memory.vel
	end
	if direction.Magnitude < 1e-3 then
		direction = root.CFrame.LookVector
	end
	root.CFrame = faceCFrame(memory.pos + Vector3.new(0, bob, 0), direction)
end

-- Ciclo ------------------------------------------------------------------------------------------

function MosquitoAI.Setup(npc, now: number)
	local memory = npc.memory
	local rng: Random = npc.rng
	memory.state = "swarm"
	memory.pos = npc.root.Position
	memory.vel = Vector3.zero
	memory.hover = npc.root.Position
	memory.seed = rng:NextNumber(0, math.pi * 2)
	memory.orbitAngle = rng:NextNumber(0, math.pi * 2)
	memory.orbitRadius = rng:NextNumber(ORBIT_RADIUS_MIN, ORBIT_RADIUS_MAX)
	memory.orbitHeight = rng:NextNumber(ORBIT_HEIGHT_MIN, ORBIT_HEIGHT_MAX)
	memory.orbitSpeed = rng:NextNumber(ORBIT_SPEED_MIN, ORBIT_SPEED_MAX) * (if rng:NextNumber() < 0.5 then -1 else 1)
	memory.nextDive = now + rng:NextNumber(1.5, DIVE_COOLDOWN_MAX)
	memory.lastThink = now
	if rng:NextNumber() < BUZZ_CHANCE then
		SoundUtil.Play("Mosquito", {
			Parent = npc.root,
			Looped = true,
			Volume = 0.3,
			PlaybackSpeed = rng:NextNumber(0.9, 1.15),
			RollOffMaxDistance = 60,
		})
	end
	Effects.Burst(npc.root.Position, SPAWN_PUFF)
end

function MosquitoAI.Think(npc, now: number, _dt: number): number?
	local memory = npc.memory
	local def = npc.def
	-- O passo usa o tempo real desde o último passo (o agendador pode atrasar alguns frames).
	local dt = math.clamp(now - (memory.lastThink or now), 1 / 60, 0.25)
	memory.lastThink = now

	local target, targetRoot, distance = Brain.UpdateTarget(npc, now)

	-- Rasante em andamento.
	if memory.state == "dive" then
		local divingOn: Player? = memory.divingOn
		local diveRoot = Brain.RootOf(divingOn)
		local from: Vector3 = memory.pos
		local nextPos, move = fly(npc, now, dt, memory.diveTo, DIVE_SPEED, false)
		-- Passou perto de alguém no caminho? Pica.
		for _, player in CombatUtil.GetAlivePlayers() do
			local root = Brain.RootOf(player)
			if root then
				local point = root.Position
				local segment = nextPos - from
				local t = 0
				local lengthSq = segment:Dot(segment)
				if lengthSq > 1e-6 then
					t = math.clamp((point - from):Dot(segment) / lengthSq, 0, 1)
				end
				if (point - (from + segment * t)).Magnitude <= BITE_RADIUS then
					bite(npc, player)
					startRetreat(npc, now)
					render(npc, now, move)
					return 0.05
				end
			end
		end
		if (memory.diveTo - nextPos).Magnitude < 1.5 or now >= memory.diveEnd or not diveRoot then
			startRetreat(npc, now)
		end
		render(npc, now, move)
		return 0.05
	end

	-- Subindo depois do rasante.
	if memory.state == "retreat" then
		local _, move = fly(npc, now, dt, memory.retreatTo, def.walkSpeed, true)
		if now >= memory.retreatEnd then
			memory.state = "swarm"
		end
		local face = if targetRoot then Brain.FlatUnit(targetRoot.Position - memory.pos) else move
		render(npc, now, face)
		return 0.05
	end

	-- Sem alvo: paira perto de onde nasceu.
	if not target or not targetRoot then
		local hover: Vector3 = memory.hover
		local t = now * 0.6 + memory.seed
		local desired = hover + Vector3.new(math.cos(t) * 4, math.sin(t * 1.7) * 1.2, math.sin(t) * 4)
		local _, move = fly(npc, now, dt, desired, IDLE_SPEED, true)
		render(npc, now, Brain.FlatUnit(move, npc.root.CFrame.LookVector))
		return 0.1
	end

	-- Enxame em volta do alvo.
	local targetPosition = targetRoot.Position
	local desired: Vector3
	if distance > APPROACH_DISTANCE then
		desired = targetPosition + Vector3.new(0, memory.orbitHeight, 0)
	else
		memory.orbitAngle += memory.orbitSpeed * dt
		local angle = memory.orbitAngle
		desired = targetPosition
			+ Vector3.new(
				math.cos(angle) * memory.orbitRadius,
				memory.orbitHeight,
				math.sin(angle) * memory.orbitRadius
			)
	end
	fly(npc, now, dt, desired, def.walkSpeed, true)
	render(npc, now, targetPosition - memory.pos)

	if
		now >= memory.nextDive
		and distance <= DIVE_RANGE
		and (divers[target] or 0) < MAX_DIVERS_PER_TARGET
		and Brain.LineOfSight(npc, now, targetPosition)
	then
		startDive(npc, now, target, targetRoot)
	elseif now >= memory.nextDive then
		-- Não deu para mergulhar agora (sem visão ou já há mosquitos demais no alvo): tenta logo depois.
		memory.nextDive = now + 0.6
	end
	return 0.05
end

function MosquitoAI.Cleanup(npc)
	releaseDive(npc)
end

-- Fim da partida: ninguém continua com febre.
function MosquitoAI.ResetAll()
	table.clear(fevers)
	table.clear(divers)
end

return MosquitoAI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="72">
          <Properties>
            <string name="Name">NPCService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Serviço de inimigos (servidor do jogo). API do contrato:
--   NPCService.Init()
--   NPCService.Spawn(kind, cframe, opts?) -> Model?   (nil se GameConfig.MAX_NPCS foi atingido)
--   NPCService.DespawnGroup(groupId) / NPCService.CountAlive(groupId?) / NPCService.DespawnAll()
-- Extra (fora do contrato, para os eventos de NPC): NPCService.GetGroup(groupId) -> { Model } vivos.
--
-- Como funciona:
--   * cada NPC é um Model em workspace.NPCs com a tag Enemy, atributos NpcKind/GroupId, barra de vida
--     (BillboardGui) e, conforme o tipo, Humanoid (terrestres) ou atributos Health/MaxHealth (voador e
--     planta). O modelo é montado por Rigs; o comportamento fica nos módulos *AI;
--   * UM único agendador no Heartbeat: cada NPC tem a hora do próximo "pensamento" e o loop atende os
--     que venceram em rodízio, com orçamento de tempo e de quantidade por frame (celular e servidor
--     leves). O mesmo loop avança os projéteis, a animação das pernas e os fades;
--   * morte: a IA para, o corpo desmonta (juntas quebradas, partes caem com colisão) e some com fade
--     em ~4 s. Remoção (DespawnGroup/DespawnAll): a IA para na hora e o modelo some com fade.

local CollectionService = game:GetService("CollectionService")
local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local Net = require(ReplicatedStorage.Shared.Net)
local Tags = require(ReplicatedStorage.Shared.Tags)

local Brain = require(script.Parent.Brain)
local Effects = require(script.Parent.Effects)
local HealthBar = require(script.Parent.HealthBar)
local Kinds = require(script.Parent.Kinds)
local Projectiles = require(script.Parent.Projectiles)
local Rigs = require(script.Parent.Rigs)

local AIModules = {
	Monkey = require(script.Parent.MonkeyAI),
	Lion = require(script.Parent.LionAI),
	Hunter = require(script.Parent.HunterAI),
	Spider = require(script.Parent.SpiderAI),
	Mosquito = require(script.Parent.MosquitoAI),
	Plant = require(script.Parent.PlantAI),
}

local NPCService = {}

-- Ajustes ------------------------------------------------------------------------------------------

local FOLDER_NAME = "NPCs"
local EFFECTS_FOLDER_NAME = "Efeitos"
local NPC_GROUP = "Npc" -- grupo de colisão das raízes: NPC não esbarra em NPC (portas não entopem)
local DEBRIS_GROUP = "Debris" -- grupo do DestructionService (pedaço não colide com pedaço)
local THINK_BUDGET = 0.003 -- segundos de IA por frame, no máximo
local MAX_THINKS_PER_FRAME = 30
local MIN_THINK_DELAY = 0.03
local ERROR_THINK_DELAY = 1
local FADE_STEP = 0.1
local CORPSE_TIME = 3 -- o corpo fica parado este tempo e depois some em NPC_DESPAWN_FADE (≈ 4 s no total)
local CORPSE_MIN_PART = 0.45 -- partes menores que isto (olhos, dentes) somem na hora da morte
local CORPSE_MAX_PARTS = 24
local DROWN_DEPTH = 3 -- abaixo do nível do mar = afogou
local OUT_OF_BOUNDS_MARGIN = 30 -- além da borda da ilha (+ margem de eliminação) = morre
local ERROR_REPORT_GAP = 10

-- Estado -------------------------------------------------------------------------------------------

local initialized = false
local npcFolder: Folder? = nil
local npcGroupReady = false
local debrisGroupKnown = false
local active: { any } = {} -- registros; os que deixaram de estar vivos saem na próxima compactação
local fading: { any } = {} -- { model, parts = { [BasePart]: transparência inicial }, fadeAt, endAt, groupId }
local cursor = 0
local dirty = false
local lastFadeStep = 0
local serial = 0
local lastErrorReport: { [string]: number } = {}

-- Utilitários ---------------------------------------------------------------------------------------

local function report(key: string, message: string)
	local now = os.clock()
	local last = lastErrorReport[key]
	if last and now - last < ERROR_REPORT_GAP then
		return
	end
	lastErrorReport[key] = now
	warn("[NPCService] " .. message)
end

local function validNumber(value: any, default: number, min: number, max: number): number
	if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
		return default
	end
	return math.clamp(value, min, max)
end

-- Só a rotação no plano (o NPC nasce em pé, olhando para onde o CFrame aponta).
local function flatBase(cframe: CFrame): CFrame
	local position = cframe.Position
	local look = cframe.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 1e-3 then
		flat = Vector3.new(0, 0, -1)
	end
	return CFrame.lookAt(position, position + flat.Unit)
end

local function ensureFolder(): Folder
	local folder = npcFolder
	if not folder or folder.Parent ~= workspace then
		local existing = workspace:FindFirstChild(FOLDER_NAME)
		if existing and existing:IsA("Folder") then
			folder = existing
		else
			local created = Instance.new("Folder")
			created.Name = FOLDER_NAME
			created.Parent = workspace
			folder = created
		end
		npcFolder = folder
	end
	local effects = (folder :: Folder):FindFirstChild(EFFECTS_FOLDER_NAME)
	if not effects then
		effects = Instance.new("Folder")
		effects.Name = EFFECTS_FOLDER_NAME
		effects.Parent = folder
	end
	Effects.SetFolder(effects)
	return folder :: Folder
end

local function ensureCollisionGroups()
	if not npcGroupReady then
		local ok, err = pcall(function()
			if not PhysicsService:IsCollisionGroupRegistered(NPC_GROUP) then
				PhysicsService:RegisterCollisionGroup(NPC_GROUP)
			end
			PhysicsService:CollisionGroupSetCollidable(NPC_GROUP, NPC_GROUP, false)
		end)
		if ok then
			npcGroupReady = true
		else
			report("group", "Não foi possível criar o grupo de colisão dos NPCs: " .. tostring(err))
		end
	end
	if not debrisGroupKnown then
		local ok, registered = pcall(PhysicsService.IsCollisionGroupRegistered, PhysicsService, DEBRIS_GROUP)
		debrisGroupKnown = ok and registered == true
	end
end

local function isAlive(npc): boolean
	return npc.state == "alive"
end

-- Fades ---------------------------------------------------------------------------------------------

local function startFade(model: Model, delay: number, groupId: string?)
	local parts = {}
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			parts[descendant] = descendant.Transparency
		end
	end
	local now = os.clock()
	local fadeTime = math.max(GameConfig.NPC_DESPAWN_FADE, 0.05)
	table.insert(fading, {
		model = model,
		parts = parts,
		fadeAt = now + delay,
		endAt = now + delay + fadeTime,
		groupId = groupId,
	})
end

local function stepFades(now: number)
	for index = #fading, 1, -1 do
		local entry = fading[index]
		local model: Model = entry.model
		if not model.Parent or now >= entry.endAt then
			table.remove(fading, index)
			if model.Parent then
				model:Destroy()
			end
		elseif now >= entry.fadeAt then
			local alpha = math.clamp((now - entry.fadeAt) / math.max(entry.endAt - entry.fadeAt, 0.05), 0, 1)
			for part, base in entry.parts do
				if part.Parent then
					part.Transparency = base + (1 - base) * alpha
				end
			end
		end
	end
end

-- Parada da IA (morte ou remoção) ---------------------------------------------------------------------

local function stopBrain(npc)
	npc.alive = false
	dirty = true
	for _, connection in npc.connections do
		connection:Disconnect()
	end
	table.clear(npc.connections)
	local ai = npc.ai
	if ai and type(ai.Cleanup) == "function" then
		local ok, err = pcall(ai.Cleanup, npc)
		if not ok then
			report("cleanup:" .. npc.kind, ("Erro ao limpar a IA de %s: %s"):format(npc.kind, tostring(err)))
		end
	end
	Projectiles.ClearOwner(npc)
	if npc.bar then
		npc.bar:Destroy()
		npc.bar = nil
	end
	-- O caminho (Path) do Pathfinding não serve mais; um cálculo em andamento só termina e é ignorado.
	local path: Path? = npc.path
	npc.path = nil
	npc.waypoints = nil
	if path then
		pcall(path.Destroy, path)
	end
end

-- Desmonta o corpo: juntas quebradas, partes soltas com colisão, um empurrãozinho para fora.
local function dismantle(npc, center: Vector3)
	local model: Model = npc.model
	local rng: Random = npc.rng
	for _, descendant in model:GetDescendants() do
		if
			descendant:IsA("JointInstance")
			or descendant:IsA("WeldConstraint")
			or descendant:IsA("Beam")
			or descendant:IsA("Sound")
		then
			descendant:Destroy()
		end
	end
	local kept = 0
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") and descendant.Parent then
			local size = descendant.Size
			local largest = math.max(size.X, size.Y, size.Z)
			if descendant.Transparency >= 0.99 or largest < CORPSE_MIN_PART or kept >= CORPSE_MAX_PARTS then
				descendant:Destroy()
			else
				kept += 1
				descendant.Anchored = false
				descendant.Massless = false
				descendant.CanCollide = true
				descendant.CanTouch = false
				if debrisGroupKnown then
					descendant.CollisionGroup = DEBRIS_GROUP
				end
				local away = descendant.Position - center
				local flat = Vector3.new(away.X, 0, away.Z)
				if flat.Magnitude < 0.05 then
					local angle = rng:NextNumber(0, math.pi * 2)
					flat = Vector3.new(math.cos(angle), 0, math.sin(angle))
				end
				descendant.AssemblyLinearVelocity = flat.Unit * rng:NextNumber(4, 11)
					+ Vector3.new(0, rng:NextNumber(5, 12), 0)
				descendant.AssemblyAngularVelocity =
					Vector3.new(rng:NextNumber(-6, 6), rng:NextNumber(-6, 6), rng:NextNumber(-6, 6))
			end
		end
	end
end

local function handleDeath(npc)
	if not isAlive(npc) then
		return
	end
	npc.state = "dead"
	local model: Model = npc.model
	local root: BasePart = npc.root
	local center = if root.Parent then root.Position else model:GetPivot().Position
	stopBrain(npc)

	-- Vida zerada em qualquer caso (afogado, fora da ilha): IsEnemyAlive passa a ser falso.
	local humanoid: Humanoid? = npc.humanoid
	if humanoid and humanoid.Parent and humanoid.Health > 0 then
		humanoid.Health = 0
	end
	if not humanoid then
		model:SetAttribute("Health", 0)
	end
	model:SetAttribute("Dead", true)

	if not model.Parent then
		return
	end
	ensureCollisionGroups() -- o grupo "Debris" pode ter sido criado depois do Init
	local ok, err = pcall(dismantle, npc, center)
	if not ok then
		report("dismantle", "Erro ao desmontar o corpo: " .. tostring(err))
	end
	startFade(model, CORPSE_TIME, npc.groupId)
end

local function despawn(npc)
	if not isAlive(npc) then
		return
	end
	npc.state = "despawning"
	local model: Model = npc.model
	stopBrain(npc)
	-- Some de vez: ninguém mais mira nele nem o conta como inimigo.
	CollectionService:RemoveTag(model, Tags.Enemy)
	local root: BasePart = npc.root
	if root.Parent then
		local humanoid: Humanoid? = npc.humanoid
		if humanoid and humanoid.Parent then
			pcall(humanoid.MoveTo, humanoid, root.Position)
		end
		root.Anchored = true
	end
	if model.Parent then
		startFade(model, 0, npc.groupId)
	end
end

-- Modelo removido por fora (ex.: Destroy de outro sistema): só esquece o registro.
local function forget(npc)
	if not isAlive(npc) then
		return
	end
	npc.state = "gone"
	stopBrain(npc)
end

-- Vida -----------------------------------------------------------------------------------------------

local function onHealthChanged(npc, health: number, maxHealth: number)
	if not isAlive(npc) then
		return
	end
	if npc.bar then
		npc.bar:Set(health, maxHealth)
	end
	if health < (npc.lastHealth or maxHealth) then
		-- Quem bateu vira o alvo preferido por alguns segundos.
		local userId = npc.model:GetAttribute("LastAttackerUserId")
		if type(userId) == "number" then
			local attacker = Players:GetPlayerByUserId(userId)
			if attacker then
				Brain.Provoke(npc, attacker, os.clock())
			end
		end
	end
	npc.lastHealth = health
	if health <= 0 then
		handleDeath(npc)
	end
end

local function currentHealth(npc): (number, number)
	local humanoid: Humanoid? = npc.humanoid
	if humanoid then
		return humanoid.Health, humanoid.MaxHealth
	end
	local model: Model = npc.model
	return tonumber(model:GetAttribute("Health")) or 0, tonumber(model:GetAttribute("MaxHealth")) or npc.maxHealth
end

-- Agendador -----------------------------------------------------------------------------------------

local function compact()
	dirty = false
	local kept = {}
	for _, npc in active do
		if isAlive(npc) then
			table.insert(kept, npc)
		end
	end
	active = kept
	if cursor > #active then
		cursor = 0
	end
end

local function think(npc, now: number)
	local model: Model = npc.model
	local root: BasePart = npc.root
	if not model.Parent then
		forget(npc)
		return
	end
	if not root.Parent then
		handleDeath(npc)
		return
	end
	local health = currentHealth(npc)
	if health <= 0 then
		handleDeath(npc)
		return
	end
	-- Caiu no mar ou saiu da ilha (ex.: bote na beirada, tornado): morre.
	local position = root.Position
	local center = GameConfig.ISLAND_CENTER
	local dx, dz = position.X - center.X, position.Z - center.Z
	local limit = GameConfig.ISLAND_RADIUS + GameConfig.ELIMINATION_MARGIN + OUT_OF_BOUNDS_MARGIN
	if position.Y < GameConfig.WATER_LEVEL_Y - DROWN_DEPTH or dx * dx + dz * dz > limit * limit then
		handleDeath(npc)
		return
	end

	local dt = now - npc.lastThink
	npc.lastThink = now
	local ok, result = pcall(npc.ai.Think, npc, now, dt)
	local delay = npc.def.thinkInterval
	if not ok then
		report("think:" .. npc.kind, ("Erro na IA de %s: %s"):format(npc.kind, tostring(result)))
		delay = ERROR_THINK_DELAY
	elseif type(result) == "number" and result == result then
		delay = result
	end
	npc.nextThink = now + math.max(delay, MIN_THINK_DELAY)
end

local function onHeartbeat()
	local now = os.clock()
	if dirty then
		compact()
	end

	local okProjectiles, projectileError = pcall(Projectiles.Step, now)
	if not okProjectiles then
		report("projectiles", "Erro nos projéteis: " .. tostring(projectileError))
	end

	local count = #active
	if count > 0 then
		-- Rodízio: começa de onde parou no frame anterior; para quando o orçamento acaba.
		local started = os.clock()
		local thinks = 0
		for _ = 1, count do
			cursor = cursor % count + 1
			local npc = active[cursor]
			if npc and isAlive(npc) and now >= npc.nextThink then
				think(npc, now)
				thinks += 1
				if thinks >= MAX_THINKS_PER_FRAME or os.clock() - started >= THINK_BUDGET then
					break
				end
			end
		end
		-- Pernas (cada NPC limita a própria frequência e só anima perto de jogadores).
		for _, npc in active do
			if isAlive(npc) and npc.rig.gait then
				local ok, err = pcall(Brain.Animate, npc, now)
				if not ok then
					report("animate", "Erro na animação: " .. tostring(err))
				end
			end
		end
	end

	if #fading > 0 and now - lastFadeStep >= FADE_STEP then
		lastFadeStep = now
		local ok, err = pcall(stepFades, now)
		if not ok then
			report("fade", "Erro no fade dos NPCs: " .. tostring(err))
		end
	end
end

-- API ------------------------------------------------------------------------------------------------

function NPCService.Init()
	if initialized then
		return
	end
	initialized = true
	ensureFolder()
	ensureCollisionGroups()
	-- Remotes usados pelos NPCs (existem antes de qualquer cliente pedir).
	Net.event(Net.Names.Fx_Play)
	Net.event(Net.Names.Notify)

	-- Personagem novo: a lista de exclusão dos raios precisa incluí-lo logo.
	local function watchPlayer(player: Player)
		player.CharacterAdded:Connect(function()
			Effects.InvalidateParams()
		end)
	end
	Players.PlayerAdded:Connect(watchPlayer)
	for _, player in Players:GetPlayers() do
		watchPlayer(player)
	end
	Players.PlayerRemoving:Connect(function()
		Effects.InvalidateParams()
	end)

	RunService.Heartbeat:Connect(onHeartbeat)
end

-- Cria um inimigo do tipo `kind` em `cframe` (ponto no chão; a frente do NPC é o LookVector).
-- opts: { groupId: string?, health: number?, damage: number? }. Retorna o Model ou nil.
function NPCService.Spawn(kind: string, cframe: CFrame, opts: { [string]: any }?): Model?
	if type(kind) ~= "string" then
		report("kind", "Spawn chamado sem um tipo de NPC válido.")
		return nil
	end
	local def = Kinds.Get(kind)
	local ai = AIModules[kind]
	if not def or not ai then
		report("kind:" .. kind, ("Tipo de NPC desconhecido: '%s'."):format(kind))
		return nil
	end
	if typeof(cframe) ~= "CFrame" then
		report("cframe", "Spawn precisa de um CFrame.")
		return nil
	end
	local spawnPosition = cframe.Position
	local spawnSum = spawnPosition.X + spawnPosition.Y + spawnPosition.Z
	if spawnSum ~= spawnSum or math.abs(spawnSum) == math.huge then
		report("cframe", "Spawn recebeu uma posição inválida (NaN ou infinita).")
		return nil
	end
	if not initialized then
		NPCService.Init()
	end
	if NPCService.CountAlive() >= GameConfig.MAX_NPCS then
		return nil
	end

	local options = if type(opts) == "table" then opts else {}
	local groupId = if type(options.groupId) == "string" and options.groupId ~= "" then options.groupId else nil
	local maxHealth = validNumber(options.health, def.health, 1, 100000)
	local damage = validNumber(options.damage, def.damage, 0, 10000)
	local base = flatBase(cframe)

	local built, rigOrError = pcall(Rigs.Build, kind, def.displayName, base)
	if not built or not rigOrError then
		report("rig:" .. kind, ("Erro ao montar o modelo de %s: %s"):format(kind, tostring(rigOrError)))
		return nil
	end
	local rig = rigOrError
	local model: Model = rig.model
	local root: BasePart = rig.root
	local humanoid: Humanoid? = rig.humanoid

	serial += 1
	model:SetAttribute("NpcKind", kind)
	model:SetAttribute("NpcId", serial)
	if groupId then
		model:SetAttribute("GroupId", groupId)
	end
	if humanoid then
		humanoid.MaxHealth = maxHealth
		humanoid.Health = maxHealth
		humanoid.WalkSpeed = def.walkSpeed
		humanoid.JumpPower = def.jumpPower
	else
		model:SetAttribute("MaxHealth", maxHealth)
		model:SetAttribute("Health", maxHealth)
	end
	if npcGroupReady and humanoid then
		root.CollisionGroup = NPC_GROUP
	end

	local bar = HealthBar.new(rig.barAdornee, def.displayName, rig.barOffset, def.barMaxDistance, def.boss)
	CollectionService:AddTag(model, Tags.Enemy)
	model.Parent = ensureFolder()
	if humanoid then
		-- A física do NPC fica no servidor (nada de cliente puxando o inimigo).
		local ok, err = pcall(root.SetNetworkOwner, root, nil)
		if not ok then
			report("owner", "Não foi possível definir o dono de rede do NPC: " .. tostring(err))
		end
		-- Estados que um inimigo nunca usa (depois de entrar no workspace, onde o servidor simula o Humanoid):
		-- menos trabalho para o Humanoid e nada de sentar em bancos.
		for _, state in
			{
				Enum.HumanoidStateType.Climbing,
				Enum.HumanoidStateType.Seated,
				Enum.HumanoidStateType.FallingDown,
				Enum.HumanoidStateType.Ragdoll,
				Enum.HumanoidStateType.PlatformStanding,
			}
		do
			humanoid:SetStateEnabled(state, false)
		end
	end

	local now = os.clock()
	local rng = Random.new()
	local npc = {
		id = serial,
		kind = kind,
		def = def,
		ai = ai,
		model = model,
		rig = rig,
		root = root,
		humanoid = humanoid,
		groupId = groupId,
		state = "alive",
		alive = true,
		damage = damage,
		maxHealth = maxHealth,
		lastHealth = maxHealth,
		memory = {},
		rng = rng,
		home = base.Position,
		feetOffset = rig.feetOffset,
		-- Espalha os primeiros pensamentos (um grupo inteiro não pensa no mesmo frame).
		nextThink = now + rng:NextNumber(0.05, 0.25),
		lastThink = now,
		bar = bar,
		connections = {},
	}

	if humanoid then
		table.insert(
			npc.connections,
			humanoid.HealthChanged:Connect(function(health)
				onHealthChanged(npc, health, humanoid.MaxHealth)
			end)
		)
		table.insert(
			npc.connections,
			humanoid.Died:Connect(function()
				handleDeath(npc)
			end)
		)
	else
		table.insert(
			npc.connections,
			model:GetAttributeChangedSignal("Health"):Connect(function()
				local health, max = currentHealth(npc)
				onHealthChanged(npc, health, max)
			end)
		)
	end
	table.insert(
		npc.connections,
		model.AncestryChanged:Connect(function()
			if not model:IsDescendantOf(workspace) then
				forget(npc)
			end
		end)
	)

	table.insert(active, npc)

	local ok, err = pcall(ai.Setup, npc, now)
	if not ok then
		report("setup:" .. kind, ("Erro ao preparar a IA de %s: %s"):format(kind, tostring(err)))
	end
	return model
end

-- Inimigos vivos (de um grupo ou de todos).
function NPCService.CountAlive(groupId: string?): number
	local count = 0
	for _, npc in active do
		if isAlive(npc) and (groupId == nil or npc.groupId == groupId) then
			count += 1
		end
	end
	return count
end

-- Models vivos de um grupo (extra para os eventos de NPC).
function NPCService.GetGroup(groupId: string): { Model }
	local models = {}
	if type(groupId) ~= "string" then
		return models
	end
	for _, npc in active do
		if isAlive(npc) and npc.groupId == groupId then
			table.insert(models, npc.model)
		end
	end
	return models
end

-- Remove todos os inimigos do grupo (com fade) e apressa o sumiço dos corpos dele.
function NPCService.DespawnGroup(groupId: string)
	if type(groupId) ~= "string" then
		return
	end
	for _, npc in table.clone(active) do
		if npc.groupId == groupId then
			despawn(npc)
		end
	end
	local now = os.clock()
	for _, entry in fading do
		if entry.groupId == groupId and entry.fadeAt > now then
			local fadeTime = entry.endAt - entry.fadeAt
			entry.fadeAt = now
			entry.endAt = now + fadeTime
		end
	end
end

-- Remove todos os inimigos (fim da partida).
function NPCService.DespawnAll()
	for _, npc in table.clone(active) do
		despawn(npc)
	end
	local now = os.clock()
	for _, entry in fading do
		if entry.fadeAt > now then
			local fadeTime = entry.endAt - entry.fadeAt
			entry.fadeAt = now
			entry.endAt = now + fadeTime
		end
	end
	Projectiles.ClearAll()
	Effects.ClearClaims()
	for kind, ai in AIModules do
		if type(ai.ResetAll) == "function" then
			local ok, err = pcall(ai.ResetAll)
			if not ok then
				report("reset:" .. kind, ("Erro ao reiniciar a IA de %s: %s"):format(kind, tostring(err)))
			end
		end
	end
end

return NPCService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="73">
          <Properties>
            <string name="Name">PlantAI</string>
            <string name="Source"><![CDATA[--!nonstrict
-- IA da Planta Carnívora (parada, sem Humanoid; usada pelo evento Cipós Carnívoros). A cabeça são duas
-- mandíbulas ancoradas animadas por tween:
--   * acompanha (vira a cabeça) o jogador que chegar a 18 studs;
--   * a 9 studs ou menos, a cada 1,2 s: abre bem a boca e fecha de repente. Se o jogador ainda estiver ao
--     alcance no instante em que ela fecha, leva 12 de dano e fica preso (WalkSpeed 4 por 1,5 s);
--   * sem ninguém por perto, só "mastiga" de vez em quando se houver jogador à vista (economiza rede).

local TweenService = game:GetService("TweenService")

local CombatUtil = require(script.Parent.Parent.CombatUtil)
local Brain = require(script.Parent.Brain)
local Effects = require(script.Parent.Effects)
local Rigs = require(script.Parent.Rigs)

local PlantAI = {}

local BITE_OPEN = 0.95 -- abertura máxima (radianos)
local OPEN_TIME = 0.18
local SNAP_DELAY = 0.24 -- do começo da abertura até a mordida
local SNAP_TIME = 0.07
local RECOVER_TIME = 0.35
local BITE_REACH_BONUS = 1.5 -- folga no instante da mordida
local TURN_TIME = 0.15
local TURN_THRESHOLD = 0.06 -- radianos: abaixo disto a cabeça não se mexe
local PITCH_MIN, PITCH_MAX = -0.6, 0.35
local CHOMP_MIN, CHOMP_MAX = 2.2, 4.2
local CHOMP_OPEN = 0.5
local CHOMP_NEAR = 45 -- só mastiga no ócio com jogador até esta distância
local HOLD_SPEED = 4
local HOLD_TIME = 1.5
local HOLD_JUMP = 0.2
local HOLD_KEY = "NpcPlantaCarnivora"
local SPAWN_LEAVES = Color3.fromRGB(70, 150, 60)

local function cancelTweens(npc)
	local tweens = npc.memory.tweens
	npc.memory.tweens = nil
	if tweens then
		for _, tween in tweens do
			tween:Cancel()
		end
	end
end

-- Leva as mandíbulas para (yaw, pitch, abertura) em `duration` segundos (0 = na hora).
local function setJaws(npc, yaw: number, pitch: number, open: number, duration: number, style: Enum.EasingStyle?)
	local memory = npc.memory
	local extras = npc.rig.extras
	local upper: BasePart? = extras.upperJaw
	local lower: BasePart? = extras.lowerJaw
	memory.yaw, memory.pitch, memory.open = yaw, pitch, open
	if not upper or not upper.Parent or not lower or not lower.Parent then
		return
	end
	cancelTweens(npc)
	local upperCFrame, lowerCFrame = Rigs.PlantJawCFrames(extras.base, yaw, pitch, open)
	if duration <= 0 then
		upper.CFrame = upperCFrame
		lower.CFrame = lowerCFrame
		return
	end
	local info = TweenInfo.new(duration, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local upperTween = TweenService:Create(upper, info, { CFrame = upperCFrame })
	local lowerTween = TweenService:Create(lower, info, { CFrame = lowerCFrame })
	upperTween:Play()
	lowerTween:Play()
	memory.tweens = { upperTween, lowerTween }
end

local function headPosition(npc): Vector3
	local base: CFrame = npc.rig.extras.base
	return (base * CFrame.new(0, Rigs.PLANT_HEAD_Y, 0)).Position
end

-- Ângulos (relativos à base) para a cabeça olhar para `point`.
local function aimAngles(npc, point: Vector3): (number, number)
	local base: CFrame = npc.rig.extras.base
	local head = base * CFrame.new(0, Rigs.PLANT_HEAD_Y, 0)
	local localPoint = head:PointToObjectSpace(point)
	local horizontal = math.sqrt(localPoint.X * localPoint.X + localPoint.Z * localPoint.Z)
	if horizontal < 0.05 then
		return npc.memory.yaw, npc.memory.pitch
	end
	-- Frente = -Z local: girar `yaw` em Y leva (0, 0, -1) para (-sen yaw, 0, -cos yaw).
	local yaw = math.atan2(-localPoint.X, -localPoint.Z)
	local pitch = math.clamp(math.atan2(localPoint.Y, horizontal), PITCH_MIN, PITCH_MAX)
	return yaw, pitch
end

local function angleDelta(a: number, b: number): number
	return math.abs((a - b + math.pi) % (math.pi * 2) - math.pi)
end

local function snap(npc, now: number)
	local memory = npc.memory
	local def = npc.def
	memory.state = "recover"
	memory.recoverAt = now + RECOVER_TIME
	setJaws(npc, memory.yaw, memory.pitch, 0, SNAP_TIME, Enum.EasingStyle.Back)

	local player: Player? = memory.biteTarget
	memory.biteTarget = nil
	local targetRoot = Brain.RootOf(player)
	if not player or not targetRoot or not CombatUtil.IsPlayerAlive(player) then
		return
	end
	if (targetRoot.Position - headPosition(npc)).Magnitude > def.attackRange + BITE_REACH_BONUS then
		return -- desviou a tempo
	end
	CombatUtil.DamagePlayer(player, npc.damage, def.displayName)
	Effects.Slow(player, HOLD_KEY, HOLD_SPEED, HOLD_TIME, HOLD_JUMP)
	Effects.Notify(player, "Uma planta carnívora mordeu você e não quer soltar!", "danger", "planta", 6)
end

function PlantAI.Setup(npc, now: number)
	local memory = npc.memory
	memory.state = "idle"
	memory.yaw = 0
	memory.pitch = 0
	memory.open = Rigs.PLANT_REST_OPEN
	memory.nextChomp = now + npc.rng:NextNumber(1, CHOMP_MAX)
	Effects.Burst(npc.root.Position + Vector3.new(0, 2, 0), SPAWN_LEAVES)
end

function PlantAI.Think(npc, now: number, _dt: number): number?
	local memory = npc.memory
	local def = npc.def

	if memory.state == "bite" then
		-- Acompanha o alvo enquanto abre a boca.
		local targetRoot = Brain.RootOf(memory.biteTarget)
		if now >= memory.snapAt then
			snap(npc, now)
		elseif targetRoot then
			local yaw, pitch = aimAngles(npc, targetRoot.Position)
			if angleDelta(yaw, memory.yaw) > 0.25 then
				setJaws(npc, yaw, pitch, BITE_OPEN, math.max(memory.snapAt - now, 0.05))
			end
		end
		return 0.05
	elseif memory.state == "recover" then
		if now < memory.recoverAt then
			return 0.05
		end
		memory.state = "idle"
		setJaws(npc, memory.yaw, memory.pitch, Rigs.PLANT_REST_OPEN, 0.3)
	end

	local target, targetRoot = Brain.UpdateTarget(npc, now)
	if target and targetRoot then
		local point = targetRoot.Position
		local yaw, pitch = aimAngles(npc, point)
		local distance = (point - headPosition(npc)).Magnitude
		if distance <= def.attackRange and now >= (npc.nextAttack or 0) and Brain.LineOfSight(npc, now, point) then
			npc.nextAttack = now + def.attackCooldown
			memory.state = "bite"
			memory.biteTarget = target
			memory.snapAt = now + SNAP_DELAY
			setJaws(npc, yaw, pitch, BITE_OPEN, OPEN_TIME)
			return 0.05
		end
		if angleDelta(yaw, memory.yaw) > TURN_THRESHOLD or math.abs(pitch - memory.pitch) > TURN_THRESHOLD then
			setJaws(npc, yaw, pitch, Rigs.PLANT_REST_OPEN, TURN_TIME, Enum.EasingStyle.Linear)
		end
		return def.thinkInterval
	end

	-- Ócio: mastiga de vez em quando (só se houver alguém para ver).
	if now >= memory.nextChomp then
		memory.nextChomp = now + npc.rng:NextNumber(CHOMP_MIN, CHOMP_MAX)
		if CombatUtil.GetNearestAlivePlayer(npc.root.Position, CHOMP_NEAR) then
			setJaws(npc, memory.yaw, memory.pitch, CHOMP_OPEN, 0.25, Enum.EasingStyle.Sine)
			memory.state = "recover"
			memory.recoverAt = now + 0.3
			return 0.05
		end
	end
	return def.idleInterval
end

function PlantAI.Cleanup(npc)
	cancelTweens(npc)
	npc.memory.biteTarget = nil
end

return PlantAI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="74">
          <Properties>
            <string name="Name">Projectiles</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Projéteis dos NPCs (servidor). Não têm loop próprio: o agendador do NPCService chama Step a cada frame.
--   * Teia da aranha: bola com física do servidor e sem colisão (a rede interpola, fica suave no
--     celular). Acertou um jogador → callback (lentidão); acertou o cenário → mancha de teia que some.
--   * Objeto arremessado pelo macaco: o objeto já voa com física; aqui só se verifica, ao longo do
--     trajeto, se passou por um jogador (dano ao "tocar"), até parar ou acabar o tempo.
-- A colisão com jogadores é geométrica (distância do segmento percorrido no frame até o jogador).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local PartBuilder = require(ReplicatedStorage.Shared.Util.PartBuilder)

local CombatUtil = require(script.Parent.Parent.CombatUtil)
local Effects = require(script.Parent.Effects)

local Projectiles = {}

local MAX_ACTIVE = 24
local MAX_SPLATS = 12
local SPLAT_LIFETIME = 4
local SPLAT_CHECK = 0.5
local PLAYER_RADIUS = 1.8 -- "espessura" do personagem
local PROP_SETTLE_TIME = 0.35 -- depois disto, objeto quase parado deixa de ser perigoso
local PROP_SETTLE_SPEED = 4
local WEB_COLOR = Color3.fromRGB(240, 240, 236)

type Entry = {
	kind: string,
	owner: any,
	part: BasePart,
	ownsPart: boolean,
	lastPos: Vector3,
	started: number,
	lifetime: number,
	radius: number,
	hitsWorld: boolean,
	onHitPlayer: (Player, Vector3) -> (),
	onHitWorld: ((RaycastResult) -> ())?,
}

local active: { Entry } = {}
local splats: { { part: BasePart, expires: number } } = {}
local lastSplatCheck = 0

local function removeAt(index: number)
	local entry = table.remove(active, index)
	if entry and entry.ownsPart and entry.part.Parent then
		entry.part:Destroy()
	end
end

local function distanceToSegment(point: Vector3, a: Vector3, b: Vector3): number
	local ab = b - a
	local lengthSq = ab:Dot(ab)
	if lengthSq < 1e-6 then
		return (point - a).Magnitude
	end
	local t = math.clamp((point - a):Dot(ab) / lengthSq, 0, 1)
	return (point - (a + ab * t)).Magnitude
end

-- Velocidade inicial para ir de `from` a `to` em `flight` segundos com a gravidade do workspace.
function Projectiles.BallisticVelocity(from: Vector3, to: Vector3, flight: number): Vector3
	local t = math.max(flight, 0.05)
	return (to - from) / t + Vector3.new(0, 0.5 * workspace.Gravity * t, 0)
end

-- Bola de teia de `origin` até `target`. `onHitPlayer(player, position)` é chamado ao acertar alguém.
function Projectiles.FireWeb(owner: any, origin: Vector3, target: Vector3, onHitPlayer: (Player, Vector3) -> ())
	if #active >= MAX_ACTIVE then
		return
	end
	local distance = (target - origin).Magnitude
	local flight = math.clamp(distance / 70, 0.25, 0.9)
	local ball = PartBuilder.part({
		Name = "Teia",
		Color = WEB_COLOR,
		Material = Enum.Material.SmoothPlastic,
		Transparency = 0.1,
		Anchored = false,
		CanCollide = false,
		CanTouch = false,
		CastShadow = false,
	}) :: Part
	ball.CanQuery = false -- só depois de CanCollide = false
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.new(1.2, 1.2, 1.2)
	ball.CFrame = CFrame.new(origin)
	ball.Parent = Effects.Folder()
	pcall(ball.SetNetworkOwner, ball, nil)
	ball.AssemblyLinearVelocity = Projectiles.BallisticVelocity(origin, target, flight)

	table.insert(active, {
		kind = "web",
		owner = owner,
		part = ball,
		ownsPart = true,
		lastPos = origin,
		started = os.clock(),
		lifetime = flight + 1.2,
		radius = 0.6,
		hitsWorld = true,
		onHitPlayer = onHitPlayer,
		onHitWorld = function(result: RaycastResult)
			Projectiles.Splat(result.Position, result.Normal)
		end,
	})
end

-- Passa a vigiar um objeto já lançado: quem estiver no caminho leva `damage`.
function Projectiles.TrackProp(
	owner: any,
	part: BasePart,
	options: { damage: number, source: string, lifetime: number? }
)
	if #active >= MAX_ACTIVE or not part.Parent then
		return
	end
	local damage = options.damage
	local source = options.source
	table.insert(active, {
		kind = "prop",
		owner = owner,
		part = part,
		ownsPart = false,
		lastPos = part.Position,
		started = os.clock(),
		lifetime = options.lifetime or 2,
		radius = math.min(part.Size.Magnitude * 0.4, 3),
		hitsWorld = false,
		onHitPlayer = function(player: Player, _position: Vector3)
			CombatUtil.DamagePlayer(player, damage, source)
			local velocity = part.AssemblyLinearVelocity
			local push = Vector3.new(velocity.X, 0, velocity.Z)
			if push.Magnitude > 0.1 then
				CombatUtil.Knockback(player, push, 25)
			end
		end,
		onHitWorld = nil,
	})
end

-- Mancha de teia decorativa no cenário (some sozinha; no máximo MAX_SPLATS ao mesmo tempo).
function Projectiles.Splat(position: Vector3, normal: Vector3)
	if #splats >= MAX_SPLATS then
		local oldest = table.remove(splats, 1)
		if oldest and oldest.part.Parent then
			oldest.part:Destroy()
		end
	end
	local part = PartBuilder.part({
		Name = "ManchaDeTeia",
		Color = WEB_COLOR,
		Material = Enum.Material.SmoothPlastic,
		Transparency = 0.3,
		CanCollide = false,
		CanTouch = false,
		CastShadow = false,
	}) :: Part
	part.CanQuery = false
	part.Shape = Enum.PartType.Cylinder
	part.Size = Vector3.new(0.1, 3, 3)
	-- O eixo do cilindro (X) fica alinhado com a normal da superfície.
	part.CFrame = CFrame.lookAt(position, position + normal) * CFrame.Angles(0, math.pi / 2, 0)
	part.Parent = Effects.Folder()
	table.insert(splats, { part = part, expires = os.clock() + SPLAT_LIFETIME })
end

-- Avança tudo um frame (chamado pelo agendador do NPCService).
function Projectiles.Step(now: number)
	if now - lastSplatCheck >= SPLAT_CHECK and #splats > 0 then
		lastSplatCheck = now
		for index = #splats, 1, -1 do
			local splat = splats[index]
			if now >= splat.expires or not splat.part.Parent then
				table.remove(splats, index)
				if splat.part.Parent then
					splat.part:Destroy()
				end
			end
		end
	end
	if #active == 0 then
		return
	end

	-- Jogadores vivos com raiz, calculados uma vez por frame.
	local targets = {}
	for _, player in CombatUtil.GetAlivePlayers() do
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			table.insert(targets, { player = player, root = root })
		end
	end

	for index = #active, 1, -1 do
		local entry = active[index]
		local part = entry.part
		if not part.Parent or now - entry.started > entry.lifetime then
			removeAt(index)
		else
			local position = part.Position
			local from = entry.lastPos
			entry.lastPos = position
			local hitPlayer: Player? = nil
			for _, target in targets do
				if distanceToSegment(target.root.Position, from, position) <= entry.radius + PLAYER_RADIUS then
					hitPlayer = target.player
					break
				end
			end
			if hitPlayer then
				local callback = entry.onHitPlayer
				removeAt(index)
				local ok, err = pcall(callback, hitPlayer, position)
				if not ok then
					warn("[NPC] Erro no acerto de projétil: " .. tostring(err))
				end
			elseif entry.hitsWorld then
				local delta = position - from
				if delta.Magnitude > 0.05 then
					local result = workspace:Raycast(from, delta, Effects.WorldParams())
					if result then
						local callback = entry.onHitWorld
						removeAt(index)
						if callback then
							pcall(callback, result)
						end
					end
				end
			elseif
				now - entry.started > PROP_SETTLE_TIME and part.AssemblyLinearVelocity.Magnitude < PROP_SETTLE_SPEED
			then
				removeAt(index)
			end
		end
	end
end

-- Remove os projéteis de um NPC (as teias somem; objetos arremessados deixam de causar dano).
function Projectiles.ClearOwner(owner: any)
	for index = #active, 1, -1 do
		if active[index].owner == owner then
			removeAt(index)
		end
	end
end

function Projectiles.ClearAll()
	for index = #active, 1, -1 do
		removeAt(index)
	end
	for _, splat in splats do
		if splat.part.Parent then
			splat.part:Destroy()
		end
	end
	table.clear(splats)
end

return Projectiles
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="75">
          <Properties>
            <string name="Name">Rigs</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Modelos dos inimigos, feitos só de parts (estilo blocos). Convenções:
--   * `base` é o ponto no chão sob o NPC; a FRENTE aponta para o -Z local (LookVector);
--   * terrestres: Humanoid R15 (para o HipHeight funcionar em rig próprio) + HumanoidRootPart invisível
--     que colide; o resto do corpo é soldado (WeldConstraint), sem massa e sem colisão. As pernas usam
--     Motor6D para a animação procedural barata (o NPCService só anima perto de jogadores);
--   * voadores (mosquito) e a planta: sem Humanoid; a part raiz é ancorada e as outras soldadas nela,
--     então mover a raiz por CFrame move o corpo todo (só a raiz replica).
-- Os nomes das partes evitam os nomes padrão de personagem (Head, Torso...) para o Humanoid não tratá-las
-- de forma especial.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local PartBuilder = require(ReplicatedStorage.Shared.Util.PartBuilder)

local Rigs = {}

export type GaitJoint = {
	motor: Motor6D,
	base: CFrame,
	mode: string, -- "swing" (gira na junta) | "lift" (levanta e avança um grupo de pernas)
	amp: number,
	lift: number,
	stride: number,
	phase: number,
}

export type Rig = {
	model: Model,
	root: BasePart,
	humanoid: Humanoid?,
	eye: BasePart, -- origem da linha de visão
	barAdornee: BasePart,
	barOffset: number,
	feetOffset: number, -- altura do centro da raiz acima do chão
	topOffset: number, -- topo da cabeça em relação ao centro da raiz
	gait: { rate: number, joints: { GaitJoint } }?,
	extras: { [string]: any },
}

local M = Enum.Material

-- Construção ----------------------------------------------------------------------------------

local function newRig(name: string, base: CFrame)
	local model = Instance.new("Model")
	model.Name = name
	return {
		model = model,
		base = base,
		root = nil,
		humanoid = nil,
		eye = nil,
		barAdornee = nil,
		barOffset = 2,
		feetOffset = 0,
		topOffset = 2,
		gait = nil,
		extras = {},
		body = {}, -- partes a soldar na raiz
	}
end

-- Part do corpo (solta, sem colisão, sem massa) no CFrame do MUNDO.
local function partAt(
	rig,
	name: string,
	size: Vector3,
	world: CFrame,
	color: Color3,
	material: Enum.Material?,
	shape: Enum.PartType?
): Part
	local maxSize = math.max(size.X, size.Y, size.Z)
	local part = PartBuilder.part({
		Name = name,
		Color = color,
		Material = material or M.SmoothPlastic,
		Anchored = false,
		CanCollide = false,
		CanTouch = false,
		Massless = true,
		CastShadow = maxSize >= 1.5,
	}) :: Part
	if shape then
		part.Shape = shape
	end
	part.Size = size
	part.CFrame = world
	part.Parent = rig.model
	return part
end

-- Part do corpo com CFrame LOCAL (relativo a `base`); entra na lista de soldagem na raiz.
local function bodyPart(
	rig,
	name: string,
	size: Vector3,
	localCFrame: CFrame,
	color: Color3,
	material: Enum.Material?,
	shape: Enum.PartType?
): Part
	local part = partAt(rig, name, size, rig.base * localCFrame, color, material, shape)
	table.insert(rig.body, part)
	return part
end

-- Segmento (bloco comprido) entre dois pontos locais; não entra na lista de soldagem.
local function segment(rig, name: string, a: Vector3, b: Vector3, thickness: number, color: Color3): Part
	local length = (b - a).Magnitude
	local localCFrame = CFrame.lookAt((a + b) / 2, b)
	return partAt(rig, name, Vector3.new(thickness, thickness, length), rig.base * localCFrame, color, M.SmoothPlastic)
end

-- Part invisível usada como "cubo" de um grupo de pernas.
local function hub(rig, name: string, localCFrame: CFrame): Part
	local part = PartBuilder.part({
		Name = name,
		Transparency = 1,
		Anchored = false,
		CanCollide = false,
		CanTouch = false,
		CastShadow = false,
		Massless = true,
	}) :: Part
	part.CanQuery = false -- só depois de CanCollide = false
	part.Size = Vector3.new(0.2, 0.2, 0.2)
	part.CFrame = rig.base * localCFrame
	part.Parent = rig.model
	return part
end

local function weldTo(anchor: BasePart, parts: { BasePart })
	for _, part in parts do
		if part ~= anchor then
			PartBuilder.weld(anchor, part)
		end
	end
end

-- Junta animável. `jointLocal` é o ponto da junta (relativo a `base`).
local function motor(rig, name: string, part0: BasePart, part1: BasePart, jointLocal: CFrame): Motor6D
	local jointWorld = rig.base * jointLocal
	local joint = Instance.new("Motor6D")
	joint.Name = name
	joint.Part0 = part0
	joint.Part1 = part1
	joint.C0 = part0.CFrame:ToObjectSpace(jointWorld)
	joint.C1 = part1.CFrame:ToObjectSpace(jointWorld)
	joint.Parent = part0
	return joint
end

local function swingJoint(joint: Motor6D, amp: number, phase: number): GaitJoint
	return { motor = joint, base = joint.C0, mode = "swing", amp = amp, lift = 0, stride = 0, phase = phase }
end

local function liftJoint(joint: Motor6D, lift: number, stride: number, phase: number): GaitJoint
	return { motor = joint, base = joint.C0, mode = "lift", amp = 0, lift = lift, stride = stride, phase = phase }
end

-- Raiz invisível que colide (terrestres). `centerY` = altura do centro acima do chão.
local function groundRoot(rig, size: Vector3, centerY: number): Part
	local root = PartBuilder.part({
		Name = "HumanoidRootPart",
		Transparency = 1,
		Anchored = false,
		CanCollide = true,
		CanTouch = true,
		CastShadow = false,
		Massless = false,
	}) :: Part
	root.Size = size
	root.CFrame = rig.base * CFrame.new(0, centerY, 0)
	root.Parent = rig.model
	rig.root = root
	rig.feetOffset = centerY
	rig.model.PrimaryPart = root
	return root
end

-- Raiz visível e ancorada (voadores e planta).
local function anchoredRoot(rig, name: string, size: Vector3, localCFrame: CFrame, color: Color3, material): Part
	local root = partAt(rig, name, size, rig.base * localCFrame, color, material)
	root.Anchored = true
	root.Massless = false
	rig.root = root
	rig.model.PrimaryPart = root
	return root
end

-- Humanoid R15 de rig próprio. HipHeight (R15) = distância do chão até a BASE da raiz.
local function addHumanoid(rig, hipHeight: number): Humanoid
	local humanoid = Instance.new("Humanoid")
	humanoid.RigType = Enum.HumanoidRigType.R15
	humanoid.AutomaticScalingEnabled = false
	humanoid.HipHeight = hipHeight
	humanoid.RequiresNeck = false
	humanoid.BreakJointsOnDeath = false
	humanoid.UseJumpPower = true
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.NameDisplayDistance = 0
	humanoid.HealthDisplayDistance = 0
	humanoid.Parent = rig.model
	rig.humanoid = humanoid
	return humanoid
end

local builders = {}

-- Macaco (~2,7 studs) ------------------------------------------------------------------------------

local MONKEY = {
	fur = Color3.fromRGB(96, 62, 34),
	furDark = Color3.fromRGB(70, 44, 24),
	face = Color3.fromRGB(214, 170, 122),
	eye = Color3.fromRGB(18, 14, 12),
}

function builders.Monkey(name: string, base: CFrame)
	local rig = newRig(name, base)
	local c = MONKEY
	local rootY = 1.25
	local root = groundRoot(rig, Vector3.new(1.2, 1, 1), rootY)

	bodyPart(rig, "Corpo", Vector3.new(1.1, 1.1, 0.9), CFrame.new(0, 1.3, 0), c.fur, M.Fabric)
	bodyPart(rig, "Barriga", Vector3.new(0.75, 0.75, 0.08), CFrame.new(0, 1.25, -0.48), c.face)
	local head = bodyPart(rig, "Cabeca", Vector3.new(0.95, 0.85, 0.85), CFrame.new(0, 2.25, -0.08), c.fur, M.Fabric)
	bodyPart(rig, "Focinho", Vector3.new(0.6, 0.45, 0.2), CFrame.new(0, 2.12, -0.6), c.face)
	for _, side in { -1, 1 } do
		bodyPart(rig, "Olho", Vector3.new(0.16, 0.16, 0.06), CFrame.new(side * 0.2, 2.42, -0.53), c.eye)
		bodyPart(rig, "Orelha", Vector3.new(0.12, 0.35, 0.35), CFrame.new(side * 0.53, 2.3, -0.05), c.face)
		bodyPart(rig, "Braco", Vector3.new(0.32, 1.2, 0.32), CFrame.new(side * 0.72, 1.3, -0.05), c.furDark, M.Fabric)
	end
	bodyPart(rig, "Rabo", Vector3.new(0.2, 0.2, 0.9), CFrame.new(0, 0.95, 0.85), c.furDark)
	bodyPart(rig, "Rabo", Vector3.new(0.2, 0.9, 0.2), CFrame.new(0, 1.3, 1.2), c.furDark)
	weldTo(root, rig.body)

	local joints = {}
	for index, side in { -1, 1 } do
		local leg = partAt(
			rig,
			"Perna",
			Vector3.new(0.4, 0.8, 0.45),
			base * CFrame.new(side * 0.3, 0.4, 0),
			c.furDark,
			M.Fabric
		)
		local hip = motor(rig, "Quadril", root, leg, CFrame.new(side * 0.3, 0.8, 0))
		table.insert(joints, swingJoint(hip, 0.7, if index == 1 then 0 else math.pi))
	end
	rig.gait = { rate = 0.55, joints = joints }

	rig.eye = head
	rig.barAdornee = head
	rig.barOffset = 1.3
	rig.topOffset = 2.675 - rootY
	addHumanoid(rig, rootY - 0.5)
	return rig
end

-- Leão -----------------------------------------------------------------------------------------------

local LION = {
	body = Color3.fromRGB(212, 160, 84),
	dark = Color3.fromRGB(176, 124, 58),
	mane = Color3.fromRGB(118, 66, 28),
	muzzle = Color3.fromRGB(232, 196, 140),
	nose = Color3.fromRGB(58, 36, 26),
	eye = Color3.fromRGB(255, 186, 52),
}

function builders.Lion(name: string, base: CFrame)
	local rig = newRig(name, base)
	local c = LION
	local rootY = 3.1
	local root = groundRoot(rig, Vector3.new(2.6, 2, 4.4), rootY)

	bodyPart(rig, "Corpo", Vector3.new(2.8, 2.2, 5.6), CFrame.new(0, 3.2, 0.2), c.body, M.Fabric)
	bodyPart(rig, "Peito", Vector3.new(3, 2.5, 1.6), CFrame.new(0, 3.4, -2.2), c.body, M.Fabric)
	local mane = bodyPart(rig, "Juba", Vector3.new(3.6, 3.4, 1.8), CFrame.new(0, 4.4, -3), c.mane, M.Fabric)
	local head = bodyPart(rig, "Cabeca", Vector3.new(2.2, 2, 2), CFrame.new(0, 4.6, -3.9), c.body, M.Fabric)
	bodyPart(rig, "Focinho", Vector3.new(1.3, 0.9, 1), CFrame.new(0, 4.1, -5.2), c.muzzle)
	bodyPart(rig, "Nariz", Vector3.new(0.5, 0.35, 0.2), CFrame.new(0, 4.45, -5.72), c.nose)
	for _, side in { -1, 1 } do
		bodyPart(rig, "Olho", Vector3.new(0.3, 0.22, 0.1), CFrame.new(side * 0.55, 5.05, -4.92), c.eye, M.Neon)
		bodyPart(rig, "Orelha", Vector3.new(0.45, 0.45, 0.3), CFrame.new(side * 0.8, 5.75, -4.3), c.dark)
	end
	bodyPart(rig, "Rabo", Vector3.new(0.3, 0.3, 2.6), CFrame.new(0, 3.8, 4.3), c.dark)
	bodyPart(rig, "PontaDoRabo", Vector3.new(0.6, 0.6, 0.6), CFrame.new(0, 3.8, 5.8), c.mane, M.Fabric)
	weldTo(root, rig.body)

	-- Pernas em pares diagonais (trote): cada par fica soldado num "cubo" com Motor6D na raiz.
	local hubA = hub(rig, "PassoA", CFrame.new(0, 2.2, 0))
	local hubB = hub(rig, "PassoB", CFrame.new(0, 2.2, 0))
	local legSize = Vector3.new(0.85, 2.2, 0.85)
	local function leg(x: number, z: number): Part
		return partAt(rig, "Pata", legSize, base * CFrame.new(x, 1.1, z), c.body, M.Fabric)
	end
	weldTo(hubA, { leg(-0.95, -2), leg(0.95, 2) })
	weldTo(hubB, { leg(0.95, -2), leg(-0.95, 2) })
	local jointA = motor(rig, "PassoA", root, hubA, CFrame.new(0, 2.2, 0))
	local jointB = motor(rig, "PassoB", root, hubB, CFrame.new(0, 2.2, 0))
	rig.gait = { rate = 0.5, joints = { liftJoint(jointA, 0.5, 0.45, 0), liftJoint(jointB, 0.5, 0.45, math.pi) } }

	rig.eye = head
	rig.barAdornee = mane
	rig.barOffset = 2.6
	rig.topOffset = 6.1 - rootY
	addHumanoid(rig, rootY - 1)
	return rig
end

-- O Caçador ------------------------------------------------------------------------------------------

local HUNTER = {
	skin = Color3.fromRGB(226, 178, 140),
	shirt = Color3.fromRGB(170, 146, 96),
	pants = Color3.fromRGB(92, 72, 48),
	boots = Color3.fromRGB(48, 34, 24),
	belt = Color3.fromRGB(64, 42, 24),
	hat = Color3.fromRGB(120, 88, 52),
	band = Color3.fromRGB(58, 38, 22),
	mustache = Color3.fromRGB(40, 28, 20),
	eye = Color3.fromRGB(26, 22, 20),
	wood = Color3.fromRGB(110, 66, 32),
	metal = Color3.fromRGB(62, 62, 66),
}

function builders.Hunter(name: string, base: CFrame)
	local rig = newRig(name, base)
	local c = HUNTER
	local rootY = 3
	local root = groundRoot(rig, Vector3.new(2, 2, 1), rootY)

	bodyPart(rig, "Tronco", Vector3.new(2, 2, 1), CFrame.new(0, 3, 0), c.shirt, M.Fabric)
	bodyPart(rig, "Cinto", Vector3.new(2.06, 0.3, 1.06), CFrame.new(0, 2.15, 0), c.belt, M.Leather)
	local head = bodyPart(rig, "Cabeca", Vector3.new(1.2, 1.2, 1.2), CFrame.new(0, 4.6, 0), c.skin)
	for _, side in { -1, 1 } do
		bodyPart(rig, "Olho", Vector3.new(0.18, 0.18, 0.05), CFrame.new(side * 0.25, 4.75, -0.61), c.eye)
		bodyPart(rig, "PontaDoBigode", Vector3.new(0.16, 0.26, 0.12), CFrame.new(side * 0.46, 4.33, -0.64), c.mustache)
	end
	bodyPart(rig, "Bigode", Vector3.new(0.8, 0.18, 0.12), CFrame.new(0, 4.42, -0.64), c.mustache)
	bodyPart(rig, "AbaDoChapeu", Vector3.new(2.3, 0.15, 2.3), CFrame.new(0, 5.25, 0), c.hat, M.Fabric)
	bodyPart(rig, "CopaDoChapeu", Vector3.new(1.3, 0.7, 1.3), CFrame.new(0, 5.65, 0), c.hat, M.Fabric)
	bodyPart(rig, "FitaDoChapeu", Vector3.new(1.34, 0.18, 1.34), CFrame.new(0, 5.42, 0), c.band)
	-- Braços para a frente, segurando o rifle.
	bodyPart(rig, "BracoDireito", Vector3.new(0.75, 0.75, 1.9), CFrame.new(1, 3.55, -0.85), c.shirt, M.Fabric)
	bodyPart(rig, "BracoEsquerdo", Vector3.new(0.75, 0.75, 1.9), CFrame.new(-0.7, 3.45, -1.05), c.shirt, M.Fabric)
	bodyPart(rig, "Mao", Vector3.new(0.55, 0.55, 0.4), CFrame.new(1, 3.55, -1.95), c.skin)
	bodyPart(rig, "Mao", Vector3.new(0.55, 0.55, 0.4), CFrame.new(-0.55, 3.45, -2.15), c.skin)
	bodyPart(rig, "Rifle", Vector3.new(0.35, 0.45, 2.5), CFrame.new(0.45, 3.75, -1.75), c.wood, M.Wood)
	bodyPart(rig, "Luneta", Vector3.new(0.22, 0.22, 0.9), CFrame.new(0.45, 4.12, -1.9), c.metal, M.Metal)
	local barrel =
		bodyPart(rig, "CanoDoRifle", Vector3.new(0.2, 0.2, 2.4), CFrame.new(0.45, 3.85, -4.15), c.metal, M.Metal)
	weldTo(root, rig.body)

	local muzzle = Instance.new("Attachment")
	muzzle.Name = "Boca"
	muzzle.Position = Vector3.new(0, 0, -1.25)
	muzzle.Parent = barrel

	local joints = {}
	for index, side in { -1, 1 } do
		local leg =
			partAt(rig, "Perna", Vector3.new(0.9, 2, 0.9), base * CFrame.new(side * 0.5, 1, 0), c.pants, M.Fabric)
		local boot = partAt(
			rig,
			"Bota",
			Vector3.new(0.94, 0.45, 1.1),
			base * CFrame.new(side * 0.5, 0.225, -0.08),
			c.boots,
			M.Leather
		)
		PartBuilder.weld(leg, boot)
		local hip = motor(rig, "Quadril", root, leg, CFrame.new(side * 0.5, 2, 0))
		table.insert(joints, swingJoint(hip, 0.5, if index == 1 then 0 else math.pi))
	end
	rig.gait = { rate = 0.6, joints = joints }

	rig.eye = head
	rig.barAdornee = head
	rig.barOffset = 2
	rig.topOffset = 6 - rootY
	rig.extras.muzzle = muzzle
	rig.extras.barrel = barrel
	addHumanoid(rig, rootY - 1)
	return rig
end

-- Aranha Gigante -------------------------------------------------------------------------------------

local SPIDER = {
	body = Color3.fromRGB(34, 28, 26),
	leg = Color3.fromRGB(46, 36, 30),
	mark = Color3.fromRGB(170, 30, 30),
	eye = Color3.fromRGB(255, 40, 40),
	fang = Color3.fromRGB(230, 220, 200),
}

function builders.Spider(name: string, base: CFrame)
	local rig = newRig(name, base)
	local c = SPIDER
	local rootY = 2.2
	local root = groundRoot(rig, Vector3.new(3, 1.6, 4), rootY)

	local thorax = bodyPart(rig, "Cabeca", Vector3.new(2.2, 1.4, 2), CFrame.new(0, 2.3, -1.4), c.body, M.Fabric)
	local abdomen = bodyPart(rig, "Abdomen", Vector3.new(3.2, 2.4, 3.2), CFrame.new(0, 2.8, 1.3), c.body, M.Fabric)
	bodyPart(rig, "Marca", Vector3.new(1.2, 0.1, 1.4), CFrame.new(0, 4.02, 1.3), c.mark)
	for _, side in { -1, 1 } do
		bodyPart(rig, "Olho", Vector3.new(0.35, 0.3, 0.1), CFrame.new(side * 0.45, 2.65, -2.42), c.eye, M.Neon)
		bodyPart(rig, "Presa", Vector3.new(0.22, 0.6, 0.22), CFrame.new(side * 0.35, 1.75, -2.35), c.fang)
	end
	weldTo(root, rig.body)

	-- 8 pernas de dois segmentos, em dois grupos alternados (como uma aranha de verdade anda).
	local hubA = hub(rig, "PassoA", CFrame.new(0, 2.4, 0))
	local hubB = hub(rig, "PassoB", CFrame.new(0, 2.4, 0))
	local groupA, groupB = {}, {}
	for index, z in { -1.8, -0.9, 0, 0.9 } do
		for _, side in { -1, 1 } do
			local hip = Vector3.new(side * 1, 2.4, z)
			local knee = Vector3.new(side * 2.6, 3.4, z * 1.25)
			local foot = Vector3.new(side * 3.9, 0.05, z * 1.6)
			local upper = segment(rig, "Perna", hip, knee, 0.32, c.leg)
			local lower = segment(rig, "Perna", knee, foot, 0.28, c.leg)
			local inA = (index % 2 == 1) == (side == -1)
			local group = if inA then groupA else groupB
			table.insert(group, upper)
			table.insert(group, lower)
		end
	end
	weldTo(hubA, groupA)
	weldTo(hubB, groupB)
	local jointA = motor(rig, "PassoA", root, hubA, CFrame.new(0, 2.4, 0))
	local jointB = motor(rig, "PassoB", root, hubB, CFrame.new(0, 2.4, 0))
	rig.gait = { rate = 0.6, joints = { liftJoint(jointA, 0.45, 0.3, 0), liftJoint(jointB, 0.45, 0.3, math.pi) } }

	rig.eye = thorax
	rig.barAdornee = abdomen
	rig.barOffset = 2.4
	rig.topOffset = 4 - rootY
	rig.extras.mouth = thorax
	addHumanoid(rig, rootY - 0.8)
	return rig
end

-- Mosquito Gigante -----------------------------------------------------------------------------------

local MOSQUITO = {
	body = Color3.fromRGB(58, 52, 46),
	stripe = Color3.fromRGB(150, 140, 120),
	wing = Color3.fromRGB(200, 220, 230),
	eye = Color3.fromRGB(150, 20, 20),
	beak = Color3.fromRGB(30, 26, 22),
}

Rigs.MOSQUITO_HOVER = 7 -- altura em que o mosquito nasce acima do ponto no chão

function builders.Mosquito(name: string, base: CFrame)
	local rig = newRig(name, base)
	local c = MOSQUITO
	local h = Rigs.MOSQUITO_HOVER
	local root = anchoredRoot(rig, "Torax", Vector3.new(0.9, 0.8, 0.9), CFrame.new(0, h, 0), c.body, M.Fabric)
	root.CanCollide = false

	bodyPart(rig, "Abdomen", Vector3.new(0.65, 0.65, 1.6), CFrame.new(0, h - 0.1, 1.15), c.body, M.Fabric)
	bodyPart(rig, "Listra", Vector3.new(0.68, 0.68, 0.25), CFrame.new(0, h - 0.1, 1.05), c.stripe)
	local head = bodyPart(rig, "Cabeca", Vector3.new(0.6, 0.6, 0.6), CFrame.new(0, h + 0.1, -0.7), c.body)
	bodyPart(
		rig,
		"Ferrao",
		Vector3.new(0.1, 0.1, 1.3),
		CFrame.new(0, h - 0.25, -1.55) * CFrame.Angles(math.rad(-20), 0, 0),
		c.beak
	)
	for _, side in { -1, 1 } do
		bodyPart(rig, "Olho", Vector3.new(0.25, 0.3, 0.2), CFrame.new(side * 0.25, h + 0.2, -0.95), c.eye, M.Neon)
		local wing = bodyPart(
			rig,
			"Asa",
			Vector3.new(1.6, 0.05, 0.7),
			CFrame.new(side * 1, h + 0.45, 0.1) * CFrame.Angles(0, 0, side * math.rad(15)),
			c.wing,
			M.Glass
		)
		wing.Transparency = 0.45
		for _, z in { -0.2, 0.3 } do
			bodyPart(rig, "Pata", Vector3.new(0.08, 1.1, 0.08), CFrame.new(side * 0.35, h - 0.8, z), c.beak)
		end
	end
	weldTo(root, rig.body)

	rig.eye = head
	rig.barAdornee = root
	rig.barOffset = 1.6
	rig.feetOffset = h
	rig.topOffset = 0.8
	return rig
end

-- Planta Carnívora -----------------------------------------------------------------------------------

local PLANT = {
	pot = Color3.fromRGB(150, 84, 50),
	soil = Color3.fromRGB(70, 48, 30),
	stem = Color3.fromRGB(52, 120, 46),
	leaf = Color3.fromRGB(70, 150, 60),
	head = Color3.fromRGB(168, 44, 66),
	inner = Color3.fromRGB(236, 104, 124),
	teeth = Color3.fromRGB(240, 236, 220),
}

Rigs.PLANT_HEAD_Y = 5 -- altura do centro da cabeça acima do chão
Rigs.PLANT_REST_OPEN = 0.12 -- abertura da boca em repouso (radianos)
local PLANT_HINGE_BACK = 0.9
local PLANT_JAW_LENGTH = 2.2
local PLANT_JAW_HALF = 0.35

-- CFrames das duas mandíbulas para a cabeça virada (`yaw`, `pitch`) e aberta (`open`, radianos).
function Rigs.PlantJawCFrames(base: CFrame, yaw: number, pitch: number, open: number): (CFrame, CFrame)
	local hinge = base
		* CFrame.new(0, Rigs.PLANT_HEAD_Y, 0)
		* CFrame.Angles(0, yaw, 0)
		* CFrame.Angles(pitch, 0, 0)
		* CFrame.new(0, 0, PLANT_HINGE_BACK)
	local upper = hinge * CFrame.Angles(open, 0, 0) * CFrame.new(0, PLANT_JAW_HALF, -PLANT_JAW_LENGTH / 2)
	local lower = hinge * CFrame.Angles(-open * 0.6, 0, 0) * CFrame.new(0, -PLANT_JAW_HALF, -PLANT_JAW_LENGTH / 2)
	return upper, lower
end

function builders.Plant(name: string, base: CFrame)
	local rig = newRig(name, base)
	local c = PLANT
	local root = anchoredRoot(rig, "Vaso", Vector3.new(2.8, 1.6, 2.8), CFrame.new(0, 0.8, 0), c.pot, M.Slate)
	root.CanCollide = true
	root.CanTouch = true

	bodyPart(rig, "Terra", Vector3.new(2.5, 0.1, 2.5), CFrame.new(0, 1.62, 0), c.soil, M.Ground)
	local stem = bodyPart(rig, "Caule", Vector3.new(0.6, 3.6, 0.6), CFrame.new(0, 3.4, 0), c.stem, M.Grass)
	for _, side in { -1, 1 } do
		bodyPart(
			rig,
			"Folha",
			Vector3.new(1.8, 0.12, 0.8),
			CFrame.new(side * 1, 2.6, 0) * CFrame.Angles(0, 0, side * math.rad(20)),
			c.leaf,
			M.Grass
		)
	end
	weldTo(root, rig.body)

	-- Mandíbulas ancoradas (animadas por tween); dentes e "boca" soldados em cada uma.
	local upperCFrame, lowerCFrame = Rigs.PlantJawCFrames(base, 0, 0, Rigs.PLANT_REST_OPEN)
	local jawSize = Vector3.new(2.2, 0.7, 2.2)
	local upper = partAt(rig, "MandibulaDeCima", jawSize, upperCFrame, c.head)
	local lower = partAt(rig, "MandibulaDeBaixo", jawSize, lowerCFrame, c.head)
	upper.Anchored = true
	lower.Anchored = true
	local upperExtras =
		{ partAt(rig, "Boca", Vector3.new(1.9, 0.08, 1.9), upperCFrame * CFrame.new(0, -0.36, 0), c.inner) }
	local lowerExtras =
		{ partAt(rig, "Boca", Vector3.new(1.9, 0.08, 1.9), lowerCFrame * CFrame.new(0, 0.36, 0), c.inner) }
	for _, x in { -0.6, 0, 0.6 } do
		local toothSize = Vector3.new(0.25, 0.35, 0.25)
		table.insert(upperExtras, partAt(rig, "Dente", toothSize, upperCFrame * CFrame.new(x, -0.5, -0.9), c.teeth))
		table.insert(lowerExtras, partAt(rig, "Dente", toothSize, lowerCFrame * CFrame.new(x, 0.5, -0.9), c.teeth))
	end
	weldTo(upper, upperExtras)
	weldTo(lower, lowerExtras)

	rig.eye = stem
	rig.barAdornee = stem
	rig.barOffset = 4
	rig.feetOffset = 0.8
	rig.topOffset = Rigs.PLANT_HEAD_Y + 1 - 0.8
	rig.extras.upperJaw = upper
	rig.extras.lowerJaw = lower
	rig.extras.base = base
	return rig
end

-- API ----------------------------------------------------------------------------------------------

-- Monta o modelo do tipo `kind` com o nome `name` em `base` (ponto no chão, frente = LookVector).
-- O modelo volta SEM pai: quem chama configura e coloca em workspace.NPCs.
function Rigs.Build(kind: string, name: string, base: CFrame): Rig?
	local builder = builders[kind]
	if not builder then
		return nil
	end
	local rig = builder(name, base)
	rig.body = nil
	return rig :: any
end

return Rigs
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="76">
          <Properties>
            <string name="Name">SpiderAI</string>
            <string name="Source"><![CDATA[--!nonstrict
-- IA da Aranha Gigante: corre atrás do jogador e morde de perto (12 de dano). De média distância, com
-- visão livre, para por um instante e CUSPE TEIA: uma bola branca em arco que, se acertar, deixa o
-- jogador lento (WalkSpeed 6 por 3 s). A lentidão usa os modificadores empilháveis (mesma chave = renova
-- o tempo, sem restaurar o valor errado quando outro efeito também está ativo).

local Brain = require(script.Parent.Brain)
local Effects = require(script.Parent.Effects)
local Projectiles = require(script.Parent.Projectiles)

local SpiderAI = {}

local SPIT_MIN, SPIT_MAX = 10, 45 -- distâncias em que cospe teia
local SPIT_WINDUP = 0.35 -- pausa antes de cuspir (aviso visual: a aranha para e encara)
local SPIT_COOLDOWN_MIN, SPIT_COOLDOWN_MAX = 4, 6.5
local SPIT_LEAD = 0.35 -- quanto da velocidade do alvo entra na mira
local WEB_SLOW_SPEED = 6
local WEB_SLOW_TIME = 3
local WEB_JUMP = 0.35 -- multiplicador de pulo enquanto está preso
local WEB_KEY = "NpcTeiaDeAranha"
local WEB_COLOR = Color3.fromRGB(240, 240, 236)
local HISS_MIN, HISS_MAX = 6, 12
local SPAWN_DUST = Color3.fromRGB(60, 52, 44)

local function hiss(npc)
	Effects.Sound("Spider", npc.root.Position, { Volume = 0.6, RollOffMaxDistance = 90 })
end

local function onWebHit(player: Player, _position: Vector3)
	Effects.Slow(player, WEB_KEY, WEB_SLOW_SPEED, WEB_SLOW_TIME, WEB_JUMP)
	Effects.Mark(player, "Teia", WEB_COLOR, WEB_SLOW_TIME)
	Effects.Notify(player, "Uma teia grudou em você! Você está mais lento.", "warning", "teia", 5)
end

local function mouthPosition(npc): Vector3
	local mouth: BasePart? = npc.rig.extras.mouth
	local root: BasePart = npc.root
	if mouth and mouth.Parent then
		return mouth.Position + root.CFrame.LookVector * 1.4
	end
	return root.Position + root.CFrame.LookVector * 2.5
end

local function spit(npc, now: number)
	local memory = npc.memory
	memory.state = "chase"
	memory.nextSpit = now + npc.rng:NextNumber(SPIT_COOLDOWN_MIN, SPIT_COOLDOWN_MAX)
	local targetRoot = Brain.RootOf(npc.target)
	if not targetRoot then
		return
	end
	local origin = mouthPosition(npc)
	local velocity = targetRoot.AssemblyLinearVelocity
	local distance = (targetRoot.Position - origin).Magnitude
	-- O voo leva ~distância/70 s: mira um pouco à frente de quem corre (dá para desviar mudando de direção).
	local flight = math.clamp(distance / 70, 0.25, 0.9)
	local aim = targetRoot.Position + Vector3.new(velocity.X, 0, velocity.Z) * flight * SPIT_LEAD
	Brain.Face(npc, aim)
	Projectiles.FireWeb(npc, origin, aim, onWebHit)
	hiss(npc)
end

function SpiderAI.Setup(npc, now: number)
	local memory = npc.memory
	memory.state = "chase"
	memory.nextSpit = now + npc.rng:NextNumber(2, 4)
	memory.nextHiss = now + npc.rng:NextNumber(1, HISS_MAX)
	Effects.Burst(npc.root.Position, SPAWN_DUST)
end

function SpiderAI.Think(npc, now: number, _dt: number): number?
	local memory = npc.memory
	local def = npc.def

	-- Preparando o cuspe: parada, encarando o alvo.
	if memory.state == "spit" then
		local targetRoot = Brain.RootOf(npc.target)
		if targetRoot then
			Brain.Face(npc, targetRoot.Position)
		end
		if now >= memory.spitAt then
			spit(npc, now)
		end
		return 0.05
	end

	local target, targetRoot, distance = Brain.UpdateTarget(npc, now)
	if not target or not targetRoot then
		Brain.Wander(npc, now, 14)
		return def.idleInterval
	end

	if now >= memory.nextHiss then
		memory.nextHiss = now + npc.rng:NextNumber(HISS_MIN, HISS_MAX)
		hiss(npc)
	end

	-- Mordida.
	if distance <= def.attackRange + 1 then
		Brain.Melee(npc, now, target, targetRoot)
		Brain.ChaseTo(npc, now, targetRoot.Position, true, def.attackRange * 0.6)
		return nil
	end

	-- Cuspe de teia.
	local canSee: boolean? = nil
	if now >= memory.nextSpit and distance >= SPIT_MIN and distance <= SPIT_MAX and Brain.IsGrounded(npc) then
		canSee = Brain.LineOfSight(npc, now, targetRoot.Position)
		if canSee then
			Brain.Stop(npc)
			Brain.Face(npc, targetRoot.Position)
			memory.state = "spit"
			memory.spitAt = now + SPIT_WINDUP
			return 0.05
		end
		-- Sem visão: tenta de novo daqui a pouco.
		memory.nextSpit = now + 1
	end

	Brain.ChaseTo(npc, now, targetRoot.Position, canSee)
	return nil
end

function SpiderAI.Cleanup(_npc) end

return SpiderAI
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="77">
        <Properties>
          <string name="Name">Weapons</string>
        </Properties>
        <Item class="ModuleScript" referent="78">
          <Properties>
            <string name="Name">Combat</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Ações das armas no servidor. O WeaponService já validou o pedido (dono, arma na mão, jogador vivo,
-- argumentos e cadência); aqui ficam as regras de cada tipo:
--   * Fire: um raycast por projétil (com espalhamento), dano em inimigos, empurra objetos soltos, a
--     espingarda quebra parts Destructible de perto e todos veem o traço (Fx_Play "tracer");
--   * Melee: cone à frente do HumanoidRootPart, até maxTargets inimigos, com linha de visão;
--   * Throw: dinamite com física (trajetória balística até o alvo), pavio com faísca e explosão;
--   * StartReload: recarga com tempo (cancelada se a arma sair da mão; ver Inventory).
-- Sem fogo amigo: os tiros atravessam personagens e a explosão da dinamite não fere jogadores.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local SoundUtil = require(ReplicatedStorage.Shared.Audio.SoundUtil)
local Tags = require(ReplicatedStorage.Shared.Tags)

local CombatUtil = require(script.Parent.Parent.CombatUtil)
local Definitions = require(script.Parent.Definitions)

local Combat = {}

-- Ajustes --------------------------------------------------------------------------------------

local MAX_LIVE_DYNAMITE = 24 -- bananas acesas ao mesmo tempo (o resto do arremesso é recusado)
local DYNAMITE_NO_COLLIDE_TIME = 0.12 -- sem colisão logo após sair da mão (não bate no próprio corpo)
local DYNAMITE_COLOR = Color3.fromRGB(176, 38, 30)
local SPARK_COLOR = ColorSequence.new(Color3.fromRGB(255, 236, 140), Color3.fromRGB(255, 120, 40))
local FUSE_LIGHT = Color3.fromRGB(255, 170, 80)
local MELEE_PREFILTER = 14 -- folga sobre o alcance para o pivô de inimigos grandes (leão)

-- Estado ---------------------------------------------------------------------------------------

local random = Random.new()
local fxRemote: RemoteEvent? = nil
local Destruction = nil -- DestructionService (opcional: carregado com segurança pelo WeaponService)
local liveDynamite = 0

function Combat.Init(destructionService: any)
	Destruction = destructionService
	fxRemote = Net.event(Net.Names.Fx_Play)
end

-- Utilitários ----------------------------------------------------------------------------------

-- Posição da cabeça (ou um ponto acima do HumanoidRootPart, se não houver cabeça).
function Combat.GetHeadPosition(character: Model?): Vector3?
	if not character then
		return nil
	end
	local head = character:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		return head.Position
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root.Position + Vector3.new(0, 1.5, 0)
	end
	return nil
end

local function bumpCounter(tool: Tool, attribute: string)
	tool:SetAttribute(attribute, (tonumber(tool:GetAttribute(attribute)) or 0) + 1)
end

-- Lista de exclusão dos tiros: personagens (sem fogo amigo), pedaços de destruição e o tabuleiro
-- (que pode estar nas costas de quem atira).
local function shotExcludeList(): { Instance }
	local list = {}
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(list, player.Character)
		end
	end
	for _, name in { "Debris", "Board" } do
		local folder = workspace:FindFirstChild(name)
		if folder then
			table.insert(list, folder)
		end
	end
	return list
end

local function newShotParams(): RaycastParams
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = shotExcludeList()
	params.IgnoreWater = true
	return params
end

-- Raiz do objeto solto (LooseProp) ao qual a part pertence, ou nil.
local function looseRootOf(part: BasePart): BasePart?
	if Destruction and type(Destruction.GetLooseRoot) == "function" then
		local ok, root = pcall(Destruction.GetLooseRoot, part)
		return ok and root or nil
	end
	if CollectionService:HasTag(part, Tags.LooseProp) then
		return part
	end
	return nil
end

-- O tiro atravessa parts invisíveis ou sem colisão (folhagem, água, volumes de evento),
-- mas nunca inimigos nem objetos soltos (que são alvos).
local function shouldPierce(part: BasePart): boolean
	if part:IsA("Terrain") then
		return false
	end
	if part.CanCollide and part.Transparency < 0.9 then
		return false
	end
	if CombatUtil.FindEnemyFromPart(part) then
		return false
	end
	return looseRootOf(part) == nil
end

-- Raycast que atravessa até MAX_RAY_PIERCE parts "vazadas". Retorna o resultado (ou nil) e o ponto final.
local function castRay(
	origin: Vector3,
	direction: Vector3,
	distance: number,
	params: RaycastParams
): (RaycastResult?, Vector3)
	local start = origin
	local remaining = distance
	for _ = 0, Definitions.MAX_RAY_PIERCE do
		local result = workspace:Raycast(start, direction * remaining, params)
		if not result then
			break
		end
		if not shouldPierce(result.Instance) then
			return result, result.Position
		end
		params:AddToFilter(result.Instance)
		remaining -= (result.Position - start).Magnitude
		start = result.Position
		if remaining <= 0.05 then
			return nil, start
		end
	end
	return nil, start + direction * remaining
end

-- Direção aleatória dentro de um cone (distribuição uniforme no disco).
local function spreadDirection(direction: Vector3, degrees: number): Vector3
	if degrees <= 0 then
		return direction
	end
	local up = if math.abs(direction.Y) > 0.99 then Vector3.xAxis else Vector3.yAxis
	local right = direction:Cross(up).Unit
	local realUp = right:Cross(direction).Unit
	local angle = math.rad(degrees) * math.sqrt(random:NextNumber())
	local theta = random:NextNumber(0, math.pi * 2)
	local offset = (right * math.cos(theta) + realUp * math.sin(theta)) * math.tan(angle)
	return (direction + offset).Unit
end

-- Solta (desancora) e empurra um objeto solto. Cada objeto é empurrado uma vez por tiro.
local function pushProp(part: BasePart, velocity: Vector3, pushed: { [BasePart]: boolean }): boolean
	local root = looseRootOf(part)
	if not root or pushed[root] then
		return root ~= nil
	end
	pushed[root] = true
	if Destruction and type(Destruction.ReleaseProp) == "function" then
		local ok, err = pcall(Destruction.ReleaseProp, root, velocity)
		if not ok then
			warn("[Weapons] Erro ao soltar objeto: " .. tostring(err))
		end
	elseif root.Anchored or root.AssemblyRootPart == root then
		root.Anchored = false
		pcall(root.SetNetworkOwner, root, nil)
		root.AssemblyLinearVelocity = velocity
	end
	return true
end

local function fireTracer(from: Vector3, to: Vector3, def: Definitions.WeaponDef, shooter: Player)
	if not fxRemote then
		return
	end
	fxRemote:FireAllClients("tracer", {
		from = from,
		to = to,
		color = def.tracerColor,
		width = def.tracerWidth,
		shooterUserId = shooter.UserId,
	})
end

-- Recarga ----------------------------------------------------------------------------------------

function Combat.StartReload(player: Player, tool: Tool, state: any, def: Definitions.WeaponDef): boolean
	if def.category ~= "gun" or state.reloading or not tool.Parent then
		return false
	end
	local ammo = tonumber(tool:GetAttribute("Ammo")) or 0
	local maxAmmo = def.maxAmmo or 0
	if ammo >= maxAmmo then
		return false
	end
	state.reloading = true
	state.reloadToken += 1
	local token = state.reloadToken
	tool:SetAttribute("Reloading", true)
	task.delay(def.reloadTime or 1.5, function()
		if state.reloadToken ~= token or not state.reloading then
			return -- cancelada (arma guardada) ou substituída por uma coleta
		end
		state.reloading = false
		if not tool.Parent then
			return
		end
		tool:SetAttribute("Reloading", false)
		if tool.Parent == player.Character and CombatUtil.IsPlayerAlive(player) then
			tool:SetAttribute("Ammo", maxAmmo)
		end
	end)
	return true
end

-- Tiro -------------------------------------------------------------------------------------------

-- `origin` e `direction` já validados (origem perto da cabeça, direção unitária).
function Combat.Fire(
	player: Player,
	tool: Tool,
	state: any,
	def: Definitions.WeaponDef,
	origin: Vector3,
	direction: Vector3
): boolean
	local ammo = tonumber(tool:GetAttribute("Ammo")) or 0
	if ammo <= 0 or state.reloading then
		return false
	end
	state.lastUse = os.clock()
	ammo -= 1
	tool:SetAttribute("Ammo", ammo)
	bumpCounter(tool, "FireSeq")

	local params = newShotParams()

	-- Cano atravessando uma parede (jogador encostado nela): o tiro sai da cabeça e para na parede.
	local start = origin
	local head = Combat.GetHeadPosition(player.Character)
	if head then
		local toOrigin = origin - head
		local length = toOrigin.Magnitude
		if length > 0.05 then
			local blocked = castRay(head, toOrigin / length, length, params)
			if blocked then
				start = head
			end
		end
	end

	local pellets = math.max(math.floor(def.pellets or 1), 1)
	local damage = def.damage or 0
	local damageByEnemy: { [Model]: number } = {}
	local enemyOrder: { Model } = {}
	local pushed: { [BasePart]: boolean } = {}
	local fractureHits: { [BasePart]: { count: number, sum: Vector3 } } = {}

	for _ = 1, pellets do
		local pelletDirection = spreadDirection(direction, def.spread or 0)
		local result, endPoint = castRay(start, pelletDirection, def.range, params)
		if result then
			local part = result.Instance
			local enemy = CombatUtil.FindEnemyFromPart(part)
			if enemy then
				if not damageByEnemy[enemy] then
					table.insert(enemyOrder, enemy)
				end
				damageByEnemy[enemy] = (damageByEnemy[enemy] or 0) + damage
			elseif not pushProp(part, pelletDirection * (def.propPush or 0), pushed) then
				local canBreak = def.fractureRange ~= nil
					and Destruction ~= nil
					and (result.Position - start).Magnitude <= def.fractureRange
					and Destruction.IsDestructible(part)
				if canBreak then
					local entry = fractureHits[part]
					if not entry then
						entry = { count = 0, sum = Vector3.zero }
						fractureHits[part] = entry
					end
					entry.count += 1
					entry.sum += result.Position
				end
			end
		end
		fireTracer(start, endPoint, def, player)
	end

	-- Dano somado por inimigo (um golpe só para vários projéteis no mesmo alvo).
	for _, enemy in enemyOrder do
		CombatUtil.DamageEnemy(enemy, damageByEnemy[enemy], player)
	end

	-- No máximo uma quebra por tiro: a part que recebeu mais projéteis (mínimo fractureMinPellets).
	local bestPart, bestEntry = nil, nil
	for part, entry in fractureHits do
		if entry.count >= (def.fractureMinPellets or 1) and (not bestEntry or entry.count > bestEntry.count) then
			bestPart, bestEntry = part, entry
		end
	end
	if bestPart and bestEntry and bestPart.Parent and Destruction then
		local ok, err = pcall(Destruction.Fracture, bestPart, bestEntry.sum / bestEntry.count, def.fractureImpulse)
		if not ok then
			warn("[Weapons] Erro ao quebrar com tiro: " .. tostring(err))
		end
	end

	-- Acabou a munição: recarrega sozinho depois da cadência (se continuar na mão).
	if ammo <= 0 then
		task.delay(def.cooldown, function()
			if tool.Parent and tool.Parent == player.Character and CombatUtil.IsPlayerAlive(player) then
				Combat.StartReload(player, tool, state, def)
			end
		end)
	end
	return true
end

-- Corpo a corpo -------------------------------------------------------------------------------------

local function closestPointOnBox(boxCFrame: CFrame, boxSize: Vector3, point: Vector3): Vector3
	local localPoint = boxCFrame:PointToObjectSpace(point)
	local half = boxSize / 2
	local clamped = Vector3.new(
		math.clamp(localPoint.X, -half.X, half.X),
		math.clamp(localPoint.Y, -half.Y, half.Y),
		math.clamp(localPoint.Z, -half.Z, half.Z)
	)
	return boxCFrame:PointToWorldSpace(clamped)
end

-- Linha de visão só contra o cenário sólido (ignora personagens, inimigos, pedaços e o tabuleiro).
local function newSightParams(): RaycastParams
	local list = shotExcludeList()
	local npcs = workspace:FindFirstChild("NPCs")
	if npcs then
		table.insert(list, npcs)
	end
	for _, enemy in CollectionService:GetTagged(Tags.Enemy) do
		table.insert(list, enemy)
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = list
	params.RespectCanCollide = true
	params.IgnoreWater = true
	return params
end

local function hasLineOfSight(from: Vector3, to: Vector3, params: RaycastParams): boolean
	local delta = to - from
	local length = delta.Magnitude
	if length < 0.75 then
		return true
	end
	local result = workspace:Raycast(from, delta, params)
	return result == nil or (result.Position - from).Magnitude >= length - 1
end

-- Golpe do facão. Retorna quantos inimigos foram atingidos.
function Combat.Melee(player: Player, tool: Tool, state: any, def: Definitions.WeaponDef): number
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return 0
	end
	state.lastUse = os.clock()
	bumpCounter(tool, "SwingSeq")

	local rootCFrame = root.CFrame
	local origin = rootCFrame.Position
	local flatLook = Vector3.new(rootCFrame.LookVector.X, 0, rootCFrame.LookVector.Z)
	if flatLook.Magnitude < 1e-3 then
		return 0
	end
	flatLook = flatLook.Unit
	local minDot = math.cos(math.rad((def.coneAngle or 70) / 2))
	local range = def.range
	local maxHeight = def.maxHeightDifference or 7

	local candidates = {}
	local sightParams: RaycastParams? = nil
	for _, enemy in CollectionService:GetTagged(Tags.Enemy) do
		if enemy:IsA("Model") and enemy:IsDescendantOf(workspace) and CombatUtil.IsEnemyAlive(enemy) then
			local pivot = enemy:GetPivot().Position
			if (pivot - origin).Magnitude <= range + MELEE_PREFILTER then
				local boxCFrame, boxSize = enemy:GetBoundingBox()
				local closest = closestPointOnBox(boxCFrame, boxSize, origin)
				local offset = closest - origin
				local distance = offset.Magnitude
				if distance <= range and math.abs(offset.Y) <= maxHeight then
					local flatOffset = Vector3.new(offset.X, 0, offset.Z)
					local inCone = flatOffset.Magnitude <= Definitions.MELEE_POINT_BLANK
						or flatLook:Dot(flatOffset.Unit) >= minDot
					if inCone then
						sightParams = sightParams or newSightParams()
						-- Mira um pouco para dentro da caixa (o ponto mais próximo pode estar rente ao chão).
						local aimPoint = closest:Lerp(boxCFrame.Position, 0.3)
						if hasLineOfSight(origin, aimPoint, sightParams :: RaycastParams) then
							table.insert(candidates, { enemy = enemy, distance = distance, point = closest })
						end
					end
				end
			end
		end
	end

	table.sort(candidates, function(a, b)
		return a.distance < b.distance
	end)
	local hits = math.min(#candidates, def.maxTargets or 1)
	for index = 1, hits do
		CombatUtil.DamageEnemy(candidates[index].enemy, def.damage or 0, player)
	end
	if hits > 0 and def.hitSound then
		SoundUtil.Play(def.hitSound, { Position = candidates[1].point, Volume = 0.7, RollOffMaxDistance = 120 })
	end
	return hits
end

-- Dinamite --------------------------------------------------------------------------------------------

local function projectileFolder(): Instance
	-- workspace.Debris: os raycasts de armas, NPCs e eventos já ignoram esta pasta.
	local folder = workspace:FindFirstChild("Debris")
	if folder then
		return folder
	end
	local created = Instance.new("Folder")
	created.Name = "Debris"
	created.Parent = workspace
	return created
end

local function explode(position: Vector3, def: Definitions.WeaponDef, player: Player)
	local attacker = if player.Parent then player else nil
	if Destruction and type(Destruction.Explode) == "function" then
		local ok, err = pcall(Destruction.Explode, position, def.blastRadius or 14, def.blastForce or 80, {
			damageEnemies = def.damageEnemies,
			attacker = attacker,
			source = def.source,
		})
		if ok then
			return
		end
		warn("[Weapons] Erro na explosão da dinamite: " .. tostring(err))
	end
	-- Sem DestructionService: explosão só visual, com dano nos inimigos (nunca nos jogadores).
	local explosion = Instance.new("Explosion")
	explosion.BlastPressure = 0
	explosion.BlastRadius = def.blastRadius or 14
	explosion.DestroyJointRadiusPercent = 0
	explosion.ExplosionType = Enum.ExplosionType.NoCraters
	explosion.Position = position
	explosion.Parent = workspace
	SoundUtil.Play("Explosion", { Position = position, RollOffMaxDistance = 350, Volume = 0.9 })
	CombatUtil.DamageEnemiesInRadius(position, def.blastRadius or 14, def.damageEnemies or 0, attacker)
end

local function spawnDynamite(player: Player, def: Definitions.WeaponDef, start: Vector3, target: Vector3)
	local stick = Instance.new("Part")
	stick.Name = "DinamiteAcesa"
	stick.Shape = Enum.PartType.Cylinder
	stick.Size = Vector3.new(1.15, 0.42, 0.42)
	stick.Color = DYNAMITE_COLOR
	stick.Material = Enum.Material.SmoothPlastic
	stick.TopSurface = Enum.SurfaceType.Smooth
	stick.BottomSurface = Enum.SurfaceType.Smooth
	stick.CanCollide = false
	stick.CanTouch = false
	stick.CastShadow = false
	stick.CustomPhysicalProperties = PhysicalProperties.new(0.9, 1, 0.15, 1, 1)
	stick.CFrame = CFrame.new(start) * CFrame.Angles(0, random:NextNumber(0, math.pi * 2), math.rad(80))

	-- Pavio aceso: faísca + luz fraca (criados no servidor, replicam sozinhos).
	local fuse = Instance.new("Attachment")
	fuse.Name = "Pavio"
	fuse.Position = Vector3.new(0.62, 0, 0)
	fuse.Parent = stick
	local sparks = Instance.new("ParticleEmitter")
	sparks.Name = "Faisca"
	sparks.Rate = 45
	sparks.Lifetime = NumberRange.new(0.15, 0.35)
	sparks.Speed = NumberRange.new(3, 7)
	sparks.SpreadAngle = Vector2.new(180, 180)
	sparks.Acceleration = Vector3.new(0, -14, 0)
	sparks.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 0) })
	sparks.Color = SPARK_COLOR
	sparks.LightEmission = 1
	sparks.LightInfluence = 0
	sparks.Parent = fuse
	local light = Instance.new("PointLight")
	light.Color = FUSE_LIGHT
	light.Brightness = 1.6
	light.Range = 8
	light.Shadows = false
	light.Parent = fuse

	stick.Parent = projectileFolder()
	pcall(stick.SetNetworkOwner, stick, nil)

	-- Trajetória balística: chega ao alvo em `flight` segundos (alvos longe sobem mais).
	local delta = target - start
	local flatDistance = Vector3.new(delta.X, 0, delta.Z).Magnitude
	local flight = math.clamp(
		flatDistance / math.max(def.flightSpeed or 40, 1),
		Definitions.THROW_MIN_FLIGHT,
		Definitions.THROW_MAX_FLIGHT
	)
	local velocity = delta / flight + Vector3.new(0, 0.5 * workspace.Gravity * flight, 0)
	if velocity.Magnitude > Definitions.THROW_MAX_SPEED then
		velocity = velocity.Unit * Definitions.THROW_MAX_SPEED
	end
	stick.AssemblyLinearVelocity = velocity
	stick.AssemblyAngularVelocity =
		Vector3.new(random:NextNumber(-8, 8), random:NextNumber(-3, 3), random:NextNumber(-8, 8))

	liveDynamite += 1
	task.delay(DYNAMITE_NO_COLLIDE_TIME, function()
		if stick.Parent then
			stick.CanCollide = true
		end
	end)
	task.delay(def.fuseTime or 2.5, function()
		liveDynamite -= 1
		if not stick.Parent then
			return -- caiu para fora do mundo e foi destruída pelo motor
		end
		local position = stick.Position
		stick:Destroy()
		explode(position, def, player)
	end)
end

-- Arremesso validado (alvo dentro do alcance). Retorna true se a dinamite foi lançada.
function Combat.Throw(player: Player, tool: Tool, state: any, def: Definitions.WeaponDef, target: Vector3): boolean
	local character = player.Character
	local head = Combat.GetHeadPosition(character)
	local charges = tonumber(tool:GetAttribute("Charges")) or 0
	if not head or charges <= 0 or liveDynamite >= MAX_LIVE_DYNAMITE then
		return false
	end
	state.lastUse = os.clock()
	charges -= 1
	tool:SetAttribute("Charges", charges)
	bumpCounter(tool, "ThrowSeq")

	-- Sai da mão (Handle) se ela estiver perto da cabeça e sem parede no meio; senão, da cabeça.
	local start = head
	local handle = tool:FindFirstChild("Handle")
	if handle and handle:IsA("BasePart") then
		local delta = handle.Position - head
		local length = delta.Magnitude
		if length <= 5 and (length < 0.05 or castRay(head, delta / length, length, newShotParams()) == nil) then
			start = handle.Position
		end
	end
	spawnDynamite(player, def, start, target)

	-- Última carga: a arma some da mão.
	if charges <= 0 then
		task.defer(function()
			if tool.Parent then
				tool:Destroy()
			end
		end)
	end
	return true
end

return Combat
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="79">
          <Properties>
            <string name="Name">Definitions</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Números e textos de cada arma (servidor).
-- O cliente não lê este módulo: o que ele precisa (alcance, cadência, munição, cor do traço...) vai como
-- atributo da Tool (ver ToolFactory). Para balancear, ajuste só aqui.

local Definitions = {}

export type WeaponDef = {
	kind: string, -- "Machete" | "Revolver" | "Shotgun" | "Dynamite"
	category: string, -- "melee" | "gun" | "throw"
	displayName: string,
	article: string, -- artigo usado nas mensagens ("o" / "a")
	description: string, -- texto curto do ProximityPrompt
	tooltip: string,
	cooldown: number, -- segundos entre usos (cadência)
	range: number, -- studs
	spawnWeight: number, -- chance relativa de aparecer nos pontos de arma
	useSound: string?, -- som tocado por quem usa (o atirador toca na hora; os outros, pelo atributo de sequência)

	-- Corpo a corpo
	damage: number?,
	coneAngle: number?, -- abertura total do cone à frente do HumanoidRootPart (graus)
	maxTargets: number?,
	maxHeightDifference: number?,
	hitSound: string?,

	-- Armas de fogo
	maxAmmo: number?,
	reloadTime: number?,
	pellets: number?,
	spread: number?, -- meia-abertura do cone de espalhamento (graus)
	recoil: number?, -- graus que o cano sobe no coice (só visual, no cliente)
	tracerColor: Color3?,
	tracerWidth: number?,
	propPush: number?, -- velocidade dada a um objeto solto atingido (por projétil)
	fractureRange: number?, -- até esta distância o tiro pode quebrar parts Destructible
	fractureImpulse: number?,
	fractureMinPellets: number?, -- projéteis na mesma part para ela quebrar

	-- Arremesso
	charges: number?, -- cargas por coleta
	maxCharges: number?,
	fuseTime: number?,
	flightSpeed: number?, -- velocidade horizontal média do arremesso (studs/s)
	blastRadius: number?,
	blastForce: number?,
	damageEnemies: number?,
	source: string?,
}

-- Regras gerais ---------------------------------------------------------------------------

Definitions.MAX_WEAPONS_PER_PLAYER = 3
Definitions.ORIGIN_MAX_DISTANCE = 10 -- a origem do tiro pode estar até isto da cabeça do atirador
Definitions.COOLDOWN_TOLERANCE = 0.75 -- aceita pedidos um pouco antes da cadência (oscilação da rede)
Definitions.THROW_RANGE_TOLERANCE = 4 -- folga no alcance do arremesso (o jogador anda durante o envio)
Definitions.PICKUP_DISTANCE = 12 -- distância máxima (servidor) para pegar uma arma do chão
Definitions.PICKUP_PROMPT_DISTANCE = 8 -- distância do ProximityPrompt (cliente)
Definitions.PICKUP_HOLD = 0.3
Definitions.PICKUP_DEBOUNCE = 0.35 -- intervalo mínimo entre coletas do mesmo jogador
Definitions.MAX_RAY_PIERCE = 4 -- parts invisíveis e sem colisão atravessadas por um tiro
Definitions.MELEE_POINT_BLANK = 3 -- colado no inimigo: acerta mesmo fora do cone
Definitions.RESPAWN_RETRY = 15 -- sem ponto livre: tenta de novo depois disto

-- Arremesso (trajetória balística calculada no servidor)
Definitions.THROW_MIN_FLIGHT = 0.45 -- segundos
Definitions.THROW_MAX_FLIGHT = 1.4
Definitions.THROW_MAX_SPEED = 150

-- Limite de pedidos por jogador (balde de fichas): protege o servidor de spam de remotes.
Definitions.REQUEST_BUDGET = 20
Definitions.REQUEST_REFILL = 12 -- fichas por segundo

-- Armas que sempre aparecem nos pontos da sala inicial (alternadas).
Definitions.START_ROOM_KINDS = { "Machete", "Revolver" }

-- Ordem usada para garantir variedade na primeira distribuição.
Definitions.ORDER = { "Machete", "Revolver", "Shotgun", "Dynamite" }

Definitions.Weapons = {
	Machete = {
		kind = "Machete",
		category = "melee",
		displayName = "Facão",
		article = "o",
		description = "Corpo a corpo",
		tooltip = "Golpeia tudo o que estiver bem à sua frente.",
		cooldown = 0.55,
		range = 8,
		spawnWeight = 3,
		useSound = "MacheteSwing",
		damage = 35,
		coneAngle = 70,
		maxTargets = 3,
		maxHeightDifference = 7,
		hitSound = "MacheteHit",
	},
	Revolver = {
		kind = "Revolver",
		category = "gun",
		displayName = "Revólver",
		article = "o",
		description = "6 balas",
		tooltip = "6 balas, recarga rápida e longo alcance.",
		cooldown = 0.35,
		range = 300,
		spawnWeight = 3,
		useSound = "Gunshot",
		damage = 34,
		maxAmmo = 6,
		reloadTime = 1.6,
		pellets = 1,
		spread = 0,
		recoil = 12,
		tracerColor = Color3.fromRGB(255, 226, 140),
		tracerWidth = 0.12,
		propPush = 28,
	},
	Shotgun = {
		kind = "Shotgun",
		category = "gun",
		displayName = "Espingarda",
		article = "a",
		description = "2 cartuchos",
		tooltip = "Dois cartuchos devastadores de perto. Quebra paredes!",
		cooldown = 0.5,
		range = 90,
		spawnWeight = 2,
		useSound = "Shotgun",
		damage = 11, -- por projétil
		maxAmmo = 2,
		reloadTime = 2.2,
		pellets = 8,
		spread = 6,
		recoil = 22,
		tracerColor = Color3.fromRGB(255, 190, 110),
		tracerWidth = 0.07,
		propPush = 9,
		fractureRange = 25,
		fractureImpulse = 14,
		fractureMinPellets = 2,
	},
	Dynamite = {
		kind = "Dynamite",
		category = "throw",
		displayName = "Dinamite",
		article = "a",
		description = "3 cargas",
		tooltip = "Arremesse e corra! Explode depois de 2,5 s.",
		cooldown = 0.9,
		range = 60,
		spawnWeight = 2,
		useSound = "MacheteSwing", -- o "vupt" do arremesso
		charges = 3,
		maxCharges = 9,
		fuseTime = 2.5,
		flightSpeed = 42,
		blastRadius = 14,
		blastForce = 80,
		damageEnemies = 120,
		source = "Dinamite",
	},
} :: { [string]: WeaponDef }

-- Devolve a definição de um tipo (ou nil se o valor não for um tipo conhecido).
function Definitions.Get(kind: any): WeaponDef?
	if type(kind) ~= "string" then
		return nil
	end
	return Definitions.Weapons[kind]
end

-- Sorteia um tipo respeitando spawnWeight.
function Definitions.RandomKind(random: Random): string
	local total = 0
	for _, kind in Definitions.ORDER do
		total += Definitions.Weapons[kind].spawnWeight
	end
	local roll = random:NextNumber(0, total)
	for _, kind in Definitions.ORDER do
		roll -= Definitions.Weapons[kind].spawnWeight
		if roll <= 0 then
			return kind
		end
	end
	return Definitions.ORDER[#Definitions.ORDER]
end

-- "o Facão" / "a Dinamite" (para mensagens).
function Definitions.WithArticle(def: WeaponDef): string
	return def.article .. " " .. def.displayName
end

return Definitions
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="80">
          <Properties>
            <string name="Name">Inventory</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Armas que cada jogador carrega (Backpack + personagem) e as regras de coleta:
--   * no máximo Definitions.MAX_WEAPONS_PER_PLAYER armas;
--   * pegar um tipo que já tem recarrega a munição (armas de fogo) ou soma cargas (dinamite);
--   * senão, cria a Tool na Backpack.
-- Também cancela a recarga quando a arma sai da mão e remove as armas de quem foi eliminado.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Tags = require(ReplicatedStorage.Shared.Tags)

local Definitions = require(script.Parent.Definitions)
local ToolFactory = require(script.Parent.ToolFactory)

local Inventory = {}

-- Resultado de uma tentativa de dar arma (usado nas mensagens ao jogador).
export type GiveResult = "created" | "refilled" | "full" | "limit" | "invalid"

-- Consulta ------------------------------------------------------------------------------------

local function isOwnedWeapon(instance: Instance, player: Player): boolean
	if not instance:IsA("Tool") or not CollectionService:HasTag(instance, Tags.Weapon) then
		return false
	end
	local state = ToolFactory.GetState(instance)
	return state ~= nil and state.ownerUserId == player.UserId
end

-- Todas as armas do jogador (as da Backpack e a que está na mão).
function Inventory.GetWeapons(player: Player): { Tool }
	local list = {}
	local containers = { player:FindFirstChildOfClass("Backpack"), player.Character }
	for _, container in containers do
		if container then
			for _, child in container:GetChildren() do
				if isOwnedWeapon(child, player) then
					table.insert(list, child :: Tool)
				end
			end
		end
	end
	return list
end

function Inventory.FindByKind(player: Player, kind: string): Tool?
	for _, tool in Inventory.GetWeapons(player) do
		if tool:GetAttribute("WeaponKind") == kind then
			return tool
		end
	end
	return nil
end

-- Recarga -------------------------------------------------------------------------------------

-- Interrompe uma recarga em andamento (a munição não muda).
function Inventory.CancelReload(tool: Tool)
	local state = ToolFactory.GetState(tool)
	if not state or not state.reloading then
		return
	end
	state.reloading = false
	state.reloadToken += 1
	tool:SetAttribute("Reloading", false)
end

-- Enche a munição / soma cargas de uma arma que o jogador já tem. Retorna false se nada mudaria.
function Inventory.Refill(tool: Tool, def: Definitions.WeaponDef): boolean
	if def.category == "gun" then
		local ammo = tonumber(tool:GetAttribute("Ammo")) or 0
		local maxAmmo = def.maxAmmo or 0
		if ammo >= maxAmmo and not tool:GetAttribute("Reloading") then
			return false
		end
		Inventory.CancelReload(tool)
		tool:SetAttribute("Ammo", maxAmmo)
		return true
	elseif def.category == "throw" then
		local charges = tonumber(tool:GetAttribute("Charges")) or 0
		local maxCharges = def.maxCharges or def.charges or 1
		if charges >= maxCharges then
			return false
		end
		tool:SetAttribute("Charges", math.min(charges + (def.charges or 1), maxCharges))
		return true
	end
	-- Corpo a corpo não tem munição: um segundo facão não muda nada.
	return false
end

-- Criação ---------------------------------------------------------------------------------------

local function watchTool(tool: Tool, player: Player)
	local state = ToolFactory.GetState(tool)
	if not state then
		return
	end
	-- Guardou a arma (ou ela saiu do personagem) no meio da recarga: a recarga é cancelada.
	table.insert(
		state.connections,
		tool:GetPropertyChangedSignal("Parent"):Connect(function()
			if state.reloading and (player.Character == nil or tool.Parent ~= player.Character) then
				Inventory.CancelReload(tool)
			end
		end)
	)
end

-- Dá uma arma ao jogador seguindo as regras. Retorna a Tool afetada (nova ou recarregada) e o resultado.
function Inventory.Give(player: Player, kind: string): (Tool?, GiveResult)
	local def = Definitions.Get(kind)
	if not def or not player.Parent then
		return nil, "invalid"
	end
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then
		return nil, "invalid"
	end

	local existing = Inventory.FindByKind(player, kind)
	if existing then
		if Inventory.Refill(existing, def) then
			return existing, "refilled"
		end
		return existing, "full"
	end

	if #Inventory.GetWeapons(player) >= Definitions.MAX_WEAPONS_PER_PLAYER then
		return nil, "limit"
	end

	local tool = ToolFactory.CreateTool(kind, player)
	if not tool then
		return nil, "invalid"
	end
	watchTool(tool, player)
	tool.Parent = backpack
	return tool, "created"
end

-- Remove todas as armas do jogador (eliminado ou fim de jogo).
function Inventory.RemoveAll(player: Player)
	for _, tool in Inventory.GetWeapons(player) do
		tool:Destroy()
	end
	-- Ferramentas marcadas como arma sem registro (não deveriam existir) também saem.
	local containers = { player:FindFirstChildOfClass("Backpack"), player.Character }
	for _, container in containers do
		if container then
			for _, child in container:GetChildren() do
				if child:IsA("Tool") and CollectionService:HasTag(child, Tags.Weapon) then
					child:Destroy()
				end
			end
		end
	end
end

return Inventory
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="81">
          <Properties>
            <string name="Name">Spawner</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Armas espalhadas pelo mapa (servidor).
--   * No Init coloca GameConfig.WEAPON_SPAWN_COUNT armas em pontos WeaponSpawn: primeiro TODOS os pontos
--     dentro da sala inicial (Facão e Revólver alternados, garantidos), depois o resto espalhado por área
--     (rodízio entre cômodos/setores), com pelo menos uma de cada tipo.
--   * Cada arma no chão é um modelo de exibição ancorado (não é Tool) com luz fraca e um ProximityPrompt
--     "Pegar <nome>". A coleta segue as regras do Inventory (limite, recarga, soma de cargas).
--   * Ao ser coletada, o ponto fica livre e, depois de WEAPON_RESPAWN_TIME, uma nova arma aparece num
--     ponto livre aleatório.
-- Os modelos ficam em workspace.Map.ArmasNoChao (o cliente os anima de perto: ver Weapons/PickupFx).

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local Net = require(ReplicatedStorage.Shared.Net)
local Tags = require(ReplicatedStorage.Shared.Tags)

local CombatUtil = require(script.Parent.Parent.CombatUtil)
local GroundUtil = require(script.Parent.Parent.EventHelpers.GroundUtil)
local Definitions = require(script.Parent.Definitions)
local Inventory = require(script.Parent.Inventory)
local ToolFactory = require(script.Parent.ToolFactory)

local Spawner = {}

Spawner.FOLDER_NAME = "ArmasNoChao"

local GLOW_COLOR = Color3.fromRGB(255, 214, 140)
local START_ROOM_MARGIN = 1 -- folga da caixa da sala inicial (pontos rente às paredes)

type Entry = {
	kind: string,
	spot: any,
	model: Model,
	taken: boolean,
}

type Spot = {
	position: Vector3,
	part: BasePart?, -- nil nos pontos extras criados aqui
	area: string,
	inStartRoom: boolean,
	entry: Entry?,
}

local initialized = false
local spots: { Spot } = {}
local folder: Instance? = nil
local activeCount = 0
local targetCount = 0
local random = Random.new()
local lastPickup: { [Player]: number } = {}
local notifyRemote: RemoteEvent? = nil

-- Utilitários ---------------------------------------------------------------------------------

local function notify(player: Player, text: string, kind: string)
	if notifyRemote and player.Parent then
		notifyRemote:FireClient(player, text, kind)
	end
end

local function shuffle(list: { any })
	for index = #list, 2, -1 do
		local other = random:NextInteger(1, index)
		list[index], list[other] = list[other], list[index]
	end
end

local function isInsideBox(position: Vector3, cframe: CFrame, size: Vector3, margin: number): boolean
	local localPosition = cframe:PointToObjectSpace(position)
	return math.abs(localPosition.X) <= size.X / 2 + margin
		and math.abs(localPosition.Y) <= size.Y / 2 + margin
		and math.abs(localPosition.Z) <= size.Z / 2 + margin
end

local function spotUsable(spot: Spot): boolean
	if spot.entry then
		return false
	end
	local part = spot.part
	return part == nil or part.Parent ~= nil
end

-- "do Revólver" / "da Espingarda"
local function ofWeapon(def: Definitions.WeaponDef): string
	return (def.article == "a" and "da " or "do ") .. def.displayName
end

-- Exibição ------------------------------------------------------------------------------------

local onTriggered: (Entry, Player) -> ()

local function place(spot: Spot, kind: string): boolean
	if not spotUsable(spot) or not folder then
		return false
	end
	local def = Definitions.Get(kind)
	if not def then
		return false
	end
	local target = CFrame.new(spot.position) * CFrame.Angles(0, random:NextNumber(0, math.pi * 2), 0)
	local model, root = ToolFactory.BuildDisplay(kind, target)
	if not model or not root then
		return false
	end

	-- Brilho leve para a arma chamar a atenção (sem sombra: barato no celular).
	local light = Instance.new("PointLight")
	light.Name = "Brilho"
	light.Color = GLOW_COLOR
	light.Brightness = 0.9
	light.Range = 7
	light.Shadows = false
	light.Parent = root

	local attachment = Instance.new("Attachment")
	attachment.Name = "Coleta"
	attachment.Position = root.CFrame:PointToObjectSpace(spot.position + Vector3.new(0, 0.5, 0))
	attachment.Parent = root

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "PegarArma"
	prompt.ActionText = "Pegar " .. def.displayName
	prompt.ObjectText = def.description
	prompt.HoldDuration = Definitions.PICKUP_HOLD
	prompt.MaxActivationDistance = Definitions.PICKUP_PROMPT_DISTANCE
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt.Parent = attachment

	model:SetAttribute("WeaponKind", kind)
	model.Parent = folder

	local entry: Entry = { kind = kind, spot = spot, model = model, taken = false }
	spot.entry = entry
	activeCount += 1
	-- A conexão morre junto com o prompt quando o modelo é destruído.
	prompt.Triggered:Connect(function(player)
		onTriggered(entry, player)
	end)
	return true
end

local function respawnOne()
	if activeCount >= targetCount then
		return
	end
	local free = {}
	for _, spot in spots do
		if spotUsable(spot) then
			table.insert(free, spot)
		end
	end
	if #free > 0 then
		local spot = free[random:NextInteger(1, #free)]
		if place(spot, Definitions.RandomKind(random)) then
			return
		end
	end
	task.delay(Definitions.RESPAWN_RETRY, respawnOne)
end

local function take(entry: Entry)
	entry.taken = true
	if entry.spot.entry == entry then
		entry.spot.entry = nil
	end
	activeCount = math.max(activeCount - 1, 0)
	entry.model:Destroy()
	task.delay(GameConfig.WEAPON_RESPAWN_TIME, respawnOne)
end

-- Coleta ---------------------------------------------------------------------------------------

function onTriggered(entry: Entry, player: Player)
	if entry.taken or not entry.model.Parent then
		return
	end
	if typeof(player) ~= "Instance" or not player:IsA("Player") or not CombatUtil.IsPlayerAlive(player) then
		return
	end
	local now = os.clock()
	if now - (lastPickup[player] or 0) < Definitions.PICKUP_DEBOUNCE then
		return
	end
	lastPickup[player] = now

	-- O prompt é do cliente: a distância é conferida aqui.
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root or (root.Position - entry.spot.position).Magnitude > Definitions.PICKUP_DISTANCE then
		return
	end

	local def = Definitions.Get(entry.kind)
	if not def then
		return
	end
	local tool, result = Inventory.Give(player, entry.kind)
	if result == "created" then
		notify(player, ("Você pegou %s!"):format(Definitions.WithArticle(def)), "success")
	elseif result == "refilled" and tool then
		if def.category == "throw" then
			local charges = tonumber(tool:GetAttribute("Charges")) or 0
			notify(player, ("Mais %s! Agora você tem %d cargas."):format(def.displayName, charges), "success")
		else
			notify(player, ("Munição %s recarregada!"):format(ofWeapon(def)), "success")
		end
	elseif result == "full" then
		-- Nada mudaria: a arma continua no chão para outra pessoa.
		if def.category == "melee" then
			notify(
				player,
				("Você já tem %s %s."):format(def.article == "a" and "uma" or "um", def.displayName),
				"info"
			)
		elseif def.category == "throw" then
			notify(
				player,
				("Você já carrega o máximo %s (%d cargas)."):format(ofWeapon(def), def.maxCharges or 0),
				"info"
			)
		else
			notify(
				player,
				("%s %s já está com a munição cheia."):format(
					def.article == "a" and "Sua" or "Seu",
					def.displayName
				),
				"info"
			)
		end
		return
	elseif result == "limit" then
		notify(
			player,
			("Você já carrega %d armas, o máximo. Use a dinamite para abrir espaço."):format(
				Definitions.MAX_WEAPONS_PER_PLAYER
			),
			"warning"
		)
		return
	else
		return
	end
	take(entry)
end

-- Distribuição inicial ------------------------------------------------------------------------------

-- Escolhe `count` pontos em rodízio por área (um cômodo de cada vez), para espalhar as armas.
local function pickSpread(candidates: { Spot }, count: number): { Spot }
	local groups: { [string]: { Spot } } = {}
	local order: { string } = {}
	for _, spot in candidates do
		local group = groups[spot.area]
		if not group then
			group = {}
			groups[spot.area] = group
			table.insert(order, spot.area)
		end
		table.insert(group, spot)
	end
	for _, group in groups do
		shuffle(group)
	end
	shuffle(order)

	local picked = {}
	local round = 1
	while #picked < count do
		local added = false
		for _, area in order do
			local spot = groups[area][round]
			if spot then
				table.insert(picked, spot)
				added = true
				if #picked >= count then
					break
				end
			end
		end
		if not added then
			break
		end
		round += 1
	end
	return picked
end

-- Lista de tipos com variedade: pelo menos 1 de cada (2 de cada se couber bastante), o resto sorteado.
local function buildKinds(count: number): { string }
	local kinds = {}
	local minimum = if count >= Definitions.MAX_WEAPONS_PER_PLAYER * #Definitions.ORDER then 2 else 1
	for _ = 1, minimum do
		for _, kind in Definitions.ORDER do
			if #kinds < count then
				table.insert(kinds, kind)
			end
		end
	end
	while #kinds < count do
		table.insert(kinds, Definitions.RandomKind(random))
	end
	shuffle(kinds)
	return kinds
end

-- Mapa sem pontos na sala inicial (ex.: mapa reserva): cria dois pontos no chão da sala.
local function createStartRoomSpots(startRoom): { Spot }
	local created = {}
	local cframe, size = startRoom.cframe, startRoom.size
	for _, offset in { Vector2.new(-0.3, 0.3), Vector2.new(0.3, -0.3) } do
		local probe = cframe * Vector3.new(size.X * offset.X, 0, size.Z * offset.Y)
		local ground = GroundUtil.FindGround(probe, size.Y + 6, 0)
		local floorY = if ground then ground.Y else probe.Y - size.Y / 2
		local spot: Spot = {
			position = Vector3.new(probe.X, floorY + 1.5, probe.Z),
			part = nil,
			area = "SalaInicial",
			inStartRoom = true,
			entry = nil,
		}
		table.insert(created, spot)
	end
	return created
end

local function collectSpots(mapInfo)
	local seen: { [BasePart]: boolean } = {}
	local function add(part: any)
		if typeof(part) ~= "Instance" or not part:IsA("BasePart") or seen[part] then
			return
		end
		seen[part] = true
		local area = part:GetAttribute("Area")
		table.insert(spots, {
			position = part.Position,
			part = part,
			area = if type(area) == "string" and area ~= "" then area else "?",
			inStartRoom = false,
			entry = nil,
		})
	end
	if type(mapInfo.weaponSpawns) == "table" then
		for _, part in mapInfo.weaponSpawns do
			add(part)
		end
	end
	if #spots == 0 then
		for _, part in CollectionService:GetTagged(Tags.WeaponSpawn) do
			add(part)
		end
	end

	local startRoom = mapInfo.startRoom
	local hasRoom = type(startRoom) == "table"
		and typeof(startRoom.cframe) == "CFrame"
		and typeof(startRoom.size) == "Vector3"
	local startCount = 0
	if hasRoom then
		for _, spot in spots do
			if isInsideBox(spot.position, startRoom.cframe, startRoom.size, START_ROOM_MARGIN) then
				spot.inStartRoom = true
				startCount += 1
			end
		end
		if startCount == 0 then
			for _, spot in createStartRoomSpots(startRoom) do
				table.insert(spots, spot)
			end
		end
	end
end

local function distribute()
	local startSpots, otherSpots = {}, {}
	for _, spot in spots do
		table.insert(if spot.inStartRoom then startSpots else otherSpots, spot)
	end

	-- 1. Sala inicial: garantida (mesmo que passe do total), Facão e Revólver alternados.
	local startKinds = Definitions.START_ROOM_KINDS
	for index, spot in startSpots do
		place(spot, startKinds[(index - 1) % #startKinds + 1])
	end

	-- 2. Resto do mapa.
	local remaining = math.max(targetCount - activeCount, 0)
	local picked = pickSpread(otherSpots, remaining)
	local kinds = buildKinds(#picked)
	for index, spot in picked do
		place(spot, kinds[index])
	end
	targetCount = math.max(targetCount, activeCount)
end

-- API ----------------------------------------------------------------------------------------------

function Spawner.Init(mapInfo)
	if initialized then
		return
	end
	initialized = true
	notifyRemote = Net.event(Net.Names.Notify)

	local parent = (typeof(mapInfo.mapFolder) == "Instance" and mapInfo.mapFolder)
		or workspace:FindFirstChild("Map")
		or workspace
	local existing = parent:FindFirstChild(Spawner.FOLDER_NAME)
	if existing then
		existing:Destroy()
	end
	local created = Instance.new("Folder")
	created.Name = Spawner.FOLDER_NAME
	created.Parent = parent
	folder = created

	collectSpots(mapInfo)
	targetCount = math.min(GameConfig.WEAPON_SPAWN_COUNT, #spots)
	distribute()
	if #spots == 0 then
		warn("[Weapons] Nenhum ponto de arma no mapa: nenhuma arma foi espalhada.")
	end
end

function Spawner.ForgetPlayer(player: Player)
	lastPickup[player] = nil
end

-- Quantas armas estão no chão agora (para depuração).
function Spawner.CountActive(): number
	return activeCount
end

return Spawner
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="82">
          <Properties>
            <string name="Name">ToolFactory</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Monta as armas por código (não há assets):
--   * CreateTool: a Tool que vai para a Backpack (Handle + partes soldadas com Weld, Tool.Grip ajustado).
--   * BuildDisplay: o modelo ancorado que fica flutuando nos pontos de arma (não é Tool).
-- Também guarda o registro das Tools criadas pelo servidor, com o estado de cadência e recarga de cada uma.
--
-- Espaço da arma: a origem é o centro do Handle, que fica na mão. Com Tool.Grip sem rotação, -Z aponta
-- para a frente do personagem (cano), +Y para cima e +X para a direita. Por isso todo Handle é um bloco
-- sem rotação e as outras partes são descritas nesse espaço.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Tags = require(ReplicatedStorage.Shared.Tags)

local Definitions = require(script.Parent.Definitions)

local ToolFactory = {}

export type ToolState = {
	kind: string,
	ownerUserId: number,
	lastUse: number,
	reloading: boolean,
	reloadToken: number,
	connections: { RBXScriptConnection },
}

type PartSpec = {
	name: string,
	size: Vector3,
	cframe: CFrame, -- no espaço da arma (relativo ao Handle)
	color: Color3,
	material: Enum.Material,
	shape: Enum.PartType?,
	wedge: boolean?,
}

type Blueprint = {
	handle: PartSpec,
	parts: { PartSpec },
	attachments: { [string]: CFrame },
	gripTilt: number, -- graus; positivo inclina o topo/cano para a frente e para baixo
	displayCenter: Vector3, -- centro aproximado do modelo (para centralizar no ponto de arma)
	displayTilt: CFrame, -- como a arma "deita" na exibição
}

-- Cores e eixos -----------------------------------------------------------------------------

local WOOD_DARK = Color3.fromRGB(74, 46, 28)
local WOOD = Color3.fromRGB(116, 74, 40)
local METAL_DARK = Color3.fromRGB(52, 54, 60)
local METAL = Color3.fromRGB(104, 108, 116)
local STEEL = Color3.fromRGB(196, 200, 206)
local STEEL_EDGE = Color3.fromRGB(234, 236, 240)
local BRASS = Color3.fromRGB(186, 146, 66)
local DYNAMITE_RED = Color3.fromRGB(176, 38, 30)
local TAPE = Color3.fromRGB(70, 56, 40)
local FUSE = Color3.fromRGB(226, 214, 180)

local M = Enum.Material
local CYLINDER = Enum.PartType.Cylinder
local ALONG_Y = CFrame.Angles(0, 0, math.rad(90)) -- cilindro (eixo X) deitado no eixo Y
local ALONG_Z = CFrame.Angles(0, math.rad(90), 0) -- cilindro (eixo X) deitado no eixo Z
local ON_SIDE = CFrame.Angles(0, 0, math.rad(90))

local function spec(
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material,
	shape: Enum.PartType?,
	wedge: boolean?
): PartSpec
	return {
		name = name,
		size = size,
		cframe = cframe,
		color = color,
		material = material,
		shape = shape,
		wedge = wedge,
	}
end

local BLUEPRINTS: { [string]: Blueprint } = {
	-- Facão: cabo na mão, lâmina para cima (levemente inclinada para a frente), fio virado para a frente.
	Machete = {
		handle = spec("Handle", Vector3.new(0.24, 0.95, 0.32), CFrame.new(), WOOD_DARK, M.Wood),
		parts = {
			spec("Pomo", Vector3.new(0.3, 0.14, 0.38), CFrame.new(0, -0.54, 0), METAL_DARK, M.Metal),
			spec("Guarda", Vector3.new(0.3, 0.12, 0.52), CFrame.new(0, 0.535, 0), METAL_DARK, M.Metal),
			spec("Lamina", Vector3.new(0.06, 2.3, 0.42), CFrame.new(0, 1.74, -0.02), STEEL, M.Metal),
			spec("Fio", Vector3.new(0.07, 2.3, 0.07), CFrame.new(0, 1.74, -0.245), STEEL_EDGE, M.Metal),
			spec("Ponta", Vector3.new(0.06, 0.55, 0.49), CFrame.new(0, 3.165, -0.055), STEEL, M.Metal, nil, true),
		},
		attachments = {
			Tip = CFrame.new(0, 3.4, -0.05),
		},
		gripTilt = 20,
		displayCenter = Vector3.new(0, 1.35, -0.03),
		displayTilt = ON_SIDE,
	},

	-- Revólver: coronha na mão, tambor e cano acima dela apontando para a frente.
	Revolver = {
		handle = spec("Handle", Vector3.new(0.3, 0.85, 0.42), CFrame.new(), WOOD, M.Wood),
		parts = {
			spec("Corpo", Vector3.new(0.32, 0.4, 0.8), CFrame.new(0, 0.6, -0.2), METAL_DARK, M.Metal),
			spec("Tambor", Vector3.new(0.5, 0.48, 0.48), CFrame.new(0, 0.6, -0.32) * ALONG_Z, METAL, M.Metal, CYLINDER),
			spec(
				"Cano",
				Vector3.new(1.15, 0.2, 0.2),
				CFrame.new(0, 0.7, -1.15) * ALONG_Z,
				METAL_DARK,
				M.Metal,
				CYLINDER
			),
			spec("MiraFrontal", Vector3.new(0.05, 0.1, 0.08), CFrame.new(0, 0.84, -1.66), METAL, M.Metal),
			spec("Cao", Vector3.new(0.08, 0.2, 0.14), CFrame.new(0, 0.86, 0.2), METAL, M.Metal),
			spec("Guarda", Vector3.new(0.06, 0.06, 0.34), CFrame.new(0, 0.24, -0.2), BRASS, M.Metal),
			spec("Gatilho", Vector3.new(0.05, 0.18, 0.05), CFrame.new(0, 0.32, -0.12), METAL_DARK, M.Metal),
		},
		attachments = {
			Muzzle = CFrame.new(0, 0.7, -1.78),
		},
		gripTilt = 0,
		displayCenter = Vector3.new(0, 0.45, -0.6),
		displayTilt = ON_SIDE,
	},

	-- Espingarda de dois canos (dois cartuchos), segurada com uma mão.
	Shotgun = {
		handle = spec("Handle", Vector3.new(0.28, 0.6, 0.46), CFrame.new(), WOOD, M.Wood),
		parts = {
			spec(
				"Coronha",
				Vector3.new(0.3, 0.46, 0.85),
				CFrame.new(0, 0.5, 0.55) * CFrame.Angles(math.rad(-8), 0, 0),
				WOOD,
				M.Wood
			),
			spec("Receptor", Vector3.new(0.34, 0.42, 0.85), CFrame.new(0, 0.52, -0.45), METAL_DARK, M.Metal),
			spec(
				"CanoEsquerdo",
				Vector3.new(2.6, 0.2, 0.2),
				CFrame.new(-0.1, 0.6, -2.15) * ALONG_Z,
				METAL,
				M.Metal,
				CYLINDER
			),
			spec(
				"CanoDireito",
				Vector3.new(2.6, 0.2, 0.2),
				CFrame.new(0.1, 0.6, -2.15) * ALONG_Z,
				METAL,
				M.Metal,
				CYLINDER
			),
			spec("Telha", Vector3.new(0.32, 0.22, 1.1), CFrame.new(0, 0.4, -1.4), WOOD, M.Wood),
			spec("Guarda", Vector3.new(0.06, 0.06, 0.36), CFrame.new(0, 0.22, -0.25), METAL_DARK, M.Metal),
			spec("Cao", Vector3.new(0.08, 0.16, 0.12), CFrame.new(0, 0.78, -0.05), METAL, M.Metal),
		},
		attachments = {
			Muzzle = CFrame.new(0, 0.6, -3.5),
		},
		gripTilt = 0,
		displayCenter = Vector3.new(0, 0.45, -1.3),
		displayTilt = ON_SIDE,
	},

	-- Dinamite: três bananas presas por fita (a fita do meio é o Handle) e o pavio em cima.
	Dynamite = {
		handle = spec("Handle", Vector3.new(0.7, 0.16, 0.64), CFrame.new(), TAPE, M.Fabric),
		parts = {
			spec(
				"Banana1",
				Vector3.new(1.15, 0.3, 0.3),
				CFrame.new(-0.17, 0, 0.14) * ALONG_Y,
				DYNAMITE_RED,
				M.SmoothPlastic,
				CYLINDER
			),
			spec(
				"Banana2",
				Vector3.new(1.15, 0.3, 0.3),
				CFrame.new(0.17, 0, 0.14) * ALONG_Y,
				DYNAMITE_RED,
				M.SmoothPlastic,
				CYLINDER
			),
			spec(
				"Banana3",
				Vector3.new(1.15, 0.3, 0.3),
				CFrame.new(0, 0, -0.14) * ALONG_Y,
				DYNAMITE_RED,
				M.SmoothPlastic,
				CYLINDER
			),
			spec("FitaDeCima", Vector3.new(0.7, 0.12, 0.64), CFrame.new(0, 0.38, 0), TAPE, M.Fabric),
			spec("Pavio", Vector3.new(0.06, 0.42, 0.06), CFrame.new(0, 0.78, -0.14), FUSE, M.Fabric),
		},
		attachments = {
			Fuse = CFrame.new(0, 0.99, -0.14),
		},
		gripTilt = 0,
		displayCenter = Vector3.new(0, 0.2, 0),
		displayTilt = CFrame.Angles(math.rad(90), 0, 0),
	},
}

-- Registro --------------------------------------------------------------------------------

-- Chaves fracas: mesmo que algum Destroying se perca, uma Tool coletada não fica presa aqui.
local registry: { [Tool]: ToolState } = setmetatable({}, { __mode = "k" }) :: any

function ToolFactory.GetState(tool: any): ToolState?
	if typeof(tool) ~= "Instance" or not tool:IsA("Tool") then
		return nil
	end
	return registry[tool]
end

local function unregister(tool: Tool)
	local state = registry[tool]
	if not state then
		return
	end
	registry[tool] = nil
	state.reloadToken += 1
	for _, connection in state.connections do
		connection:Disconnect()
	end
	table.clear(state.connections)
end

-- Construção ------------------------------------------------------------------------------

local function makePart(partSpec: PartSpec, anchored: boolean): BasePart
	local part: BasePart
	if partSpec.wedge then
		part = Instance.new("WedgePart")
	else
		local block = Instance.new("Part")
		if partSpec.shape then
			block.Shape = partSpec.shape
		end
		part = block
	end
	part.Name = partSpec.name
	part.Size = partSpec.size
	part.Color = partSpec.color
	part.Material = partSpec.material
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Anchored = anchored
	-- A ordem importa: CanQuery só pode ficar falso com CanCollide falso.
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.CastShadow = not anchored
	return part
end

-- Cria a Tool de um tipo (sem pai). O chamador a coloca na Backpack.
function ToolFactory.CreateTool(kind: string, owner: Player): Tool?
	local def = Definitions.Get(kind)
	local blueprint = BLUEPRINTS[kind]
	if not def or not blueprint then
		return nil
	end

	local tool = Instance.new("Tool")
	tool.Name = def.displayName
	tool.ToolTip = def.tooltip
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool.ManualActivationOnly = false
	tool.Grip = CFrame.Angles(math.rad(blueprint.gripTilt), 0, 0)

	local handle = makePart(blueprint.handle, false)
	handle.Name = "Handle"
	handle.CFrame = CFrame.new()
	for name, offset in blueprint.attachments do
		local attachment = Instance.new("Attachment")
		attachment.Name = name
		attachment.CFrame = offset
		attachment.Parent = handle
	end
	handle.Parent = tool

	-- Weld clássico (C0 explícito): a posição relativa não depende de onde as partes estão agora.
	for _, partSpec in blueprint.parts do
		local part = makePart(partSpec, false)
		part.CFrame = partSpec.cframe
		local weld = Instance.new("Weld")
		weld.Name = "Solda"
		weld.Part0 = handle
		weld.Part1 = part
		weld.C0 = partSpec.cframe
		weld.C1 = CFrame.new()
		weld.Parent = part
		part.Parent = tool
	end

	-- Atributos lidos pelo cliente (UI, cadência, alcance da mira e efeitos). Só o servidor os altera.
	-- Os contadores *Seq sobem a cada uso aceito: os outros clientes reagem a eles (som, clarão, golpe).
	tool:SetAttribute("WeaponKind", kind)
	tool:SetAttribute("DisplayName", def.displayName)
	tool:SetAttribute("Category", def.category)
	tool:SetAttribute("Cooldown", def.cooldown)
	tool:SetAttribute("Range", def.range)
	if def.useSound then
		tool:SetAttribute("UseSound", def.useSound)
	end
	if def.category == "gun" then
		tool:SetAttribute("Ammo", def.maxAmmo)
		tool:SetAttribute("MaxAmmo", def.maxAmmo)
		tool:SetAttribute("ReloadTime", def.reloadTime)
		tool:SetAttribute("Pellets", def.pellets or 1)
		tool:SetAttribute("Spread", def.spread or 0)
		tool:SetAttribute("Recoil", def.recoil or 10)
		tool:SetAttribute("TracerColor", def.tracerColor or Color3.fromRGB(255, 226, 140))
		tool:SetAttribute("TracerWidth", def.tracerWidth or 0.1)
		tool:SetAttribute("Reloading", false)
		tool:SetAttribute("FireSeq", 0)
	elseif def.category == "throw" then
		tool:SetAttribute("Charges", def.charges)
		tool:SetAttribute("MaxCharges", def.maxCharges)
		tool:SetAttribute("FuseTime", def.fuseTime)
		tool:SetAttribute("BlastRadius", def.blastRadius)
		tool:SetAttribute("ThrowSeq", 0)
	else
		tool:SetAttribute("SwingSeq", 0)
	end
	CollectionService:AddTag(tool, Tags.Weapon)

	local state: ToolState = {
		kind = kind,
		ownerUserId = owner.UserId,
		lastUse = 0,
		reloading = false,
		reloadToken = 0,
		connections = {},
	}
	registry[tool] = state
	table.insert(
		state.connections,
		tool.Destroying:Connect(function()
			unregister(tool)
		end)
	)
	return tool
end

-- Cria o modelo de exibição (ancorado, sem colisão e invisível para raycasts), centralizado em `target`.
-- Devolve o Model e a part principal (onde ficam a luz e o prompt).
function ToolFactory.BuildDisplay(kind: string, target: CFrame): (Model?, BasePart?)
	local blueprint = BLUEPRINTS[kind]
	if not blueprint or not Definitions.Get(kind) then
		return nil, nil
	end
	local model = Instance.new("Model")
	model.Name = "Arma_" .. kind
	local root = makePart(blueprint.handle, true)
	root.Name = "Empunhadura"
	root.CFrame = CFrame.new()
	root.Parent = model
	for _, partSpec in blueprint.parts do
		local part = makePart(partSpec, true)
		part.CFrame = partSpec.cframe
		part.Parent = model
	end
	-- Com PrimaryPart, o pivô fica guardado como PivotOffset da raiz (replica junto com a part).
	model.PrimaryPart = root
	root.PivotOffset = CFrame.new(blueprint.displayCenter)
	model:PivotTo(target * blueprint.displayTilt)
	return model, root
end

return ToolFactory
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="83">
          <Properties>
            <string name="Name">WeaponService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Serviço das armas (servidor do jogo).
--   WeaponService.Init(mapInfo)        cria os remotes Weapon_*, liga os handlers e espalha as armas
--   WeaponService.GiveWeapon(player, kind): Tool?
--
-- O cliente só PEDE (Weapon_Fire / Weapon_Melee / Weapon_Throw / Weapon_Reload). Aqui tudo é validado:
-- tipo de cada argumento, Tool marcada com a tag Weapon e criada por este servidor para ESTE jogador,
-- arma na mão (tool.Parent == player.Character), jogador vivo, cadência, munição/cargas, recarga em
-- andamento, origem do tiro perto da cabeça, direção finita e unitária, alvo do arremesso dentro do
-- alcance e um limite de pedidos por segundo. Jogador eliminado perde as armas.
--
-- Submódulos: Definitions (números), ToolFactory (modelos), Inventory (posse e coleta), Combat (ações),
-- Spawner (armas no chão).

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local Tags = require(ReplicatedStorage.Shared.Tags)

local CombatUtil = require(script.Parent.Parent.CombatUtil)
local Combat = require(script.Parent.Combat)
local Definitions = require(script.Parent.Definitions)
local Inventory = require(script.Parent.Inventory)
local Spawner = require(script.Parent.Spawner)
local ToolFactory = require(script.Parent.ToolFactory)

local WeaponService = {}

local MAX_COORDINATE = 1e6
local ERROR_LOG_INTERVAL = 5 -- no máximo um aviso de erro por jogador a cada 5 s

local initialized = false
local buckets: { [Player]: { tokens: number, last: number } } = {}
local lastErrorLog: { [Player]: number } = {}
local playerConnections: { [Player]: { RBXScriptConnection } } = {}

-- Carrega um módulo irmão de outro dono sem derrubar as armas se ele falhar.
local function safeRequire(parent: Instance, name: string): any
	local module = parent:FindFirstChild(name)
	if not module or not module:IsA("ModuleScript") then
		warn(("[WeaponService] Módulo '%s' não encontrado: armas sem esse recurso."):format(name))
		return nil
	end
	local ok, result = pcall(require, module)
	if not ok then
		warn(("[WeaponService] Erro ao carregar '%s': %s"):format(name, tostring(result)))
		return nil
	end
	return result
end

-- Validação -----------------------------------------------------------------------------------

local function isFiniteVector(value: any): boolean
	if typeof(value) ~= "Vector3" then
		return false
	end
	local x, y, z = value.X, value.Y, value.Z
	-- x == x é falso para NaN; o limite também barra ±inf.
	return x == x
		and y == y
		and z == z
		and math.abs(x) < MAX_COORDINATE
		and math.abs(y) < MAX_COORDINATE
		and math.abs(z) < MAX_COORDINATE
end

-- Balde de fichas: cada pedido gasta uma; elas voltam com o tempo.
local function takeToken(player: Player): boolean
	local now = os.clock()
	local bucket = buckets[player]
	if not bucket then
		bucket = { tokens = Definitions.REQUEST_BUDGET, last = now }
		buckets[player] = bucket
	end
	bucket.tokens =
		math.min(Definitions.REQUEST_BUDGET, bucket.tokens + (now - bucket.last) * Definitions.REQUEST_REFILL)
	bucket.last = now
	if bucket.tokens < 1 then
		return false
	end
	bucket.tokens -= 1
	return true
end

-- Confere a arma de um pedido. Retorna (estado, definição, personagem) ou nil se algo não bater.
local function resolveTool(player: Player, tool: any, category: string): (any, Definitions.WeaponDef?, Model?)
	if not takeToken(player) then
		return nil, nil, nil
	end
	if typeof(tool) ~= "Instance" or not tool:IsA("Tool") or not CollectionService:HasTag(tool, Tags.Weapon) then
		return nil, nil, nil
	end
	local state = ToolFactory.GetState(tool)
	if not state or state.ownerUserId ~= player.UserId then
		return nil, nil, nil
	end
	local character = player.Character
	if not character or tool.Parent ~= character or not CombatUtil.IsPlayerAlive(player) then
		return nil, nil, nil
	end
	local def = Definitions.Get(state.kind)
	if not def or def.category ~= category then
		return nil, nil, nil
	end
	return state, def, character
end

local function cooldownReady(state: any, def: Definitions.WeaponDef): boolean
	return os.clock() - state.lastUse >= def.cooldown * Definitions.COOLDOWN_TOLERANCE
end

-- Handlers ---------------------------------------------------------------------------------------

local function onFire(player: Player, tool: any, origin: any, direction: any)
	local state, def, character = resolveTool(player, tool, "gun")
	if not state or not def or not character then
		return
	end
	if not isFiniteVector(origin) or not isFiniteVector(direction) then
		return
	end
	local magnitude = direction.Magnitude
	if magnitude < 1e-3 then
		return
	end
	local unit = direction / magnitude
	if state.reloading or not cooldownReady(state, def) then
		return
	end
	local head = Combat.GetHeadPosition(character)
	if not head or (origin - head).Magnitude > Definitions.ORIGIN_MAX_DISTANCE then
		return
	end
	if (tonumber(tool:GetAttribute("Ammo")) or 0) <= 0 then
		-- O cliente achou que tinha bala (dessincronizado): recarrega em vez de atirar.
		Combat.StartReload(player, tool, state, def)
		return
	end
	Combat.Fire(player, tool, state, def, origin, unit)
end

local function onMelee(player: Player, tool: any)
	local state, def = resolveTool(player, tool, "melee")
	if not state or not def or not cooldownReady(state, def) then
		return
	end
	Combat.Melee(player, tool, state, def)
end

local function onThrow(player: Player, tool: any, target: any)
	local state, def, character = resolveTool(player, tool, "throw")
	if not state or not def or not character or not isFiniteVector(target) then
		return
	end
	if not cooldownReady(state, def) or (tonumber(tool:GetAttribute("Charges")) or 0) <= 0 then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return
	end
	if (target - root.Position).Magnitude > def.range + Definitions.THROW_RANGE_TOLERANCE then
		return
	end
	Combat.Throw(player, tool, state, def, target)
end

local function onReload(player: Player, tool: any)
	local state, def = resolveTool(player, tool, "gun")
	if not state or not def then
		return
	end
	Combat.StartReload(player, tool, state, def)
end

-- Erros de um handler (argumentos estranhos) não podem derrubar a conexão nem lotar o Output.
local function guard(label: string, handler: (Player, ...any) -> ())
	return function(player: Player, ...)
		if typeof(player) ~= "Instance" or not player:IsA("Player") then
			return
		end
		local ok, err = pcall(handler, player, ...)
		if not ok then
			local now = os.clock()
			if now - (lastErrorLog[player] or -math.huge) >= ERROR_LOG_INTERVAL then
				lastErrorLog[player] = now
				warn(("[WeaponService] Erro em %s (%s): %s"):format(label, player.Name, tostring(err)))
			end
		end
	end
end

-- Jogadores -------------------------------------------------------------------------------------

local function onPlayerAdded(player: Player)
	if playerConnections[player] then
		return
	end
	local connections = {}
	table.insert(
		connections,
		player:GetAttributeChangedSignal("Eliminated"):Connect(function()
			if player:GetAttribute("Eliminated") then
				Inventory.RemoveAll(player)
			end
		end)
	)
	playerConnections[player] = connections
	if player:GetAttribute("Eliminated") then
		Inventory.RemoveAll(player)
	end
end

local function onPlayerRemoving(player: Player)
	buckets[player] = nil
	lastErrorLog[player] = nil
	Spawner.ForgetPlayer(player)
	local connections = playerConnections[player]
	playerConnections[player] = nil
	if connections then
		for _, connection in connections do
			connection:Disconnect()
		end
	end
end

-- API ----------------------------------------------------------------------------------------------

function WeaponService.Init(mapInfo)
	if initialized then
		return
	end
	initialized = true

	Combat.Init(safeRequire(script.Parent.Parent, "DestructionService"))

	-- Remotes usados pelas armas (existem antes de qualquer cliente pedir).
	Net.event(Net.Names.Fx_Play)
	Net.event(Net.Names.Notify)
	Net.event(Net.Names.Weapon_Fire).OnServerEvent:Connect(guard("Weapon_Fire", onFire))
	Net.event(Net.Names.Weapon_Melee).OnServerEvent:Connect(guard("Weapon_Melee", onMelee))
	Net.event(Net.Names.Weapon_Throw).OnServerEvent:Connect(guard("Weapon_Throw", onThrow))
	Net.event(Net.Names.Weapon_Reload).OnServerEvent:Connect(guard("Weapon_Reload", onReload))

	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		onPlayerAdded(player)
	end

	local ok, err = pcall(Spawner.Init, type(mapInfo) == "table" and mapInfo or {})
	if not ok then
		warn("[WeaponService] Erro ao espalhar as armas: " .. tostring(err))
	end
end

-- Dá uma arma seguindo as regras de coleta (limite de armas; mesmo tipo = recarrega/soma cargas).
-- Retorna a Tool do jogador desse tipo, ou nil se não foi possível (limite, eliminado, tipo inválido).
function WeaponService.GiveWeapon(player: Player, kind: "Machete" | "Revolver" | "Shotgun" | "Dynamite"): Tool?
	if typeof(player) ~= "Instance" or not player:IsA("Player") or not player.Parent then
		return nil
	end
	if player:GetAttribute("Eliminated") then
		return nil
	end
	local tool, result = Inventory.Give(player, kind)
	if result == "created" or result == "refilled" or result == "full" then
		return tool
	end
	return nil
end

-- Remove todas as armas de um jogador (extra; o serviço já faz isso quando ele é eliminado).
function WeaponService.RemoveWeapons(player: Player)
	if typeof(player) == "Instance" and player:IsA("Player") then
		Inventory.RemoveAll(player)
	end
end

return WeaponService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
    <Item class="Folder" referent="84">
      <Properties>
        <string name="Name">ServerShared</string>
      </Properties>
      <Item class="ModuleScript" referent="85">
        <Properties>
          <string name="Name">SettingsStore</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Configurações dos jogadores no servidor (usado pelo lobby e pela partida).
--   SettingsStore.Init()        cria Settings_Get / Settings_Save e começa a carregar/gravar
--   SettingsStore.Get(player)   configurações do jogador (carrega se preciso; pode ceder)
--
-- DataStore "PlayerSettings_v1", chave "u_<userId>", até 3 tentativas por operação.
-- Gravação: no máximo 1 a cada 6 s por jogador; mudanças que chegam antes disso ficam agendadas e a
-- gravação adiada usa sempre o valor mais recente. Ao sair (PlayerRemoving) e ao fechar o servidor
-- (BindToClose, com limite de tempo) grava o que estiver pendente.
-- Sem acesso ao DataStore (Studio sem "Enable Studio Access to API Services" ou place não publicado):
-- usa o padrão, guarda só durante a sessão e avisa uma vez no Output.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local SettingsSchema = require(ReplicatedStorage.Shared.Settings.SettingsSchema)

local SettingsStore = {}

local STORE_NAME = "PlayerSettings_v1"
local KEY_PREFIX = "u_"
local MAX_ATTEMPTS = 3
local SAVE_INTERVAL = 6 -- s entre gravações do mesmo jogador
local MAX_WRITE_FAILURES = 3 -- falhas seguidas antes de desistir até a próxima mudança
local BUDGET_WAIT = 5 -- s esperando orçamento de requisições do DataStore
local CLOSE_TIMEOUT = 25 -- s (o Roblox dá no máximo 30 s ao BindToClose)
local RATE_WINDOW = 1 -- s
local RATE_MAX = 8 -- mensagens Settings_Save por janela; o excesso é ignorado

type Entry = {
	player: Player,
	userId: number,
	settings: any,
	state: string, -- "loading" | "ready"
	waiters: { thread },
	changedByPlayer: boolean,
	dirty: boolean,
	writing: boolean,
	writeScheduled: boolean,
	lastWrite: number,
	failures: number,
	removed: boolean,
	finalizing: boolean,
	rateStart: number,
	rateCount: number,
}

local entries: { [Player]: Entry } = {}
local pendingFinal: { [number]: Entry } = {} -- userId → entrada de quem saiu e ainda está gravando
local store: DataStore? = nil
local storeAvailable = true
local warnedUnavailable = false
local initialized = false
local closing = false
local activeWrites = 0
local activeFinals = 0

-- DataStore ------------------------------------------------------------------------------------

local function markUnavailable(reason: string)
	storeAvailable = false
	if warnedUnavailable then
		return
	end
	warnedUnavailable = true
	warn(
		("[SettingsStore] DataStore indisponível (%s). As configurações valem só nesta sessão e começam no padrão. "):format(
			reason
		)
			.. "No Studio: publique o place e ative Game Settings › Security › Enable Studio Access to API Services."
	)
end

-- Erros que não adianta repetir (sem permissão / Studio sem API / place não publicado).
local function isAccessError(message: string): boolean
	local lower = string.lower(message)
	for _, pattern in { "studio", "publish", "403", "not allowed", "forbidden", "api access" } do
		if string.find(lower, pattern, 1, true) then
			return true
		end
	end
	return false
end

local function getStore(): DataStore?
	if not storeAvailable then
		return nil
	end
	if store then
		return store
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok and result then
		store = result
		return store
	end
	markUnavailable(tostring(result))
	return nil
end

-- Executa `callback` com até MAX_ATTEMPTS tentativas (espera 1 s, depois 2 s).
local function withRetries(label: string, callback: () -> any): (boolean, any)
	local lastError = "?"
	for attempt = 1, MAX_ATTEMPTS do
		local ok, result = pcall(callback)
		if ok then
			return true, result
		end
		lastError = tostring(result)
		if isAccessError(lastError) then
			markUnavailable(lastError)
			return false, lastError
		end
		if attempt < MAX_ATTEMPTS then
			task.wait(attempt)
		end
	end
	warn(("[SettingsStore] Falha ao %s depois de %d tentativas: %s"):format(label, MAX_ATTEMPTS, lastError))
	return false, lastError
end

local function waitForBudget(requestType: Enum.DataStoreRequestType)
	local started = os.clock()
	while os.clock() - started < BUDGET_WAIT do
		local ok, budget = pcall(function()
			return DataStoreService:GetRequestBudgetForRequestType(requestType)
		end)
		if not ok or budget > 0 or closing then
			return
		end
		task.wait(0.5)
	end
end

local function sameSettings(a, b): boolean
	if a.version ~= b.version then
		return false
	end
	for key, value in a.audio do
		if b.audio[key] ~= value then
			return false
		end
	end
	for key, value in a.graphics do
		if b.graphics[key] ~= value then
			return false
		end
	end
	return true
end

-- Gravação ---------------------------------------------------------------------------------------

local scheduleWrite -- declarada abaixo (recursão com writeEntry)

local function writeEntry(entry: Entry): boolean
	if entry.writing or not entry.dirty then
		return false
	end
	local dataStore = getStore()
	if not dataStore then
		-- Sem DataStore não há onde gravar: o valor fica só no cache desta sessão.
		entry.dirty = false
		return false
	end

	entry.writing = true
	entry.dirty = false
	entry.lastWrite = os.clock()
	activeWrites += 1
	local snapshot = SettingsSchema.Clone(entry.settings)
	local key = KEY_PREFIX .. tostring(entry.userId)
	local userIds = { entry.userId }

	waitForBudget(Enum.DataStoreRequestType.SetIncrementAsync)
	local ok = withRetries(("gravar as configurações de %d"):format(entry.userId), function()
		dataStore:SetAsync(key, snapshot, userIds)
	end)

	activeWrites -= 1
	entry.writing = false
	entry.lastWrite = os.clock()
	if ok then
		entry.failures = 0
	elseif storeAvailable then
		entry.failures += 1
		if entry.failures < MAX_WRITE_FAILURES then
			entry.dirty = true -- tenta de novo mais tarde
		end
	end
	return ok
end

-- Agenda uma gravação respeitando o intervalo mínimo; o valor gravado é o mais recente na hora.
scheduleWrite = function(entry: Entry)
	if entry.writeScheduled or entry.removed or closing then
		return
	end
	entry.writeScheduled = true
	local delayTime = math.max(0, entry.lastWrite + SAVE_INTERVAL - os.clock())
	task.delay(delayTime, function()
		entry.writeScheduled = false
		if entry.removed or closing or entry.writing then
			-- Saída/fechamento fazem a gravação final; uma gravação em andamento reagenda ao terminar.
			return
		end
		writeEntry(entry)
		if entry.dirty and not entry.removed and not closing then
			scheduleWrite(entry)
		end
	end)
end

-- Gravação final (jogador saiu ou servidor fechando).
local function finalSave(entry: Entry)
	while entry.writing do
		task.wait(0.2)
	end
	if not entry.dirty then
		return
	end
	-- Respeita o intervalo por chave, a não ser que o servidor esteja fechando.
	local readyAt = entry.lastWrite + SAVE_INTERVAL
	while os.clock() < readyAt and not closing do
		task.wait(0.25)
	end
	writeEntry(entry)
end

local function startFinalSave(entry: Entry)
	if entry.finalizing then
		return
	end
	entry.finalizing = true
	activeFinals += 1
	pendingFinal[entry.userId] = entry
	task.spawn(function()
		local ok, err = pcall(finalSave, entry)
		if not ok then
			warn("[SettingsStore] Erro na gravação final: " .. tostring(err))
		end
		activeFinals -= 1
		if pendingFinal[entry.userId] == entry then
			pendingFinal[entry.userId] = nil
		end
	end)
end

-- Carregamento -----------------------------------------------------------------------------------

local function wakeWaiters(entry: Entry)
	local waiters = entry.waiters
	entry.waiters = {}
	for _, thread in waiters do
		task.spawn(thread)
	end
end

local function load(entry: Entry)
	local data = nil
	local ok, err = pcall(function()
		local dataStore = getStore()
		if not dataStore then
			return
		end
		waitForBudget(Enum.DataStoreRequestType.GetAsync)
		local key = KEY_PREFIX .. tostring(entry.userId)
		local success, result = withRetries(("carregar as configurações de %d"):format(entry.userId), function()
			return dataStore:GetAsync(key)
		end)
		if success then
			data = result
		end
	end)
	if not ok then
		warn("[SettingsStore] Erro ao carregar: " .. tostring(err))
	end

	-- Se o jogador já mudou algo enquanto carregava, a escolha dele vale mais que o valor salvo.
	if not entry.changedByPlayer then
		entry.settings = SettingsSchema.Sanitize(data)
	end
	entry.state = "ready"
	wakeWaiters(entry)

	if entry.dirty then
		if entry.removed then
			startFinalSave(entry)
		else
			scheduleWrite(entry)
		end
	end
end

local function newEntry(player: Player): Entry
	return {
		player = player,
		userId = player.UserId,
		settings = SettingsSchema.Defaults(),
		state = "loading",
		waiters = {},
		changedByPlayer = false,
		dirty = false,
		writing = false,
		writeScheduled = false,
		lastWrite = 0,
		failures = 0,
		removed = false,
		finalizing = false,
		rateStart = 0,
		rateCount = 0,
	}
end

local function ensureEntry(player: Player): Entry?
	local entry = entries[player]
	if entry then
		return entry
	end
	if player.Parent ~= Players then
		return nil
	end
	entry = newEntry(player)
	entries[player] = entry

	-- Voltou antes da gravação final terminar: usa o valor que ainda está sendo gravado.
	local previous = pendingFinal[player.UserId]
	if previous then
		entry.settings = SettingsSchema.Clone(previous.settings)
		entry.state = "ready"
		entry.lastWrite = os.clock()
		return entry
	end

	task.spawn(load, entry)
	return entry
end

-- Remotes ----------------------------------------------------------------------------------------

local function onSave(player: Player, payload: any)
	local entry = entries[player]
	if not entry or entry.removed then
		return
	end

	-- Limite de frequência (o cliente já espera 1,5 s entre envios; isto só barra abuso).
	local now = os.clock()
	if now - entry.rateStart > RATE_WINDOW then
		entry.rateStart = now
		entry.rateCount = 0
	end
	entry.rateCount += 1
	if entry.rateCount > RATE_MAX then
		return
	end

	if type(payload) ~= "table" then
		return
	end
	local ok, clean = pcall(SettingsSchema.Sanitize, payload)
	if not ok then
		return
	end

	entry.changedByPlayer = true
	if sameSettings(clean, entry.settings) then
		return
	end
	entry.settings = clean
	entry.dirty = true
	entry.failures = 0
	if entry.state == "ready" then
		scheduleWrite(entry)
	end
end

local function onPlayerRemoving(player: Player)
	local entry = entries[player]
	if not entry then
		return
	end
	entries[player] = nil
	entry.removed = true
	if entry.state == "ready" and entry.dirty then
		startFinalSave(entry)
	end
	-- Ainda carregando: o load termina, acorda quem espera e faz a gravação final se precisar.
end

local function onClose()
	closing = true
	for _, entry in entries do
		if entry.state == "ready" and entry.dirty then
			startFinalSave(entry)
		end
	end
	local started = os.clock()
	while (activeFinals > 0 or activeWrites > 0) and os.clock() - started < CLOSE_TIMEOUT do
		task.wait(0.25)
	end
end

-- API pública ------------------------------------------------------------------------------------

function SettingsStore.Init()
	if initialized then
		return
	end
	initialized = true

	local getRemote = Net.func(Net.Names.Settings_Get)
	local saveRemote = Net.event(Net.Names.Settings_Save)

	getRemote.OnServerInvoke = function(player)
		return SettingsStore.Get(player)
	end
	saveRemote.OnServerEvent:Connect(onSave)

	Players.PlayerAdded:Connect(ensureEntry)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(ensureEntry, player)
	end

	game:BindToClose(onClose)
end

-- Configurações do jogador (cópia). Cede enquanto o DataStore responde.
function SettingsStore.Get(player: Player)
	if typeof(player) ~= "Instance" or not player:IsA("Player") then
		return SettingsSchema.Defaults()
	end
	local entry = ensureEntry(player)
	if not entry then
		return SettingsSchema.Defaults()
	end
	if entry.state ~= "ready" then
		table.insert(entry.waiters, coroutine.running())
		coroutine.yield()
	end
	return SettingsSchema.Clone(entry.settings)
end

return SettingsStore
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="86">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="87">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="88">
        <Properties>
          <string name="Name">Game</string>
        </Properties>
        <Item class="ModuleScript" referent="89">
          <Properties>
            <string name="Name">BoardClient</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Controles do tabuleiro para quem o carrega: T joga o dado, G solta (com botões na tela no celular).
-- As ações só existem quando fazem sentido (de acordo com o Board_Status). Perto do tabuleiro no chão,
-- quem cuida é o ProximityPrompt do servidor ("Jogar o dado", tecla T, ou toque no prompt).

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)

local BoardClient = {}

local LocalPlayer = Players.LocalPlayer

local ROLL_ACTION = "SelvaJogarDado"
local DROP_ACTION = "SelvaSoltarTabuleiro"
local SEND_DEBOUNCE = 0.5

local initialized = false
local status = nil
local bound: { [string]: boolean } = {}
local lastSend = 0
local remotes: { [string]: RemoteEvent } = {}

local function send(remote: RemoteEvent)
	local now = os.clock()
	if now - lastSend < SEND_DEBOUNCE then
		return
	end
	lastSend = now
	remote:FireServer()
end

local function onRoll(_actionName: string, inputState: Enum.UserInputState)
	if inputState == Enum.UserInputState.Begin then
		send(remotes.roll)
	end
	return Enum.ContextActionResult.Sink
end

local function onDrop(_actionName: string, inputState: Enum.UserInputState)
	if inputState == Enum.UserInputState.Begin then
		send(remotes.drop)
	end
	return Enum.ContextActionResult.Sink
end

local function setBound(
	name: string,
	shouldBind: boolean,
	handler: (string, Enum.UserInputState) -> Enum.ContextActionResult,
	title: string,
	keyboard: Enum.KeyCode,
	gamepad: Enum.KeyCode
)
	if (bound[name] == true) == shouldBind then
		return
	end
	bound[name] = shouldBind
	if shouldBind then
		ContextActionService:BindAction(name, handler, true, keyboard, gamepad)
		ContextActionService:SetTitle(name, title)
	else
		ContextActionService:UnbindAction(name)
	end
end

local function refresh()
	local eliminated = LocalPlayer:GetAttribute("Eliminated") == true
	local carrying = not eliminated and status ~= nil and status.carrierUserId == LocalPlayer.UserId
	local canRoll = carrying and status.canRoll and not status.rolling and not status.locked
	setBound(ROLL_ACTION, canRoll, onRoll, "Jogar dado", Enum.KeyCode.T, Enum.KeyCode.ButtonY)
	setBound(DROP_ACTION, carrying and not status.rolling, onDrop, "Soltar", Enum.KeyCode.G, Enum.KeyCode.ButtonB)
end

local function onStatus(payload)
	if type(payload) ~= "table" then
		return
	end
	status = {
		carrierUserId = type(payload.carrierUserId) == "number" and payload.carrierUserId or nil,
		canRoll = payload.canRoll == true,
		locked = payload.locked == true,
		rolling = payload.rolling == true,
	}
	refresh()
end

function BoardClient.Init()
	if initialized then
		return
	end
	initialized = true
	remotes.roll = Net.event(Net.Names.Board_RollRequest)
	remotes.drop = Net.event(Net.Names.Board_DropRequest)

	Net.event(Net.Names.Board_Status).OnClientEvent:Connect(onStatus)
	LocalPlayer:GetAttributeChangedSignal("Eliminated"):Connect(refresh)
	LocalPlayer.CharacterRemoving:Connect(function()
		status = nil
		refresh()
	end)
	refresh()
end

return BoardClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="90">
          <Properties>
            <string name="Name">FxClient</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Efeitos rápidos pedidos pelo servidor (Fx_Play):
--   shake     → treme a câmera (fraco longe da origem)
--   tracer    → traço de tiro local que some (o atirador ignora o próprio eco)
--   knockback → soma velocidade no HumanoidRootPart do jogador local
--   flash     → a tela pisca numa cor
-- Tudo é local e leve: limites de quantidade e nada de loops quando não há efeito ativo.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Net = require(ReplicatedStorage.Shared.Net)
local UIKit = require(ReplicatedStorage.Shared.UI.UIKit)

local FxClient = {}

local LocalPlayer = Players.LocalPlayer

local MAX_SHAKES = 8
local MAX_TRACERS = 40
local MAX_KNOCKBACK = 300
local TRACER_LIFETIME = 0.15
local DEFAULT_SHAKE_RADIUS = 150

local initialized = false
local shakes = {}
local appliedOffset: CFrame? = nil
local appliedResult: CFrame? = nil
local tracers: { BasePart } = {}
local fxFolder: Folder? = nil
local flashFrame: Frame? = nil
local flashToken = 0

local function clampNumber(value: any, min: number, max: number, default: number): number
	if type(value) ~= "number" or value ~= value then
		return default
	end
	return math.clamp(value, min, max)
end

local function getFocusPosition(): Vector3
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root.Position
	end
	local camera = workspace.CurrentCamera
	return camera and camera.Focus.Position or Vector3.zero
end

-- Tremor -----------------------------------------------------------------------------------

local function addShake(params)
	if #shakes >= MAX_SHAKES then
		table.remove(shakes, 1)
	end
	table.insert(shakes, {
		intensity = clampNumber(params.intensity, 0.2, 2, 0.6),
		duration = clampNumber(params.duration, 0.05, 10, 0.5),
		origin = typeof(params.origin) == "Vector3" and params.origin or nil,
		radius = clampNumber(params.radius, 1, 5000, DEFAULT_SHAKE_RADIUS),
		started = os.clock(),
	})
end

-- Antes da câmera atualizar: desfaz o tremor do frame anterior (evita "deriva" da câmera).
local function undoShake()
	if not appliedOffset then
		return
	end
	local camera = workspace.CurrentCamera
	if camera and appliedResult and camera.CFrame:FuzzyEq(appliedResult, 1e-4) then
		camera.CFrame = camera.CFrame * appliedOffset:Inverse()
	end
	appliedOffset, appliedResult = nil, nil
end

-- Depois da câmera atualizar: aplica o tremor deste frame.
local function applyShake()
	if #shakes == 0 then
		return
	end
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local now = os.clock()
	local focus = getFocusPosition()
	local strength = 0
	for index = #shakes, 1, -1 do
		local shake = shakes[index]
		local elapsed = now - shake.started
		if elapsed >= shake.duration then
			table.remove(shakes, index)
		else
			local fade = 1 - elapsed / shake.duration
			local factor = 1
			if shake.origin then
				factor = math.clamp(1 - (focus - shake.origin).Magnitude / shake.radius, 0, 1)
			end
			strength += shake.intensity * fade * factor
		end
	end
	if strength <= 0.001 then
		return
	end
	strength = math.min(strength, 2.5)
	local t = now * 22
	local offset = CFrame.new(math.noise(t, 1.3) * 0.5 * strength, math.noise(t, 7.1) * 0.5 * strength, 0)
		* CFrame.Angles(
			math.rad(math.noise(t, 3.7) * 1.6 * strength),
			math.rad(math.noise(t, 5.9) * 1.6 * strength),
			math.rad(math.noise(t, 9.4) * 1.0 * strength)
		)
	local result = camera.CFrame * offset
	camera.CFrame = result
	appliedOffset, appliedResult = offset, result
end

-- Traço de tiro -------------------------------------------------------------------------------

local function addTracer(params)
	if params.shooterUserId == LocalPlayer.UserId then
		return -- o atirador já desenhou o próprio traço
	end
	local from, to = params.from, params.to
	if typeof(from) ~= "Vector3" or typeof(to) ~= "Vector3" then
		return
	end
	local delta = to - from
	local length = delta.Magnitude
	if length < 0.1 or length > 2000 then
		return
	end
	local width = clampNumber(params.width, 0.03, 1, 0.12)
	local color = typeof(params.color) == "Color3" and params.color or Color3.fromRGB(255, 226, 140)

	if not fxFolder or not fxFolder.Parent then
		local folder = Instance.new("Folder")
		folder.Name = "EfeitosLocais"
		folder.Parent = workspace
		fxFolder = folder
	end
	if #tracers >= MAX_TRACERS then
		local oldest = table.remove(tracers, 1)
		if oldest then
			oldest:Destroy()
		end
	end

	local part = Instance.new("Part")
	part.Name = "Tracer"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	part.Color = color
	part.Transparency = 0.15
	part.Size = Vector3.new(width, width, length)
	part.CFrame = CFrame.lookAt(from + delta / 2, to)
	part.Parent = fxFolder :: Folder
	table.insert(tracers, part)

	local tween = TweenService:Create(part, TweenInfo.new(TRACER_LIFETIME), { Transparency = 1 })
	tween.Completed:Once(function()
		local index = table.find(tracers, part)
		if index then
			table.remove(tracers, index)
		end
		part:Destroy()
	end)
	tween:Play()
end

-- Empurrão --------------------------------------------------------------------------------------

local function applyKnockback(params)
	local velocity = params.velocity
	if typeof(velocity) ~= "Vector3" or velocity.Magnitude ~= velocity.Magnitude then
		return
	end
	if velocity.Magnitude > MAX_KNOCKBACK then
		velocity = velocity.Unit * MAX_KNOCKBACK
	end
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then
		return
	end
	if velocity.Y > 5 then
		-- Tira o personagem do chão para o atrito não "comer" o empurrão.
		humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
	end
	root.AssemblyLinearVelocity += velocity
end

-- Clarão --------------------------------------------------------------------------------------

local function flash(params)
	if not flashFrame or not flashFrame.Parent then
		local gui = UIKit.ScreenGui("FlashFx", 50)
		flashFrame = UIKit.Create("Frame", {
			Name = "Clarao",
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = UDim2.fromScale(1, 1),
			Visible = false,
			Parent = gui,
		}) :: Frame
	end
	local frame = flashFrame :: Frame
	flashToken += 1
	local myToken = flashToken
	local duration = clampNumber(params.duration, 0.05, 3, 0.35)
	frame.BackgroundColor3 = typeof(params.color) == "Color3" and params.color or Color3.new(1, 1, 1)
	frame.BackgroundTransparency = 0.25
	frame.Visible = true
	local tween = TweenService:Create(frame, TweenInfo.new(duration), { BackgroundTransparency = 1 })
	tween.Completed:Once(function()
		if myToken == flashToken then
			frame.Visible = false
		end
	end)
	tween:Play()
end

-- API -------------------------------------------------------------------------------------------

local HANDLERS = {
	shake = addShake,
	tracer = addTracer,
	knockback = applyKnockback,
	flash = flash,
}

function FxClient.Init()
	if initialized then
		return
	end
	initialized = true

	RunService:BindToRenderStep("SelvaTremorDesfaz", Enum.RenderPriority.Camera.Value - 1, undoShake)
	RunService:BindToRenderStep("SelvaTremor", Enum.RenderPriority.Camera.Value + 1, applyShake)

	Net.event(Net.Names.Fx_Play).OnClientEvent:Connect(function(kind, params)
		local handler = type(kind) == "string" and HANDLERS[kind]
		if not handler then
			return
		end
		local ok, err = pcall(handler, type(params) == "table" and params or {})
		if not ok then
			warn(("[FxClient] Erro no efeito '%s': %s"):format(kind, tostring(err)))
		end
	end)
end

return FxClient
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="91">
          <Properties>
            <string name="Name">GameClient</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Entrada do cliente da PARTIDA:
--   1. configurações (busca no servidor em paralelo com a tela de carregamento);
--   2. tela de carregamento (bloqueante; pré-carrega o jogo se o jogador quiser);
--   3. interface e efeitos (HUD, enigma, efeitos, espectador, controles do tabuleiro);
--   4. avisa o servidor que está pronto (Game_ClientReady).
-- Os módulos começam ANTES do aviso de pronto para não perder o estado que o servidor manda em resposta.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(ReplicatedStorage.Shared.Net)
local UIKit = require(ReplicatedStorage.Shared.UI.UIKit)

local LoadingScreen = require(script.Parent.LoadingScreen)
local HUD = require(script.Parent.HUD)
local RiddleUI = require(script.Parent.RiddleUI)
local FxClient = require(script.Parent.FxClient)
local Spectate = require(script.Parent.Spectate)
local BoardClient = require(script.Parent.BoardClient)

local TOAST_KINDS = { info = true, warning = true, danger = true, success = true }

-- 1. Configurações -------------------------------------------------------------------------
local settingsDone = false
task.spawn(function()
	local settingsFolder = Shared:WaitForChild("Settings", 10)
	local moduleScript = settingsFolder and settingsFolder:WaitForChild("SettingsClient", 10)
	if moduleScript and moduleScript:IsA("ModuleScript") then
		local ok, SettingsClient = pcall(require, moduleScript)
		if ok and type(SettingsClient) == "table" and type(SettingsClient.Init) == "function" then
			local initOk, err = pcall(SettingsClient.Init)
			if not initOk then
				warn("[GameClient] Erro ao iniciar as configurações: " .. tostring(err))
			end
		else
			warn("[GameClient] SettingsClient não pôde ser carregado: " .. tostring(SettingsClient))
		end
	else
		warn("[GameClient] SettingsClient não encontrado; usando as configurações padrão.")
	end
	settingsDone = true
end)

-- Sem botão de "Resetar personagem": morrer elimina o jogador.
task.spawn(function()
	for _ = 1, 10 do
		local ok = pcall(function()
			StarterGui:SetCore("ResetButtonCallback", false)
		end)
		if ok then
			break
		end
		task.wait(1)
	end
end)

-- 2. Tela de carregamento ----------------------------------------------------------------
local loadingOk, loadingErr = pcall(LoadingScreen.Run, function()
	return settingsDone
end)
if not loadingOk then
	warn("[GameClient] Erro na tela de carregamento: " .. tostring(loadingErr))
	LoadingScreen.ForceClose()
end

-- 3. Interface e efeitos -----------------------------------------------------------------
local function start(label: string, module)
	local ok, err = pcall(module.Init)
	if not ok then
		warn(("[GameClient] Erro ao iniciar %s: %s"):format(label, tostring(err)))
	end
end
start("FxClient", FxClient)
start("HUD", HUD)
start("RiddleUI", RiddleUI)
start("Spectate", Spectate)
start("BoardClient", BoardClient)

Net.event(Net.Names.Notify).OnClientEvent:Connect(function(text, kind)
	if type(text) ~= "string" or text == "" then
		return
	end
	UIKit.Toast(text, TOAST_KINDS[kind] and kind or "info")
end)

-- 4. Pronto! -------------------------------------------------------------------------------
Net.event(Net.Names.Game_ClientReady):FireServer()
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="92">
          <Properties>
            <string name="Name">HUD</string>
            <string name="Source"><![CDATA[--!nonstrict
-- HUD da partida: casa atual, estado do dado, quem carrega o tabuleiro, vivos/total, eventos ativos,
-- mensagem da fase, aviso de borda da ilha, contagem grande e telas de vitória/derrota.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local Net = require(ReplicatedStorage.Shared.Net)
local SoundUtil = require(ReplicatedStorage.Shared.Audio.SoundUtil)
local UIKit = require(ReplicatedStorage.Shared.UI.UIKit)

local HUD = {}

local Theme = UIKit.Theme
local LocalPlayer = Players.LocalPlayer
local UPDATE_INTERVAL = 0.2
local EDGE_COLOR = Color3.fromRGB(255, 84, 64)

local initialized = false
local ui: { [string]: any } = {}
local scales: { UIScale } = {}
local gameState = nil
local boardStatus = nil
local events: { [string]: { info: any, receivedAt: number, label: TextLabel } } = {}
local eventOrder = 0
local lastCountdown: number? = nil
local edgeVisible = false
local edgeTween: Tween? = nil

-- Validação dos payloads ------------------------------------------------------------------

local function num(value: any, default: number): number
	if type(value) == "number" and value == value then
		return value
	end
	return default
end

local function str(value: any): string?
	if type(value) == "string" and value ~= "" then
		return value
	end
	return nil
end

-- Escala ------------------------------------------------------------------------------------

local function addScale(object: GuiObject)
	local scale = Instance.new("UIScale")
	scale.Parent = object
	table.insert(scales, scale)
end

local function updateScale()
	local camera = workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
	local value = math.clamp(math.min(viewport.X / 1280, viewport.Y / 720), 0.62, 1.15)
	for _, scale in scales do
		scale.Scale = value
	end
end

-- Construção -------------------------------------------------------------------------------

local function build()
	local gui = UIKit.ScreenGui("GameHUD", 5)
	ui.gui = gui

	-- Painel de informações (meio da lateral esquerda: longe do chat e dos botões do Roblox)
	local info = UIKit.Panel({
		Name = "Info",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.5, 0),
		Size = UDim2.fromOffset(280, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Padding = 12,
		Parent = gui,
	})
	local infoLayout = UIKit.ListLayout(info, 6)
	infoLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
	addScale(info)

	ui.space = UIKit.Label({
		Name = "Casa",
		Text = ("Casa 0 de %d"):format(GameConfig.BOARD_SPACES),
		Font = Theme.TitleFont,
		TextSize = 24,
		TextColor3 = Theme.Gold,
		Size = UDim2.new(1, 0, 0, 26),
		LayoutOrder = 1,
		Parent = info,
	})
	local track = UIKit.Create("Frame", {
		Name = "Trilha",
		BackgroundColor3 = Theme.WoodDark,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 8),
		LayoutOrder = 2,
		Parent = info,
	}) :: Frame
	UIKit.Corner(track, UDim.new(1, 0))
	ui.spaceFill = UIKit.Create("Frame", {
		BackgroundColor3 = Theme.Gold,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0, 1),
		Parent = track,
	})
	UIKit.Corner(ui.spaceFill, UDim.new(1, 0))
	ui.dice = UIKit.Label({ Name = "Dado", Text = "Dado: —", TextSize = 18, LayoutOrder = 3, Parent = info })
	ui.carrier = UIKit.Label({
		Name = "Carregador",
		Text = "Tabuleiro: na mesa",
		TextSize = 18,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 22),
		LayoutOrder = 4,
		Parent = info,
	})
	ui.alive = UIKit.Label({ Name = "Vivos", Text = "Vivos: —", TextSize = 18, LayoutOrder = 5, Parent = info })

	-- Eventos ativos (lado direito)
	local eventsPanel = UIKit.Panel({
		Name = "Eventos",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0.3, 0),
		Size = UDim2.fromOffset(290, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Padding = 10,
		Visible = false,
		Parent = gui,
	})
	local eventsLayout = UIKit.ListLayout(eventsPanel, 6)
	eventsLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
	addScale(eventsPanel)
	UIKit.Label({
		Text = "Eventos ativos",
		Font = Theme.TitleFont,
		TextSize = 22,
		TextColor3 = Theme.Gold,
		Size = UDim2.new(1, 0, 0, 24),
		LayoutOrder = 0,
		Parent = eventsPanel,
	})
	ui.eventsPanel = eventsPanel

	-- Mensagem da fase (topo, centro)
	local banner = UIKit.Panel({
		Name = "Mensagem",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.fromOffset(560, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Padding = 10,
		Visible = false,
		Parent = gui,
	})
	addScale(banner)
	ui.bannerText = UIKit.Label({
		Text = "",
		Font = Theme.BoldFont,
		TextSize = 20,
		TextXAlignment = Enum.TextXAlignment.Center,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 0),
		Parent = banner,
	})
	ui.banner = banner

	-- Contagem grande (abaixo do centro, para não cobrir o enigma)
	local countdownHolder = UIKit.Frame({
		Name = "Contagem",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.76),
		Size = UDim2.fromOffset(500, 170),
		Visible = false,
		Parent = gui,
	})
	addScale(countdownHolder)
	ui.countdownNumber = UIKit.Label({
		Text = "",
		Font = Theme.TitleFont,
		TextSize = 110,
		TextColor3 = Theme.Gold,
		TextStrokeTransparency = 0.2,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 128),
		Parent = countdownHolder,
	})
	ui.countdownPop = Instance.new("UIScale")
	ui.countdownPop.Parent = ui.countdownNumber
	ui.countdownText = UIKit.Label({
		Text = "As portas vão se abrir!",
		Font = Theme.BoldFont,
		TextSize = 26,
		TextStrokeTransparency = 0.4,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(0, 132),
		Size = UDim2.new(1, 0, 0, 34),
		Parent = countdownHolder,
	})
	ui.countdown = countdownHolder

	-- Aviso da borda da ilha
	local edge = UIKit.Label({
		Name = "AvisoBorda",
		Text = "Volte! A borda da ilha elimina!",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.66),
		Size = UDim2.fromOffset(640, 48),
		Font = Theme.BoldFont,
		TextSize = 34,
		TextColor3 = EDGE_COLOR,
		TextStrokeTransparency = 0.1,
		TextXAlignment = Enum.TextXAlignment.Center,
		Visible = false,
		Parent = gui,
	})
	addScale(edge)
	ui.edge = edge

	-- Tela de fim (vitória / derrota)
	local endScreen = UIKit.Create("Frame", {
		Name = "Fim",
		BackgroundColor3 = Theme.Overlay,
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 10,
		Parent = gui,
	}) :: Frame
	local endContent = UIKit.Frame({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(760, 300),
		ZIndex = 11,
		Parent = endScreen,
	})
	addScale(endContent)
	ui.endTitle = UIKit.Title("", {
		TextSize = 96,
		Size = UDim2.new(1, 0, 0, 110),
		ZIndex = 11,
		Parent = endContent,
	})
	ui.endSubtitle = UIKit.Label({
		Text = GameConfig.GAME_TITLE,
		Font = Theme.TitleFont,
		TextSize = 30,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(0, 116),
		Size = UDim2.new(1, 0, 0, 36),
		ZIndex = 11,
		Parent = endContent,
	})
	ui.endMessage = UIKit.Label({
		Text = "",
		TextSize = 24,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(0, 160),
		Size = UDim2.new(1, 0, 0, 60),
		ZIndex = 11,
		Parent = endContent,
	})
	ui.endTimer = UIKit.Label({
		Text = "",
		TextSize = 20,
		TextColor3 = Theme.TextMuted,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(0, 226),
		Size = UDim2.new(1, 0, 0, 30),
		ZIndex = 11,
		Parent = endContent,
	})
	ui.endScreen = endScreen

	updateScale()
	local camera = workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
	end
end

-- Renderização ----------------------------------------------------------------------------

local function diceText(): (string, Color3)
	local status = boardStatus
	if not status then
		return "Dado: —", Theme.TextMuted
	end
	if status.rolling then
		return "Dado: rolando…", Theme.Gold
	end
	if status.locked then
		return "Dado: tabuleiro preso!", Theme.Danger
	end
	if status.cooldownEndsAt then
		local remaining = status.cooldownEndsAt - workspace:GetServerTimeNow()
		if remaining > 0 then
			return ("Dado: próxima jogada em %ds"):format(math.ceil(remaining)), Theme.TextMuted
		end
	end
	if status.canRoll then
		return "Dado: pronto para jogar!", Theme.Success
	end
	return "Dado: em espera", Theme.TextMuted
end

local function renderBoard()
	local status = boardStatus
	if not status then
		return
	end
	local text, color = diceText()
	ui.dice.Text = text
	ui.dice.TextColor3 = color
	if status.carrierUserId then
		if status.carrierUserId == LocalPlayer.UserId then
			ui.carrier.Text = "Tabuleiro: com você (T joga • G solta)"
			ui.carrier.TextColor3 = Theme.Gold
		else
			local player = Players:GetPlayerByUserId(status.carrierUserId)
			ui.carrier.Text = ("Tabuleiro: com %s"):format(player and player.DisplayName or "outro jogador")
			ui.carrier.TextColor3 = Theme.Text
		end
	else
		ui.carrier.Text = "Tabuleiro: no chão"
		ui.carrier.TextColor3 = Theme.Text
	end
	if gameState == nil then
		ui.space.Text = ("Casa %d de %d"):format(status.space, GameConfig.BOARD_SPACES)
	end
end

local function popCountdown()
	local pop = ui.countdownPop :: UIScale
	pop.Scale = 1.45
	TweenService:Create(pop, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

local function renderState()
	local state = gameState
	if not state then
		return
	end
	local total = math.max(state.totalSpaces, 1)
	ui.space.Text = ("Casa %d de %d"):format(state.space, total)
	ui.spaceFill.Size = UDim2.fromScale(math.clamp(state.space / total, 0, 1), 1)
	ui.alive.Text = ("Vivos: %d/%d"):format(state.alive, state.total)

	local phase = state.phase
	local isEnd = phase == "Victory" or phase == "Defeat"

	-- Mensagem da fase (não aparece durante o jogo, na contagem nem no fim)
	local showBanner = state.message ~= nil and phase ~= "Playing" and phase ~= "Countdown" and not isEnd
	ui.banner.Visible = showBanner
	if showBanner then
		ui.bannerText.Text = state.message
	end

	-- Contagem grande
	if phase == "Countdown" and state.countdown then
		ui.countdown.Visible = true
		ui.countdownNumber.Text = tostring(state.countdown)
		ui.countdownText.Text = state.message or "As portas vão se abrir!"
		if state.countdown ~= lastCountdown then
			lastCountdown = state.countdown
			popCountdown()
			SoundUtil.Play("Countdown", { Volume = 0.5 })
		end
	else
		ui.countdown.Visible = false
		lastCountdown = nil
	end

	-- Fim
	if isEnd then
		local victory = phase == "Victory"
		ui.endScreen.Visible = true
		ui.endTitle.Text = victory and "Vitória!" or "Derrota"
		ui.endTitle.TextColor3 = victory and Theme.Gold or Theme.Danger
		ui.endMessage.Text = victory and "O tabuleiro foi vencido!"
			or "Todos foram eliminados. A selva venceu desta vez…"
		if state.countdown then
			ui.endTimer.Text = ("Voltando ao lobby em %ds"):format(state.countdown)
		elseif state.message and state.message ~= ui.endMessage.Text then
			-- Ex.: "Voltando ao lobby…" ou o aviso de que no Studio não há teleporte.
			ui.endTimer.Text = state.message
		else
			ui.endTimer.Text = ""
		end
	else
		ui.endScreen.Visible = false
	end
end

local function refreshEvents()
	local now = os.clock()
	local count = 0
	for _, entry in events do
		count += 1
		local info = entry.info
		local remaining = math.max(math.ceil(info.duration - (now - entry.receivedAt)), 0)
		entry.label.Text = ("%s\n%s · %ds"):format(info.name, info.regionName or "perto do tabuleiro", remaining)
	end
	ui.eventsPanel.Visible = count > 0
end

local function setEdgeWarning(visible: boolean)
	if visible == edgeVisible then
		return
	end
	edgeVisible = visible
	ui.edge.Visible = visible
	if edgeTween then
		edgeTween:Cancel()
		edgeTween = nil
	end
	if visible then
		ui.edge.TextTransparency = 0
		local tween = TweenService:Create(
			ui.edge,
			TweenInfo.new(0.45, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
			{ TextTransparency = 0.65 }
		)
		edgeTween = tween
		tween:Play()
	end
end

local function updateEdge()
	local show = false
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") and not LocalPlayer:GetAttribute("Eliminated") then
		local center = GameConfig.ISLAND_CENTER
		local distance = Vector3.new(root.Position.X - center.X, 0, root.Position.Z - center.Z).Magnitude
		show = distance > GameConfig.ISLAND_RADIUS - GameConfig.EDGE_WARNING_DISTANCE
	end
	setEdgeWarning(show)
end

-- Remotes -----------------------------------------------------------------------------------

local function onGameState(payload)
	if type(payload) ~= "table" or type(payload.phase) ~= "string" then
		return
	end
	gameState = {
		phase = payload.phase,
		countdown = type(payload.countdown) == "number" and payload.countdown or nil,
		space = num(payload.space, 0),
		totalSpaces = num(payload.totalSpaces, GameConfig.BOARD_SPACES),
		alive = num(payload.alive, 0),
		total = num(payload.total, 0),
		message = str(payload.message),
	}
	renderState()
end

local function onBoardStatus(payload)
	if type(payload) ~= "table" then
		return
	end
	boardStatus = {
		carrierUserId = type(payload.carrierUserId) == "number" and payload.carrierUserId or nil,
		canRoll = payload.canRoll == true,
		cooldownEndsAt = type(payload.cooldownEndsAt) == "number" and payload.cooldownEndsAt or nil,
		space = num(payload.space, 0),
		locked = payload.locked == true,
		rolling = payload.rolling == true,
	}
	renderBoard()
end

local function onEventStarted(info)
	if type(info) ~= "table" or type(info.id) ~= "string" then
		return
	end
	local clean = {
		id = info.id,
		name = str(info.name) or str(info.eventId) or "Evento",
		regionName = str(info.regionName),
		duration = num(info.duration, 60),
	}
	local entry = events[clean.id]
	if entry then
		entry.info = clean
		entry.receivedAt = os.clock()
	else
		eventOrder += 1
		local label = UIKit.Label({
			Name = clean.id,
			Text = "",
			TextSize = 17,
			AutomaticSize = Enum.AutomaticSize.Y,
			Size = UDim2.new(1, 0, 0, 0),
			LayoutOrder = eventOrder,
			Parent = ui.eventsPanel,
		})
		events[clean.id] = { info = clean, receivedAt = os.clock(), label = label }
	end
	refreshEvents()
end

local function onEventEnded(instanceId)
	if type(instanceId) ~= "string" then
		return
	end
	local entry = events[instanceId]
	if entry then
		entry.label:Destroy()
		events[instanceId] = nil
	end
	refreshEvents()
end

-- API -----------------------------------------------------------------------------------------

function HUD.Init()
	if initialized then
		return
	end
	initialized = true
	build()

	Net.event(Net.Names.Game_State).OnClientEvent:Connect(onGameState)
	Net.event(Net.Names.Board_Status).OnClientEvent:Connect(onBoardStatus)
	Net.event(Net.Names.Event_Started).OnClientEvent:Connect(onEventStarted)
	Net.event(Net.Names.Event_Ended).OnClientEvent:Connect(onEventEnded)

	task.spawn(function()
		while ui.gui and ui.gui.Parent do
			renderBoard()
			refreshEvents()
			updateEdge()
			task.wait(UPDATE_INTERVAL)
		end
	end)
end

return HUD
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="93">
          <Properties>
            <string name="Name">LoadingScreen</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Tela de carregamento da partida.
-- Espera o mapa ficar pronto (workspace MapReady) e, se o jogador deixou "Carregar jogo antecipadamente"
-- ligado nas configurações:
--   1. ContentProvider:PreloadAsync nas instâncias com assets do mapa, dos sons e do céu;
--   2. uma varredura de câmera por todas as regiões de workspace.Map.Regions (3–4 ângulos, 2 frames cada),
--      com o culling desligado, para o aparelho renderizar e compilar materiais e shaders AGORA — assim o
--      jogo não engasga quando o jogador entra num cômodo novo.
-- Sem pré-carregamento, só espera o mapa.

local ContentProvider = game:GetService("ContentProvider")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local SettingsSchema = require(ReplicatedStorage.Shared.Settings.SettingsSchema)
local UIKit = require(ReplicatedStorage.Shared.UI.UIKit)

local LoadingScreen = {}

local Theme = UIKit.Theme
local GUI_NAME = "LoadingScreen"
local PRELOAD_BATCH = 40
local FRAMES_PER_SHOT = 2
local SETTINGS_TIMEOUT = 9
local TIP_INTERVAL = 6

local TIPS = {
	"Carregue o tabuleiro nas costas para levá-lo de um cenário para outro.",
	"Cada nova jogada SOMA um evento aos que já estão acontecendo.",
	"O evento acontece onde o tabuleiro foi jogado. Escolha bem o lugar!",
	"Passar da borda da ilha elimina na hora. Fique longe da água!",
	"Procure armas na mansão, no labirinto e na estufa.",
	"O enigma do tabuleiro dá uma pista do que vai acontecer. Leia com atenção!",
	"Pedaços do cenário somem depois de um tempo para não pesar no aparelho.",
	"Todos andam com a MESMA peça: a vitória é do grupo inteiro.",
}

-- Classes que carregam assets (texturas, malhas, sons, partículas...).
local CONTENT_CLASSES = {
	Decal = true,
	Texture = true,
	MeshPart = true,
	SpecialMesh = true,
	SurfaceAppearance = true,
	ParticleEmitter = true,
	Beam = true,
	Trail = true,
	Sound = true,
	ImageLabel = true,
	ImageButton = true,
	Sky = true,
	Animation = true,
}

local current = nil -- elementos da tela atual

local function requireSettingsModule(name: string): any
	local settingsFolder = ReplicatedStorage.Shared:FindFirstChild("Settings")
	local moduleScript = settingsFolder and settingsFolder:WaitForChild(name, 5)
	if not moduleScript or not moduleScript:IsA("ModuleScript") then
		return nil
	end
	local ok, result = pcall(require, moduleScript)
	if ok and type(result) == "table" then
		return result
	end
	return nil
end

local function buildGui()
	local gui = UIKit.ScreenGui(GUI_NAME, 200)

	local background = UIKit.Create("Frame", {
		Name = "Fundo",
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Parent = gui,
	}) :: Frame
	UIKit.Create("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(Color3.fromRGB(28, 56, 32), Color3.fromRGB(6, 14, 8)),
		Parent = background,
	})

	local header = UIKit.Frame({
		Name = "Cabecalho",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.14),
		Size = UDim2.new(0.9, 0, 0, 130),
		Parent = background,
	})
	local title = UIKit.Title(GameConfig.GAME_TITLE, {
		Size = UDim2.new(1, 0, 0, 80),
		TextScaled = true,
		Parent = header,
	})
	UIKit.Create("UITextSizeConstraint", { MaxTextSize = 72, Parent = title })
	UIKit.Label({
		Text = GameConfig.GAME_SUBTITLE,
		Position = UDim2.fromOffset(0, 86),
		Size = UDim2.new(1, 0, 0, 28),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = Theme.TextMuted,
		TextSize = 22,
		Parent = header,
	})

	local panel = UIKit.Panel({
		Name = "Painel",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -32),
		Size = UDim2.new(0.92, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = background,
	})
	UIKit.Create("UISizeConstraint", { MaxSize = Vector2.new(720, math.huge), Parent = panel })
	UIKit.ListLayout(panel, 8)

	local status = UIKit.Label({
		Name = "Status",
		Text = "Carregando…",
		Font = Theme.BoldFont,
		TextSize = 20,
		TextXAlignment = Enum.TextXAlignment.Center,
		LayoutOrder = 1,
		Parent = panel,
	})

	local track = UIKit.Create("Frame", {
		Name = "Barra",
		BackgroundColor3 = Theme.WoodDark,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 14),
		LayoutOrder = 2,
		Parent = panel,
	}) :: Frame
	UIKit.Corner(track, UDim.new(1, 0))
	local fill = UIKit.Create("Frame", {
		Name = "Progresso",
		BackgroundColor3 = Theme.Gold,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0, 1),
		Parent = track,
	}) :: Frame
	UIKit.Corner(fill, UDim.new(1, 0))

	local detail = UIKit.Label({
		Name = "Detalhe",
		Text = "",
		TextSize = 16,
		TextColor3 = Theme.TextMuted,
		TextXAlignment = Enum.TextXAlignment.Center,
		LayoutOrder = 3,
		Parent = panel,
	})

	local note = UIKit.Label({
		Name = "Nota",
		Text = "Pré-carregando: a câmera passa por todos os cenários para compilar texturas e shaders agora. "
			.. "Assim o jogo não trava quando você entrar num lugar novo. "
			.. "(Dá para desligar em Configurações › Gráficos.)",
		TextSize = 15,
		TextColor3 = Theme.TextMuted,
		TextXAlignment = Enum.TextXAlignment.Center,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 0),
		Visible = false,
		LayoutOrder = 4,
		Parent = panel,
	})

	local errorLabel = UIKit.Label({
		Name = "Erro",
		Text = "",
		TextSize = 16,
		TextColor3 = Theme.Danger,
		TextXAlignment = Enum.TextXAlignment.Center,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 0),
		Visible = false,
		LayoutOrder = 5,
		Parent = panel,
	})

	local tip = UIKit.Label({
		Name = "Dica",
		Text = "Dica: " .. TIPS[math.random(1, #TIPS)],
		TextSize = 17,
		TextColor3 = Theme.Gold,
		TextXAlignment = Enum.TextXAlignment.Center,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 0),
		LayoutOrder = 6,
		Parent = panel,
	})

	return {
		gui = gui,
		background = background,
		header = header,
		panel = panel,
		status = status,
		fill = fill,
		detail = detail,
		note = note,
		errorLabel = errorLabel,
		tip = tip,
		progress = 0,
		alive = true,
	}
end

local function setStatus(text: string)
	if current then
		current.status.Text = text
	end
end

local function setDetail(text: string)
	if current then
		current.detail.Text = text
	end
end

local function setProgress(alpha: number)
	if not current then
		return
	end
	alpha = math.clamp(alpha, 0, 1)
	if math.abs(alpha - current.progress) < 0.002 then
		return
	end
	current.progress = alpha
	TweenService:Create(current.fill, TweenInfo.new(0.15), { Size = UDim2.fromScale(alpha, 1) }):Play()
end

-- Instâncias com assets do mapa, dos sons e do céu.
local function collectContent(map: Instance): { Instance }
	local list = {}
	local count = 0
	for _, descendant in map:GetDescendants() do
		count += 1
		if count % 4000 == 0 then
			task.wait()
		end
		if CONTENT_CLASSES[descendant.ClassName] then
			table.insert(list, descendant)
		end
	end
	for _, descendant in SoundService:GetDescendants() do
		if descendant:IsA("Sound") then
			table.insert(list, descendant)
		end
	end
	for _, child in Lighting:GetChildren() do
		if child:IsA("Sky") then
			table.insert(list, child)
		end
	end
	return list
end

-- Posições de câmera: 3–4 ângulos por região + vistas gerais da ilha.
local function buildShots(map: Instance): { { cframe: CFrame, name: string } }
	local shots = {}
	local regions = map:FindFirstChild("Regions")
	if regions then
		for _, part in regions:GetDescendants() do
			if part:IsA("BasePart") then
				local regionName = part:GetAttribute("RegionName")
				local name = type(regionName) == "string" and regionName or part.Name
				local size, cframe = part.Size, part.CFrame
				local center = cframe.Position
				local horizontal = math.max(size.X, size.Z)
				local floorY = center.Y - size.Y / 2
				local big = horizontal > 80
				local angles = big and 4 or 3
				local eye
				if big then
					-- Áreas externas grandes: de cima, olhando para o chão em diagonal.
					eye = Vector3.new(center.X, floorY + math.clamp(horizontal * 0.2, 18, 70), center.Z)
				else
					-- Cômodos: do meio da sala, na altura dos olhos.
					eye = Vector3.new(center.X, floorY + math.clamp(size.Y * 0.45, 3, 8), center.Z)
				end
				for index = 0, angles - 1 do
					local angle = (index / angles) * math.pi * 2 + math.pi / 4
					local direction = cframe:VectorToWorldSpace(Vector3.new(math.cos(angle), 0, math.sin(angle)))
					local target
					if big then
						target = Vector3.new(center.X, floorY, center.Z) + direction * horizontal * 0.35
					else
						target = eye + direction * math.max(horizontal * 0.5, 4) - Vector3.new(0, 1.5, 0)
					end
					table.insert(shots, { cframe = CFrame.lookAt(eye, target), name = name })
				end
			end
		end
	end

	local center = GameConfig.ISLAND_CENTER + Vector3.new(0, GameConfig.GROUND_Y, 0)
	for index = 0, 3 do
		local angle = index * math.pi / 2 + math.pi / 4
		local eye = center
			+ Vector3.new(
				math.cos(angle) * GameConfig.ISLAND_RADIUS * 0.9,
				160,
				math.sin(angle) * GameConfig.ISLAND_RADIUS * 0.9
			)
		table.insert(shots, { cframe = CFrame.lookAt(eye, center), name = "Vista da ilha" })
	end
	return shots
end

local function readPreloadSetting(): boolean
	local SettingsClient = requireSettingsModule("SettingsClient")
	if SettingsClient and type(SettingsClient.Get) == "function" then
		local ok, settings = pcall(SettingsClient.Get)
		if
			ok
			and type(settings) == "table"
			and type(settings.graphics) == "table"
			and type(settings.graphics.preload) == "boolean"
		then
			return settings.graphics.preload
		end
	end
	return SettingsSchema.Defaults().graphics.preload
end

local function restoreCamera()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	camera.CameraType = Enum.CameraType.Custom
	local character = Players.LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		camera.CameraSubject = humanoid
	end
end

local function runPreload(map: Instance)
	local GraphicsApplier = requireSettingsModule("GraphicsApplier")
	local function setCulling(enabled: boolean)
		if GraphicsApplier and type(GraphicsApplier.SetCullingEnabled) == "function" then
			local ok, err = pcall(GraphicsApplier.SetCullingEnabled, enabled)
			if not ok then
				warn("[LoadingScreen] Erro ao mudar o culling: " .. tostring(err))
			end
		end
	end

	current.note.Visible = true
	setCulling(false)

	local ok, err = pcall(function()
		-- 1. Assets
		setStatus("Pré-carregando texturas e sons…")
		local assets = collectContent(map)
		local total = #assets
		for first = 1, total, PRELOAD_BATCH do
			local last = math.min(first + PRELOAD_BATCH - 1, total)
			local batch = table.move(assets, first, last, 1, {})
			pcall(function()
				ContentProvider:PreloadAsync(batch)
			end)
			setProgress(0.3 + 0.2 * last / total)
			setDetail(("Assets: %d/%d"):format(last, total))
		end
		setProgress(0.5)

		-- 2. Varredura de câmera (renderiza cada cenário para compilar materiais e shaders)
		setStatus("Pré-carregando os cenários…")
		local shots = buildShots(map)
		local camera = workspace.CurrentCamera
		camera.CameraType = Enum.CameraType.Scriptable
		-- O fundo fica translúcido para a "visita" aparecer atrás do painel.
		current.background.BackgroundTransparency = 0.45
		current.header.Visible = false
		for index, shot in shots do
			camera.CFrame = shot.cframe
			for _ = 1, FRAMES_PER_SHOT do
				RunService.RenderStepped:Wait()
			end
			setProgress(0.5 + 0.5 * index / #shots)
			setDetail(("Visitando: %s (%d/%d)"):format(shot.name, index, #shots))
		end
	end)
	if not ok then
		warn("[LoadingScreen] Erro no pré-carregamento: " .. tostring(err))
	end

	setCulling(true)
	restoreCamera()
	current.background.BackgroundTransparency = 0
	current.header.Visible = true
	setDetail("")
end

-- Fecha a tela imediatamente (usado se algo der errado).
function LoadingScreen.ForceClose()
	if current then
		current.alive = false
		current.gui:Destroy()
		current = nil
	end
	local playerGui = Players.LocalPlayer:FindFirstChild("PlayerGui")
	local leftover = playerGui and playerGui:FindFirstChild(GUI_NAME)
	if leftover then
		leftover:Destroy()
	end
	restoreCamera()
end

-- Mostra a tela e só retorna quando o jogo está pronto para jogar.
-- isSettingsReady: função opcional que diz se as configurações já chegaram do servidor.
function LoadingScreen.Run(isSettingsReady: (() -> boolean)?)
	current = buildGui()
	local screen = current

	-- Dicas trocando de tempos em tempos
	task.spawn(function()
		local index = math.random(1, #TIPS)
		while screen.alive do
			task.wait(TIP_INTERVAL)
			if not screen.alive then
				break
			end
			index = index % #TIPS + 1
			screen.tip.Text = "Dica: " .. TIPS[index]
		end
	end)

	-- 1. Jogo carregado
	if not game:IsLoaded() then
		setStatus("Carregando o jogo…")
		game.Loaded:Wait()
	end

	-- 2. Mapa construído pelo servidor
	local started = os.clock()
	while not workspace:GetAttribute("MapReady") do
		local elapsed = os.clock() - started
		setStatus(("Construindo a ilha… %ds"):format(math.floor(elapsed)))
		setProgress(0.3 * (1 - math.exp(-elapsed / 12)))
		task.wait(0.25)
	end
	local map = workspace:WaitForChild("Map", 15)
	local mapError = workspace:GetAttribute("MapError")
	if mapError then
		screen.errorLabel.Text = "O mapa principal não pôde ser construído (veja o Output do servidor). "
			.. "Um mapa reserva será usado."
		screen.errorLabel.Visible = true
	end
	setProgress(0.3)

	-- 3. Configurações do jogador (com limite de tempo)
	local waitStart = os.clock()
	while isSettingsReady and not isSettingsReady() and os.clock() - waitStart < SETTINGS_TIMEOUT do
		setStatus("Carregando suas configurações…")
		task.wait(0.1)
	end

	-- 4. Pré-carregamento (opcional)
	if map and readPreloadSetting() then
		runPreload(map)
	else
		setStatus("Quase lá…")
	end

	setStatus("Pronto!")
	setProgress(1)
	task.wait(0.35)

	-- Some com um fade
	screen.alive = false
	screen.panel.Visible = false
	screen.header.Visible = false
	local fade = TweenService:Create(screen.background, TweenInfo.new(0.6), { BackgroundTransparency = 1 })
	fade:Play()
	task.delay(0.65, function()
		screen.gui:Destroy()
	end)
	if current == screen then
		current = nil
	end
end

return LoadingScreen
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="94">
          <Properties>
            <string name="Name">RiddleUI</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Enigma do tabuleiro na tela: painel de "vidro" verde no centro, texto em efeito de máquina de escrever,
-- tambores e contagem até o evento. Some depois de ~8 s ou quando o evento começa.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local SoundUtil = require(ReplicatedStorage.Shared.Audio.SoundUtil)
local UIKit = require(ReplicatedStorage.Shared.UI.UIKit)

local RiddleUI = {}

local Theme = UIKit.Theme
local LocalPlayer = Players.LocalPlayer

local HIDE_AFTER = 8
local CHARS_PER_SECOND = 32
local FAR_FROM_BOARD = 80 -- longe assim, o tambor 3D do servidor não é ouvido: toca um local
local MAX_TEXT = 500

local GLASS_BG = Color3.fromRGB(8, 34, 16)
local GLASS_TEXT = Color3.fromRGB(120, 255, 140)
local GLASS_MUTED = Color3.fromRGB(150, 210, 160)

local initialized = false
local ui: { [string]: any } = {}
local token = 0
local visible = false

local function build()
	local gui = UIKit.ScreenGui("RiddleUI", 20)

	-- CanvasGroup só para o fade; o "vidro" fica num Frame interno (margem para a borda não ser cortada).
	local panel = UIKit.Create("CanvasGroup", {
		Name = "Enigma",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromOffset(640, 270),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		GroupTransparency = 1,
		Visible = false,
		Parent = gui,
	}) :: CanvasGroup
	local scale = Instance.new("UIScale")
	scale.Parent = panel

	local glass = UIKit.Create("Frame", {
		Name = "Vidro",
		Position = UDim2.fromOffset(5, 5),
		Size = UDim2.new(1, -10, 1, -10),
		BackgroundColor3 = GLASS_BG,
		BackgroundTransparency = 0.08,
		BorderSizePixel = 0,
		Parent = panel,
	}) :: Frame
	UIKit.Corner(glass, UDim.new(0, 16))
	UIKit.Stroke(glass, GLASS_TEXT, 3)
	UIKit.Padding(glass, 14)
	UIKit.Create("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(150, 190, 160)),
		Parent = glass,
	})
	UIKit.ListLayout(glass, 8)

	UIKit.Label({
		Text = "O tabuleiro fala…",
		Font = Theme.TitleFont,
		TextSize = 22,
		TextColor3 = GLASS_MUTED,
		TextXAlignment = Enum.TextXAlignment.Center,
		LayoutOrder = 1,
		Parent = glass,
	})
	ui.text = UIKit.Label({
		Name = "Texto",
		Text = "",
		Font = Theme.TitleFont,
		TextSize = 30,
		TextColor3 = GLASS_TEXT,
		TextStrokeColor3 = Color3.fromRGB(0, 50, 16),
		TextStrokeTransparency = 0.4,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center,
		Size = UDim2.new(1, 0, 0, 140),
		LayoutOrder = 2,
		Parent = glass,
	})
	UIKit.Create("UITextSizeConstraint", { MaxTextSize = 30, MinTextSize = 14, Parent = ui.text })
	ui.text.TextScaled = true
	ui.footer = UIKit.Label({
		Text = "",
		TextSize = 18,
		TextColor3 = GLASS_MUTED,
		TextXAlignment = Enum.TextXAlignment.Center,
		LayoutOrder = 3,
		Parent = glass,
	})
	ui.timer = UIKit.Label({
		Text = "",
		Font = Theme.BoldFont,
		TextSize = 20,
		TextColor3 = Theme.Gold,
		TextXAlignment = Enum.TextXAlignment.Center,
		LayoutOrder = 4,
		Parent = glass,
	})

	ui.gui = gui
	ui.panel = panel
	ui.scale = scale

	local function updateScale()
		local camera = workspace.CurrentCamera
		local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
		scale.Scale = math.clamp(math.min(viewport.X / 1000, viewport.Y / 620), 0.55, 1.1)
	end
	updateScale()
	local camera = workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
	end
end

local function hide()
	token += 1
	if visible then
		visible = false
		UIKit.Fade(ui.panel, false, 0.4)
	end
end

-- Tambores locais só para quem está longe do tabuleiro (perto, o som 3D do servidor já toca).
local function playDrums()
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local boardFolder = workspace:FindFirstChild("Board")
	local boardModel = boardFolder and boardFolder:FindFirstChildOfClass("Model")
	if root and root:IsA("BasePart") and boardModel then
		if (boardModel:GetPivot().Position - root.Position).Magnitude <= FAR_FROM_BOARD then
			return
		end
	end
	SoundUtil.Play("Drums", { Volume = 0.45 })
end

local function show(payload)
	token += 1
	local myToken = token

	local text = payload.text
	local graphemes = utf8.len(text) or #text
	ui.text.Text = text
	ui.text.MaxVisibleGraphemes = 0

	local dice = {}
	local sum = 0
	for _, value in payload.dice do
		table.insert(dice, tostring(value))
		sum += value
	end
	if #dice > 0 then
		ui.footer.Text = ("Casa %d · Dados: %s = %d"):format(payload.space, table.concat(dice, " + "), sum)
	else
		ui.footer.Text = ("Casa %d"):format(payload.space)
	end

	visible = true
	UIKit.Fade(ui.panel, true, 0.3)
	playDrums()

	local shownAt = os.clock()
	local eventAt = shownAt + payload.countdown
	-- Na primeira jogada a contagem (10 s) passa de HIDE_AFTER: o painel fica até ela terminar.
	local hideAfter = math.max(HIDE_AFTER, payload.countdown + 1)

	-- Máquina de escrever (MaxVisibleGraphemes não quebra acentos)
	task.spawn(function()
		local shown = 0
		local step = math.max(1, math.floor(CHARS_PER_SECOND / 30 + 0.5))
		while token == myToken and shown < graphemes do
			task.wait(1 / 30)
			shown = math.min(graphemes, shown + step)
			ui.text.MaxVisibleGraphemes = shown
		end
		if token == myToken then
			ui.text.MaxVisibleGraphemes = -1
		end
	end)

	-- Contagem até o evento e fechamento automático
	task.spawn(function()
		while token == myToken do
			local remaining = math.ceil(eventAt - os.clock())
			if remaining > 0 then
				ui.timer.Text = payload.isFirst and ("A partida começa em %ds"):format(remaining)
					or ("O evento começa em %ds"):format(remaining)
			else
				ui.timer.Text = "Começou!"
			end
			if os.clock() - shownAt >= hideAfter then
				hide()
				break
			end
			task.wait(0.2)
		end
	end)
end

local function onRiddle(payload)
	if type(payload) ~= "table" or type(payload.text) ~= "string" or payload.text == "" then
		return
	end
	local text = payload.text
	if #text > MAX_TEXT then
		local cut = utf8.offset(text, MAX_TEXT)
		text = cut and text:sub(1, cut - 1) or text:sub(1, MAX_TEXT)
	end
	local dice = {}
	if type(payload.dice) == "table" then
		for index, value in payload.dice do
			if type(index) == "number" and type(value) == "number" and index <= 12 then
				table.insert(dice, math.floor(value))
			end
		end
	end
	show({
		text = text,
		space = type(payload.space) == "number" and math.floor(payload.space) or 0,
		dice = dice,
		countdown = type(payload.countdown) == "number" and math.clamp(payload.countdown, 0, 60) or 5,
		isFirst = payload.isFirst == true,
	})
end

function RiddleUI.Init()
	if initialized then
		return
	end
	initialized = true
	build()
	Net.event(Net.Names.Board_Riddle).OnClientEvent:Connect(onRiddle)
	Net.event(Net.Names.Event_Started).OnClientEvent:Connect(function()
		hide()
	end)
end

return RiddleUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="95">
          <Properties>
            <string name="Name">Spectate</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Câmera do jogador fora de jogo:
--   * eliminado (atributo Eliminated): segue um jogador vivo; botões ◀ ▶ e teclas Q / E trocam o alvo;
--     sem ninguém vivo, a câmera gira em volta do tabuleiro;
--   * ainda sem personagem (esperando nascer): a câmera gira devagar em volta do tabuleiro;
--   * jogando: devolve a câmera normal (Custom) para o próprio personagem.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local Net = require(ReplicatedStorage.Shared.Net)
local UIKit = require(ReplicatedStorage.Shared.UI.UIKit)

local Spectate = {}

local Theme = UIKit.Theme
local LocalPlayer = Players.LocalPlayer

local NEXT_ACTION = "SelvaEspectadorProximo"
local PREV_ACTION = "SelvaEspectadorAnterior"
local ORBIT_STEP = "SelvaOrbita"
local CHECK_INTERVAL = 0.5

local initialized = false
local mode: string? = nil -- "play" | "waiting" | "spectate"
local targetUserId: number? = nil
local orbitBound = false
local orbitWide = false
local orbitAngle = 0
local actionsBound = false
local hadCharacter = false -- quem nunca teve personagem (entrou depois do início) é só espectador
local ui: { [string]: any } = {}

local function getHumanoid(player: Player): Humanoid?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		return humanoid
	end
	return nil
end

local function aliveTargets(): { Player }
	local list = {}
	for _, player in Players:GetPlayers() do
		if player ~= LocalPlayer and not player:GetAttribute("Eliminated") and getHumanoid(player) then
			table.insert(list, player)
		end
	end
	table.sort(list, function(a, b)
		return a.UserId < b.UserId
	end)
	return list
end

-- Órbita ----------------------------------------------------------------------------------------

local function orbitFocus(): Vector3
	local boardFolder = workspace:FindFirstChild("Board")
	local boardModel = boardFolder and boardFolder:FindFirstChildOfClass("Model")
	if boardModel then
		return boardModel:GetPivot().Position
	end
	return GameConfig.ISLAND_CENTER + Vector3.new(0, GameConfig.GROUND_Y, 0)
end

local function orbitStep(deltaTime: number)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	if camera.CameraType ~= Enum.CameraType.Scriptable then
		camera.CameraType = Enum.CameraType.Scriptable
	end
	orbitAngle += deltaTime * (orbitWide and 0.08 or 0.15)
	local radius = orbitWide and 70 or 12
	local height = orbitWide and 45 or 8
	local focus = orbitFocus()
	local eye = focus + Vector3.new(math.cos(orbitAngle) * radius, height, math.sin(orbitAngle) * radius)
	camera.CFrame = CFrame.lookAt(eye, focus)
end

local function startOrbit(wide: boolean)
	orbitWide = wide
	if orbitBound then
		return
	end
	orbitBound = true
	RunService:BindToRenderStep(ORBIT_STEP, Enum.RenderPriority.Camera.Value, orbitStep)
end

local function stopOrbit()
	if not orbitBound then
		return
	end
	orbitBound = false
	RunService:UnbindFromRenderStep(ORBIT_STEP)
end

-- Alvo do espectador --------------------------------------------------------------------------

local function refreshTarget()
	local camera = workspace.CurrentCamera
	local targets = aliveTargets()
	if #targets == 0 then
		targetUserId = nil
		ui.name.Text = "Ninguém vivo para assistir"
		startOrbit(true)
		return
	end
	local current = targets[1]
	for _, player in targets do
		if player.UserId == targetUserId then
			current = player
			break
		end
	end
	targetUserId = current.UserId
	stopOrbit()
	local humanoid = getHumanoid(current)
	if camera and humanoid then
		if camera.CameraType ~= Enum.CameraType.Custom then
			camera.CameraType = Enum.CameraType.Custom
		end
		if camera.CameraSubject ~= humanoid then
			camera.CameraSubject = humanoid
		end
	end
	ui.name.Text = ("Assistindo: %s"):format(current.DisplayName)
end

local function cycle(direction: number)
	if mode ~= "spectate" then
		return
	end
	local targets = aliveTargets()
	if #targets == 0 then
		refreshTarget()
		return
	end
	local index = 0
	for i, player in targets do
		if player.UserId == targetUserId then
			index = i
			break
		end
	end
	if index == 0 then
		index = 1
	else
		index = (index - 1 + direction) % #targets + 1
	end
	targetUserId = targets[index].UserId
	refreshTarget()
end

local function onAction(actionName: string, inputState: Enum.UserInputState)
	if inputState ~= Enum.UserInputState.Begin then
		return Enum.ContextActionResult.Pass
	end
	cycle(actionName == NEXT_ACTION and 1 or -1)
	return Enum.ContextActionResult.Sink
end

local function setActionsBound(bound: boolean)
	if bound == actionsBound then
		return
	end
	actionsBound = bound
	if bound then
		ContextActionService:BindAction(NEXT_ACTION, onAction, false, Enum.KeyCode.E, Enum.KeyCode.ButtonR1)
		ContextActionService:BindAction(PREV_ACTION, onAction, false, Enum.KeyCode.Q, Enum.KeyCode.ButtonL1)
	else
		ContextActionService:UnbindAction(NEXT_ACTION)
		ContextActionService:UnbindAction(PREV_ACTION)
	end
end

-- Modos ------------------------------------------------------------------------------------------

local function setMode(newMode: string)
	if newMode == mode then
		return
	end
	mode = newMode
	stopOrbit()
	setActionsBound(false)
	ui.panel.Visible = false
	local camera = workspace.CurrentCamera

	if newMode == "play" then
		local humanoid = getHumanoid(LocalPlayer)
		if camera then
			camera.CameraType = Enum.CameraType.Custom
			if humanoid then
				camera.CameraSubject = humanoid
			end
		end
	elseif newMode == "waiting" then
		startOrbit(false)
	elseif newMode == "spectate" then
		ui.title.Text = hadCharacter and "Você foi eliminado" or "Modo espectador"
		if ui.reason.Text == "" then
			local reason = LocalPlayer:GetAttribute("LastDamageSource")
			ui.reason.Text = type(reason) == "string" and reason or ""
		end
		ui.panel.Visible = true
		setActionsBound(true)
		targetUserId = nil
		refreshTarget()
	end
end

local function evaluate()
	local character = LocalPlayer.Character
	if LocalPlayer:GetAttribute("Eliminated") == true then
		setMode("spectate")
		refreshTarget()
	elseif getHumanoid(LocalPlayer) then
		setMode("play")
	elseif not character or not character.Parent then
		setMode("waiting")
	end
	-- Personagem morto mas ainda não eliminado: mantém a câmera até o servidor confirmar.
end

local function build()
	local gui = UIKit.ScreenGui("Spectate", 8)
	local panel = UIKit.Panel({
		Name = "Espectador",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -20),
		Size = UDim2.fromOffset(440, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Padding = 12,
		Visible = false,
		Parent = gui,
	})
	UIKit.ListLayout(panel, 6)
	local scale = Instance.new("UIScale")
	scale.Parent = panel

	ui.title = UIKit.Label({
		Text = "Você foi eliminado",
		Font = Theme.TitleFont,
		TextSize = 28,
		TextColor3 = Theme.Danger,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 30),
		LayoutOrder = 1,
		Parent = panel,
	})
	ui.reason = UIKit.Label({
		Text = "",
		TextSize = 16,
		TextColor3 = Theme.TextMuted,
		TextXAlignment = Enum.TextXAlignment.Center,
		LayoutOrder = 2,
		Parent = panel,
	})

	local row = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 44), LayoutOrder = 3, Parent = panel })
	UIKit.Button({
		Text = "◀",
		Style = "ghost",
		Size = UDim2.fromOffset(56, 44),
		OnClick = function()
			cycle(-1)
		end,
		Parent = row,
	})
	ui.name = UIKit.Label({
		Text = "",
		Font = Theme.BoldFont,
		TextSize = 20,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(62, 0),
		Size = UDim2.new(1, -124, 1, 0),
		Parent = row,
	})
	UIKit.Button({
		Text = "▶",
		Style = "ghost",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromOffset(56, 44),
		OnClick = function()
			cycle(1)
		end,
		Parent = row,
	})
	UIKit.Label({
		Text = "Q / E (ou os botões) para trocar de jogador",
		TextSize = 15,
		TextColor3 = Theme.TextMuted,
		TextXAlignment = Enum.TextXAlignment.Center,
		LayoutOrder = 4,
		Parent = panel,
	})

	ui.gui = gui
	ui.panel = panel

	local function updateScale()
		local camera = workspace.CurrentCamera
		local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
		scale.Scale = math.clamp(math.min(viewport.X / 1280, viewport.Y / 720), 0.65, 1.1)
	end
	updateScale()
	local camera = workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
	end
end

function Spectate.Init()
	if initialized then
		return
	end
	initialized = true
	build()

	Net.event(Net.Names.Player_Eliminated).OnClientEvent:Connect(function(userId, reason)
		if userId == LocalPlayer.UserId and type(reason) == "string" then
			ui.reason.Text = reason
		end
	end)
	LocalPlayer:GetAttributeChangedSignal("Eliminated"):Connect(evaluate)
	hadCharacter = LocalPlayer.Character ~= nil
	LocalPlayer.CharacterAdded:Connect(function(character)
		hadCharacter = true
		-- Espera o Humanoid existir antes de decidir o modo.
		character:WaitForChild("Humanoid", 5)
		evaluate()
	end)

	local reason = LocalPlayer:GetAttribute("LastDamageSource")
	if type(reason) == "string" then
		ui.reason.Text = reason
	end

	evaluate()
	task.spawn(function()
		while ui.gui and ui.gui.Parent do
			task.wait(CHECK_INTERVAL)
			evaluate()
		end
	end)
end

return Spectate
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="96">
          <Properties>
            <string name="Name">WeaponClient</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Cliente das armas.
--   * Detecta a arma na mão: Tool com a tag Weapon dentro do personagem (Character.ChildAdded e
--     CollectionService, para o caso de a tag chegar depois).
--   * Clique/toque (Tool.Activated):
--       - armas de fogo: mira pelo Camera:ViewportPointToRay da posição do mouse (no toque/controle, do
--         centro da tela), origem na boca do cano; traço, clarão e som na hora; envia Weapon_Fire;
--       - facão: animação de Grip (estilo espada clássica) + Weapon_Melee;
--       - dinamite: Weapon_Throw com o ponto mirado (limitado ao alcance) e um marcador no chão.
--   * Recarregar: R (ContextActionService, com botão "Recarregar" no celular).
--   * Interface: mira, munição/cargas e "Recarregando..." (ver Weapons/WeaponUI).
-- O servidor valida tudo; aqui só há previsão local (munição e cadência) para a resposta ser imediata.

local CollectionService = game:GetService("CollectionService")
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Net = require(ReplicatedStorage.Shared.Net)
local SoundUtil = require(ReplicatedStorage.Shared.Audio.SoundUtil)
local Tags = require(ReplicatedStorage.Shared.Tags)

local WeaponsFolder = script.Parent.Weapons
local Aim = require(WeaponsFolder.Aim)
local PickupFx = require(WeaponsFolder.PickupFx)
local WeaponFx = require(WeaponsFolder.WeaponFx)
local WeaponUI = require(WeaponsFolder.WeaponUI)

local LocalPlayer = Players.LocalPlayer

local RELOAD_ACTION = "SelvaRecarregar"
local RESYNC_TIME = 0.6 -- depois disto sem atirar, a contagem local volta a seguir o servidor
local TURN_MIN_ANGLE = math.rad(25) -- vira o corpo para a mira se ela estiver mais longe que isto
local MAX_LOCAL_IMPACTS = 3 -- faíscas de impacto desenhadas por tiro (espingarda tem 8 projéteis)
local MARKER_REFRESH = 1 / 20

-- Os remotes das armas são criados pelo servidor só depois de o mapa ficar pronto; até lá as ações são
-- ignoradas (o personagem também só nasce depois disso).
local REMOTE_KEYS = {
	fire = Net.Names.Weapon_Fire,
	melee = Net.Names.Weapon_Melee,
	throw = Net.Names.Weapon_Throw,
	reload = Net.Names.Weapon_Reload,
}
local remotes: { [string]: RemoteEvent } = {}
local remotesReady = false

type Equipped = {
	tool: Tool,
	category: string,
	connections: { RBXScriptConnection },
	nextUse: number,
	localCount: number, -- munição/cargas previstas logo após um uso local
	lastLocalUse: number,
	localReloadUntil: number,
	lastServerCount: number,
}

local equipped: Equipped? = nil
local characterConnections: { RBXScriptConnection } = {}
local random = Random.new()
local mouseIconHidden = false
local reloadBound = false
local markerConnection: RBXScriptConnection? = nil
local lastMarkerUpdate = 0

-- Leitura dos atributos -------------------------------------------------------------------------------

local function numberAttr(tool: Tool, name: string, default: number): number
	local value = tool:GetAttribute(name)
	if type(value) == "number" and value == value then
		return value
	end
	return default
end

local function countAttribute(state: Equipped): string
	return if state.category == "throw" then "Charges" else "Ammo"
end

local function serverCount(state: Equipped): number
	return numberAttr(state.tool, countAttribute(state), 0)
end

-- Contagem mostrada: logo depois de usar, a previsão local (mais rápida que o servidor).
local function displayCount(state: Equipped): number
	local server = serverCount(state)
	if os.clock() - state.lastLocalUse < RESYNC_TIME then
		return math.max(math.min(state.localCount, server), 0)
	end
	return server
end

local function isReloading(state: Equipped): boolean
	return state.tool:GetAttribute("Reloading") == true or os.clock() < state.localReloadUntil
end

local function getHandle(tool: Tool): BasePart?
	local handle = tool:FindFirstChild("Handle")
	if handle and handle:IsA("BasePart") then
		return handle
	end
	return nil
end

local function getAlive(): (Model?, Humanoid?, BasePart?)
	if LocalPlayer:GetAttribute("Eliminated") then
		return nil, nil, nil
	end
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
		return nil, nil, nil
	end
	return character, humanoid, root
end

-- Interface -----------------------------------------------------------------------------------------------

local function refreshUI()
	local state = equipped
	if not state then
		return
	end
	local tool = state.tool
	if state.category == "gun" then
		local maxAmmo = numberAttr(tool, "MaxAmmo", 0)
		local ammo = displayCount(state)
		WeaponUI.SetCount(("%d / %d"):format(ammo, maxAmmo), ammo <= 0)
		local reloading = isReloading(state)
		WeaponUI.SetReloading(reloading, numberAttr(tool, "ReloadTime", 1.5))
		if reloading then
			WeaponUI.SetHint(nil)
		elseif Aim.IsTouch() then
			WeaponUI.SetHint("Toque em Recarregar")
		else
			WeaponUI.SetHint("[R] Recarregar")
		end
	elseif state.category == "throw" then
		local charges = displayCount(state)
		WeaponUI.SetCount(if charges == 1 then "1 carga" else ("%d cargas"):format(charges), charges <= 0)
		WeaponUI.SetHint("Mire e clique para arremessar")
	else
		WeaponUI.SetCount("Corpo a corpo", false)
		WeaponUI.SetHint(nil)
	end
end

-- Mira na posição do mouse (escondendo o cursor) ou no centro da tela.
local function updateCrosshairPosition()
	local state = equipped
	local wantsCrosshair = state ~= nil and state.category ~= "melee"
	local followMouse = wantsCrosshair and not Aim.UsesCenter()
	if followMouse then
		WeaponUI.SetCrosshairPosition(UserInputService:GetMouseLocation())
	else
		WeaponUI.SetCrosshairPosition(nil)
	end
	if followMouse ~= mouseIconHidden then
		mouseIconHidden = followMouse
		UserInputService.MouseIconEnabled = not followMouse
	end
end

-- Corpo virado para a mira (só visual: o tiro vai para onde se mira de qualquer jeito).
-- Retorna a transformação aplicada (para corrigir pontos medidos antes de virar).
local function faceDirection(direction: Vector3): CFrame?
	local _, humanoid, root = getAlive()
	if not humanoid or not root or not humanoid.AutoRotate or humanoid.Sit or humanoid.PlatformStand then
		return nil
	end
	local stateType = humanoid:GetState()
	if stateType == Enum.HumanoidStateType.Climbing or stateType == Enum.HumanoidStateType.Swimming then
		return nil
	end
	local flat = Vector3.new(direction.X, 0, direction.Z)
	if flat.Magnitude < 0.2 then
		return nil
	end
	flat = flat.Unit
	local current = root.CFrame
	local look = Vector3.new(current.LookVector.X, 0, current.LookVector.Z)
	if look.Magnitude > 1e-3 and look.Unit:Dot(flat) >= math.cos(TURN_MIN_ANGLE) then
		return nil
	end
	local turned = CFrame.lookAt(current.Position, current.Position + flat)
	root.CFrame = turned
	return turned * current:Inverse()
end

-- Ações -------------------------------------------------------------------------------------------------

local function requestReload(auto: boolean?)
	local state = equipped
	if not remotesReady or not state or state.category ~= "gun" or not getAlive() then
		return
	end
	local tool = state.tool
	if isReloading(state) or serverCount(state) >= numberAttr(tool, "MaxAmmo", 0) then
		return
	end
	local reloadTime = numberAttr(tool, "ReloadTime", 1.5)
	state.localReloadUntil = os.clock() + reloadTime
	if not auto then
		local handle = getHandle(tool)
		SoundUtil.Play("Reload", { Parent = handle, Volume = 0.6 })
	end
	remotes.reload:FireServer(tool)
	refreshUI()
	-- Se o servidor recusar (nenhum atributo muda), o aviso "Recarregando..." não pode ficar preso na tela.
	task.delay(reloadTime + 0.1, function()
		if equipped == state then
			refreshUI()
		end
	end)
end

local function fireGun(state: Equipped)
	local tool = state.tool
	if isReloading(state) then
		return
	end
	if displayCount(state) <= 0 then
		requestReload()
		return
	end
	local handle = getHandle(tool)
	local muzzle = WeaponFx.GetMuzzle(tool)
	if not handle or not muzzle then
		return
	end

	local now = os.clock()
	state.nextUse = now + numberAttr(tool, "Cooldown", 0.35)
	state.localCount = displayCount(state) - 1
	state.lastLocalUse = now

	-- Direção: da boca do cano até o ponto sob a mira (ou a direção da câmera se o ponto ficar para trás).
	local range = numberAttr(tool, "Range", 300)
	local params = Aim.NewParams()
	local aimPoint, cameraDirection = Aim.GetAimPoint(range, params)
	local direction = aimPoint - muzzle
	if direction.Magnitude < 1 or direction.Unit:Dot(cameraDirection) < 0.2 then
		direction = cameraDirection
	end
	direction = direction.Unit
	local turn = faceDirection(direction)
	local origin = if turn then turn * muzzle else muzzle

	-- Desenho local imediato (o servidor sorteia o espalhamento dele; aqui é só o visual).
	local pellets = math.max(math.floor(numberAttr(tool, "Pellets", 1)), 1)
	local spread = numberAttr(tool, "Spread", 0)
	local color = tool:GetAttribute("TracerColor")
	local width = numberAttr(tool, "TracerWidth", 0.1)
	local hitEnemy = false
	local impacts = 0
	for _ = 1, pellets do
		local pelletDirection = Aim.SpreadDirection(direction, spread, random)
		local result, endPoint = Aim.Cast(origin, pelletDirection, range, params)
		WeaponFx.Tracer(origin, endPoint, if typeof(color) == "Color3" then color else nil, width)
		if result then
			if Aim.IsEnemyPart(result.Instance) then
				hitEnemy = true
			end
			if impacts < MAX_LOCAL_IMPACTS then
				impacts += 1
				WeaponFx.Impact(endPoint)
			end
		end
	end
	WeaponFx.MuzzleFlash(origin)
	WeaponFx.PlayGrip(tool, "recoil", numberAttr(tool, "Recoil", 10) / 10)
	local sound = tool:GetAttribute("UseSound")
	if type(sound) == "string" then
		SoundUtil.Play(sound, { Parent = handle, Volume = 0.8 })
	end
	if hitEnemy then
		WeaponUI.Hitmarker()
	end

	remotes.fire:FireServer(tool, origin, direction)
	refreshUI()
	task.delay(RESYNC_TIME + 0.05, refreshUI)
end

local function swingMachete(state: Equipped)
	local tool = state.tool
	state.nextUse = os.clock() + numberAttr(tool, "Cooldown", 0.55)
	WeaponFx.PlayToolAnim(tool, "Slash")
	WeaponFx.PlayGrip(tool, "swing")
	local sound = tool:GetAttribute("UseSound")
	if type(sound) == "string" then
		SoundUtil.Play(sound, { Parent = getHandle(tool), Volume = 0.6 })
	end
	remotes.melee:FireServer(tool)
end

-- Alvo do arremesso: ponto sob a mira, limitado ao alcance (o servidor recusa além dele).
local function throwTarget(tool: Tool, root: BasePart): (Vector3, boolean)
	local range = numberAttr(tool, "Range", 60)
	local point, _, result = Aim.GetAimPoint(range + 20)
	local offset = point - root.Position
	local limit = math.max(range - 1, 1)
	if offset.Magnitude > limit then
		return root.Position + offset.Unit * limit, false
	end
	return point, result ~= nil
end

local function throwDynamite(state: Equipped)
	local tool = state.tool
	local _, _, root = getAlive()
	if not root or displayCount(state) <= 0 then
		return
	end
	local now = os.clock()
	state.nextUse = now + numberAttr(tool, "Cooldown", 0.9)
	state.localCount = displayCount(state) - 1
	state.lastLocalUse = now

	local target = throwTarget(tool, root)
	faceDirection(target - root.Position)
	WeaponFx.PlayToolAnim(tool, "Slash")
	WeaponFx.PlayGrip(tool, "throw")
	local sound = tool:GetAttribute("UseSound")
	if type(sound) == "string" then
		SoundUtil.Play(sound, { Parent = getHandle(tool), Volume = 0.5, PlaybackSpeed = 0.8 })
	end
	remotes.throw:FireServer(tool, target)
	refreshUI()
	task.delay(RESYNC_TIME + 0.05, refreshUI)
end

local function onActivated()
	local state = equipped
	if not remotesReady or not state or not getAlive() then
		return
	end
	if os.clock() < state.nextUse then
		return
	end
	if state.category == "gun" then
		fireGun(state)
	elseif state.category == "melee" then
		swingMachete(state)
	elseif state.category == "throw" then
		throwDynamite(state)
	end
end

-- Marcador da dinamite ------------------------------------------------------------------------------------

local function updateMarker()
	local now = os.clock()
	if now - lastMarkerUpdate < MARKER_REFRESH then
		return
	end
	lastMarkerUpdate = now
	local state = equipped
	local _, _, root = getAlive()
	if not state or state.category ~= "throw" or not root then
		WeaponFx.SetMarker(nil)
		return
	end
	local target, onSurface = throwTarget(state.tool, root)
	if not onSurface then
		-- Alvo no ar (limitado pelo alcance): mostra onde a dinamite deve cair.
		local result = Aim.Cast(target, Vector3.new(0, -1, 0), 40)
		if not result then
			WeaponFx.SetMarker(nil)
			return
		end
		target = result.Position
	end
	WeaponFx.SetMarker(target, numberAttr(state.tool, "BlastRadius", 14))
end

local function setMarkerActive(active: boolean)
	if active and not markerConnection then
		markerConnection = RunService.Heartbeat:Connect(updateMarker)
	elseif not active then
		if markerConnection then
			markerConnection:Disconnect()
			markerConnection = nil
		end
		WeaponFx.SetMarker(nil)
	end
end

-- Recarga (tecla R / botão) --------------------------------------------------------------------------------

local function onReloadAction(_actionName: string, inputState: Enum.UserInputState)
	if inputState == Enum.UserInputState.Begin then
		requestReload()
	end
	return Enum.ContextActionResult.Sink
end

local function setReloadBound(shouldBind: boolean)
	if shouldBind == reloadBound then
		return
	end
	reloadBound = shouldBind
	if shouldBind then
		ContextActionService:BindAction(RELOAD_ACTION, onReloadAction, true, Enum.KeyCode.R, Enum.KeyCode.ButtonL2)
		ContextActionService:SetTitle(RELOAD_ACTION, "Recarregar")
	else
		ContextActionService:UnbindAction(RELOAD_ACTION)
	end
end

-- Equipar / guardar -----------------------------------------------------------------------------------------

local unequip: () -> ()

local function onCountChanged(state: Equipped)
	local server = serverCount(state)
	if server > state.lastServerCount then
		-- Recarregou ou pegou mais: a previsão local é descartada.
		state.localCount = server
		state.localReloadUntil = 0
	end
	state.lastServerCount = server
	refreshUI()
end

local function onReloadingChanged(state: Equipped)
	local reloading = state.tool:GetAttribute("Reloading") == true
	if reloading then
		if os.clock() >= state.localReloadUntil then
			-- Recarga iniciada pelo servidor (munição acabou): o som toca aqui.
			state.localReloadUntil = os.clock() + numberAttr(state.tool, "ReloadTime", 1.5)
			SoundUtil.Play("Reload", { Parent = getHandle(state.tool), Volume = 0.6 })
		end
	else
		state.localReloadUntil = 0
	end
	refreshUI()
end

local function equip(tool: Tool)
	if equipped and equipped.tool == tool then
		return
	end
	if equipped then
		unequip()
	end
	local category = tool:GetAttribute("Category")
	if category ~= "gun" and category ~= "melee" and category ~= "throw" then
		return
	end

	local state: Equipped = {
		tool = tool,
		category = category,
		connections = {},
		nextUse = 0,
		localCount = 0,
		lastLocalUse = -math.huge,
		localReloadUntil = 0,
		lastServerCount = 0,
	}
	state.lastServerCount = serverCount(state)
	state.localCount = state.lastServerCount
	equipped = state

	table.insert(state.connections, tool.Activated:Connect(onActivated))
	table.insert(
		state.connections,
		tool:GetAttributeChangedSignal(countAttribute(state)):Connect(function()
			onCountChanged(state)
		end)
	)
	if category == "gun" then
		table.insert(
			state.connections,
			tool:GetAttributeChangedSignal("Reloading"):Connect(function()
				onReloadingChanged(state)
			end)
		)
		table.insert(state.connections, tool:GetAttributeChangedSignal("MaxAmmo"):Connect(refreshUI))
	end

	local displayName = tool:GetAttribute("DisplayName")
	WeaponUI.ShowWeapon(if type(displayName) == "string" then displayName else tool.Name)
	WeaponUI.SetCrosshairVisible(category ~= "melee", if numberAttr(tool, "Spread", 0) > 0 then 14 else 6)
	updateCrosshairPosition()
	setReloadBound(category == "gun")
	setMarkerActive(category == "throw")
	refreshUI()
	SoundUtil.Play("Equip", { Parent = getHandle(tool), Volume = 0.5 })

	-- Arma de fogo sem bala ao equipar: já pede a recarga.
	if category == "gun" and serverCount(state) <= 0 and tool:GetAttribute("Reloading") ~= true then
		requestReload(false)
	end
end

function unequip()
	local state = equipped
	equipped = nil
	if state then
		for _, connection in state.connections do
			connection:Disconnect()
		end
		table.clear(state.connections)
		WeaponFx.ResetGrip(state.tool)
	end
	setReloadBound(false)
	setMarkerActive(false)
	WeaponUI.HideWeapon()
	updateCrosshairPosition()
end

local function isWeaponTool(instance: Instance): boolean
	return instance:IsA("Tool") and CollectionService:HasTag(instance, Tags.Weapon)
end

local function onCharacterAdded(character: Model)
	for _, connection in characterConnections do
		connection:Disconnect()
	end
	table.clear(characterConnections)
	unequip()

	table.insert(
		characterConnections,
		character.ChildAdded:Connect(function(child)
			if isWeaponTool(child) then
				equip(child :: Tool)
			end
		end)
	)
	table.insert(
		characterConnections,
		character.ChildRemoved:Connect(function(child)
			if equipped and equipped.tool == child then
				unequip()
			end
		end)
	)
	local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 10)
	if humanoid and humanoid:IsA("Humanoid") and LocalPlayer.Character == character then
		table.insert(characterConnections, humanoid.Died:Connect(unequip))
	end
	for _, child in character:GetChildren() do
		if isWeaponTool(child) then
			equip(child :: Tool)
		end
	end
end

-- Início ------------------------------------------------------------------------------------------------------

-- Espera os remotes em silêncio (sem o aviso do Net nem "Infinite yield") e só então os pega pelo Net.
task.spawn(function()
	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	while not folder do
		folder = ReplicatedStorage:WaitForChild("Remotes", 30)
	end
	for key, name in REMOTE_KEYS do
		while not folder:FindFirstChild(name) do
			folder:WaitForChild(name, 30)
		end
		remotes[key] = Net.event(name)
	end
	remotesReady = true
end)

WeaponUI.Init()
WeaponFx.Init()
PickupFx.Init()

-- A tag pode chegar depois da Tool (replicação): confere se ela já está na mão.
CollectionService:GetInstanceAddedSignal(Tags.Weapon):Connect(function(instance)
	local character = LocalPlayer.Character
	if character and instance.Parent == character and isWeaponTool(instance) then
		equip(instance :: Tool)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if equipped and input.UserInputType == Enum.UserInputType.MouseMovement then
		updateCrosshairPosition()
	end
end)
UserInputService.LastInputTypeChanged:Connect(function()
	if equipped then
		updateCrosshairPosition()
		refreshUI()
	end
end)
UserInputService:GetPropertyChangedSignal("MouseBehavior"):Connect(function()
	if equipped then
		updateCrosshairPosition()
	end
end)

LocalPlayer:GetAttributeChangedSignal("Eliminated"):Connect(function()
	if LocalPlayer:GetAttribute("Eliminated") then
		unequip()
	end
end)
LocalPlayer.CharacterRemoving:Connect(function()
	unequip()
end)
LocalPlayer.CharacterAdded:Connect(onCharacterAdded)
if LocalPlayer.Character then
	task.spawn(onCharacterAdded, LocalPlayer.Character)
end
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="97">
          <Properties>
            <string name="Name">Weapons</string>
          </Properties>
          <Item class="ModuleScript" referent="98">
            <Properties>
              <string name="Name">Aim</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Mira do cliente: ponto da tela (mouse ou centro), raio da câmera e raycasts locais com as mesmas regras
-- do servidor (atravessa personagens, pedaços, o tabuleiro e partes invisíveis ou sem colisão; para em
-- inimigos e objetos soltos). Serve para desenhar o traço na hora e para escolher a direção do tiro.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Tags = require(ReplicatedStorage.Shared.Tags)

local Aim = {}

local LocalPlayer = Players.LocalPlayer

local MAX_PIERCE = 4
local IGNORED_FOLDERS = { "Debris", "Board", "EfeitosLocais", "EfeitosArmas" }

local lastInputType: Enum.UserInputType = UserInputService:GetLastInputType()
UserInputService.LastInputTypeChanged:Connect(function(inputType)
	lastInputType = inputType
end)

-- Entrada ---------------------------------------------------------------------------------------

function Aim.IsTouch(): boolean
	return lastInputType == Enum.UserInputType.Touch
		or (UserInputService.TouchEnabled and not UserInputService.MouseEnabled)
end

function Aim.IsGamepad(): boolean
	return string.find(lastInputType.Name, "Gamepad", 1, true) ~= nil
end

-- true quando a mira fica no centro da tela: toque, controle ou mouse travado (primeira pessoa / shift lock).
function Aim.UsesCenter(): boolean
	if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
		return true
	end
	return Aim.IsTouch() or Aim.IsGamepad() or not UserInputService.MouseEnabled
end

-- Ponto mirado em coordenadas do viewport (as mesmas de GetMouseLocation e de uma ScreenGui com
-- IgnoreGuiInset = true).
function Aim.GetScreenPoint(): Vector2
	local camera = workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
	if Aim.UsesCenter() then
		return viewport / 2
	end
	return UserInputService:GetMouseLocation()
end

-- Raycast ----------------------------------------------------------------------------------------

local function isEnemyPart(instance: Instance?): boolean
	local current = instance
	while current and current ~= workspace do
		if CollectionService:HasTag(current, Tags.Enemy) then
			return true
		end
		current = current.Parent
	end
	return false
end
Aim.IsEnemyPart = isEnemyPart

local function isLooseProp(part: BasePart): boolean
	if CollectionService:HasTag(part, Tags.LooseProp) then
		return true
	end
	local root = part.AssemblyRootPart
	return root ~= nil and root ~= part and CollectionService:HasTag(root, Tags.LooseProp)
end

local function shouldPierce(part: BasePart): boolean
	if part:IsA("Terrain") then
		return false
	end
	if part.CanCollide and part.Transparency < 0.9 then
		return false
	end
	return not isEnemyPart(part) and not isLooseProp(part)
end

-- Parâmetros novos a cada mira (a lista muda quando alguém entra, morre ou renasce).
function Aim.NewParams(): RaycastParams
	local list = {}
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(list, player.Character)
		end
	end
	for _, name in IGNORED_FOLDERS do
		local folder = workspace:FindFirstChild(name)
		if folder then
			table.insert(list, folder)
		end
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = list
	params.IgnoreWater = true
	return params
end

-- Raycast que atravessa parts "vazadas". Retorna o resultado (ou nil) e o ponto final.
function Aim.Cast(
	origin: Vector3,
	direction: Vector3,
	distance: number,
	params: RaycastParams?
): (RaycastResult?, Vector3)
	local rayParams = params or Aim.NewParams()
	local start = origin
	local remaining = distance
	for _ = 0, MAX_PIERCE do
		local result = workspace:Raycast(start, direction * remaining, rayParams)
		if not result then
			break
		end
		if not shouldPierce(result.Instance) then
			return result, result.Position
		end
		rayParams:AddToFilter(result.Instance)
		remaining -= (result.Position - start).Magnitude
		start = result.Position
		if remaining <= 0.05 then
			return nil, start
		end
	end
	return nil, start + direction * remaining
end

-- Mira -----------------------------------------------------------------------------------------------

-- Ponto do mundo sob a mira. `range` é contado a partir do personagem (não da câmera).
-- Retorna o ponto, a direção do raio da câmera e o resultado do raycast (ou nil).
function Aim.GetAimPoint(range: number, params: RaycastParams?): (Vector3, Vector3, RaycastResult?)
	local camera = workspace.CurrentCamera
	local screen = Aim.GetScreenPoint()
	local ray = camera:ViewportPointToRay(screen.X, screen.Y)
	local direction = ray.Direction.Unit
	local origin = ray.Origin

	-- Começa o raio na altura do personagem: o que está entre a câmera e ele não conta.
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local skip = 0
	if root and root:IsA("BasePart") then
		skip = math.max((root.Position - origin):Dot(direction) - 1, 0)
	end
	local result, point = Aim.Cast(origin + direction * skip, direction, range, params)
	return point, direction, result
end

-- Direção aleatória dentro de um cone (só para o desenho local; o servidor sorteia a dele).
function Aim.SpreadDirection(direction: Vector3, degrees: number, random: Random): Vector3
	if degrees <= 0 then
		return direction
	end
	local up = if math.abs(direction.Y) > 0.99 then Vector3.xAxis else Vector3.yAxis
	local right = direction:Cross(up).Unit
	local realUp = right:Cross(direction).Unit
	local angle = math.rad(degrees) * math.sqrt(random:NextNumber())
	local theta = random:NextNumber(0, math.pi * 2)
	local offset = (right * math.cos(theta) + realUp * math.sin(theta)) * math.tan(angle)
	return (direction + offset).Unit
end

return Aim
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="99">
            <Properties>
              <string name="Name">PickupFx</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Armas no chão giram e flutuam devagar (só no cliente, só as mais próximas da câmera).
-- O servidor cria os modelos ancorados em workspace.Map.ArmasNoChao; aqui eles são movidos localmente
-- (nada replica). Para não pesar no celular: no máximo MAX_ANIMATED modelos e a lista de próximos é
-- refeita só a cada REFRESH_INTERVAL segundos.

local RunService = game:GetService("RunService")

local PickupFx = {}

local FOLDER_NAME = "ArmasNoChao"
local MAX_ANIMATED = 8
local MAX_DISTANCE = 45
local REFRESH_INTERVAL = 0.5
local SPIN_SPEED = 1.2 -- rad/s
local BOB_HEIGHT = 0.18
local BOB_SPEED = 2.2

type Item = { model: Model, base: CFrame?, phase: number }

local initialized = false
local items: { [Model]: Item } = {}
local nearby: { Item } = {}
local lastRefresh = 0
local connections: { RBXScriptConnection } = {}
local stepConnection: RBXScriptConnection? = nil
local random = Random.new()

local function track(child: Instance)
	if not child:IsA("Model") or items[child] then
		return
	end
	-- O pivô original é lido na primeira atualização (as parts podem ainda estar chegando agora).
	items[child] = { model = child, base = nil, phase = random:NextNumber(0, math.pi * 2) }
end

local function untrack(child: Instance)
	if child:IsA("Model") then
		items[child] = nil
	end
end

local function refreshNearby(cameraPosition: Vector3)
	table.clear(nearby)
	local candidates = {}
	for model, item in items do
		if model.Parent then
			if not item.base and model.PrimaryPart then
				item.base = model:GetPivot()
			end
			local base = item.base or model:GetPivot()
			local distance = (base.Position - cameraPosition).Magnitude
			if distance <= MAX_DISTANCE then
				table.insert(candidates, { item = item, distance = distance })
			end
		else
			items[model] = nil
		end
	end
	table.sort(candidates, function(a, b)
		return a.distance < b.distance
	end)
	for index = 1, math.min(#candidates, MAX_ANIMATED) do
		table.insert(nearby, candidates[index].item)
	end
end

local function step()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local now = os.clock()
	if now - lastRefresh >= REFRESH_INTERVAL then
		lastRefresh = now
		refreshNearby(camera.CFrame.Position)
	end
	for _, item in nearby do
		local model = item.model
		local base = item.base
		if model.Parent and base then
			local bob = math.sin(now * BOB_SPEED + item.phase) * BOB_HEIGHT
			local spin = CFrame.Angles(0, now * SPIN_SPEED + item.phase, 0)
			model:PivotTo(CFrame.new(base.Position + Vector3.new(0, bob, 0)) * spin * base.Rotation)
		end
	end
end

local function attach(folder: Instance)
	for _, child in folder:GetChildren() do
		track(child)
	end
	table.insert(connections, folder.ChildAdded:Connect(track))
	table.insert(connections, folder.ChildRemoved:Connect(untrack))
	if not stepConnection then
		stepConnection = RunService.Heartbeat:Connect(step)
	end
end

function PickupFx.Init()
	if initialized then
		return
	end
	initialized = true
	task.spawn(function()
		-- O mapa (e só depois as armas) pode demorar a ficar pronto: espera sem desistir.
		local map = workspace:FindFirstChild("Map")
		while not map do
			map = workspace:WaitForChild("Map", 30)
		end
		local folder = map:FindFirstChild(FOLDER_NAME)
		while not folder and map.Parent do
			folder = map:WaitForChild(FOLDER_NAME, 30)
		end
		if folder then
			attach(folder)
		end
	end)
end

return PickupFx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="100">
            <Properties>
              <string name="Name">WeaponFx</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Efeitos locais das armas (nada aqui replica):
--   * traço do tiro, clarão do cano, faísca do impacto e o marcador do alvo da dinamite;
--   * animações por Tool.Grip (golpe estilo espada clássica, coice das armas, arremesso) e a animação de
--     braço padrão ("toolanim" Slash, lida pelo script Animate do personagem e replicada pelo Roblox);
--   * reação às armas dos OUTROS jogadores: o servidor sobe os atributos FireSeq/SwingSeq/ThrowSeq e
--     Reloading, e aqui tocamos som, clarão e animação de Grip na arma deles.
-- Limites de quantidade e nenhum loop rodando quando não há animação ativa.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local SoundUtil = require(ReplicatedStorage.Shared.Audio.SoundUtil)
local Tags = require(ReplicatedStorage.Shared.Tags)

local WeaponFx = {}

local LocalPlayer = Players.LocalPlayer

local FOLDER_NAME = "EfeitosArmas"
local MAX_TRACERS = 30
local MAX_IMPACTS = 12
local TRACER_LIFETIME = 0.12
local IMPACT_LIFETIME = 0.18
local FLASH_LIFETIME = 0.06
local FLASH_COLOR = Color3.fromRGB(255, 214, 120)
local MARKER_COLOR = Color3.fromRGB(255, 140, 50)
local REMOTE_FX_DISTANCE = 260 -- armas de outros jogadores mais longe que isto: sem efeito local

-- Animações de Grip: chaves { tempo, ângulo (graus, em torno do eixo X da mão), deslocamento em Z }.
-- O Grip final é Grip original * CFrame.new(0, 0, z) * CFrame.Angles(ângulo, 0, 0).
-- Ângulo positivo leva o topo da arma para a frente (lâmina "para fora"); negativo, para trás/cano para cima.
type GripKey = { number }
type GripAnim = { duration: number, keys: { GripKey } }

local GRIP_ANIMS: { [string]: GripAnim } = {
	swing = {
		duration = 0.42,
		keys = { { 0, 0, 0 }, { 0.06, -45, 0 }, { 0.16, 80, 0.1 }, { 0.3, 60, 0 }, { 0.42, 0, 0 } },
	},
	throw = {
		duration = 0.38,
		keys = { { 0, 0, 0 }, { 0.09, -60, -0.5 }, { 0.2, 70, 0.6 }, { 0.38, 0, 0 } },
	},
	-- Coice: o ângulo e o recuo são multiplicados pela força (graus do atributo Recoil / 10).
	recoil = {
		duration = 0.22,
		keys = { { 0, 0, 0 }, { 0.04, -10, -0.25 }, { 0.22, 0, 0 } },
	},
}

local folder: Folder? = nil
local tracers: { BasePart } = {}
local impacts: { BasePart } = {}
local baseGrips: { [Tool]: CFrame } = setmetatable({}, { __mode = "k" }) :: any
local activeAnims: { [Tool]: { anim: GripAnim, started: number, scale: number, base: CFrame } } = {}
local animLoop: RBXScriptConnection? = nil
local marker: BasePart? = nil
local markerDot: BasePart? = nil
local watched: { [Instance]: { RBXScriptConnection } } = {}
local initialized = false

-- Peças locais -----------------------------------------------------------------------------------------

local function getFolder(): Folder
	local current = folder
	if current and current.Parent then
		return current
	end
	local created = Instance.new("Folder")
	created.Name = FOLDER_NAME
	created.Parent = workspace
	folder = created
	return created
end

local function fxPart(name: string, size: Vector3, cframe: CFrame, color: Color3, shape: Enum.PartType?): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	part.Color = color
	if shape then
		part.Shape = shape
	end
	part.Size = size
	part.CFrame = cframe
	return part
end

local function pushLimited(list: { BasePart }, part: BasePart, limit: number)
	if #list >= limit then
		local oldest = table.remove(list, 1)
		if oldest then
			oldest:Destroy()
		end
	end
	table.insert(list, part)
end

local function fadeAndRemove(list: { BasePart }, part: BasePart, duration: number)
	local tween = TweenService:Create(part, TweenInfo.new(duration), { Transparency = 1 })
	tween.Completed:Once(function()
		local index = table.find(list, part)
		if index then
			table.remove(list, index)
		end
		part:Destroy()
	end)
	tween:Play()
end

-- Traço de tiro local (o mesmo visual do FxClient; o atirador desenha o próprio na hora).
function WeaponFx.Tracer(from: Vector3, to: Vector3, color: Color3?, width: number?)
	local delta = to - from
	local length = delta.Magnitude
	if length < 0.1 or length > 2000 then
		return
	end
	local size = math.clamp(width or 0.1, 0.03, 1)
	local part =
		fxPart("Tracer", Vector3.new(size, size, length), CFrame.lookAt(from + delta / 2, to), color or FLASH_COLOR)
	part.Transparency = 0.15
	part.Parent = getFolder()
	pushLimited(tracers, part, MAX_TRACERS)
	fadeAndRemove(tracers, part, TRACER_LIFETIME)
end

-- Faísca no ponto atingido.
function WeaponFx.Impact(position: Vector3, color: Color3?)
	local part = fxPart("Impacto", Vector3.new(0.35, 0.35, 0.35), CFrame.new(position), color or FLASH_COLOR)
	part.Transparency = 0.1
	part.Parent = getFolder()
	pushLimited(impacts, part, MAX_IMPACTS)
	fadeAndRemove(impacts, part, IMPACT_LIFETIME)
end

-- Clarão rápido na boca do cano (bola de neon + luz).
function WeaponFx.MuzzleFlash(position: Vector3)
	local part = fxPart("Clarao", Vector3.new(0.7, 0.7, 0.7), CFrame.new(position), FLASH_COLOR, Enum.PartType.Ball)
	part.Transparency = 0.2
	local light = Instance.new("PointLight")
	light.Color = FLASH_COLOR
	light.Brightness = 4
	light.Range = 12
	light.Shadows = false
	light.Parent = part
	part.Parent = getFolder()
	task.delay(FLASH_LIFETIME, function()
		part:Destroy()
	end)
end

-- Ponto de saída do tiro: o Attachment "Muzzle" do Handle (ou o próprio Handle).
function WeaponFx.GetMuzzle(tool: Tool): Vector3?
	local handle = tool:FindFirstChild("Handle")
	if not handle or not handle:IsA("BasePart") then
		return nil
	end
	local muzzle = handle:FindFirstChild("Muzzle")
	if muzzle and muzzle:IsA("Attachment") then
		return muzzle.WorldPosition
	end
	return handle.Position
end

-- Marcador do alvo da dinamite (disco do tamanho da explosão + ponto central). nil esconde.
function WeaponFx.SetMarker(position: Vector3?, radius: number?)
	if not position then
		if marker then
			marker.Parent = nil
		end
		if markerDot then
			markerDot.Parent = nil
		end
		return
	end
	local diameter = math.clamp((radius or 14) * 2, 2, 60)
	if not marker then
		local disc = fxPart("AlvoDinamite", Vector3.new(0.1, diameter, diameter), CFrame.new(), MARKER_COLOR)
		disc.Shape = Enum.PartType.Cylinder
		disc.Material = Enum.Material.SmoothPlastic
		disc.Transparency = 0.75
		marker = disc
		local dot = fxPart("AlvoCentro", Vector3.new(0.12, 1.2, 1.2), CFrame.new(), MARKER_COLOR)
		dot.Shape = Enum.PartType.Cylinder
		dot.Transparency = 0.2
		markerDot = dot
	end
	local disc = marker :: BasePart
	local dot = markerDot :: BasePart
	if disc.Size.Y ~= diameter then
		disc.Size = Vector3.new(0.1, diameter, diameter)
	end
	-- Cilindro deitado: o eixo (X) aponta para cima.
	local flat = CFrame.new(position + Vector3.new(0, 0.08, 0)) * CFrame.Angles(0, 0, math.rad(90))
	disc.CFrame = flat
	dot.CFrame = flat * CFrame.new(0.02, 0, 0)
	local parent = getFolder()
	disc.Parent = parent
	dot.Parent = parent
end

-- Animações de Grip -------------------------------------------------------------------------------------

-- Ajusta o C1 das soldas "RightGrip" que prendem o Handle na mão (pode haver mais de uma no cliente
-- dono: a local, criada ao equipar, e a replicada pelo servidor).
local function setGripJoints(tool: Tool, grip: CFrame)
	local handle = tool:FindFirstChild("Handle")
	local character = tool.Parent
	if not handle or not character then
		return
	end
	for _, handName in { "RightHand", "Right Arm" } do
		local hand = character:FindFirstChild(handName)
		if hand then
			for _, child in hand:GetChildren() do
				if child.Name == "RightGrip" and child:IsA("JointInstance") and child.Part1 == handle then
					if child.C1 ~= grip then
						child.C1 = grip
					end
				end
			end
		end
	end
end

local function applyGrip(tool: Tool, grip: CFrame)
	-- A solda da mão normalmente acompanha o Tool.Grip; ajustar o C1 garante o mesmo resultado localmente.
	tool.Grip = grip
	setGripJoints(tool, grip)
end

local function smooth(alpha: number): number
	return alpha * alpha * (3 - 2 * alpha)
end

local function sampleGrip(anim: GripAnim, elapsed: number, scale: number): CFrame
	local keys = anim.keys
	for index = 1, #keys - 1 do
		local a, b = keys[index], keys[index + 1]
		if elapsed <= b[1] then
			local span = math.max(b[1] - a[1], 1e-3)
			local alpha = smooth(math.clamp((elapsed - a[1]) / span, 0, 1))
			local angle = (a[2] + (b[2] - a[2]) * alpha) * scale
			local z = (a[3] + (b[3] - a[3]) * alpha) * scale
			return CFrame.new(0, 0, z) * CFrame.Angles(math.rad(angle), 0, 0)
		end
	end
	return CFrame.new()
end

local function stepAnims()
	local now = os.clock()
	for tool, state in activeAnims do
		local elapsed = now - state.started
		if not tool.Parent then
			activeAnims[tool] = nil
		elseif elapsed >= state.anim.duration then
			applyGrip(tool, state.base)
			activeAnims[tool] = nil
		else
			applyGrip(tool, state.base * sampleGrip(state.anim, elapsed, state.scale))
		end
	end
	if next(activeAnims) == nil and animLoop then
		animLoop:Disconnect()
		animLoop = nil
	end
end

-- Toca uma animação de Grip ("swing" | "throw" | "recoil"). `scale` multiplica ângulos e recuo.
function WeaponFx.PlayGrip(tool: Tool, name: string, scale: number?)
	local anim = GRIP_ANIMS[name]
	if not anim or not tool.Parent then
		return
	end
	local current = activeAnims[tool]
	local base = if current then current.base else baseGrips[tool]
	if not base then
		base = tool.Grip
		baseGrips[tool] = base
	end
	activeAnims[tool] = { anim = anim, started = os.clock(), scale = scale or 1, base = base }
	if not animLoop then
		animLoop = RunService.Heartbeat:Connect(stepAnims)
	end
end

-- Volta o Grip ao original (ao guardar a arma no meio de uma animação).
function WeaponFx.ResetGrip(tool: Tool)
	local state = activeAnims[tool]
	activeAnims[tool] = nil
	local base = (state and state.base) or baseGrips[tool]
	if base then
		applyGrip(tool, base)
	end
end

-- Animação de braço padrão do Roblox (o script Animate do personagem lê o StringValue "toolanim").
function WeaponFx.PlayToolAnim(tool: Tool, animName: string)
	local value = Instance.new("StringValue")
	value.Name = "toolanim"
	value.Value = animName
	value.Parent = tool
	task.delay(1, function()
		value:Destroy()
	end)
end

-- Armas dos outros jogadores ------------------------------------------------------------------------------

-- Personagem (de outro jogador) que segura a arma, se estiver perto o bastante para valer o efeito.
local function remoteHolder(tool: Tool): Model?
	local character = tool.Parent
	if not character or not character:IsA("Model") or character == LocalPlayer.Character then
		return nil
	end
	if not character:FindFirstChildOfClass("Humanoid") then
		return nil
	end
	local handle = tool:FindFirstChild("Handle")
	local camera = workspace.CurrentCamera
	if not handle or not handle:IsA("BasePart") or not camera then
		return nil
	end
	if (handle.Position - camera.CFrame.Position).Magnitude > REMOTE_FX_DISTANCE then
		return nil
	end
	return character
end

local function playToolSound(tool: Tool, soundName: any, volume: number)
	local handle = tool:FindFirstChild("Handle")
	if type(soundName) == "string" and handle then
		SoundUtil.Play(soundName, { Parent = handle, Volume = volume, RollOffMaxDistance = 300 })
	end
end

local function onRemoteFire(tool: Tool)
	if not remoteHolder(tool) then
		return
	end
	playToolSound(tool, tool:GetAttribute("UseSound"), 0.8)
	local muzzle = WeaponFx.GetMuzzle(tool)
	if muzzle then
		WeaponFx.MuzzleFlash(muzzle)
	end
	WeaponFx.PlayGrip(tool, "recoil", (tonumber(tool:GetAttribute("Recoil")) or 10) / 10)
end

local function onRemoteSwing(tool: Tool, gripName: string)
	if not remoteHolder(tool) then
		return
	end
	playToolSound(tool, tool:GetAttribute("UseSound"), 0.6)
	WeaponFx.PlayGrip(tool, gripName)
end

local function onRemoteReload(tool: Tool)
	if tool:GetAttribute("Reloading") == true and remoteHolder(tool) then
		playToolSound(tool, "Reload", 0.6)
	end
end

local function unwatch(instance: Instance)
	local connections = watched[instance]
	watched[instance] = nil
	if connections then
		for _, connection in connections do
			connection:Disconnect()
		end
	end
end

local function watch(instance: Instance)
	if watched[instance] or not instance:IsA("Tool") then
		return
	end
	local tool = instance :: Tool
	watched[tool] = {
		tool:GetAttributeChangedSignal("FireSeq"):Connect(function()
			onRemoteFire(tool)
		end),
		tool:GetAttributeChangedSignal("SwingSeq"):Connect(function()
			onRemoteSwing(tool, "swing")
		end),
		tool:GetAttributeChangedSignal("ThrowSeq"):Connect(function()
			onRemoteSwing(tool, "throw")
		end),
		tool:GetAttributeChangedSignal("Reloading"):Connect(function()
			onRemoteReload(tool)
		end),
	}
end

function WeaponFx.Init()
	if initialized then
		return
	end
	initialized = true
	CollectionService:GetInstanceAddedSignal(Tags.Weapon):Connect(watch)
	CollectionService:GetInstanceRemovedSignal(Tags.Weapon):Connect(unwatch)
	for _, instance in CollectionService:GetTagged(Tags.Weapon) do
		watch(instance)
	end
end

return WeaponFx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="101">
            <Properties>
              <string name="Name">WeaponUI</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Interface das armas: mira (no centro ou seguindo o mouse), marcador de acerto, painel com o nome da
-- arma e a munição/cargas, aviso "Recarregando..." com barra de progresso e a dica do botão de recarga.
-- O painel fica embaixo, no centro, acima da barra de ferramentas do Roblox.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local UIKit = require(ReplicatedStorage.Shared.UI.UIKit)

local WeaponUI = {}

local Theme = UIKit.Theme

local CROSSHAIR_COLOR = Color3.fromRGB(255, 248, 230)
local HIT_COLOR = Color3.fromRGB(255, 92, 70)
local LOW_COLOR = Color3.fromRGB(255, 120, 90)
local ARM_LENGTH = 10
local ARM_THICKNESS = 2
local HIT_TIME = 0.18

local built = false
local ui: { [string]: any } = {}
local scales: { UIScale } = {}
local hitToken = 0
local reloadTween: Tween? = nil
local reloadActive = false

-- Construção --------------------------------------------------------------------------------------------

local function addScale(object: GuiObject)
	local scale = Instance.new("UIScale")
	scale.Parent = object
	table.insert(scales, scale)
end

local function updateScale()
	local camera = workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
	local value = math.clamp(math.min(viewport.X / 1280, viewport.Y / 720), 0.62, 1.15)
	for _, scale in scales do
		scale.Scale = value
	end
end

local function line(parent: Instance, name: string, size: UDim2, color: Color3, rotation: number?): Frame
	local frame = UIKit.Create("Frame", {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = size,
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Rotation = rotation or 0,
		Parent = parent,
	}) :: Frame
	local stroke = UIKit.Stroke(frame, Color3.new(0, 0, 0), 1)
	stroke.Transparency = 0.45
	return frame
end

local function build()
	local gui = UIKit.ScreenGui("WeaponHUD", 6)
	ui.gui = gui

	-- Mira
	local crosshair = UIKit.Frame({
		Name = "Mira",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(72, 72),
		Visible = false,
		Parent = gui,
	})
	addScale(crosshair)
	line(crosshair, "Ponto", UDim2.fromOffset(4, 4), CROSSHAIR_COLOR)
	ui.arms = {
		top = line(crosshair, "Cima", UDim2.fromOffset(ARM_THICKNESS, ARM_LENGTH), CROSSHAIR_COLOR),
		bottom = line(crosshair, "Baixo", UDim2.fromOffset(ARM_THICKNESS, ARM_LENGTH), CROSSHAIR_COLOR),
		left = line(crosshair, "Esquerda", UDim2.fromOffset(ARM_LENGTH, ARM_THICKNESS), CROSSHAIR_COLOR),
		right = line(crosshair, "Direita", UDim2.fromOffset(ARM_LENGTH, ARM_THICKNESS), CROSSHAIR_COLOR),
	}
	ui.crosshair = crosshair

	-- Marcador de acerto (um "X" em volta da mira)
	local hit = UIKit.Frame({ Name = "Acerto", Size = UDim2.fromScale(1, 1), Visible = false, Parent = crosshair })
	for index, offset in { Vector2.new(-1, -1), Vector2.new(1, -1), Vector2.new(-1, 1), Vector2.new(1, 1) } do
		local mark = line(hit, "Traco" .. index, UDim2.fromOffset(ARM_THICKNESS + 1, 9), HIT_COLOR)
		mark.Position = UDim2.new(0.5, offset.X * 9, 0.5, offset.Y * 9)
		mark.Rotation = if offset.X * offset.Y > 0 then -45 else 45
	end
	ui.hit = hit

	-- "Recarregando..." logo abaixo da mira
	ui.reloadText = UIKit.Label({
		Name = "Recarregando",
		Text = "Recarregando...",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 1, 2),
		Size = UDim2.fromOffset(200, 24),
		Font = Theme.BoldFont,
		TextSize = 18,
		TextColor3 = Theme.Gold,
		TextStrokeTransparency = 0.3,
		TextXAlignment = Enum.TextXAlignment.Center,
		Visible = false,
		Parent = crosshair,
	})

	-- Painel da arma
	local panel = UIKit.Panel({
		Name = "PainelArma",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -84),
		Size = UDim2.fromOffset(240, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Padding = 10,
		BackgroundTransparency = 0.2,
		Visible = false,
		Parent = gui,
	})
	addScale(panel)
	UIKit.ListLayout(panel, 4)
	ui.name = UIKit.Label({
		Name = "Nome",
		Font = Theme.BoldFont,
		TextSize = 18,
		TextColor3 = Theme.Gold,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 20),
		LayoutOrder = 1,
		Parent = panel,
	})
	ui.count = UIKit.Label({
		Name = "Municao",
		Font = Theme.TitleFont,
		TextSize = 30,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 32),
		LayoutOrder = 2,
		Parent = panel,
	})
	local track = UIKit.Create("Frame", {
		Name = "BarraRecarga",
		BackgroundColor3 = Theme.WoodDark,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 6),
		LayoutOrder = 3,
		Visible = false,
		Parent = panel,
	}) :: Frame
	UIKit.Corner(track, UDim.new(1, 0))
	local fill = UIKit.Create("Frame", {
		BackgroundColor3 = Theme.Gold,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0, 1),
		Parent = track,
	}) :: Frame
	UIKit.Corner(fill, UDim.new(1, 0))
	ui.reloadTrack = track
	ui.reloadFill = fill
	ui.hint = UIKit.Label({
		Name = "Dica",
		TextSize = 14,
		TextColor3 = Theme.TextMuted,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 16),
		LayoutOrder = 4,
		Visible = false,
		Parent = panel,
	})
	ui.panel = panel

	updateScale()
	local camera = workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
	end
end

local function ensureBuilt()
	if built and ui.gui and ui.gui.Parent then
		return
	end
	built = true
	table.clear(scales)
	build()
end

-- API --------------------------------------------------------------------------------------------------

function WeaponUI.Init()
	ensureBuilt()
end

function WeaponUI.ShowWeapon(name: string)
	ensureBuilt()
	ui.name.Text = name
	ui.panel.Visible = true
end

function WeaponUI.HideWeapon()
	if not built then
		return
	end
	ui.panel.Visible = false
	WeaponUI.SetCrosshairVisible(false)
	WeaponUI.SetReloading(false)
	WeaponUI.SetHint(nil)
end

-- Texto grande do painel ("4 / 6", "3 cargas", "Corpo a corpo"). `low` pinta de vermelho.
function WeaponUI.SetCount(text: string, low: boolean?)
	ensureBuilt()
	ui.count.Text = text
	ui.count.TextColor3 = if low then LOW_COLOR else Theme.Text
	ui.count.TextSize = if #text > 10 then 22 else 30
end

function WeaponUI.SetHint(text: string?)
	ensureBuilt()
	ui.hint.Text = text or ""
	ui.hint.Visible = text ~= nil and text ~= ""
end

-- Mostra/esconde a mira; `gap` é a abertura dos traços (px), maior para a espingarda.
function WeaponUI.SetCrosshairVisible(visible: boolean, gap: number?)
	ensureBuilt()
	ui.crosshair.Visible = visible
	if gap then
		local arms = ui.arms
		arms.top.AnchorPoint = Vector2.new(0.5, 1)
		arms.top.Position = UDim2.new(0.5, 0, 0.5, -gap)
		arms.bottom.AnchorPoint = Vector2.new(0.5, 0)
		arms.bottom.Position = UDim2.new(0.5, 0, 0.5, gap)
		arms.left.AnchorPoint = Vector2.new(1, 0.5)
		arms.left.Position = UDim2.new(0.5, -gap, 0.5, 0)
		arms.right.AnchorPoint = Vector2.new(0, 0.5)
		arms.right.Position = UDim2.new(0.5, gap, 0.5, 0)
	end
end

-- nil = centro da tela; senão, a posição do mouse (coordenadas do viewport).
function WeaponUI.SetCrosshairPosition(position: Vector2?)
	ensureBuilt()
	if position then
		ui.crosshair.Position = UDim2.fromOffset(position.X, position.Y)
	else
		ui.crosshair.Position = UDim2.fromScale(0.5, 0.5)
	end
end

function WeaponUI.Hitmarker()
	ensureBuilt()
	hitToken += 1
	local token = hitToken
	ui.hit.Visible = true
	task.delay(HIT_TIME, function()
		if token == hitToken and ui.hit then
			ui.hit.Visible = false
		end
	end)
end

-- Liga o aviso de recarga com a barra enchendo em `duration` segundos (não reinicia se já estiver ligado).
function WeaponUI.SetReloading(active: boolean, duration: number?)
	if not built then
		return
	end
	if active == reloadActive then
		return
	end
	reloadActive = active
	if reloadTween then
		reloadTween:Cancel()
		reloadTween = nil
	end
	ui.reloadText.Visible = active
	ui.reloadTrack.Visible = active
	ui.reloadFill.Size = UDim2.fromScale(0, 1)
	if active then
		local tween = TweenService:Create(
			ui.reloadFill,
			TweenInfo.new(math.max(duration or 1, 0.05), Enum.EasingStyle.Linear),
			{ Size = UDim2.fromScale(1, 1) }
		)
		reloadTween = tween
		tween:Play()
	end
end

return WeaponUI
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
